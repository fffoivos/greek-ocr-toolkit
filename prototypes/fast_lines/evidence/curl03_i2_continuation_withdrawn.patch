+def material_foreign(record,evidence,page_field,labels,new,old,origin,items,h):
+    """Whole native support, with witnessed row identity, replaces box claims.
+
+    A phase only supplies correspondence. Detached/unwitnessed marks and joined
+    components remain unresolved; they cannot acquire an owner from proximity.
+    """
+    from .geometry_page_field import invert_points
+    state=record['shared_continuation'];f=page_field['fields'][state['field']]
+    peers=[r for r in evidence['lines'] if r.get('shared_continuation') and
+           r['shared_continuation']['field']==state['field'] and len(r['contacts'])>=4]
+    phases=np.array([r['shared_continuation']['phase'] for r in peers])
+    if not len(phases):return 'material row witnesses unknown'
+    x0,y0=origin;H,W=new.shape
+    ids=np.unique(labels[y0:y0+H,x0:x0+W][(new>0)&(old==0)]);ids=ids[ids>0]
+    components={c['id']:c for c in evidence['components']}
+    own={c['id'] for c in record['contacts']}
+    for cid in ids:
+        c=components.get(int(cid))
+        if c is None:return 'unwitnessed new native mark'
+        a,b,z,w=np.asarray(c['bbox'],int);yy,xx=np.nonzero(labels[b:w,a:z]==cid)
+        p=invert_points(np.asarray(f['xs']),np.asarray(f['knots']),np.asarray(f['mesh']),np.c_[xx+a,yy+b])
+        if not len(p) or not np.isfinite(p).all():return 'unknown new native component phase'
+        owners=np.argmin(abs(p[:,None]-phases),axis=1)
+        if not np.all(owners==owners[0]):return 'joined native support crosses witnessed material rows'
+        owner=peers[int(owners[0])]['line']
+        if owner!=record['line']:return 'new whole component belongs to witnessed neighbor'
+        if cid not in own:return 'new native component lacks current row body witness'
+    return None
