+    peers=[r for r in evidence['lines'] if r['line']!=record['line'] and r.get('shared_continuation') and
+           r['shared_continuation']['field']==state['field'] and len(r['contacts'])>=4]
+    poly=np.asarray(record['polygon']);n=len(poly)//2;x=poly[:n,0];top=poly[:n,1].copy();bottom=poly[n:,1][::-1].copy()
