+def material_obstructions(record,evidence,page_field,labels,stats,new,old,origin,h,ink):
+    """Collect whole local native obstructions; no component vetoes its row.
+
+    The regional ink contract is exactly the existing overlap guard's 3h
+    relative observation. Prepared page labels supply body witnesses only;
+    their different photometry is not substituted for the regional mask.
+    """
+    from .geometry_page_field import invert_points
+    state=record['shared_continuation'];f=page_field['fields'][state['field']]
+    peers=[r for r in evidence['lines'] if r.get('shared_continuation') and
+           r['shared_continuation']['field']==state['field'] and len(r['contacts'])>=4]
+    phases=np.array([r['shared_continuation']['phase'] for r in peers])
+    own={c['id'] for c in record['contacts']};ambiguous=set(record.get('ambiguous_components',[]))
+    n,lab,st,_=cv2.connectedComponentsWithStats(ink.astype(np.uint8),8)
+    x0,y0=origin;local=labels[y0:y0+new.shape[0],x0:x0+new.shape[1]]
+    ids=np.unique(lab[(new>0)&(old==0)&ink]);objects=[]
+    for k in ids:
+        if not k:continue
+        a,b,w,z,area=st[k];yy,xx=np.nonzero(lab[b:b+z,a:a+w]==k)
+        points=np.c_[xx+a+x0,yy+b+y0];strong=set(map(int,np.unique(local[yy+b,xx+a])))-{0}
+        reason=None
+        if a==0 or b==0 or a+w==new.shape[1] or b+z==new.shape[0]:reason='component meets finite observation boundary'
+        elif not len(phases):reason='no material body witnesses'
+        else:
+            p=invert_points(np.asarray(f['xs']),np.asarray(f['knots']),np.asarray(f['mesh']),points)
+            if not np.isfinite(p).all():reason='unknown inverse component support'
