+def continuation(evidence, anchor, x, *, column_evidence=None):
+    """Locate one observed row in the existing finite correspondence.
+
+    The anchor supplies position, never a new bend fit. Unknown inverse phases,
+    folds, unsupported end certificates and finite printed rules abstain. The
+    caller still has to witness native extent and retain/exclude actual ink.
+    """
+    from .geometry_field_detector import displacement
+    anchor=np.asarray(anchor,float);x=np.asarray(x,float);h=evidence['height']
+    possible=[]
+    for fid,f in enumerate(evidence.get('fields',[])):
+        if not f.get('curved') or 'mesh' not in f:continue
+        xs=np.asarray(f['xs']);knots=np.asarray(f['knots']);mesh=np.asarray(f['mesh'])
+        phase=invert_points(xs,knots,mesh,anchor)
+        if not np.isfinite(phase).all():continue
+        t=float(np.median(phase));residual=phase-t
+        if np.quantile(abs(residual),.9)>.65*h:continue
+        records=[r for r in f.get('certificate',[]) if r.get('coherent') and
+                 abs(f['rows'][r['row']]['seed']-t)<8*h]
+        if not records:continue
+        inside=(x>=xs[0])&(x<=xs[-1]);y=t+displacement(f,x,t)
+        a,b,c,d=f['region'];inside&=(y>=b)&(y<=d)
+        # A full-height median-x cut is not a finite rule contract. Consume
+        # only the observed path and its stated native vertical span.
+        for r in (column_evidence or {}).get('rules',[]):
+            if not r.get('accepted'):continue
+            rule=r['rule'];path=np.asarray(rule['path']);cy=np.interp(anchor[:,1],path[:,1],path[:,0])
+            active=(anchor[:,1]>=rule['y0'])&(anchor[:,1]<=rule['y1'])
+            sides=np.sign(anchor[active,0]-cy[active])
+            if not len(sides):continue
+            if not np.all(sides==sides[0]) or sides[0]==0:inside[:]=False;break
+            at=(y>=rule['y0'])&(y<=rule['y1'])
+            edge=np.interp(y,path[:,1],path[:,0]);inside&=~at|((x-edge)*sides[0]>0)
+        possible.append(dict(field=fid,phase=t,path=np.c_[x,np.where(inside,y,np.nan)],
+                             residual_h=(residual/h).tolist(),sides=sorted({r['side'] for r in records})))
+    return possible[0] if len(possible)==1 else None
