    "python3 - <<'PY'\nimport json\ncards=[json.loads(l) for l in open('items.jsonl')]\n# letters, marks, crop, errors, detail, where, owner faults, segmentation\nrows=[\n('n','n','y',['wrong_letter','missing_mark'],'Ка́менгельчанъ → Каменгельчанъ; Тинпигина → Тинтигина',[{'label':'Тинтигина','printed':'Тинпигина'}],[],''),\n('y','na','y',[], '',[],[],''),\n('y','y','y',[], '',[],[],''),\n('y','y','n',['crop_overrun'],'',[],[],'Whole upper body of a T from the next line appears below χθ.'),\n('y','y','y',[], '',[],[],''),\n('u','n','n',['crop_clipped'],'',[],['text_ne_visible_line','turned_or_clipped'],'Upper parts of the central line are cut off across its full width.'),\n('n','y','y',['wrong_letter'],'Fc → Fe',[{'label':'Fe','printed':'Fc'}],[],''),\n('y','y','y',[], '',[],[],''),\n]\nkeys=['one_central_line','text_ne_visible_line','other_complete_line','gt2_whole_neighbour_words','turned_or_clipped']\nwith open('answers.jsonl','w') as f:\n for c,r in zip(cards,rows):\n  a,b,d,e,t,w,faults,s=r\n  obj=dict(card_id=c['card_id'],letters=a,marks=b,crop_ok=d,errors=e,detail=t,owner_crop={k:('yes' if k in faults else 'no') for k in keys},where=w,segmentation_detail=s)\n  f.write(json.dumps(obj,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\ncards=[json.loads(l) for l in open('items.jsonl')]; out=[json.loads(l) for l in open('answers.jsonl')]\nrows=[\n('n','y','y',['missing_word_or_span'],'σκότος. → ∅',[{'label':'','printed':'σκότος.'}],['text_ne_visible_line'], 'The complete visible final word σκότος. is omitted from the label; neighbouring ink is only slivers.'),\n('y','na','y',[], '',[],[],''),\n('y','y','n',['crop_overrun'],'',[],[],'Partial letter bodies from adjacent lines appear along the upper and lower edges; no complete neighbouring words.'),\n('y','y','y',[], '',[],[],''),\n('y','na','y',[], '',[],[],''),\n('y','na','y',[], '',[],[],''),\n('y','y','y',[], '',[],[],''),\n('y','y','y',[], '',[],[],''),\n('y','y','n',['crop_overrun'],'',[],[],'Partial bodies of letters from neighbouring lines appear above and below; no whole neighbouring words.'),\n('y','y','n',[], '',[],['turned_or_clipped'],'Text is turned approximately 90 degrees.'),\n('n','na','y',['lookalike_script_letter'],'ΑΙΕ → AIE',[{'label':'AIE','printed':'ΑΙΕ'}],[],''),\n('y','na','y',[], '',[],[],''),\n('y','y','y',[], '',[],[],''),\n('y','na','y',[], '',[],[],''),\n]\nkeys=list(out[0]['owner_crop'])\nfor c,r in zip(cards[len(out):],rows):\n a,b,d,e,t,w,faults,s=r;out.append(dict(card_id=c['card_id'],letters=a,marks=b,crop_ok=d,errors=e,detail=t,owner_crop={k:('yes' if k in faults else 'no') for k in keys},where=w,segmentation_detail=s))\nwith open('answers.jsonl','w') as f:\n for o in out:f.write(json.dumps(o,ensure_ascii=False)+'\\n')\nPY",
