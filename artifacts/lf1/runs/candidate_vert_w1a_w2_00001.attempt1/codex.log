import json,collections
cards=[json.loads(l) for l in open('items.jsonl')]
answers=[json.loads(l) for l in open('answers.jsonl')]
assert len(cards)==len(answers)==55
assert [c['card_id'] for c in cards]==[a['card_id'] for a in answers]
assert len({a['card_id'] for a in answers})==55
for a in answers:
    assert all(k in a for k in ['card_id','letters','marks','crop_ok','errors','detail','owner_crop','where'])
    assert len(a['owner_crop'])==5 and all(v in ['yes','no','uncertain'] for v in a['owner_crop'].values())
    assert a['letters'] in ['y','n','u'] and a['marks'] in ['y','n','na'] and a['crop_ok'] in ['y','n']
for field in ['letters','marks','crop_ok']:
    print(field,dict(collections.Counter(a[field] for a in answers)))
print('errors',collections.Counter(e for a in answers for e in a['errors']).most_common())
print('Count and order verified:',len(answers))
