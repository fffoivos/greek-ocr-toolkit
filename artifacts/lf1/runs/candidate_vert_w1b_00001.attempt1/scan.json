  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nfor i,l in enumerate(open('items.jsonl'),1):\n c=json.loads(l)\n subprocess.run(['magick',c['crop'],'-filter','point','-resize','400%',f'zoom/{i:02}.png'],check=True)\nPY",
    "python3 - <<'PY'\nimport json\ncs=[json.loads(l) for l in open('items.jsonl')]\nrows=[]\nfor i,c in enumerate(cs[:16],1):\n r=dict(card_id=c['card_id'],letters='y',marks='na' if i in [4,7] else 'y',crop_ok='y',errors=[],detail='',owner_crop={k:'no' for k in ['one_central_line','text_ne_visible_line','other_complete_line','gt2_whole_neighbour_words','turned_or_clipped']},where=[],segmentation_detail='')\n if i==7:r.update(letters='n',errors=['punctuation'],detail='1.2.3..... → 1.2.3..',where=[{'label':'1.2.3..','printed':'1.2.3.....'}])\n if i==10:\n  r.update(letters='n',errors=['missing_word_or_span'],detail='σκότος. → ∅',where=[{'label':'','printed':'σκότος.'}]);r['owner_crop']['text_ne_visible_line']='yes'\n if i==13:\n  r.update(letters='n',crop_ok='n',errors=['missing_word_or_span','merged_two_lines'],detail='second complete φέρ᾽, ἀντι.. κρατὶ περιβάλω σκότος. → ∅',where=[{'label':'','printed':c['google_text']}],segmentation_detail='Two complete copies of the printed line are visible.')\n  for k in ['one_central_line','text_ne_visible_line','other_complete_line','gt2_whole_neighbour_words']:r['owner_crop'][k]='yes'\n rows.append(r)\nwith open('answers.jsonl','w') as f:\n for r in rows:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\ncs=[json.loads(l) for l in open('items.jsonl')];rs=[json.loads(l) for l in open('answers.jsonl')]\nfor i,c in enumerate(cs[16:32],17):\n r=dict(card_id=c['card_id'],letters='y',marks='na' if i in [23,24,26,29] else 'y',crop_ok='y',errors=[],detail='',owner_crop={k:'no' for k in ['one_central_line','text_ne_visible_line','other_complete_line','gt2_whole_neighbour_words','turned_or_clipped']},where=[],segmentation_detail='')\n if i==18:r.update(letters='n',errors=['wrong_letter','lookalike_script_letter'],detail='φ → X',where=[{'label':'X','printed':'φ'}])\n if i in [19,21,25,32]:r.update(crop_ok='n',errors=['crop_overrun'],segmentation_detail='Partial letter bodies from neighbouring text are visible; no complete neighbouring line or more than two whole neighbouring words.')\n if i in [20,23,26]:\n  r.update(crop_ok='n',errors=['crop_clipped'],segmentation_detail='The main text is cut through at the crop boundary.' if i!=20 else 'The top of the main line, including its accents and letter tops, is cut away.')\n  r['owner_crop']['text_ne_visible_line']='yes';r['owner_crop']['turned_or_clipped']='yes'\n if i==20:r.update(marks='n',errors=['crop_clipped','missing_mark'],detail='Diacritics above the line are clipped.')\n rs.append(r)\nwith open('answers.jsonl','w') as f:\n for r in rs:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\ncs=[json.loads(l) for l in open('items.jsonl')];rs=[json.loads(l) for l in open('answers.jsonl')]\nfor i,c in enumerate(cs[32:40],33):\n r=dict(card_id=c['card_id'],letters='y',marks='na' if i in [35,37,38,40] else 'y',crop_ok='y',errors=[],detail='',owner_crop={k:'no' for k in ['one_central_line','text_ne_visible_line','other_complete_line','gt2_whole_neighbour_words','turned_or_clipped']},where=[],segmentation_detail='')\n if i==37:\n  r.update(letters='n',crop_ok='n',errors=['missing_word_or_span','merged_two_lines','crop_overrun'],detail='1. → ∅',where=[{'label':'','printed':'1.'}],segmentation_detail='A complete second line, 1., is visible beneath 26.; additional partial text occurs at the left edge.')\n  for k in ['one_central_line','text_ne_visible_line','other_complete_line']:r['owner_crop'][k]='yes'\n if i==40:\n  r.update(crop_ok='n',errors=['crop_clipped'],segmentation_detail='Digits touch and are cut by the narrow crop boundary.')\n  for k in ['text_ne_visible_line','turned_or_clipped']:r['owner_crop'][k]='yes'\n rs.append(r)\nwith open('answers.jsonl','w') as f:\n for r in rs:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY",
    "magick img/013d01ae72d2da632146a9df190b98d227ea07eff6538c364b8e552de6e281a9.png -filter point -resize 800% zoom/07-extra.png",
    "python3 - <<'PY'\nimport json,collections\ncs=[json.loads(l) for l in open('items.jsonl')];rs=[json.loads(l) for l in open('answers.jsonl')]\nrs[6].update(detail='1.2.3...... → 1.2.3..',where=[{'label':'1.2.3..','printed':'1.2.3......'}])\nrs[19].update(marks='y',errors=['crop_clipped'],detail='')\nfor i,c in enumerate(cs[40:],41):\n r=dict(card_id=c['card_id'],letters='y',marks='na' if i in [41,45,52] else 'y',crop_ok='y',errors=[],detail='',owner_crop={k:'no' for k in ['one_central_line','text_ne_visible_line','other_complete_line','gt2_whole_neighbour_words','turned_or_clipped']},where=[],segmentation_detail='')\n if i in [41,45,52]:\n  r.update(crop_ok='n',errors=['crop_clipped'],segmentation_detail='The vertical sequence of digits is cut through at the crop boundary.')\n  for k in ['text_ne_visible_line','turned_or_clipped']:r['owner_crop'][k]='yes'\n if i==41:r['errors'].append('crop_overrun');r['segmentation_detail']+=' A partial neighbouring digit is also visible at the upper left.'\n if i==49:r.update(crop_ok='n',errors=['crop_overrun'],segmentation_detail='A partial neighbouring letter body is visible on the left; no whole neighbouring line or more than two whole words.')\n rs.append(r)\nwith open('answers.jsonl','w') as f:\n for r in rs:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nactual=[json.loads(l) for l in open('answers.jsonl')]\nassert len(actual)==len(cs)\nassert [r['card_id'] for r in actual]==[c['card_id'] for c in cs]\nfor r in actual:\n assert all(k in r for k in ['card_id','letters','marks','crop_ok','errors','detail','owner_crop','where'])\n assert all(v in ['yes','no','uncertain'] for v in r['owner_crop'].values())\nprint('Count and order verified:',len(actual))\nfor k in ['letters','marks','crop_ok']:print(k,dict(collections.Counter(r[k] for r in actual)))\nprint('errors',collections.Counter(e for r in actual for e in r['errors']).most_common())\nPY"
