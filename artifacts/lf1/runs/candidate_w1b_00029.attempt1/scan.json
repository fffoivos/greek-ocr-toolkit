    "python3 - <<'PY'\nimport json\ncards=[json.loads(l) for l in open('items.jsonl')]\nrows=[]\nfor c in cards[:22]:\n rows.append(dict(card_id=c['card_id'],letters='y',marks='y' if any(s=='Greek' or s=='Mixed' for _,s in c['word_scripts']) else 'na',crop_ok='y',errors=[],detail='',owner_crop=dict(one_central_line='no',text_ne_visible_line='no',other_complete_line='no',gt2_whole_neighbour_words='no',turned_or_clipped='no'),where=[],segmentation_detail=''))\ndef upd(i,**kw): rows[i-1].update(kw)\ndef crop(i,errors,detail,**faults):\n r=rows[i-1];r['crop_ok']='n';r['errors']+=errors;r['segmentation_detail']=detail;r['owner_crop'].update(faults)\nupd(1,letters='n',errors=['missing_word_or_span','digits'],detail='1 (partially visible) → ∅',where=[dict(label='',printed='1')])\ncrop(1,['crop_clipped'],'A preceding digit is cut through at the left boundary.',text_ne_visible_line='yes',turned_or_clipped='yes')\nfor i in [2,3,4]: crop(i,['crop_overrun'],'Neighbouring line letter bodies enter the crop; no complete neighbouring line or more than two whole neighbouring words.')\ncrop(11,['crop_clipped'],'The line is rotated about 90 degrees; its beginning is cut through at the bottom edge.',text_ne_visible_line='yes',turned_or_clipped='yes')\nupd(14,letters='y',errors=['punctuation'],detail='4:36 → 4.36',where=[dict(label='.',printed=':')])\n# Punctuation differences do not alter base-letter correctness.\nupd(19,letters='n',errors=['lookalike_script_letter','wrong_letter'],detail='φ → X',where=[dict(label='X',printed='φ')])\nwith open('answers.jsonl','w') as f:\n for r in rows:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY",
