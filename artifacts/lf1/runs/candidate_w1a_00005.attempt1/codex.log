import json,collections
cards=[json.loads(x) for x in open('items.jsonl')]
answers=[json.loads(x) for x in open('answers.jsonl')]
assert len(cards)==len(answers)
assert [x['card_id'] for x in cards]==[x['card_id'] for x in answers]
fields={'card_id','letters','marks','crop_ok','errors','detail','owner_crop','where','segmentation_detail'}
for a in answers:
 assert fields <= a.keys()
 assert a['letters'] in ['y','n','u']
 assert a['marks'] in ['y','n','na']
 assert a['crop_ok'] in ['y','n']
 assert len(a['owner_crop'])==5 and all(v in ['yes','no','uncertain'] for v in a['owner_crop'].values())
 assert all(set(w)=={'label','printed'} for w in a['where'])
print('Count and order verified:',len(answers))
for field in ['letters','marks','crop_ok']:
 print(field,dict(collections.Counter(a[field] for a in answers)))
print('Errors:',collections.Counter(e for a in answers for e in a['errors']).most_common())
