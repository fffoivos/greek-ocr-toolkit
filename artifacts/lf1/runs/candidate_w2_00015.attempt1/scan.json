    "python3 - <<'PY'\nimport json\ncs=[json.loads(x) for x in open('items.jsonl')]\na=[]\ndef add(i,l='y',m='y',c='y',e=[],d='',w=[],seg='',one='no',ext='no',other='no',gt='no',turn='no'):\n a.append(dict(card_id=cs[i-1]['card_id'],letters=l,marks=m,crop_ok=c,errors=e,detail=d,owner_crop=dict(one_central_line=one,text_ne_visible_line=ext,other_complete_line=other,gt2_whole_neighbour_words=gt,turned_or_clipped=turn),where=w,segmentation_detail=seg))\nadd(1,m='na');add(2);add(3)\nadd(4,c='n',e=['crop_overrun'],seg='Line is rotated 90 degrees; neighbouring partial ink along the side.',turn='yes')\nadd(5,m='na')\nadd(6,l='u',c='n',e=['crop_clipped'],seg='Final word runs into the right edge and its ending is cut.',ext='yes',turn='yes')\nadd(7);add(8,m='na');add(9,m='na');add(10,m='na');add(11)\nadd(12,c='n',seg='Text is rotated 90 degrees.',turn='yes')\nadd(13,m='na')\nadd(14,l='n',c='n',e=['merged_two_lines','missing_word_or_span'],d='Second complete repeated line → omitted',seg='Two complete copies of the line are visible.',one='yes',ext='yes',other='yes',gt='yes',w=[dict(label='',printed='φέρ᾽, ἀντι.. κρατὶ περιβάλω σκότος.')])\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\ncs=[json.loads(x) for x in open('items.jsonl')];a=[json.loads(x) for x in open('answers.jsonl')]\ndef add(i,l='y',m='y',c='y',e=[],d='',w=[],seg='',one='no',ext='no',other='no',gt='no',turn='no'):\n a.append(dict(card_id=cs[i-1]['card_id'],letters=l,marks=m,crop_ok=c,errors=e,detail=d,owner_crop=dict(one_central_line=one,text_ne_visible_line=ext,other_complete_line=other,gt2_whole_neighbour_words=gt,turned_or_clipped=turn),where=w,segmentation_detail=seg))\nadd(15,m='na');add(16)\nadd(17,l='n',e=['wrong_letter','digits'],d='ἐπέλθοι⁹ → ἐπέλθοιθ',w=[dict(label='θ',printed='9')])\nadd(18)\nadd(19,c='n',e=['crop_overrun'],seg='Partial neighbour letter bodies above and below the central line.')\nadd(20,m='na',c='n',e=['crop_overrun'],seg='Readable neighbour letter bodies above the number; no complete other line or more than two whole words.')\nadd(21,m='n',e=['missing_mark'],d='ἅπαντες → άπαντες')\nadd(22)\nadd(23,m='n',e=['missing_mark'],d='Ὄψεως → Όψεως')\nadd(24,m='na');add(25);add(26)\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\ncs=[json.loads(x) for x in open('items.jsonl')];a=[json.loads(x) for x in open('answers.jsonl')]\ndef add(i,l='y',m='y',c='y',e=[],d='',w=[],seg='',one='no',ext='no',other='no',gt='no',turn='no'):\n a.append(dict(card_id=cs[i-1]['card_id'],letters=l,marks=m,crop_ok=c,errors=e,detail=d,owner_crop=dict(one_central_line=one,text_ne_visible_line=ext,other_complete_line=other,gt2_whole_neighbour_words=gt,turned_or_clipped=turn),where=w,segmentation_detail=seg))\nadd(27,c='n',e=['crop_overrun'],seg='Partial neighbour letter bodies above and below the central line.')\nadd(28,m='na')\nadd(29,c='n',e=['crop_overrun'],seg='Partial neighbour letter bodies above the central line.')\nadd(30,l='n',c='n',e=['missing_word_or_span','crop_overrun'],d='σκότος. → omitted',w=[dict(label='',printed='σκότος.')],seg='Label omits the visible final word; partial neighbour letter bodies above and below.',ext='yes')\nadd(31,m='na');add(32);add(33,m='na');add(34);add(35,m='na');add(36,m='na')\nadd(37,l='n',e=['digits','punctuation'],d='τι¹⁷ → τι”',w=[dict(label='”',printed='17')])\nadd(38,l='n',c='n',e=['wrong_letter','lookalike_script_letter','crop_overrun'],d='φ → X',w=[dict(label='X',printed='φ')],seg='Partial neighbour letter bodies above and below the central line.')\nadd(39);add(40,c='n',e=['crop_overrun'],seg='Partial neighbour letter bodies above and below the central line.')\nadd(41);add(42,m='na');add(43,m='na')\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x,ensure_ascii=False)+'\\n')\nPY",
