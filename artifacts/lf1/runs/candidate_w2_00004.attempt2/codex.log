def add(i,letters='y',marks='y',crop='y',errors=[],detail='',where=[],faults={},seg=''):
 rows.append(dict(card_id=cards[i-1]['card_id'],letters=letters,marks=marks,crop_ok=crop,errors=errors,detail=detail,owner_crop={k:faults.get(k,'no') for k in ['one_central_line','text_ne_visible_line','other_complete_line','gt2_whole_neighbour_words','turned_or_clipped']},where=where,segmentation_detail=seg))
