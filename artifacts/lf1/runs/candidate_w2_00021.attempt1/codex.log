import json, collections
with open('items.jsonl') as f: cards=[json.loads(x) for x in f]
with open('answers.jsonl') as f: answers=[json.loads(x) for x in f]
assert len(cards)==len(answers)
assert [x['card_id'] for x in cards]==[x['card_id'] for x in answers]
for a in answers:
 assert set(('card_id','letters','marks','crop_ok','errors','detail','owner_crop','where'))<=a.keys()
 assert a['letters'] in ('y','n','u') and a['marks'] in ('y','n','na') and a['crop_ok'] in ('y','n')
 assert len(a['owner_crop'])==5 and all(v in ('yes','no','uncertain') for v in a['owner_crop'].values())
print('Cards:',len(cards))
for key in ('letters','marks','crop_ok'): print(key,dict(collections.Counter(a[key] for a in answers)))
print('Errors:',collections.Counter(e for a in answers for e in a['errors']).most_common())
