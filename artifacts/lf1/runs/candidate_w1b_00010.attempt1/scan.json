    "python3 - <<'PY'\nimport json\ncards=[json.loads(x) for x in open('items.jsonl')]\nrows=[]\nfor i,c in enumerate(cards[:16],1):\n r=dict(card_id=c['card_id'],letters='y',marks='na' if i in [2,3,7,12,14] else 'y',crop_ok='y',errors=[],detail='',owner_crop=dict(one_central_line='no',text_ne_visible_line='no',other_complete_line='no',gt2_whole_neighbour_words='no',turned_or_clipped='no'),where=[],segmentation_detail='')\n if i==1:\n  r.update(letters='n',errors=['lookalike_script_letter'],detail='φ → X',where=[{'label':'X','printed':'φ'}])\n if i==4:\n  r.update(letters='n',errors=['missing_word_or_span'],detail='σκότος. → ∅',where=[{'label':'','printed':'σκότος.'}]);r['owner_crop']['text_ne_visible_line']='yes'\n if i==5:\n  r.update(crop_ok='n',errors=['merged_two_lines'],segmentation_detail='Two complete copies of the line are visible.');r['owner_crop'].update(one_central_line='yes',text_ne_visible_line='yes',other_complete_line='yes',gt2_whole_neighbour_words='yes')\n if i==6:\n  r.update(crop_ok='n',errors=['crop_overrun'],segmentation_detail='Neighbour-line letter bodies enter at the top and bottom; no complete neighbour words.');\n if i==8:r.update(marks='n',errors=['wrong_mark'],detail='Καθὼς → Καθώς')\n rows.append(r)\nwith open('answers.jsonl','w') as f:\n for r in rows:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY",
