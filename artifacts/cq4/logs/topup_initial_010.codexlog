import json,sys
items=[json.loads(x) for x in open('items.jsonl')]
p='zoom/labels.json'
try: labels=json.load(open(p))
except FileNotFoundError: labels=[]
for token in sys.argv[1:]:
 b,a,*c=token.split('/')
 names={'n':'none','s':'smooth','r':'rough','u':'unreadable','a':'acute','g':'grave','c':'circumflex'}
 labels.append((names[b],names[a], 'low' if c else 'high'))
json.dump(labels,open(p,'w'))
with open('answers.jsonl','w') as f:
 for it,(b,a,c) in zip(items,labels):
