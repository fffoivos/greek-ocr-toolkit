/bin/zsh -lc "mkdir -p zoom
cat > zoom/write.py <<'PY'
import json,sys
items=[json.loads(s) for s in open('items.jsonl')]
with open('zoom/labels','a') as f: f.write(sys.argv[1]+'\\n')
labels=open('zoom/labels').read().split()
with open('answers.jsonl','w') as f:
 for it,label in zip(items,labels):
  b,a=label.split('/')
  conf='low' if '?' in label else 'high'
  b=b.rstrip('?');a=a.rstrip('?')
  bs={'n':'none','s':'smooth','r':'rough','u':'unreadable'}[b]
  ac={'n':'none','a':'acute','g':'grave','c':'circumflex','u':'unreadable'}[a]
  f.write(json.dumps(dict(item_id=it['item_id'],breathing=next(k for k,v in it['breathing_options'].items() if v==bs),accent=next(k for k,v in it['accent_options'].items() if v==ac),confidence=conf,note=''))+'\\n')
print(len(labels))
