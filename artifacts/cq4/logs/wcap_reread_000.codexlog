import json,re
items=[json.loads(s) for s in open('items.jsonl')]
a=[json.loads(s) for s in open('answers.jsonl')]
schema=json.load(open('answer_schema.json'))
assert len(a)==len(items)==100
assert [x['item_id'] for x in a]==[x['item_id'] for x in items]
for it,x in zip(items,a):
 assert set(x)==set(schema['required'])
 assert re.fullmatch(schema['properties']['item_id']['pattern'],x['item_id'])
 assert x['breathing'] in it['breathing_options']
 assert x['accent'] in it['accent_options']
