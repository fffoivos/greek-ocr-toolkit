import json,re
items=[json.loads(l) for l in open('items.jsonl')]
a=[json.loads(l) for l in open('answers.jsonl')]
s=json.load(open('answer_schema.json'))
assert len(a)==len(items)
for x,y in zip(items,a):
 assert set(y)==set(s['required'])
 assert y['item_id']==x['item_id'] and re.fullmatch(s['properties']['item_id']['pattern'],y['item_id'])
 assert y['breathing'] in x['breathing_options']
 assert y['accent'] in x['accent_options']
 assert y['confidence'] in ['high','low']
 assert isinstance(y['note'],str)
print(f'Validated {len(a)} answers: count, order, schema, and options valid.')
