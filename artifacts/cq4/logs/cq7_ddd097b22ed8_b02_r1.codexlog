import json
items=[json.loads(x) for x in open('items.jsonl')]
a=[json.loads(x) for x in open('answers.jsonl')]
a[1]['breathing']=next(k for k,v in items[1]['breathing_options'].items() if v=='smooth')
for it,(b,c) in zip(items[24:],[('smooth','circumflex'),('rough','none')]):
 a.append(dict(item_id=it['item_id'],breathing=next(k for k,v in it['breathing_options'].items() if v==b),accent=next(k for k,v in it['accent_options'].items() if v==c),confidence='high',note=''))
open('answers.jsonl','w').write(''.join(json.dumps(x)+'\\n' for x in a))
schema=json.load(open('answer_schema.json'))
r=[json.loads(x) for x in open('answers.jsonl')]
assert len(r)==len(items)
for it,x in zip(items,r):
 assert x['item_id']==it['item_id']
 assert set(x)==set(schema['required'])
 assert x['breathing'] in it['breathing_options']
 assert x['accent'] in it['accent_options']
 assert x['confidence'] in ['high','low']
 assert isinstance(x['note'],str)
print(f'Validated {len(r)} items: count, order, schema fields, and option validity.')
