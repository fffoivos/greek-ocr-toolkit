items=[json.loads(x) for x in open('items.jsonl')]
rows=[json.loads(x) for x in open('answers.jsonl')]
for n in (1,13):
 rows[n-1]['confidence']='low'
for n in (13,74):
 rows[n-1]['breathing']=next(k for k,v in items[n-1]['breathing_options'].items() if v=='unreadable')
 rows[n-1]['confidence']='low'
with open('answers.jsonl','w') as f:
 for r in rows:f.write(json.dumps(r)+'\\n')
schema=json.load(open('answer_schema.json'))
