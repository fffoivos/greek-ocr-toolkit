",\"none\"],[\"smooth\",\"none\"],[\"rough\",\"none\"],[\"unreadable\",\"none\",\"low\"],[\"rough\",\"none\"],[\"rough\",\"none\"],[\"unreadable\",\"none\",\"low\"],[\"rough\",\"none\"],[\"rough\",\"none\"],[\"rough\",\"none\"],[\"rough\",\"none\"],[\"smooth\",\"none\"],[\"smooth\",\"none\"]]
