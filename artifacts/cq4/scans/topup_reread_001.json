    "cat README.md answer_schema.json items.jsonl",
    "python3 - <<'PY'\nimport json\nfrom PIL import Image,ImageOps,ImageDraw\nfrom pathlib import Path\nitems=[json.loads(x) for x in open('items.jsonl')]\nPath('zoom').mkdir(exist_ok=True)\nprint(len(items))\nfor start in range(0,len(items),5):\n rows=[]\n for i,x in enumerate(items[start:start+5],start+1):\n  w=Image.open(x['word_image']).convert('RGB'); l=Image.open(x['line_image']).convert('RGB')\n  canvas=Image.new('RGB',(max(1500,w.width+30,l.width+30),w.height+l.height+65),'white'); d=ImageDraw.Draw(canvas); d.text((10,5),str(i)+' '+x['item_id'],fill='black'); canvas.paste(w,(10,25)); canvas.paste(l,(10,w.height+40)); rows.append(canvas)\n out=Image.new('RGB',(max(r.width for r in rows),sum(r.height for r in rows)), 'white'); y=0\n for r in rows:out.paste(r,(0,y)); y+=r.height\n out.save(f'zoom/b{start//5+1}.png')\nPY",
    "cat > zoom/write.py <<'PY'\nimport json,sys\nitems=[json.loads(x) for x in open('items.jsonl')]\np='zoom/decisions.json'\ntry: ds=json.load(open(p))\nexcept FileNotFoundError: ds=[]\nfor s in sys.argv[1:]:\n b,a,*c=s.split('/')\n ds.append((b,a,c[0] if c else 'high'))\njson.dump(ds,open(p,'w'))\nwith open('answers.jsonl','w') as f:\n for x,(b,a,c) in zip(items,ds):\n  f.write(json.dumps(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence=c,note=''))+'\\n')\nprint(len(ds))\nPY\npython3 zoom/write.py rough/none smooth/none rough/none rough/none smooth/circumflex",
