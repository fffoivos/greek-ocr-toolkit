  "commands": [
    "cat README.md answer_schema.json items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),5):\n args=[]\n for i,it in enumerate(items[start:start+5],start+1):\n  out=f'zoom/pair{i}.png'\n  subprocess.run(['magick',it['word_image'],it['line_image'],'-background','white','-gravity','west','-append',out],check=True)\n  args.extend([out])\n subprocess.run(['magick',*args,'-background','white','-gravity','west','-splice','0x12','-append',f'zoom/batch{start//5+1}.png'],check=True)\nPY",
    "python3 - <<'PY'\nimport json\nit=[json.loads(x) for x in open('items.jsonl')]\nv=[('rough','none'),('none','acute'),('smooth','none'),('smooth','none'),('smooth','none'),('smooth','none'),('rough','none'),('smooth','none'),('smooth','circumflex'),('smooth','none')]\nwith open('answers.jsonl','w') as f:\n for x,(b,a) in zip(it,v):\n  f.write(json.dumps(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence='high',note=''))+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nit=[json.loads(x) for x in open('items.jsonl')]\nvals=[('rough','none'),('smooth','none'),('smooth','none'),('smooth','none'),('rough','none')]\nrows=[json.loads(x) for x in open('answers.jsonl')]\nfor x,(b,a) in zip(it[len(rows):],vals):\n rows.append(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence='high',note=''))\nwith open('answers.jsonl','w') as f:\n for r in rows:f.write(json.dumps(r)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nit=[json.loads(x) for x in open('items.jsonl')]\nfor n in [5,8,12,23]:print(n,it[n-1]['word_image'])\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\nrows=[json.loads(x) for x in open('answers.jsonl')]\nvals=[('smooth','circumflex'),('smooth','none'),('none','acute'),('smooth','none'),('smooth','none'),('smooth','none'),('none','acute'),('smooth','none')]\nfor x,(b,a) in zip(items[len(rows):],vals):\n rows.append(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence='high',note=''))\nrows[4]['confidence']='low'\nwith open('answers.jsonl','w') as f:\n for row in rows:f.write(json.dumps(row)+'\\n')\nschema=json.load(open('answer_schema.json'))\nassert len(rows)==len(items)\nfor it,row in zip(items,rows):\n assert row['item_id']==it['item_id']\n assert set(row)==set(schema['required'])\n assert row['breathing'] in it['breathing_options']\n assert row['accent'] in it['accent_options']\n assert row['confidence'] in ['high','low']\n assert isinstance(row['note'],str)\nprint(f'Validated {len(rows)} answers: count, order, schema fields and option validity.')\nPY"
