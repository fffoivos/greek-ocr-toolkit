  "commands": [
    "cat README.md answer_schema.json items.jsonl",
    "python - <<'PY'\nimport json,subprocess,os\nos.makedirs('zoom',exist_ok=True)\na=[json.loads(l) for l in open('items.jsonl')]\nfor s in range(0,len(a),5):\n parts=[]\n for i,x in enumerate(a[s:s+5],s+1):\n  out=f'zoom/row{i}.png'\n  subprocess.run(['magick','(',x['word_image'],'-background','white','-gravity','west','-extent','1200x200',')','(',x['line_image'],'-background','white','-gravity','west','-extent','1200x100',')','-append',out],check=True)\n  parts.append(out)\n subprocess.run(['magick',*parts,'-append',f'zoom/batch{s//5+1}.png'],check=True)\nPY",
    "python3 - <<'PY'\nimport json,subprocess,os\nos.makedirs('zoom',exist_ok=True)\na=[json.loads(l) for l in open('items.jsonl')]\nfor s in range(0,len(a),5):\n parts=[]\n for i,x in enumerate(a[s:s+5],s+1):\n  out=f'zoom/row{i}.png'\n  subprocess.run(['magick','(',x['word_image'],'-background','white','-gravity','west','-extent','1200x200',')','(',x['line_image'],'-background','white','-gravity','west','-extent','1200x100',')','-append',out],check=True)\n  parts.append(out)\n subprocess.run(['magick',*parts,'-append',f'zoom/batch{s//5+1}.png'],check=True)\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]\nvalues=[('smooth','none'),('rough','none'),('none','none'),('none','none'),('none','none'),('none','none'),('smooth','none'),('smooth','none'),('none','none'),('none','none')]\nwith open('answers.jsonl','w') as f:\n for x,(b,a) in zip(items,values):\n  f.write(json.dumps(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence='high',note=''))+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; out=[json.loads(l) for l in open('answers.jsonl')]\nvalues=[('smooth','none'),('rough','none'),('none','none'),('rough','none'),('smooth','none'),('smooth','none'),('none','none'),('none','acute'),('rough','none'),('none','none')]\nfor x,(b,a) in zip(items[len(out):],values):\n out.append(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence='high',note=''))\nopen('answers.jsonl','w').write(''.join(json.dumps(x)+'\\n' for x in out))\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; out=[json.loads(l) for l in open('answers.jsonl')]\nvalues=[('rough','none'),('none','none'),('smooth','acute'),('smooth','none'),('rough','none'),('none','none'),('smooth','none'),('smooth','none'),('smooth','none'),('none','none')]\nfor x,(b,a) in zip(items[len(out):],values):\n out.append(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence='high',note=''))\nopen('answers.jsonl','w').write(''.join(json.dumps(x)+'\\n' for x in out))\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; out=[json.loads(l) for l in open('answers.jsonl')]\nvalues=[('smooth','acute'),('smooth','none'),('none','none'),('rough','none'),('none','none'),('smooth','none'),('none','none'),('none','none'),('none','none'),('none','acute')]\nfor x,(b,a) in zip(items[len(out):],values):\n out.append(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence='high',note=''))\nopen('answers.jsonl','w').write(''.join(json.dumps(x)+'\\n' for x in out))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(l) for l in open('items.jsonl')]; out=[json.loads(l) for l in open('answers.jsonl')]\nvalues=[('none','none'),('rough','none'),('none','none'),('rough','none'),('smooth','none')]\nfor x,(b,a) in zip(items[len(out):],values):\n out.append(dict(item_id=x['item_id'],breathing=next(k for k,v in x['breathing_options'].items() if v==b),accent=next(k for k,v in x['accent_options'].items() if v==a),confidence='high',note=''))\nopen('answers.jsonl','w').write(''.join(json.dumps(x)+'\\n' for x in out))\nfor i in [1,2,11,21,31]:\n subprocess.run(['magick',items[i-1]['word_image'],'-background','white','-gravity','northwest','-extent','1400x350',f'zoom/review{i}.png'],check=True)\nsubprocess.run(['magick',*[f'zoom/review{i}.png' for i in [1,2,11,21,31]],'-append','zoom/review.png'],check=True)\nPY",
    "python3 - <<'PY'\nimport json,re\nitems=[json.loads(l) for l in open('items.jsonl')]\na=[json.loads(l) for l in open('answers.jsonl')]\ns=json.load(open('answer_schema.json'))\nassert len(a)==len(items)\nfor x,y in zip(items,a):\n assert set(y)==set(s['required'])\n assert y['item_id']==x['item_id'] and re.fullmatch(s['properties']['item_id']['pattern'],y['item_id'])\n assert y['breathing'] in x['breathing_options']\n assert y['accent'] in x['accent_options']\n assert y['confidence'] in ['high','low']\n assert isinstance(y['note'],str)\nprint(f'Validated {len(a)} answers: count, order, schema, and options valid.')\nPY"
