  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(l) for l in open('items.jsonl')]\nfor i,x in enumerate(items):\n subprocess.run(['magick',x['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "cat > zoom/record.py <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]\n# Per-image visual calls; H = hard, S = soft, O = other, U = undecidable.\nrows=[]\ndef add(calls,pre='yes',extra=None,low=(),note=''):\n i=len(rows); x=items[i]\n assert len(calls)==x['slots'],(i+1,calls)\n rows.append(dict(item_id=x['item_id'],slots={str(j+1):dict(H='ъ',S='ь',O='other',U='u')[c] for j,c in enumerate(calls)},confidence={str(j+1):'low' if j+1 in low else 'high' for j in range(len(calls))},unmarked_final_hard_signs=extra or [],pre1918=pre,note=note))\nadd('HS')\nadd('HHS')\nadd('S')\nadd('HSSH')\nadd('SH')\nadd('HS')\nadd('S','no')\nadd('S','no')\nadd('HHS')\nadd('HH')\nwith open('answers.jsonl','w') as f:\n for r in rows:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY\npython3 zoom/record.py",
