  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows),'crops enlarged')\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъ','ьъ','ьъъъ','ъъ','ьъъъ','ь','ь','ъъъ','ъъъ','ъ']\nwith open('answers.jsonl','w') as f:\n for r,c in zip(rs,calls):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
