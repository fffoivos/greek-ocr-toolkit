  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nfor i,l in enumerate(open('items.jsonl')):\n d=json.loads(l)\n subprocess.run(['magick',d['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint('enlarged',i+1)\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ъъьъ','ъьъъъ','ьъъ','ъъother','ъь','ъъъ','ь','ъъъ']\nwith open('answers.jsonl','w') as f:\n for d,c in zip(items,calls):\n  a=list(c) if c!='ъъother' else ['ъ','ъ','other']\n  f.write(json.dumps(dict(item_id=d['item_id'],slots={str(i+1):v for i,v in enumerate(a)},confidence={str(i+1):'high' for i in range(len(a))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; old=[json.loads(l) for l in open('answers.jsonl')]\nfor d,c in zip(items[8:16],['ьъъ','ь','ъьъъ','ъь','ъъъь','ъь','ъ','ьъ']):\n old.append(dict(item_id=d['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''))\nwith open('answers.jsonl','w') as f:\n for a in old:f.write(json.dumps(a,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; old=[json.loads(l) for l in open('answers.jsonl')]\nfor n,c in enumerate(['ьь','ъь','ъ','ьъъ','ьъ','ьъъ','ь','ьъъь'],17):\n d=items[n-1];old.append(dict(item_id=d['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='no' if n==23 else 'yes',note=''))\nwith open('answers.jsonl','w') as f:\n for a in old:f.write(json.dumps(a,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')];old=[json.loads(l) for l in open('answers.jsonl')]\nfor n,c in enumerate(['ъь','ъьъъъъ','ььъ','ъъъь','ьъ','ъ','ьь','ь'],25):\n d=items[n-1];old.append(dict(item_id=d['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='no' if n==31 else 'yes',note=''))\nwith open('answers.jsonl','w') as f:\n for a in old:f.write(json.dumps(a,ensure_ascii=False)+'\\n')\nPY",
