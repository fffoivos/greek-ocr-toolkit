  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows))\nPY",
    "cat > zoom/record.py <<'PY'\nimport json\nR=[json.loads(x) for x in open('items.jsonl')]\n# Calls recorded in crop order: h=hard sign, s=soft sign.\nD='''s no\nss no\nhhh yes\ns no\nsh yes\nhs yes\nhh yes\ns yes\ns no\nshhh yes\n'''\ndef write():\n out=[]\n for r,line in zip(R,D.strip().splitlines()):\n  c,p,*extra=line.split()\n  out.append(dict(item_id=r['item_id'],slots={str(i+1):{'h':'ъ','s':'ь','u':'u','o':'other'}[x] for i,x in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=extra,pre1918=p,note=''))\n with open('answers.jsonl','w') as f:\n  for r in out:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nwrite()\nPY\npython3 zoom/record.py",
    "python3 - <<'PY'\np='zoom/record.py'\ns=open(p).read().replace(\"\\ndef write():\", \"\\nD+='''s no\\nhhh yes\\nhhhh yes\\nhhh yes\\nshhh yes\\n'''\\ndef write():\")\nopen(p,'w').write(s)\nPY\npython3 zoom/record.py",
