  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor n,i in enumerate(items,1):\n subprocess.run(['magick',i['crop'],'-resize','400%',f'zoom/{n:03}.png'],check=True)\nprint('items',len(items),'slots',sum(i['slots'] for i in items))\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъъъ','ъъъь','ьъьъ','ьъъ','ьъ']\nwith open('answers.jsonl','w') as f:\n for i,c in zip(items,calls):\n  f.write(json.dumps(dict(item_id=i['item_id'],slots={str(j):v for j,v in enumerate(c,1)},confidence={str(j):'high' for j in range(1,len(c)+1)},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\nwith open('answers.jsonl','a') as f:\n for n,c,p in [(6,'ъъьъ','yes'),(7,'ь','no'),(8,'ъъь','yes'),(9,'ъъ','yes'),(10,'ь','no')]:\n  f.write(json.dumps(dict(item_id=items[n-1]['item_id'],slots={str(j):v for j,v in enumerate(c,1)},confidence={str(j):'high' for j in range(1,len(c)+1)},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\nwith open('answers.jsonl','a') as f:\n for n,c in [(11,'ьъ'),(12,'ъ'),(13,'ьъьъ'),(14,'ъ'),(15,'ьъ')]:\n  f.write(json.dumps(dict(item_id=items[n-1]['item_id'],slots={str(j):v for j,v in enumerate(c,1)},confidence={str(j):'high' for j in range(1,len(c)+1)},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
