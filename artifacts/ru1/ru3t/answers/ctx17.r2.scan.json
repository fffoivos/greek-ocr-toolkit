  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,x in enumerate(items):\n subprocess.run(['magick',x['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,x in enumerate(items):\n subprocess.run(['magick',x['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "cat > zoom/record.py <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\ndata=[]\ndef add(calls,pre,unmarked=None,low=None,note=''):\n i=len(data); x=items[i]; assert len(calls)==x['slots'],(i+1,calls)\n data.append(dict(item_id=x['item_id'],slots={str(j+1):c for j,c in enumerate(calls)},confidence={str(j+1):('low' if low and j+1 in low else 'high') for j in range(len(calls))},unmarked_final_hard_signs=unmarked or [],pre1918=pre,note=note))\ndef save():\n with open('answers.jsonl','w') as f:\n  for x in data:f.write(json.dumps(x,ensure_ascii=False)+'\\n')\nadd('ъъ','yes')\nadd('ьъъ','yes')\nadd('ь','no')\nadd('ъъь','yes')\nadd('ь','no')\nadd('ььъ','yes')\nadd('ь','no')\nadd('ь','no')\nsave()\nPY\npython3 zoom/record.py",
    "magick zoom/015.png -crop 700x100+1300+0 -resize 200% zoom/015detail.png\nmagick zoom/010.png -crop 550x100+1500+0 -resize 200% zoom/010detail.png",
    "magick identify zoom/015.png zoom/010.png",
