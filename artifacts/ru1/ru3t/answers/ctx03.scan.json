  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,x in enumerate(items):\n subprocess.run(['magick',x['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "pwd",
    "pwd",
