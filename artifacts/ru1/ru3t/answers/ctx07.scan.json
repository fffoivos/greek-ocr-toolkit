  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows))\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъъъ','ъъъ','ъъъъъ','ъ','ьъ','ьъь']\nextras={0:['шарфъ','знакъ']}\nwith open('answers.jsonl','w') as f:\n for i,c in enumerate(calls):\n  f.write(json.dumps(dict(item_id=rs[i]['item_id'],slots={str(j+1):v for j,v in enumerate(c)},confidence={str(j+1):'high' for j in range(len(c))},unmarked_final_hard_signs=extras.get(i,[]),pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(x) for x in open('items.jsonl')]; a=[json.loads(x) for x in open('answers.jsonl')]\nfor i,c in enumerate(['ъьъ','ъъь','ь','ь','ьъъъ','ъъ'],6):\n a.append(dict(item_id=rs[i]['item_id'],slots={str(j+1):v for j,v in enumerate(c)},confidence={str(j+1):'high' for j in range(len(c))},unmarked_final_hard_signs=[],pre1918='no' if i==8 else 'yes',note=''))\nopen('answers.jsonl','w').writelines(json.dumps(x,ensure_ascii=False)+'\\n' for x in a)\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(x) for x in open('items.jsonl')]; a=[json.loads(x) for x in open('answers.jsonl')]\nfor i,c in enumerate(['ъ','ь','ъъъъ','ь','ъ','ъь'],12):\n a.append(dict(item_id=rs[i]['item_id'],slots={str(j+1):v for j,v in enumerate(c)},confidence={str(j+1):'high' for j in range(len(c))},unmarked_final_hard_signs=[],pre1918='no' if i in [13,15] else 'yes',note=''))\nopen('answers.jsonl','w').writelines(json.dumps(x,ensure_ascii=False)+'\\n' for x in a)\nPY",
