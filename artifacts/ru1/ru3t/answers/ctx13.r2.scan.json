  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(items):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "cat > zoom/record.py <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\ndef save(rows):\n try: out=[json.loads(x) for x in open('answers.jsonl')]\n except FileNotFoundError: out=[]\n for idx,calls,pre,extra in rows:\n  r=items[idx-1]\n  assert len(calls)==r['slots'],(idx,calls)\n  v={'item_id':r['item_id'],'slots':{str(i+1):v for i,v in enumerate(calls)},'confidence':{str(i+1):'high' for i in range(len(calls))},'unmarked_final_hard_signs':extra,'pre1918':pre,'note':''}\n  assert len(out)==idx-1\n  out.append(v)\n with open('answers.jsonl','w') as f:\n  for r in out:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nsave([(1,'ь','no',[]),(2,'ъьъъъ','yes',[]),(3,'ъъьъ','yes',[]),(4,'ъъ','yes',[]),(5,'ъ','yes',[]),(6,'ъъ','yes',[])])\nPY\npython3 zoom/record.py",
    "python3 - <<'PY'\nexec(open('zoom/record.py').read().split('save([(1,')[0])\nsave([(7,'ь','no',[]),(8,'ьъ','yes',[]),(9,'ъъъ','yes',[]),(10,'ъьъьъ','yes',[]),(11,'ьъъ','yes',[]),(12,'ъъьъъ','yes',[])])\nPY",
    "python3 - <<'PY'\nexec(open('zoom/record.py').read().split('save([(1,')[0])\nsave([(13,'ъьъ','yes',[]),(14,'ъъ','yes',[]),(15,'ъь','yes',[]),(16,'ъ','yes',[]),(17,'ъъь','yes',[]),(18,'ъъъъъ','yes',[])])\nPY",
