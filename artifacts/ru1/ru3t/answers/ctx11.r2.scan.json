  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(l) for l in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows),'crops enlarged')\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ъьъъ','ььъъ','ъъъъ','ь','ь']\npre=['yes','yes','yes','no','no']\nwith open('answers.jsonl','w') as f:\n for x,c,p in zip(r,calls,pre):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\\nimport json\\nr=[json.loads(l) for l in open('items.jsonl')]\\nc=json.loads('${JSON.stringify(c)}'); p=json.loads('${JSON.stringify(p)}')\\nwith open('answers.jsonl','w') as f:\\n for x,c,p in zip(r,c,p):\\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\\nPY",
