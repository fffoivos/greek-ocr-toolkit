  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nfor i,l in enumerate(open('items.jsonl')):\n r=json.loads(l)\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(i+1)\nPY",
    "python3 - <<'PY'\nimport json\nitems=list(map(json.loads,open('items.jsonl')))\ncalls=['ь','ь','ьь','ъъъъъ','ььъ','ьъъ','ъъь','ъьъ']\nwith open('answers.jsonl','w') as f:\n for r,s in zip(items,calls):\n  d=dict(item_id=r['item_id'],slots={str(i+1):v for i,v in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=[],pre1918='no' if r['item_id']==items[1]['item_id'] else 'yes',note='')\n  f.write(json.dumps(d,ensure_ascii=False)+'\\n')\nPY",
    "pwd",
    "python3 - <<'PY'\\nimport json\\nitems=list(map(json.loads,open('items.jsonl')))\\ncalls=json.loads('${JSON.stringify(calls)}')\\nwith open('answers.jsonl','w') as f:\\n for n,(r,s) in enumerate(zip(items,calls),1):\\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):v for i,v in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=[],pre1918='no' if n==2 else 'yes',note=''),ensure_ascii=False)+'\\n')\\nPY",
