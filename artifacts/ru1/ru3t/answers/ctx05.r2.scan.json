  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(l) for l in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows))\nPY",
    "cat > zoom/record.py <<'PY'\nimport json\nrows=[json.loads(l) for l in open('items.jsonl')]\nanswers=[]\ndef add(n,c,pre='yes',extra=None,low=(),note=''):\n assert len(c)==rows[n-1]['slots'],(n,c)\n answers.append(dict(item_id=rows[n-1]['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):('low' if i+1 in low else 'high') for i in range(len(c))},unmarked_final_hard_signs=extra or [],pre1918=pre,note=note))\ndef save():\n with open('answers.jsonl','w') as f:\n  for a in answers:f.write(json.dumps(a,ensure_ascii=False)+'\\n')\nadd(1,'ъъ');add(2,'ь');add(3,'ъьъ');add(4,'ь','no');add(5,'ъ');add(6,'ъъььъ');add(7,'ъъъъ');add(8,'ь','no')\nsave()\nPY\npython3 zoom/record.py",
    "cat >> zoom/record.py <<'PY'\nadd(9,'ь','no');add(10,'ьъъъ');add(11,'ъъъ');add(12,'ъ');add(13,'ьъъьъ');add(14,'ъъь');add(15,'ьъъ');add(16,'ьь','no')\nsave()\nPY\npython3 zoom/record.py",
    "cat >> zoom/record.py <<'PY'\nadd(17,'ъь');add(18,'ъъь');add(19,'ь','no');add(20,'ъьъъ');add(21,'ь','no');add(22,'ь');add(23,'ььъ');add(24,'ъьъъ')\nsave()\nPY\npython3 zoom/record.py",
