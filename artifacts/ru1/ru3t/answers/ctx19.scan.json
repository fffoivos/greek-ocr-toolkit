    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows))\nPY",
    "cat > zoom/calls.txt <<'EOF'\nъь yes\nъъьъ yes\nъъъьъ yes\nь no\nь no\nъъь yes\nъ yes\nъ yes\nъъъьъъ yes\nь yes\nEOF\npython3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\ncalls=[x.split() for x in open('zoom/calls.txt')]\nwith open('answers.jsonl','w') as f:\n for r,(s,p) in zip(rows,calls):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):c for i,c in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "cat >> zoom/calls.txt <<'EOF'\nъь yes\nъъь yes\nъъ yes\nь yes\nъъ yes\nь yes\nь no\nьъ yes\nьъъ yes\nъьъ yes\nEOF\npython3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\nwith open('answers.jsonl','w') as f:\n for r,line in zip(rows,open('zoom/calls.txt')):\n  s,p=line.split();f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):c for i,c in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
