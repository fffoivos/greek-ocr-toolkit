  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows), 'items enlarged')\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows), 'items enlarged')\nPY",
    "cat > zoom/calls.tsv <<'EOF'\nъъъь yes\nъь yes\nъьъъъ yes\nь no\nъъъъь yes\nEOF\npython3 - <<'PY'\nimport json\nrows=list(map(json.loads,open('items.jsonl')))\nwith open('answers.jsonl','w') as f:\n for r,line in zip(rows,open('zoom/calls.tsv')):\n  s,p=line.split(); a={'item_id':r['item_id'],'slots':{str(i+1):c for i,c in enumerate(s)},'confidence':{str(i+1):'high' for i in range(len(s))},'unmarked_final_hard_signs':[],'pre1918':p,'note':''};f.write(json.dumps(a,ensure_ascii=False)+'\\n')\nPY",
    "cat >> zoom/calls.tsv <<'EOF'\nъьъ yes\nъъ yes\nъьъъъъ yes\nъьъ yes\nъ yes\nEOF\ncat > zoom/write.py <<'PY'\nimport json\nrows=list(map(json.loads,open('items.jsonl')))\nwith open('answers.jsonl','w') as f:\n for r,line in zip(rows,open('zoom/calls.tsv')):\n  fields=line.split();s,p=fields[:2];a={'item_id':r['item_id'],'slots':{str(i+1):c for i,c in enumerate(s)},'confidence':{str(i+1):'high' for i in range(len(s))},'unmarked_final_hard_signs':fields[2:],'pre1918':p,'note':''};f.write(json.dumps(a,ensure_ascii=False)+'\\n')\nPY\npython3 zoom/write.py",
    "cat >> zoom/calls.tsv <<'EOF'\nъь yes\nьь yes\nъьъ yes\nъъ yes\nъъьъ yes\nьъъ yes\nEOF\npython3 zoom/write.py",
    "cat >> zoom/calls.tsv <<'EOF'\nъьъ yes\nьъъ yes\nьъ yes\nь no\nьъ yes\nььь no\nьъ yes\nEOF\npython3 zoom/write.py",
    "cat >> zoom/calls.tsv <<'EOF'\nьъ yes\nъ yes\nъъъь yes\nъьъ yes\nъъьъ yes\nъъь yes\nьъъъ yes\nEOF\npython3 zoom/write.py",
    "magick zoom/032.png -crop 360x200+0+0 zoom/032-detail.png",
    "magick identify zoom/032.png\nmagick zoom/032.png -crop 550x300+300+0 zoom/032-detail2.png",
    "cat >> zoom/calls.tsv <<'EOF'\nьъ yes\nъъъ yes\nь no\nь no\nъъъ yes\nь no\nь no\nEOF\npython3 zoom/write.py",
