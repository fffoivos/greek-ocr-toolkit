import json,collections
xs=[json.loads(l) for l in open('items.jsonl')]
calls=['ь','ъъ','ъ','ъьъъ','ь']
with open('answers.jsonl','a') as f:
 for x,c in zip(xs[90:],calls):
  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes' if 'ъ' in c or any(t in x['masked_text'] for t in 'ѣіѳ') else 'no',note=''),ensure_ascii=False)+'\\n')
ys=[json.loads(l) for l in open('answers.jsonl')]
assert len(xs)==len(ys)
counts=collections.Counter()
for x,y in zip(xs,ys):
 assert x['item_id']==y['item_id']
 expected={str(i+1) for i in range(x['slots'])}
 assert set(y['slots'])==expected
 assert set(y['confidence'])==expected
 assert all(v in {'ъ','ь','other','u'} for v in y['slots'].values())
 assert all(v in {'high','low'} for v in y['confidence'].values())
 assert y['pre1918'] in {'yes','no','unclear'}
 counts.update(y['slots'].values())
print('Validated count, order, and slot coverage:',len(ys),'items')
print('Slot calls:',dict(counts),'total',sum(counts.values()))
print('Items with unmarked final hard signs:',sum(bool(y['unmarked_final_hard_signs']) for y in ys))
