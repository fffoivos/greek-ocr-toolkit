import json,collections
items=[json.loads(l) for l in open('items.jsonl')]
a=[json.loads(l) for l in open('answers.jsonl')]
a[65]['slots']['1']='ь'
a[65]['confidence']['1']='low'
a[65]['note']='Top of final stem is worn; no distinct left flag visible.'
a[83]['slots']['1']='u'
a[83]['confidence']['1']='low'
a[83]['note']='First final glyph is partly erased at the top.'
a[57]['confidence']['2']='low'
a[57]['note']='Second final glyph has worn upper strokes.'
with open('answers.jsonl','w') as f:
 for row in a:f.write(json.dumps(row,ensure_ascii=False)+'\\n')
assert len(a)==len(items)
counts=collections.Counter()
for item,answer in zip(items,a):
 assert item['item_id']==answer['item_id']
 expected={str(i) for i in range(1,item['slots']+1)}
 assert set(answer['slots'])==expected
 assert set(answer['confidence'])==expected
 assert all(v in ['ъ','ь','other','u'] for v in answer['slots'].values())
 assert all(v in ['high','low'] for v in answer['confidence'].values())
 assert answer['pre1918'] in ['yes','no','unclear']
 counts.update(answer['slots'].values())
print('Validated count, order and slot coverage:',len(a),'items')
print('Slot calls:',dict(counts))
print('Items with unmarked final hard signs:',sum(bool(x['unmarked_final_hard_signs']) for x in a))
