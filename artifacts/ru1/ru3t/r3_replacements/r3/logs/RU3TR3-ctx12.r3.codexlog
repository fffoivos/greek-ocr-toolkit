import json
from pathlib import Path
items=[json.loads(x) for x in Path('items.jsonl').read_text().splitlines()]
def add(start,calls,pre,extras=None):
 p=Path('answers.jsonl'); rows=[json.loads(x) for x in p.read_text().splitlines()] if p.exists() else []
 assert len(rows)==start-1
 for j,s in enumerate(calls.split()):
  x=items[start-1+j]; assert len(s)==x['slots']
  rows.append(dict(item_id=x['item_id'],slots={str(k+1):v for k,v in enumerate(s)},confidence={str(k+1):'high' for k in range(len(s))},unmarked_final_hard_signs=(extras or {}).get(j,[]),pre1918='yes' if pre[j]=='y' else 'no',note=''))
 p.write_text(''.join(json.dumps(x,ensure_ascii=False)+'\\n' for x in rows))
PY
