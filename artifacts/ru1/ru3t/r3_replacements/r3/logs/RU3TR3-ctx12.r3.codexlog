rows[90]['confidence']['1']='low'
rows[90]['note']='Верх стержня потерт; левый флаг не различим.'
rows[23]['note']='В позиции 1 напечатана ѣ.'
p.write_text(''.join(json.dumps(x,ensure_ascii=False)+'\\n' for x in rows))
items=[json.loads(x) for x in Path('items.jsonl').read_text().splitlines()]
from collections import Counter
assert len(items)==len(rows)==95
for x,y in zip(items,rows):
 assert x['item_id']==y['item_id']
 expected={str(i+1) for i in range(x['slots'])}
 assert set(y['slots'])==set(y['confidence'])==expected
 assert all(v in ['ъ','ь','other','u'] for v in y['slots'].values())
 assert all(v in ['high','low'] for v in y['confidence'].values())
 assert y['pre1918'] in ['yes','no','unclear']
 assert isinstance(y['unmarked_final_hard_signs'],list)
print('Validated count, order and slot coverage:',len(rows))
print('Slot calls:',dict(Counter(v for r in rows for v in r['slots'].values())))
print('Items with unmarked final hard signs:',sum(bool(r['unmarked_final_hard_signs']) for r in rows))
