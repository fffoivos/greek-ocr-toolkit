calls=json.loads('[\"ъь\",\"ььъ\",\"ь\",\"ъ\",\"ъьъь\",\"ь\",\"ьъь\",\"ьь\",\"ьь\",\"ь\",\"ь\",\"ъьъъ\",\"ъ\",\"ььъъь\",\"ъ\",\"ь\",\"ь\",\"ъъъъ\",\"ъъьъъъъ\",\"ьь\",\"ъъъъ\",\"ьъ\",\"ьъь\",\"ь\",\"ь\",\"ъъъь\",\"ъъъь\",\"ъъьъъъ\",\"ъъ\",\"ъ\",\"ьъ\",\"ъьъъь\",\"ь\",\"ь\",\"ь\",\"ь\",\"ъъ\",\"ъъъъ\",\"ьъъ\",\"ьъ\",\"ъъь\",\"ь\",\"ьъъъ\",\"ььъ\",\"ъъь\"]')
