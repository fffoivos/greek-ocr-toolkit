import json,collections
rows=list(map(json.loads,open('items.jsonl')))
calls=json.loads('[\"ъь\",\"ььъ\",\"ь\",\"ъ\",\"ъьъь\",\"ь\",\"ьъь\",\"ьь\",\"ьь\",\"ь\",\"ь\",\"ъьъъ\",\"ъ\",\"ььъъь\",\"ъ\",\"ь\",\"ь\",\"ъъъъ\",\"ъъьъъъъ\",\"ьь\",\"ъъъъ\",\"ьъ\",\"ьъь\",\"ь\",\"ь\",\"ъъъь\",\"ъъъь\",\"ъъьъъъ\",\"ъъ\",\"ъ\",\"ьъ\",\"ъьъъь\",\"ь\",\"ь\",\"ь\",\"ь\",\"ъъ\",\"ъъъъ\",\"ьъъ\",\"ьъ\",\"ъъь\",\"ь\",\"ьъъъ\",\"ььъ\",\"ъъь\",\"ь\",\"oъъ\",\"ъъъ\",\"ъъъъъ\",\"ь\",\"ъъъ\",\"ъъъь\",\"ьъъъ\",\"ьъъ\",\"ъ\",\"ъь\",\"ь\",\"ь\",\"ъъ\",\"ь\",\"ъъъ\",\"ьъ\",\"ь\",\"ь\",\"ьъьъъ\",\"ьъ\",\"ъьъъ\",\"ьь\",\"o\",\"ь\",\"ь\",\"ъ\",\"ь\",\"ъ\",\"ъ\",\"ъъъ\",\"ьъьъ\",\"ъъъъ\",\"ь\",\"ъ\",\"ъь\",\"ъъъ\",\"ь\",\"ьь\",\"ь\",\"ъъ\",\"ъьъъ\",\"ь\",\"ь\",\"ь\",\"ь\",\"ъъ\",\"ь\",\"ьъ\",\"ь\"]')
assert len(rows)==len(calls)==95
with open('answers.jsonl','w') as f:
 for n,(r,s) in enumerate(zip(rows,calls),1):
  assert len(s)==r['slots'],(n,r['slots'],s)
  a=dict(item_id=r['item_id'],slots={str(i):('other' if v=='o' else v) for i,v in enumerate(s,1)},confidence={str(i):'high' for i in range(1,len(s)+1)},unmarked_final_hard_signs=[],pre1918='yes' if 'ъ' in s or 'o' in s or any(c in r['masked_text'] for c in 'ѣіѳ') else 'no',note='Slot 1 is printed as ѣ.' if s.startswith('o') else '')
  f.write(json.dumps(a,ensure_ascii=False)+'\\n')
answers=list(map(json.loads,open('answers.jsonl')))
assert len(answers)==len(rows)
for r,a in zip(rows,answers):
 assert r['item_id']==a['item_id']
 assert set(a['slots'])==set(map(str,range(1,r['slots']+1)))
 assert set(a['confidence'])==set(a['slots'])
 assert all(x in ['ъ','ь','other','u'] for x in a['slots'].values())
print('Validated count, order, and slot coverage:',len(answers))
print('Slot calls:',dict(collections.Counter(v for a in answers for v in a['slots'].values())))
print('Items with unmarked final hard signs:',sum(bool(a['unmarked_final_hard_signs']) for a in answers))
