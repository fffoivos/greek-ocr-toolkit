{"item_id": "kd9e2916791", "crop": "crops/c4b7f1ea9fe9ecaac302a9629ca0c6e3a7c6bb81c63feb68bbc9843a0dd4c1ca.png", "masked_text": "н. вернувшис⟦1⟧ в родную деревню,", "slots": 1}
