import json
items=[json.loads(l) for l in open('items.jsonl')]
# Per-image visual calls; H = hard, S = soft, O = other, U = undecidable.
rows=[]
def add(calls,pre='yes',extra=None,low=(),note=''):
 i=len(rows); x=items[i]
 assert len(calls)==x['slots'],(i+1,calls)
 rows.append(dict(item_id=x['item_id'],slots={str(j+1):dict(H='ъ',S='ь',O='other',U='u')[c] for j,c in enumerate(calls)},confidence={str(j+1):'low' if j+1 in low else 'high' for j in range(len(calls))},unmarked_final_hard_signs=extra or [],pre1918=pre,note=note))
add('HS')
add('HHS')
add('S')
add('HSSH')
add('SH')
add('HS')
add('S','no')
add('S','no')
add('HHS')
add('HH')
with open('answers.jsonl','w') as f:
 for r in rows:f.write(json.dumps(r,ensure_ascii=False)+'\\n')
PY
