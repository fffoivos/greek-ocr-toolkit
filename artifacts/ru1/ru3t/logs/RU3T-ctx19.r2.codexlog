with open('answers.jsonl','w') as f:
 for n,(r,s) in enumerate(zip(items,p['calls']),1):
  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):('other' if v=='O' else v) for i,v in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=p['unmarked'].get(str(n),[]),pre1918='no' if n in p['no'] else 'yes',note=({'54':'Slot 2 is ѣ.','73':'Slot 3 is ѣ.'}.get(str(n),''))),ensure_ascii=False)+'\\n')
answers=list(map(json.loads,open('answers.jsonl')))
assert len(items)==len(answers)==95
for r,a in zip(items,answers):
 assert r['item_id']==a['item_id']
 expected={str(i) for i in range(1,r['slots']+1)}
 assert set(a['slots'])==set(a['confidence'])==expected,(r['item_id'],r['slots'],a)
 assert all(v in ['ъ','ь','other','u'] for v in a['slots'].values())
 assert all(v in ['high','low'] for v in a['confidence'].values())
 assert a['pre1918'] in ['yes','no','unclear']
print('Count, order and slot coverage verified:',len(answers))
print('Slot calls:',dict(collections.Counter(v for a in answers for v in a['slots'].values())))
print('Items with unmarked final hard signs:',sum(bool(a['unmarked_final_hard_signs']) for a in answers))
