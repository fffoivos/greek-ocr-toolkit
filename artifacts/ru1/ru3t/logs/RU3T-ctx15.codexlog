import json
R=[json.loads(x) for x in open('items.jsonl')]
# Calls recorded in crop order: h=hard sign, s=soft sign.
D='''s no
ss no
hhh yes
s no
sh yes
hs yes
hh yes
s yes
s no
shhh yes
'''
def write():
 out=[]
 for r,line in zip(R,D.strip().splitlines()):
  c,p,*extra=line.split()
  out.append(dict(item_id=r['item_id'],slots={str(i+1):{'h':'ъ','s':'ь','u':'u','o':'other'}[x] for i,x in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=extra,pre1918=p,note=''))
 with open('answers.jsonl','w') as f:
  for r in out:f.write(json.dumps(r,ensure_ascii=False)+'\\n')
write()
PY
