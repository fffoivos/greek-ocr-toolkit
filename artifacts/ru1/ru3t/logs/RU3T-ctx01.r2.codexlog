import json,collections
rows=list(map(json.loads,open('items.jsonl')))
ans=list(map(json.loads,open('answers.jsonl')))
ans[31]['confidence']['1']='low'
ans[31]['note']='Top flag visible but interrupted by worn ink.'
with open('answers.jsonl','w') as f:
 for a in ans:f.write(json.dumps(a,ensure_ascii=False)+'\\n')
assert len(rows)==len(ans)
counts=collections.Counter()
for r,a in zip(rows,ans):
 assert r['item_id']==a['item_id']
 expected={str(i) for i in range(1,r['slots']+1)}
 assert set(a['slots'])==set(a['confidence'])==expected,(r['item_id'],expected,a)
 assert all(x in {'ъ','ь','other','u'} for x in a['slots'].values())
 assert all(x in {'high','low'} for x in a['confidence'].values())
 assert a['pre1918'] in {'yes','no','unclear'}
 counts.update(a['slots'].values())
print('Validated count, order, slot coverage:',len(ans),'items')
print('Slot calls:',dict(counts))
print('Items with unmarked final hard signs:',sum(bool(a['unmarked_final_hard_signs']) for a in ans))
