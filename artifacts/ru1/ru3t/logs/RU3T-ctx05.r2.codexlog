import json
rows=[json.loads(l) for l in open('items.jsonl')]
answers=[]
def add(n,c,pre='yes',extra=None,low=(),note=''):
 assert len(c)==rows[n-1]['slots'],(n,c)
 answers.append(dict(item_id=rows[n-1]['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):('low' if i+1 in low else 'high') for i in range(len(c))},unmarked_final_hard_signs=extra or [],pre1918=pre,note=note))
def save():
 with open('answers.jsonl','w') as f:
  for a in answers:f.write(json.dumps(a,ensure_ascii=False)+'\\n')
