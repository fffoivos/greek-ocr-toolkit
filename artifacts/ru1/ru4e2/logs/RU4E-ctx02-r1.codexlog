import json
rows=list(map(json.loads,open('items.jsonl')))
def save(start,calls,pre=None,extras=None):
 try: out=list(map(json.loads,open('answers.jsonl')))
 except FileNotFoundError: out=[]
 for j,c in enumerate(calls):
  i=start-1+j;r=rows[i]; d={'item_id':r['item_id'],'slots':{str(k+1):v for k,v in enumerate(c)},'confidence':{str(k+1):'high' for k in range(len(c))},'unmarked_final_hard_signs':(extras or {}).get(i+1,[]),'pre1918':(pre or {}).get(i+1,'yes'),'note':''}
  assert len(c)==r['slots'],(i+1,c)
  if i<len(out):out[i]=d
  else: assert i==len(out);out.append(d)
 with open('answers.jsonl','w') as f:
  for d in out:f.write(json.dumps(d,ensure_ascii=False)+'\\n')
