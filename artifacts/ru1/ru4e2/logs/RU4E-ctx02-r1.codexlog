37\u0435\u043d\u0438 \u0438 \u0441\u043d\u0430\u0431\u0434\u0435\u043d\u0438 \u0441\u27e63\u27e7 \u043e\u0441\u0442\u0440\u0438", "slots": 3}, {"item_id": "k2b619ff333", "crop": "crops/1564fe5b71c53964aff9c46bb02ad70081d4262cded68eaebcab9835bbe14196.png", "masked_text": "\u043e\u0442\u0432\u044b\u043a\u043d\u0435\u0442\u27e61\u27e7 \u043e\u0442\u27e62\u27e7 \u0431\u0435\u0437\u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0441\u0442\u0438, \u2014 \u043f\u0440\u043e\u0431\u043e\u0440\u043c\u043e\u0442\u0430\u043b\u27e63\u27e7 \u044f. - \u0423", "slots": 3}, {"item_id": "k15461bdb03", "crop": "crops/ebadb36cd245eea318795e81452bf0d2f0aaec6c8e9c2baaa8d590220b812100.png", "masked_text": "\u041b\u044c\u0432\u043e\u0432\u0430 \u043d\u043e\u0447\u044c\u044e, \u0447\u0430\u0441\u043e\u0432\u27e61\u27e7 \u0432\u27e62\u27e7 \u0434\u0435\u0432\u044f\u0442\u27e63\u27e7, \u043f\u043e\u0434\u27e64\u27e7 \u043f\u043e\u043a\u0440\u043e\u0432\u043e\u043c\u27e65\u27e7", "slots": 5}, {"item_id": "kc1f2de6dfe", "crop": "crops/ef61e9931f4f96fa81857fad1e0a4f58d736b7e0e11a4accccd0b62ca8a69e20.png", "masked_text": "\u0441\u043b\u0430\u0434\u043a\u043e\u0433\u043b\u0430\u0441\u043d\u044b\u043c\u0438 \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u0430\u043c\u0438 \u043e\u043d\u0438 \u0443\u043f\u0435\u0440\u043b\u0438\u0441\u27e61\u27e7 \u0432 \u0441\u0442\u0435\u043d\u0443.", "slots": 1}, {"item_id": "k7a2173699c", "crop": "crops/17398da06e5aa43e12b85019cfc1dbf9fff3ac62249eddd73a5362f129bce929.png", "masked_text": "\u0432\u0430\u044e\u0442\u27e61\u27e7 \u0443\u0441\u043b\u044b\u0448\u0430\u043d\u043d\u043e\u0435 \u043c\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u27e62\u27e7, \u043d\u043e \u0431\u0435\u0437\u27e63\u27e7 \u0432\u0441\u044f\u043a\u0430\u0433\u043e \u0443\u0441\u043f\u0463\u0445\u0430", "slots": 3}, {"item_id": "k6927dcba70", "crop": "crops/f52bbabf95698964bb63edee357b46c4a7fa68e69536868a36940fe2729b963d.png", "masked_text": "\u043a\u043d\u044f\u0433\u0438\u043d\u044f \u044d\u0442\u0430, \u043d\u0435 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u27e61\u27e7 \u0432\u27e62\u27e7 \u041f\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u0463, \u0430 \u043d\u0430\u0445\u043e-", "slots": 2}, {"item_id": "k2c666c97fa", "crop": "crops/02f059ab41298dd66dd77cf14467ac14316716799a31610d3e6c443d9cfb2a05.png", "masked_text": "\u0418 \u043b\u044e\u0434\u0438 \u0421\u043e\u043b\u0438\u0446\u0435 \u043f\u044c\u044e\u0442\u27e61\u27e7, \u0442\u044b \u043b\u044c\u0435\u0448\u27e62\u27e7 \u0432\u0438\u043d\u043e \u0441\u0442\u0440\u0443\u044f\u043c\u0438,", "slots": 2}, {"item_id": "k45763d19ca", "crop": "crops/51b38071b25483ce8239d2cb39a6a68dbfe0e37d4c498fcbb52920c55168faf7.png", "masked_text": "\u0432\u27e61\u27e7 \u043e\u043f\u0430\u0441\u043d\u044b\u044f \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0456\u044f. \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u043e\u0441\u27e62\u27e7 \u043e\u0441\u0442\u0430\u043d\u0430-", "slots": 2}, {"item_id": "kb98de9feb0", "crop": "crops/076032127fcc142e25283d5a5a328ad44c9d4c68c81c34bc48601061b4198317.png", "masked_text": "\u043d\u043e \u0434\u0430\u0436\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f. \u041f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u27e61\u27e7 \u0436\u0435 \u0432", "slots": 1}, {"item_id": "k1da93af36f", "crop": "crops/c8f83d2734d1dc7f5788b55f6bebe246ccc20c99c2bf632e102f42a8f6707393.png", "masked_text": "\u043e\u0447\u0435\u043d\u27e61\u27e7 \u0440\u0430\u0437\u0432\u0438\u0442\u043e\u0439, \u043e\u0447\u0435\u043d\u27e62\u27e7 \u0442\u043e\u043d\u043a\u043e\u0439 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b; \u043e\u0442\u0442\u043e\u0433\u043e, \u0438", "slots": 2}, {"item_id": "kaac582abff", "crop": "crops/873c66c671f13b3180c683ba84116626921ce031481ab5efb4399f0e4aa6fa2a.png", "masked_text": "\u0431\u044b\u043b\u043e \u0434\u0432\u0430 \u0433\u043e\u0434\u0430 \u0438 \u0441\u0435\u043c\u27e61\u27e7 \u043c\u0463\u0441\u044f\u0446\u0435\u0432\u27e62\u27e7, \u044f \u043e\u0434\u043d\u0430\u0436\u0434\u044b \u0432\u0441\u0442\u0440\u0463\u0442\u0438\u043b\u27e63\u27e7 \u0435\u0433\u043e", "slots": 3}, {"item_id": "k20ec8a518d", "crop": "crops/bf3e1ce24e95ee8a45bf49633e4daaf6919738df36c940d571735ac9942d2405.png", "masked_text": "\u0446\u0435\u0432\u27e61\u27e7 \u043e\u043d\u27e62\u27e7 \u044d\u0442\u043e\u0433\u043e \u043d\u0435 \u0432\u043f\u043e\u043b\u043d\u0463 \u0434\u043e\u0441\u0442\u0438\u0433\u27e63\u27e7. \u0412\u27e64\u27e7 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u27e65\u27e7 \u0434\u0432\u0430 \u0434\u0438\u043b", "slots": 5}, {"item_id": "kd9c82d4523", "crop": "crops/e8aa021d090656c9d1c76a06ff4c2e6af35da507ba46d7178a58d23311964338.png", "masked_text": "\u0433\u0443\u0440\u044c\u0431\u043e\u0439, \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0441\u044f \u043e\u0433\u0443\u0440\u0431\u0438\u0442\u27e61\u27e7, \u0430 \u0432 \u0441\u043c\u044b\u0441\u043b\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u27e62\u27e7 \u043a\u043e\u0433\u043e", "slots": 2}, {"item_id": "k500f62036c", "crop": "crops/853aee07a4f21fb9acce62a78fd613e8609129421fe568d21e94b3243f561e6b.png", "masked_text": "\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043b\u0430 \u0431\u044b \u0432\u27e61\u27e7 \u0442\u0430\u043a\u043e\u0439 \u0434\u0435\u043d\u27e62\u27e7 \u0434\u043e \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0456\u044f, \u0435\u0441\u043b\u0438 \u0431\u044b \u043e\u043d\u0430 \u0431\u044b\u043b\u0430", "slots": 2}, {"item_id": "kabb158fa3b", "crop": "crops/f79113922b603aa9406062b491bb4702cf67e2d424fb69459d016f4ed3e5822c.png", "masked_text": "\u0412\u27e61\u27e7 \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0435\u043c\u27e62\u27e7 \u0434\u043d\u0435\u0439 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u0442\u043e\u0442\u27e63\u27e7 \u0440\u0435\u0431\u0435\u043d\u043e\u043a\u27e64\u27e7 \u043c\u043e\u0439,", "slots": 4}, {"item_id": "k2707b9fe3e", "crop": "crops/3382f17f3600a1cc841b24417617942da5fc0d1589a774773f615893a39236b7.png", "masked_text": "\u0434\u0456\u0435\u043c\u27e61\u27e7 \u043e\u0442\u27e62\u27e7 \u0434\u0440\u0435\u0432\u043d\u044f\u0433\u043e \u0440\u043e\u0434\u0438\u0447\u0430, \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u043d\u0430\u0433\u043e \u0438\u043c\u27e63\u27e7, \u0441\u043b\u0463\u0434\u043e\u0432\u0430\u043b\u043e \u0431\u044b \u043e\u0436\u0438\u0434\u0430\u0442\u27e64\u27e7", "slots": 4}, {"item_id": "k253a03ff09", "crop": "crops/d484f5f4a4e0dcc051d37946de946aed8c0a96b37d6e6c35acccc8e80ab32a99.png", "masked_text": "\u0433\u0434\u0430 \u043d\u0435\u043e\u0431\u044b\u0447\u0430\u0439\u043d\u043e\u0435 \u0435\u0441\u0442\u27e61\u27e7 \u0432\u27e62\u27e7 \u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u0430\u0432\u0434\u0430. \u0412\u27e63\u27e7 \u044d\u0442\u043e\u043c\u27e64\u27e7", "slots": 4}, {"item_id": "k1bdb1dca61", "crop": "crops/92c3d9791747dc8f9f291d460dad2554db0cc7e548055d6edad36e90833fa3ed.png", "masked_text": "- \u0414\u0430. \u042f \u0435\u0435 \u043e\u0447\u0435\u043d\u27e61\u27e7 \u043b\u044e\u0431\u0438\u043b\u27e62\u27e7.", "slots": 2}, {"item_id": "k9963107075", "crop": "crops/665aa6504f694d314db0c0860c85b9d94e89e2559d68b39e471a70f4ae687b6a.png", "masked_text": "\u0421\u043b\u043e\u0432\u0430 \u044d\u0442\u0438, \u0431\u0435\u0437\u27e61\u27e7 \u0441\u043e\u043c\u043d\u0463\u043d\u0456\u044f, \u0441\u043a\u043e\u043d\u0444\u0443\u0437\u0438\u043b\u0438 \u0435\u0433\u043e; \u043a\u043e\u0433\u0434\u0430 \u044f \u043e\u043f\u044f\u0442\u27e62\u27e7", "slots": 2}, {"item_id": "k2d7e87b6a5", "crop": "crops/d0a22d69dd0ae99815995a6a2c925a92d321fbf9a416a548549bdaf918b386dc.png", "masked_text": "\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u043e\u0441\u27e61\u27e7 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u27e62\u27e7 \u0441\u043e\u0431\u044b\u0442\u0456\u0435\u043c\u27e63\u27e7 \u0438 \u043f\u0440\u0438\u0432\u043b\u0435-", "slots": 3}, {"item_id": "ka60519fc36", "crop": "crops/708d5b548b3aca58f09cc0714ba7aa95bb6662517da3a6e9cf1ad961f5f214e3.png", "masked_text": "\u0414\u0430\u043b\u27e61\u27e7 \u0438\u043c\u27e62\u27e7 \u0432\u043a\u0443\u0441\u0438\u0442\u27e63\u27e7 \u043e\u0442\u27e64\u27e7 \u0441\u0432\u0435\u0440\u043a\u0430\u044e\u0449\u0438\u0445\u27e65\u27e7 \u0441\u0438\u043b\u27e66\u27e7,", "slots": 6}, {"item_id": "kf12e890404", "crop": "crops/167b5b76aa331bb6100bb87308d5607912c060e5fcf8bc2f770e01717289f7f9.png", "masked_text": "\u0434\u0440\u0443\u0436\u043a\u0463, \u0463\u0434\u0443\u0442\u27e61\u27e7 \u0431\u0435\u0437\u27e62\u27e7 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u043e\u0432\u27e63\u27e7, \u043d\u0430 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430\u0445\u27e64\u27e7", "slots": 4}, {"item_id": "kaba91da923", "crop": "crops/73fbc1cf523b1cdac707d1f10c71bcdc9ccbef6d37e4163faa94a1a3f201b9a2.png", "masked_text": ",,\u0434\u043e\u0431\u0440\u044b\u0445\u27e61\u27e7 \u0422\u0432\u043e\u0438\u0445\u27e62\u27e7 \u0441\u043e\u043b\u0434\u0430\u0442\u27e63\u27e7 \u043d\u0430 \u041b\u0435\u0432\u0435\u043d\u0433\u043e\u0443\u043f\u0442\u0441\u043a\u043e\u0439 \u0431\u0430\u0442\u0430\u043b\u0456\u0438, \u043a\u043e\u0433\u0434\u0430", "slots": 3}, {"item_id": "k998775ce08", "crop": "crops/26632d1d9b76339f675683eba0a3d119a79b15dd48742aeed82f8a2356bd46cd.png", "masked_text": "\u043f\u0443\u0448\u043a\u0443 \u0432\u044b\u0434\u0443\u043c\u0430\u043b\u27e61\u27e7 \u043a\u0442\u043e-\u043d\u0438\u0431\u0443\u0434\u27e62\u27e7 \u0434\u0440\u0443\u0433\u043e\u0439, \u043f\u0440\u0438-", "slots": 2}, {"item_id": "k6c57be8256", "crop": "crops/f3d4b87e36da6e1b1ae82b22ce82b5d79d65bb682d35c3ce9027967b84c2247a.png", "masked_text": "\u0434\u043e\u043b\u0436\u0435\u043d\u27e61\u27e7 \u0437\u043d\u0430\u0442\u27e62\u27e7? \u041d\u0430 \u0447\u044c\u0435\u0439 \u044d\u0442\u043e \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0436\u0438\u0442\u27e63\u27e7:", "slots": 3}, {"item_id": "k0d73a61388", "crop": "crops/29d85cd5f2ec9606b01516adb11a094de6631d67511478f21a18f58cb99f29b6.png", "masked_text": "\u0434\u044b\u043c\u0438\u0442\u27e61\u27e7, \u043a\u0430\u043a\u27e62\u27e7 \u043f\u043b\u043e\u0445\u043e\u0439 \u043a\u043e\u0441\u0442\u0435\u0440\u27e63\u27e7 \u0438\u0437\u27e64\u27e7 \u0441\u044b\u0440\u044b\u0445\u27e65\u27e7 \u0432\u0463\u0442\u043e\u043a\u27e66\u27e7.", "slots": 6}, {"item_id": "k656a364723", "crop": "crops/617b61bcd820b8fd684fe0815b80dd44ee1319c9418eebc6598e7f8dd86318f0.png", "masked_text": "\u0436\u0438\u0432\u044b\u0445\u27e61\u27e7 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u0445\u27e62\u27e7, \u0443\u043d\u0430\u0441\u043b\u0463\u0434\u043e\u0432\u0430\u0432\u0448\u0438\u0445\u27e63\u27e7 \u043b\u0438\u0448\u27e64\u27e7 \u043c\u0430\u043b\u043e \u043e\u0431\u0449\u0430\u0433\u043e \u043e\u0442\u27e65\u27e7 \u043e\u0431-", "slots": 5}, {"item_id": "kdd40195682", "crop": "crops/6db34826bc9c159546a0138c61405cd3e8dd374fcf7fec89b6e9aa5352f71f6a.png", "masked_text": "\u0446\u0432\u0463\u0442\u043a\u0443 \u043e\u0434\u043d\u043e\u0433\u043e \u0432\u0438\u0434\u0430 \u043a\u0430\u043a\u043e\u0433\u043e-\u043b\u0438\u0431\u043e \u0440\u043e\u0434\u0430 \u0431\u044b\u0442\u27e61\u27e7 \u0438\u0437\u043c\u0463\u043d\u0447\u0438\u0432\u0463\u0435 \u043f\u043e \u043e\u043a\u0440\u0430\u0441\u043a\u0463", "slots": 1}, {"item_id": "k5bf8ef1716", "crop": "crops/cebf865c006e4860c017e8639cb33d177e10ca2222466e88db0e9ba40dbefff9.png", "masked_text": "\u0440\u043e\u0441\u043f\u0438\u0441\u0438. 1651 \u0433. \u0444\u0435\u0432\u0440\u0430\u043b\u27e61\u27e7.", "slots": 1}, {"item_id": "k36de89e825", "crop": "crops/dd610ca413b5ce7249e76baa9585f18d030d24f6604e531dfbb0010ba3e1cd35.png", "masked_text": "\u0448\u0443\u0442\u043a\u0443, \u043d\u043e \u044f \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u043b\u27e61\u27e7, \u043a\u0430\u043a\u27e62\u27e7 \u0440\u0430\u043d\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u27e63\u27e7 \u0438\u0433\u0440\u0430\u0442\u27e64\u27e7 \u043a\u043e-", "slots": 4}, {"item_id": "k9657ea2c66", "crop": "crops/4bc18b2f1fc3366a00a732042af32658a1913fe6e4253b4f0b14b55c875e5609.png", "masked_text": "\u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0442\u043e\u043c\u27e61\u27e7 \u043c\u0438\u0440\u0438\u0442\u044c\u0441\u044f \u0438 \u043f\u043e\u0446\u0463\u043b\u043e\u0432\u0430\u0442\u27e62\u27e7 \u043c\u0435\u043d\u044f. \u041d\u0435 \u0437\u0434\u0463\u0441\u27e63\u27e7 \u0441\u043b\u0463-", "slots": 3}, {"item_id": "k9eda5e6246", "crop": "crops/7d19c9432726491d30b4635f4b7e211ff3bf3716a274f2b74044825b7cda726f.png", "masked_text": "\u043d\u044b\u0435 \u043e\u043f\u0442\u0438\u0441\u043a\u0438 (\u0432\u27e61\u27e7 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0463 90 \u044d\u043a\u0437\u0435\u043c\u043f\u043b\u044f\u0440\u043e\u0432\u27e62\u27e7), \u0421\u043f\u0431.", "slots": 2}, {"item_id": "k3c9f2d13e6", "crop": "crops/601c1c8d4ea9115a3ae4dae724b916517ba9669522565bb6bab0fa4b2d272a3f.png", "masked_text": "\u042f \u043f\u043e\u0463\u0434\u0443 \u0432\u0437\u0433\u043b\u044f\u043d\u0443\u0442\u27e61\u27e7 - \u0445\u043e\u0442\u0438\u0442\u0435 \u0441\u043e \u043c\u043d\u043e\u0439?", "slots": 1}, {"item_id": "k40e5871f65", "crop": "crops/491c53ff05255097bf2bcf7e694d3684d3236b53f6e3f0cf135e2f4a3dc7c0ed.png", "masked_text": "\u0434\u0438\u0440\u0438\u0436\u0430\u0431\u043b\u27e61\u27e7, \u0442\u0430\u043a\u27e62\u27e7 \u0447\u0442\u043e \u043e\u043d\u27e63\u27e7 \u0432\u0432\u0435\u0440\u0445\u27e64\u27e7 \u0442\u043e\u0440\u043c\u0430\u0448-", "slots": 4}, {"item_id": "k78e51d261f", "crop": "crops/d7988d6dcb132a41127e0489a6b1af4408c0d8a6210a08ee9e342692e0977377.png", "masked_text": "\u0411\u044b\u043b\u27e61\u27e7 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u27e62\u27e7 \u0434\u043b\u044f \u0438\u0437\u0434\u0430\u043d\u0456\u044f \u041e\u0431\u0449\u0435\u0441\u0442\u0432\u0443, \u043d\u043e \u043d\u0435", "slots": 2}, {"item_id": "k75a00d078b", "crop": "crops/43ad61eb9833c2cb240366318e95da263ee86770124d519fd2cfe07271eb0de8.png", "masked_text": "\u043c\u0438\u0440 \u0445\u043e\u0442\u044f\u0442 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0442\u27e61\u27e7, \u0441\u043e\u0447\u0438\u043d\u044f\u044e\u0442 \u0443 \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u043e\u0433\u043e", "slots": 1}, {"item_id": "kbd28b366fe", "crop": "crops/51697a8a9afec7cd45aa7c81731d520e1f63d770a476da7ef524adb16e543fc3.png", "masked_text": "\u042f \u043b\u044e\u0431\u043b\u044e \u0432\u27e61\u27e7 \u0432\u0430\u0441\u27e62\u27e7 \u0432\u0430\u0448\u0435 \u0443\u0442\u0440\u043e, \u0432\u0430\u0448\u0443 \u0441\u043c\u0463\u043b\u043e\u0441\u0442\u27e63\u27e7 \u0438 \u043c\u0435\u0447\u0442\u044b,", "slots": 3}, {"item_id": "k716adc2581", "crop": "crops/fdc9c581a20992dbddc20674384503a5ae288a923645bdb98fa4564cc2cceca2.png", "masked_text": "\u0438\u0437\u27e61\u27e7 \u041a\u0430\u0431\u0438\u043d\u0435\u0442\u0430 \u0415\u0433\u043e \u0412\u0435\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 (\u0421\u0435\u0440\u0435\u0431\u0440\u044f\u043d\u043d\u0430\u044f \u0447\u0435\u0440\u043d\u0438\u043b\u27e62\u27e7-", "slots": 2}, {"item_id": "k7294c78ede", "crop": "crops/60fdbcfb177eccf5ee85d91b65d6f2904053627a9ffd4efbc4d9e20c72b5da76.png", "masked_text": "\u0423\u043b\u0435\u0433\u043b\u0438\u0441\u27e61\u27e7-\u0443\u0441\u0463\u043b\u0438\u0441\u27e62\u27e7 \u043d\u0430 \u0441\u043e\u043b\u043e\u043c\u0463: \u043b\u0438\u0446\u0430 \u0438\u0437\u043d\u0443\u0440\u0435\u043d-", "slots": 2}, {"item_id": "k64ee4cb280", "crop": "crops/02a24d8df5430f522832aa5b54d3bbf994e09b50f3110a5efc291b24d9a7e8e9.png", "masked_text": "\u0431\u0435\u0437\u27e61\u27e7 \u0438\u0437\u043c\u0463\u043d\u0435\u043d\u0456\u044f \u0441\u27e62\u27e7 \u043e\u0447\u0435\u043d\u27e63\u27e7 \u0434\u0430\u0432\u043d\u0438\u0445\u27e64\u27e7 \u0432\u0440\u0435\u043c\u0435\u043d\u27e65\u27e7. \u041f\u043e \u0442\u0435\u043e\u0440\u0456\u0438 \u043e\u0442\u0434\u0463\u043b\u044c\u043d\u044b\u0445\u27e66\u27e7", "slots": 6}, {"item_id": "k085ad94441", "crop": "crops/148cad8ca3465b962de598d88bc9171a8b7a21dad912de8e9b3238f9bc612efa.png", "masked_text": "\u043c\u043d\u0463\u043d\u043d\u043e \u0431\u0443\u0434\u0443\u0442\u27e61\u27e7 \u0432\u044b\u0437\u0432\u0430\u043d\u044b \u0435\u0433\u043e \u0441\u0442\u0430\u0442\u044c\u0435\u044e, \u043f\u0440\u0438\u043d\u0435\u0441\u0435\u0442\u27e62\u27e7 \u043c\u043e\u0436\u0435\u0442\u27e63\u27e7 \u0431\u044b\u0442\u27e64\u27e7", "slots": 4}, {"item_id": "k728988ae84", "crop": "crops/63a75709710f4a18e9f9572d7c815f117fd13c6584bf840c5f61fa8de2285974.png", "masked_text": "\u0443 \u0447\u043b\u0435\u043d\u043e\u0432\u27e61\u27e7 \u0441\u27e62\u27e7 \u043e\u0447\u0435\u043d\u27e63\u27e7 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u043c\u27e64\u27e7 \u043e\u0431\u0440\u0430\u0437\u043e\u043c\u27e65\u27e7 \u0436\u0438\u0437\u043d\u0438, \u043c\u044b \u043c\u043e\u0436\u0435\u043c\u27e66\u27e7 \u0441\u0447\u0438\u0442\u0430\u0442\u27e67\u27e7", "slots": 7}, {"item_id": "kfbf6a38e1d", "crop": "crops/43b8013da67d3ce02765d71935557a50fa4682cf6663b266697100ec6a9c906f.png", "masked_text": "\u042f \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430, \u0447\u0442\u043e \u0438\u0430 \u043a\u0440\u044b\u0448\u0443 \u043d\u0435\u043b\u044c\u0437\u044f \u0441\u0430\u0436\u0430\u0442\u27e61\u27e7 \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043e\u0432\u27e62\u27e7, \u2014", "slots": 2}, {"item_id": "k99eed6dbd4", "crop": "crops/a3cbf661449231eadc4d03802a47c6e93b22c46f4f83f4a3831bc69663efcd98.png", "masked_text": "\u0442\u043e\u043c\u0443 \u0418\u0433\u043e\u0440\u044e \u0412\u043b\u0430\u0434\u0438\u043c\u0456\u0440\u27e61\u27e7-\u0412\u043e\u043b\u044b\u043d\u0441\u043a\u0456\u0439, \u0432\u043d\u0443\u043a\u0443 \u0420\u043e\u0441\u0442\u0438\u0441\u043b\u0430\u0432\u0443 \u0412\u043b\u0430\u0434\u0438\u043c\u0456\u0440\u043e\u0432\u0438\u0447\u0443-", "slots": 1}, {"item_id": "k84abc21383", "crop": "crops/62fa9bc621c629de38006ad2c7f41213fe79b4ce52d0a1e2b39d6cb7dc3f5244.png", "masked_text": "\u0432\u0435\u043a\u043e\u043c-\u0434\u0432\u0443\u043c\u044f, \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u27e61\u27e7 \u0441\u043b\u043e\u0432\u043e \u00ab\u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0439\u00bb \u2014 \u043d\u0443\u0436\u043d\u043e", "slots": 1}, {"item_id": "k0c648912e7", "crop": "crops/164c84488f100eb449c01e9665e702d288b8797e02930d3f0e7d5af6bcd796a5.png", "masked_text": "\u0434\u0438\u043d\u0430\u043d\u0434\u27e61\u27e7 \u0406, \u043d\u0430 \u0415\u043b\u27e62\u27e7-\u0442\u0435\u043f\u0435, 7. VII. 1914), Artemisia laxa Frit. (\u043e\u0442\u27e63\u27e7 \u0426\u0430\u0440\u27e64\u27e7 \u0411\u043e\u0440\u0438\u0441\u27e65\u27e7 III,", "slots": 5}, {"item_id": "k913057a9f3", "crop": "crops/0495170bfb6f8a07e213c8043d24fb7ffe659fa1bde168f99e640e8be1f6cae0.png", "masked_text": "\u0441\u0442\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0431\u044b\u043b\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0435\u0442\u044b\u0440\u043d\u0430\u0434\u0446\u0430\u0442\u27e61\u27e7 \u043c\u0463\u0441\u044f\u0446\u0435\u0432\u27e62\u27e7; \u043d\u0430\u0434\u043e,", "slots": 2}, {"item_id": "kf1275540d8", "crop": "crops/7652e365867348c562d917706e45b7246ed44cd7499d194ecbb7251ae4c38a88.png", "masked_text": "\u0442\u0430\u043a\u27e61\u27e7 \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u27e62\u27e7 \u0436\u0430\u0440\u0438\u0442\u27e63\u27e7.", "slots": 3}, {"item_id": "ke51cf4c8c4", "crop": "crops/5b1f386b01ee6614706c67d95fb90a9920a5626c4401071612fb7f0642086ca7.png", "masked_text": "\u044d\u043f\u043e\u0445\u0443. \u041e\u043d\u27e61\u27e7 \u0442\u044f\u0433\u043e\u0442\u0438\u0442\u27e62\u27e7 \u043d\u0430\u0434\u27e63\u27e7 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438 \u0438 \u043f\u0440\u0438\u043c\u0438-", "slots": 3}, {"item_id": "k231b703b4a", "crop": "crops/1b3d7ce1c6f17ee9fbf6426babf9142ec903f4f2940ecab9248044e20cc3f5d6.png", "masked_text": "\u0442\u0430\u043a\u0438\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u043a \u0443\u0445\u0430\u0436\u0435\u0440 \u0438 \u0442\u0430\u043d\u0446\u0443\u043b\u044c\u043a\u0430. \u041f\u0443\u0441\u0442\u27e61\u27e7 \u0441\u043e\u0447\u0438-", "slots": 1}, {"item_id": "ke05370cc49", "crop": "crops/2dff41221ae36e174b06fee76bbc10c4d73fb8a63dc90d509af30752039c0606.png", "masked_text": "\u043c\u044b\u0441\u043b\u0438 \u043d\u0435 \u0437\u0430 \u0447\u0442\u043e \u0443\u0446\u0463\u043f\u0438\u0442\u044c\u0441\u044f; \u043e\u043d\u0430 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442\u27e61\u27e7 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u27e62\u27e7 \u0434\u0430\u043b\u27e63\u27e7-", "slots": 3}, {"item_id": "kfad5379c1d", "crop": "crops/44857c5f40303a4edbc1a20b28ede9c31d11b50d6211967d3f2ff87b66fc6cee.png", "masked_text": "\u043a\u043e\u0432\u044b\u043c\u27e61\u27e7. (\u041d\u0430\u043f\u0435\u0447\u0430\u0442\u0430\u043d\u044b \u043f\u043e\u0434\u27e62\u27e7 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0456\u0435\u043c\u27e63\u27e7 \u0421. \u0410. \u0411.).", "slots": 3}, {"item_id": "kfac67b2782", "crop": "crops/7cd91e86d0398b707a3c656eeec87d828c3951ce22953c710029f5952b50bed4.png", "masked_text": "\u0442\u0435\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0441\u044e\u0434\u0430, \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u0438\u0432\u0448\u0438\u0441\u27e61\u27e7 \u043a\u043e", "slots": 1}, {"item_id": "kdeb1ebeedc", "crop": "crops/eba6bfaeaee485d7391ef84ca01cd638cc450eb77958015988e6ac18d2fa53dd.png", "masked_text": "\u0434\u0432\u043e\u0439\u043a\u0430 \u043a\u0440\u0430\u0447\u043a\u0430, \u043a\u043e\u0438\u0442\u043e, \u0432\u27e61\u27e7 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u27e62\u27e7 \u043d\u0430 \u0432\u0441\u0438\u0447\u043a\u0438 \u043e\u0441\u0442\u0430\u043d\u0430\u043b\u0438 \u043f\u0430\u044f\u0446\u0438, \u0441", "slots": 2}, {"item_id": "k285576a06e", "crop": "crops/71efbe985817d36e98ca12220235ebb4283f2861a7e273ebc618b30ab3cd8f9f.png", "masked_text": "\u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u27e61\u27e7 \u043e\u0434\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0456\u0435 \u0438 \u0442\u0438\u043f\u0438\u0447\u043d\u043e\u0441\u0442\u27e62\u27e7 \u043a\u0430\u0436\u0434\u0430\u0433\u043e \u043e\u0442\u0434\u0463\u043b\u044c\u043d\u0430\u0433\u043e \u0432\u0438\u0434\u0430, \u043a\u0430\u0436-", "slots": 2}, {"item_id": "kcb1efde67b", "crop": "crops/843ef823444e6b4e8b3db521fd9b9f8947ce7d9fe2e0e161cce4d30aa136d57d.png", "masked_text": "\u0436\u0435\u0442\u27e61\u27e7 \u0431\u044b\u0442\u27e62\u27e7 \u043c\u043d\u0463 \u0442\u0430\u043a\u27e63\u27e7 \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u27e64\u27e7; \u043d\u043e \u0432\u27e65\u27e7 \u0434\u0435\u0441\u044f\u0442\u27e66\u27e7 \u0441\u27e67\u27e7 \u043f\u043e\u043b\u043e\u0432\u0438-", "slots": 7}, {"item_id": "k0b474c1a8e", "crop": "crops/b4508fad58daf0853c4e290b5db32f39233fdd8de5a94a14f538dfe147cf9c95.png", "masked_text": "\u043d\u044b \u0431\u044b\u043b\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u27e61\u27e7 \u043e\u0442\u0434\u0463\u043b\u044c\u043d\u044b\u044f \u0441\u0442\u0430\u0442\u044c\u0438. \u041d\u0430\u0438\u0432\u043d\u044b\u0439 \u0418\u0432\u0430\u043d\u27e62\u27e7 \u0441\u043a\u043e\u0442\u043d\u0438\u043a\u27e63\u27e7,", "slots": 3}, {"item_id": "kfbce9cb1f5", "crop": "crops/8a1d6ab4535ca995f582a631303f4d8fa03fc8b1e407e69628d780f1af6d8cdc.png", "masked_text": "\u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u27e61\u27e7 \u0435\u043c\u0443 \u0434\u0432\u0430 \u0438\u043b\u0438 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u043a\u0430\u043a\u0443\u044e-\u043d\u0438-", "slots": 1}, {"item_id": "k8b3ba3a48e", "crop": "crops/28d4cba3901755c6394352ba5f0b578289c9977e8194f09d256c80aec28fcdad.png", "masked_text": "\u043d\u044b\u0445\u27e61\u27e7 \u0440\u0430\u0437\u043d\u043e\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u0435\u0439, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u27e62\u27e7 \u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0430.", "slots": 2}, {"item_id": "k6dfd98868a", "crop": "crops/1a20024346aed6044150e47696db194acc1157db661c97e34a18bdf9d849aa8c.png", "masked_text": "\u0441\u0442\u044c\u044f\u043d\u27e61\u27e7 \u043a\u27e62\u27e7 \u0442\u043e\u043c\u0443, \u0447\u0442\u043e\u0431\u044b \u0446\u0463\u043b\u27e63\u27e7 \u043f\u043e\u043c\u0463\u0449\u0438\u043a\u0430 \u043c\u043e\u0433\u043b\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u27e64\u27e7 \u0432\u27e65\u27e7 \u0447\u0435\u043c\u27e66\u27e7-", "slots": 6}, {"item_id": "k45893a9b5a", "crop": "crops/9d3a2bd2fedcecc7b0f68f97a6a08a9bc6428b90f884adae5aef74778b54b231.png", "masked_text": "\u0442\u043e\u043c\u27e61\u27e7 \u043e\u043d\u27e62\u27e7 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u043b\u27e63\u27e7 \u0441\u0435\u0431\u044f: \u043a\u0430\u043a\u27e64\u27e7 \u0440\u0463\u0448\u0438\u0442\u27e65\u27e7? \u0418 \u043f\u043e\u0442\u043e\u043c\u27e66\u27e7 \u0441\u043f\u0440\u0430\u0448\u0438-", "slots": 6}, {"item_id": "ka01efba249", "crop": "crops/c6207db2bc82f97198d9ce7a67ff7bd412716799d26c7a64525056acbca5e44e.png", "masked_text": "\u041e\u043d\u27e61\u27e7 \u0432\u0430\u043c\u27e62\u27e7 \u0431\u0443\u0434\u0435\u0442\u27e63\u27e7 \u043e\u0447\u0435\u043d\u27e64\u27e7 \u0440\u0430\u0434\u044b.", "slots": 4}, {"item_id": "k3244f218b1", "crop": "crops/af7952d9597fe9784d029722a83f66dca0965d8cc5c8436a9f53111aeb7a76e3.png", "masked_text": "\u042f \u043f\u0440\u043e\u043a\u043b\u044f\u043d\u0443 \u0442\u0435\u0431\u044f \u0437\u0430 \u043d\u0438\u0437\u043e\u0441\u0442\u27e61\u27e7 \u043e\u0431\u043c\u0435\u043b\u0463\u043d\u044c\u044f,", "slots": 1}, {"item_id": "ke1302ab42a", "crop": "crops/7f24b638a0dd6516b856660ba72764f7fefe190e689bcdc938410d4218bd8486.png", "masked_text": "\u0447\u0430\u043b\u043e \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0456\u0435 \u0437\u0430\u0436\u0435\u0447\u27e61\u27e7 \u0431\u0443\u043c\u0430\u0436\u043a\u0443, \u0442\u043e\u0440\u0463\u043d\u0456\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0435\u043c\u0443 \u043e\u0447\u0435\u043d\u27e62\u27e7", "slots": 2}, {"item_id": "kc3e4afc6ba", "crop": "crops/ca4a5821bb23e78df10c4e1913c6128515bdc71ae425316d5c3a0afe78fa63e2.png", "masked_text": "\u043d\u043e\u0439 \u0448\u0435\u0439\u043a\u0463 \u0434\u043e\u0447\u0435\u0440\u0438. - \u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u2014 \u0441\u043a\u0430\u0437\u0430\u043b\u27e61\u27e7 \u043e\u043d\u27e62\u27e7, \u0443\u043b\u044b\u0431\u0430\u044f\u0441\u27e63\u27e7 \u0437\u0434\u043e-", "slots": 3}, {"item_id": "kc078bc2ae9", "crop": "crops/f0f9835ad1cccdf737fbcd321cc94008c513070090dd25ff5d2ffb4b315da9c0.png", "masked_text": "\u041f\u0443\u0441\u0442\u27e61\u27e7 \u0431\u0443\u0434\u0435\u0442\u27e62\u27e7 \u0432\u27e63\u27e7 \u0441\u043c\u0435\u0440\u0442\u27e64\u27e7 \u0442\u0432\u043e\u044f \u0438\u0433\u0440\u0430,", "slots": 4}, {"item_id": "k2e98b45ac1", "crop": "crops/f25cd20a1a69fa6798641b869b665b9b2d0684696beca1c15d05f53053e7950f.png", "masked_text": "\u0432\u0430\u044e\u0441\u27e61\u27e7, \u0438 \u0441\u0434\u0463\u043b\u0430\u044e \u0432\u0438\u0434\u27e62\u27e7, \u0447\u0442\u043e \u044f \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e", "slots": 2}, {"item_id": "k686be88bab", "crop": "crops/a38dc8c4d92ff0cbddd0900262e7d4563129885417a30f4bb3e5e6f12eb0789e.png", "masked_text": "\u043c\u0438\u0440\u0430\u044e\u0442\u27e61\u27e7 \u0437\u0438\u043c\u043e\u0439 \u043c\u0443\u0445\u0438, \u043d\u043e \u0435\u0434\u0432\u0430 \u043e\u0442\u0442\u0430\u044f\u043b\u0430 \u0432\u043e\u0434\u0430, \u043a\u0430\u043a\u27e62\u27e7 \u043e\u043d\u0438", "slots": 