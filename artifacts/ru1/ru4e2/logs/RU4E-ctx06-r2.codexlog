import json
calls=[\"ь\",\"ъь\",\"ььъ\",\"ъьъъ\",\"ъъьь\",\"ъь\",\"ьъъъъ\",\"ъ\",\"ьъъъ\",\"ъьъъ\",\"ъъъ\",\"ьь\",\"ъь\",\"ъ\",\"ьъ\",\"ьъ\",\"ъьъ\",\"ъъъ\",\"ъъъъ\",\"ъъь\",\"ъь\",\"ъъь\",\"ь\",\"ъьъ\",\"ь\",\"ъьъъьъъ\",\"ъьъ\",\"ьь\",\"ь\",\"ъъ\",\"ъъ\",\"ь\",\"ъъъ\",\"ъььъьъ\",\"ьъъ\",\"ъь\",\"ь\",\"ьъъъ\",\"ъъъь\",\"ъъ\",\"ъьъъ\",\"ъъь\",\"ъъьъ\",\"ъьъ\",\"ъъь\",\"ьь\",\"ъьъ\",\"ььъ\",\"ь\",\"ъьъъ\",\"ь\",\"ььъ\",\"ъъъ\",\"ъьъ\",\"ь\",\"ьъъъ\",\"ь\",\"ъъъъъ\",\"ьь\",\"ь\",\"ъъъ\",\"ьъььъъ\",\"ъь\",\"ъъъ\",\"ъъ\",\"ъъъ\",\"ьъ\",\"ьъъ\",\"ьъъ\",\"ъъъъ\",\"ь\",\"ьъь\",\"ъъъъ\",\"ъьъ\",\"ъъ\",\"ьъ\",\"ъь\",\"ьъъ\",\"ьъ\",\"ъъ\",\"ььъ\",\"ъъъ\",\"ъъ\",\"ъъъ\",\"ъьъ\",\"ъъьъ\",\"ьъъ\",\"ъъъ\",\"ъ\",\"ъъь\",\"ъъ\",\"ъъь\",\"ъъьь\",\"ъьъ\"]
u={\"12\":[\"тутъ\"],\"61\":[\"шарфъ\",\"знакъ\"]}
items=[json.loads(l) for l in open('items.jsonl')]
with open('answers.jsonl','w') as f:
 for n,(i,c) in enumerate(zip(items,calls),1):
  f.write(json.dumps(dict(item_id=i['item_id'],slots={str(k):v for k,v in enumerate(c,1)},confidence={str(k):'low' if n==55 else 'high' for k in range(1,len(c)+1)},unmarked_final_hard_signs=u.get(str(n),[]),pre1918='no' if n in [25,29,37,49,51,55,60] else 'yes',note=''),ensure_ascii=False)+'\\n')
assert len(items)==len(calls)
answers=[json.loads(l) for l in open('answers.jsonl')]
from collections import Counter
cnt=Counter()
for i,a in zip(items,answers):
 assert i['item_id']==a['item_id']
 expected={str(k) for k in range(1,i['slots']+1)}
 assert set(a['slots'])==set(a['confidence'])==expected
 assert all(v in ['ъ','ь','other','u'] for v in a['slots'].values())
 cnt.update(a['slots'].values())
print('Verified count, order, slot coverage:',len(answers))
print('Slot calls:',dict(cnt))
print('Items with unmarked final hard signs:',sum(bool(a['unmarked_final_hard_signs']) for a in answers))
