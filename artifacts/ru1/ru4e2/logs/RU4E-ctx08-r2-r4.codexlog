rs=[json.loads(x) for x in open('items.jsonl')];out=[json.loads(x) for x in open('answers.jsonl')]
for n,c in enumerate(['ьъ','ъьъ','ъьъъъ','ъъ'],91):
 r=rs[n-1];out.append(dict(item_id=r['item_id'],slots={str(i+1):x for i,x in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''))
with open('answers.jsonl','w') as f:
 for x in out:f.write(json.dumps(x,ensure_ascii=False)+'\\n')
assert len(rs)==len(out)
for r,a in zip(rs,out):
 assert r['item_id']==a['item_id']
 expected={str(i+1) for i in range(r['slots'])}
 assert set(a['slots'])==expected==set(a['confidence'])
 assert set(a['slots'].values())<={'ъ','ь','other','u'}
 assert set(a['confidence'].values())<={'high','low'}
 assert a['pre1918'] in ['yes','no','unclear']
c=collections.Counter(x for a in out for x in a['slots'].values())
print('Validated count, order, slot coverage:',len(out),'items;',dict(c),'unmarked items:',sum(bool(a['unmarked_final_hard_signs']) for a in out))
