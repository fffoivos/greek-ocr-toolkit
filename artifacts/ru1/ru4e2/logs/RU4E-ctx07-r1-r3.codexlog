/bin/zsh -lc "python3 - <<'PY'
import json,collections
r=list(map(json.loads,open('items.jsonl')))
with open('answers.jsonl','a') as f:
 for i,c in enumerate(['ъъьъ','ъьъ','ьъ','ъъьъ'],90):
  f.write(json.dumps(dict(item_id=r[i]['item_id'],slots={str(j+1):x for j,x in enumerate(c)},confidence={str(j+1):'high' for j in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')
a=list(map(json.loads,open('answers.jsonl')))
assert len(a)==len(r)
for x,y in zip(r,a):
 assert x['item_id']==y['item_id']
 expected={str(i+1) for i in range(x['slots'])}
 assert set(y['slots'])==expected==set(y['confidence'])
 assert all(v in ('ъ','ь','other','u') for v in y['slots'].values())
 assert all(v in ('high','low') for v in y['confidence'].values())
 assert y['pre1918'] in ('yes','no','unclear')
counts=collections.Counter(v for x in a for v in x['slots'].values())
print('Validated count, order, slot coverage:',len(a),'items')
print('Slot calls:',dict(counts))
print('Items with unmarked final hard signs:',sum(bool(x['unmarked_final_hard_signs']) for x in a))
