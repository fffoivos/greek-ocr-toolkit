/bin/zsh -lc "python3 - <<'PY'
import json,collections
items=[json.loads(l) for l in open('items.jsonl')]
answers=[json.loads(l) for l in open('answers.jsonl')]
assert len(items)==len(answers)
for item,ans in zip(items,answers):
 assert item['item_id']==ans['item_id']
 expected={str(i) for i in range(1,item['slots']+1)}
 assert set(ans['slots'])==expected
 assert set(ans['confidence'])==expected
 assert all(c in ['ъ','ь','other','u'] for c in ans['slots'].values())
 assert all(c in ['high','low'] for c in ans['confidence'].values())
 assert ans['pre1918'] in ['yes','no','unclear']
 assert isinstance(ans['unmarked_final_hard_signs'],list)
with open('answers.jsonl','w') as f:
 for ans in answers:
  f.write(json.dumps(ans,ensure_ascii=False)+'\\n')
counts=collections.Counter(v for a in answers for v in a['slots'].values())
print('Validated count, order, slot coverage:',len(answers),'items')
print('Slot calls:',dict(counts))
print('Items with unmarked final hard signs:',sum(bool(a['unmarked_final_hard_signs']) for a in answers))
