rows=[json.loads(x) for x in open('items.jsonl')]
with open('answers.jsonl','a') as f:
 for a,c in zip(rows[90:],['ь','ъъъъъъ','ъъъ','ъь']):
  f.write(json.dumps(dict(item_id=a['item_id'],slots=dict(zip(map(str,range(1,len(c)+1)),c)),confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes' if len(c)>1 else 'no',note=''),ensure_ascii=False)+'\\n')
a=[json.loads(x) for x in open('answers.jsonl')]
assert len(a)==len(rows)
for r,b in zip(rows,a):
 assert r['item_id']==b['item_id']
 keys={str(i) for i in range(1,r['slots']+1)}
 assert set(b['slots'])==keys==set(b['confidence'])
 assert set(b['slots'].values()) <= {'ъ','ь','other','u'}
 assert set(b['confidence'].values()) <= {'high','low'}
 assert b['pre1918'] in {'yes','no','unclear'}
print('items',len(a),'calls',dict(collections.Counter(v for b in a for v in b['slots'].values())),'unmarked_items',sum(bool(b['unmarked_final_hard_signs']) for b in a))
print('Validated count, order, and complete slot coverage.')
