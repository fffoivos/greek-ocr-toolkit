import json,collections
p='answers.jsonl';a=[json.loads(l) for l in open(p)];x=[json.loads(l) for l in open('items.jsonl')]
for row,c in zip(x[90:94],['ъъъ','ъъьъ','ьъ','ъьъ']):
 a.append(dict(item_id=row['item_id'],slots={str(i):v for i,v in enumerate(c,1)},confidence={str(i):'high' for i in range(1,len(c)+1)},unmarked_final_hard_signs=[],pre1918='yes',note=''))
with open(p,'w') as f:
 for v in a:f.write(json.dumps(v,ensure_ascii=False)+'\\n')
answers=[json.loads(l) for l in open(p)]
assert len(answers)==len(x)
counts=collections.Counter()
for inp,out in zip(x,answers):
 assert inp['item_id']==out['item_id']
 expected={str(i) for i in range(1,inp['slots']+1)}
 assert set(out['slots'])==expected
 assert set(out['confidence'])==expected
 assert all(v in ('ъ','ь','other','u') for v in out['slots'].values())
 assert all(v in ('high','low') for v in out['confidence'].values())
 assert out['pre1918'] in ('yes','no','unclear')
 counts.update(out['slots'].values())
print('Validated count, order, slot coverage:',len(answers),'items')
print('Slot calls:',dict(counts),'total',sum(counts.values()))
print('Items with unmarked final hard signs:',sum(bool(o['unmarked_final_hard_signs']) for o in answers))
