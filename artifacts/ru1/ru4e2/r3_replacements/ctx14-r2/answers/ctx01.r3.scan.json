  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows), 'items')\nPY",
    "python3 - <<'PY'\nimport subprocess\nsubprocess.run(['magick','zoom/002.png','-crop','1800x600+800+0','zoom/002-detail.png'])\nPY",
