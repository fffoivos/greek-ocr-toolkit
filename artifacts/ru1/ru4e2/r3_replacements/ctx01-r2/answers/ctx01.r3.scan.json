  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows),'crops enlarged')\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(x) for x in open('items.jsonl')]\nc=['ъъ','ъъ','ъ','ьъъъ','ь','ъъьъ','ъъ','ъъьь']\nwith open('answers.jsonl','w') as f:\n for a,s in zip(r,c):\n  f.write(json.dumps(dict(item_id=a['item_id'],slots={str(i+1):v for i,v in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=[],pre1918='no' if r.index(a)==4 else 'yes',note=''),ensure_ascii=False)+'\\n')\nPY",
