  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows),'items enlarged')\nPY",
    "python3 - <<'PY'\nimport json\nr=list(map(json.loads,open('items.jsonl')))\ncalls=['ъь','ь','ъъьъ','ьь','ьъьъъ']\nwith open('answers.jsonl','w') as f:\n for i,c in enumerate(calls):\n  f.write(json.dumps(dict(item_id=r[i]['item_id'],slots={str(j+1):x for j,x in enumerate(c)},confidence={str(j+1):'high' for j in range(len(c))},unmarked_final_hard_signs=[],pre1918='no' if i==3 else 'yes',note=''),ensure_ascii=False)+'\\n')\nPY",
