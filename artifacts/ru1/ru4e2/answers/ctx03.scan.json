  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03d}.png'],check=True)\nprint(len(rows), 'items enlarged')\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ьъъ','ьъъ','ьъъ','ь','ъъъ','ъь','ъь','ь','ъъьъ','ьъъ']\nwith open('answers.jsonl','w') as f:\n for i,s in enumerate(calls):\n  d=dict(item_id=rs[i]['item_id'],slots={str(j+1):c for j,c in enumerate(s)},confidence={str(j+1):'high' for j in range(len(s))},unmarked_final_hard_signs=[],pre1918='no' if i==7 else 'yes',note='')\n  f.write(json.dumps(d,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(x) for x in open('items.jsonl')]; ds=[json.loads(x) for x in open('answers.jsonl')]\nfor i,s in enumerate(['ъъъъьъъ','ьъъь','ь','ъъъъъ','ьъъ','ъъ','ь','ьь','ъъъьъ','ььь'],10):\n ds.append(dict(item_id=rs[i]['item_id'],slots={str(j+1):c for j,c in enumerate(s)},confidence={str(j+1):'high' for j in range(len(s))},unmarked_final_hard_signs=[],pre1918='no' if i in [12,19] else 'yes',note=''))\nwith open('answers.jsonl','w') as f:\n for d in ds:f.write(json.dumps(d,ensure_ascii=False)+'\\n')\nPY",
