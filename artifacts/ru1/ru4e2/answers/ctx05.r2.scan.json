  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(items):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ь','ъъъъъ','ь','ъъъъ','ъъъ']\nwith open('answers.jsonl','w') as f:\n for a,c,p in zip(r,calls,['yes','yes','no','yes','yes']):\n  f.write(json.dumps(dict(item_id=a['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\ncs=['ь','ъъъъ','ъъь','ъъъъ','ъъьъ']\nwith open('answers.jsonl','a') as f:\n for a,c in zip(rows[5:10],cs):\n  f.write(json.dumps(dict(item_id=a['item_id'],slots=dict(zip(map(str,range(1,len(c)+1)),c)),confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\ncs=['ьъ','ъъьъ','ь','ъъъ','ъъ']\nwith open('answers.jsonl','a') as f:\n for a,c,p in zip(rows[10:15],cs,['yes','yes','no','yes','yes']):\n  f.write(json.dumps(dict(item_id=a['item_id'],slots=dict(zip(map(str,range(1,len(c)+1)),c)),confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\nwith open('answers.jsonl','a') as f:\n for a,c,p in zip(rows[15:20],['ьъ','ь','ъ','ь','ъъьъьъ'],['yes','no','yes','yes','yes']):\n  f.write(json.dumps(dict(item_id=a['item_id'],slots=dict(zip(map(str,range(1,len(c)+1)),c)),confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
