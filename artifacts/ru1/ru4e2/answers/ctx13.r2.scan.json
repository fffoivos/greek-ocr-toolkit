  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json,subprocess\nitems=[json.loads(l) for l in open('items.jsonl')]\nfor i,x in enumerate(items):\n subprocess.run(['magick',x['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(l) for l in open('items.jsonl')]\nfor i,x in enumerate(items):\n subprocess.run(['magick',x['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json\ncalls=['ъъъ','ь','ьь','ь','ъъъъ','ъььь','ьъ','ъъ','ъь','ъь']\npre=['yes','yes','no','no','yes','yes','yes','yes','yes','yes']\nitems=[json.loads(l) for l in open('items.jsonl')]\nwith open('answers.jsonl','w') as f:\n for x,c,p in zip(items,calls,pre):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):a for i,a in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\\nimport json\\ncalls=json.loads('${JSON.stringify(cs)}')\\npre=json.loads('${JSON.stringify(ps)}')\\nitems=[json.loads(l) for l in open('items.jsonl')]\\nwith open('answers.jsonl','w') as f:\\n for n,(x,c,p) in enumerate(zip(items,calls,pre),1):\\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):a for i,a in enumerate(c)},confidence={str(i+1):('low' if n==19 else 'high') for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=('Lower part of line clipped.' if n==19 else '')),ensure_ascii=False)+'\\n')\\nPY",
