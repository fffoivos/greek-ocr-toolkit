  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows),sum(r['slots'] for r in rows))\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъь','ььъъъ','ььъ','ьъъ','ъь']\nwith open('answers.jsonl','w') as f:\n for r,s in zip(rows,calls):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):c for i,c in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
