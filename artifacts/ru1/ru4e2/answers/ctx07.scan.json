  "commands": [
    "cat items.jsonl",
    "python3 - <<'PY'\nimport json,subprocess,os\nitems=[json.loads(l) for l in open('items.jsonl')]\nos.makedirs('zoom',exist_ok=True)\nfor i,r in enumerate(items):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items),'images enlarged')\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ъъ','ъьъ','ъъь','ь','ьъъъ','ьъъъ','ь','ъьъ']\nwith open('answers.jsonl','w') as f:\n for r,c in zip(rs,calls):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):x for i,x in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ъъъ','ъъь','ъъъь','ъьъъ','ъъ','ььь','ьъъ','ъъъъ']\nwith open('answers.jsonl','a') as f:\n for r,c in zip(rs[8:],calls):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):x for i,x in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
