  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json,subprocess\nrows=[json.loads(l) for l in open('items.jsonl')]\nfor i,r in enumerate(rows,1):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i:03}.png'],check=True)\nprint(len(rows),'items')\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(l) for l in open('items.jsonl')]\nfor i,r in enumerate(rows,1):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i:03}.png'],check=True)\nprint(len(rows),'items')\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ъьъ','ьъ','ъъъь','ъь','ь']\nwith open('answers.jsonl','w') as f:\n for r,c in zip(rows,calls):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i):x for i,x in enumerate(c,1)},confidence={str(i):'high' for i in range(1,len(c)+1)},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(l) for l in open('items.jsonl')]\nwith open('answers.jsonl','a') as f:\n for n,c in enumerate(['ь','ъъь','ъъьъ','ьъъ','ъъъ'],6):\n  r=rows[n-1];f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i):x for i,x in enumerate(c,1)},confidence={str(i):'high' for i in range(1,len(c)+1)},unmarked_final_hard_signs=['жизненныхъ'] if n==8 else [],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(l) for l in open('items.jsonl')]\nwith open('answers.jsonl','a') as f:\n for n,c in enumerate(['ъьъ','ьъ','ъъь','ь','ъъъь'],11):\n  r=rows[n-1];f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i):x for i,x in enumerate(c,1)},confidence={str(i):'high' for i in range(1,len(c)+1)},unmarked_final_hard_signs=[],pre1918='no' if n==14 else 'yes',note=''),ensure_ascii=False)+'\\n')\nPY",
