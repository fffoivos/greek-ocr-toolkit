    "python3 - <<'PY'\nimport json,subprocess\nn=sum(1 for l in open('items.jsonl'))\nfor start in range(0,n,5):\n args=['magick']\n for i in range(start,min(start+5,n)):\n  args+=['(',f'zoom/{i+1:03}.png','-background','white','-splice','0x24',')']\n args+=['-background','white','-gravity','west','-append',f'zoom/group{start//5+1:02}.png']\n subprocess.run(args,check=True)\nprint(n)\nPY",
