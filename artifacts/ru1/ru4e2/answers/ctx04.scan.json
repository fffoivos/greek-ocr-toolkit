  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json,subprocess\nrows=[json.loads(l) for l in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i:03}.png'],check=True)\nprint(len(rows))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(l) for l in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i:03}.png'],check=True)\nprint(len(rows))\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ььъъъ','ъьъъ','ъъ','ъь','ъь']\nwith open('answers.jsonl','w') as f:\n for x,s in zip(r,calls):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):c for i,c in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
