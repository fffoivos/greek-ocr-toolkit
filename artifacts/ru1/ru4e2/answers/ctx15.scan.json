  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows))\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ььь','ьъ','ь','ьъъ','ъъь']\nwith open('answers.jsonl','w') as f:\n for x,c in zip(r,calls):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(x) for x in open('items.jsonl')]\ncs=['ь','ъъ','ъьъ','ъ','ъь','ьъъ','ьъъ','ъъъ','ъъъь','ъ']\nwith open('answers.jsonl','a') as f:\n for x,c in zip(r[5:],cs):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(x) for x in open('items.jsonl')]\ncs=['ь','ъ','ьъ','ь','ъ','ъьъь','ьъъъ','ь','ъ','ъьъ']\nwith open('answers.jsonl','a') as f:\n for n,(x,c) in enumerate(zip(r[15:],cs),16):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='no' if n in [16,19] else 'yes',note=''),ensure_ascii=False)+'\\n')\nPY",
