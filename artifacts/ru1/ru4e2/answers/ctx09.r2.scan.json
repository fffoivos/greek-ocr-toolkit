  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(items):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03d}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(items):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03d}.png'],check=True)\nprint(len(items))\nPY",
    "cat > answers.jsonl <<'EOF'\nEOF\npython3 - <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ьъъ','ъь','ьь','ъь','ь','ьъъ']\npre=['yes','yes','no','yes','no','yes']\nwith open('answers.jsonl','w') as f:\n for r,c,p in zip(items,calls,pre):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\nwith open('answers.jsonl','a') as f:\n for r,c in zip(items[6:12],['ь','ьъъьъ','ьъ','ъъь','ьъ','ъь']):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
