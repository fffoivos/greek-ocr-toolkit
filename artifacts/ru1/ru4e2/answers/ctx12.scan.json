  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows,1):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i:03}.png'],check=True)\nprint('items',len(rows))\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъъъ','ъъьь','ь','ьъ','ьь','ь','ь','ь']\nold=['yes','yes','no','yes','no','no','yes','no']\nwith open('answers.jsonl','w') as f:\n for r,c,p in zip(rows,calls,old):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i):s for i,s in enumerate(c,1)},confidence={str(i):'high' for i in range(1,len(c)+1)},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\ncs=['ъъ','ъъъ','ъъь','ъъъь','ьъ','ъьъ','ь','ь']; ps=['yes']*6+['no','yes']\na=[json.loads(x) for x in open('answers.jsonl')]\nfor r,c,p in zip(rows[len(a):],cs,ps):\n a.append(dict(item_id=r['item_id'],slots={str(i):s for i,s in enumerate(c,1)},confidence={str(i):'high' for i in range(1,len(c)+1)},unmarked_final_hard_signs=[],pre1918=p,note=''))\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x,ensure_ascii=False)+'\\n')\nPY",
