  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,x in enumerate(items):\n subprocess.run(['magick',x['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json\nI=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъь','ъъъ','ъъъъъъ','ь','ь']\nwith open('answers.jsonl','w') as f:\n for x,c,p in zip(I,calls,['yes','yes','yes','no','no']):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nI=[json.loads(x) for x in open('items.jsonl')]\nwith open('answers.jsonl','a') as f:\n for x,c,p in zip(I[5:10],['ь','ьъ','ь','ъъъь','ьъъъ'],['no','yes','no','yes','yes']):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
