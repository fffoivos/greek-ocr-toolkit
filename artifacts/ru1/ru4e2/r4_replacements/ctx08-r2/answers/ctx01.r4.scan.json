  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(items):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ьъ','ь','ъъъъ','ъь','ьъ','ъъь']\nwith open('answers.jsonl','w') as f:\n for r,c in zip(rows,calls):\n  f.write(json.dumps(dict(item_id=r['item_id'],slots={str(i+1):x for i,x in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='no' if r==rows[1] else 'yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nrs=[json.loads(x) for x in open('items.jsonl')]; out=[json.loads(x) for x in open('answers.jsonl')]\nfor n,c in enumerate(['ъъъ','ь','ъъъъьъ','ъъъьь','ьъ','ьь'],7):\n r=rs[n-1];out.append(dict(item_id=r['item_id'],slots={str(i+1):x for i,x in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='no' if n in [8,12] else 'yes',note=''))\nwith open('answers.jsonl','w') as f:\n for x in out:f.write(json.dumps(x,ensure_ascii=False)+'\\n')\nPY",
