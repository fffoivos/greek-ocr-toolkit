a=[json.loads(x) for x in open('answers.jsonl')]
assert len(a)==len(rs)
for r,v in zip(rs,a):
 assert r['item_id']==v['item_id']
 expected={str(i) for i in range(1,r['slots']+1)}
 assert set(v['slots'])==expected
 assert set(v['confidence'])==expected
 assert all(x in ['ъ','ь','other','u'] for x in v['slots'].values())
 assert all(x in ['high','low'] for x in v['confidence'].values())
 assert v['pre1918'] in ['yes','no','unclear']
c=collections.Counter(x for v in a for x in v['slots'].values())
print('Validated item count, order and complete slot coverage:',len(a))
print('Slot counts:',dict(c),'total:',sum(c.values()))
print('Items with unmarked final hard signs:',sum(bool(v['unmarked_final_hard_signs']) for v in a))
