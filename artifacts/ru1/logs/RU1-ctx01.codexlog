import json,collections
rs=[json.loads(x) for x in open('items.jsonl')]; old=[json.loads(x) for x in open('answers.jsonl')]
for i,s in enumerate(['ъъъ','ьъъ','ъъ'],84):
 old.append({'item_id':rs[i]['item_id'],'slots':{str(j+1):v for j,v in enumerate(s)},'confidence':{str(j+1):'high' for j in range(len(s))},'unmarked_final_hard_signs':[],'pre1918':'yes','note':''})
with open('answers.jsonl','w') as f:
