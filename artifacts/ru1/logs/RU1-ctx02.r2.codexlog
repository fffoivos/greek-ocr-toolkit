 a.append(dict(item_id=row['item_id'],slots={str(i+1):x for i,x in enumerate(s)},confidence={str(i+1):'high' for i in range(len(s))},unmarked_final_hard_signs=[],pre1918='yes',note=''))
with open('answers.jsonl','w') as f:
 for row in a: f.write(json.dumps(row,ensure_ascii=False)+'\\n')
assert len(a)==len(r)
for x,y in zip(r,a):
 assert x['item_id']==y['item_id']
 expected={str(i) for i in range(1,x['slots']+1)}
 assert set(y['slots'])==expected
 assert set(y['confidence'])==expected
 assert all(v in ['ъ','ь','other','u'] for v in y['slots'].values())
 assert all(v in ['high','low'] for v in y['confidence'].values())
 assert y['pre1918'] in ['yes','no','unclear']
counts=collections.Counter(v for x in a for v in x['slots'].values())
print('Validated count, order, slot coverage:',len(a),'items')
print('Slot calls:',dict(counts))
print('Items with unmarked final hard signs:',sum(bool(x['unmarked_final_hard_signs']) for x in a))
