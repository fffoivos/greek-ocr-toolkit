437\u0430\u043b\u27e62\u27e7 \u0430\u0440\u0435\u0441\u0442\u0430\u043d\u0442\u27e63\u27e7 \u0438 \u0432\u0441\u0442\u0430\u043b\u27e64\u27e7", "slots": 4}, {"item_id": "k58490b16c5", "crop": "crops/476f848995bd2967727a1832419b3c6d140ab7bedf19b1f6cb97c2350c37625f.png", "masked_text": "\u0434\u0435\u0448\u27e61\u27e7, \u043d\u0435\u0431\u043e\u0439\u0441\u27e62\u27e7! \u041f\u043e\u043d\u044f\u043b\u27e63\u27e7? \u041d\u0443? \u0421\u043c\u043e\u0442\u0440\u0438 - \u0431\u0438\u0442\u27e64\u27e7 \u0431\u0443\u0434\u0443!", "slots": 4}, {"item_id": "k95f11e798b", "crop": "crops/9efab73444dd2402225d74ce2880c204056652bd3825b1407b7f92f3dc24b8ab.png", "masked_text": "\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u0435\u0441\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0441\u0442\u27e61\u27e7 \u0432\u27e62\u27e7 \u0441\u043a\u0430\u0437\u0430\u043d\u0456\u0438 \u043e \u0413\u043e\u0441-", "slots": 2}, {"item_id": "k75c16a31ac", "crop": "crops/a164cdbb86a6ae49cfbd9e1c4079a3c0edc2c5730dd51f53ab1279dee0db5679.png", "masked_text": "\u0448\u0438\u0432\u0448\u0438\u0445\u0441\u044f \u043f\u0435\u0440\u0435\u0434\u27e61\u27e7 \u0438\u0445\u27e62\u27e7 \u0433\u043b\u0430\u0437\u0430\u043c\u0438, \u043d\u0430\u0437\u043e\u0432\u0443\u0442\u27e63\u27e7 \u044d\u0442\u043e \u0442\u0430\u043a\u27e64\u27e7.", "slots": 4}, {"item_id": "k69668d7a1e", "crop": "crops/e2104615f55f1ddbe0eed4b731d0f3ed32cd1b688014aac110553ef2c0787068.png", "masked_text": "\u043d\u0435 \u043c\u043e\u0433\u043b\u043e \u043d\u0430\u0440\u0443\u0448\u0438\u0442\u27e61\u27e7 \u0415\u0433\u043e \u0432\u043d\u0438\u043c\u0430\u043d\u0456\u044f, \u0438 \u041e\u043d\u27e62\u27e7 \u043f\u043e\u0447\u0442\u0438 \u043d\u0435", "slots": 2}, {"item_id": "k597818d3a9", "crop": "crops/44512752983a2af3742d384bc2857067fd5943eea50e4b27b23380ca7080ff62.png", "masked_text": "\u043f\u043e\u0440\u0443\u0447\u0430\u044e\u0442\u27e61\u27e7 \u043c\u0438\u043b\u043e\u0441\u0442\u0438 \u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443 \u0415\u0433\u043e \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u0430\u0433\u043e", "slots": 1}, {"item_id": "kbb22f62c73", "crop": "crops/59f89f6f602ee1ee5de2da30a991a4e3dc989159de75018052d2a3344f9a4752.png", "masked_text": "\u0438 \u0431\u0443\u0445\u27e61\u27e7 \u043d\u0430\u0437\u0435\u043c\u27e62\u27e7, \u043a\u0430\u043a\u27e63\u27e7 \u0441\u0442\u043e\u044f\u043b\u0430, \u043f\u043e\u0447\u0442\u0438 \u0440\u044f\u0434\u043e\u043c\u27e64\u27e7 \u0441\u043e \u043c\u043d\u043e\u0439.", "slots": 4}, {"item_id": "kcd1703edde", "crop": "crops/5d284e5c6eee29b211384fd7b721a3b1a0ffecfcf2dd734dd29c53ab00d0d2e6.png", "masked_text": "\u0432\u043e\u0437\u043b\u043e\u0436\u0438\u043b\u27e61\u27e7 \u043d\u0430 \u041d\u0435\u0433\u043e \u0432\u0435\u043b\u0438\u043a\u0456\u0439 \u0410\u0434\u043c\u0438\u0440\u0430\u043b\u27e62\u27e7 \u0438 \u041a\u0430\u043d\u0446\u043b\u0435\u0440\u27e63\u27e7 \u0413\u0440\u0430\u0444\u27e64\u27e7", "slots": 4}, {"item_id": "kef30c7f6c2", "crop": "crops/10ad44ead66deb90c2fcdefd40e79790a4f40fe3c61197fd3384c018aebaac23.png", "masked_text": "\u0406\u043e\u0430\u043d\u043d\u27e61\u27e7 \u043a\u0430\u0440\u0430\u043b\u27e62\u27e7 \u043d\u0435\u0432\u0438\u043d\u043d\u044b\u0445\u27e63\u27e7; \u0430 \u0432\u0438\u043d\u043e\u0432\u043d\u044b\u0439,", "slots": 3}, {"item_id": "k7c3f25f89a", "crop": "crops/25f8566e8e174f4e9ad96d42c442036bce625f0a4460b63666e33682fd73555e.png", "masked_text": "\u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0435\u0442\u27e61\u27e7.", "slots": 1}, {"item_id": "k833295277f", "crop": "crops/95cd7ad7476d47cde07b4f0362c739376e6bcc20f2eca93795467ccdfa6693a1.png", "masked_text": "\u0433\u043e\u043b\u0443\u0431\u0430\u0433\u043e \u0438 \u043a\u0440\u0430\u0441\u043d\u0430\u0433\u043e: \u043f\u043e \u0435\u0441\u0442\u27e61\u27e7, \u0441\u0440\u0435\u0434\u0438\u043d\u0443 \u0435\u0433\u043e \u0441\u043e-", "slots": 1}, {"item_id": "k242db33209", "crop": "crops/2f8281ac5b7de310ff70392ec08a1ad14400242f71686095e971d6740892b8a3.png", "masked_text": "\u041c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u043e\u0432\u27e61\u27e7", "slots": 1}, {"item_id": "k7ea7dccd02", "crop": "crops/4895098f500587b87f1c0c537a35e02ab58f6b4b132195c70199ef668b2effc0.png", "masked_text": "\u0413\u043e\u043b\u043e\u0432\u0438\u043d\u27e61\u27e7, \u044f\u043a\u043e \u043f\u0435\u0440\u0432\u044b\u0439 \u041a\u0430\u0432\u0430\u043b\u0435\u0440\u27e62\u27e7 \u0441\u0435\u0433\u043e \u041e\u0440\u0434\u0435\u043d\u0430.", "slots": 2}, {"item_id": "k3fc4f37d2c", "crop": "crops/c9dff3dcb0e6df878462f38f9388de0aaf957703af3d0b3ae436d4c05c54cdfa.png", "masked_text": "\u0438 \u043d\u0430 \u0434\u0440\u043e\u0431\u043d\u0438\u0446\u044b, 5 \u0433\u0440\u0438\u0432\u0435\u043d\u043e\u043a\u27e61\u27e7 \u0441\u0435\u0440\u0435\u0431\u0440\u0430, \u043f\u043e \u0441\u0447\u0435\u0442\u0443 \u0434\u0435\u043d\u044c\u0433\u0430\u043c\u0438 21 \u0440\u0443\u0431\u043b\u27e62\u27e7 2 \u0433\u0440\u0438\u0432\u043d\u044b.", "slots": 2}, {"item_id": "k190c3149f0", "crop": "crops/15abe7697e5ae7c1ce6376384d5861788c162abdace0a84b318f65b30cd42a73.png", "masked_text": "\u0412\u0438\u0446\u0435 - \u0410\u0434\u043c\u0438\u0440\u0430\u043b\u27e61\u27e7 \u041b\u043e\u0448\u0435\u0440\u27e62\u27e7 \u0432\u044b\u0448\u0435\u043b\u27e63\u27e7 \u0441\u27e64\u27e7 \u044d\u0441\u043a\u0430\u0434\u0440\u043e\u044e, \u0432\u27e65\u27e7 15", "slots": 5}, {"item_id": "k442ef7ac93", "crop": "crops/9442a80851094982c3f355686a71c758e8c68da8e871766daf84737c5e077113.png", "masked_text": "\u0431\u044b\u043b\u0438\u0446\u0430 \u043e \u041a\u043e\u0440\u043e\u043b\u27e61\u27e7 \u0412\u0435\u043d\u0433\u0435\u0440\u0441\u043a\u043e\u043c\u27e62\u27e7, \u043e \u0427\u0435\u0448\u0441\u043a\u043e\u043c\u27e63\u27e7 \u0438\u043b\u0438", "slots": 3}, {"item_id": "k0033adbd69", "crop": "crops/f5d18fc980815c8bb5530f8943b0cfbc0e1438bedbe7a07312ae0661d216fb65.png", "masked_text": "\u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0441\u0442\u0430\u0442\u043a\u0430\u043c\u0438 \u0441\u0442\u0430\u0440\u044b\u0445\u27e61\u27e7 \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u043e\u0432\u27e62\u27e7, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0433\u043e\u0434\u27e63\u27e7 \u043e\u0442\u27e64\u27e7 \u0433\u043e\u0434\u0443 \u0442\u0430\u044e\u0442\u27e65\u27e7,", "slots": 5}, {"item_id": "k574e944bae", "crop": "crops/e82fb6d507660a6779e18aed1c2fec2dcf7a6cfbe76e581f819c6602125fe14b.png", "masked_text": "\u0420\u0443\u043a\u043e\u043f\u0438\u0441\u27e61\u27e7 \u0431\u0435\u0437\u27e62\u27e7 \u043d\u0430\u0447\u0430\u043b\u0430 \u0438 \u043a\u043e\u043d\u0446\u0430. \u041e\u0431\u0440\u0430\u0437\u0447\u0438\u043a\u27e63\u27e7 \u0437\u0430\u043f\u0438\u0441\u0435\u0439:", "slots": 3}, {"item_id": "kbdb5be0f86", "crop": "crops/843d544bc1d1180867b984639265812bfab672f2f4b1fd69a19e15379a7eeb08.png", "masked_text": "\u043e\u0442\u27e61\u27e7 \u043f\u0443\u0434\u0440\u044b, \u043d\u0435\u0431\u0440\u0435\u0436\u043d\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0438\u0441\u27e62\u27e7 \u043d\u0430 \u043f\u043b\u0435-", "slots": 2}, {"item_id": "k70ccaf3c41", "crop": "crops/528f249d1cc33f35f41a5fb62364cf9fe9605e7d956c1a639e0b1edc39f6454a.png", "masked_text": "\u0438\u0437\u27e61\u27e7 \u0442\u043e\u0433\u043e \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0442\u27e62\u27e7", "slots": 2}, {"item_id": "k677c564e6d", "crop": "crops/f817b2085efdabd028c57131a1d9ef069268df9cf29bbfae0cf6d365cddf7b99.png", "masked_text": "\u043a\u0443\u0434\u0430-\u0442\u043e \u0438\u0437\u27e61\u27e7 \u0442\u044c\u043c\u044b, \u0431\u0440\u043e\u0441\u0438\u043b\u0438\u0441\u27e62\u27e7 \u043d\u0430 \u043d\u0430\u0441\u27e63\u27e7. \u0428\u0430\u043a\u0440\u043e, \u0432\u0441\u0435 \u0432\u0440\u0435-", "slots": 3}, {"item_id": "k69dbc8c32b", "crop": "crops/5a54f611e52757d558cd8f7f55dbf41da5039197c1876c6e7d4b08a6271c0b51.png", "masked_text": "\u0441\u0442\u0432\u043e\u043c\u27e61\u27e7 \u0406\u043e\u0430\u043d\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0447\u0440\u0435\u0437\u27e62\u27e7 \u0434\u0435\u0441\u044f\u0442\u27e63\u27e7 \u0434\u043d\u0435\u0439 \u0443\u0436\u0435", "slots": 3}, {"item_id": "k3a8b878da6", "crop": "crops/cb6a52a047e3306ca6fda1d50a2494e72e8737ad530604c43f5caf8073f1e275.png", "masked_text": "\u043c\u043e\u0436\u043d\u043e \u0442\u0430\u043a\u0436\u0435 \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u27e61\u27e7 \u0441\u27e62\u27e7 \u043e\u0431\u0440\u0430\u0437\u0446\u0430\u043c\u0438, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c\u0438 \u043d\u0430 \u0444\u0438\u0433. 64-66, \u043d\u043e \u0441\u0445\u043e\u0434\u0441\u0442\u0432\u043e", "slots": 2}, {"item_id": "kfeb5994d64", "crop": "crops/8f2f117960397e75d7bb5d2fd1f26cec9fa2d50a714729ca7e23a2a16b53899e.png", "masked_text": "\u0440\u0435\u0433\u27e61\u27e7, \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u0442\u043e\u043c\u27e62\u27e7 \u0440\u0430\u0437\u043c\u044b\u0442\u27e63\u27e7 \u043c\u043e\u0440\u0435\u043c\u27e64\u27e7", "slots": 4}, {"item_id": "ke9ceff53a0", "crop": "crops/5aa875241d29508552052cf967a552b7d6e0f355daaf64c2efa270c44cf7ec35.png", "masked_text": "\u0434\u0430 \u0434\u0432\u0430 \u0441\u0442\u0430\u0432\u0446\u0430 \u0441\u0435\u0440\u0435\u0431\u0440\u044f\u043d\u044b \u0436\u27e61\u27e7, \u043f\u043e\u0437\u043e\u043b\u043e\u0447\u0435\u043d\u044b. \u041f\u043e\u0434\u043f\u0438\u0441\u27e62\u27e7 \u0443 \u0441\u043a\u043e\u0432\u043e\u0440\u043e\u0434\u043e\u043a\u27e63\u27e7 \u0438 \u0443 \u0441\u0442\u0430\u0432\u0446\u043e\u0432\u27e64\u27e7", "slots": 4}, {"item_id": "kd26968d0be", "crop": "crops/b081a1521ee6ce157e408e5b8b5f415acb07afa5af50ada428b372237ffc8e04.png", "masked_text": "\u0434\u0432\u0435\u0440\u0438 \u0442\u0435\u043c\u043d\u0438\u0446\u044b \u0438 \u0445\u043e\u0442\u0438\u0442\u0435 \u0432\u044b\u0442\u043e\u043b\u043a\u043d\u0443\u0442\u27e61\u27e7 \u043a\u043e\u043b\u043e\u0434\u043d\u0438\u043a\u0430 \u0432\u27e62\u27e7", "slots": 2}, {"item_id": "k2edb2a5da8", "crop": "crops/f29c9d339f102a44632467b32e0e70f2c9e7bc7b4dd90f19e4da11902313d01d.png", "masked_text": "\u0442\u043e\u0442\u27e61\u27e7. - \u041a\u0430\u043a\u27e62\u27e7 \u043e\u0442\u0435\u0446\u27e63\u27e7 \u0443 \u043c\u0435\u043d\u044f \u0443\u043c\u0435\u0440\u27e64\u27e7, \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u043e \u043c\u0430\u043b\u043e\u0435, \u043c\u0430\u0442\u27e65\u27e7", "slots": 5}, {"item_id": "k60d5f6208a", "crop": "crops/5ed173ecd0d47ee4c2105ad0395a5f6c1a86ab3a13c1817637a505846ad96ebb.png", "masked_text": "\u043e\u043d\u0430 \u0443\u0437\u043a\u0430, \u0447\u0442\u043e \u0447\u0435\u0440\u0435\u0437\u27e61\u27e7 \u043f\u0435\u0440\u0435\u0441\u043a\u043e\u0447\u0438\u0442\u27e62\u27e7 \u043c\u043e\u0436\u043d\u043e,", "slots": 2}, {"item_id": "k03082c687c", "crop": "crops/a91695c6365f6f8d2d67f7f78da74927073b0cfab1d6df227a160e0a8b5622a4.png", "masked_text": "\u043f\u043e\u0442\u0435\u0440\u044f\u0442\u27e61\u27e7 \u0435\u0433\u043e, \u044d\u0442\u043e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0456\u0435, ultinia", "slots": 1}, {"item_id": "k0c40090acf", "crop": "crops/6ecdc71079f5e44df300ea34e66a806db21fb02beb256de42c94ecfd197abd34.png", "masked_text": "\u043c\u043e\u043b\u043e\u0434\u0443\u044e \u0420\u0443\u0441\u27e61\u27e7, \u043e\u0442\u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d\u043e \u0431\u044b\u043b\u043e \u043d\u0430 \u0418\u0441\u0430\u043a\u0456\u0435\u0432\u0441\u043a\u043e\u0439", "slots": 1}, {"item_id": "k253c000c36", "crop": "crops/b2481c5f3b515cabe29010f462804b8774e77d2561cab71b58f0942a6fdfd3a1.png", "masked_text": "\u043e\u0434\u043d\u043e\u0433\u043e \u0438 \u0442\u043e\u0433\u043e-\u0436\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0456\u044f, \u043a\u27e61\u27e7 \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043c\u044b \u043f\u0440\u0456\u0443\u0447\u0438\u043b\u0438\u0441\u27e62\u27e7;", "slots": 2}, {"item_id": "k93c98795bc", "crop": "crops/c6936c45f1ebb66afd9ba42b5bcab04b90d79f701d6f43fbda53369e952ac2df.png", "masked_text": "\u0410 \u0442\u044b \u0447\u0442\u043e \u0434\u0443\u043c\u0430\u0435\u0448\u27e61\u27e7?", "slots": 1}, {"item_id": "k882fed9867", "crop": "crops/df41818d92e9c5558c6389f8463afcdbff4bab12c4d5efa3aaebbfe3e8f7c0dd.png", "masked_text": "\u043b\u0430 \u0435\u0433\u043e \u0431\u0435\u0440\u0435\u0447\u27e61\u27e7 \u0441\u0432\u043e\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u043f\u0440\u043e\u0441\u0438\u043b\u0430 \u0438", "slots": 1}, {"item_id": "k3084606650", "crop": "crops/0c375d829e67e3b8f27aecdf6cbbe680301c6ba91a6ce46bb1613222835e2468.png", "masked_text": "\u0442\u0430\u043d\u0441\u043a\u0430\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430, \u0441\u043a\u0440\u044b\u043b\u0438\u0441\u27e61\u27e7 \u0432\u27e62\u27e7 \u0434\u0430\u043b\u044c\u043d\u0438\u0445\u27e63\u27e7 \u0441\u0442\u0435-", "slots": 3}, {"item_id": "k965771cb22", "crop": "crops/2196d9d8362d1d6e4137cecc7891f2dcf6d1a4cc770ac6e8cc5c457217e66381.png", "masked_text": "\u043f\u0438\u043b\u0438\u0441\u27e61\u27e7 \u0432\u27e62\u27e7 \u0437\u0430\u043b\u0430\u0445\u27e63\u27e7, \u0432\u27e64\u27e7 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0445\u27e65\u27e7. \u041d\u044f\u043d\u044f", "slots": 5}, {"item_id": "k8cd7657588", "crop": "crops/7c0037208370fa792f92c6900bbce4fa4b43e852b2fee4da12ae3f6e6ba37065.png", "masked_text": "\u0442\u043e\u0440\u044b\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u043b\u27e61\u27e7 \u041f\u0415\u0422\u0420\u042a \u0412\u0435\u043b\u0438\u043a\u0456\u0439. \u0428\u0430\u0440\u0444\u044b, \u043f\u043e\u043b\u0430\u0433\u0430\u044f", "slots": 1}, {"item_id": "k458cebaa88", "crop": "crops/cf544b246beecaddeea3929a7122bd72f941d2ef4f6f794d57c39a2104a3e1e3.png", "masked_text": "\u043d\u044b \u0437\u0430\u043a\u043b\u044e\u0447\u0438\u0442\u27e61\u27e7 \u043c\u043e\u0436\u043d\u043e, \u0447\u0442\u043e \u0441\u0438\u0445\u27e62\u27e7 \u0443\u0442\u0435\u0441\u043e\u0432\u27e63\u27e7", "slots": 3}, {"item_id": "kbf782460d5", "crop": "crops/f2f3a2b4be3225c498679ecd617701e4150047ed620606f8db015bf65cd2e3e5.png", "masked_text": "\u0415\u0444\u0438\u043c\u0443\u0448\u043a\u0430 \u0441\u043d\u043e\u0432\u0430 \u0437\u0430\u043c\u043e\u043b\u0447\u0430\u043b\u27e61\u27e7 \u0438, \u043f\u0435\u0440\u0435\u043c\u0438\u043d\u0430\u044f\u0441\u27e62\u27e7 \u0441\u27e63\u27e7 \u043d\u043e\u0433\u0438", "slots": 3}, {"item_id": "keb33c587e2", "crop": "crops/6c0d25b615d38ad4a93d725163c10f5f6e1e3ef3a8f707125b9c0260d72188f6.png", "masked_text": "\u043d\u0430\u0432\u0430\u043b\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u043d\u0435\u0433\u043e, \u0441\u043a\u0440\u0443\u0442\u0438\u0442\u27e61\u27e7 \u0435\u043c\u0443 \u0440\u0443\u043a\u0438, \u0434\u0430\u0442\u27e62\u27e7 \u0440\u0430\u0437\u0430 \u0434\u0432\u0430", "slots": 2}, {"item_id": "k83ea5ec31e", "crop": "crops/d359c38d5d3d8572da00f50a186bda90909806466ef696e0de3070e080dcfcd9.png", "masked_text": "\u043e\u0434\u043d\u0430\u043a\u043e, \u043d\u0438 \u0433\u0443\u0433\u0443. \u0410 \u043e\u043d\u0430 \u0440\u0435\u0432\u0435\u0442\u27e61\u27e7. \u0422\u043e\u0441\u043a\u0430 \u043c\u0435\u043d\u044f \u0432\u0437\u044f\u043b\u0430.", "slots": 1}, {"item_id": "k05df3b7da2", "crop": "crops/ad3c42430e743cbe504383ab52964889dfc76158d523937f455bcc169f7fe00c.png", "masked_text": "\u0442\u043e: \u0432\u27e61\u27e7 \u0441\u0442\u0435\u043f\u0438 \u043b\u0438 \u0436\u0438\u0432\u0443\u0442\u27e62\u27e7 \u043e\u043d\u0438, \u0438\u043b\u0438 \u043d\u0430 \u043e\u043a\u0440\u0430\u0439\u0438\u0430\u0445\u27e63\u27e7", "slots": 3}, {"item_id": "k87d9b5135f", "crop": "crops/74b99a79b0c5e78f15ffc76df8a1f1a83a6c80940183b3c05003e4265f104952.png", "masked_text": "\u0441\u0442\u0432\u043e, \u0441\u043e\u0441\u0442\u043e\u0438\u0442\u27e61\u27e7 \u0438\u0437\u27e62\u27e7 \u0447\u0438\u0441\u0442\u0430\u0433\u043e \u0441\u0435\u0440\u0435\u0431\u0440\u0430, \u0438 \u0441\u27e63\u27e7 \u0432\u044b\u043f\u0443\u043a\u043b\u043e\u0439", "slots": 3}, {"item_id": "k7a49329a57", "crop": "crops/fd3faba5644c6c2678caf79aee0bd94e437e3f7d02c66d8c07dffaa0554e53c4.png", "masked_text": "\u0432\u043e\u043f\u0440\u043e\u0441\u044b, \u043e\u0442\u0432\u0435\u0440\u043d\u0443\u0432\u0448\u0438\u0441\u27e61\u27e7 \u043e\u0442\u27e62\u27e7 \u043f\u0430\u0440\u043d\u044f.", "slots": 2}, {"item_id": "k4f92002cd9", "crop": "crops/d4029207b8bba5bca51b9087787ef16b12f52e439920679723e0e5aa2ff4330e.png", "masked_text": "\u0441\u0432\u044b\u0441\u043e\u043a\u0430; \u0442\u0430\u043a\u27e61\u27e7 \u043a\u0430\u043a\u27e62\u27e7 \u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u0441\u0443\u0434\u044f\u0442\u27e63\u27e7 \u0436\u0438\u0437\u043d\u27e64\u27e7 \u043f\u043e", "slots": 4}, {"item_id": "kad65a946c0", "crop": "crops/be1cf4cf8c530fcbdf80d816e442e10f10f717410c2063f65a7e8b13cad4a2af.png", "masked_text": "\u043a\u043e\u0442\u043e\u0440\u043e\u043c\u27e61\u27e7 \u0432\u27e62\u27e7 \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438 \u0438 \u0437\u0438\u0436\u0434\u0435\u0442\u0441\u044f \u0432\u0435\u0441\u27e63\u27e7 \u043f\u0440\u0430\u0432\u043e\u0432\u043e\u0439 \u043f\u043e\u0440\u044f\u0434\u043e\u043a\u27e64\u27e7 -", "slots": 4}, {"item_id": "k0b7d09c615", "crop": "crops/a580fe760a3e8be6c8eb37a53afdfdb1d653074e6bdb793754b1d3ecad4fa89e.png", "masked_text": "\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0456\u0435 \u0432\u0435\u0441\u044c\u043c\u0430 \u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u043e, \u0432\u0448\u0435\u043b\u27e61\u27e7 \u0432\u27e62\u27e7 \u0433\u043e\u0440\u043e\u0434\u27e63\u27e7 \u043f\u0440\u0438", "slots": 3}, {"item_id": "ka22be34b32", "crop": "crops/24f2144d8677b301d3f0c72377f60cb2bee501799e8da5efa4c7aed0db5bd097.png", "masked_text": "\u043d\u043e\u0441\u0438\u0442\u27e61\u27e7 \u0438\u043b\u043e\u0434\u044b \u0432\u27e62\u27e7 \u0442\u0430\u043a\u043e\u043c\u27e63\u27e7 \u0438\u0437\u043e\u0431\u0438\u043b\u0456\u0438, \u0447\u0442\u043e \u0438\u0441 \u0442\u043e\u043b\u044c\u043a\u043e", "slots": 3}, {"item_id": "k987919581c", "crop": "crops/b21dd886c9d5b5ba17979fca3ba93bd3283ec75270c24e9011bd87d61410577d.png", "masked_text": "\u043f\u043b\u0435\u0447\u0438\u043a\u0438 \u0434\u0440\u043e\u0436\u0430\u0442\u27e61\u27e7-\u0434\u0440\u043e\u0436\u0430\u0442\u27e62\u27e7... \u0430 \u0438\u0437\u27e63\u27e7 \u0433\u043b\u0430\u0437\u27e64\u27e7-\u0442\u043e \u0441\u043b\u0435\u0437\u044b \u043a\u0440\u0443\u043f-", "slots": 4}, {"item_id": "k1e208584f8", "crop": "crops/0454d05f74efa4fd02db824724d865af78d1bd1a93e1589c5ca9ba83a2a8f2e5.png", "masked_text": "\u043e\u043d\u0438 \u044d\u0442\u043e\u0433\u043e \u0445\u043e\u0442\u044f\u0442\u27e61\u27e7, \u0430 \u043c\u044b \u043d\u0435 \u0445\u043e\u0442\u0438\u043c\u27e62\u27e7; \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u0438", "slots": 2}, {"item_id": "k2d64d44f51", "crop": "crops/48c0a14391715d29f9bc02ed873890caaec59e719f8bb6b225969caab135cc9e.png", "masked_text": "\u043f\u0438\u0441\u0430\u043b\u27e61\u27e7, \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438 \u0431\u044b\u043b\u0438 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u044b \u0438 \u0433\u043e\u0442\u043e-", "slots": 1}, {"item_id": "kfe7a0bc343", "crop": "crops/45a28d7cff0e6574dac0fe7dd1377144a3d84fce12670b683a9384cde2aa7116.png", "masked_text": "\u0417\u043d\u0430\u043a\u043e \u041e\u0444\u0438\u0446\u0435\u0440\u0441\u043a\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u043e\u0441\u0438\u043b\u27e61\u27e7 \u0415\u0433\u043e \u0412\u0435\u043b\u0438\u0447\u0435-", "slots": 1}, {"item_id": "k1b295773e1", "crop": "crops/22f4b54c4c7ab3280b1c9e566879f3e771aaef38c41d143c53565a05413a8990.png", "masked_text": "\u041