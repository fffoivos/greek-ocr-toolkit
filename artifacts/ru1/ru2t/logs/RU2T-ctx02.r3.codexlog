  r=rows[i-1]; cs=s.split()[0]; pre=s.split()[1] if len(s.split())>1 else 'yes'
  out.append(dict(item_id=r['item_id'],slots={str(j):c for j,c in enumerate(cs,1)},confidence={str(j):('low' if j in low.get(i,[]) else 'high') for j in range(1,len(cs)+1)},unmarked_final_hard_signs=extras.get(i,[]),pre1918=pre,note=''))
 with open('answers.jsonl','w') as f:
