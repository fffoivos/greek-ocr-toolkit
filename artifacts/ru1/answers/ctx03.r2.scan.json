  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(x) for x in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows))\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъъ','ъъьъъ','ъъьъ','ъъ','ьъъ']\nwith open('answers.jsonl','w') as f:\n for a,c in zip(r,calls):\n  f.write(json.dumps(dict(item_id=a['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъъъ','ъъъъъь','ъ','ъьъъ','ьъъъ']\nwith open('answers.jsonl','a') as f:\n for a,c in zip(r[5:],calls):\n  f.write(json.dumps(dict(item_id=a['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nr=[json.loads(x) for x in open('items.jsonl')]\ncalls=['ъ','ъъъъ','ъъь','ь','ьъъ','ъъъъъ']\nwith open('answers.jsonl','a') as f:\n for a,c in zip(r[10:],calls):\n  f.write(json.dumps(dict(item_id=a['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=['въ'] if a==r[13] else [],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
