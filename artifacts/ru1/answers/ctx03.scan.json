  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json, subprocess\nitems=[json.loads(l) for l in open('items.jsonl')]\nfor i,x in enumerate(items):\n subprocess.run(['magick',x['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(items),'items enlarged')\nPY",
    "python3 - <<'PY'\nimport json\nxs=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ъьъь','ь','ь','ъъь','ь','ь']\npre=['yes','yes','no','yes','yes','no']\nwith open('answers.jsonl','w') as f:\n for x,c,p in zip(xs,calls,pre):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nxs=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ь','ьъъ','ъьъь','ъъъъ','ь','ь']; pre=['no','yes','yes','yes','yes','yes']\nwith open('answers.jsonl','a') as f:\n for x,c,p in zip(xs[6:],calls,pre):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918=p,note=''),ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nxs=[json.loads(l) for l in open('items.jsonl')]\ncalls=['ъ','ъъъ','ь','ъьъ','ъь','ъъъьъ']\nwith open('answers.jsonl','a') as f:\n for x,c in zip(xs[12:],calls):\n  f.write(json.dumps(dict(item_id=x['item_id'],slots={str(i+1):v for i,v in enumerate(c)},confidence={str(i+1):'high' for i in range(len(c))},unmarked_final_hard_signs=[],pre1918='yes',note=''),ensure_ascii=False)+'\\n')\nPY",
