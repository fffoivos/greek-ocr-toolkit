  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json,subprocess\nrows=[json.loads(s) for s in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nrows=[json.loads(s) for s in open('items.jsonl')]\nfor i,r in enumerate(rows):\n subprocess.run(['magick',r['crop'],'-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nprint(len(rows))\nPY",
    "cat > zoom/write_answers.py <<'PY'\nimport json\nrows=[json.loads(s) for s in open('items.jsonl')]\ncalls=[]\nextras={}\npre={}\nnotes={}\ndef add(s):\n calls.extend(s.split())\ndef save():\n with open('answers.jsonl','w') as f:\n  for i,s in enumerate(calls):\n   r=rows[i]\n   out=dict(item_id=r['item_id'],slots={str(j+1):v for j,v in enumerate(s)},confidence={str(j+1):'high' for j in range(len(s))},unmarked_final_hard_signs=extras.get(i+1,[]),pre1918=pre.get(i+1,'yes'),note=notes.get(i+1,''))\n   f.write(json.dumps(out,ensure_ascii=False)+'\\n')\nadd('ъъъ ъъь ъьъ ь ъъ ьъъъ ъьъъъ ъъ')\nsave()\nPY\npython3 zoom/write_answers.py",
    "cat >> zoom/write_answers.py <<'PY'\nadd('ъъъ ьъ ь ъьь ъъъъ ьъ ъъъъ ъъъъь')\npre[11]='no'\nsave()\nPY\npython3 zoom/write_answers.py",
    "cat >> zoom/write_answers.py <<'PY'\nadd('ъ ь ъьь ъъъь ъъь ъъ ъ ъьъ')\npre[18]='no'\nsave()\nPY\npython3 zoom/write_answers.py",
    "cat >> zoom/write_answers.py <<'PY'\nadd('ъъъ ъь ьъь ьь ь ь ь ъ')\nfor i in (29,30,31): pre[i]='no'\nsave()\nPY\npython3 zoom/write_answers.py",
    "magick zoom/034.png -crop 900x220+1000+0 -resize 200% zoom/034-detail.png\nmagick zoom/036.png -crop 480x220+0+0 -resize 200% zoom/036-detail.png",
    "magick identify -format '%f %wx%h\\n' zoom/034.png zoom/036.png",
    "magick zoom/036.png -crop 600x324+0+0 zoom/036-slot1.png",
    "cat >> zoom/write_answers.py <<'PY'\nadd('ъъ ьъь ь ъъъ ъьъъ ъъъь ъъъъ ъь')\nsave()\nPY\npython3 zoom/write_answers.py",
    "cat >> zoom/write_answers.py <<'PY'\nadd('ъъь ьъ ъъъ ъъъъъъъ ъъъъь ъь ь ъъъ')\ncalls[35]='uъъ'\nnotes[36]='Первый знак сильно стерт; верхний флаг неразличим.'\npre[47]='no'\nextras[48]=['шарфъ','знакъ']\nsave()\nPY\npython3 zoom/write_answers.py",
    "cat >> zoom/write_answers.py <<'PY'\nadd('ьъ ъ ь ъъь ъь ъъ ъъ ььъ')\npre[51]='no'\nsave()\nPY\npython3 zoom/write_answers.py",
    "cat >> zoom/write_answers.py <<'PY'\nadd('ъъъъъ ъ ъьъь ъъьъ ъ ьъъь ъьъъ ъь')\nsave()\nPY\npython3 zoom/write_answers.py",
    "cat >> zoom/write_answers.py <<'PY'\nadd('ъъъъ ьъ ъъ ь ь ъ ьь ьь')\nfor i in (69,71,72): pre[i]='no'\nsave()\nPY\npython3 zoom/write_answers.py",
