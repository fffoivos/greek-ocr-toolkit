import json,collections
x=[json.loads(l) for l in open('items.jsonl')];a=[json.loads(l) for l in open('answers.jsonl')]
for it,m in zip(x[len(a):],['baseline dot','en dash','hyphen','space']): a.append(dict(item_id=it['item_id'],answer=next(k for k,v in it['options'].items() if v==m),confidence='high',note=''))
open('answers.jsonl','w').write(''.join(json.dumps(i)+'\\n' for i in a))
a=[json.loads(l) for l in open('answers.jsonl')]
assert len(a)==len(x)==89
assert [i['item_id'] for i in a]==[i['item_id'] for i in x]
assert all(i['answer'] in it['options'] for it,i in zip(x,a))
assert all(i['confidence'] in ('high','low') for i in a)
print('Verified count, order, and option letters:',len(a))
c=collections.Counter(it['options'][i['answer']] for it,i in zip(x,a))
print(json.dumps(dict(c),sort_keys=True))
print('Low confidence:',sum(i['confidence']=='low' for i in a))
