/bin/zsh -lc "python3 - <<'PY'
import json
x=[json.loads(s) for s in open('items.jsonl')]
a=[('em dash','high'),('other','high'),('hyphen','high'),('baseline dot','high'),('em dash','low')]
with open('answers.jsonl','w') as f:
 for r,(m,c) in zip(x,a):
  f.write(json.dumps(dict(item_id=r['item_id'],answer=next(k for k,v in r['options'].items() if v==m),confidence=c,note=''))+'\\n')
print(json.dumps(x))
