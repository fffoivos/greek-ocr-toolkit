x=[json.loads(s) for s in open('items.jsonl')]; a=[json.loads(s) for s in open('answers.jsonl')]
for r,m,c in zip(x[len(a):],['baseline dot','space','nothing','em dash'],['high','high','high','low']): a.append(dict(item_id=r['item_id'],answer=next(k for k,v in r['options'].items() if v==m),confidence=c,note=''))
with open('answers.jsonl','w') as f:
 for r in a:f.write(json.dumps(r)+'\\n')
a=[json.loads(s) for s in open('answers.jsonl')]
assert len(a)==len(x)==89
assert [r['item_id'] for r in a]==[r['item_id'] for r in x]
assert len({r['item_id'] for r in a})==len(a)
assert all(r['answer'] in i['options'] for i,r in zip(x,a))
assert all(r['confidence'] in ['high','low'] and isinstance(r['note'],str) for r in a)
c=collections.Counter(i['options'][r['answer']] for i,r in zip(x,a))
print('Validated count, order, unique item IDs, option letters and confidence fields.')
