with open('answers.jsonl','w') as f:
 for i,m in enumerate(ms):
  f.write(json.dumps(dict(item_id=x[i]['item_id'],answer=next(k for k,v in x[i]['options'].items() if v==m),confidence='low' if i in [2,4,5] else 'high',note=''))+'\\n')
