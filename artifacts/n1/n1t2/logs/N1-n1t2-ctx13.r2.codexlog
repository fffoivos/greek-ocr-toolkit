import json,collections
items=[json.loads(s) for s in open('items.jsonl')]
answers=[json.loads(s) for s in open('answers.jsonl')]
assert len(items)==len(answers)==84
assert [x['item_id'] for x in items]==[x['item_id'] for x in answers]
for x,a in zip(items,answers):
 assert a['answer'] in x['options']
 assert a['confidence'] in ('high','low')
 assert set(a)=={'item_id','answer','confidence','note'}
print('Validated count, order, option letters:',len(answers))
print(dict(collections.Counter(x['options'][a['answer']] for x,a in zip(items,answers))))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
