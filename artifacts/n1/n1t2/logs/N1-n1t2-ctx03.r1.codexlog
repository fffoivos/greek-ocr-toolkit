"]]
with open('answers.jsonl','w') as f:
 for x,(m,c) in zip(items,a):
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence=c,note=''))+'\\n')
answers=[json.loads(l) for l in open('answers.jsonl')]
assert len(answers)==len(items)==85
assert [v['item_id'] for v in answers]==[v['item_id'] for v in items]
assert all(v['answer'] in x['options'] for x,v in zip(items,answers))
assert all(v['confidence'] in ('high','low') for v in answers)
print('Verified count, order, letters:',len(answers))
counts=collections.Counter(x['options'][v['answer']] for x,v in zip(items,answers))
for m in ['raised dot','baseline dot','comma','hyphen','en dash','em dash','space','nothing','other','unreadable']:print(m,counts[m])
print('Low confidence:',sum(v['confidence']=='low' for v in answers))
