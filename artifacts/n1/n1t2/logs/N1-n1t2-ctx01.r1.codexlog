j=[\"comma\",\"other\",\"em dash\",\"other\",\"other\",\"comma\",\"baseline dot\",\"en dash\",\"en dash\",\"comma\",\"nothing\",\"baseline dot\",\"comma\",\"comma\",\"baseline dot\",\"other\",\"nothing\",\"comma\",\"baseline dot\",\"baseline dot\",\"space\",\"space\",\"comma\",\"comma\",\"nothing\",\"em dash\",\"hyphen\",\"baseline dot\",\"nothing\",\"other\",\"em dash\",\"unreadable\",\"nothing\",\"nothing\",\"hyphen\",\"hyphen\",\"raised dot\",\"baseline dot\",\"space\",\"baseline dot\",\"em dash\",\"baseline dot\",\"baseline dot\",\"nothing\",\"en dash\",\"space\",\"hyphen\",\"space\",\"comma\",\"hyphen\",\"comma\",\"comma\",\"unreadable\",\"raised dot\",\"nothing\",\"baseline dot\",\"em dash\",\"comma\",\"baseline dot\",\"comma\",\"nothing\",\"other\",\"em dash\",\"comma\",\"hyphen\",\"en dash\",\"space\",\"other\",\"hyphen\",\"en dash\",\"nothing\",\"baseline dot\",\"space\",\"baseline dot\",\"hyphen\",\"hyphen\",\"baseline dot\",\"en dash\",\"nothing\",\"nothing\",\"nothing\",\"other\",\"em dash\",\"nothing\",\"nothing\"]
