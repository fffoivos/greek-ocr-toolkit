import json,collections
items=[json.loads(s) for s in open('items.jsonl')]
a=[json.loads(s) for s in open('answers.jsonl')]
assert len(items)==len(a)
for i,x in zip(items,a):
 assert x['item_id']==i['item_id']
 assert x['answer'] in i['options']
 assert x['confidence'] in ['high','low']
 assert set(x)=={'item_id','answer','confidence','note'}
print('Validated count, order and letters:',len(a))
c=collections.Counter(i['options'][x['answer']] for i,x in zip(items,a))
for m in ['raised dot','baseline dot','comma','hyphen','en dash','em dash','space','nothing','other','unreadable']: print(m,c[m])
print('Low confidence:',sum(x['confidence']=='low' for x in a))
