import json,collections
x=[json.loads(l) for l in open('items.jsonl')]; a=['baseline dot','baseline dot','space','space','baseline dot']
y=[json.loads(l) for l in open('answers.jsonl')]
for v,m in zip(x[len(y):],a): y.append(dict(item_id=v['item_id'],answer=next(k for k,b in v['options'].items() if b==m),confidence='high',note=''))
open('answers.jsonl','w').write(''.join(json.dumps(v)+'\\n' for v in y))
y=[json.loads(l) for l in open('answers.jsonl')]
assert len(x)==len(y)==85
assert len({v['item_id'] for v in y})==85
for v,r in zip(x,y):
 assert v['item_id']==r['item_id']
 assert r['answer'] in v['options']
 assert r['confidence'] in ['high','low']
print('Verified count, order, unique IDs, and option letters:',len(y))
c=collections.Counter(v['options'][r['answer']] for v,r in zip(x,y))
for m in ['raised dot','baseline dot','comma','hyphen','en dash','em dash','space','nothing','other','unreadable']:print(m,c[m])
print('low confidence',sum(r['confidence']=='low' for r in y))
