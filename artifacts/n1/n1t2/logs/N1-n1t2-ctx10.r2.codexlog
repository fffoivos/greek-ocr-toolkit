import json,collections
xs=[json.loads(l) for l in open('items.jsonl')]
ms=[\"baseline dot\",\"comma\",\"comma\",\"comma\",\"space\",\"hyphen\",\"hyphen\",\"hyphen\",\"em dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"space\",\"comma\",\"baseline dot\",\"comma\",\"comma\",\"baseline dot\",\"other\",\"baseline dot\",\"em dash\",\"unreadable\",\"em dash\",\"baseline dot\",\"other\",\"space\",\"other\",\"em dash\",\"space\",\"em dash\",\"en dash\",\"hyphen\",\"nothing\",\"raised dot\",\"hyphen\",\"em dash\",\"baseline dot\",\"nothing\",\"comma\",\"space\",\"comma\",\"unreadable\",\"baseline dot\",\"comma\",\"other\",\"nothing\",\"nothing\",\"comma\",\"baseline dot\",\"comma\",\"comma\",\"comma\",\"hyphen\",\"comma\",\"nothing\",\"em dash\",\"other\",\"space\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"other\",\"nothing\",\"space\",\"nothing\",\"unreadable\",\"comma\",\"comma\",\"em dash\",\"baseline dot\",\"baseline dot\",\"space\",\"other\",\"comma\",\"baseline dot\",\"comma\",\"nothing\",\"comma\",\"en dash\",\"space\",\"hyphen\",\"em dash\",\"other\",\"baseline dot\"]
with open('answers.jsonl','w') as f:
 for i,(x,m) in enumerate(zip(xs,ms),1):
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if i in [22,42,66] else 'high',note='Overlapping ink obscures gap.' if i in [22,42] else 'Gap cut at image edge.' if i==66 else ''))+'\\n')
a=[json.loads(l) for l in open('answers.jsonl')]
assert len(a)==len(xs)==84
for x,y in zip(xs,a):
 assert x['item_id']==y['item_id']
 assert y['answer'] in x['options']
 assert y['confidence'] in ['high','low']
 assert set(y)=={'item_id','answer','confidence','note'}
print('Verified count, order, letters and schema:',len(a))
c=collections.Counter(x['options'][y['answer']] for x,y in zip(xs,a))
for m in ['raised dot','baseline dot','comma','hyphen','en dash','em dash','space','nothing','other','unreadable']:
 print(m,c[m])
print('Low confidence:',sum(y['confidence']=='low' for y in a))
