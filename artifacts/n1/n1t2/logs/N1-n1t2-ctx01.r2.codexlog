import json,collections
items=[json.loads(x) for x in open('items.jsonl')]
answers=[json.loads(x) for x in open('answers.jsonl')]
assert len(items)==len(answers)
counts=collections.Counter()
for it,a in zip(items,answers):
 assert a['item_id']==it['item_id']
 assert a['answer'] in it['options']
 assert a['confidence'] in ['high','low']
 assert set(a)=={'item_id','answer','confidence','note'}
 counts[it['options'][a['answer']]]+=1
print('Validated count, order, and option letters:',len(answers))
print(json.dumps(dict(sorted(counts.items()))))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
