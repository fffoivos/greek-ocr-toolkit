 for i,m in enumerate(ms):
  x=xs[i];f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if i==4 else 'high',note='Small angular mark at the digit baseline.' if i==4 else ''))+'\\n')
