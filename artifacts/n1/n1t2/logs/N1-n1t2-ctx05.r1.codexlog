with open('answers.jsonl','w') as f:
 for x,(m,c) in zip(items,choices):
  a=next(a for a,v in x['options'].items() if v==m)
  f.write(json.dumps(dict(item_id=x['item_id'],answer=a,confidence=c,note=''))+'\\n')
answers=[json.loads(s) for s in open('answers.jsonl')]
assert len(answers)==len(items)==85
for x,a in zip(items,answers):
 assert a['item_id']==x['item_id']
 assert a['answer'] in x['options']
 assert a['confidence'] in ['high','low']
 assert isinstance(a['note'],str)
counts=collections.Counter(x['options'][a['answer']] for x,a in zip(items,answers))
print('Validated count, order, and option letters:',len(answers))
print(json.dumps(dict(counts),sort_keys=True))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
