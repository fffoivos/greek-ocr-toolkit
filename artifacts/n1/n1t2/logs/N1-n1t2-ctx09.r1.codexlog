import json,collections
items=[json.loads(l) for l in open('items.jsonl')]
a=[json.loads(l) for l in open('answers.jsonl')]
a[49]['confidence']='high'
for i,n in {14:'Blank gap at cropped number end.',20:'Short ink stroke below the digit baseline.',40:'Faint baseline mark.',57:'Inverted line; dot appears near the visible digit bottom.'}.items(): a[i]['note']=n
open('answers.jsonl','w').write(''.join(json.dumps(x,ensure_ascii=False)+'\\n' for x in a))
a=[json.loads(l) for l in open('answers.jsonl')]
assert len(a)==len(items)==85
assert len({x['item_id'] for x in a})==len(a)
for r,x in zip(items,a):
 assert x['item_id']==r['item_id']
 assert x['answer'] in r['options']
 assert x['confidence'] in ['high','low']
 assert isinstance(x['note'],str)
c=collections.Counter(r['options'][x['answer']] for r,x in zip(items,a))
print('Validated count, order, and option letters:',len(a))
for m in ['raised dot','baseline dot','comma','hyphen','en dash','em dash','space','nothing','other','unreadable']:print(m,c[m])
print('low confidence',sum(x['confidence']=='low' for x in a))
