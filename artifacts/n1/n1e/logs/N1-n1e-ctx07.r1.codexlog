/bin/zsh -lc "python3 - <<'PY'
import json,collections
r=list(map(json.loads,open('items.jsonl')))
m=[\"hyphen\",\"baseline dot\",\"comma\",\"baseline dot\",\"unreadable\",\"baseline dot\",\"baseline dot\",\"en dash\",\"unreadable\",\"nothing\",\"hyphen\",\"baseline dot\",\"unreadable\",\"other\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"space\",\"space\",\"nothing\",\"baseline dot\",\"unreadable\",\"baseline dot\",\"baseline dot\",\"nothing\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"comma\",\"nothing\",\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"nothing\",\"space\",\"space\",\"space\",\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"nothing\",\"nothing\",\"space\",\"hyphen\",\"space\",\"en dash\",\"space\",\"nothing\",\"space\",\"baseline dot\",\"unreadable\",\"em dash\",\"baseline dot\",\"other\",\"hyphen\",\"other\",\"nothing\",\"nothing\",\"other\",\"baseline dot\",\"baseline dot\",\"space\",\"baseline dot\",\"other\",\"nothing\",\"baseline dot\",\"hyphen\",\"nothing\",\"nothing\",\"baseline dot\",\"nothing\",\"baseline dot\",\"nothing\",\"comma\",\"baseline dot\",\"other\",\"nothing\",\"unreadable\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\"]
with open('answers.jsonl','w') as f:
 for n,(x,y) in enumerate(zip(r,m),1):
  low=y=='unreadable' or n in [51,72]
  note='Target gap cannot be located in sideways crop.' if y=='unreadable' else 'Handwritten spacing is uncertain.' if n in [51,72] else ''
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==y),confidence='low' if low else 'high',note=note))+'\\n')
a=list(map(json.loads,open('answers.jsonl')))
assert len(a)==len(r)==len(m)
assert [x['item_id'] for x in a]==[x['item_id'] for x in r]
assert len(set(x['item_id'] for x in a))==len(a)
assert all(y['answer'] in x['options'] for x,y in zip(r,a))
assert all(x['confidence'] in ['high','low'] for x in a)
c=collections.Counter(x['options'][y['answer']] for x,y in zip(r,a))
print('Validated count, order, unique IDs, and option letters:',len(a))
print(json.dumps(dict(c),sort_keys=True))
print('Low confidence:',sum(x['confidence']=='low' for x in a))
