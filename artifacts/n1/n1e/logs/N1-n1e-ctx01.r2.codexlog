import json,collections
xs=[json.loads(l) for l in open('items.jsonl')]
ms=json.loads('[\"hyphen\",\"hyphen\",\"other\",\"baseline dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"other\",\"nothing\",\"baseline dot\",\"other\",\"nothing\",\"other\",\"comma\",\"hyphen\",\"baseline dot\",\"other\",\"nothing\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"space\",\"other\",\"other\",\"raised dot\",\"nothing\",\"nothing\",\"other\",\"en dash\",\"space\",\"nothing\",\"space\",\"nothing\",\"baseline dot\",\"baseline dot\",\"other\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"hyphen\",\"em dash\",\"baseline dot\",\"en dash\",\"space\",\"baseline dot\",\"nothing\",\"other\",\"nothing\",\"space\",\"em dash\",\"other\",\"other\",\"space\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"other\",\"nothing\",\"nothing\",\"comma\",\"space\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"other\",\"baseline dot\",\"nothing\",\"baseline dot\",\"space\",\"baseline dot\",\"comma\",\"baseline dot\",\"other\",\"other\",\"unreadable\",\"baseline dot\",\"baseline dot\"]')
with open('answers.jsonl','w') as f:
 for i,(x,m) in enumerate(zip(xs,ms),1):
  note={79:'No following ink visible to anchor gap width.',85:'Gap pointers not visible; target gap cannot be localized.'}.get(i,'')
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if i in [79,85] else 'high',note=note))+'\\n')
ys=[json.loads(l) for l in open('answers.jsonl')]
assert len(xs)==len(ys)==87
for x,y in zip(xs,ys):
 assert x['item_id']==y['item_id']
 assert y['answer'] in x['options']
 assert y['confidence'] in ['high','low']
assert len({y['item_id'] for y in ys})==len(xs)
c=collections.Counter(x['options'][y['answer']] for x,y in zip(xs,ys))
print('Verified count, order, uniqueness, and option letters:',len(ys))
print(json.dumps(c,sort_keys=True))
print('Low confidence:',sum(y['confidence']=='low' for y in ys))
