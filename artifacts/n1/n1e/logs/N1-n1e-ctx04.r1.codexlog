import json
items=[json.loads(l) for l in open('items.jsonl')]
meanings=json.loads('[\"nothing\",\"en dash\",\"baseline dot\",\"space\",\"baseline dot\",\"space\",\"en dash\",\"space\",\"space\",\"baseline dot\",\"space\",\"hyphen\",\"nothing\",\"nothing\",\"baseline dot\"]')
with open('answers.jsonl','w') as f:
 for x,m in zip(items,meanings):
  a=next(k for k,v in x['options'].items() if v==m)
  f.write(json.dumps(dict(item_id=x['item_id'],answer=a,confidence='high',note=''))+'\\n')
