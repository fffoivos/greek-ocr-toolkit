/bin/zsh -lc "python3 - <<'PY'
import json,collections
xs=[json.loads(l) for l in open('items.jsonl')]
ms=json.loads('[\"nothing\",\"en dash\",\"baseline dot\",\"space\",\"baseline dot\",\"space\",\"en dash\",\"space\",\"other\",\"baseline dot\",\"space\",\"hyphen\",\"nothing\",\"nothing\",\"baseline dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"comma\",\"nothing\",\"space\",\"other\",\"baseline dot\",\"baseline dot\",\"unreadable\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"nothing\",\"hyphen\",\"space\",\"baseline dot\",\"space\",\"hyphen\",\"other\",\"en dash\",\"baseline dot\",\"em dash\",\"nothing\",\"nothing\",\"raised dot\",\"other\",\"baseline dot\",\"hyphen\",\"other\",\"baseline dot\",\"space\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"nothing\",\"other\",\"other\",\"nothing\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"space\",\"other\",\"baseline dot\",\"baseline dot\",\"other\",\"baseline dot\",\"baseline dot\",\"nothing\",\"unreadable\",\"space\",\"hyphen\",\"em dash\",\"baseline dot\",\"hyphen\",\"nothing\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"unreadable\",\"nothing\",\"space\"]')
low={24,40,74,84}
with open('answers.jsonl','w') as f:
 for i,(x,m) in enumerate(zip(xs,ms)):
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if i in low else 'high',note=''))+'\\n')
ys=[json.loads(l) for l in open('answers.jsonl')]
assert len(xs)==len(ys)==len(ms)
assert [x['item_id'] for x in xs]==[y['item_id'] for y in ys]
assert len({y['item_id'] for y in ys})==len(ys)
assert all(y['answer'] in x['options'] for x,y in zip(xs,ys))
assert all(y['confidence'] in {'high','low'} for y in ys)
counts=collections.Counter(x['options'][y['answer']] for x,y in zip(xs,ys))
print('Validated count, order, and option letters:',len(ys))
print(json.dumps(dict(counts),sort_keys=True))
print('Low confidence:',sum(y['confidence']=='low' for y in ys))
