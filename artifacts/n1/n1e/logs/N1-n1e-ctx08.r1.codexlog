/bin/zsh -lc "python3 - <<'PY'
import json
from collections import Counter
with open('items.jsonl') as f:
    items=[json.loads(x) for x in f]
with open('answers.jsonl') as f:
    answers=[json.loads(x) for x in f]
assert len(items)==len(answers)
for item, answer in zip(items, answers):
    assert item['item_id']==answer['item_id']
    assert answer['answer'] in item['options']
    assert answer['confidence'] in ('high','low')
assert len({a['item_id'] for a in answers})==len(items)
counts=Counter(i['options'][a['answer']] for i,a in zip(items,answers))
print('Count, order, uniqueness, and option letters verified:',len(items))
for meaning in ['raised dot','baseline dot','comma','hyphen','en dash','em dash','space','nothing','other','unreadable']:
    print(meaning+':',counts[meaning])
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
