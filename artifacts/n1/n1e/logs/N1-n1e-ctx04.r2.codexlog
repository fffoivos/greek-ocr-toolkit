import json,collections
x=[json.loads(l) for l in open('items.jsonl')]
a=[json.loads(l) for l in open('answers.jsonl')]
for row,meaning in zip(x[85:],['hyphen','nothing']):
 a.append(dict(item_id=row['item_id'],answer=next(k for k,v in row['options'].items() if v==meaning),confidence='high',note=''))
a[12].update(answer=next(k for k,v in x[12]['options'].items() if v=='unreadable'),confidence='low',note='Several isolated ink marks between digits; identity uncertain.')
a[78].update(confidence='high')
with open('answers.jsonl','w') as f:
 for row in a:f.write(json.dumps(row)+'\\n')
assert len(a)==len(x)
for src,row in zip(x,a):
 assert row['item_id']==src['item_id']
 assert row['answer'] in src['options']
 assert row['confidence'] in ['high','low']
 assert isinstance(row['note'],str)
print('Validated count, order, option letters:',len(a))
print(json.dumps(dict(collections.Counter(src['options'][row['answer']] for src,row in zip(x,a))),sort_keys=True))
print('Low confidence:',sum(row['confidence']=='low' for row in a))
