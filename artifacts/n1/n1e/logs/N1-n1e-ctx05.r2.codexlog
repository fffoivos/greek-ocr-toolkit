import json,collections
m=[\"other\",\"other\",\"other\",\"baseline dot\",\"baseline dot\",\"other\",\"baseline dot\",\"other\",\"baseline dot\",\"en dash\",\"baseline dot\",\"en dash\",\"other\",\"en dash\",\"baseline dot\",\"baseline dot\",\"other\",\"comma\",\"hyphen\",\"baseline dot\",\"hyphen\",\"other\",\"unreadable\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"unreadable\",\"baseline dot\",\"other\",\"hyphen\",\"baseline dot\",\"hyphen\",\"comma\",\"other\",\"baseline dot\",\"baseline dot\",\"en dash\",\"space\",\"baseline dot\",\"baseline dot\",\"nothing\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"other\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"space\",\"baseline dot\",\"space\",\"other\",\"other\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"comma\",\"nothing\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"space\",\"nothing\",\"other\",\"other\",\"baseline dot\",\"nothing\",\"baseline dot\",\"baseline dot\",\"nothing\",\"hyphen\",\"baseline dot\",\"comma\",\"nothing\",\"baseline dot\",\"baseline dot\",\"comma\",\"nothing\",\"nothing\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"other\",\"nothing\",\"baseline dot\"]
items=[json.loads(l) for l in open('items.jsonl')]
low={2,10,23,27,75,80}
notes={23:'Target gap cannot be located in supplied images.',27:'Target gap cannot be located in supplied images.',2:'Handwriting and preprinted dots overlap the target region.',10:'Stroke length is near the hyphen versus en dash boundary.',75:'Handwritten digits make normal spacing less certain.',80:'Target pointer alignment makes the precise gap uncertain.'}
with open('answers.jsonl','w') as f:
 for i,(x,v) in enumerate(zip(items,m),1):
  a=next(k for k,w in x['options'].items() if w==v)
  f.write(json.dumps({'item_id':x['item_id'],'answer':a,'confidence':'low' if i in low else 'high','note':notes.get(i,'')})+'\\n')
a=[json.loads(l) for l in open('answers.jsonl')]
assert len(a)==len(items)==86
assert [v['item_id'] for v in a]==[v['item_id'] for v in items]
assert len({v['item_id'] for v in a})==86
assert all(v['answer'] in x['options'] for x,v in zip(items,a))
assert all(v['confidence'] in ('high','low') for v in a)
c=collections.Counter(x['options'][v['answer']] for x,v in zip(items,a))
print('Validated count, order, unique IDs, option letters and confidence values.')
print(json.dumps(dict(c),sort_keys=True))
print('Low confidence:',sum(v['confidence']=='low' for v in a))
