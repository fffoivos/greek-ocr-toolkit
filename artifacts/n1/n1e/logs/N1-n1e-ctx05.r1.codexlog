import json,collections
xs=[json.loads(s) for s in open('items.jsonl')]
ms=[\"baseline dot\",\"comma\",\"other\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"nothing\",\"comma\",\"baseline dot\",\"baseline dot\",\"nothing\",\"comma\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"other\",\"other\",\"nothing\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"comma\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"other\",\"other\",\"space\",\"baseline dot\",\"space\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"nothing\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"nothing\",\"baseline dot\",\"baseline dot\",\"space\",\"en dash\",\"baseline dot\",\"baseline dot\",\"other\",\"comma\",\"hyphen\",\"baseline dot\",\"hyphen\",\"other\",\"baseline dot\",\"unreadable\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"unreadable\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"hyphen\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"nothing\",\"en dash\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"other\",\"baseline dot\",\"other\",\"baseline dot\",\"baseline dot\",\"other\",\"baseline dot\",\"other\"]
with open('answers.jsonl','w') as f:
 for i,(x,m) in enumerate(zip(xs,ms),1):
  row=dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if i in [12,60,64] else 'high',note='Target gap is not marked in either full-table image.' if i in [60,64] else '')
  f.write(json.dumps(row)+'\\n')
ys=[json.loads(s) for s in open('answers.jsonl')]
assert len(xs)==len(ys)==86
assert [x['item_id'] for x in xs]==[y['item_id'] for y in ys]
assert all(y['answer'] in x['options'] for x,y in zip(xs,ys))
assert all(y['confidence'] in ['high','low'] for y in ys)
c=collections.Counter(x['options'][y['answer']] for x,y in zip(xs,ys))
print('Validated count, order, letters:',len(ys))
for m in ['raised dot','baseline dot','comma','hyphen','en dash','em dash','space','nothing','other','unreadable']: print(m,c[m])
print('low confidence',sum(y['confidence']=='low' for y in ys))
