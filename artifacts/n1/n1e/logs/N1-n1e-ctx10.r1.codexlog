":\"space\"},{\"m\":\"space\"},{\"m\":\"baseline dot\"},{\"m\":\"baseline dot\"},{\"m\":\"nothing\"},{\"m\":\"em dash\"},{\"m\":\"baseline dot\"},{\"m\":\"unreadable\",\"c\":\"low\",\"n\":\"No visible gap pointers; zoom repeats the whole rotated line.\"},{\"m\":\"nothing\"},{\"m\":\"other\",\"n\":\"Slash.\"},{\"m\":\"space\"},{\"m\":\"space\"},{\"m\":\"unreadable\",\"c\":\"low\",\"n\":\"No visible gap pointers; zoom repeats the whole rotated line.\"},{\"m\":\"other\",\"n\":\"Slash.\"},{\"m\":\"comma\"},{\"m\":\"nothing\"},{\"m\":\"comma\"},{\"m\":\"unreadable\",\"c\":\"low\",\"n\":\"No visible gap pointers; zoom repeats the whole rotated line.\"},{\"m\":\"baseline dot\"},{\"m\":\"hyphen\"},{\"m\":\"baseline dot\"},{\"m\":\"baseline dot\"},{\"m\":\"space\"},{\"m\":\"other\",\"n\":\"Slash.\"},{\"m\":\"baseline dot\"},{\"m\":\"nothing\"}]''')
