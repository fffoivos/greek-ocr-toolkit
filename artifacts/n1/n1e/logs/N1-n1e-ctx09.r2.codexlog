/bin/zsh -lc "python3 - <<'PY'
import json,collections
items=[json.loads(x) for x in open('items.jsonl')]
meanings=[\"comma\",\"nothing\",\"en dash\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"space\",\"baseline dot\",\"baseline dot\",\"space\",\"nothing\",\"hyphen\",\"hyphen\",\"raised dot\",\"em dash\",\"baseline dot\",\"other\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"nothing\",\"baseline dot\",\"space\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"unreadable\",\"baseline dot\",\"baseline dot\",\"unreadable\",\"baseline dot\",\"baseline dot\",\"other\",\"space\",\"nothing\",\"baseline dot\",\"other\",\"nothing\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"other\",\"nothing\",\"nothing\",\"baseline dot\",\"nothing\",\"baseline dot\",\"baseline dot\",\"unreadable\",\"nothing\",\"nothing\",\"nothing\",\"hyphen\",\"raised dot\",\"baseline dot\",\"hyphen\",\"comma\",\"nothing\",\"other\",\"space\",\"hyphen\",\"hyphen\",\"en dash\",\"hyphen\",\"nothing\",\"space\",\"nothing\",\"space\",\"nothing\",\"nothing\",\"unreadable\",\"baseline dot\",\"other\",\"space\",\"unreadable\",\"nothing\",\"nothing\",\"space\"]
low=[14,33,36,57,79,83]
notes={14:'Rotated blurred mark; dot height uncertain.',33:'Vertical crop does not localize the intended gap.',36:'Vertical crop does not localize the intended gap.',57:'Rotated broad crop does not localize the intended gap.',79:'Vertical crop does not localize the intended gap.',83:'Small oblique ink mark; punctuation versus dirt unclear.'}
with open('answers.jsonl','w') as f:
 for i,(x,v) in enumerate(zip(items,meanings),1):
  ans=next(k for k,a in x['options'].items() if a==v)
  f.write(json.dumps({'item_id':x['item_id'],'answer':ans,'confidence':'low' if i in low else 'high','note':notes.get(i,'')})+'\\n')
answers=[json.loads(x) for x in open('answers.jsonl')]
assert len(answers)==len(items)==86
assert [x['item_id'] for x in answers]==[x['item_id'] for x in items]
assert all(a['answer'] in x['options'] for x,a in zip(items,answers))
assert all(a['confidence'] in ['high','low'] for a in answers)
print('Validated count, order, letters:',len(answers))
print(dict(collections.Counter(x['options'][a['answer']] for x,a in zip(items,answers))))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
