with open('answers.jsonl','w') as f:
 for i,(x,m) in enumerate(zip(xs,ms)):
  row=dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if i==32 else 'high',note='Dot is above baseline but relatively low.' if i==32 else '')
  f.write(json.dumps(row)+'\\n')
ys=[json.loads(l) for l in open('answers.jsonl')]
assert len(xs)==len(ys)==85
assert [x['item_id'] for x in xs]==[y['item_id'] for y in ys]
assert len({y['item_id'] for y in ys})==len(xs)
assert all(y['answer'] in x['options'] for x,y in zip(xs,ys))
assert all(y['confidence'] in ['high','low'] for y in ys)
c=collections.Counter(x['options'][y['answer']] for x,y in zip(xs,ys))
print('Validated count, order, option letters:',len(ys))
print(dict(c))
print('Low confidence:',sum(y['confidence']=='low' for y in ys))
