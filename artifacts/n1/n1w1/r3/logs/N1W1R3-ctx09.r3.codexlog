import json,collections
x=[json.loads(l) for l in open('items.jsonl')]; a=[json.loads(l) for l in open('answers.jsonl')]
r=x[75]; a[75]['answer']=next(k for k,v in r['options'].items() if v=='comma'); a[75]['note']='Blurred vertical mark extends below digit baseline.'
open('answers.jsonl','w').write(''.join(json.dumps(r)+'\\n' for r in a))
assert len(a)==len(x)==85
for r,b in zip(x,a):
 assert b['item_id']==r['item_id']
 assert b['answer'] in r['options']
 assert b['confidence'] in ('high','low')
 assert set(b)=={'item_id','answer','confidence','note'}
assert len({b['item_id'] for b in a})==len(x)
print('Validated count, order, letters:',len(a))
print(dict(collections.Counter(r['options'][b['answer']] for r,b in zip(x,a))))
print('Low confidence:',sum(b['confidence']=='low' for b in a))
