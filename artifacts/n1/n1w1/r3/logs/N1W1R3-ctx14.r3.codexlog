import json,collections
items=[json.loads(l) for l in open('items.jsonl')]
answers=[json.loads(l) for l in open('answers.jsonl')]
assert len(items)==len(answers)==85
assert [r['item_id'] for r in items]==[r['item_id'] for r in answers]
for i,a in zip(items,answers):
 assert a['answer'] in i['options']
 assert a['confidence'] in ('high','low')
 assert isinstance(a['note'],str)
c=collections.Counter(i['options'][a['answer']] for i,a in zip(items,answers))
print('Validated count, order, and option letters:',len(answers))
for meaning in ['raised dot','baseline dot','comma','hyphen','en dash','em dash','space','nothing','other','unreadable']:
 print(meaning+':',c[meaning])
print('low confidence:',sum(a['confidence']=='low' for a in answers))
