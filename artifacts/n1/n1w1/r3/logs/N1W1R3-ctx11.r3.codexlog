import json,collections
x=[json.loads(l) for l in open('items.jsonl')];a=[json.loads(l) for l in open('answers.jsonl')]
for s in ['baseline dot','raised dot','baseline dot','baseline dot','raised dot']:
 t=x[len(a)];a.append(dict(item_id=t['item_id'],answer=next(k for k,v in t['options'].items() if v==s),confidence='high',note=''))
open('answers.jsonl','w').write(''.join(json.dumps(t)+'\\n' for t in a))
a=[json.loads(l) for l in open('answers.jsonl')]
assert len(a)==len(x)==85
for t,r in zip(x,a):
 assert t['item_id']==r['item_id']
 assert r['answer'] in t['options']
 assert r['confidence'] in ('high','low')
 assert set(r)=={'item_id','answer','confidence','note'}
print('Validated count, order and option letters:',len(a))
print(dict(collections.Counter(t['options'][r['answer']] for t,r in zip(x,a))))
print('Low confidence:',sum(r['confidence']=='low' for r in a))
