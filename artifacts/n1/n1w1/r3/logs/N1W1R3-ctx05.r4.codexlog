/bin/zsh -lc "python3 - <<'PY'
import json,collections
xs=[json.loads(l) for l in open('items.jsonl')]
ms=[\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"raised dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"raised dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"en dash\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"raised dot\",\"raised dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\"]
low={15,22,45,56,63,80}
with open('answers.jsonl','w') as f:
 for n,(x,m) in enumerate(zip(xs,ms),1):
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if n in low else 'high',note='Uneven digit bottoms make dot height less certain.' if n in low else ''))+'\\n')
ys=[json.loads(l) for l in open('answers.jsonl')]
assert len(xs)==len(ys)==86
assert [x['item_id'] for x in xs]==[y['item_id'] for y in ys]
assert all(y['answer'] in x['options'] for x,y in zip(xs,ys))
assert all(y['confidence'] in ('high','low') for y in ys)
print('Validated count, order and option letters:',len(ys))
print(json.dumps(collections.Counter(x['options'][y['answer']] for x,y in zip(xs,ys)),sort_keys=True))
print('Low confidence:',sum(y['confidence']=='low' for y in ys))
