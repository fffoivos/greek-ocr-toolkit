\",\"high\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"],[\"raised dot\",\"low\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"],[\"baseline dot\",\"high\"]]')
assert len(x)==len(y)
with open('answers.jsonl','w') as f:
 for a,(m,c) in zip(x,y):
  f.write(json.dumps(dict(item_id=a['item_id'],answer=next(k for k,v in a['options'].items() if v==m),confidence=c,note=''))+'\\n')
z=[json.loads(s) for s in open('answers.jsonl')]
assert len(z)==len(x)
assert [a['item_id'] for a in x]==[a['item_id'] for a in z]
assert len({a['item_id'] for a in z})==len(x)
assert all(b['answer'] in a['options'] for a,b in zip(x,z))
assert all(b['confidence'] in ['high','low'] for b in z)
print('Verified count, order, unique items, option letters:',len(z))
print(dict(collections.Counter(a['options'][b['answer']] for a,b in zip(x,z))))
print('Low confidence:',sum(b['confidence']=='low' for b in z))
