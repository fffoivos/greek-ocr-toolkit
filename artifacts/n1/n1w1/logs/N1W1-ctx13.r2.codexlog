import json,collections
m=[\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"baseline dot\",\"raised dot\",\"raised dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"nothing\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"em dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\"]
low=[7,23,24,25,35,36,39,56,69]
x=[json.loads(l) for l in open('items.jsonl')]
with open('answers.jsonl','w') as f:
 for i,(a,v) in enumerate(zip(x,m)):
  f.write(json.dumps(dict(item_id=a['item_id'],answer=next(k for k,w in a['options'].items() if w==v),confidence='low' if i in low else 'high',note=''))+'\\n')
y=[json.loads(l) for l in open('answers.jsonl')]
assert len(x)==len(y)==85
assert [a['item_id'] for a in x]==[a['item_id'] for a in y]
assert all(b['answer'] in a['options'] for a,b in zip(x,y))
assert all(b['confidence'] in ['high','low'] for b in y)
print('Validated count, order, letters:',len(y))
print(dict(collections.Counter(a['options'][b['answer']] for a,b in zip(x,y))))
print('Low confidence:',sum(b['confidence']=='low' for b in y))
