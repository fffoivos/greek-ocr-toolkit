import json
from collections import Counter
items=[json.loads(l) for l in open('items.jsonl')]
means=[\"baseline dot\",\"baseline dot\",\"baseline dot\",\"space\",\"baseline dot\",\"raised dot\",\"unreadable\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"raised dot\",\"raised dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"raised dot\",\"unreadable\",\"raised dot\",\"raised dot\",\"baseline dot\",\"unreadable\",\"raised dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"raised dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"nothing\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"raised dot\"]
low={6,7,31,36,40,71}
notes={6:'Dot elevated but blurred.',7:'Faint baseline ink; shape uncertain.',31:'Dot height close to boundary.',36:'Worn baseline mark.',40:'Blurred mark at or below baseline; tail unclear.',71:'Stroke length near dash-length boundary.'}
with open('answers.jsonl','w') as f:
 for n,(x,m) in enumerate(zip(items,means),1):
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if n in low else 'high',note=notes.get(n,'')))+'\\n')
answers=[json.loads(l) for l in open('answers.jsonl')]
assert len(answers)==len(items)==86
for x,a in zip(items,answers):
 assert x['item_id']==a['item_id']
 assert a['answer'] in x['options']
 assert a['confidence'] in ('high','low')
 assert set(a)=={'item_id','answer','confidence','note'}
print('Validated count, order, letters:',len(answers))
print(json.dumps(Counter(x['options'][a['answer']] for x,a in zip(items,answers)),sort_keys=True))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
