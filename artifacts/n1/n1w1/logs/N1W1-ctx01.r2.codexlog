import json,collections
xs=[json.loads(l) for l in open('items.jsonl')]; ms=json.loads('[\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"space\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\"]'); low=[22,23,27,28,31,39,40,43,49,55,59,61,63,65,68,69,76,78,80]
with open('answers.jsonl','w') as f:
 for i,(x,m) in enumerate(zip(xs,ms),1):
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if i in low else 'high',note=''))+'\\n')
ys=[json.loads(l) for l in open('answers.jsonl')]
assert len(xs)==len(ys)==86
assert [x['item_id'] for x in xs]==[y['item_id'] for y in ys]
assert all(y['answer'] in x['options'] for x,y in zip(xs,ys))
assert all(y['confidence'] in ['high','low'] for y in ys)
print('Count, order, and letters verified:',len(ys))
print(dict(collections.Counter(x['options'][y['answer']] for x,y in zip(xs,ys))))
print('Low confidence:',sum(y['confidence']=='low' for y in ys))
