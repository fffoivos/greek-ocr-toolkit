import json
from collections import Counter
with open('items.jsonl') as f: items=[json.loads(x) for x in f]
with open('answers.jsonl') as f: answers=[json.loads(x) for x in f]
assert len(items)==len(answers)
for item,answer in zip(items,answers):
 assert item['item_id']==answer['item_id']
 assert answer['answer'] in item['options']
 assert answer['confidence'] in ('high','low')
 assert isinstance(answer['note'],str)
print('Validated count, order, and letters:',len(answers))
print(dict(Counter(i['options'][a['answer']] for i,a in zip(items,answers))))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
