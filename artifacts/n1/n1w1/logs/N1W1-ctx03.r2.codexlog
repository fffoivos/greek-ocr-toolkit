  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='high',note=''))+'\\n')
answers=[json.loads(s) for s in open('answers.jsonl')]
assert len(answers)==len(items)==len(meanings)
for x,a in zip(items,answers):
 assert x['item_id']==a['item_id']
 assert a['answer'] in x['options']
 assert a['confidence'] in ('high','low')
 assert isinstance(a['note'],str)
print('Validated count, order and letters:',len(answers))
print(dict(Counter(x['options'][a['answer']] for x,a in zip(items,answers))))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
