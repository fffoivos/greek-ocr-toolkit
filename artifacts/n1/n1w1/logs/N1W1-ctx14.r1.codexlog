import json,collections
items=[json.loads(l) for l in open('items.jsonl')]
meanings=json.loads('[\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"baseline dot\",\"baseline dot\",\"em dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"baseline dot\",\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\"]')
low={3,4,15,70,81}
notes={3:'Stroke shorter than adjacent digit; borderline dash length.',4:'Faint rounded mark near baseline.',15:'Dot appears above baseline; height somewhat uncertain.',70:'Faint descending trace below dot.',81:'Faint rounded mark near baseline.'}
with open('answers.jsonl','w') as f:
 for i,(it,meaning) in enumerate(zip(items,meanings)):
  letter=next(k for k,v in it['options'].items() if v==meaning)
  f.write(json.dumps({'item_id':it['item_id'],'answer':letter,'confidence':'low' if i in low else 'high','note':notes.get(i,'')})+'\\n')
answers=[json.loads(l) for l in open('answers.jsonl')]
assert len(answers)==len(items)==85
assert [a['item_id'] for a in answers]==[i['item_id'] for i in items]
assert all(a['answer'] in i['options'] for i,a in zip(items,answers))
assert all(a['confidence'] in ('high','low') for a in answers)
print('Validated count, order, letters:',len(answers))
print(dict(collections.Counter(i['options'][a['answer']] for i,a in zip(items,answers))))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
