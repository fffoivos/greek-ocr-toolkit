x=[json.loads(l) for l in open('items.jsonl')]; a=[json.loads(l) for l in open('answers.jsonl')]
for r in x[80:]: a.append(dict(item_id=r['item_id'],answer=next(k for k,v in r['options'].items() if v=='raised dot'),confidence='high',note=''))
with open('answers.jsonl','w') as f:
 for r in a:f.write(json.dumps(r)+'\\n')
a=[json.loads(l) for l in open('answers.jsonl')]
assert len(x)==len(a)
assert [r['item_id'] for r in x]==[r['item_id'] for r in a]
assert len(set(r['item_id'] for r in a))==len(a)
for r,s in zip(x,a):
 assert s['answer'] in r['options']
 assert s['confidence'] in ['high','low']
print('Validated count, order, option letters:',len(a))
print(json.dumps(dict(collections.Counter(r['options'][s['answer']] for r,s in zip(x,a)))))
print('Low confidence:',sum(s['confidence']=='low' for s in a))
