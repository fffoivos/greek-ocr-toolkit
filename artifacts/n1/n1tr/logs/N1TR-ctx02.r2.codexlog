import json,collections
items=[json.loads(s) for s in open('items.jsonl')]
a=[json.loads(s) for s in open('answers.jsonl')]
assert len(a)==len(items)
for x,y in zip(items,a):
 assert x['item_id']==y['item_id']
 assert y['answer'] in x['options']
 assert y['confidence'] in ['high','low']
assert len({x['item_id'] for x in a})==len(items)
print('Validated count, order, unique items, option letters:',len(a))
print(dict(collections.Counter(x['options'][y['answer']] for x,y in zip(items,a))))
print('Low confidence:',sum(y['confidence']=='low' for y in a))
