import json
from collections import Counter
xs=[json.loads(x) for x in open('items.jsonl')]
ms=[\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"en dash\",\"baseline dot\",\"em dash\",\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"en dash\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"em dash\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"comma\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"em dash\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"baseline dot\",\"hyphen\",\"baseline dot\",\"hyphen\",\"baseline dot\"]
with open('answers.jsonl','w') as f:
 for n,(x,m) in enumerate(zip(xs,ms),1):
  f.write(json.dumps(dict(item_id=x['item_id'],answer=next(k for k,v in x['options'].items() if v==m),confidence='low' if n in [29] else 'high',note=''))+'\\n')
ys=[json.loads(x) for x in open('answers.jsonl')]
assert len(xs)==len(ys)==88
assert len({x['item_id'] for x in ys})==88
for x,y in zip(xs,ys):
 assert x['item_id']==y['item_id']
 assert y['answer'] in x['options']
 assert y['confidence'] in ['high','low']
 assert set(y)=={'item_id','answer','confidence','note'}
print('Validated count, order, and letters:',len(ys))
print(dict(Counter(x['options'][y['answer']] for x,y in zip(xs,ys))))
print('Low confidence:',sum(y['confidence']=='low' for y in ys))
