import json
from collections import Counter
x=[json.loads(l) for l in open('items.jsonl')]; a=[json.loads(l) for l in open('answers.jsonl')]
for r in x[85:]: a.append(dict(item_id=r['item_id'],answer=next(k for k,v in r['options'].items() if v=='baseline dot'),confidence='high',note=''))
for n,m,c,note in [(2,'en dash','low','Stroke is close to one digit width.'),(17,'hyphen','high',''),(84,'hyphen','low','Blurred stroke is visibly shorter than the adjacent 2.'),(8,'en dash','low','Blurred stroke is close to one digit width.'),(65,'en dash','low','Blurred stroke is close to one digit width.')]:
 a[n-1].update(answer=next(k for k,v in x[n-1]['options'].items() if v==m),confidence=c,note=note)
with open('answers.jsonl','w') as f:
 for r in a: f.write(json.dumps(r)+'\\n')
assert len(x)==len(a)==88
for r,s in zip(x,a):
 assert r['item_id']==s['item_id']
 assert s['answer'] in r['options']
 assert s['confidence'] in ('high','low')
c=Counter(r['options'][s['answer']] for r,s in zip(x,a))
print('Validated count, order, and option letters:',len(a))
print(dict(c))
print('Low confidence:',sum(s['confidence']=='low' for s in a))
