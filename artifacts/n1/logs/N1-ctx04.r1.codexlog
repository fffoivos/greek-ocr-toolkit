import json,collections
items=[json.loads(s) for s in open('items.jsonl')]
meanings=[\"space\",\"hyphen or dash\",\"comma\",\"hyphen or dash\",\"baseline dot\",\"hyphen or dash\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"hyphen or dash\",\"baseline dot\",\"hyphen or dash\",\"raised dot\",\"hyphen or dash\",\"raised dot\",\"comma\",\"space\",\"hyphen or dash\",\"comma\",\"baseline dot\",\"baseline dot\",\"comma\",\"comma\",\"hyphen or dash\",\"baseline dot\",\"hyphen or dash\",\"raised dot\",\"hyphen or dash\",\"hyphen or dash\",\"raised dot\",\"hyphen or dash\",\"comma\",\"baseline dot\",\"hyphen or dash\",\"space\",\"comma\",\"hyphen or dash\",\"hyphen or dash\",\"other\",\"comma\",\"hyphen or dash\",\"baseline dot\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"comma\",\"nothing\",\"hyphen or dash\",\"hyphen or dash\",\"baseline dot\",\"raised dot\",\"hyphen or dash\",\"hyphen or dash\",\"comma\",\"hyphen or dash\",\"hyphen or dash\",\"baseline dot\",\"space\",\"hyphen or dash\",\"hyphen or dash\",\"baseline dot\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"baseline dot\",\"baseline dot\",\"hyphen or dash\",\"baseline dot\",\"baseline dot\",\"hyphen or dash\",\"hyphen or dash\",\"space\",\"hyphen or dash\",\"comma\",\"raised dot\",\"raised dot\",\"baseline dot\",\"comma\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"other\",\"hyphen or dash\",\"hyphen or dash\",\"other\",\"baseline dot\"]
low={7:'Dot sits above the baseline, below mid-height.',41:'Faint short horizontal stroke.',79:'Small elevated dot.',82:'Faint elevated dot.'}
with open('answers.jsonl','w') as f:
 for i,(item,meaning) in enumerate(zip(items,meanings),1):
  answer=next(k for k,v in item['options'].items() if v==meaning)
  f.write(json.dumps({'item_id':item['item_id'],'answer':answer,'confidence':'low' if i in low else 'high','note':low.get(i,'')})+'\\n')
answers=[json.loads(s) for s in open('answers.jsonl')]
assert len(answers)==len(items)
assert [a['item_id'] for a in answers]==[i['item_id'] for i in items]
assert len({a['item_id'] for a in answers})==len(items)
assert all(a['answer'] in i['options'] for a,i in zip(answers,items))
assert all(a['confidence'] in ('high','low') for a in answers)
counts=collections.Counter(i['options'][a['answer']] for i,a in zip(items,answers))
print('Validated count, order, and letters:',len(answers))
print(json.dumps({m:counts[m] for m in ['raised dot','baseline dot','comma','hyphen or dash','space','nothing','other','unreadable']}))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
