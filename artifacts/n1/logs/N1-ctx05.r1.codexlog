python3 - <<'PY'
import json,collections
items=[json.loads(l) for l in open('items.jsonl')]
answers=[json.loads(l) for l in open('answers.jsonl')]
assert len(items)==len(answers)
for i,a in zip(items,answers):
 assert a['item_id']==i['item_id']
 assert a['answer'] in i['options']
 assert a['confidence'] in ('high','low')
assert len({a['item_id'] for a in answers})==len(items)
counts=collections.Counter(i['options'][a['answer']] for i,a in zip(items,answers))
print(json.dumps({'items_done':len(answers),'counts':dict(counts),'low_confidence':sum(a['confidence']=='low' for a in answers),'validation':'count, order, unique IDs, and option letters passed'}))
