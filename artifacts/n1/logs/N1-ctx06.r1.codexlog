/bin/zsh -lc "python3 - <<'PY'
import json,collections
x=[json.loads(s) for s in open('items.jsonl')]; y=[json.loads(s) for s in open('answers.jsonl')]
fix={60:'comma',62:'baseline dot',66:'hyphen or dash',67:'raised dot',68:'hyphen or dash',69:'hyphen or dash',70:'hyphen or dash',72:'hyphen or dash',73:'baseline dot',74:'nothing',76:'comma',77:'comma',78:'baseline dot',80:'hyphen or dash',84:'raised dot',85:'baseline dot',87:'baseline dot'}
for i,m in fix.items():y[i-1]['answer']=next(k for k,v in x[i-1]['options'].items() if v==m)
with open('answers.jsonl','w') as f:
 for s in y:f.write(json.dumps(s)+'\\n')
y=[json.loads(s) for s in open('answers.jsonl')]
assert len(x)==len(y)==88
assert len({s['item_id'] for s in y})==88
for r,s in zip(x,y):
 assert r['item_id']==s['item_id']
 assert s['answer'] in r['options']
 assert s['confidence'] in ['high','low']
print('Validated: 88 items, same order, valid option letters.')
c=collections.Counter(r['options'][s['answer']] for r,s in zip(x,y))
for m in ['raised dot','baseline dot','comma','hyphen or dash','space','nothing','other','unreadable']:print(m,c[m])
print('Low confidence:',sum(s['confidence']=='low' for s in y))
