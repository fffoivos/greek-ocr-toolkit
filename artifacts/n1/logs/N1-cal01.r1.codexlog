import json,collections
items=[json.loads(s) for s in open('items.jsonl')]
meanings=[\"baseline dot\",\"baseline dot\",\"hyphen or dash\",\"raised dot\",\"comma\",\"comma\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"comma\",\"baseline dot\",\"baseline dot\",\"nothing\",\"baseline dot\",\"baseline dot\",\"hyphen or dash\",\"hyphen or dash\",\"comma\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"baseline dot\",\"comma\",\"nothing\",\"comma\",\"raised dot\",\"hyphen or dash\",\"baseline dot\",\"comma\",\"comma\",\"comma\",\"hyphen or dash\",\"baseline dot\",\"baseline dot\",\"comma\",\"comma\",\"nothing\",\"baseline dot\",\"hyphen or dash\",\"baseline dot\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"comma\",\"hyphen or dash\",\"hyphen or dash\",\"comma\",\"comma\",\"baseline dot\",\"comma\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"raised dot\",\"hyphen or dash\",\"hyphen or dash\",\"hyphen or dash\",\"comma\",\"baseline dot\",\"comma\",\"nothing\",\"comma\",\"baseline dot\",\"comma\",\"nothing\",\"nothing\",\"baseline dot\",\"hyphen or dash\",\"baseline dot\",\"comma\",\"nothing\",\"comma\",\"comma\",\"comma\",\"raised dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\",\"baseline dot\"]
assert len(items)==len(meanings)
with open('answers.jsonl','w') as f:
 for it,m in zip(items,meanings):
  a=next(k for k,v in it['options'].items() if v==m)
  f.write(json.dumps(dict(item_id=it['item_id'],answer=a,confidence='high',note=''))+'\\n')
answers=[json.loads(s) for s in open('answers.jsonl')]
assert len(answers)==len(items)==82
for it,a in zip(items,answers):
 assert a['item_id']==it['item_id']
 assert a['answer'] in it['options']
 assert a['confidence'] in ['high','low']
 assert isinstance(a['note'],str)
counts=collections.Counter(it['options'][a['answer']] for it,a in zip(items,answers))
print('Validated count, order, letters:',len(answers))
print(json.dumps(counts,sort_keys=True))
print('Low confidence:',sum(a['confidence']=='low' for a in answers))
