+            if isinstance(obj,str):return obj.replace(str(directory),str(snapshot))
+            if isinstance(obj,list):return [relocate(v) for v in obj]
+            if isinstance(obj,dict):return {k:relocate(v) for k,v in obj.items()}
+            return obj
