{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REL0 source-spec contract",
  "description": "Builder-owned structure validation; unresolved joins remain explicit. Freeze verifies files; read_lock enforces full relation selection.",
  "type": "object",
  "required": [
    "dataset_version",
    "hf_pins",
    "models",
    "features",
    "assets",
    "inputs"
  ],
  "properties": {
    "dataset_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^v0\\.[0-9]+$"
    },
    "hf_pins": {
      "type": "object",
      "required": [
        "staging-v4",
        "harvest-20261025"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "models": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "features": {
      "type": "object",
      "required": [
        "codec",
        "scripts",
        "unicode_version"
      ],
      "properties": {
        "codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "scripts": {
          "type": [
            "string",
            "null"
          ]
        },
        "unicode_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "codec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scripts_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "keyset_unions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "reconciliations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "left",
          "right",
          "left_only",
          "right_only"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "left_only": {
            "type": "integer",
            "minimum": 0
          },
          "right_only": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "expected_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "table",
          "where",
          "count"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "object"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "component_versions": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "release_code_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "probe_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "smoke_rows_per_source": {
      "type": "integer",
      "minimum": 1
    },
    "binding_status": {
      "enum": [
        "INCOMPLETE_EVIDENCE_NOT_FREEZE_READY",
        "COORDINATOR_BOUND_PENDING_RESOLVER",
        "BOUND"
      ]
    },
    "unresolved_bindings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "field",
          "value",
          "reason",
          "evidence"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "historical_unknown": {
            "const": true
          },
          "blocks_freeze": {
            "const": false
          },
          "blocks_smoke": {
            "const": false
          },
          "resolve_probe": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "historical_unknown",
              "pending_resolve: original_crops"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "historical_unknown"
              ]
            },
            "then": {
              "required": [
                "blocks_freeze",
                "blocks_smoke"
              ]
            }
          }
        ]
      }
    },
    "keyset_bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "left",
          "right"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "partial_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "status",
          "value",
          "reason",
          "evidence",
          "coverage",
          "source_report",
          "source_report_sha256",
          "blocks_freeze",
          "blocks_smoke"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "partial"
          },
          "value": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "object"
          },
          "source_report": {
            "type": "string",
            "minLength": 1
          },
          "source_report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "blocks_freeze": {
            "const": false
          },
          "blocks_smoke": {
            "const": false
          }
        }
      }
    },
    "resolved_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "status",
          "value",
          "reason",
          "evidence",
          "coverage",
          "source_report",
          "source_report_sha256",
          "blocks_freeze",
          "blocks_smoke"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "resolved"
          },
          "value": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "object"
          },
          "source_report": {
            "type": "string",
            "minLength": 1
          },
          "source_report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "blocks_freeze": {
            "const": false
          },
          "blocks_smoke": {
            "const": false
          }
        }
      }
    },
    "book_bridge": {
      "type": "object",
      "required": [
        "decision",
        "registry_input",
        "instruments_input",
        "sources_input",
        "populations",
        "coverage",
        "registry_sha256",
        "row_instruments_sha256"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending_resolve: book_bridge",
            "partial"
          ]
        },
        "registry_input": {
          "type": "string"
        },
        "instruments_input": {
          "type": "string"
        },
        "sources_input": {
          "type": "string"
        },
        "populations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "s1",
              "v4",
              "old",
              "census",
              "harvest",
              "seal04",
              "validation",
              "synthetic"
            ]
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/book_population_coverage"
              }
            ]
          }
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "row_instruments_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "crop_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          },
          "index": {
            "description": "Freeze measures files and SHA256 of canonical [sha256, absolute_path] JSON lines, sorted by sha256 then path. Builder can reuse the pinned freeze index after matching root metadata snapshots; changed roots and independent acceptance rebuild from bytes.",
            "type": "object",
            "required": [
              "files",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "files": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "input": {
      "type": "object",
      "required": [
        "name",
        "adapter",
        "patterns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "enum": [
            "census",
            "row",
            "s1",
            "harvest",
            "keyset",
            "table",
            "row_patch",
            "synthetic",
            "prepared",
            "evidence",
            "decision"
          ]
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fields": {
          "$ref": "#/$defs/mapping"
        },
        "templates": {
          "$ref": "#/$defs/mapping"
        },
        "constants": {
          "type": "object"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "priority": {
          "type": "integer"
        },
        "table": {
          "enum": [
            "pages",
            "page_images",
            "page_frames",
            "boxes",
            "segmenter_page_results",
            "rows",
            "label_versions",
            "row_features",
            "row_instruments",
            "references",
            "book_registry",
            "training_membership",
            "book_sources"
          ]
        },
        "keyset": {
          "type": "string",
          "minLength": 1
        },
        "key_field": {
          "type": "string",
          "minLength": 1
        },
        "pool": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "train",
            "dev",
            "test",
            "reference"
          ]
        },
        "factory_build_id": {
          "type": "string",
          "minLength": 1
        },
        "source_build": {
          "type": "string",
          "minLength": 1
        },
        "build_evidence": {
          "type": "string",
          "minLength": 1
        },
        "json_prefix": {
          "type": "string"
        },
        "json_map": {
          "type": "boolean"
        },
        "image_root": {
          "type": "string",
          "minLength": 1
        },
        "image_root_evidence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "minProperties": 1
            }
          ]
        },
        "original_crops_source": {
          "type": "object",
          "required": [
            "patterns",
            "image_storage",
            "hf_pin",
            "expected_rows",
            "evidence"
          ],
          "properties": {
            "patterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "image_storage": {
              "const": "embedded_hf_parquet"
            },
            "hf_pin": {
              "type": "object",
              "required": [
                "repo_id",
                "branch",
                "revision"
              ],
              "properties": {
                "repo_id": {
                  "const": "fffoivos/greek-ocr-lines"
                },
                "branch": {
                  "const": "harvest-20261025"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            },
            "expected_rows": {
              "type": "integer",
              "minimum": 0
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "A separate original-image payload input. Freeze pins every parquet file by bytes/SHA256. Ingestion reconciles exact native tuples and recorded hashes; native labels and provenance remain selected from the main input."
        },
        "image_path_base": {
          "const": "source_file_directory"
        },
        "validation_original_metadata": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "keyset"
              }
            }
          },
          "then": {
            "required": [
              "keyset",
              "key_field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "table"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "required": [
              "factory_build_id",
              "source_build",
              "build_evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "prepared"
              }
            }
          },
          "then": {
            "required": [
              "pool",
              "role"
            ]
          }
        }
      ]
    },
    "book_population_coverage": {
      "type": "object",
      "required": [
        "rows",
        "match",
        "no_key",
        "unmatched",
        "ambiguous",
        "source_fields",
        "instrument_rows",
        "instrument_memberships",
        "instrument_original_id_unknown",
        "lqb_row",
        "release_excluded_row",
        "match_paths"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "match": {
          "type": "integer",
          "minimum": 0
        },
        "no_key": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "instrument_rows": {
          "type": "integer",
          "minimum": 0
        },
        "instrument_memberships": {
          "type": "integer",
          "minimum": 0
        },
        "instrument_original_id_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "lqb_row": {
          "type": "integer",
          "minimum": 0
        },
        "release_excluded_row": {
          "type": "integer",
          "minimum": 0
        },
        "source_fields": {
          "type": "object",
          "required": [
            "book_id",
            "canonical_book_id",
            "provider",
            "source",
            "item",
            "edition",
            "volume",
            "source_title",
            "year",
            "page",
            "page_number_convention",
            "catalogue_url",
            "catalogue_reference",
            "manifest_url",
            "source_url",
            "source_record_sha256"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/source_field_coverage"
          }
        },
        "match_paths": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "source_field_coverage": {
      "type": "object",
      "required": [
        "nonnull",
        "null",
        "null_reasons"
      ],
      "properties": {
        "nonnull": {
          "type": "integer",
          "minimum": 0
        },
        "null": {
          "type": "integer",
          "minimum": 0
        },
        "null_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
