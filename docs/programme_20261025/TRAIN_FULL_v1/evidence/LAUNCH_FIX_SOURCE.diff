+# BEGIN LAUNCH COMPATIBILITY
+PARENT_SHA = '294c3458c0d1fbbb45c61dcac2e11e8fab92f1ce10558cf9576ecccaabd30aac'
+
+
+def launch_compatibility():
+    """Prove the sole operational change, retaining original data/smoke bytes."""
+    import hashlib
+    payload = verify()
+    parent_path = ROOT / 'launch_parent_payload.json'
+    if sha(parent_path) != PARENT_SHA:
+        raise ValueError('unrecognized launch parent payload')
+    parent = read(parent_path)
+    edits = {
+        'job.sbatch': [('SLURM_TIME_FORMAT=standard squeue', 'squeue')],
+        'run.py': [
+            ('from verify import verify, package_matches', 'from verify import verify'),
+            ("not package_matches(runtime.get('package_sha256'))", "runtime.get('package_sha256') != sha(ROOT / 'PAYLOAD.json')")],
+        'chain.py': [
+            ('        from verify import package_matches\n', ''),
+            ("not package_matches(identity.get('package_sha256'))", "identity.get('package_sha256') != sha(ROOT / 'PAYLOAD.json')")],
+        'reuse_audit.py': [(
+            "    from verify import PARENT_SHA as launch_parent, launch_compatibility\n"
+            "    if sha(ROOT / 'PAYLOAD.json') != launch_parent:\n"
+            "        launch_compatibility()\n"
+            "        current = read(ROOT / 'launch_parent_payload.json')\n", '')],
+    }
+    additions = set(payload['files']) - set(parent['files'])
+    if additions != {'launch_parent_payload.json', 'tests/test_launch_fix.py'}:
+        raise ValueError('unexpected launch payload additions')
+    changed = set()
+    for name, entry in parent['files'].items():
+        if name not in payload['files']:
+            raise ValueError('missing launch parent file: ' + name)
+        if payload['files'][name] == entry:
+            continue
+        changed.add(name)
+        text = (ROOT / name).read_text()
+        if name == 'verify.py':
+            start = text.index('# BEGIN LAUNCH COMPATIBILITY\n')
+            end = text.index('# END LAUNCH COMPATIBILITY\n', start)
+            text = text[:start] + text[end + len('# END LAUNCH COMPATIBILITY\n\n\n'):]
+        elif name in edits:
+            for new, old in edits[name]:
+                if text.count(new) != 1:
+                    raise ValueError('launch edit not exact: ' + name)
+                text = text.replace(new, old)
+        else:
+            raise ValueError('nonoperational launch change: ' + name)
+        if hashlib.sha256(text.encode()).hexdigest() != entry['sha256']:
+            raise ValueError('launch change exceeds declared edit: ' + name)
+    if changed != {'job.sbatch', 'run.py', 'chain.py', 'verify.py', 'reuse_audit.py'}:
+        raise ValueError('unexpected launch change set')
+    return dict(parent_sha256=PARENT_SHA, changed=sorted(changed), added=sorted(additions),
+                policy='scheduler format and exact historical artifact binding only')
+
+
+def package_matches(value):
+    if value == sha(ROOT / 'PAYLOAD.json'):
+        return True
+    if value != PARENT_SHA:
+        return False
+    launch_compatibility()
+    return True
+# END LAUNCH COMPATIBILITY
