{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C0 mix manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "components",
    "seed",
    "codec_version",
    "created_by",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "codec_version": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "synthetic"
              },
              "build_dir": {
                "type": "string",
                "minLength": 1
              },
              "recipe_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind",
              "build_dir",
              "recipe_sha256",
              "fraction"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "real"
              },
              "shard_dir": {
                "type": "string",
                "minLength": 1
              },
              "shard_sha256": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "partition_id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind",
              "shard_dir",
              "shard_sha256",
              "partition_id",
              "source",
              "fraction"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "shard_dir": {
                "type": "string",
                "minLength": 1
              },
              "shard_sha256": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "kind": {
                "const": "legacy_eval"
              },
              "recipe_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "role": {
                "enum": [
                  "eval",
                  "transfer"
                ]
              },
              "provenance_status": {
                "const": "unprovenanced_recipe"
              },
              "disclosure": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "shard_dir",
              "shard_sha256",
              "fraction",
              "kind",
              "recipe_sha256",
              "role",
              "provenance_status",
              "disclosure"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "matched_replay": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "codec_recovery": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
