+            same=n.name in b and ast.dump(ast.Module(body=n.body,type_ignores=[]))==ast.dump(ast.Module(body=b[n.name].body,type_ignores=[]))
+            historical.append(dict(path=path,function=n.name,body_unchanged=same,decorators=[ast.unparse(d) for d in n.decorator_list if 'historical binding' in ast.unparse(d).lower()]))
+result['historical_skips']=dict(functions=len(historical),unchanged=sum(r['body_unchanged'] for r in historical),changed=[r for r in historical if not r['body_unchanged']])
+(OUT/'historical_skip_audit.json').write_text(json.dumps(historical,indent=2)+'\n')
+(OUT/'facts.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
+print(json.dumps(result,ensure_ascii=False,indent=2))

