@lru_cache(maxsize=16384)
def sha(path):
    h = hashlib.sha256()
    with _data_input(Path(path)).open('rb') as f:
        for b in iter(lambda: f.read(1024 * 1024), b''):
            h.update(b)
    return h.hexdigest()


def bind(path):
