"""Paths for relocated evidence; immutable fixture sources stay byte-identical."""
from __future__ import annotations

import ast
import importlib.machinery
from pathlib import Path

from scripts.layout_paths import MOVES as _MOVES, relocated

ROOT = Path(__file__).resolve().parents[1]
RECORDS = ROOT / 'docs/records'
ADMISSION = RECORDS / 'harvest/collect_v3_admission'
SOL_READING = RECORDS / 'harvest/sol_reading'
SEG_STEPS = RECORDS / 'harvest/seg_steps'


def require_file(path):
    """Skip only the caller that needs an actually absent evidence file."""
    import pytest
    from greekocr.ops.data_root import input_path
    path = relocated(path)
    try:
        resolved = input_path(path)
    except FileNotFoundError:
        resolved = path
    if not resolved.is_file():
        pytest.skip(str(path))
    return resolved


def evidence_params(path, loader, *, ids=None):
    """Keep synthetic tests runnable when a saved parameter input is absent."""
    import pytest
    try:
        source = require_file(path)
    except pytest.skip.Exception as exc:
        return [pytest.param(None, marks=pytest.mark.skip(reason=str(exc)), id=Path(path).name)]
    values = loader(source)
    return [pytest.param(value, id=ids(value) if ids else None) for value in values]


def install_record_loader():
    """Rebase documentation Python fixtures in memory during this test run.

    Python evidence under docs is frozen. Its old repository-root calculation
    and literal local input paths need the same relocation as its test caller.
    No decision code, source bytes, receipt strings or hash values are changed.
    Explicit spec loaders and ordinary imports both use SourceFileLoader here.
    """
    loader = importlib.machinery.SourceFileLoader
    original = loader.source_to_code
    original_get_code = loader.get_code

    def source_to_code(self, data, path, *, _optimize=-1):
        current = Path(path).resolve()
        try:
            relative = current.relative_to(ROOT).as_posix()
        except ValueError:
            return original(self, data, path, _optimize=_optimize)
        old_file = None
        for old, new in _MOVES:
            if relative == new or relative.startswith(new + '/'):
                old_file = ROOT / (old + relative[len(new):])
                break
        if not relative.startswith('docs/'):
            return original(self, data, path, _optimize=_optimize)
        if old_file is None:
            old_file = current
        tree = ast.parse(data, filename=path)
        # Evaluate only path arithmetic, never fixture code. Track the original
        # location to recognize expressions that formerly selected this repo.
        paths = {'__file__': old_file}

        def path_value(node):
            if isinstance(node, ast.Name):
                return paths.get(node.id)
            if isinstance(node, ast.Constant) and isinstance(node.value, str):
                return node.value
            if isinstance(node, ast.Call):
                if isinstance(node.func, (ast.Name, ast.Attribute)) and (
                        getattr(node.func, 'id', '') in ('Path', '_Path') or
                        getattr(node.func, 'attr', '') == 'Path') and len(node.args) == 1:
                    value = path_value(node.args[0])
                    return Path(value) if value is not None else None
                if isinstance(node.func, ast.Attribute) and node.func.attr in ('resolve', 'absolute'):
                    return path_value(node.func.value)
            if isinstance(node, ast.Attribute) and node.attr == 'parent':
                value = path_value(node.value)
                return value.parent if isinstance(value, Path) else None
            if isinstance(node, ast.Subscript) and isinstance(node.value, ast.Attribute) and node.value.attr == 'parents':
                value = path_value(node.value.value)
                if isinstance(value, Path) and isinstance(node.slice, ast.Constant):
                    return value.parents[node.slice.value]
            if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
                left, right = path_value(node.left), path_value(node.right)
                if isinstance(left, Path) and isinstance(right, str):
                    return left / right
            return None

        class Rebase(ast.NodeTransformer):
            def visit_Subscript(self, node):
                if path_value(node) == ROOT:
                    return ast.copy_location(ast.Call(
                        func=ast.Attribute(value=ast.Call(func=ast.Name(id='__import__', ctx=ast.Load()),
                            args=[ast.Constant('pathlib')], keywords=[]), attr='Path', ctx=ast.Load()),
                        args=[ast.Constant(str(ROOT))], keywords=[]), node)
                return self.generic_visit(node)

            def visit_Constant(self, node):
                if isinstance(node.value, str) and node.value.startswith('docs/'):
                    value = str(relocated(node.value))
                    if value != node.value:
                        return ast.copy_location(ast.Constant(value), node)
                return node

        rebase = Rebase()
        for statement in tree.body:
            if isinstance(statement, ast.Assign):
                value = path_value(statement.value)
                if isinstance(value, Path):
                    for target in statement.targets:
                        if isinstance(target, ast.Name):
                            paths[target.id] = value
            rebase.visit(statement)
        return original(self, ast.fix_missing_locations(tree), path, _optimize=_optimize)

    def get_code(self, fullname):
        # Moved trees contain historical __pycache__ files. Never execute those
        # unadapted code objects or overwrite them during a path-only test run.
        path = Path(self.path).resolve()
        if path.is_relative_to(ROOT / 'docs'):
            return self.source_to_code(self.get_data(str(path)), str(path))
        return original_get_code(self, fullname)

    loader.source_to_code = source_to_code
    loader.get_code = get_code

    def restore():
        loader.source_to_code = original
        loader.get_code = original_get_code
    return restore


def run_record(path):
    """Execute a documentation fixture with the same path adapter as imports."""
    path = relocated(path).resolve()
    loader = importlib.machinery.SourceFileLoader('<run_path>', str(path))
    namespace = dict(__name__='<run_path>', __file__=str(path),
                     __package__='', __spec__=None, __cached__=None)
    exec(loader.get_code('<run_path>'), namespace)
    return namespace
"""Read-only post-cleanup guard. Run directly or with pytest after untracking.

Reads blob sizes from the index rather than the working tree: deleting a file
without untracking it cannot make this guard pass. Uses no Git writing command.
"""
import os
from pathlib import Path
import subprocess

LIMIT = 5_000_000


def oversized_tracked_files(root):
    listing = subprocess.check_output(['git', 'ls-files', '--stage', '-z'], cwd=root)
    entries = []
    for item in listing.split(b'\0'):
        if not item:
            continue
        metadata, path = item.split(b'\t', 1)
        mode, oid, stage = metadata.split()
        if mode == b'160000':
            continue  # submodule commit, not a tracked file blob
        entries.append((oid, os.fsdecode(path), stage))
    unique = sorted({oid for oid, _, _ in entries})
    if not unique:
        return []
    process = subprocess.run(['git', 'cat-file', '--batch-check=%(objectname) %(objectsize)'],
                             input=b'\n'.join(unique) + b'\n', stdout=subprocess.PIPE,
                             cwd=root, check=True)
    sizes = {oid: int(size) for oid, size in (line.split() for line in process.stdout.splitlines())}
    return sorted((path, sizes[oid]) for oid, path, _ in entries if sizes[oid] > LIMIT)


def test_no_tracked_file_exceeds_5_mb():
    root = next(p for p in Path(__file__).resolve().parents if (p / '.git').exists())
    oversized = oversized_tracked_files(root)
    assert not oversized, ('Tracked blobs exceed 5,000,000 bytes; retain custody receipts and untrack after moving:\n'
                           + '\n'.join(f'{p}\t{n}' for p, n in oversized))


if __name__ == '__main__':
    test_no_tracked_file_exceeds_5_mb()
# CLEAN4L3 — test paths after documentation layout

Workspace: `/Users/foivoskarounos-zamparloukos/Projects/greek-ocr-toolkit-main-next`, branch `cleanup/20261019`. Completed 20 October 2026. The retrieval map is [LAYOUT_REPORT.md](LAYOUT_REPORT.md).

Updated local literal paths in `tests/`, `scripts/`, and `greekocr/`, including dynamically assembled wave-record paths. The table below records 374 file/path mappings. Repeated segmentation and scanner bases use `tests/_paths.py` (`ADMISSION`, `SOL_READING`, `SEG_STEPS`). `greekocr.ops.data_root` holds the exact 130 move-table aliases, searches repository copies before external mirrors, and still identifies the original custody shard for a missing relocated input.

No documentation was moved, no symlinks were added, and no Git-writing command was issued. This task did not edit root `README.md` or `AGENTS.md`; concurrent CLEAN5E changes to those files were left alone. No existing documentation, JSON receipt, manifest, fixture JSON/JSONL, vendor source snapshot, or saved checksum/hash value was changed. The only documentation written by this task is this report.

Executable documentation fixtures remain byte-identical on disk. A test-only loader translates local path literals and former repository-root parent calculations in memory. It bypasses the historical `__pycache__` objects moved with those fixtures; it neither updates nor deletes those caches. `run_record` applies the same adapter to explicit script execution. Tool decision logic is unchanged.

Two path-sensitive checks need additional explanation. CP7 runtime checks compare the same receipt-relative suffix under its new directory using copies of the receipt dictionaries, preserving every hash value. CP1 gate-mechanics tests use a temporary current-ledger fixture because CLEAN4L also rebased links inside two source briefs; the original ledger, its historical hashes, and truth remain untouched. The temporary fixture binds the actual current source bytes and retains the union-failure and no-side-effect assertions; it does not qualify the historical receipt.

Explicit sibling-worktree paths retain their original layout: CLEAN4L moved this workspace's documentation, not those source checkouts. Unmoved `docs/harvest/harvest_big`, pipeline assets, and synthetic non-relocated paths also retain their identities. Old strings in custody/origin JSON, frozen vendor Rust comments, the alias map, and historical-path resolver tests are intentional. No local executable-source lookup remains at a relocated old literal path outside those explicitly external or frozen identities.

All 19 historical-binding skip decorators in edited test files match the branch base exactly. No test was converted to a historical record because evidence moved. Truly absent inputs use the exact filename as their skip reason. Parameterized evidence that cannot be loaded at collection time has an explicit missing-file skip parameter; synthetic tests from those modules still run. This changes the collected parameter count when a bulk input is absent and does not assert that missing evidence was restored or verified.

