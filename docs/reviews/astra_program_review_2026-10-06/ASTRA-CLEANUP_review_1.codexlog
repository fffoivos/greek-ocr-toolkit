class Norm(ast.NodeTransformer):
 def visit_Constant(self,n):
  if isinstance(n.value,str):
   for old,new in moves:n.value=n.value.replace(old,new)
  return n
 def visit_Expr(self,n):
  if isinstance(n.value,ast.Constant) and isinstance(n.value.value,str):return None
  return self.generic_visit(n)
 def visit_ImportFrom(self,n):
  if n.module in ['greekocr.ops.data_root','scripts.layout_paths']:return None
  return n
 def visit_Call(self,n):
  if isinstance(n.func,ast.Name) and n.func.id in ['_data_input','relocated'] and len(n.args)==1:return self.visit(n.args[0])
  return self.generic_visit(n)
