   262	    if dict(reasons) != {k: v for k, v in summary["per_reason"].items() if v}:
   263	        raise ValueError(f"{wave}: rejection reasons differ from summary")
   264	    return dict(status="delivered", why=summary.get("status", "admission artifacts present"),
   265	                summary=summary, rows=rows, holdouts=json.loads((directory / "holdout_books.json").read_text()),
   266	                reports=reports, rejection_reasons=dict(sorted(reasons.items())))
