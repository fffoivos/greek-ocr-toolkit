   304	def polygon_box(layout, size, native_normalized=False):
   305	    poly=layout['boundingPoly']
   306	    if native_normalized or not poly.get('vertices'):
   307	        points=[(v.get('x',0)*size[0],v.get('y',0)*size[1]) for v in poly['normalizedVertices']]
   308	    else:
   309	        points=[(v.get('x',0),v.get('y',0)) for v in poly['vertices']]
   310	    return [min(p[0] for p in points),min(p[1] for p in points),max(p[0] for p in points),max(p[1] for p in points)]
