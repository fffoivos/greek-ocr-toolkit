+import ast, collections, csv, hashlib, json, os, re, subprocess
+from pathlib import Path
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+R=Path('/Users/foivoskarounos-zamparloukos/Projects/greek-ocr-toolkit-main-next')
+OUT=Path(__file__).resolve().parent
+DATA=R.parent/'greek-ocr-data'
+def git(*args):return subprocess.check_output(['git',*args],cwd=R)
+def readlines(p):
+    with p.open() as f:return [json.loads(l) for l in f if l.strip()]
+def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+result={}
+manifest=json.loads((R/'docs/harvest/line_pipeline/tool_versions.json').read_text())
+bindings=[]
+for tool,v in manifest['tools'].items():
+    for name,wanted in v['components'].items():
+        p=R.parent/name
+        actual=sha(p) if p.is_file() else None
+        bindings.append(dict(tool=tool,path=name,match=actual==wanted,actual=actual,expected=wanted))
+    encoded=json.dumps(v['components'],sort_keys=True,separators=(',',':')).encode()
+    assert hashlib.sha256(encoded).hexdigest()==v['digest']
+    assert v['iteration_count']==len(v['documented_iterations'])
+result['manifest']=dict(versions={t:v['version'] for t,v in manifest['tools'].items()},component_occurrences=len(bindings),unique_components=len({b['path'] for b in bindings}),failures=[b for b in bindings if not b['match']],digests_checked=len(manifest['tools']))
+result['codec_sha256']=sha(R/'greekocr/_vendor/codec/v2.json')
+result['slow_q4_equal']={f:git('show',f'76ad6fb4f:{f}')==(R/f).read_bytes() for f in ['greekocr/pages/lines.py','greekocr/pages/pixels.py','greekocr/pages/font.py','greekocr/glyphs/baseline.py','greekocr/glyphs/components.py']}
+result['r7_ancestor_of_r8']={c:subprocess.run(['git','merge-base','--is-ancestor',c,'cae93fb49'],cwd=R).returncode==0 for c in ['932027e210','52cee3bcc']}
+result['prototype_pytest_files']=len(list((R/'prototypes/fast_lines').rglob('test_*.py')))
+result['sf7_line_statuses']=dict(collections.Counter(row['status'] for row in json.loads((R/'artifacts/sf7_rc1/audit/final_score/final_score.json').read_text())['lines']))
+
+# Independent recount from row records, not the executor's summary scalars.
+steps=R/'docs/records/harvest/seg_steps'
+rows=readlines(steps/'s5_adopt/replay.jsonl')
+result['replay_cohorts']=dict(collections.Counter(r['cohort'] for r in rows))
+result['replay_verdict_flips']=sum(r['before']['verdict']!=r['after']['verdict'] for r in rows)
+result['replay_reason_only']=sum(r['before']['verdict']==r['after']['verdict'] and r['before']['reason']!=r['after']['reason'] for r in rows)
+gate={(r['set'],r['id']):r['outcome']=='ADMIT' for r in readlines(DATA/'docs/harvest/seg_steps/gate_rereport/row_decisions.jsonl')}
+marks=readlines(steps/'s4/owner_marks_snapshot.jsonl');typmarks=readlines(steps/'s4/typology_owner_marks_snapshot.jsonl')
+def timestamp(v):
+    v=v.get('updated','')
+    if not v:return 0
+    d=datetime.fromisoformat(v.replace('Z','+00:00'))
+    return (d if d.tzinfo else d.replace(tzinfo=ZoneInfo('Europe/Athens'))).timestamp()
+def latest(values):
+    return {r['line_id']:r for i,r in sorted(enumerate(values),key=lambda ir:(timestamp(ir[1]),ir[0]))}
+marks_by_id=latest(marks);typmarks_by_id=latest(typmarks)
+main={r['line_id']:r for r in rows if r['cohort']!='typology'}
+result['marks']=dict(entries=len(marks),unique=len(marks_by_id),typology_unique=len(typmarks_by_id))
+scores={}
+for filtered in [False,True]:
+    def choose(rs,panel):return [r for r in rs if not filtered or gate[(panel,r['line_id'])]]
+    s150=choose([r for r in rows if r['cohort']=='segeval1'],'segeval1')
+    rated=choose([r for r in rows if r.get('owner_rating',{}).get('decision') in ['KEEP','DROP']],'rated_888')
+    explicit=choose([main[i] for i in marks_by_id],'owner_marks')
+    typed=choose([r for r in rows if r['cohort']=='typology' and r['line_id'] in typmarks_by_id],'typology_marked')
+    label='post_gate' if filtered else 'unfiltered';scores[label]={}
+    for v in ['before','after']:
+        verdict=lambda r:r[v]['verdict']
+        scores[label][v]=dict(s150=dict(n=len(s150),fp=sum(verdict(r)=='DROP' and r['owner_standard_state']=='fine' for r in s150),fn=sum(verdict(r)=='KEEP' and r['owner_standard_state']=='faulty' for r in s150),unc=sum(verdict(r)=='UNCERTAIN' for r in s150)),rated=[sum(verdict(r)==r['owner_rating']['decision'] for r in rated),len(rated)],marks=[sum(verdict(r)==marks_by_id[r['line_id']]['owner_mark'] for r in explicit),len(explicit)],typology=[sum(verdict(r)==typmarks_by_id[r['line_id']]['owner_mark'] for r in typed),len(typed)])
+result['scores']=scores
+flips=readlines(steps/'s5_adopt/owner_judged_flips.jsonl')
+result['changed_owner_ids']=dict(unique=len({r['line_id'] for r in flips}),after_gate=sum(gate['changed_lines',r['line_id']] for r in flips))
+
+truth=DATA/'docs/labelfix/lqb/truth_v1_1.jsonl'
+result['lqb_truth_rows']=sum(1 for line in truth.open() if line.strip()) if truth.exists() else 'missing'
+result['collection_v2_manifest_rows']={}
+for split in ['train','dev','test']:
+    p=DATA/f'docs/harvest/collection/v2/manifest_v2_{split}.json'
+    if not p.exists():p=R/f'docs/records/harvest/collection/v2/manifest_v2_{split}.json'
+    x=json.loads(p.read_text())
+    result['collection_v2_manifest_rows'][split]=dict(type=type(x).__name__,size=len(x),keys=list(x)[:10] if isinstance(x,dict) else None)
+
+# Verify actual historical skip introduction without trusting prose.
+files=git('diff','--name-only','65c978494','78e94d640','--','tests').decode().splitlines()
+historical=[]
+for path in files:
+    try:before=ast.parse(git('show',f'65c978494:{path}'));after=ast.parse(git('show',f'78e94d640:{path}'))
+    except (SyntaxError,subprocess.CalledProcessError):continue
+    b={n.name:n for n in ast.walk(before) if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}
+    for n in ast.walk(after):
+        if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and any('Historical binding' in ast.unparse(d) for d in n.decorator_list):
+            same=n.name in b and ast.dump(ast.Module(body=n.body,type_ignores=[]))==ast.dump(ast.Module(body=b[n.name].body,type_ignores=[]))
+            historical.append(dict(path=path,function=n.name,body_unchanged=same,decorators=[ast.unparse(d) for d in n.decorator_list if 'Historical binding' in ast.unparse(d)]))
+result['historical_skips']=dict(functions=len(historical),unchanged=sum(r['body_unchanged'] for r in historical),changed=[r for r in historical if not r['body_unchanged']])
+(OUT/'historical_skip_audit.json').write_text(json.dumps(historical,indent=2)+'\n')
+(OUT/'facts.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
+print(json.dumps(result,ensure_ascii=False,indent=2))

