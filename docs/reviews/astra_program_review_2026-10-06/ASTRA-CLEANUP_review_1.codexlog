    44	def adapt_admission(rows):
    45	    """Census exports retain canonical `id`; older admissions use `row_id`."""
    46	    census = any('parent_id' in r for r in rows)
    47	    if census:
    48	        if any('parent_id' not in r for r in rows):
    49	            raise ValueError('mixed census/legacy admission formats')
    50	        rows = [r for r in rows if r['parent_id'] == W2_PARENT]
    51	        if not rows:
    52	            raise ValueError('zero W2 rows in admission')
    53	    result = []
    54	    for row in rows:
    55	        key = row.get('row_id', row.get('id'))
    56	        component(key)
    57	        if 'id' in row and 'row_id' in row and row['id'] != row['row_id']:
    58	            raise ValueError('conflicting admission row identities')
    59	        if not census and (row.get('pass') is False or row.get('admitted') is False):
    60	            raise ValueError('non-admitted row in admission input')
    61	        if census and (row.get('split', 'train') != 'train' or
    62	                       row.get('decision', {}).get('disposition', 'ADMIT') != 'ADMIT'):
    63	            raise ValueError('non-ADMIT/train census row')
    64	        result.append(dict(row, row_id=key))
    65	    if not result:
    66	        raise ValueError('zero admitted rows')
    67	    return result, 'census' if census else 'legacy'
    68	
