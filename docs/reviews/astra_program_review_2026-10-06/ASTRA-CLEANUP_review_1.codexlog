    70	def guard_output(out, features):
    71	    # Guard the metadata directory too: metadata lives beside --out.
    72	    output = out.parent.resolve()
    73	    for protected in (*READ_ONLY, features.parent):
    74	        protected = protected.resolve()
    75	        if output.is_relative_to(protected) or out.resolve().is_relative_to(protected) or protected.is_relative_to(out.resolve()):
    76	            raise ValueError('output/metadata overlaps read-only input root')
