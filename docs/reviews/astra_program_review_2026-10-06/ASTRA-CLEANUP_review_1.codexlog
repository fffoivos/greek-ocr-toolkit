def _layout_candidates(relative: PurePosixPath) -> tuple[PurePosixPath, ...]:
    value = relative.as_posix()
    for old, new in _LAYOUT_MOVES:
        for source, target in ((old, new), (new, old)):
            if value == source or value.startswith(source + '/'):
                return relative, PurePosixPath(target + value[len(source):])
    return (relative,)


@lru_cache(maxsize=4)
def _receipt_paths(root: Path) -> dict[str, Path]:
    paths = {}
    for shard in sorted((root / RECEIPTS).glob('receipt_*.tsv')):
        with shard.open(newline='') as stream:
            for row in csv.DictReader(stream, delimiter='\t'):
                paths[row['path']] = shard
    return paths


def resolve(repo_relative_path: str | os.PathLike[str]) -> Path:
    """Return the existing repo path, else its mirror under the data root.

    Missing data errors identify the exact receipt shard when known, otherwise
    RECEIPTS/INDEX.md. Absolute and escaping paths are rejected. A dangling
    symlink counts as missing data, since it cannot be loaded by a reader.
    """
    relative = PurePosixPath(os.fspath(repo_relative_path))
    if relative.is_absolute() or '..' in relative.parts or not relative.parts:
        raise ValueError(f'Expected a repo-relative data path: {repo_relative_path!s}')
    candidates = _layout_candidates(relative)
    local = REPO_ROOT / relative
    for candidate in candidates:
        available = REPO_ROOT / candidate
        if available.exists():
            return available
    data_root = os.environ.get('GREEK_OCR_DATA_ROOT')
    external = Path(data_root).expanduser() / relative if data_root else None
    if data_root:
        for candidate in candidates:
            available = Path(data_root).expanduser() / candidate
            if available.exists():
                return available
    receipts = _receipt_paths(REPO_ROOT)
    receipt = next((receipts[p.as_posix()] for p in candidates if p.as_posix() in receipts),
                   REPO_ROOT / RECEIPTS / 'INDEX.md')
    location = str(external) if external is not None else 'GREEK_OCR_DATA_ROOT is unset'
    raise FileNotFoundError(
        f'Missing Greek OCR data: {relative}; tried {local}; {location}. '
        f'Custody receipt: {receipt}. Set GREEK_OCR_DATA_ROOT to the mirrored data directory.'
    )


def input_path(path: str | os.PathLike[str]) -> Path:
    """Adapt existing readers while preserving explicit non-repository inputs.

    Keep a present path exactly as supplied (including cwd-relative paths and
    temporary test inputs). Only missing repo-local paths are sent to resolve;
    an absolute path in another checkout is never silently rebound here.
    """
    original = Path(path)
    if original.exists():
        return original
    try:
        relative = original.absolute().relative_to(REPO_ROOT)
    except ValueError:
        return original
    return resolve(relative)
"""Load CLEAN4L2 documentation aliases without editing the installed package.

Tests and repository scripts share this companion to CLEAN4L3's resolver map.
Historical receipts and mirrored bulk data keep their original path identities.
"""
from __future__ import annotations

import csv
from pathlib import Path

from greekocr.ops import data_root

ROOT = Path(__file__).resolve().parents[1]
ALIAS_MAP = ROOT / 'docs/cleanup_20261019/LAYOUT_ALIASES_2.tsv'

with ALIAS_MAP.open(newline='') as stream:
    EXTRA_MOVES = tuple((row['old'], row['new'])
                        for row in csv.DictReader(stream, delimiter='\t'))

# The resolver consults this table at call time. Install once per interpreter;
# Sort by both identities so a broad reverse alias (such as the former draft A
# directory) cannot hide a newly relocated reference file beneath that home.
data_root._LAYOUT_MOVES = tuple(sorted(
    dict((*data_root._LAYOUT_MOVES, *EXTRA_MOVES)).items(),
    key=lambda pair: max(map(len, pair)), reverse=True))
MOVES = data_root._LAYOUT_MOVES


def relocated(path):
    """Map a local historical path, retaining explicit other-checkout paths."""
    original = Path(path)
    prefix = ROOT if original.is_absolute() else Path()
    if original.is_absolute():
        try:
            relative = original.relative_to(ROOT).as_posix()
        except ValueError:
            return original
    else:
        relative = original.as_posix()
    for old, new in MOVES:
        if relative == old or relative.startswith(old + '/'):
            return prefix / (new + relative[len(old):])
    return original
"""R2C saved-data contracts and synthetic independent-reader integration."""
from copy import deepcopy
import json
from pathlib import Path

import pytest
from PIL import Image

from scripts.labelfix import r2_cards_prepare as prep
from scripts.labelfix import r2_cards_resolve as res


def heads(**changes):
    return dict(dict.fromkeys(res.HEADS,'none'),**changes)


def answer(card,form='η',**kw):
    row=dict(card_id=card['card_id'],choice='literal',transcription=form,
             anchor_heads=heads(),letter_heads=[],readability='readable',ownership_ok=True,
             confidence='high',note='',usage={'input_tokens':10,'output_tokens':5})
    row.update(kw)
    return row


@pytest.fixture
def tmp_path():
    # The adopted resolver confines all output to its own checkout. Keep the
    # synthetic deck and output disposable, but inside that boundary.
    import tempfile
    with tempfile.TemporaryDirectory(prefix='.r2c-test-', dir=Path(__file__).resolve().parents[1]) as directory:
        yield Path(directory)


@pytest.fixture
def synthetic(tmp_path):
    deck=tmp_path/'T2';(deck/'blind').mkdir(parents=True);(deck/'private').mkdir()
    image=Image.new('RGB',(40,20),'white');image.save(deck/'blind/pixels.png')
    for name in ('README.md','answer_schema.json'):
        (deck/'blind'/name).write_text('{}')
    cards=[];keys=[];controls=[]
    for ident in ['data1','data2','control1','control2','control3']:
        card=dict(card_id=ident,options={'A':'η','B':'ῃ'},anchor_index=0,
                  word_image='pixels.png',line_image='pixels.png')
        cards.append(card)
        keys.append(dict(card_id=ident,public=card,control=ident.startswith('control'),
                         crop_sha256='samecrop',crop_letter_offset=0 if ident=='data1' else 4,
                         word_index=0 if ident=='data1' else 1,slice='subscript',
                         anchor_index=0,target_head='subscript'))
        if ident.startswith('control'):
            controls.append(dict(card_id=ident,lead_verified=True,expected_form='η',
                                 expected_letter_heads=[dict(index=0,**heads())],
                                 expected_readability='readable',expected_ownership_ok=True))
    res.write(deck/'blind/cards.jsonl',cards);res.write(deck/'private/key.jsonl',keys)
    res.dump(deck/'private/controls_proposed.json',dict(controls=controls))
    r1=[answer(c) for c in cards];r2=[answer(c) for c in reversed(cards)]
    p1=tmp_path/'r1.jsonl';p2=tmp_path/'r2.jsonl'
    res.write(p1,r1);res.write(p2,r2)
    return deck,cards,p1,p2,tmp_path/'resolved'


def test_reservation_disjoint_deterministic_stratified():
    source={f'doc{i}':dict(source='a' if i<50 else 'b',era='1890s',line_count=3) for i in range(100)}
    a=prep.allocate(deepcopy(source));b=prep.allocate(dict(reversed(list(deepcopy(source).items()))))
    assert a==b
    from collections import Counter
    assert Counter(r['role'] for r in a.values())==dict(validation=10,witness=20,calibration=14,supervision=56)
    assert {r['role'] for r in a.values()}=={'validation','witness','calibration','supervision'}


@pytest.mark.parametrize('head,expected',[('breathing',3),('accent',4),('diaeresis',2),('subscript',2)])
def test_options_only_target_head_from_bases(head,expected):
    opts=prep.options('ἀῄ',1,head,'fixed')
    assert len(opts)==expected
    assert {prep.skeleton(v) for v in opts.values()}=={'αη'}
    assert opts==prep.options('αη',1,head,'fixed')
    for form in opts.values():
        cc=prep.clusters(form)
        assert cc[0]=='α'
        assert all(v=='none' for k,v in prep.tuple_heads(cc[1]).items() if k!=head)


def test_two_reader_agreement_complete_slots_and_usage(synthetic):
    deck,cards,p1,p2,out=synthetic
    truth,gates,inv=res.run(deck,p1,p2,out)
    assert all(t['status']=='resolved' for t in truth)
