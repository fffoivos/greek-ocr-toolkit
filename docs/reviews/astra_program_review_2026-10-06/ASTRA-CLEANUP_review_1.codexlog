+    explicit=choose([main[i] for i in marks_by_id],'owner_marks')
+    typed=choose([r for r in rows if r['cohort']=='typology' and r['line_id'] in typmarks_by_id],'typology_marked')
+    label='post_gate' if filtered else 'unfiltered';scores[label]={}
