new file mode 100644
index 0000000000000000000000000000000000000000..5a4eefa554b46bf72e29df4a9d9c8d58e46351b6
--- /dev/null
+++ b/audit_custody.py
@@ -0,0 +1,115 @@
+import csv, hashlib, json, os, re, subprocess, collections
+from pathlib import Path
+
+REPO = Path('/Users/foivoskarounos-zamparloukos/Projects/greek-ocr-toolkit-main-next')
+DATA = REPO.parent / 'greek-ocr-data'
+OUT = Path(__file__).resolve().parent
+BASE = 'ac1c38cf6'
+
+def git(*args):
+    return subprocess.check_output(['git', *args], cwd=REPO)
+
+def tree(ref):
+    result = {}
+    for entry in git('ls-tree', '-r', '-l', '-z', ref).split(b'\0'):
+        if entry:
+            meta, path = entry.split(b'\t', 1)
+            mode, kind, oid, size = meta.split()
+            result[os.fsdecode(path)] = dict(mode=mode.decode(), oid=oid.decode(), size=int(size))
+    return result
+
+base, head = tree(BASE), tree('HEAD')
+moves = []
+for fn in ('LAYOUT_REPORT.md', 'LAYOUT_REPORT_2.md'):
+    content = (REPO/'docs/cleanup_20261019'/fn).read_text()
+    moves.extend(re.findall(r'^\| `([^`]+)` \| `([^`]+)` \|$', content, re.M))
+moves.sort(key=lambda pair:len(pair[0]), reverse=True)
+def mapped(path):
+    # Specific moves win over broad ancestors (review contract vs review tree).
+    for old, new in moves:
+        if path == old or path.startswith(old+'/'):
+            return new + path[len(old):]
+    return path
+
+receipt_rows=[]
+shards=[]
+for f in sorted((REPO/'docs/cleanup_20261019/data_out/RECEIPTS').glob('receipt_*.tsv')):
+    rows=list(csv.DictReader(f.open(), delimiter='\t'))
+    shards.append(dict(shard=f.name, entries=len(rows), payload_bytes=sum(int(r['bytes']) for r in rows), tsv_bytes=f.stat().st_size, sha256=hashlib.sha256(f.read_bytes()).hexdigest()))
+    for r in rows:
+        r['shard']=f.name
+    receipt_rows.extend(rows)
+receipts={r['path']:r for r in receipt_rows}
+manifest=list(csv.DictReader((REPO/'docs/cleanup_20261019/data_out/MOVE_MANIFEST.tsv').open(),delimiter='\t'))
+manifest_by_path={r['path']:r for r in manifest}
+counts=collections.Counter()
+unaccounted=[]
+changed=[]
+accounting=[]
+for path, old in base.items():
+    dest=mapped(path)
+    if dest in head:
+        status='moved' if dest!=path else 'same_path'
+        if old['oid']==head[dest]['oid']:
+            status+='_identical'
+        else:
+            status+='_modified'
+            changed.append(dict(old=path, new=dest, old_oid=old['oid'], new_oid=head[dest]['oid']))
+    elif path in head:
+        dest=path
+        status='same_path_identical' if old['oid']==head[path]['oid'] else 'same_path_modified'
+    elif path in receipts or dest in receipts:
+        key=path if path in receipts else dest
+        dest=key
+        status='external_receipted'
+    else:
+        status='UNACCOUNTED'
+        unaccounted.append(path)
+    counts[status]+=1
+    accounting.append(dict(base_path=path, disposition=status, destination=dest))
+
+errors=[]
+hash_rows=[]
+total_hash_bytes=0
+for i,r in enumerate(receipt_rows):
+    p=DATA/r['path']
+    if not os.path.lexists(p):
+        errors.append(dict(path=r['path'],error='missing'))
+        continue
+    if p.is_symlink():
+        blob=os.fsencode(os.readlink(p))
+        size=len(blob)
+        sha=hashlib.sha256(blob).hexdigest()
+        oid=hashlib.sha1(b'blob '+str(size).encode()+b'\0'+blob).hexdigest()
+    elif p.is_file():
+        size=p.stat().st_size
+        digest=hashlib.sha256()
+        g=hashlib.sha1(b'blob '+str(size).encode()+b'\0')
+        with p.open('rb') as stream:
+            for chunk in iter(lambda:stream.read(1024*1024),b''):
+                digest.update(chunk); g.update(chunk)
+        sha=digest.hexdigest();oid=g.hexdigest()
+    else:
+        errors.append(dict(path=r['path'],error='not_file_or_symlink'))
+        continue
+    total_hash_bytes+=size
+    source=base.get(r['path'])
+    if source is None:
+        source=next((v for k,v in base.items() if mapped(k)==r['path']),None)
+    mismatch=[]
+    if size!=int(r['bytes']):mismatch.append('size')
+    if sha!=r['sha256']:mismatch.append('receipt_sha256')
+    if source and oid!=source['oid']:mismatch.append('base_git_oid')
+    if mismatch:errors.append(dict(path=r['path'],error=mismatch))
+    hash_rows.append(dict(path=r['path'],size=size,sha256=sha,git_oid=oid,base_present=source is not None,base_oid_match=oid==source['oid'] if source else None))
+    if i%4000==0:print('hashed',i,flush=True)
+
+manifest_errors=[]
+for p,r in manifest_by_path.items():
+    if p not in receipts:manifest_errors.append(dict(path=p,error='manifest_without_receipt'))
+    elif any(r[k]!=receipts[p][k] for k in ('bytes','sha256')):manifest_errors.append(dict(path=p,error='manifest_receipt_mismatch'))
+
+summary=dict(base=git('rev-parse',BASE).decode().strip(),head=git('rev-parse','HEAD').decode().strip(),base_files=len(base),head_files=len(head),base_bytes=sum(r['size'] for r in base.values()),head_bytes=sum(r['size'] for r in head.values()),layout_rows=len(moves),dispositions=dict(counts),unaccounted=unaccounted,receipt_shards=shards,receipt_rows=len(receipt_rows),duplicate_receipt_paths=len(receipt_rows)-len(receipts),manifest_rows=len(manifest),receipt_paths_without_manifest=sorted(set(receipts)-set(manifest_by_path)),manifest_errors=manifest_errors,hash_files=len(hash_rows),hash_bytes=total_hash_bytes,hash_errors=errors,head_oversized=[dict(path=p,**r) for p,r in head.items() if r['size']>5_000_000],head_largest=sorted((dict(path=p,**r) for p,r in head.items()),key=lambda r:r['size'],reverse=True)[:10])
+for name,obj in [('custody_summary.json',summary),('custody_accounting.json',accounting),('custody_hashes.json',hash_rows),('modified_base_files.json',changed)]:
+    (OUT/name).write_text(json.dumps(obj,indent=2)+'\n')
+print(json.dumps(summary,indent=2))

