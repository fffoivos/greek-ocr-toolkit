     3	Tests and repository scripts share this companion to CLEAN4L3's resolver map.
     4	Historical receipts and mirrored bulk data keep their original path identities.
     5	"""
     6	from __future__ import annotations
     7	
     8	import csv
     9	from pathlib import Path
    10	
    11	from greekocr.ops import data_root
    12	
    13	ROOT = Path(__file__).resolve().parents[1]
    14	ALIAS_MAP = ROOT / 'docs/cleanup_20261019/LAYOUT_ALIASES_2.tsv'
    15	
    16	with ALIAS_MAP.open(newline='') as stream:
    17	    EXTRA_MOVES = tuple((row['old'], row['new'])
    18	                        for row in csv.DictReader(stream, delimiter='\t'))
    19	
    20	# The resolver consults this table at call time. Install once per interpreter;
    21	# Sort by both identities so a broad reverse alias (such as the former draft A
    22	# directory) cannot hide a newly relocated reference file beneath that home.
    23	data_root._LAYOUT_MOVES = tuple(sorted(
    24	    dict((*data_root._LAYOUT_MOVES, *EXTRA_MOVES)).items(),
    25	    key=lambda pair: max(map(len, pair)), reverse=True))
    26	MOVES = data_root._LAYOUT_MOVES
    27	
    28	
    29	def relocated(path):
    30	    """Map a local historical path, retaining explicit other-checkout paths."""
    31	    original = Path(path)
    32	    prefix = ROOT if original.is_absolute() else Path()
    33	    if original.is_absolute():
    34	        try:
    35	            relative = original.relative_to(ROOT).as_posix()
    36	        except ValueError:
    37	            return original
    38	    else:
    39	        relative = original.as_posix()
    40	    for old, new in MOVES:
    41	        if relative == old or relative.startswith(old + '/'):
    42	            return prefix / (new + relative[len(old):])
