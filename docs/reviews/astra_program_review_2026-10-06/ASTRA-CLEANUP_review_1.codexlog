x=json.loads(Path('artifacts/sf7_rc1/audit/final_score/final_score.json').read_text());print('sf7 keys',[(k,len(v) if isinstance(v,(list,dict)) else v) for k,v in x.items()])
print('s5 files',[p.name for p in (base/'s5_adopt').iterdir()])
