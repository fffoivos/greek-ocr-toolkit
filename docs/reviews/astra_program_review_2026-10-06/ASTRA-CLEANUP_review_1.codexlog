    78	
    79	def stage(admitted, features, out, *, extend=False, minimum_free_gb=10):
    80	    if not os.path.samefile(sys.executable, INTERPRETER):
    81	        raise RuntimeError('use ' + str(INTERPRETER))
    82	    sys.path.insert(0, str(COLLECTOR))
    83	    from collect_v3.storage import ensure_crop
    84	    from collect_v3.common import atomic_bytes
    85	    import PIL
    86	
    87	    admitted, features, out = (Path(p).expanduser().absolute() for p in (admitted, features, out))
    88	    guard_output(out, features)
    89	    if minimum_free_gb < 0:
    90	        raise ValueError('negative disk floor')
    91	    if admitted.resolve().is_relative_to(out.resolve()):
    92	        raise ValueError('admitted input is inside output')
    93	    data = gzip.decompress(admitted.read_bytes()) if admitted.suffix == ".gz" else admitted.read_bytes()
    94	    rows = [json.loads(line) for line in data.splitlines() if line.strip()]
    95	    rows, admission_format = adapt_admission(rows)
    96	    applications = {r.get('application_manifest_sha256', r.get('admission', {}).get('application_manifest_sha256')) for r in rows}
    97	    if len(applications) > 1:
    98	        raise ValueError('mixed application identities')
    99	    application = next(iter(applications), None)
   100	    ids = [row['row_id'] for row in rows]
   101	    if len(set(ids)) != len(ids):
   102	        raise ValueError('duplicate admitted row_id')
   103	    wanted = set(ids)
   104	    joined = {}
   105	    feature_hash = hashlib.sha256()
   106	    # One read-only descriptor, no locks, no collector materialize/finalize calls.
   107	    with features.open('rb') as stream:
   108	        before = os.fstat(stream.fileno())
   109	        for line in stream:
   110	            feature_hash.update(line)
   111	            if not line.strip():
   112	                continue
   113	            row = json.loads(line)
   114	            key = row.get('row_id', row.get('id'))
   115	            if key in wanted:
   116	                if key in joined:
   117	                    raise ValueError('duplicate feature row_id: ' + key)
   118	                joined[key] = row
   119	        after = os.fstat(stream.fileno())
   120	    if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
   121	        raise RuntimeError('features changed during read; retry against a stable file')
   122	    if admission_format == 'legacy' and any(f.get('tranche') == 'W2' for f in joined.values()):
   123	        # Select the W2 cohort even when legacy input contains other waves.
   124	        rows = [dict(r, parent_id=W2_PARENT) for r in rows
   125	                if joined.get(r['row_id'], {}).get('tranche') == 'W2']
   126	    if 'W2' in features.name and not any(f.get('tranche') == 'W2' for f in joined.values()):
   127	        raise ValueError('zero W2 rows in admission')
   128	    old_path = out.parent / "crops_manifest.jsonl"
   129	    previous = [json.loads(line) for line in old_path.read_text().splitlines()] if old_path.exists() else []
   130	    if len({r["row_id"] for r in previous}) != len(previous):
   131	        raise ValueError("duplicate previous manifest row_id")
   132	    manifest, failures = [], []
   133	    disk_deferred = []
   134	    new_count = 0
   135	    out.parent.mkdir(parents=True, exist_ok=True)
