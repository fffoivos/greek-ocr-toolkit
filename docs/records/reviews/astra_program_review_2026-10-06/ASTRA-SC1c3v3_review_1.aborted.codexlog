   365	def _reader_reasons(slot, prediction, coverage, prefix):
   366	    reasons=[]
   367	    if prediction is None:reasons.append(prefix+'_missing')
   368	    elif not ('parts' in prediction or 'cls' in prediction):reasons.append(prefix+'_prediction_invalid')
   369	    if prediction and prediction.get('base',slot['base'])!=slot['base']:reasons.append(prefix+'_base_mismatch')
   370	    if coverage is None:reasons.append(prefix+'_missing_coverage')
   371	    else:
   372	        if coverage.get('base',slot['base'])!=slot['base']:reasons.append(prefix+'_coverage_base_mismatch')
   373	        if coverage.get('scored') is not True:reasons.append(prefix+'_unscored:'+str(coverage.get('reason')))
   374	        if coverage.get('evidence_state') in (None,'UNKNOWN'):reasons.append(prefix+'_evidence_UNKNOWN')
   375	        if not isinstance(coverage.get('uncertainty'),(list,tuple)):
   376	            reasons.append(prefix+'_uncertainty_not_recorded')
   377	        else:reasons.extend(prefix+'_uncertainty:'+str(z) for z in coverage['uncertainty'])
   378	    if prediction is not None:
   379	        if prediction.get('evidence_state')=='UNKNOWN':reasons.append(prefix+'_evidence_UNKNOWN')
   380	        reasons.extend(prefix+'_uncertainty:'+str(z) for z in (prediction.get('uncertainty') or ()))
   381	        parts=prediction.get('parts',prediction.get('cls','none').split('+'))
   382	        if any(p not in R.MARKS and p!='none' for p in parts):reasons.append(prefix+'_unsupported_mark')
   383	    return reasons
