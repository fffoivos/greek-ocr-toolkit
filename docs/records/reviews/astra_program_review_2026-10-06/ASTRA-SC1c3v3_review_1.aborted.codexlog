   141	
   142	def capital_features(ink, slots):
   143	    """Geometric pixel vote, independent of recognizer case and frozen model weights."""
   144	    guides=ink.shared_guides
   145	    for s in slots:
   146	        c=s['component']; x=min(ink.width-1,max(0,int(c.cx)))
   147	        mask=I.component_mask(ink,c)
   148	        cut=int(np.clip(np.floor(guides.mean[x])-c.y0,0,mask.shape[0]))
   149	        upper=mask[:cut];lower=mask[cut:]
   150	        uw=int(upper.any(axis=0).sum()) if upper.size else 0
   151	        lw=int(lower.any(axis=0).sum()) if lower.size else 0
   152	        cap=(abs(c.y0-guides.ascender[x])<=.18*ink.xh and
   153	             abs(c.y1-guides.base[x])<=.18*ink.xh and c.w>=.5*ink.xh and uw>=.6*max(lw,1))
   154	        s['toolkit_capital_features']=dict(ascender_distance=(c.y0-guides.ascender[x])/ink.xh,
   155	            baseline_distance=(c.y1-guides.base[x])/ink.xh,upper_width=uw,body_width=lw,
   642	def apostrophe_candidates(ink, letters):
   643	    """Geometric elision signs after an input-text word-final consonant.
   644	
   645	    `letters` supplies (component, base, word_final) from locator-only mapping.
   646	    A sign must be detached, at meanline height, between words; no vowel under it.
   647	    Returns slot-index -> blobs; the recogniser supplies no mark reading.
   648	    """
   649	    out = {}
   650	    for i, (body, base, final) in enumerate(letters):
   651	        if not final or base.lower() not in 'δτρθπ':
   652	            continue
   653	        top, _ = ink.band(body.cx)
   654	        nxt = letters[i+1][0].x0 if i+1 < len(letters) else ink.width
   655	        for c in ink.components:
   656	            if c.role not in ('mark', 'punct', 'fragment') or c.x0 < body.x1 - .1*ink.xh:
   657	                continue
   658	            if not (body.x1 <= c.cx < nxt and c.cx-body.x1 <= .65*ink.xh):
   659	                continue
   660	            if not (.10*ink.xh <= c.h <= .8*ink.xh and c.w <= .6*ink.xh
   661	                    and top-1.1*ink.xh <= c.y0 and c.y1 <= top+.25*ink.xh):
   662	                continue
   663	            b = _blob(component_mask(ink,c),c.y0,c.x0,'apostrophe',ink)
   664	            if b.area >= MIN_BLOB_AREA and not b.faint:
   665	                out.setdefault(i, []).append(b)
   666	    return out
   667	
   668	
   669	def opening_quote_candidates(ink, first_body, reserved=()):
   670	    """Detached line-initial quote ink, separate from a capital's own marks.
   671	
   672	    Single curved opening signs occur in these editions. Ambiguous leading
   673	    apostrophe/quote semantics remain a flag; the pixels are not vowel marks.
   674	    """
   675	    top, _ = ink.band(first_body.cx)
   676	    used = {(b.x0,b.y0,b.x1,b.y1) for b in reserved}
   677	    out = []
   678	    for c in ink.components:
   679	        if c.role not in ('punct','mark','fragment') or c.x1 >= first_body.x0:
   680	            continue
   681	        if (c.x0,c.y0,c.x1,c.y1) in used:
   682	            continue
   683	        if not (.2*ink.xh <= c.h <= .9*ink.xh and .12*ink.xh <= c.w <= .8*ink.xh
   684	                and top-1.2*ink.xh <= c.y0 and c.y1 <= top+.25*ink.xh):
   685	            continue
   686	        b = _blob(component_mask(ink,c),c.y0,c.x0,'opening_quote',ink)
   687	        if not b.faint and not b.touches_border:
   688	            out.append(b)
   689	    return out
