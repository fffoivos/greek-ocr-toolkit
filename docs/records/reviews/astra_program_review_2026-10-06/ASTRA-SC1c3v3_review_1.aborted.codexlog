    91	def effective(original,recogniser,decision,policy,runtime=None):
    92	    label=sf5.effective_label(policy,original,recogniser,decision,sf5=True)
    93	    checks=gate.deletion_guard(original,label['proposal'],runtime,decision) if runtime else []
    94	    if any(not c['allowed'] for c in checks):label.update(status='hold',label=original,alias_only=False)
    95	    label['deletion_checks']=checks
    96	    return label
