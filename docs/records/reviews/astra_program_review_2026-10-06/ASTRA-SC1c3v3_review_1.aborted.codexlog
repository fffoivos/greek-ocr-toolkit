    81	def physical_slots(ink, text, alignment):
    82	    from .segmentation import _region
    83	    text=nfd(text); alignment=transfer_alignment(text,alignment)
    84	    boxes=letter_boxes(glyph_view(ink))
    85	    tokens=tokenize(text); slots=[]; owners={}
    86	    for cl in clusters(text):
    87	        if not cl.base.isalpha(): continue
    88	        sp=alignment.span(cl.start)
    89	        overlap=[I._overlap(sp.x0,sp.x1,b.x0,b.x1)/np.sqrt(max(b.w,.35*ink.xh)) for b in boxes]
    90	        k=max(range(len(boxes)),key=lambda i:overlap[i]) if boxes else None
    91	        if k is not None and overlap[k]<=0: k=None
    92	        s=dict(base=cl.base,start=cl.start,end=cl.end,locator_span=[sp.x0,sp.x1],
    93	               primary=k,indices=[],component_ids=[],component=None,
    94	               word_final=any(cl.end==t.core_end for t in tokens),
    95	               word_index=next((t.index for t in tokens if t.core_start<=cl.start<t.core_end),-1),
    96	               fused=False,split_union=False,localisation_unknown=False,
    97	               segmentation_source='toolkit_middle_pieces')
    98	        slots.append(s)
    99	        if k is not None: owners.setdefault(k,[]).append(s)
   100	    ink.physical_letters=[dict(x0=b.x0,y0=b.y0,x1=b.x1,y1=b.y1,
   101	                              parents=list(b.components),pieces=b.pieces,merged=b.merged,resolved=b.resolved,
   102	                              recognizer_starts=[s['start'] for s in owners.get(i,[])]) for i,b in enumerate(boxes)]
   103	    ink.physical_mapping=dict(physical_groups=len(boxes),recognizer_letters=len(slots),
   104	        count_disagreement=len(boxes)!=len(slots),
   105	        unassigned_physical=[i for i in range(len(boxes)) if i not in owners],
   106	        shared_physical=[i for i,ss in owners.items() if len(ss)>1],
   107	        unresolved_physical=[i for i,b in enumerate(boxes) if not b.resolved])
   108	    ink.physical_mapping['ambiguous']=bool(ink.physical_mapping['count_disagreement'] or
   109	        ink.physical_mapping['unassigned_physical'] or ink.physical_mapping['shared_physical'] or
   110	        ink.physical_mapping['unresolved_physical'])
   111	    lookup={c.index:c for c in ink.components}
   112	    for k,ss in owners.items():
   113	        b=boxes[k]; ambiguous=len(ss)!=1 or not b.resolved
   114	        for s in ss:
   115	            c=_region(ink,[lookup[i] for i in b.components],b.x0,b.x1)
   116	            # The toolkit also bounds this group's vertical custody to its
   117	            # own line. Do not re-expand a parent label into a neighbouring row.
   118	            if c is not None:
   119	                y0=max(c.y0,b.y0);y1=min(c.y1,b.y1)
   120	                mask=I.component_mask(ink,c)[y0-c.y0:y1-c.y0].copy()
   121	                mask.setflags(write=False)
   122	                c=SimpleNamespace(**{**vars(c),'y0':y0,'y1':y1,'h':y1-y0,'mask':mask})
   123	            s.update(component=c,component_ids=list(b.components),indices=[],
   124	                     region_bounds=[b.x0,b.x1],fused=b.merged>1 or len(ss)>1,
   125	                     fusion_size=max(b.merged,len(ss)),split_union=len(b.components)>1,
   126	                     segmentation_uncertain=ambiguous,localisation_unknown=ambiguous,
   127	                     physical_resolved=b.resolved,physical_piece_count=b.pieces,
   128	                     physical_recognizer_count=len(ss),
   129	                     ambiguity='physical_recognizer_count' if len(ss)!=1 else 'unresolved_bridge' if not b.resolved else None)
   130	    for s in slots:
   131	        if s['component'] is not None: continue
   132	        a,b=s['locator_span']; left=max(0,min(ink.width-1,int(a)));right=min(ink.width,max(left+1,int(b)))
   133	        top,base=ink.band((left+right)/2)
   134	        s.update(component=SimpleNamespace(index=-s['start']-1,x0=left,x1=right,y0=int(top),y1=int(base),
   135	                                          cx=(left+right)/2,w=right-left,h=base-top,role='letter'),
   136	                 region_bounds=[left,right],localisation_unknown=True,segmentation_uncertain=True,
   137	                 physical_resolved=False,physical_piece_count=0,physical_recognizer_count=1,
   138	                 ambiguity='no_physical_piece')
