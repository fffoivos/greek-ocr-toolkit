   112	    elif defect=='unknown':rt['coverage'][0]['evidence_state']='UNKNOWN'
   113	    elif defect=='uncertain':rt['coverage'][0]['uncertainty']=['crop_clipped']
   114	    elif defect=='out_of_window':rt['coverage'][0]['span']=[-1,10]
   115	    elif defect=='clipped_top':s['evidence']['clipped_top']=True
   116	    elif defect=='unseen':s['evidence']['observation']={'above':'UNSEEN'}
   117	    elif defect=='unnamed':s['unnamed']=[0]
   118	    elif defect=='unscored_recogniser':rt.pop('recognition_confidence')
   119	    elif defect=='unknown_detector':
   120	        # Keep recognised mark; A/B absence is still just one signal.
   121	        rt=rich('ά');rt.pop('recognition_confidence');s=rt['detector']['slots'][0]
   122	        s['parts']=[];s['evidence'].pop('observation')
   123	        for records in [rt['r1_predictions'],*rt['peer_predictions'].values()]:records[0]['parts']=[]
   124	    elif defect=='peer_unscored':rt['peer_coverage']['B'][0]['scored']=False
   125	    assert overlay(policy,'ά',rt)['status']=='hold'
