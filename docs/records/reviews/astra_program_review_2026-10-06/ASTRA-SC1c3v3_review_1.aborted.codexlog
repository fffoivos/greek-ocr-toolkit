    42	def prepare():
    43	    """Copy fresh SF5 witnesses, plus all 48 L1A lines from saved evidence."""
    44	    dest=EV/'witness_inputs.jsonl.gz'
    45	    inputs=list(rows(DOC/'SF5_evidence/witness_inputs.jsonl.gz'))
    46	    for r in inputs:r['cohort']='sf5'
    47	    s8=Path.home()/'Projects/greek-ocr-toolkit-spellcheck-s8/docs/labelfix/spellcheck'
    48	    l1=Path.home()/'Projects/greek-ocr-toolkit-spellcheck-l1/docs/labelfix/spellcheck/L1M_evidence'
    49	    audit=s8/'S8_DEV/private/audit/items_key.json'
    50	    wanted={r['line_id'] for r in json.loads(audit.read_text()) if not r['control']}
    51	    assert len(wanted)==48
    52	    records={r['id']:r for r in rows('docs/harvest/collection/v2/import_real_v2_train.jsonl') if r['id'] in wanted}
    53	    oldgate,oldcommon=baseline()
    54	    for pool in ('200','vouli'):
    55	        with gzip.open(l1/f'remote_{pool}.json.gz','rt') as f:remote=json.load(f)['runtime']
    56	        for r in rows(l1/pool/'details.jsonl.gz'):
    57	            lid=r['id']
    58	            if lid not in wanted:continue
    59	            saved=r['modes']['masked']['ENSEMBLE_AB'];rt=deepcopy(remote[lid])
    60	            rt['detector']=r['detector']['masked']
    61	            # L1M holds the reader fixed but remaps observation to the masked crop.
    62	            rt['coverage']=[s['r1_coverage'] for s in saved['slots'] if s.get('r1_coverage') is not None]
    63	            rt['peer_coverage']={'B':[s['peer_coverage'] for s in saved['slots'] if s.get('peer_coverage') is not None]}
    64	            rt['peer_predictions']={'B':[s['peer_prediction'] for s in saved['slots'] if s.get('peer_prediction') is not None]}
    65	            rt.pop('evidence_sha256',None)
    66	            # The SF5 composer must reproduce all saved per-slot decisions exactly.
    67	            actual=oldgate.compose_runtime(rt,'ENSEMBLE_AB')
    68	            assert actual['slots']==saved['slots'],lid
    69	            record=dict(records[lid],id=lid,script_class='greek_poly')
    70	            inputs.append(dict(id=lid,cohort='l1a',kind='l1a_audit',record=record,runtime=rt))
    71	    assert sum(r['cohort']=='l1a' for r in inputs)==48
    72	    # Probe runtimes are fixtures of the reviewer's synthetic saved-text cases,
    73	    # never claims of newly observed detector evidence.
    74	    from tests.labelfix.test_sf5 import synthetic
    75	    for i,case in enumerate(json.loads(PROBE.read_text())['cases']):
    76	        record=dict(id=f'quote-probe-{i:02}',label=case['original'],script_class='greek_poly')
    77	        rt=synthetic(case['recogniser'])
    78	        rt['id']=record['id']
    79	        prior=oldcommon.overlay(record,rt,case['mode'],BINDING)
    80	        assert prior['label']==case['after'],(i,prior)
    81	        inputs.append(dict(id=record['id'],cohort='quote_probe',kind='leading_quote',
    82	                           mode=case['mode'],record=record,runtime=rt))
    83	    write_rows(dest,inputs)
    84	    paths=[DOC/'SF5_evidence/witness_inputs.jsonl.gz',audit,l1/'remote_200.json.gz',
    85	           l1/'200/details.jsonl.gz',l1/'remote_vouli.json.gz',l1/'vouli/details.jsonl.gz',Path('docs/harvest/collection/v2/import_real_v2_train.jsonl'),PROBE]
    86	    write_json(EV/'witness_inputs_receipt.json',dict(inputs={str(p):sha256(p) for p in paths},
    87	        output_sha256=sha256(dest),cohorts=dict(Counter(r['cohort'] for r in inputs)),
    88	        l1a_full_slot_parity=48,detector_runs=0,r1_runs=0,ctc_runs=0,network=False))
