    99	def census_summary(records):
   100	    result={m:dict(before=Counter(),after=Counter(),held=Counter(),punctuation_held=Counter(),
   101	                   all_held=Counter(),punctuation_all_held=Counter(),
   102	                   single_source_before=0,single_source_after=0,uncertified_before=0,uncertified_after=0)
   103	            for m in gate.MODES}
   104	    for r in records:
   105	        d=result[r['mode']];before=r['before'];after=r['after'];events=r['checks']
   106	        if after['status']=='hold':
   107	            cats={c['category'] for c in events if not c['allowed']}
   108	            d['all_held'].update(cats)
   109	            punct=cats&{'apostrophe','quote','keraia'}
   110	            d['punctuation_all_held'].update(punct)
   111	            d['punctuation_all_held']['union']+=bool(punct)
   112	        for phase,label in [('before',before),('after',after)]:
   113	            if label['status']=='hold':continue
   114	            for event in events:
   115	                d[phase][event['category']]+=1
   116	                if not event['allowed']:d['uncertified_'+phase]+=1
   117	                if sum(event['signals'].values())==1 and not event['allowed']:d['single_source_'+phase]+=1
   118	        if before['status']!='hold' and after['status']=='hold':
   119	            cats={c['category'] for c in events if not c['allowed']}
   120	            d['held'].update(cats)
   121	            # Counts by class can overlap; this is the distinct union.
   122	            punct=cats&{'apostrophe','quote','keraia'}
   123	            d['punctuation_held'].update(punct)
   124	            d['punctuation_held']['union']+=bool(punct)
   125	    return {m:{k:dict(v) if isinstance(v,Counter) else v for k,v in d.items()} for m,d in result.items()}
