   275	def add_census(path):
   276	    """Accept a pulled JSON/JSONL(.gz) census with saved runtime or overlays.
   277	
   278	    Each deletion row needs record+runtime, or a full SF5 overlay (including
   279	    edit evidence) plus google/original_label. Nothing missing is synthesized.
   280	    """
   281	    opener=gzip.open if path.suffix=='.gz' else open
   282	    with opener(path,'rt') as f:data=f.read()
   283	    try:
   284	        decoded=json.loads(data)
   285	        values=(decoded if isinstance(decoded,list) else
   286	                next((decoded[k] for k in ('records','cases','lines') if k in decoded),[decoded]))
   287	    except json.JSONDecodeError:values=[json.loads(line) for line in data.splitlines() if line.strip()]
   288	    material_paths=[]
   289	    if isinstance(values,list) and len(values)==1 and 'modes' in values[0]:
   290	        # L1R2's pulled CHANGES.json is an aggregate with up to 20 examples per
   291	        # class/wave, not a runtime export. Never turn those IDs into evidence.
   292	        aggregate=values[0];ids=set()
   293	        def collect(node):
   294	            if not isinstance(node,dict):return
   295	            for key,value in node.items():
   296	                if key=='deletions_by_class':
   297	                    for bucket in value.values():ids.update(bucket.get('example_ids',()))
   298	                else:collect(value)
   299	        collect(aggregate.get('modes',{}).get('ENSEMBLE_AB',{}))
   300	        if len(ids)<30:raise ValueError(f'census witnesses pending: only {len(ids)} AB deletion example IDs; need 30')
   301	        candidates_paths=[]
   302	        for parent in [path.parent,*list(path.parents)[1:3]]:
   303	            candidates_paths.extend(parent/name for name in ('witness_inputs.jsonl.gz','deletion_witness_inputs.jsonl.gz',
   304	                'overlay_ensemble_ab.jsonl.gz','release/overlay_ensemble_ab.jsonl.gz'))
   305	        if aggregate.get('witness_inputs_file'):
   306	            candidates_paths.insert(0,path.parent/aggregate['witness_inputs_file'])
   307	        candidates_paths.append(EV/'witness_inputs.jsonl.gz')
   308	        supplied={};overlays={}
   309	        for candidate in dict.fromkeys(candidates_paths):
   310	            if not candidate.is_file():continue
   311	            material_paths.append(candidate)
   312	            for r in rows(candidate):
   313	                lid=r.get('id',r.get('line_id'))
   314	                if lid not in ids:continue
   315	                if 'runtime' in r and 'record' in r:supplied[lid]=r
   316	                elif r.get('status')=='corrected' and r.get('changes'):overlays[lid]=r
   317	        needed=set(overlays)-supplied.keys()
   318	        originals=({r['id']:r['label'] for r in rows('docs/harvest/collection/v2/import_real_v2_train.jsonl') if r['id'] in needed}
   319	                   if needed else {})
   320	        supplied.update({lid:dict(line_id=lid,original_label=originals[lid],overlay=o)
   321	                         for lid,o in overlays.items() if lid in originals and lid not in supplied})
   322	        if len(supplied)<30:
   323	            write_json(EV/'census_pending.json',dict(census=str(path),sha256=sha256(path),seed=6,
   324	                candidate_ids=sorted(ids),available_saved_inputs=sorted(supplied),
   325	                missing_saved_inputs=sorted(ids-supplied.keys()),
   326	                required='Place deletion_witness_inputs.jsonl.gz (record+runtime), or overlay_ensemble_ab.jsonl.gz, beside CHANGES.json; then rerun --add-census'))
   327	            raise ValueError(f'census witnesses pending: {len(supplied)}/{len(ids)} AB example IDs have saved runtime/overlays; see census_pending.json')
   328	        values=list(supplied.values())
   329	    candidates={}
   330	    oldgate,oldcommon=baseline()
   331	    for r in values:
   332	        lid=r.get('id',r.get('line_id'))
   333	        if 'runtime' in r and 'record' in r:w=dict(r,id=lid)
   334	        else:
   335	            o=r.get('overlay',r.get('sf5_overlay'))
   336	            if o is None and 'changes' in r:o=r
   337	            original=r.get('google',r.get('original_label'))
   338	            if o is None or original is None:
   339	                raise ValueError('census needs saved runtime or full overlay and original_label: '+str(lid))
   340	            assert common.label_sha(original)==o['original_label_sha256'],lid
   341	            w=dict(id=lid,record=dict(id=lid,label=original,script_class='greek_poly'),runtime=sf5.runtime_from_overlay(o))
   342	        prior=oldcommon.overlay(w['record'],w['runtime'],'ENSEMBLE_AB',BINDING)
   343	        if 'runtime' not in r:
   344	            assert (prior['status'],prior.get('label'))==(o['status'],o.get('label')),lid
   345	        if prior['status']=='hold' or not gate.google_deletions(w['record']['label'],prior['label']):continue
   346	        assert lid not in candidates,'duplicate census line: '+lid
   347	        candidates[lid]=dict(w,cohort='census',kind='seeded_census',mode='ENSEMBLE_AB')
   348	    if len(candidates)<30:raise ValueError(f'need 30 distinct released deletion lines; got {len(candidates)}')
   349	    ids=random.Random(6).sample(sorted(candidates),30)
   350	    write_rows(EV/'census_inputs.jsonl.gz',[candidates[lid] for lid in ids])
   351	    write_json(EV/'census_receipt.json',dict(path=str(path),sha256=sha256(path),seed=6,
   352	        eligible_lines=len(candidates),selected_ids=ids,output_sha256=sha256(EV/'census_inputs.jsonl.gz'),
   353	        saved_materials={str(p):sha256(p) for p in material_paths}))
