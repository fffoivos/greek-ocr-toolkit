    92	    if big.width>1000:big=big.resize((1000,int(big.height*1000/big.width)),Image.Resampling.LANCZOS)
    93	    side=dict(reading=record['text'],boxes=boxes,letters=[[s['bbox'][0],s['bbox'][2]] for s in record['slots'] if s['bbox']],
    94	              letter_zones=zones,line_reading=record,raw_line_reading=rawrecord,reading_configuration=config)
    95	    return reading_html(record),record['text'],uri(big),side
