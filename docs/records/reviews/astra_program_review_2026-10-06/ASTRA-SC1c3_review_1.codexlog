    20	MARKS = dict(psili='\u0313', dasia='\u0314', acute='\u0301', grave='\u0300',
    21	             circumflex='\u0342', subscript='\u0345', dialytika='\u0308')
    22	ELISION = "'’ʼ᾽"
    23	
    24	
    25	@dataclass
    26	class LineReading:
    27	    """Independent text with slot evidence and parallel unresolved-mark flags."""
    28	    text: str
    29	    slots: list
    30	    unnamed: list
    31	    opening_quotes: list = field(default_factory=list)
    32	    removed_by_constraint: list = field(default_factory=list)
    33	    constraint_flags: list = field(default_factory=list)
    34	    geometry: dict = field(default_factory=dict)
