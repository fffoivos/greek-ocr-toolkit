    32	def infer(historical,window_audit,checkpoints,out,code_hashes,device='cuda:0',batch_size=512):
    33	    out=Path(out);out.mkdir(parents=True,exist_ok=True)
    34	    started=time.monotonic()
    35	    torch.set_num_threads(4 if device=='cpu' else 8)
    36	    torch.backends.cuda.matmul.allow_tf32=False;torch.backends.cudnn.allow_tf32=False
    37	    models={a:load_reader(p['path'],a,p['sha256'],device) for a,p in checkpoints.items() if a in ('B','E')}
    38	    checked(checkpoints['A']['path'],checkpoints['A']['sha256'])
    39	    ck=torch.load(checkpoints['A']['path'],map_location='cpu',weights_only=True)
    40	    if ck['arm']!='A':raise ValueError('historical A checkpoint arm mismatch')
    41	    historical=Path(historical);top=json.loads((historical/'run_receipt.json').read_text())
    42	    if not top['complete']:raise ValueError('historical run incomplete')
    43	    result=[]
    44	    checkpoint_hashes={a:p['sha256'] for a,p in checkpoints.items()}
    45	    for e in window_audit['entries']:
    46	        number=e['shard'];paths=shard_inputs(historical/'detector',number)
    47	        old=historical/'combined'/f'shard-{number:05d}-combined.jsonl.gz'
    48	        op=old.with_name(old.name.replace('-combined.jsonl.gz','-receipt.json'))
    49	        checked(op,top['step_receipts'][str(op.relative_to(historical))])
    50	        old_receipt=json.loads(op.read_text());checked(old,old_receipt['output_sha256'])
    51	        dest=out/old.name;rp=out/f'shard-{number:05d}-receipt.json'
    52	        inputs=dict(historical_combined_sha256=sha256(old),window_receipt_sha256=e['receipt_sha256'],
    53	                    checkpoint_sha256=checkpoint_hashes,code_sha256=code_hashes)
    54	        if rp.exists():
    55	            sr=json.loads(rp.read_text())
    56	            if not sr.get('complete') or sr['inputs']!=inputs:raise ValueError('cannot reuse stale ensemble shard')
    57	            checked(dest,sr['output_sha256'])
    58	        else:
    59	            tick=time.monotonic();samples=json.loads(paths['samples'].read_text())
    60	            windows=np.load(e['wide'],mmap_mode='r',allow_pickle=False)
    61	            records=list(rows(old));detector=list(rows(paths['detector']))
    62	            if len(records)!=e['lines'] or [r['id'] for r in records]!=[r['id'] for r in detector]:raise ValueError('A/detector line mismatch')
    63	            expected=[set() for _ in records]
    64	            for s in samples:expected[s['line']].add((s['start'],LETTERS[s['letter']]))
    65	            for i,r in enumerate(records):
    66	                if r['detector']!=detector[i]['detector'] or r['coverage']!=detector[i]['coverage']:raise ValueError('A/detector evidence differs')
    67	                actual=[(p['start'],p['base']) for p in r['r1_predictions']]
    68	                if len(actual)!=len(set(actual)) or set(actual)!=expected[i]:raise ValueError('stored windows differ from A prediction slots')
    69	            peer={a:predictions(m,samples,windows,device,batch_size) for a,m in models.items()}
    70	            byline={a:[[] for _ in records] for a in models}
    71	            for a in models:
    72	                if len(peer[a])!=len(samples):raise ValueError('peer prediction count')
    73	                for sample,p in zip(samples,peer[a]):byline[a][sample['line']].append(p)
    74	            combined=[]
    75	            for i,r in enumerate(records):
    76	                rr={k:v for k,v in r.items() if k!='modes'}
    77	                rr.update(peer_predictions={a:byline[a][i] for a in models},peer_coverage={a:r['coverage'] for a in models})
    78	                combined.append(rr)
    79	            partial=dest.with_name(dest.name.replace('.jsonl.gz','.partial.jsonl.gz'))
    80	            write_rows(partial,combined);partial.replace(dest)
    81	            sr=dict(schema='l1e-inference-shard-v1',complete=True,shard=number,lines=len(records),samples=len(samples),
    82	                inputs=inputs,output=dest.name,output_sha256=sha256(dest),elapsed_seconds=time.monotonic()-tick)
    83	            write_json(rp,sr)
    84	        result.append(dict(receipt=rp.name,receipt_sha256=sha256(rp),lines=sr['lines'],samples=sr['samples']))
    85	        print(f'L1E_SHARD {number} lines={sr["lines"]} seconds={sr["elapsed_seconds"]:.3f}',flush=True)
    86	    receipt=dict(schema='l1e-inference-v1',complete=True,device=device,precision='fp32; TF32 off; no autocast',
    87	        historical_run_receipt_sha256=sha256(historical/'run_receipt.json'),selection_sha256=window_audit['selection_sha256'],
    88	        checkpoint_sha256=checkpoint_hashes,code_sha256=code_hashes,shards=result,
    89	        lines=sum(r['lines'] for r in result),samples=sum(r['samples'] for r in result),elapsed_seconds=time.monotonic()-started)
    90	    write_json(out/'r1e_receipt.json',receipt)
    91	    return receipt
