    17	def digest(path):return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    18	def policy(output='print'):
    19	    data=dict(schema='sf1-constraints-v1',output=output,rules=sorted(R.APPLIED_CONSTRAINT_RULES),reader_sha256=digest(ROOT/'greekocr/labelfix/reading.py'))
    20	    return dict(data,sha256=hashlib.sha256(json.dumps(data,sort_keys=True).encode()).hexdigest())
