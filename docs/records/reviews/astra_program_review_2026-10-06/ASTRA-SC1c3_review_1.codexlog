    21	        if r.get('status','ok')!='ok':continue
    22	        out=compose_runtime(r,a.mode,flags.get(r['id'],()))
    23	        counts.update(s['label_status'] for s in out['slots'])
    24	        counts['lines_with_HOLD']+=bool(out['hold_slots'])
    25	    print(dict(counts))
