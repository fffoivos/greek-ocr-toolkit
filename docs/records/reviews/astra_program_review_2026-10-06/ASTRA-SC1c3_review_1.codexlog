    60	def page_reading(path,model,line,alignment,config,uri,combine=None):
    61	    if not isinstance(config,ReadingConfiguration):raise ValueError('explicit hash-bound reading configuration required; use load_configuration')
    62	    if alignment is None:raise ValueError('missing cached alignment')
    63	    with Image.open(path) as source:im=source.convert('L')
    64	    ci=I.analyse(im)
    65	    raw=R.read_ink(ci,line['model'],alignment,model,filtered=False)
    66	    rawrecord=serialize(raw)
    67	    rd=combine(line['line_id'],raw)[0] if combine else raw
    68	    rd,_=R.apply_constraints(rd,output=config['constraint_policy']['output'])
    69	    record=serialize(rd)
    70	    boxes=[];zones=[]
    71	    for sl,rawsl in zip(record['slots'],rawrecord['slots']):
    72	        ev=sl['evidence'];slot=sl['display_slot'];bbox=sl['bbox']
    73	        sl['raw_parts']=rawsl['parts']
    74	        sl['raw_detection']=rawsl['evidence']
    75	        if bbox:
    76	            xh=ev.get('xh',ci.xh);window=ev.get('window',[bbox[0],bbox[2]])
    77	            zones.append(dict(display_slot=slot,mark_zone=[window[0],ev.get('meanline',bbox[1])-1.3*xh,window[1],ev.get('baseline',bbox[3])+.9*xh]))
    78	        for field,kind in [('above','above'),('below','below'),('apostrophes','above')]:
    79	            for b in ev.get(field,[]):
    80	                status='HOLD' if sl.get('hold') else 'flagged-by-constraint' if sl.get('constraint_flags') else 'raw-detection'
    81	                boxes.append(dict(kind=kind,bbox=b['bbox'],display_slot=slot,status=status,source_ids=b.get('source_ids'),pixel_runs=b.get('pixel_runs')))
    82	    for b in record['opening_quotes']:boxes.append(dict(kind='quote',bbox=b['bbox'],status='raw-detection',source_ids=b.get('source_ids'),pixel_runs=b.get('pixel_runs')))
    83	    scale=2 if im.width<700 else 1
    84	    big=im.convert('RGB').resize((im.width*scale,im.height*scale),Image.Resampling.NEAREST);draw=ImageDraw.Draw(big)
    85	    try:font=ImageFont.truetype('/System/Library/Fonts/Helvetica.ttc',11*scale)
    86	    except OSError:font=None
