    53	
    54	# Qualified against S6 PRINT truth by scripts/labelfix/k1_validate.py.
    55	# The audit may request every rule with enabled_rules=None; runtime uses this
    56	# explicit allowlist. A printed-mark conflict holds back the entire subrule.
    57	CONSTRAINT_RULES = frozenset({
    58	    'C2:mark_on_consonant', 'C5:dialytika_not_on_iota_upsilon',
    59	    'C6:subscript_not_under_alpha_eta_omega', 'C2:two_breathings',
    60	    'C2:two_accents_one_letter', 'C2:breathing_with_dialytika',
    61	    'C1:breathing_not_initial', 'C1:breathing_after_consonant_start',
    62	    'C1:smooth_breathing_on_rho', 'C3:two_accents',
    63	    'C4:grave_not_final', 'C4:circumflex_on_short_vowel',
    64	    'C4:circumflex_before_penult',
    65	})
    66	APPLIED_CONSTRAINT_RULES = CONSTRAINT_RULES - {
    67	    # A single DEV printed breathing conflicts with C1; 16 held-out printed
    68	    # accents conflict with C3. See K1_REPORT.md and K1_printed_conflicts.jsonl.
    69	    'C1:breathing_after_consonant_start', 'C3:two_accents',
    70	}
    71	_ACCENT_PARTS = frozenset(('acute', 'grave', 'circumflex'))
    72	_BREATH_PARTS = frozenset(('psili', 'dasia'))
