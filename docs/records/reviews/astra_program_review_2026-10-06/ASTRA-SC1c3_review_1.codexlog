   112	def blob_from_pixels(ink,pixels,source):
   113	    ys,xs=zip(*pixels);y0,y1=min(ys),max(ys)+1;x0,x1=min(xs),max(xs)+1
   114	    mask=np.zeros((y1-y0,x1-x0),bool)
   115	    mask[np.array(ys)-y0,np.array(xs)-x0]=True
   116	    return _blob(mask,y0,x0,source,ink)
