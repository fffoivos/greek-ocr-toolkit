    58	def bound_sidecar(page,sidecar,expected_page_sha256):
    59	    digest=hashlib.sha256(Path(page).read_bytes()).hexdigest()
    60	    if digest!=expected_page_sha256:raise ValueError('reviewed page snapshot hash mismatch')
    61	    data=json.loads(Path(sidecar).read_text())
    62	    if data.get('page_sha256')!=digest:raise ValueError('sidecar not bound to page snapshot')
    63	    return data['lines']
    64	
    65	
    66	def main():
    67	    ap=argparse.ArgumentParser(description=__doc__)
    68	    for flag in ('old-page','new-page','old-boxes','new-boxes','reviewed-page-sha256','new-page-sha256','notes','out'):
    69	        ap.add_argument('--'+flag,required=True)
    70	    a=ap.parse_args()
    71	    old=bound_sidecar(a.old_page,a.old_boxes,a.reviewed_page_sha256)
    72	    new=bound_sidecar(a.new_page,a.new_boxes,a.new_page_sha256)
    73	    notes=[json.loads(l) for l in Path(a.notes).read_text().splitlines()]
    74	    data=dict(reviewed_page_sha256=a.reviewed_page_sha256,old_sidecar_sha256=hashlib.sha256(Path(a.old_boxes).read_bytes()).hexdigest(),
    75	              note_set=a.notes,changes=compare(old,new,notes))
    76	    Path(a.out).write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\n')
    77	
    78	if __name__=='__main__':main()

