    94	@dataclass(frozen=True)
    95	class Token:
    96	    text: str      # the whitespace-delimited token, NFD
    97	    lead: str      # leading punctuation
    98	    core: str      # letters (+ marks) between the punctuation
    99	    trail: str     # trailing punctuation
   100	    start: int     # index of `text` in the NFD line
   101	    end: int
   102	    index: int     # word index in the line
   103	
   104	    @property
   105	    def core_start(self) -> int:
   106	        return self.start + len(self.lead)
   107	
   108	    @property
   109	    def core_end(self) -> int:
   110	        return self.end - len(self.trail)
   111	
   112	
   113	def split_token(text: str) -> tuple[str, str, str]:
   114	    i, j = 0, len(text)
   115	    while i < j and text[i] in PUNCT_EDGE:
   116	        i += 1
   117	    while j > i and text[j - 1] in PUNCT_EDGE and not is_mark(text[j - 1]):
   118	        j -= 1
   119	    return text[:i], text[i:j], text[j:]
   120	
   121	
   122	def tokenize(line: str) -> list[Token]:
   123	    """Whitespace tokens of an NFD line with punctuation split off the core."""
   124	    line = nfd(line)
   125	    out: list[Token] = []
   126	    i = 0
   127	    n = len(line)
   128	    k = 0
   129	    while i < n:
   130	        if line[i].isspace():
