   103	def pixel_runs(mask):
   104	    """Lossless local row runs, half-open, for serialized native-pixel custody."""
   105	    out=[]
   106	    for y,row in enumerate(mask):
   107	        edges=np.diff(np.r_[False,row,False].astype(int))
   108	        out.extend([y,int(a),int(b)] for a,b in zip(np.where(edges==1)[0],np.where(edges==-1)[0]))
   109	    return out
