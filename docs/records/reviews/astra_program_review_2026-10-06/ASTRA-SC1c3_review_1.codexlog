   334	def compose(text,raw,predictions,coverage,mode,k1_flags=(),**kwargs):
   335	    serial=serialize(compose_reading(text,raw,predictions,coverage,mode,k1_flags,**kwargs))
   336	    serial.update(mode=mode.upper(),release_policy=POLICY,
   337	        hold_slots=[dict(start=s['start'],base=s['base'],reasons=s['hold_reasons'],parts=s['parts'],
   338	                         detector_parts=s['detector_parts'],r1_parts=s['r1_parts'],locator_span=s.get('locator_span'))
   339	                    for s in serial['slots'] if s['hold']])
   340	    return serial
