   397	                if not faint_letter(c, ink) and not punctuation_dot(c, ink, excluded_stems=region_ids if mark_bearer else ()) and not _reserved_for_capital(ink, c, b1):
   398	                    ev.above.append(b)
   399	        elif c.role in ('mark', 'punct', 'fragment') and c.y0 >= base - 0.2 * xh and inside:
   400	            sub = component_mask(ink,c)
