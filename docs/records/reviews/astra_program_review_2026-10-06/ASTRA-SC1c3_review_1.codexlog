    37	
    38	def overlay(record, runtime, variant, binding):
    39	    original = record['label']
    40	    result = dict(line_id=record['id'], original_label_sha256=label_sha(original),
    41	                  changes=[], hold_slots=[], detector_version=binding['detector'],
    42	                  r1_sha=binding['r1_sha256'], policy_sha=binding['policy_sha256'])
    43	    if record['script_class'] != 'greek_poly':
    44	        return dict(result, status='out_of_scope')
    45	    # Never trust previously composed decisions under an older policy.
    46	    mode = compose_runtime(runtime,variant.upper())
    47	    result.update(release_policy=POLICY,opening_quotes=mode['opening_quotes'],
    48	        gate_decisions=[{k:s.get(k) for k in ('start','base','label_status','hold_reasons',
    49	            'r1_coverage','segmentation_uncertain','localisation_unknown','unnamed',
    50	            'detector_parts','r1_parts','peer_arm','peer_prediction','peer_coverage','evidence','constraint_flags','apostrophe')}
    51	            for s in mode['slots']])
    52	    for slot in mode['hold_slots']:
    53	        for reason in slot['reasons']:
    54	            result['hold_slots'].append(dict(start=slot['start'], letter=slot['base'],
    55	                reason=hold_reason(reason), detail=reason))
    56	    proposal = mode['text']
    57	    for detail in edit_guard(original, runtime['recogniser_text']) + edit_guard(original,proposal):
    58	        result['hold_slots'].append(dict(start=0,letter='',reason='edit_guard',detail=detail))
    59	    if result['hold_slots']:
    60	        return dict(result, status='hold')
    61	    if nfd(original) == nfd(proposal):
    62	        return dict(result, status='unchanged', label=original)
    63	    old, new = nfd(original), nfd(proposal)
    64	    for tag, i, j, lo, hi in SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
    65	        if tag == 'equal':
    66	            continue
    67	        # Evidence is recogniser-indexed; edits are original-label NFD offsets.
    68	        evidence = dict(recogniser_text=runtime['recogniser_text'], agreement=variant,
    69	            slots=[dict(start=s['start'], letter=s['base'], r1_coverage=s.get('r1_coverage'),
    70	                        segmentation_uncertain=s.get('segmentation_uncertain'),localisation_unknown=s.get('localisation_unknown'),
    71	                        hold_reasons=s.get('hold_reasons'),detector_parts=s.get('detector_parts'),
    72	                        r1_parts=s.get('r1_parts'),peer_arm=s.get('peer_arm'),peer_prediction=s.get('peer_prediction'),
    73	                        peer_coverage=s.get('peer_coverage'),locator_span=s.get('locator_span'),
    74	                        mark_probabilities=s.get('mark_probabilities'), evidence=s.get('evidence'))
    75	                   for s in mode['slots']],
    76	            opening_quotes=mode.get('opening_quotes', []), detector_text=runtime['detector']['text'])
    77	        context = i
    78	        if (lo < hi and unicodedata.combining(new[lo])) or (i < j and unicodedata.combining(old[i])):
    79	            context -= 1
    80	        while context >= 0 and context < len(old) and unicodedata.combining(old[context]):
    81	            context -= 1
    82	        letter = old[context] if 0 <= context < len(old) and old[context].isalpha() else ''
    83	        result['changes'].append(dict(start=i, letter=letter,
    84	                                      **{'from': old[i:j], 'to': new[lo:hi]}, evidence=evidence))
    85	    return dict(result, status='corrected', label=proposal)
    86	
    87	
    88	def _overlays(task):
    89	    record,runtime,variants,binding=task
    90	    return runtime['id'],{v:overlay(record,runtime,v,binding) for v in variants}
    91	
    92	
    93	def release(selection, runtime_paths, out, binding, source, input_receipt, variants=('presence','full'), workers=1):
    94	    """Stream both variants, with one explicit kept-line list shared by each control."""
    95	    out = Path(out)
    96	    out.mkdir(parents=True, exist_ok=False)
    97	    original_sha = sha256(source)
    98	    selected=list(rows(selection))
    99	    records = {r['id']: r for r in selected}
   100	    if len(records)!=len(selected):raise ValueError('duplicate selection IDs')
   101	    import gzip
   102	    handles = {v: gzip.open(out / f'overlay_{v}.jsonl.gz', 'xt', encoding='utf-8', compresslevel=3)
   103	               for v in variants}
   104	    counts = {v: Counter({s: 0 for s in STATUSES}) for v in handles}
   105	    coverage = {v: {'wave': {}, 'source': {}} for v in handles}
   106	    kept = {v: [] for v in handles}
   107	    control = {v: gzip.open(out / f'ctrl_subset_{v}.jsonl.gz', 'xt', encoding='utf-8', compresslevel=3)
   108	               for v in handles}
   109	    seen = set()
   110	    pool=None
   111	    try:
   112	        def tasks():
   113	            for path in runtime_paths:
   114	                for runtime in rows(path):
   115	                    identifier = runtime['id']
   116	                    if identifier not in records or identifier in seen:
   117	                        raise ValueError('unexpected/duplicate L1 runtime: ' + identifier)
   118	                    seen.add(identifier)
   119	                    yield records[identifier],runtime,variants,binding
   120	        if workers>1:
   121	            import multiprocessing as mp
   122	            from itertools import islice
   123	            pool=mp.get_context('spawn').Pool(workers)
   124	            def bounded_results():
   125	                work=tasks()
   126	                while batch:=list(islice(work,workers*8)):
   127	                    yield from pool.imap(_overlays,batch,chunksize=8)
   128	            results=bounded_results()
   129	        else:results=map(_overlays,tasks())
   130	        for identifier,values in results:
   131	            record = records[identifier]
   132	            for variant in handles:
   133	                value = values[variant]
   134	                handles[variant].write(canonical(value) + '\n')
   135	                counts[variant][value['status']] += 1
   136	                for dim, key in [('wave', record['wave']), ('source', record.get('source', record.get('source_dataset', 'UNKNOWN')))]:
   137	                    bucket = coverage[variant][dim].setdefault(key, Counter({s: 0 for s in STATUSES}))
   138	                    bucket[value['status']] += 1
   139	                if value['status'] in ('corrected', 'unchanged'):
   140	                    kept[variant].append(identifier)
   141	                    control[variant].write(canonical(dict(line_id=identifier, label=record['label'],
   142	                        original_label_sha256=value['original_label_sha256'])) + '\n')
   143	    finally:
   144	        if pool is not None:pool.terminate();pool.join()
   145	        for f in [*handles.values(), *control.values()]:
   146	            f.close()
   147	    if seen != set(records):
   148	        raise ValueError(f'incomplete runtime: {len(seen)}/{len(records)}')
   149	    assert original_sha == sha256(source), 'original labels changed'
   150	    for variant in handles:
   151	        op = out / f'overlay_{variant}.jsonl.gz'
   152	        cp = out / f'ctrl_subset_{variant}.jsonl.gz'
   153	        kp = out / f'kept_{variant}_line_ids.txt'
   154	        kp.write_text(''.join(i + '\n' for i in sorted(kept[variant])))
   155	        # Verify actual control payload, not just two aliases of an in-memory set.
   156	        ctrl_ids = [r['line_id'] for r in rows(cp)]
   157	        assert len(ctrl_ids) == len(set(ctrl_ids)) and set(ctrl_ids) == set(kept[variant])
   158	        for dim in coverage[variant].values():
   159	            for bucket in dim.values():
   160	                bucket['total'] = sum(bucket[s] for s in STATUSES)
   161	                bucket['kept'] = bucket['corrected'] + bucket['unchanged']
   162	                bucket['kept_fraction'] = bucket['kept'] / bucket['total']
   163	        suffix = '-r'
   164	        release_name=variant.replace('_','-')
   165	        manifest = dict(schema='l1r-release-v1', release_policy=POLICY, release=f'v2-corrected-{release_name}{suffix}',
   166	            variant=variant, overlay=op.name, overlay_sha256=sha256(op),
   167	            source_label_file=str(source), source_sha256=original_sha,
   168	            selection_sha256=sha256(selection), counts_by_status=dict(counts[variant]),
   169	            coverage_per_wave=coverage[variant]['wave'], coverage_per_source=coverage[variant]['source'],
   170	            kept_line_ids=kp.name, kept_line_ids_sha256=sha256(kp), kept_lines=len(kept[variant]),
   171	            exclusion_receipts=input_receipt['exclusions'], out_of_scope=input_receipt['out_of_scope'],
   172	            r0_policy=input_receipt['r0_policy'], input_documents_sha256=input_receipt['input_documents_sha256'],
   173	            code_commit=binding['code_commit'], detector_commit=binding['detector_commit'],
   174	            detector_version=binding['detector'], r1_sha=binding['r1_sha256'], policy_sha=binding['policy_sha256'],
   175	            hold_policy='HOLD and out_of_scope lines excluded; original source never modified',
   176	            original_labels_unchanged=True, ensemble_caveat=ENSEMBLE_CAVEAT,
   177	            checkpoint_sha256=binding.get('checkpoint_sha256',{'A':binding['r1_sha256']}),
   178	            code_sha256=binding.get('code_sha256',{}),policy_binding=binding.get('policy_binding'))
   179	        write_json(out / f'release_{variant}.json', manifest)
   180	        write_json(out / f'release_ctrl_subset_{variant}.json', dict(manifest,
   181	            release=f'v2-ctrl-subset-{release_name}{suffix}', labels='ORIGINAL',
   182	            labels_file=cp.name, labels_sha256=sha256(cp),
   183	            paired_release=f'v2-corrected-{release_name}{suffix}', corrected_and_control_line_sets_equal=True))
   184	    return {v: dict(counts[v]) for v in handles}
     1	"""Re-release L1-v0 saved evidence under SF2. No detector or model execution.
     2	
     3	Missing gate inputs cause HOLD. Old files are never written. A complete input
     4	run, exact selection and all shard hashes must verify before release.
     5	"""
     6	import argparse
     7	from collections import Counter
     8	import json
     9	from pathlib import Path
    10	from greekocr.labelfix.release_gate import policy_binding
    11	from scripts.labelfix.clariden.l1_common import release, rows, sha256, write_json
    12	
    13	
    14	def recompose(input_run, selection, binding_dir, source, out, ensemble_run=None, workers=1):
    15	    base,out=Path(input_run),Path(out)
    16	    if out.resolve()==base.resolve() or base.resolve() in out.resolve().parents:
    17	        raise ValueError('L1r output must be separate from historical run')
    18	    run=json.loads((base/'run_receipt.json').read_text())
    19	    if not run.get('complete'):raise ValueError('incomplete historical run')
    20	    paths=sorted((base/'combined').glob('shard-*-combined.jsonl.gz'))
    21	    if not paths:raise ValueError('no saved combined shards')
    22	    inputs={str(selection):sha256(selection),str(source):sha256(source)}
    23	    inputs[str(base/'run_receipt.json')]=sha256(base/'run_receipt.json')
    24	    binding_path=Path(binding_dir)/'binding.json'
    25	    if sha256(binding_path)!=run['binding_sha256']:raise ValueError('historical binding changed')
    26	    inputs[str(binding_path)]=sha256(binding_path)
    27	    for name,digest in run['step_receipts'].items():
    28	        if sha256(base/name)!=digest:raise ValueError('historical step receipt changed: '+name)
    29	        inputs[str(base/name)]=digest
    30	    ids=[];missing=Counter();apostrophes=0
    31	    for path in paths:
    32	        receipt=json.loads(path.with_name(path.name.replace('-combined.jsonl.gz','-receipt.json')).read_text())
    33	        if not receipt.get('complete') or receipt['output_sha256']!=sha256(path):raise ValueError('invalid shard '+str(path))
    34	        inputs[str(path)]=sha256(path)
    35	        for r in rows(path):
    36	            ids.append(r['id'])
    37	            for key in ('detector','r1_predictions','coverage','recogniser_text'):
    38	                if key not in r:raise ValueError('missing line input '+key)
    39	            for c in r['coverage']:
    40	                for key in ('scored','evidence_state','uncertainty'):
    41	                    if key not in c:missing['r1_'+key]+=1
    42	            for s in r['detector']['slots']:
    43	                if 'segmentation_uncertain' not in s:missing['detector_segmentation_state']+=1
    44	                for k in ('clipped_top','clipped_bottom'):
    45	                    if k not in s.get('evidence',{}):missing[k]+=1
    46	                if s.get('apostrophe') and not s.get('evidence',{}).get('apostrophes'):apostrophes+=1
    47	    selected=list(rows(selection))
    48	    if len(ids)!=len(set(ids)) or set(ids)!={r['id'] for r in selected}:raise ValueError('runtime/selection mismatch')
    49	    for v in ('presence','full'):
    50	        manifest=json.loads((base/'release'/f'release_{v}.json').read_text())
    51	        inputs[str(base/'release'/f'release_{v}.json')]=sha256(base/'release'/f'release_{v}.json')
    52	        if manifest['source_sha256']!=sha256(source) or manifest['selection_sha256']!=sha256(selection):raise ValueError('source/selection changed')
    53	        for name,key in [('overlay','overlay_sha256'),('kept_line_ids','kept_line_ids_sha256')]:
    54	            if sha256(base/'release'/manifest[name])!=manifest[key]:raise ValueError('historical release hash mismatch')
    55	            inputs[str(base/'release'/manifest[name])]=manifest[key]
    56	        control=json.loads((base/'release'/f'release_ctrl_subset_{v}.json').read_text())
    57	        if sha256(base/'release'/control['labels_file'])!=control['labels_sha256']:raise ValueError('historical control changed')
    58	        inputs[str(base/'release'/control['labels_file'])]=control['labels_sha256']
    59	    if missing:raise ValueError('saved evidence incomplete; regenerate missing fields: '+str(dict(missing)))
    60	    runtime_paths=paths;ensemble=None
    61	    if ensemble_run is not None:
    62	        ensemble_run=Path(ensemble_run)
    63	        ep=ensemble_run/'r1e_receipt.json';ensemble=json.loads(ep.read_text())
    64	        if not ensemble.get('complete') or ensemble['historical_run_receipt_sha256']!=sha256(base/'run_receipt.json'):
    65	            raise ValueError('ensemble not bound to completed historical run')
    66	        if ensemble['selection_sha256']!=sha256(selection):raise ValueError('ensemble selection changed')
    67	        inputs[str(ep)]=sha256(ep);runtime_paths=[]
    68	        for entry in ensemble['shards']:
    69	            rp=ensemble_run/entry['receipt'];sr=json.loads(rp.read_text())
    70	            if sha256(rp)!=entry['receipt_sha256'] or not sr['complete']:raise ValueError('ensemble shard receipt changed')
    71	            p=ensemble_run/sr['output']
    72	            if sha256(p)!=sr['output_sha256']:raise ValueError('ensemble shard changed')
    73	            inputs[str(rp)]=sha256(rp);inputs[str(p)]=sha256(p);runtime_paths.append(p)
    74	        if len(runtime_paths)!=len(paths):raise ValueError('ensemble shards missing')
    75	    out.mkdir(parents=True,exist_ok=False)
    76	    binding=json.loads(binding_path.read_text())
    77	    policy=policy_binding();binding['historical_policy_sha256']=binding['policy_sha256'];binding['policy_sha256']=policy['sha256']
    78	    binding['code_commit']='uncommitted-SF2-source-bound'
    79	    binding.update(policy_binding=policy,code_sha256=policy['sources'])
    80	    if ensemble is not None:
    81	        binding.update(checkpoint_sha256=ensemble['checkpoint_sha256'],code_commit='e48e06e8+L1E-source-bound',
    82	                       code_sha256=ensemble['code_sha256'])
    83	    inp=json.loads((base/'input_receipt.json').read_text())
    84	    variants=('presence','full','ensemble_ab') if ensemble is not None else ('presence','full')
    85	    counts=release(selection,runtime_paths,out/'release',binding,source,inp,variants,workers)
    86	    changes={}
    87	    for v in ('presence','full'):
    88	        old={r['line_id']:r for r in rows(base/'release'/f'overlay_{v}.jsonl.gz')}
    89	        delta=[]
    90	        for r in rows(out/'release'/f'overlay_{v}.jsonl.gz'):
    91	            a=old[r['line_id']]
    92	            if (a['status'],a.get('label'))!=(r['status'],r.get('label')):
    93	                delta.append(dict(line_id=r['line_id'],before=a['status'],after=r['status'],
    94	                    reasons=sorted({s['detail'] for s in r['hold_slots']})))
    95	        write_json(out/f'decision_changes_{v}.json',delta)
    96	        changes[v]=dict(changed=len(delta),reasons=dict(Counter(z for d in delta for z in d['reasons'])))
    97	    if any(sha256(Path(p))!=h for p,h in inputs.items()):raise ValueError('input changed during recomposition')
    98	    receipt=dict(schema='l1r-recomposition-v1',complete=True,policy=policy,inputs=inputs,
    99	        historical_run=str(base),counts=counts,changes=changes,evidence_sufficient=True,
   100	        historical_apostrophe_boxes_missing=apostrophes,network=False,detector_runs=0,r1_runs=0,
   101	        ensemble_receipt_sha256=inputs.get(str(Path(ensemble_run)/'r1e_receipt.json')) if ensemble_run else None,
   102	        outputs={str(p.relative_to(out)):sha256(p) for p in sorted(out.rglob('*')) if p.is_file()})
   103	    write_json(out/'receipt.json',receipt)
   104	    return receipt
   105	
   106	
   107	def main():
   108	    ap=argparse.ArgumentParser(description=__doc__)
   109	    for flag in ('input-run','selection','binding-dir','source','out'):ap.add_argument('--'+flag,type=Path,required=True)
   110	    ap.add_argument('--ensemble-run',type=Path);ap.add_argument('--workers',type=int,default=1)
   111	    a=ap.parse_args()
   112	    r=recompose(a.input_run,a.selection,a.binding_dir,a.source,a.out,a.ensemble_run,a.workers)
   113	    print(json.dumps({k:v for k,v in r.items() if k not in ('inputs','outputs')},ensure_ascii=False,indent=2))
   114	
   115	
   116	if __name__=='__main__':main()

