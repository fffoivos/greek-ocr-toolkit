    33	def system_coverage(line):
    34	    """Full systems have S6 output outside R1's four heads; don't erase it.
    35	
    36	    reader_scored here means a system output is present, not R1 inference or
    37	    confidence. This adapter is applied symmetrically to S6 and combined.
    38	    """
    39	    line = deepcopy(line)
    40	    line['prediction_line_present'] = True
    41	    for s in line['slots']:
    42	        s['reader_scored'] = True
    43	    for s in line['recogniser_slots']:
    44	        s['system_output_present'] = True
    45	        if 'r1_coverage' in s:
    46	            s['r1_scored'] = bool(s['r1_coverage'] and s['r1_coverage'].get('scored'))
    47	            s['acceptance_eligible'] = s.get('label_status') in ('ACCEPT','KEEP')
    48	            # Historical clause adapter needs system coverage; acceptance uses HOLD.
    49	        s['reader_scored'] = True
    50	    return line
