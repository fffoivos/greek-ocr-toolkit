"""Read-only cycle-2 probes: synthetic composition and saved small instruments.

No image decoding, network, CTC or neural forward passes. Run with repo PYTHONPATH.
"""
import copy
import gzip
import json
import sys
from collections import Counter
from pathlib import Path

ROOT = Path(sys.argv[1])
OUT = Path(__file__).resolve().parent
from greekocr.labelfix.reading import LineReading
from scripts.labelfix.m2_run import combine
from scripts.labelfix.owner_pages_build_combined import combine as page_combine
from scripts.labelfix import owner_pages_build_combined as page
from scripts.labelfix.box_regression import diff_line

def rows(p):
    with (gzip.open(p, 'rt') if str(p).endswith('.gz') else open(p)) as f:
        return [json.loads(x) for x in f]

def raw(parts=(), **kw):
    slot = dict(start=0,end=1,base='α',parts=list(parts),unnamed=[],
        locator_span=[10,20],component=None,bbox=[10,10,20,30],
        evidence=dict(above=[],below=[],clipped_top=False,clipped_bottom=False))
    slot.update(kw)
    return LineReading('α',[slot],[])

result = {}
for label, r, coverage in [
    ('r1_unknown',raw(),[dict(start=0,scored=True,evidence_state='UNKNOWN',uncertainty=['no_pixel_evidence'],reason=None)]),
    ('r1_outside',raw(),[dict(start=0,scored=True,evidence_state='UNKNOWN',uncertainty=['out_of_image_span'],reason=None)]),
    ('segmentation_uncertain',raw(segmentation_uncertain=True),[]),
    ('clipped_detector',raw(evidence=dict(above=[],below=[],clipped_top=True,clipped_bottom=True)),[]),
]:
    pred={0:dict(parts=[],mark_probabilities={})}
    modes={m:combine('ά',copy.deepcopy(r),pred,coverage,m) for m in ('PRESENCE','FULL')}
    result[label]={m:dict(text=v['text'],holds=v['hold_slots']) for m,v in modes.items()}
    if (ROOT/'scripts/labelfix/clariden/l1_common.py').exists():
        from scripts.labelfix.clariden.l1_common import overlay
        runtime=dict(recogniser_text='ά',detector=dict(text='α'),modes=modes)
        rec=dict(id='synthetic',label='ά',script_class='greek_poly')
        binding=dict(detector='s6',r1_sha256='synthetic',policy_sha256='synthetic')
        result[label]['overlay']={m:overlay(rec,runtime,m.lower(),binding)['status'] for m in modes}

# Same physical blob, different S4 family names, fixed R1 prediction.
result['same_pixels_kind_gate']={}
for part in ('acute','psili'):
    ev=dict(above=[dict(bbox=[10,2,14,6],area=10)],below=[])
    out=combine('ά',raw([part],evidence=ev),{0:dict(parts=['acute'],mark_probabilities={'acute':.9})},[],'PRESENCE')
    result['same_pixels_kind_gate'][part]=out['hold_slots']

page.LINE_TEXT['synthetic']='α'
page.R1.clear()
page.R1[('synthetic',0)]=dict(cls='none')
r=raw();r.opening_quotes=[dict(bbox=[0,0,3,5])];r.text='“α'
out,_=page_combine('synthetic',copy.deepcopy(r))
result['page_quote_loss']=dict(before=r.text,after=out.text,opening_quote_evidence=out.opening_quotes)
r=raw();r.slots[0]['component']=object()
page.R1.clear();page.R1[('other',0)]=dict(cls='none')
out,_=page_combine('synthetic',r)
result['page_missing_prediction']=dict(parts=out.slots[0]['parts'],hold=out.slots[0].get('hold',False))

old=dict(reading='αα',boxes=[dict(kind='above',bbox=[5,2,8,5],display_slot=1)],
    letter_zones=[dict(display_slot=1,mark_zone=[0,0,10,10])])
new=copy.deepcopy(old);new['boxes'][0]['display_slot']=2;new['letter_zones'][0]['display_slot']=2
result['unchanged_box_changed_owner']=diff_line(old,new,.3)

cn=ROOT/'docs/labelfix/spellcheck/CN1_evidence'
if cn.exists():
    a=json.loads((cn/'s6_control_boxes.json').read_text())['lines']
    b=json.loads((cn/'combined_boxes.json').read_text())['lines']
    quote_diffs=[]
    for lid in a:
        ar,br=a[lid]['line_reading'],b[lid]['line_reading']
        if ar['opening_quotes'] and not br['text'].startswith('“'):
            quote_diffs.append(dict(line_id=lid,control=ar['text'],combined=br['text'],quote_evidence=br['opening_quotes']))
    result['saved_CN1_quotes_missing_from_text']=quote_diffs

se=ROOT/'docs/labelfix/spellcheck/S7_evidence'
if se.exists():
    ds=[r for r in rows(se/'kind_disagreements.jsonl') if r['variant']=='baseline']
    def zone(parts):
        return set(('below' if p=='subscript' else 'above') for p in parts)
    result['80_disagreements_zone_strata']=dict(Counter('same_named_zone' if zone(r['detector_parts'])==zone(r['r1_parts']) else 'different_named_zone' for r in ds))
    result['80_disagreements_known']=dict(Counter('unknown' if r['truth'] is None else 'R1' if r['r1_right'] else 'detector' if r['detector_right'] else 'neither' for r in ds))

if (ROOT/'artifacts/labelfix_l1/mock_checked_192').exists():
    base=ROOT/'artifacts/labelfix_l1/mock_checked_192'
    runtimes={r['id']:r for p in sorted((base/'combined').glob('*-combined.jsonl.gz')) for r in rows(p)}
    out={}
    for v in ('presence','full'):
        overlays=rows(base/'release'/f'overlay_{v}.jsonl.gz')
        ctrl=rows(base/'release'/f'ctrl_subset_{v}.jsonl.gz')
        kept={r['line_id'] for r in overlays if r['status'] in ('corrected','unchanged')}
        tally=Counter();detail=[]
        for lid in kept:
            r=runtimes[lid]
            unknown=[c for c in r['coverage'] if c.get('evidence_state')=='UNKNOWN']
            ambiguous=[s['start'] for s in r['detector']['slots'] if s.get('segmentation_uncertain')]
            clipped=[s['start'] for s in r['detector']['slots'] if s['evidence'].get('clipped_top') or s['evidence'].get('clipped_bottom')]
            for k,vs in [('r1_UNKNOWN',unknown),('segmentation_uncertain',ambiguous),('detector_clipped',clipped)]:
                tally[k+'_slots']+=len(vs);tally[k+'_lines']+=bool(vs)
            if unknown or ambiguous or clipped:detail.append(dict(id=lid,unknown=unknown,segmentation_uncertain=ambiguous,clipped=clipped))
        out[v]=dict(statuses=dict(Counter(r['status'] for r in overlays)),kept=len(kept),paired_ids=kept=={r['line_id'] for r in ctrl},uncertainty=dict(tally),details=detail)
    result['L1_mock_saved_readback']=out

if (ROOT/'scripts/labelfix/clariden/l1_common.py').exists():
    from scripts.labelfix.clariden.l1_common import overlay
    result['unsupported_original_mark_deletion']={}
    for original,base in [('ᾱ','α'),('é','e'),('α\u0301\u0300','α')]:
        rd=raw();rd.text=base;rd.slots[0]['base']=base
        predictions={0:dict(parts=[],mark_probabilities={})} if base=='α' else {}
        modes={m:combine(original,copy.deepcopy(rd),predictions,[],m) for m in ('PRESENCE','FULL')}
        runtime=dict(recogniser_text=original,detector=dict(text=base),modes=modes)
        rec=dict(id='synthetic',label=original,script_class='greek_poly')
        binding=dict(detector='s6',r1_sha256='synthetic',policy_sha256='synthetic')
        result['unsupported_original_mark_deletion'][original]={m:{k:v for k,v in overlay(rec,runtime,m.lower(),binding).items() if k in ('status','label','hold_slots')} for m in modes}

dest=OUT/('new_probes_l1.json' if ROOT.name.endswith('-l1') else 'new_probes_main.json')
dest.write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
for k,v in result.items():
    if k=='saved_CN1_quotes_missing_from_text':print(k,len(v),[r['line_id'] for r in v])
    elif k=='L1_mock_saved_readback':print(k,{name:{kk:vv for kk,vv in value.items() if kk!='details'} for name,value in v.items()})
    else:print(k,json.dumps(v,ensure_ascii=False))
"""Execute the actual agreement_mode loop with tiny in-memory serialized inputs."""
import ast
import io
import json
from pathlib import Path
from types import SimpleNamespace
from collections import Counter

root=Path('/Users/foivoskarounos-zamparloukos/Projects/greek-ocr-toolkit-spellcheck')
source=root/'scripts/labelfix/agreement_mode.py'
tree=ast.parse(source.read_text())
loop=next(x for x in tree.body if isinstance(x,ast.For))
# This is the first TOP-LEVEL for, the R1 scoring loop, not the optional flags loop.
code=compile(ast.Module(body=[loop],type_ignores=[]),str(source),'exec')
output={}
for case,flagged,detector in [('external_K1_flag',True,'acute'),('Google_agrees_R1_detector_disagrees',False,'psili')]:
    slot=dict(slot=1,recogniser_start=0,base='α',detected=[['accent','acute']],truth=[['accent','acute']])
    row=dict(line_id='synthetic',recogniser_text='ά',slots=[slot])
    env=dict(gzip=SimpleNamespace(open=lambda *a:io.StringIO(json.dumps(row)+'\n')),R1='unused',MODE='presence',
        FLAGS={('synthetic',0)} if flagged else set(),G={'synthetic':'ά'},nfd=lambda x:x,
        google_marks=lambda *a:{0:{('accent','acute')}},atomic=lambda x:set(map(tuple,x)),
        kinds=lambda m:{k for k,v in m},Counter=Counter,json=json,
        s6={'synthetic':dict(slots=[dict(slot=1,detected=[['accent' if detector=='acute' else 'breathing',detector]])])},
        c=Counter(),lines=Counter(),by_type=Counter(),rows=[])
    exec(code,env)
    output[case]={' / '.join(k):v for k,v in env['c'].items()}
dest=Path(__file__).resolve().parent/'agreement_probe.json'
dest.write_text(json.dumps(output,indent=2)+'\n')
print(json.dumps(output,indent=2))
"""Read-only ASTRA-SC1 probes. No crop decoding, network, CTC or model forward passes."""
import copy
import gzip
import hashlib
import json
import sys
from pathlib import Path
from types import SimpleNamespace
import numpy as np
from PIL import Image, ImageDraw

R = Path('/Users/foivoskarounos-zamparloukos/Projects/greek-ocr-toolkit-spellcheck')
O = Path(__file__).resolve().parent
sys.path.insert(0, str(R))
sys.path.insert(0, str(R/'scripts/labelfix'))
from greekocr.labelfix import ink as I, case
from greekocr.labelfix.reading import LineReading, apply_constraints
from greekocr.labelfix.segmentation import _region
from scripts.labelfix.clariden.r1_extract import window, extract_line
from scripts.labelfix.box_regression import diff_line
from s6_notes import clause
from s6_validate import char_truth

results = {}
# A print transcription may be orthographically impossible. Support does not veto deletion.
s = dict(base='ε', start=0, parts=['circumflex'], naming={'probability':1.0},
         evidence=dict(xh=20, body=[10,25], above=[dict(bbox=[12,4,22,10],area=50)]))
rd, removed = apply_constraints(LineReading('ε\u0342', [s], []))
results['k1_supported_misprint'] = dict(before='ε\u0342', after=rd.text, removed=removed)

# Clipping an original blob must not switch to a foreign component in its bounding box.
lab = np.zeros((20,20), int)
lab[2:12,2]=1; lab[2,2:14]=1; lab[11,2:14]=1
lab[4:10,4:12]=2
ci = I.CropInk(np.where(lab>0,20.,255.),lab>0,lab,20.,np.full(20,12.),np.full(20,18.),[],255.,20,20,20.)
b = I._blob(lab==1,0,0,'attached',ci)
q = I.zone_blob(ci,b,upper=10)
results['blob_parent_switch'] = dict(source_bbox=b.to_record()['bbox'],source_area=b.area,
    clipped_bbox=q.to_record()['bbox'], clipped_area=q.area,
    result_parent_ids=np.unique(lab[q.y0:q.y1,q.x0:q.x1]).tolist())

# A union region retains both labels, but case features read only the first label.
lab = np.zeros((30,40),int); lab[5:25,5:10]=1; lab[5:25,15:20]=2
ci = I.CropInk(np.where(lab>0,20.,255.),lab>0,lab,20.,np.full(40,5.),np.full(40,25.),[],255.,40,30,20.)
c = _region(ci,[SimpleNamespace(index=1),SimpleNamespace(index=2)],5,20)
results['union_case_occupancy'] = dict(measured=case.features(ci,c)[5],
    actual_union=float((lab[c.y0:c.y1,c.x0:c.x1]>0).mean()), region_index=c.index)

# Entire-crop vertical resizing changes font scale when only blank padding changes.
a=Image.new('L',(80,40),255); b=Image.new('L',(80,80),255)
for im in (a,b):ImageDraw.Draw(im).rectangle((20,10,29,29),fill=0)
wa,_=window(a,[20,30],20); wb,_=window(b,[20,30],20)
results['r1_vertical_padding'] = dict(dark_rows_40=int((wa<128).any(axis=1).sum()),
    dark_rows_80=int((wb<128).any(axis=1).sum()), equal=bool(np.array_equal(wa,wb)))
al=dict(prediction='α',spans=[['α',0,1,20.,30.]],confidence=.9)
ss,_,_,losses,coverage,size=extract_line(dict(_line=0,recogniser_text='α'),al,Image.new('L',(80,40),255),evaluation=True)
results['r1_blank_admission']=dict(samples=len(ss),size=size,coverage=coverage)

# Same boxes, different ordering -> different lost/added conclusions.
old=dict(reading='',letters=[[0,10],[5,15]],boxes=[dict(kind='above',bbox=[0,0,10,10]),dict(kind='above',bbox=[5,0,15,10])])
new=dict(reading='',letters=old['letters'],boxes=[dict(kind='above',bbox=[2,0,12,10]),dict(kind='above',bbox=[-3,0,7,10])])
rev=copy.deepcopy(old);rev['boxes'].reverse()
results['box_matching_order']={key:{k:len(v) for k,v in diff_line(value,new,.3).items() if k in ('lost','added','moved')}
    for key,value in [('original',old),('reversed',rev)]}

# A physical-presence check can pass when a previously approved name disappears.
old=dict(slots=[dict(slot=1,truth=None,detected=[])],recogniser_slots=[dict(start=0,component_slot=1,parts=['acute'],evidence={'above':[{'bbox':[0,0,3,3]}]})])
new=copy.deepcopy(old);new['recogniser_slots'][0]['parts']=[]
results['unknown_approved_name_removed']=dict(zip(('passes','details'),clause(new,old,'no_regression',None,None)))
results['missing_owner_target_no_top']=dict(zip(('passes','details'),clause(new,old,'no_top',999,None)))
results['unsupported_print_truth']=char_truth(dict(line_id='probe',google='α',model='α',human='α'),
    {'probe|0':{'printed':'α\u0301\u0300'}})

root=R/'docs/labelfix/spellcheck'
metrics=json.loads((root/'clariden/R1_result_3678928/metrics.json').read_text())
results['r1_metrics']={k:metrics[k] for k in ('heldout_lines','scoring_contract','source_sha256')}
results['r1_metrics']['A']={k:metrics['arms']['A'][k] for k in ('mapping','all_unscored_none','scored','fused_all_unscored_none','fused_scored','capital_detection','capital_naming','owner_counts')}
results['r1_metrics']['coverage']={k:v for k,v in metrics['coverage'].items() if k in ('counts','samples','coverage','font_rule','font_size_summary')}
results['model_assets']={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in (R/'docs/labelfix').glob('*model*.json')}
results['s5_s6_baselines']={n:json.loads((root/f'{n}_metrics.json').read_text()).get('after') for n in ('S4','S5')}
results['s5_s6_baselines']['S6']=json.loads((root/'S6_metrics.json').read_text())['heldout']['detected']
results['r1_reference_S5']=metrics['reference']['S5']['all_unscored_none']
results['r1_disjointness']=json.loads((R/'artifacts/labelfix_r1/binding/disjointness.json').read_text())

(O/'review_probe_results.json').write_text(json.dumps(results,ensure_ascii=False,indent=2)+'\n')
for k,v in results.items():
    if k not in ('r1_metrics','s5_s6_baselines','r1_reference_S5'):print(k,json.dumps(v,ensure_ascii=False))
for k in ('mapping','capital_detection','owner_counts'):
    print('R1 A',k,json.dumps(results['r1_metrics']['A'][k]))
print('R1 A totals', {k:results['r1_metrics']['A'][k]['total'] for k in ('all_unscored_none','scored','fused_all_unscored_none','fused_scored')})
print('reference total identity', {k:v['total'] for k,v in results['s5_s6_baselines'].items()},results['r1_reference_S5']['total'])

