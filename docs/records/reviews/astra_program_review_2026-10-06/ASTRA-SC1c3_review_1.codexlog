   267	def compose_reading(text, raw, predictions, coverage, mode, k1_flags=(), *, peer_predictions=None, peer_coverage=None, signal_parts=None):
   268	    """Compose from detector punctuation and R1 names, retaining all HOLD evidence."""
   269	    if isinstance(raw,dict):raw=deserialize(raw)
   270	    cov={c['start']:c for c in coverage}
   271	    if len(cov)!=len(coverage):raise ValueError('duplicate R1 coverage start')
   272	    pcov={c['start']:c for c in (peer_coverage or [])}
   273	    if len(pcov)!=len(peer_coverage or []):raise ValueError('duplicate peer coverage start')
   274	    slots=[]
   275	    cs=clusters(nfd(text))
   276	    source_parts={c.start:[p for p,v in R.MARKS.items() if v in c.marks] for c in cs}
