   262	    return replace(reading, text=text, slots=slots,
   263	                   removed_by_constraint=list(reading.removed_by_constraint)+removed,
   264	                   constraint_flags=flags), removed
   265	
   266	
   267	def apply_constraints(reading: LineReading, *, enabled_rules=APPLIED_CONSTRAINT_RULES,
   268	                      output='print'):
   269	    """Flag orthographic conflicts and HOLD labels, preserving the printed reading.
   270	
   271	    Explicit normalised output reproduces the historical deletion policy. The
   272	    policy is advisory: even a supported impossible mark remains in print output.
   273	    """
   274	    if output not in ('print', 'normalised'):
   275	        raise ValueError('output must be print or normalised')
   276	    candidate, removed = _normalise_constraints(reading, enabled_rules=enabled_rules)
   277	    if output == 'normalised':
   278	        return candidate, removed
   279	    flags = list(candidate.constraint_flags)
   280	    flags.extend(dict(r, reason='impossible_by_rule', action='flag') for r in removed)
   281	    slots = [dict(s, parts=s.get('parts', ())) for s in reading.slots]
   282	    affected = set()
   283	    for flag in flags:
   284	        if 'start' in flag: affected.add(flag['start'])
   285	        affected.update(a['start'] for a in flag.get('alternatives', ()) if 'start' in a)
   286	    for s in slots:
   287	        if s['start'] in affected:
   288	            s.update(hold=True, label_status='HOLD')
   289	            s['constraint_flags'] = [f for f in flags if f.get('start') == s['start'] or
   290	                any(a.get('start') == s['start'] for a in f.get('alternatives', ()))]
   291	    # Reapplying the advisory policy must not multiply receipts.
   292	    unique = {}
   293	    for f in flags:
   294	        import json
   295	        unique[json.dumps(f, sort_keys=True)] = f
   296	    return replace(reading, slots=slots, constraint_flags=list(unique.values())), []
   297	
   298	
   299	QUALIFIED_GEOMETRY = frozenset()
   300	
   301	
   302	def read_ink(ink, recogniser_text, alignment, model, *, filtered=True, output="print",
   303	             substitutions=None):
   304	    from .case import prepare, estimate_font
   305	    from . import toolkit_geometry as G
   306	    substitutions=QUALIFIED_GEOMETRY if substitutions is None else frozenset(substitutions)
   307	    if substitutions-{'S1','S2','S3'}:
   308	        raise ValueError('unknown geometry substitution')
   309	    estimate_font(ink)
   310	    if 'S2' in substitutions:
   311	        G.shared_guides(ink,apply=True)
   312	    slots=(G.physical_slots if 'S1' in substitutions else recogniser_slots)(ink,recogniser_text,alignment)
   313	    prepare(ink,slots)
   314	    if 'S2' in substitutions:
   315	        G.capital_features(ink,slots)
   316	    if 'S3' in substitutions:
   317	        G.prepare_cuts(ink)
   318	    located=[s for s in slots if s['component'] is not None]
   319	    apost=I.apostrophe_candidates(ink,[(s['component'],s['base'],s['word_final']) for s in located])
   320	    apost_boxes={(b.x0,b.y0,b.x1,b.y1) for bs in apost.values() for b in bs}
   321	    for i,s in enumerate(located):
   322	        c=s['component']
   323	        # The union is already certified against all character owners. Pass it
   324	        # directly so snap_body cannot include another overlapping character.
   325	        ev=I.mark_evidence(ink,c.x0,c.x1,base_letter=s['base'],certified_body=(c.x0,c.x1), letter_region=s)
   326	        ev.above=[b for b in ev.above if (b.x0,b.y0,b.x1,b.y1) not in apost_boxes]
   327	        ev.apostrophes=list(apost.get(i,()))
   328	        s.update(evidence=ev,apostrophe=i in apost)
   329	    # Overhanging ink may enter two windows. Sloping meanlines can clip the
   330	    # same native lobe by one different row, so exact-box equality is too weak.
   331	    proposals=[]
   332	    for s in located:
   333	        for field in ('above','below'):
   334	            for b in getattr(s['evidence'],field):
   335	                proposals.append(dict(slot=s,field=field,blob=b,pixels=b.pixel_keys()))
   336	    roots=list(range(len(proposals)))
   337	    def root(i):
   338	        while roots[i]!=i:
   339	            roots[i]=roots[roots[i]];i=roots[i]
   340	        return i
   341	    for i,p in enumerate(proposals):
   342	        a=p['blob']
   343	        for j,q in enumerate(proposals[:i]):
   344	            b=q['blob']
   345	            if p['field']!=q['field']:continue
   346	            if p['pixels'] & q['pixels']:roots[root(i)]=root(j)
   347	    winners={}
   348	    for i,p in enumerate(proposals):
   349	        key=root(i);b=p['blob'];s=p['slot']
   350	        rank=(abs(b.cx-s['component'].cx),-b.area,s['start'])
   351	        if key not in winners or rank<winners[key][0]:winners[key]=(rank,i)
   352	    accepted={i for rank,i in winners.values()}
   353	    for key, (_, winner) in winners.items():
   354	        group=[p for i,p in enumerate(proposals) if root(i)==key]
   355	        pixels=set().union(*(p['pixels'] for p in group))
   356	        b=proposals[winner]['blob']
   357	        proposals[winner]['blob']=I.blob_from_pixels(ink,pixels,b.source)
   358	        assert proposals[winner]['blob'].pixel_keys()==pixels
   359	    for s in located:
   360	        for field in ('above','below'):
   361	            setattr(s['evidence'],field,[p['blob'] for i,p in enumerate(proposals) if i in accepted and p['slot'] is s and p['field']==field])
   362	    flags=[]
   363	    for s in slots:
   364	        if s.get('localisation_unknown'):
   365	            flags.append(dict(start=s['start'],reason='localisation_unknown'))
   366	            if 'S1' in substitutions:
   367	                s.update(hold=True,label_status='HOLD')
   368	        if s['component'] is None:
   369	            s['parts']=();s['unnamed']=()
   370	            continue
   371	        ev=s['evidence']
   372	        names=name_marks(ev,model)
   373	        s.update(parts=names.parts,unnamed=names.unnamed,naming=names)
   374	        if 'S3' in substitutions:
   375	            ev.observation=G.observation(ink,s)
   376	            unseen=[]
   377	            if s['base'].lower() in 'αεηιουωρ' and ev.observation['above']=='UNSEEN':unseen.append('above')
   378	            if s['base'].lower() in 'αηω' and ev.observation['below']=='UNSEEN':unseen.append('below')
   379	            if unseen:
   380	                s.update(hold=True,label_status='HOLD',unseen_zones=unseen)
   381	                flags.append(dict(start=s['start'],reason='crop_UNSEEN',zones=unseen))
   382	        flags.extend(dict(start=s['start'],blob=i,reason='unnamed') for i in names.unnamed)
   383	    reserved = [b for s in located for b in s['evidence'].above if b.source == 'preposed']
   384	    quotes = I.opening_quote_candidates(ink,located[0]['component'],reserved) if located else []
   385	    text = render_reading(recogniser_text,slots)
   386	    # Quote glyphs in recogniser text are not evidence of printed punctuation.
   387	    text = text.lstrip('“”«»„\" ')
   388	    if quotes:
   389	        text = '“'+text
   390	    geometry={}
   391	    if substitutions:
   392	        geometry['substitutions']=sorted(substitutions)
   393	    if 'S1' in substitutions:
   394	        geometry.update(physical_letters=ink.physical_letters,physical_mapping=ink.physical_mapping)
   395	    if 'S2' in substitutions:
   396	        geometry['guides']=ink.shared_guides.record()
   397	    reading = LineReading(text,slots,flags,[b.to_record() for b in quotes],geometry=geometry)
   398	    return apply_constraints(reading, output=output)[0] if filtered else reading
