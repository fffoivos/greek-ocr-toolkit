   410	            # crossing a fused-letter boundary stays one native upper CC and
   411	            # whole-line ownership credits its full box to one character.
   412	            mark_source=original if own_region and own_vowel else c
   413	            blobs, rejected = vowel_marks(ink, mark_source, top) if own_vowel else attached_marks(ink, c, top)
   414	            ev.above.extend(b for b in blobs if lo <= b.cx <= hi)
   415	            ev.diagnostics.extend(b for b in rejected if lo <= b.cx <= hi)
   416	        # The same local rule applies to a wedge touching its vowel. Only the
   417	        # below-baseline tail is measured, never the entire letter/descender.
   418	        if base_letter in ('α','η','ω') and c.role in ('letter','large') and b0 <= c.cx <= b1 and c.y1 > base:
   419	            cut = max(c.y0, int(math.ceil(base)))
   420	            if cut < c.y1:
   421	                tail = component_mask(ink,c)[cut-c.y0:]
   422	                lab, _ = ndi.label(tail, structure=EIGHT)
   423	                for k, sl in enumerate(ndi.find_objects(lab), 1):
   424	                    if sl is None:
   425	                        continue
   426	                    b = _blob(lab[sl] == k, cut+sl[0].start, c.x0+sl[1].start, 'attached', ink)
   427	                    if subscript_shape(b, ev, ink):
   428	                        ev.below.append(b)
   429	    ev.above.extend(preposed)
   430	    # The glyph pass can call an upper arch neighbouring-line ink. A lower,
   431	    # already accepted mark anchors recovery; top-edge fragments never qualify.
   432	    for c in ink.components:
   433	        if c.role != 'neighbour' or c.y0 <= 0 or c.y1 >= ink.height:
   434	            continue
   435	        if not (b0 <= c.cx <= b1 and top-1.3*xh <= c.y0
   436	                and c.h <= .9*xh and c.w <= 1.2*xh):
