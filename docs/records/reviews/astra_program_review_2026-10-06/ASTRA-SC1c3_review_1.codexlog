    94	def run(config,out,*,mock=False):
    95	    config=Path(config);cfg=json.loads(config.read_text());out=Path(out)
    96	    historical=Path(cfg['historical_run']).resolve()
    97	    if out.resolve()==historical or historical in out.resolve().parents:raise ValueError('L1-v0 is immutable; choose a separate output')
    98	    out.mkdir(parents=True,exist_ok=True)
    99	    if mock:
   100	        if cfg['lines']>200 or not cfg.get('verification_only'):raise ValueError('mock must be <=200 verification-only lines')
   101	        device='cpu'
   102	    else:
   103	        if not os.environ.get('SLURM_JOB_ID') or not torch.cuda.is_available():raise ValueError('GPU allocation required')
   104	        device='cuda:0'
   105	    started=time.monotonic();checked(cfg['historical_run']+'/run_receipt.json',cfg['historical_run_receipt_sha256'])
   106	    original_binding=json.loads((Path(cfg['binding_dir'])/'binding.json').read_text())
   107	    if cfg['checkpoints']['A']['sha256']!=original_binding['r1_sha256']:raise ValueError('A checkpoint differs from historical binding')
   108	    for name,digest in cfg['unchanged_l1_code_sha256'].items():checked(name,digest)
   109	    for name,digest in cfg['code_sha256'].items():checked(name,digest)
   110	    wr=audit(Path(cfg['historical_run'])/'detector',cfg['selection'],out/'windows_receipt.json',workers=1 if mock else 16,
   111	        repair=True,binding_dir=cfg['binding_dir'],crop_root=cfg.get('crop_root'),layout=cfg.get('layout','e3'))
   112	    if wr['lines']!=cfg['lines']:raise ValueError('unexpected line population')
   113	    ir=infer(cfg['historical_run'],wr,cfg['checkpoints'],out/'inference',cfg['code_sha256'],device,64 if mock else 512)
   114	    if mock:
   115	        expected={r['id']:r['decisions'] for r in rows(cfg['expected_decisions'])}
   116	        actual={r['id']:decision_record(r) for p in sorted((out/'inference').glob('*-combined.jsonl.gz')) for r in rows(p)}
   117	        differences=[i for i in expected if actual.get(i)!=expected[i]]
   118	        pr=dict(verification_only=True,lines=len(actual),exact=len(expected)-len(differences),expected=len(expected),
   119	            differences=differences,expected_sha256=sha256(cfg['expected_decisions']))
   120	        write_json(out/'parity_receipt.json',pr)
   121	        if differences or set(actual)!=set(expected):raise ValueError('held-out decision parity failed')
   122	    from scripts.labelfix.clariden.l1r_recompose import recompose
   123	    rr=recompose(cfg['historical_run'],cfg['selection'],cfg['binding_dir'],cfg['source'],out/'recomposition',
   124	        out/'inference',workers=1 if mock else 16)
   125	    result=dict(schema='l1e-run-v1',complete=True,mock=mock,verification_only=mock,lines=cfg['lines'],
   126	        config_sha256=sha256(config),policy=policy_binding(),window_audit_sha256=sha256(out/'windows_receipt.json'),
   127	        inference_receipt_sha256=sha256(out/'inference/r1e_receipt.json'),
   128	        recomposition_receipt_sha256=sha256(out/'recomposition/receipt.json'),elapsed_seconds=time.monotonic()-started,
   129	        checkpoints=ir['checkpoint_sha256'],counts=rr['counts'],original_labels_unchanged=True)
   130	    write_json(out/'run_receipt.json',result)
   131	    print('L1E_DONE '+json.dumps(result,ensure_ascii=False),flush=True)
   132	    return result
