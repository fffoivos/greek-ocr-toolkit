+                         (ctrl,[('labels_file','labels_sha256')])]:
+            for name,digest in keys:assert sha256(path/obj[name])==obj[digest]
+        overlays=list(rows(path/m['overlay']));controls=list(rows(path/ctrl['labels_file']))
