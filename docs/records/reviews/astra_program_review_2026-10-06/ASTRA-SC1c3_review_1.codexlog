    17	def load_reader(checkpoint,arm,digest,device):
    18	    checked(checkpoint,digest)
    19	    ck=torch.load(checkpoint,map_location='cpu',weights_only=True)
    20	    if ck['arm']!=arm:raise ValueError('checkpoint arm mismatch: '+arm)
    21	    model=MarkReader(embedding=ARMS[arm]['embedding']).to(device,memory_format=torch.channels_last)
