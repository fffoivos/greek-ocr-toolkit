    38	def serialize(rd):
    39	    """Lossless decision/evidence serializer shared by pages and releases."""
    40	    slots=[]
    41	    for i,s in enumerate(rd.slots,1):
    42	        c=s.get('component')
    43	        d={k:v for k,v in s.items() if k not in ('component','evidence','naming')}
    44	        d.update(display_slot=i,parts=list(s.get('parts',())),
    45	                 bbox=[c.x0,c.y0,c.x1,c.y1] if c is not None else s.get('bbox'),
    46	                 component_ids=list(s.get('component_ids',())))
    47	        ev=s.get('evidence',{})
    48	        d['evidence']=ev.to_record() if hasattr(ev,'to_record') else deepcopy(ev)
    49	        nm=s.get('naming',{})
    50	        d['naming']=asdict(nm) if hasattr(nm,'__dataclass_fields__') else deepcopy(nm)
    51	        slots.append(d)
    52	    record=dict(schema='line-reading-sf1-v1',text=rd.text,slots=slots,unnamed=rd.unnamed,
    53	                opening_quotes=rd.opening_quotes,removed_by_constraint=rd.removed_by_constraint,
    54	                constraint_flags=rd.constraint_flags)
    55	    if rd.geometry:record['geometry']=deepcopy(rd.geometry)
    56	    return record
