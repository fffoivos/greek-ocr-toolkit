     1	"""Shared SF2/L1E policy: observation, agreement, K1, and bounded edits.
     2	
     3	PRESENCE compares mark families; FULL compares exact mark sets. Neither is
     4	independent print truth. Missing observation always abstains. Punctuation uses
     5	detector opening quotes (canonical “) and word-final elisions (canonical ’).
     6	Other punctuation and spaces must match, allowing explicit codepoint aliases.
     7	Base letters and unsupported printed marks remain guarded.
     8	ENSEMBLE_AB/AE compare A with B/E exactly and do not veto on detector names.
     9	"""
    10	from collections import Counter
    11	from copy import deepcopy
    12	from dataclasses import asdict, fields, replace
    13	import hashlib
