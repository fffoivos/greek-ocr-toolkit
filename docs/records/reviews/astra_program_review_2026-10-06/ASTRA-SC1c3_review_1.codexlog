    28	def policy_binding():
    29	    from pathlib import Path
    30	    root=Path(__file__).resolve().parents[2]
    31	    paths = [Path(__file__), Path(R.__file__),Path(__file__).with_name('text.py'),
    32	             root/'scripts/labelfix/clariden/l1_common.py',root/'scripts/labelfix/clariden/l1r_recompose.py']
    33	    sources = {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
    34	    return dict(schema=POLICY, sources=sources,
    35	                sha256=hashlib.sha256(json.dumps(sources,sort_keys=True).encode()).hexdigest())
