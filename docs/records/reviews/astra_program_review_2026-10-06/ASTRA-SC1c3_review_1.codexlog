    83	def _mark_support(slot, part):
    84	    """Actual detector support, with shared whole-set evidence explicit.
    85	
    86	    Rank: classifier probability, area / x-height squared, then negative
    87	    horizontal distance / x-height. Whole-set names share support; no invented
    88	    per-mark probabilities or blob assignments break ties.
    89	    """
    90	    reader_support=slot.get('mark_support_source')=='reader'
    91	    ev = _record(slot.get('reader_evidence') if reader_support else slot.get('evidence'))
    92	    naming = {} if reader_support else _record(slot.get('naming'))
    93	    blobs = ev.get('below' if part == 'subscript' else 'above', [])
    94	    records = [r for r in naming.get('per_blob', ()) if part in r['parts']]
    95	    probability = naming.get('probability') if part != 'subscript' else None
    96	    source = 'whole_set_shared'
    97	    if records and part != 'subscript':
    98	        blobs = [blobs[r['blob']] for r in records if r['blob'] < len(blobs)]
    99	        probability = min(r['probability'] for r in records) if all(r.get('probability') is not None for r in records) else None
   100	        source = 'per_blob'
   101	    if 'mark_probabilities' in slot:
   102	        probability = slot['mark_probabilities'].get(part)
   103	        source = 'reader_head'
   104	    bs = [_record(b) for b in blobs]
   105	    xh = max(float(ev.get('xh', 1)), 1.)
   106	    body = ev.get('body') or slot.get('region_bounds')
   107	    center = sum(body) / 2 if body else None
   108	    area = sum(float(b.get('area', 0)) for b in bs)
   109	    distance = (sum(abs((b['bbox'][0] + b['bbox'][2]) / 2 - center)
   110	                    * float(b.get('area', 0)) for b in bs) / area
   111	                if center is not None and area else None)
   112	    return dict(probability=probability, blob_area=area if bs else None,
   113	                distance_to_letter=distance, xh=xh, source=source,
   114	                blobs=[b['bbox'] for b in bs],
   115	                rank=[float(probability) if probability is not None else 0.,
   116	                      area / (xh*xh), -distance / xh if distance is not None else 0.])
   117	
