    60	        for field in ('base', 'component_ids', 'bbox'):
    61	            assert r[field] == b[field], (frozen['line_id'], r['start'], field)
    62	        r['component_slots'] = b['component_slots']
    63	        r['component_slot'] = b['component_slot']
    64	    for s in line['slots']:
