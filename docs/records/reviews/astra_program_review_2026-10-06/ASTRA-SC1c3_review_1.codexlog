    88	def _word_final_elision(cs, i):
    89	    return (cs[i].base in ELISION and not cs[i].marks and i>0
    90	            and cs[i-1].base in GREEK_LETTERS
    91	            and (i+1==len(cs) or not cs[i+1].base.isalpha()))
