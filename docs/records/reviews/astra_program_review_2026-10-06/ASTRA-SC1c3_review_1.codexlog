    88	        color=(180,100,0) if box['status']=='flagged-by-constraint' else (40,80,200) if box['kind']=='below' else (30,140,60)
    89	        draw.rectangle([v*scale for v in box['bbox']],outline=color,width=2)
    90	    for sl in record['slots']:
