   303	    # entire body; do not throw away the second stroke (and its overlying mark).
   304	    if vowel and len(hits) == 2:
   305	        a, b = sorted(hits, key=lambda c: c.x0)
   306	        if b.x1 - a.x0 <= 1.6*xh:
   307	            return float(a.x0), float(b.x1), 'letter', 1
   308	    n = sum(1 for ov in overlaps if ov >= 0.3 * max(1.0, bx1 - bx0) and ov >= best_ov / 1.5)
   309	    if best.w <= 1.6 * xh:
   310	        return float(best.x0), float(best.x1), 'letter', n
   311	    return max(float(best.x0), bx0 - 0.2 * xh), min(float(best.x1), bx1 + 0.5 * xh), 'merged', n
