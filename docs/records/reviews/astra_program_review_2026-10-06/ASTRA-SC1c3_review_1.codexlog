    11	from scripts.labelfix.clariden.r1_common import rows, write_rows, sha256, write_json
    12	from greekocr.labelfix.text import nfd
    13	from greekocr.labelfix.release_gate import compose_runtime, edit_guard, POLICY, ENSEMBLE_CAVEAT
    14	
    15	STATUSES = ('corrected', 'unchanged', 'hold', 'out_of_scope')
    16	
    17	
    18	def canonical(value):
    19	    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False)
    20	
    21	
    22	def label_sha(text):
    23	    return hashlib.sha256(text.encode('utf-8')).hexdigest()
    24	
    25	
    26	def hold_reason(reason):
    27	    if reason.startswith(('ensemble_ab_mark_set_disagreement','ensemble_ae_mark_set_disagreement')):
    28	        return 'ensemble_disagreement'
    29	    if reason.startswith(('mark_kind_disagreement', 'mark_set_disagreement')):
    30	        return 'kind_disagreement'
    31	    if reason.startswith('K1:'):
    32	        return 'k1_flag'
    33	    if reason == 'r1_unsupported_letter':
    34	        return 'recogniser_letter_problem'
    35	    return 'localisation_unknown'
