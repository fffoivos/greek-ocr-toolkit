    47	def reading_html(record):
    48	    it=iter(record['slots']);out=[]
    49	    for cl in clusters(nfd(record['text'])):
    50	        text=html.escape(nfc(cl.base+cl.marks))
    51	        if cl.base.isalpha():
    52	            sl=next(it)
    53	            if sl.get('hold') or sl.get('constraint_flags'):
    54	                text=f'<span class="un" title="reader and detector disagree / impossible by rule">{text}</span>'
    55	            elif sl.get('unnamed'):
    56	                text=f'<span class="un" title="mark detected, not named">{text}</span>'
    57	        out.append(text)
    58	    return ''.join(out)
