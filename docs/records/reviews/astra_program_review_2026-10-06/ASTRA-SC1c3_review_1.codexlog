     1	"""Regression check between two page builds: mark boxes lost / added / moved per line, and reading changes.
     2	
     3	Standard step of every detector or reader cycle (owner, 16 Oct 2026): "checking for regression should be standard part of your work
     4	cycle ... test for the presence of different boxes on the line from previous versions."
     5	
     6	Inputs are the `--boxes-out` sidecars written by the owner-page builder (line_id -> reading, boxes [{kind, bbox}], letters [[x0, x1]]).
     7	Boxes match when they have the same kind and IoU >= --iou (default 0.3); a matched pair whose IoU < 0.6 is reported as moved.
     8	Each changed box is tied to the page's slot number (letter components sorted by x, from 1) by horizontal centre.
     9	With --notes (owner note files, jsonl with line_id/note), lines are split into: judged correct (empty note), reviewed with a note
    10	(a change at a slot number the note names is 'at a named slot', otherwise 'implicitly approved'), and unreviewed.
    11	
    12	Usage: python scripts/labelfix/box_regression.py OLD.json NEW.json [--notes a.jsonl b.jsonl] [--out diff.json]
    13	"""
    14	from __future__ import annotations
    15	
    16	import argparse
    17	import hashlib
    18	from pathlib import Path
    19	import json
    20	import re
    21	from collections import Counter
    22	import numpy as np
    23	from scipy.optimize import linear_sum_assignment
    24	from scripts.labelfix.owner_implicit_changes import mentioned_slots
    25	
    26	
    27	def iou(a, b):
    28	    ix = max(0, min(a[2], b[2]) - max(a[0], b[0])); iy = max(0, min(a[3], b[3]) - max(a[1], b[1]))
    29	    inter = ix * iy
    30	    ua = (a[2] - a[0]) * (a[3] - a[1]) + (b[2] - b[0]) * (b[3] - b[1]) - inter
    31	    return inter / ua if ua > 0 else 0.0
    32	
    33	
    34	def slot_of(box, letters):
    35	    """Assign only inside an explicit mark zone; ambiguous/outside stays unassigned."""
    36	    cx,cy=(box[0]+box[2])/2,(box[1]+box[3])/2
    37	    hits=[]
    38	    for i,letter in enumerate(letters):
    39	        zone=letter.get('mark_zone') if isinstance(letter,dict) else letter
    40	        if zone is None or len(zone)!=4:continue  # legacy x ranges cannot certify a mark zone
    41	        inside=zone[0]<=box[0] and box[2]<=zone[2] and zone[1]<=box[1] and box[3]<=zone[3]
    42	        if inside:hits.append(letter.get('display_slot',i+1) if isinstance(letter,dict) else i+1)
    43	    return hits[0] if len(hits)==1 else None
    44	
    45	
    46	def diff_line(old, new, thr):
    47	    lost,added,moved=[],[],[]
    48	    changes={k:[] for k in ('owner_changed','pixels_changed','status_changed','pixels_unknown','owner_unknown','status_unknown')}
    49	    # Canonical order also makes equal-weight choices independent of input order.
    50	    aa=sorted(old['boxes'],key=lambda b:(b['kind'],b['bbox']))
    51	    bb=sorted(new['boxes'],key=lambda b:(b['kind'],b['bbox']))
    52	    n,m=len(aa),len(bb);weight=np.zeros((n+m,n+m))
    53	    for i,a in enumerate(aa):
    54	        for j,b in enumerate(bb):
    55	            ov=iou(a['bbox'],b['bbox'])
    56	            if a['kind']==b['kind'] and ov>=thr:
    57	                weight[i,j]=min(n,m)+1+ov  # maximum cardinality, then total IoU
    58	    ii,jj=linear_sum_assignment(weight,maximize=True)
    59	    matched={i:j for i,j in zip(ii,jj) if i<n and j<m and weight[i,j]>0}
    60	    used=set(matched.values())
    61	    oldzones=old.get('letter_zones',old.get('letters',[]));newzones=new.get('letter_zones',new.get('letters',[]))
    62	    for i,a in enumerate(aa):
    63	        oldslot=slot_of(a['bbox'],oldzones)
    64	        if i not in matched:
    65	            lost.append(dict(a,slot=oldslot,old_slot=oldslot,namespace='old',ownership='assigned' if oldslot else 'unassigned'))
    66	        else:
    67	            b=bb[matched[i]];ov=iou(a['bbox'],b['bbox'])
    68	            newslot=slot_of(b['bbox'],newzones)
    69	            oldowner=a.get('display_slot');newowner=b.get('display_slot')
    70	            delta=dict(kind=a['kind'],old=a,new=b,iou=ov,old_slot=oldslot,new_slot=newslot,
    71	                       old_display_slot=oldowner,new_display_slot=newowner)
    72	            if a['kind']!='quote' and (oldowner is None or newowner is None):changes['owner_unknown'].append(delta)
    73	            elif oldowner!=newowner:changes['owner_changed'].append(delta)
    74	            def pixels(box):
    75	                runs=box.get('pixel_runs')
    76	                if runs is None:return None
    77	                x0,y0=box['bbox'][:2]
    78	                return {(y+y0,x+x0) for y,lo,hi in runs for x in range(lo,hi)}
    79	            ap,bp=pixels(a),pixels(b)
    80	            if ap is None or bp is None:changes['pixels_unknown'].append(delta)
    81	            elif ap!=bp or set(a.get('source_ids') or [])!=set(b.get('source_ids') or []):changes['pixels_changed'].append(delta)
    82	            if a.get('status') is None or b.get('status') is None:changes['status_unknown'].append(delta)
    83	            elif a['status']!=b['status']:changes['status_changed'].append(delta)
    84	            if ov<.6:
    85	                newslot=slot_of(b['bbox'],newzones)
    86	                moved.append(dict(kind=a['kind'],old=a['bbox'],new=b['bbox'],iou=round(ov,2),slot=oldslot,
    87	                                  old_slot=oldslot,new_slot=newslot,namespace='old/new'))
    88	    for j,b in enumerate(bb):
    89	        if j not in used:
    90	            slot=slot_of(b['bbox'],newzones)
    91	            added.append(dict(b,slot=slot,new_slot=slot,namespace='new',ownership='assigned' if slot else 'unassigned'))
    92	    return dict(**changes,lost=lost,added=added,moved=moved,reading_old=old['reading'],reading_new=new['reading'],reading_changed=old['reading']!=new['reading'])
    93	
    94	
    95	def compare_pages(old,new,thr):
    96	    result={}
    97	    empty=dict(boxes=[],letters=[],reading='')
    98	    for lid in sorted(set(old)|set(new)):
    99	        d=diff_line(old.get(lid,empty),new.get(lid,empty),thr)
   100	        d['line_status']='missing_old' if lid not in old else 'missing_new' if lid not in new else 'both'
   101	        result[lid]=d
   102	    return result
   103	
   104	
   105	def review_scope(change,kind,oldline,named,status):
   106	    """Notes refer to reviewed OLD slots; a new slot number is never an alias."""
   107	    if status=='unreviewed':return 'unreviewed'
   108	    oldslot=change.get('old_slot')
   109	    if kind=='added':
   110	        oldslot=slot_of(change['bbox'],oldline.get('letter_zones',[]))
   111	    change['reviewed_old_slot']=oldslot
   112	    if oldslot is None:return 'unresolved reviewed owner'
   113	    return 'at a named slot' if status=='reviewed with note' and oldslot in named else 'implicitly approved'
   114	
   115	
   116	def validate_review_binding(path, old, notes):
   117	    """A caller explicitly binds each exact notes file to the reviewed snapshot."""
   118	    if not path:raise ValueError('notes require --review-binding before approval language')
   119	    binding=json.loads(Path(path).read_text())
   120	    expected={str(p):hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in notes}
   121	    if not old.get('page_sha256') or binding.get('reviewed_page_sha256')!=old['page_sha256']:
   122	        raise ValueError('notes binding does not identify reviewed page')
   123	    if binding.get('notes_sha256')!=expected:raise ValueError('notes binding hash mismatch')
   124	    page=Path(binding['reviewed_page'])
   125	    if hashlib.sha256(page.read_bytes()).hexdigest()!=old['page_sha256']:
   126	        raise ValueError('reviewed page bytes differ')
   127	    return binding
   128	
   129	
   130	def main():
   131	    ap = argparse.ArgumentParser()
   132	    ap.add_argument('old'); ap.add_argument('new')
   133	    ap.add_argument('--notes', nargs='*', default=[]); ap.add_argument('--iou', type=float, default=0.3); ap.add_argument('--out')
   134	    ap.add_argument('--review-binding',help='JSON: reviewed_page, reviewed_page_sha256, notes_sha256 keyed by notes path')
   135	    a = ap.parse_args()
   136	    old, new = json.load(open(a.old)), json.load(open(a.new))
   137	    if a.notes:validate_review_binding(a.review_binding,old,a.notes)
   138	    old=old.get('lines',old);new=new.get('lines',new)
   139	    notes = {}
   140	    for f in a.notes:
   141	        for l in open(f):
   142	            r = json.loads(l); notes[r['line_id']] = (r.get('note') or '').strip()
   143	    out, tot = {}, Counter()
   144	    for lid,d in compare_pages(old,new,a.iou).items():
   145	        if lid not in notes:
   146	            status = 'unreviewed'
   147	        elif not notes[lid]:
   148	            status = 'judged correct'
   149	        else:
   150	            status = 'reviewed with note'
   151	        named = mentioned_slots(notes.get(lid,''))
   152	        for k in ('lost', 'added', 'moved','owner_changed','pixels_changed','status_changed'):
   153	            for b in d[k]:
   154	                b['scope'] = review_scope(b,k,old.get(lid,{}),named,status)
   155	                tot[(status, k, b['scope'])] += 1
   156	        for key in ('owner_unknown','pixels_unknown','status_unknown'):
   157	            tot[('coverage',key,'unresolved')]+=len(d[key])
   158	        d['status'] = status
   159	        if d['line_status']!='both' or d['lost'] or d['added'] or d['moved'] or any(d[k] for k in ('owner_changed','pixels_changed','status_changed')) or d['reading_changed']:
   160	            out[lid] = d
   161	    summary = {' / '.join(k): v for k, v in sorted(tot.items())}
   162	    summary['lines missing old']=len(set(new)-set(old));summary['lines missing new']=len(set(old)-set(new))
   163	    summary['lines compared'] = len(set(old) & set(new)); summary['lines with any change'] = len(out)
   164	    print(json.dumps(summary, ensure_ascii=False, indent=1))
   165	    if a.out:
   166	        json.dump(dict(summary=summary, lines=out), open(a.out, 'w'), ensure_ascii=False, indent=1)
   167	
   168	
   169	if __name__ == '__main__':
   170	    main()
