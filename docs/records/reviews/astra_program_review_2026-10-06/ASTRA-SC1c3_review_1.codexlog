   443	        b = _blob(component_mask(ink,c),c.y0,c.x0,'stacked',ink)
   444	        if b.area >= MIN_BLOB_AREA and not b.faint:
   445	            ev.above.append(b)
   446	    ev.above = list({b.pixel_keys(): b for b in ev.above}.values())
   447	    if letter_region is not None:
   448	        # A half-open box may end at floor(meanline), never inside the body.
   449	        # Capital side marks are outside its horizontal body and have their
   450	        # separate S5 vertical side zone. Subscripts start at ceil(baseline).
   451	        overhead_top=min(top,ink.band((b0+b1)/2)[0])
   452	        ev.above=[q for b in ev.above if (q:=zone_blob(ink,b,upper=shared.mean if shared else overhead_top) if b.source!='preposed' else b) is not None]
