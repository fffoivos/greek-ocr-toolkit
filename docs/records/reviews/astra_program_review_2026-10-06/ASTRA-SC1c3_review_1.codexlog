   116	def validate_review_binding(path, old, notes):
   117	    """A caller explicitly binds each exact notes file to the reviewed snapshot."""
   118	    if not path:raise ValueError('notes require --review-binding before approval language')
   119	    binding=json.loads(Path(path).read_text())
   120	    expected={str(p):hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in notes}
   121	    if not old.get('page_sha256') or binding.get('reviewed_page_sha256')!=old['page_sha256']:
   122	        raise ValueError('notes binding does not identify reviewed page')
   123	    if binding.get('notes_sha256')!=expected:raise ValueError('notes binding hash mismatch')
   124	    page=Path(binding['reviewed_page'])
   125	    if hashlib.sha256(page.read_bytes()).hexdigest()!=old['page_sha256']:
   126	        raise ValueError('reviewed page bytes differ')
   127	    return binding
   128	
   129	
   130	def main():
   131	    ap = argparse.ArgumentParser()
   132	    ap.add_argument('old'); ap.add_argument('new')
   133	    ap.add_argument('--notes', nargs='*', default=[]); ap.add_argument('--iou', type=float, default=0.3); ap.add_argument('--out')
   134	    ap.add_argument('--review-binding',help='JSON: reviewed_page, reviewed_page_sha256, notes_sha256 keyed by notes path')
   135	    a = ap.parse_args()
   136	    old, new = json.load(open(a.old)), json.load(open(a.new))
   137	    if a.notes:validate_review_binding(a.review_binding,old,a.notes)
   138	    old=old.get('lines',old);new=new.get('lines',new)
   139	    notes = {}
   140	    for f in a.notes:
   141	        for l in open(f):
   142	            r = json.loads(l); notes[r['line_id']] = (r.get('note') or '').strip()
   143	    out, tot = {}, Counter()
   144	    for lid,d in compare_pages(old,new,a.iou).items():
   145	        if lid not in notes:
   146	            status = 'unreviewed'
   147	        elif not notes[lid]:
   148	            status = 'judged correct'
   149	        else:
   150	            status = 'reviewed with note'
   151	        named = mentioned_slots(notes.get(lid,''))
   152	        for k in ('lost', 'added', 'moved','owner_changed','pixels_changed','status_changed'):
   153	            for b in d[k]:
   154	                b['scope'] = review_scope(b,k,old.get(lid,{}),named,status)
   155	                tot[(status, k, b['scope'])] += 1
   156	        for key in ('owner_unknown','pixels_unknown','status_unknown'):
   157	            tot[('coverage',key,'unresolved')]+=len(d[key])
   158	        d['status'] = status
   159	        if d['line_status']!='both' or d['lost'] or d['added'] or d['moved'] or any(d[k] for k in ('owner_changed','pixels_changed','status_changed')) or d['reading_changed']:
   160	            out[lid] = d
   161	    summary = {' / '.join(k): v for k, v in sorted(tot.items())}
   162	    summary['lines missing old']=len(set(new)-set(old));summary['lines missing new']=len(set(old)-set(new))
   163	    summary['lines compared'] = len(set(old) & set(new)); summary['lines with any change'] = len(out)
   164	    print(json.dumps(summary, ensure_ascii=False, indent=1))
   165	    if a.out:
   166	        json.dump(dict(summary=summary, lines=out), open(a.out, 'w'), ensure_ascii=False, indent=1)
   167	
   168	
   169	if __name__ == '__main__':
   170	    main()
