   119	def _normalise_constraints(reading: LineReading, *, enabled_rules=APPLIED_CONSTRAINT_RULES):
   120	    """Return a copy with qualified impossible marks removed, plus a receipt.
   121	
   122	    None enables all rules for offline qualification. Held-back proposals and
   123	    tied conflicts are parallel flags, never deletions. Missing marks are never
   124	    supplied. Base letters, punctuation, physical evidence and input are intact.
   125	    """
   126	    from . import constraints as C
   127	    enabled = CONSTRAINT_RULES if enabled_rules is None else frozenset(enabled_rules)
   128	    slots = [dict(s, parts=list(s.get('parts', ()))) for s in reading.slots]
   129	    removed, flags = [], list(reading.constraint_flags)
   130	    # Output NFD offsets differ from the recogniser offsets as marks change.
   131	    # Join by letter order, retaining each original slot/start in all receipts.
   132	    text_cls = clusters(nfd(reading.text))
   133	    letters = [c for c in text_cls if c.base.isalpha()]
   134	    if len(letters) != len(slots) or any(c.base != s['base'] for c,s in zip(letters, slots)):
   135	        raise ValueError('reading letters and evidence slots differ')
   136	    at = {c.start: i for i,c in enumerate(letters)}
   137	    groups = []
   138	    for token in tokenize(reading.text):
   139	        group = []
   140	        for c in clusters(token.core):
   141	            if c.base.isalpha():
   142	                group.append(at[token.core_start+c.start])
   143	            elif group:
   144	                groups.append((group, True)); group = []
   145	        if group:
   146	            groups.append((group, False))
   147	
   148	    def describe(ref):
   149	        i, k = ref; s = slots[i]; p = s['parts'][k]
   150	        return dict(letter=s['base'], slot=s.get('component_slot', i),
    28	
    29	def recogniser_slots(ink, text, alignment):
    30	    """Every recognised letter gets one region, including touching/split glyphs.
    31	
    32	    Shared components are partitioned at cached span boundaries, refined by the
    33	    minimum *body* ink column within a quarter font-scaled letter width. A zero
    34	    gap is neither required nor used as evidence of a separate character.
    35	    """
    36	    text = nfd(text)
    37	    alignment = transfer_alignment(text, alignment)
    38	    letters = sorted((c for c in ink.components if c.role == 'letter'), key=lambda c:c.x0)
    39	    tokens = tokenize(text)
    40	    slots, owners = [], {}
    41	    for cl in clusters(text):
    42	        if not cl.base.isalpha():
    43	            continue
    44	        sp = alignment.span(cl.start)
    45	        # CTC spikes lean into the preceding letter. Absolute overlap alone
    46	        # sends a narrow iota to its wide neighbour. Normalize by pixel width
    47	        # on the font scale before deciding that a component is truly shared.
    48	        ovs = [I._overlap(sp.x0, sp.x1, c.x0, c.x1)/np.sqrt(max(c.w,.35*ink.xh)) for c in letters]
    49	        k = max(range(len(letters)), key=lambda k:ovs[k]) if letters else None
    50	        if k is not None and ovs[k] <= 0:
    51	            k = None
    52	        s = dict(base=cl.base, start=cl.start, end=cl.end, locator_span=[sp.x0, sp.x1],
    53	                 primary=k, indices=[], component_ids=[], component=None,
    54	                 word_final=any(cl.end==t.core_end for t in tokens),
    55	                 word_index=next((t.index for t in tokens if t.core_start<=cl.start<t.core_end), -1),
    56	                 fused=False, split_union=False, localisation_unknown=False)
    57	        slots.append(s)
    58	        if k is not None:
    59	            owners.setdefault(k, []).append(len(slots)-1)
    60	    claimed = set(owners)
    61	    for k, indices in owners.items():
    62	        c = letters[k]
    63	        ss = [slots[i] for i in indices]
    64	        if len(ss)>1:
    65	            width = float(np.mean([expected_width(ink,s['base']) for s in ss]))
    66	            cuts = [c.x0]
    67	            top, bottom = ink.band(c.cx)
    68	            mask = ink.labels[max(0,int(top)):min(ink.height,int(np.ceil(bottom))),c.x0:c.x1]==c.index
    69	            mass = mask.sum(axis=0)
    70	            for j, (a,b) in enumerate(zip(ss,ss[1:]), 1):
    71	                target = (a['locator_span'][1]+b['locator_span'][0])/2
    72	                # Ordering and a small pixel support floor prevent zero-width
    73	                # partitions when transferred CTC spans coincide.
    74	                target = np.clip(target, cuts[-1]+1, c.x1-(len(ss)-j))
    75	                lo = max(cuts[-1]+1, int(np.ceil(target-.25*width)))
    76	                hi = min(c.x1-(len(ss)-j), int(np.floor(target+.25*width)))
    77	                choices = range(lo, hi+1)
    78	                cut = min(choices, key=lambda x:(mass[x-c.x0],abs(x-target))) if lo<=hi else int(target)
    79	                cuts.append(cut)
    80	            cuts.append(c.x1)
    81	            for j,s in enumerate(ss):
    82	                s.update(component=_region(ink,[c],cuts[j],cuts[j+1]), component_ids=[c.index], indices=[k],
    83	                         fused=True, fusion_size=len(ss), region_bounds=[cuts[j],cuts[j+1]],
    84	                         segmentation_source='font_ctc_split' if c.w>1.3*width else 'ctc_shared_narrow',
    85	                         expected_width=width, segmentation_uncertain=c.w<=1.3*width)
    86	        else:
    87	            s = ss[0]; members=[k]; a,b=s['locator_span']
    88	            extra=[j for j in (k-1,k+1) if 0<=j<len(letters) and j not in claimed
    89	                   and I._overlap(a,b,letters[j].x0,letters[j].x1)>0]
    90	            # S4 union: disconnected strokes under one character are retained.
    91	            if len(extra)==1 and c.w<1.3*expected_width(ink,s['base']):
    92	                j=extra[0]
    93	                if max(c.x1,letters[j].x1)-min(c.x0,letters[j].x0)<=1.6*ink.xh:
    94	                    members.append(j);claimed.add(j)
    95	            cs=[letters[j] for j in members]
    96	            left,right=min(q.x0 for q in cs),max(q.x1 for q in cs)
