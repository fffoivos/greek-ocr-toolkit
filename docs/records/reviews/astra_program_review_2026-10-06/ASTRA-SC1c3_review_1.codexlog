   120	
   121	def edit_guard(original, proposal):
   122	    """Return rejection reasons; unchanged unsupported characters are preserved.
   123	
   124	    Greek bases and legal mark multiplicities are the only editable letters.
   125	    Non-Greek clusters and unsupported Greek clusters must remain identical.
   126	    Canonical equivalence alone is never a reason to rewrite source bytes.
   127	    """
   128	    a=[c for c in clusters(nfd(original)) if (c.base.isalpha() and c.base not in ELISION) or ud.combining(c.base)]
   129	    b=[c for c in clusters(nfd(proposal)) if (c.base.isalpha() and c.base not in ELISION) or ud.combining(c.base)]
   130	    reasons=[]
   131	    # Preserve the raw spelling of out-of-domain clusters, including decomposed
   132	    # Latin accents. NFC equivalence does not authorize rewriting those bytes.
   133	    raw_a=[c for c in clusters(original) if c.base.isalpha() and c.base not in ELISION]
   134	    raw_b=[c for c in clusters(proposal) if c.base.isalpha() and c.base not in ELISION]
   135	    if len(raw_a)==len(raw_b):
   136	        for i,(x,y) in enumerate(zip(raw_a,raw_b)):
   137	            decoded=clusters(nfd(x.base+x.marks))[0]
   138	            if (decoded.base not in GREEK_LETTERS or not _supported(decoded)) and x.base+x.marks!=y.base+y.marks:
   139	                reasons.append(f'edit_guard:unsupported_raw_character:{i}')
   140	    if len(a)!=len(b) or [c.base for c in a]!=[c.base for c in b]:
   141	        reasons.append('edit_guard:base_or_character_mismatch')
   142	    else:
   143	        for i,(x,y) in enumerate(zip(a,b)):
   144	            if (not _supported(x) or not _supported(y) or x.base not in GREEK_LETTERS) and (x.base+x.marks!=y.base+y.marks):
   145	                reasons.append(f'edit_guard:unsupported_character:{i}')
   146	    if _punctuation(original)!=_punctuation(proposal):reasons.append('edit_guard:punctuation_mismatch')
   147	    return reasons
   148	
   149	
   150	def _reader_reasons(slot, prediction, coverage, prefix):
   151	    reasons=[]
   152	    if prediction is None:reasons.append(prefix+'_missing')
   153	    elif not ('parts' in prediction or 'cls' in prediction):reasons.append(prefix+'_prediction_invalid')
   154	    if prediction and prediction.get('base',slot['base'])!=slot['base']:reasons.append(prefix+'_base_mismatch')
   155	    if coverage is None:reasons.append(prefix+'_missing_coverage')
   156	    else:
   157	        if coverage.get('base',slot['base'])!=slot['base']:reasons.append(prefix+'_coverage_base_mismatch')
   158	        if coverage.get('scored') is not True:reasons.append(prefix+'_unscored:'+str(coverage.get('reason')))
   159	        if coverage.get('evidence_state') in (None,'UNKNOWN'):reasons.append(prefix+'_evidence_UNKNOWN')
   160	        if not isinstance(coverage.get('uncertainty'),(list,tuple)):
   161	            reasons.append(prefix+'_uncertainty_not_recorded')
   162	        else:reasons.extend(prefix+'_uncertainty:'+str(z) for z in coverage['uncertainty'])
   163	    if prediction is not None:
   164	        if prediction.get('evidence_state')=='UNKNOWN':reasons.append(prefix+'_evidence_UNKNOWN')
   165	        reasons.extend(prefix+'_uncertainty:'+str(z) for z in (prediction.get('uncertainty') or ()))
   166	        parts=prediction.get('parts',prediction.get('cls','none').split('+'))
   167	        if any(p not in R.MARKS and p!='none' for p in parts):reasons.append(prefix+'_unsupported_mark')
   168	    return reasons
   169	
   170	
   171	def zone_relevance(slot, signal_parts=()):
   172	    """Relevance from saved local detector geometry, never from a new fit.
   173	
   174	    The upper observation extent is the existing .9 xh contract; capital
   175	    preposed marks use capital_left_marks' .35 xh upper extent. Coordinates
   176	    are crop-local. Rounded/missing/invalid geometry cannot prove clearance.
   177	    Explicit UNKNOWN/UNSEEN observations remain separate vetoes.
   178	    """
   179	    base=slot['base'].lower()
   180	    ev=slot.get('evidence',{})
   181	    ev=ev.to_record() if hasattr(ev,'to_record') else ev
   182	    capital=slot['base'].isupper() or ev.get('case_class',slot.get('case_class'))=='capital'
   183	    bearing=base in 'αεηιουωρ'
   184	    upper_cut=bearing
   185	    top_extent=None
   186	    if bearing:
   187	        try:
   188	            mean=float(ev['meanline']);xh=float(ev['xh'])
   189	            if math.isfinite(mean) and math.isfinite(xh) and xh>0:
   190	                top_extent=mean-(.35 if capital else .9)*xh
   191	                # meanline is saved to .1 px, xh to .01 px.
   192	                upper_cut=top_extent<=.06
   193	        except (KeyError,TypeError,ValueError):pass
   194	    return dict(above=bearing,top_cut=upper_cut,upper_zone_top=top_extent,
   195	        below=base in 'αηω' or bool(slot.get('iota_adscript')) or 'subscript' in signal_parts,
   196	        left=bearing and capital,right=slot.get('word_final',False) or slot.get('apostrophe',False))
   197	
   198	
   199	def _flag_relevant(flag, relevance):
   200	    """Only known observation predicates can lose a veto; unknown flags hold."""
   201	    if flag.get('rule','observation')!='observation':return True
   202	    reason=flag.get('reason','')
   203	    key={'clipped_top':'top_cut','detector_clipped_top':'top_cut',
   204	         'clipped_bottom':'below','detector_clipped_bottom':'below',
   205	         'unseen_above':'above','crop_UNSEEN:above':'above',
   206	         'unseen_below':'below','crop_UNSEEN:below':'below'}.get(reason)
   207	    return relevance[key] if key else True
   208	
   209	
   210	def _flag_targets(flag, start):
   211	    return (flag.get('start')==start or any(a.get('start')==start for a in flag.get('alternatives',()))
   212	            or ('start' not in flag and not flag.get('alternatives')))
   213	
   214	
   215	def decide(slot, prediction, coverage, mode, *, flagged=False, peer_prediction=None, peer_coverage=None, signal_parts=()):
   216	    mode=mode.upper()
   217	    if mode not in MODES:raise ValueError('unknown release mode: '+mode)
   218	    ev=slot.get('evidence',{})
   219	    ev=ev.to_record() if hasattr(ev,'to_record') else ev
   220	    det=list(slot.get('parts',()))
   221	    rp=None if prediction is None else list(prediction.get('parts',prediction.get('cls','none').split('+')))
   222	    if rp==['none']:rp=[]
   223	    reasons=[]
   224	    for key in ('localisation_unknown','segmentation_uncertain'):
   225	        if slot.get(key):reasons.append('detector_'+key)
   226	    if slot.get('physical_resolved') is False or slot.get('ambiguity'):
   227	        reasons.append('detector_physical_unresolved')
   228	    if slot.get('unnamed'):reasons.append('detector_unnamed_mark')
   229	    peer_parts=[] if peer_prediction is None else peer_prediction.get('parts',peer_prediction.get('cls','none').split('+'))
   230	    relevant=zone_relevance(slot,[*det,*(rp or []),*peer_parts,*signal_parts])
   231	    reasons.extend('crop_UNSEEN:'+z for z in slot.get('unseen_zones',()) if relevant.get(z,True))
   232	    for zone,direction in [('above','top'),('below','bottom'),('left','left'),('right','right')]:
   233	        if relevant['top_cut' if direction=='top' else zone] and ev.get('clipped_'+direction):reasons.append('detector_clipped_'+direction)
   234	        if relevant[zone] and ev.get('observation',{}).get(zone) in ('UNSEEN','UNKNOWN'):
   235	            reasons.append('crop_UNSEEN:'+zone)
   236	    if slot['base'] in R1_LETTERS:
   237	        reasons.extend(_reader_reasons(slot,prediction,coverage,'r1'))
   238	        if mode.startswith('ENSEMBLE_'):
   239	            peer='r1_'+mode[-1]
   240	            reasons.extend(_reader_reasons(slot,peer_prediction,peer_coverage,peer))
   241	            pp=None if peer_prediction is None else peer_prediction.get('parts',peer_prediction.get('cls','none').split('+'))
   242	            if pp==['none']:pp=[]
   243	            if prediction is not None and peer_prediction is not None and set(rp)!=set(pp):
   244	                reasons.append(mode.lower()+'_mark_set_disagreement')
   245	        if prediction is not None:
   246	            if mode in ('PRESENCE','FULL') and (kinds(det)!=kinds(rp) if mode=='PRESENCE' else set(det)!=set(rp)):
   247	                reasons.append('mark_kind_disagreement' if mode=='PRESENCE' else 'mark_set_disagreement')
   248	    elif (det and not mode.startswith('ENSEMBLE_')) or slot.get('unnamed'):reasons.append('r1_unsupported_letter')
   249	    active_flags=[f for f in slot.get('constraint_flags',()) if _flag_relevant(f,relevant)]
   250	    if flagged or active_flags:reasons.append('K1:flag')
   251	    if slot.get('hold'):
   252	        old=slot.get('hold_reasons')
   253	        # A saved K1-only HOLD must not resurrect a now-irrelevant flag.
   254	        if old:
   255	            for reason in old:
   256	                predicate=reason.removeprefix('K1:observation:')
