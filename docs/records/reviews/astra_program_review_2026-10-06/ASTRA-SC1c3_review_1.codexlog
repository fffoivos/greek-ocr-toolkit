   234	        next_core = ''.join(slots[i]['base'] for i in next_ids) if next_ids else None
   235	        refs = [(i,k) for i in ids for k,p in enumerate(slots[i]['parts']) if p in _ACCENT_PARTS]
   236	        final_accent = any(syl_of.get(ids.index(i)) == len(syl)-1 for i,k in refs)
   237	        enclitic = next_core is None or C.lexicon_key(next_core) in C.ENCLITICS
   238	        if len(refs) > 1 and not (len(refs) == 2 and final_accent and enclitic):
   239	            while len(refs) > 1:
   240	                before = sum(len(slots[i]['parts']) for i in ids)
   241	                drop('C3:two_accents',refs,True)
   242	                if sum(len(slots[i]['parts']) for i in ids) == before: break
   243	                refs = [(i,k) for i in ids for k,p in enumerate(slots[i]['parts']) if p in _ACCENT_PARTS]
   244	        for j,i in enumerate(ids):
   245	            for k in reversed(range(len(slots[i]['parts']))):
   246	                part = slots[i]['parts'][k]; sy = syl_of.get(j)
   247	                if sy is None: continue
   248	                from_end = len(syl)-1-sy
   249	                rule = None
   250	                if part == 'grave' and from_end != 0: rule = 'C4:grave_not_final'
   251	                elif part == 'circumflex':
   252	                    if from_end > 1: rule = 'C4:circumflex_before_penult'
   253	                    elif len(syl[sy]) != 2 and cls[j].base.lower() not in C.LONG_CAPABLE and 'subscript' not in slots[i]['parts']:
   254	                        rule = 'C4:circumflex_on_short_vowel'
