    26	def decision_record(runtime):
    27	    """Comparable policy outcomes; probabilities are not acceptance thresholds."""
    28	    return {m:dict(text=(r:=compose_runtime(runtime,m))['text'],hold_slots=r['hold_slots'],
    29	        slots=[{k:s.get(k) for k in ('start','base','parts','label_status','hold_reasons','apostrophe')} for s in r['slots']]) for m in MODES}
