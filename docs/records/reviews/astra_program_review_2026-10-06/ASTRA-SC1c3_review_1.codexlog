    12	def main():
    13	    ap=argparse.ArgumentParser(description=__doc__)
    14	    ap.add_argument('runtime');ap.add_argument('--mode',choices=MODES,default='PRESENCE')
    15	    ap.add_argument('--flags',help='JSONL line id and constraint_flags')
    16	    a=ap.parse_args();flags={}
