    22	class ReadingConfiguration(dict):
    23	    """Configuration verified against checkout, assets and explicit output policy."""
    24	
    25	
    26	def load_configuration(path):
    27	    c=json.loads(Path(path).read_text())
    28	    if c.get('schema')!='sf1-reading-v1':raise ValueError('explicit sf1-reading-v1 configuration required')
    29	    head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()
    30	    if c['detector_commit']!=head:raise ValueError('detector commit differs from checkout')
    31	    if c['source_sha256']!={p:digest(ROOT/p) for p in SOURCES}:raise ValueError('detector source hash mismatch')
    32	    for name,default in [('shape_model',DEFAULT_SHAPE),('case_model','docs/labelfix/case_model_S5.json')]:
    33	        asset=c[name];asset.setdefault('path',default)
    34	        if digest(ROOT/asset['path'])!=asset['sha256']:raise ValueError(name+' hash mismatch')
    35	    if c['constraint_policy']!=policy(c['constraint_policy']['output']):raise ValueError('constraint policy hash mismatch')
    36	    if c['constraint_policy']['output'] not in ('print','normalised'):raise ValueError('unknown output policy')
    37	    if 'r1_checkpoint' not in c:raise ValueError('r1_checkpoint must be explicit (null for detector-only)')
    38	    if c['r1_checkpoint'] is not None:
    39	        ck=c['r1_checkpoint']
    40	        if digest(ROOT/ck['path'])!=ck['sha256']:raise ValueError('R1 checkpoint hash mismatch')
    41	    case.configure_model(ROOT/c['case_model']['path'])
    42	    return ReadingConfiguration(c)
