     1	"""NFD text utilities for label correction: tokens, vowel clusters, diff classes, guards.
     2	
     3	Everything here works on NFD codepoints (codec v1 contract). Combining marks that the
     4	rules reason about:
     5	
     6	    breathing   U+0313 psili, U+0314 dasia
     7	    accent      U+0301 oxia/tonos, U+0300 varia, U+0342 perispomeni
     8	    subscript   U+0345 ypogegrammeni
     9	    dialytika   U+0308
    10	    other       U+0304 macron, U+0306 vrachy (never corrected; a change there is "other")
    11	"""
    12	from __future__ import annotations
    13	
    14	from dataclasses import dataclass, field
    15	import unicodedata as ud
    16	
    17	BREATHINGS = frozenset('̓̔')
    18	ACCENTS = frozenset('́̀͂')
    19	SUBSCRIPT = frozenset('ͅ')
    20	DIALYTIKA = frozenset('̈')
    21	OTHER_MARKS = frozenset('̄̆')
    22	MARKS = BREATHINGS | ACCENTS | SUBSCRIPT | DIALYTIKA | OTHER_MARKS
    23	
    24	ACUTE, GRAVE, CIRCUMFLEX = '́', '̀', '͂'
    25	
    26	GREEK_LOWER = 'αβγδεζηθικλμνξοπρσςτυφχψω'
    27	GREEK_UPPER = 'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ'
    28	GREEK_LETTERS = frozenset(GREEK_LOWER + GREEK_UPPER + 'ϛϙϡϝϟϲϹ')
    29	VOWELS = frozenset('αεηιουωΑΕΗΙΟΥΩ')
    30	MARK_BEARERS = VOWELS | frozenset('ρΡ')   # rho carries a breathing
    31	
    32	# Base-letter confusions the owner allows (unordered pairs; sigma/final sigma handled by position).
    33	CONFUSIONS = frozenset({frozenset(p) for p in ('ει', 'οα', 'οσ', 'νυ', 'πτ', 'ρο', 'ιυ', '0ο')})
    34	SIGMA_PAIR = frozenset('σς')
    35	
    36	PUNCT_EDGE = '.,;:·!?"\'«»()[]{}—–-‐‑*†‡§¶"“”‘’…/\\|'
    37	HYPHENS = ('-', '‐', '‑')
    38	
    39	
    40	def nfd(s: str) -> str:
    41	    return ud.normalize('NFD', s)
    42	
    43	
    44	def nfc(s: str) -> str:
    45	    return ud.normalize('NFC', s)
    46	
    47	
    48	def is_mark(c: str) -> bool:
    49	    return c in MARKS or ud.combining(c) != 0
    50	
    51	
    52	def strip_marks(s: str) -> str:
    53	    return ''.join(c for c in s if not is_mark(c))
    54	
    55	
    56	def mark_category(c: str) -> str:
    57	    if c in BREATHINGS:
    58	        return 'breathing'
    59	    if c in ACCENTS:
    60	        return 'accent'
    61	    if c in SUBSCRIPT:
    62	        return 'subscript'
    63	    if c in DIALYTIKA:
    64	        return 'dialytika'
    65	    return 'other'
    66	
