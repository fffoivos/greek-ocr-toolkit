   165	
   290	    hits = []
   291	    for c in ink.components:
   292	        if c.role != 'letter':
   293	            continue
   294	        ov = _overlap(bx0, bx1, c.x0, c.x1)
   295	        overlaps.append(ov)
   296	        if ov > 0:
   297	            hits.append(c)
   298	        if ov > best_ov:
   299	            best, best_ov = c, ov
   300	    if best is None or best_ov <= 0:
   301	        return bx0 - 0.1 * xh, bx1 + 0.4 * xh, 'ctc', 0
