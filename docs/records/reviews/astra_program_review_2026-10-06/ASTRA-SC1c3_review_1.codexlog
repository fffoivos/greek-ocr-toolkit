   482	def capital_left_marks(ink, body):
   483	    """Detached upper-left ink bounded by the preceding letter's right edge.
   484	
   485	    This never reaches into the preceding word's last letter. Geometry only:
   486	    naming the breathing/accent remains the mark classifier's responsibility.
   487	    """
   488	    xh = ink.xh
   489	    left = max((c.x1 for c in ink.components if c.role == 'letter'
   490	                and c.x1 <= body.x0 and c.index != body.index), default=0)
   491	    out = []
   492	    for c in ink.components:
   493	        if c.role not in ('mark','punct','fragment') or not (left <= c.x0 and c.x1 <= body.x0):
   494	            continue
   495	        if not (body.y0-.35*xh <= c.y0 and c.y1 <= body.y0+.6*body.h
   496	                and .1*xh <= c.h <= .9*xh and c.w <= 1.2*xh):
   497	            continue
   498	        b = _blob(component_mask(ink,c),c.y0,c.x0,'preposed',ink)
   499	        guides = getattr(ink, 'shared_guides', None)
   500	        if guides is not None:
   501	            b = zone_blob(ink, b, lower=guides.ascender-.35*xh, upper=guides.mean)
   502	            if b is None:
   503	                continue
   504	        if b.area >= MIN_BLOB_AREA and not b.faint and not b.touches_border:
   505	            out.append(b)
   506	    # Marks form a compact group next to the capital. A distant opening quote
   507	    # or preceding word's overhang must not join that group across whitespace.
   508	    group = []
   509	    right = body.x0
   510	    for b in sorted(out, key=lambda b: b.x1, reverse=True):
   511	        if right-b.x1 > (.65*xh if not group else .25*xh):
   512	            break
   513	        group.append(b)
   514	        right = b.x0
   515	    return sorted(group, key=lambda b: b.x0)
