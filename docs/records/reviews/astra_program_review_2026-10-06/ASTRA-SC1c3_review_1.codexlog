   343	def compose_runtime(runtime, mode, k1_flags=()):
   344	    """Saved evidence adapter. All readers use the same receipt-bound windows.
   345	
   346	    A peer's coverage is explicit; callers must bind it to that extraction.
   347	    Missing peer predictions/coverage always abstain.
   348	    """
   349	    peer=mode[-1].upper() if mode.upper().startswith('ENSEMBLE_') else None
   350	    signals={}
   351	    for records in runtime.get('peer_predictions',{}).values():
   352	        for p in records:signals.setdefault(p['start'],[]).extend(p.get('parts',p.get('cls','none').split('+')))
   353	    return compose(runtime.get('recogniser_nfd',runtime['recogniser_text']),runtime['detector'],
   354	        prediction_index(runtime['r1_predictions']),runtime['coverage'],mode,k1_flags,
   355	        peer_predictions=prediction_index(runtime.get('peer_predictions',{}).get(peer,[])),
   356	        peer_coverage=runtime.get('peer_coverage',{}).get(peer),signal_parts=signals)
     1	"""SF2 L1r overlay/release consumer, derived from historical L1-v0 format."""
     2	from __future__ import annotations
     3	
     4	from collections import Counter
     5	from difflib import SequenceMatcher
     6	import hashlib
     7	import json
     8	from pathlib import Path
     9	import unicodedata
