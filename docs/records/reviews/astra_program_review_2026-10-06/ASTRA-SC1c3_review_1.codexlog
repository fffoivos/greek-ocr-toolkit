     1	"""L1E held-out metadata-only R1 frozen-slot instrument; no pixel/model work.
     2	
     3	Full 666-line scoring is run on Clariden, not the Mac. Export <=200 verification
     4	lines for the identical l1e_run entry point. Truth never enters the reader.
     5	"""
     6	from __future__ import annotations
     7	import argparse
     8	from collections import Counter,defaultdict
     9	from copy import deepcopy
    10	import json
    11	from pathlib import Path
    12	import time
    13	import numpy as np
    14	from greekocr.labelfix.candidates import pair_tokens
    15	from greekocr.labelfix.text import nfd,clusters,strip_marks
    16	from greekocr.labelfix.reading import LineReading,MARKS
    17	from greekocr.labelfix.linemetric import mark_set
    18	from greekocr.labelfix.release_gate import MODES,serialize,compose_runtime,edit_guard,policy_binding
    19	from scripts.labelfix.clariden.r1_common import rows,sha256,write_json,write_rows
    20	from scripts.labelfix.clariden.l1e_run import decision_record
    21	
    22	KINDS={p:'breathing' if p in ('psili','dasia') else 'accent' if p in ('acute','grave','circumflex') else p for p in MARKS}
    23	
    24	
    25	def recover_observation(meta,crop_root):
    26	    """Recover SF2's exact predicates from saved measurements and PNG headers.
    27	
    28	    No pixels are decoded. Missing font evidence is never defaulted to clean.
    29	    """
    30	    from PIL import Image
    31	    from scripts.labelfix.clariden.r1_common import crop_path
    32	    receipts={}
    33	    for lid,row in meta.items():
    34	        if all('evidence_state' in c and 'uncertainty' in c for c in row['coverage']):continue
    35	        path=crop_path(row['crop'],crop_root,'e3')
    36	        with Image.open(path) as image:width,height=image.size
    37	        measurements=row.get('font_size',{}).get('pixel_measurements')
    38	        if measurements is None:raise ValueError('cannot recover observation without pixel measurements: '+lid)
    39	        for c in row['coverage']:
    40	            uncertainty=[]
    41	            if measurements==0:uncertainty.append('no_pixel_evidence')
    42	            if c['span'][0]<0 or c['span'][1]>width:uncertainty.append('out_of_image_span')
    43	            c.setdefault('uncertainty',uncertainty)
    44	            c.setdefault('evidence_state','UNKNOWN' if uncertainty else 'unadjudicated')
    45	        receipts[lid]=dict(crop=str(path),crop_sha256=sha256(path),width=width,height=height,pixel_measurements=measurements)
    46	    return receipts
    47	
    48	
    49	def atomic(marks):
    50	    # R1 error-type instrument: split compound truth; punctuation is separate.
    51	    return {(KINDS.get(p,k),p) for k,name in marks if k!='apostrophe' for p in (name.split('+') if k=='compound' else [name])}
    52	
    53	
    54	def google_marks(google,rec):
    55	    # Same word/base pairing as r1_error_types.google_marks.
    56	    names={v:(KINDS[k],k) for k,v in MARKS.items()};out={}
    57	    for g,m in pair_tokens(google,rec):
    58	        if m is None or strip_marks(nfd(g.core))!=strip_marks(nfd(m.core)):continue
    59	        for a,b in zip(clusters(nfd(g.core)),clusters(nfd(m.core))):
    60	            out[m.core_start+b.start]={names[x] for x in a.marks if x in names}
    61	    return out
    62	
    63	
    64	def saved_runtime(line,meta,predictions):
    65	    raw=LineReading(line['reading'],deepcopy(line['recogniser_slots']),[],
    66	        opening_quotes=deepcopy(line.get('opening_quotes',[])),constraint_flags=deepcopy(line.get('reading_flags',[])))
    67	    if meta['recogniser_text']!=line['recogniser_text']:raise ValueError('recogniser identity mismatch')
    68	    return dict(id=line['line_id'],recogniser_text=line['recogniser_text'],recogniser_nfd=line['recogniser_text'],
    69	        detector=serialize(raw),coverage=meta['coverage'],font_size=meta['font_size'],r1_predictions=predictions['A'],
    70	        peer_predictions={a:predictions[a] for a in ('B','E')},peer_coverage={a:meta['coverage'] for a in ('B','E')})
    71	
    72	
    73	def score_line(line,google,runtime):
    74	    gm=google_marks(google,nfd(line['recogniser_text']));stats={};details={}
    75	    owners=defaultdict(list)
    76	    for s in line['recogniser_slots']:
    77	        if s.get('component_slot') is not None:owners[s['component_slot']].append(s['start'])
    78	    primary={p['start']:p for p in runtime['r1_predictions']}
    79	    gclusters={c.start:c for c in clusters(nfd(line['recogniser_text']))}
    80	    for mode in MODES:
    81	        rd=compose_runtime(runtime,mode);by={s['start']:s for s in rd['slots']}
    82	        c=Counter(corrected=0,wrong=0,missed=0,HOLD=0,new=0,google_errors=0,known=0,unknown=0,kept=0)
    83	        events=[]
    84	        for slot in line['slots']:
    85	            matches=owners.get(slot['slot'],[])
    86	            if len(matches)!=1:continue
    87	            start=matches[0]
    88	            # Exact R1 RESULT domain: a mapped scored A slot with paired Google.
    89	            if start not in gm or start not in primary:continue
    90	            s=by[start];g=gm[start];r=atomic(mark_set('+'.join(s['parts']) or 'none'))
    91	            if slot['truth'] is None:c['unknown']+=1;continue
    92	            truth=atomic(slot['truth']);c['known']+=1
    93	            # Original-label supported-domain guard, in addition to the shared
    94	            # recogniser/composer guard. No unsupported Google edit is accepted.
    95	            original=slot['base']+''.join(MARKS[p] for _,p in sorted(g))
    96	            proposal=gclusters[start].base+''.join(MARKS[p] for p in s['parts'])
    97	            hold=bool(s['hold_reasons'] or edit_guard(original,proposal))
    98	            if g!=truth:
    99	                c['google_errors']+=1
   100	                outcome='HOLD' if hold else 'corrected' if r==truth else 'missed' if r==g else 'wrong'
   101	            else:outcome='HOLD_control' if hold else 'new' if r!=truth else 'kept'
   102	            c[outcome]+=1
   103	            if g!=truth or outcome=='new':
   104	                events.append(dict(slot=slot['slot'],start=start,google=sorted(g),truth=sorted(truth),reader=sorted(r),
   105	                    outcome=outcome,reasons=s['hold_reasons']))
   106	        c['lines']=1;c['lines_held']=bool(rd['hold_slots']);stats[mode]=dict(c);details[mode]=events
   107	    return stats,details
   108	
   109	
   110	def measure(detector,frozen_path,extraction,runs,google_path,out,crop_root,mock_lines=64):
   111	    from scripts.labelfix.clariden.r1_score import metadata,prediction_map
   112	    started=time.monotonic();out=Path(out);out.mkdir(parents=True,exist_ok=False)
