    36	
    37	def render_reading(text, slots):
    38	    """Replace every combining mark, preserving base characters and punctuation."""
    39	    by={s['start']:s for s in slots}
    40	    out=[]
    41	    for cl in clusters(nfd(text)):
    42	        if cl.base in ELISION:
    43	            continue
    44	        s=by.get(cl.start)
    45	        if s is None:
    46	            out.append(cl.base)
    47	        else:
    48	            out.append(cl.base+''.join(MARKS[p] for p in s.get('parts',()) if p in MARKS))
    49	            if s.get('apostrophe'):
    50	                out.append('’')
    51	    return nfc(''.join(out))
