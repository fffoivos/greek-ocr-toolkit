   119	def component_mask(ink,c):
   120	    """Exact region membership, including every parent of a virtual union."""
   121	    if getattr(c,'mask',None) is not None:
   122	        return c.mask
   123	    return np.isin(ink.labels[c.y0:c.y1,c.x0:c.x1],getattr(c,'component_ids',(c.index,)))
   124	
   125	
   126	def principal_axis(ys: np.ndarray, xs: np.ndarray) -> tuple[float, float]:
   127	    """(angle in degrees, elongation). Angle of the major axis vs the x axis in image coordinates."""
   128	    if len(xs) < 3:
   129	        return 0.0, 1.0
   130	    x = xs - xs.mean()
   131	    y = ys - ys.mean()
   132	    cxx, cyy, cxy = float((x * x).mean()), float((y * y).mean()), float((x * y).mean())
   133	    tr, det = cxx + cyy, cxx * cyy - cxy * cxy
   134	    disc = max(tr * tr / 4 - det, 0.0)
   135	    l1, l2 = tr / 2 + math.sqrt(disc), max(tr / 2 - math.sqrt(disc), 1e-6)
   136	    angle = 0.5 * math.degrees(math.atan2(2 * cxy, cxx - cyy))
   137	    return angle, math.sqrt(l1 / l2)
   138	
   139	
   140	@dataclass
   141	class CropInk:
   142	    """Per-crop analysis shared by all candidates of a line."""
   143	    gray: np.ndarray
   144	    ink: np.ndarray
   145	    labels: np.ndarray
   146	    xh: float
   147	    top: np.ndarray        # mean line per column
   148	    bottom: np.ndarray     # baseline per column
   149	    components: list
   150	    paper: float
   151	    width: int = 0
   152	    height: int = 0
   153	    ink_level: float = 0.0   # median gray of letter pixels
   154	    case_info: dict = field(default_factory=dict)
   155	    word_bands: dict = field(default_factory=dict)
   156	
   157	    @property
   158	    def faint_cut(self) -> float:
   159	        return self.paper - 0.45 * (self.paper - self.ink_level)
