   260	                reasons.append(reason)
   261	        elif not slot.get('constraint_flags') or active_flags:reasons.append('detector_hold')
   262	    reasons=list(dict.fromkeys(reasons))
   263	    return dict(action='HOLD' if reasons else 'ACCEPT' if slot['base'] in R1_LETTERS else 'KEEP',
   264	                reasons=reasons,detector_parts=det,r1_parts=rp)
   265	
