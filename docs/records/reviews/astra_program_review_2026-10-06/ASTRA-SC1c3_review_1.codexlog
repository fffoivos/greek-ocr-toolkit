    68	@dataclass(frozen=True)
    69	class Cluster:
    70	    """A base codepoint with its following combining marks; `start`/`end` index the NFD word core."""
    71	    base: str
    72	    marks: str
    73	    start: int
    74	    end: int
    75	
    76	    @property
    77	    def categories(self) -> frozenset:
    78	        return frozenset(mark_category(m) for m in self.marks)
    79	
    80	
    81	def clusters(core: str) -> list[Cluster]:
    82	    out: list[Cluster] = []
    83	    i = 0
    84	    n = len(core)
    85	    while i < n:
    86	        j = i + 1
    87	        while j < n and is_mark(core[j]):
    88	            j += 1
    89	        out.append(Cluster(core[i], core[i + 1:j], i, j))
    90	        i = j
    91	    return out
