   103	            # component is a quality flag, never a reason to suppress all marks.
   104	            a,b=s['locator_span']; mid=(a+b)/2; w=expected_width(ink,s['base'])
   105	            left=max(0,int(mid-w/2));right=min(ink.width,max(left+1,int(mid+w/2)))
   106	            top,bottom=ink.band(mid)
   107	            s.update(component=SimpleNamespace(index=-s['start']-1,x0=left,x1=right,y0=int(top),y1=int(bottom),cx=(left+right)/2,w=right-left,h=bottom-top,role='letter'),
   108	                     region_bounds=[left,right],localisation_unknown=True,segmentation_uncertain=True,segmentation_source='font_ctc_fallback')
   109	    return slots

