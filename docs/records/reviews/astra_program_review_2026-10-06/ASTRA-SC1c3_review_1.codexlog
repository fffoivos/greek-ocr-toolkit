   117	def infer_line(identifier, image, alignment, detector_model, reader_model, *, script_class=None):
   118	    """Reference-free boundary: no Google label, verdict or printed pair accepted."""
   119	    from greekocr.labelfix.toolkit_geometry import polytonic_scope
   120	    if not polytonic_scope(script_class):
   121	        return dict(id=identifier,status='skipped',skip_reason='monotonic_scope')
   122	    text = alignment.prediction
   123	    record = dict(id=identifier, recogniser_text=text, _line=0)
   124	    ss, wide, _, losses, coverage, size = extract_line(record, alignment.to_record(), image, evaluation=True)
   125	    pred = reader_predictions(reader_model, ss, wide)
   126	    raw = reading.read_ink(ink.analyse(image), text, alignment, detector_model, filtered=False)
   127	    return dict(id=identifier, status='ok', recogniser_text=nfc(text), recogniser_nfd=text,
   128	        recognition_confidence=alignment.confidence, detector=serialize(raw),
   129	        r1_predictions=list(pred.values()), coverage=coverage, font_size=size, extraction_counts=dict(losses),
   130	        modes={mode: combine(text, raw, pred, coverage, mode) for mode in ('PRESENCE', 'FULL')})
