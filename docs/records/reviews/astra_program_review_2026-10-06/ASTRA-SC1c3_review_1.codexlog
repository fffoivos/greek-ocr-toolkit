   135	def main():
   136	    ap=argparse.ArgumentParser(description=__doc__)
   137	    ap.add_argument('--config',type=Path,required=True);ap.add_argument('--out',type=Path,required=True);ap.add_argument('--mock',action='store_true')
   138	    a=ap.parse_args();run(a.config,a.out,mock=a.mock)
