+        localisation_unknown=False,segmentation_uncertain=False,word_final=False,
+        evidence=dict(clipped_top=False,clipped_bottom=False)))
+    result = compose_runtime(r,'ENSEMBLE_AB')
+    assert result['text'] == 'δ’'

