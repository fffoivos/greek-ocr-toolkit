    75	def _supported(c):
    76	    if c.base not in GREEK_LETTERS:return not c.marks
    77	    if any(m not in R.MARKS.values() for m in c.marks):return False
    78	    counts=Counter(kinds([p]).pop() for m in c.marks for p,v in R.MARKS.items() if v==m)
    79	    if any(n>1 for n in counts.values()):return False
    80	    if counts['breathing'] and counts['dialytika']:return False
    81	    if c.marks and c.base not in R1_LETTERS:return False
    82	    if counts['dialytika'] and c.base.lower() not in 'ιυ':return False
    83	    if counts['subscript'] and c.base.lower() not in 'αηω':return False
    84	    if c.base.lower()=='ρ' and any(k!='breathing' for k in counts):return False
    85	    return True
