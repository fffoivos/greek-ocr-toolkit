   185	        google_only=len(g.keys()-r.keys()),recogniser_only=len(r.keys()-g.keys()),
   186	        both_kept=len(consensus&final.keys()),both_deleted=len(consensus-final.keys()),
   187	        google_only_kept=len((g.keys()-r.keys())&final.keys()),
   188	        google_only_deleted=len((g.keys()-r.keys())-final.keys()),
   189	        recogniser_only_kept=len((r.keys()-g.keys())&final.keys()),
   190	        recogniser_only_deleted=len((r.keys()-g.keys())-final.keys()),
   191	        added=len(final.keys()-g.keys()),spacing_breathings=len(breathings),
   192	        spacing_breathings_attached=len(attached))
   193	    return text,census
