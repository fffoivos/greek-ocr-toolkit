   212	            decoded=clusters(nfd(x.base+x.marks))[0]
   213	            if (decoded.base not in GREEK_LETTERS or not _supported(decoded)) and x.base+x.marks!=y.base+y.marks:
   214	                reasons.append(f'edit_guard:unsupported_raw_character:{i}')
   215	    if len(a)!=len(b) or [c.base for c in a]!=[c.base for c in b]:
   216	        reasons.append('edit_guard:base_or_character_mismatch')
   217	    else:
   218	        for i,(x,y) in enumerate(zip(a,b)):
   219	            if (not _supported(x) or not _supported(y) or x.base not in GREEK_LETTERS) and (x.base+x.marks!=y.base+y.marks):
   220	                reasons.append(f'edit_guard:unsupported_character:{i}')
   221	    punct_a,punct_b=_breathing_pair(original,proposal)
   222	    if _punctuation(punct_a)!=_punctuation(punct_b):reasons.append('edit_guard:punctuation_mismatch')
   223	    return reasons
