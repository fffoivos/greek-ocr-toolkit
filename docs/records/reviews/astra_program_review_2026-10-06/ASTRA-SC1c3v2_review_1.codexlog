     1	"""SF5 offline release replay. Saved evidence only; no inference or network.
     2	
     3	The 56 witnesses use the saved AB runtime fields. The 666 instrument retains
     4	its complete saved SF4 slot decisions (full extraction coverage is unavailable)
     5	and replays only the release text rules. M2 is filtered to the DEV allowlist
     6	before decoding cached records. No locked (ii) record is evaluated.
     7	"""
     8	from __future__ import annotations
     9	
    10	import argparse
    11	from collections import Counter
    12	from copy import deepcopy
    13	import importlib.util
    14	import json
    15	from pathlib import Path
    16	import re
