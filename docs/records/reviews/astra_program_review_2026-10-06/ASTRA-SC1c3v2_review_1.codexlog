def m2_dev(out):
    from scripts.labelfix.sf3_measure import dev_inventory,dev_runtime
    from scripts.labelfix import m2_score as score
    oldgate,_=baseline();score.MODES=gate.MODES
    manifest=DOC/'SF3_evidence/m2_dev_manifest.jsonl'
    inv=dev_inventory(manifest);allowed={r['id'] for r in inv}
    assert len(inv)==273
    assert all(r['human'] is None for r in rows(manifest))
    line_ids={r['line_id'] for r in inv};certified_dev=[]
    punct=DOC/'R0_evidence/scoring/punctuation_sites.jsonl'
    with punct.open() as f:
        for line in f:
            match=re.search(r'"line_id":\s*("(?:[^"\\]|\\.)*")',line)
            if match and json.loads(match[1]) in line_ids:certified_dev.append(json.loads(line))
    assert not certified_dev, 'New DEV punctuation truth exists; use it instead of UNKNOWN'
    cache=Path('.cache/labelfix/m2/runtime.jsonl')
    runs=dev_runtime(cache,allowed);by={r['id']:r for r in inv}
    ledger=score.pair_ledger(inv);result={};proof=[];outputs=[]
    for phase,policy in [('before',oldgate),('after',gate)]:
        runtime={}
        for r in runs:
            r=deepcopy(r);r['modes']={m:policy.compose_runtime(r,m) for m in gate.MODES};runtime[r['id']]=r
            outputs.append(dict(phase=phase,id=r['id'],modes=r['modes']))
        pairs=[score.score_case(c,by[c['id']],runtime[c['id']]) for c in ledger if c['included']]
        lines=[];census={m:Counter() for m in gate.MODES};release_counts={m:Counter() for m in gate.MODES}
        for line in inv:
            r=runtime[line['id']];changes,cov=score.changes_for(line,r)
            lines.append(dict(**line,**{k:v for k,v in r.items() if k!='id'},changes=changes,
                reference_change_alignment_coverage=cov))
            for mode in gate.MODES:
                label=effective_label(policy,line['google_label'],r['recogniser_text'],r['modes'][mode],sf5=phase=='after')
                release_counts[mode][label['status']]+=1
                release_counts[mode]['alias_only']+=label['alias_only']
                census[mode].update({k:v for k,v in label['elision_census'].items() if k!='aligned'})
        metrics=score.summarize(inv,runtime,pairs,lines)
        result[phase]=dict(marks=metrics['POOLED'],release_counts={m:dict(c) for m,c in release_counts.items()},
            elision_census={m:dict(c) for m,c in census.items()},
            elision={m:dict(kept=None,deleted=None,added=None,positive_sites=0,negative_sites=0,
                truth_source='UNKNOWN: DEV manifest human=null; R0b punctuation adjudications cover locked (ii), not DEV') for m in gate.MODES})
        if phase=='before':prior=runtime;prior_pairs=pairs
        else:
            assert pairs==prior_pairs
            for lid,r in runtime.items():
                for mode in gate.MODES:
                    a=prior[lid]['modes'][mode];b=r['modes'][mode]
                    assert a['slots']==b['slots'] and a['hold_slots']==b['hold_slots'],lid
                    proof.extend(dict(id=lid,mode=mode,start=s['start'],slot_identical=True) for s in b['slots'])
    assert result['before']['marks']==result['after']['marks']
    dest=out/'m2_dev';dest.mkdir(exist_ok=True)
    write_json(dest/'metrics.json',result);write_rows(dest/'decisions.jsonl.gz',outputs)
    write_rows(dest/'per_slot_proof.jsonl.gz',proof)
    write_json(dest/'receipt.json',dict(policy=gate.policy_binding(),complete=True,dev_lines=273,
        allowed_card_ids=sorted(allowed),locked_ii_records_decoded_or_composed=0,
        truth_positive_sites=0,truth_negative_sites=0,elision_truth_unknown=True,
        slot_mode_records_identical=len(proof),mark_rows_and_pair_events_identical=True,
        inputs={str(manifest):sha256(manifest),str(cache):sha256(cache),str(punct):sha256(punct)},
        detector_runs=0,r1_runs=0,ctc_runs=0,network=False,script_sha256=sha256(Path(__file__)),
        outputs={p.name:sha256(p) for p in dest.iterdir() if p.name!='receipt.json'}))
    return result


def main():
    p=argparse.ArgumentParser(description=__doc__)
"""NFD text utilities for label correction: tokens, vowel clusters, diff classes, guards.

Everything here works on NFD codepoints (codec v1 contract). Combining marks that the
rules reason about:

    breathing   U+0313 psili, U+0314 dasia
    accent      U+0301 oxia/tonos, U+0300 varia, U+0342 perispomeni
    subscript   U+0345 ypogegrammeni
    dialytika   U+0308
    other       U+0304 macron, U+0306 vrachy (never corrected; a change there is "other")
"""
from __future__ import annotations

from dataclasses import dataclass, field
import unicodedata as ud

BREATHINGS = frozenset('̓̔')
ACCENTS = frozenset('́̀͂')
SUBSCRIPT = frozenset('ͅ')
DIALYTIKA = frozenset('̈')
OTHER_MARKS = frozenset('̄̆')
MARKS = BREATHINGS | ACCENTS | SUBSCRIPT | DIALYTIKA | OTHER_MARKS

ACUTE, GRAVE, CIRCUMFLEX = '́', '̀', '͂'

GREEK_LOWER = 'αβγδεζηθικλμνξοπρσςτυφχψω'
GREEK_UPPER = 'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ'
GREEK_LETTERS = frozenset(GREEK_LOWER + GREEK_UPPER + 'ϛϙϡϝϟϲϹ')
VOWELS = frozenset('αεηιουωΑΕΗΙΟΥΩ')
MARK_BEARERS = VOWELS | frozenset('ρΡ')   # rho carries a breathing

# Base-letter confusions the owner allows (unordered pairs; sigma/final sigma handled by position).
CONFUSIONS = frozenset({frozenset(p) for p in ('ει', 'οα', 'οσ', 'νυ', 'πτ', 'ρο', 'ιυ', '0ο')})
SIGMA_PAIR = frozenset('σς')

ELISION = "'’ʼ᾽᾿"


def is_letter(base: str) -> bool:
    """Elision aliases are punctuation even when Unicode calls them letters."""
    return base.isalpha() and base not in ELISION


def word_final_elision(cs, i):
    return (cs[i].base in ELISION and not cs[i].marks and i > 0
            and is_letter(cs[i-1].base)
            and (i+1 == len(cs) or not is_letter(cs[i+1].base)))


def spacing_breathing(cs, i):
    """A spacing psili/koronis before a capital or word-initial vowel.

    Clusters keep any combining marks with their letter, so these predicates
    also work on decomposed text without treating a combining mark as a word.
    """
    return (cs[i].base in '᾿᾽' and not cs[i].marks and i+1 < len(cs)
            and is_letter(cs[i+1].base)
            and (cs[i+1].base.isupper() or
                 (cs[i+1].base in VOWELS and (i == 0 or not is_letter(cs[i-1].base)))))


def punctuation_sites(text, predicate=word_final_elision):
    """Map punctuation to its following letter boundary (aliases are one atom).

    Boundary N is after N letters, ignoring combining marks. Callers comparing
    lines must first establish the same letter sequence; offsets stay local.
    """
    cs=clusters(nfd(text));boundary=0;out={}
    for i,c in enumerate(cs):
        if is_letter(c.base):boundary+=1
        elif predicate(cs,i):out[boundary]=c
    return out


def elision_alias_key(text):
    """Comparison only. Prefix breathings and other quotes retain their bytes."""
    cs=clusters(nfd(text))
    return ''.join(('’' if word_final_elision(cs,i) else c.base)+c.marks for i,c in enumerate(cs))


PUNCT_EDGE = '.,;:·!?"\'«»()[]{}—–-‐‑*†‡§¶"“”‘’…/\\|'
PUNCT_EDGE += ELISION
HYPHENS = ('-', '‐', '‑')


def nfd(s: str) -> str:
    return ud.normalize('NFD', s)


def nfc(s: str) -> str:
    return ud.normalize('NFC', s)


def is_mark(c: str) -> bool:
    return c in MARKS or ud.combining(c) != 0


def strip_marks(s: str) -> str:
    return ''.join(c for c in s if not is_mark(c))


def mark_category(c: str) -> str:
    if c in BREATHINGS:
        return 'breathing'
    if c in ACCENTS:
        return 'accent'
    if c in SUBSCRIPT:
        return 'subscript'
    if c in DIALYTIKA:
        return 'dialytika'
        elif word_final_elision(cs,i) and boundary in g:
            out.append(g[boundary].base)
        else:out.append(c.base+c.marks)
    text=nfc(''.join(out));final=punctuation_sites(text)
    census=dict(aligned=True,google=len(g),recogniser=len(r),both=len(consensus),
        google_only=len(g.keys()-r.keys()),recogniser_only=len(r.keys()-g.keys()),
        both_kept=len(consensus&final.keys()),both_deleted=len(consensus-final.keys()),
        google_only_kept=len((g.keys()-r.keys())&final.keys()),
        google_only_deleted=len((g.keys()-r.keys())-final.keys()),
        recogniser_only_kept=len((r.keys()-g.keys())&final.keys()),
        recogniser_only_deleted=len((r.keys()-g.keys())-final.keys()),
        added=len(final.keys()-g.keys()),spacing_breathings=len(breathings),
        spacing_breathings_attached=len(attached))
    return text,census


def edit_guard(original, proposal):
    """Return rejection reasons; unchanged unsupported characters are preserved.

    Greek bases and legal mark multiplicities are the only editable letters.
    Non-Greek clusters and unsupported Greek clusters must remain identical.
    Canonical equivalence alone is never a reason to rewrite source bytes.
    """
    a=[c for c in clusters(nfd(original)) if (c.base.isalpha() and c.base not in ELISION) or ud.combining(c.base)]
    b=[c for c in clusters(nfd(proposal)) if (c.base.isalpha() and c.base not in ELISION) or ud.combining(c.base)]
    reasons=[]
    # Preserve the raw spelling of out-of-domain clusters, including decomposed
    # Latin accents. NFC equivalence does not authorize rewriting those bytes.
    raw_a=[c for c in clusters(original) if c.base.isalpha() and c.base not in ELISION]
    raw_b=[c for c in clusters(proposal) if c.base.isalpha() and c.base not in ELISION]
    if len(raw_a)==len(raw_b):
        for i,(x,y) in enumerate(zip(raw_a,raw_b)):
            decoded=clusters(nfd(x.base+x.marks))[0]
            if (decoded.base not in GREEK_LETTERS or not _supported(decoded)) and x.base+x.marks!=y.base+y.marks:
                reasons.append(f'edit_guard:unsupported_raw_character:{i}')
    if len(a)!=len(b) or [c.base for c in a]!=[c.base for c in b]:
        reasons.append('edit_guard:base_or_character_mismatch')
    else:
        for i,(x,y) in enumerate(zip(a,b)):
            if (not _supported(x) or not _supported(y) or x.base not in GREEK_LETTERS) and (x.base+x.marks!=y.base+y.marks):
                reasons.append(f'edit_guard:unsupported_character:{i}')
    punct_a,punct_b=_breathing_pair(original,proposal)
    if _punctuation(punct_a)!=_punctuation(punct_b):reasons.append('edit_guard:punctuation_mismatch')
    return reasons


def _reader_reasons(slot, prediction, coverage, prefix):
    reasons=[]
    if prediction is None:reasons.append(prefix+'_missing')
    elif not ('parts' in prediction or 'cls' in prediction):reasons.append(prefix+'_prediction_invalid')
"""SF2 L1r overlay/release consumer, derived from historical L1-v0 format."""
from __future__ import annotations

from collections import Counter
from difflib import SequenceMatcher
import hashlib
import json
from pathlib import Path
import unicodedata

from scripts.labelfix.clariden.r1_common import rows, write_rows, sha256, write_json
from greekocr.labelfix.text import nfd, elision_alias_key
from greekocr.labelfix.release_gate import compose_runtime, edit_guard, release_text, POLICY, ENSEMBLE_CAVEAT

STATUSES = ('corrected', 'unchanged', 'hold', 'out_of_scope')


def canonical(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False)


def label_sha(text):
    return hashlib.sha256(text.encode('utf-8')).hexdigest()


def hold_reason(reason):
    if reason.startswith(('ensemble_ab_mark_set_disagreement','ensemble_ae_mark_set_disagreement')):
        return 'ensemble_disagreement'
    if reason.startswith(('mark_kind_disagreement', 'mark_set_disagreement')):
        return 'kind_disagreement'
    if reason.startswith('K1:'):
        return 'k1_flag'
    if reason == 'r1_unsupported_letter':
        return 'recogniser_letter_problem'
    return 'localisation_unknown'


def overlay(record, runtime, variant, binding):
    original = record['label']
    result = dict(line_id=record['id'], original_label_sha256=label_sha(original),
                  changes=[], hold_slots=[], detector_version=binding['detector'],
                  r1_sha=binding['r1_sha256'], policy_sha=binding['policy_sha256'])
    if record['script_class'] != 'greek_poly':
        return dict(result, status='out_of_scope')
    # Never trust previously composed decisions under an older policy.
    mode = compose_runtime(runtime,variant.upper())
    result.update(release_policy=POLICY,evidence_sha256=mode['evidence_sha256'],opening_quotes=mode['opening_quotes'],
        gate_decisions=[{k:s.get(k) for k in ('start','base','label_status','hold_reasons',
            'r1_coverage','segmentation_uncertain','localisation_unknown','unnamed',
            'detector_parts','r1_parts','peer_arm','peer_prediction','peer_coverage','evidence','constraint_flags','apostrophe')}
            for s in mode['slots']])
    for slot in mode['hold_slots']:
        for reason in slot['reasons']:
            result['hold_slots'].append(dict(start=slot['start'], letter=slot['base'],
                reason=hold_reason(reason), detail=reason))
    proposal, census = release_text(original, runtime['recogniser_text'], mode['text'])
    alias_only = (nfd(original)!=nfd(mode['text'])
                  and elision_alias_key(original)==elision_alias_key(mode['text']))
    result.update(alias_only=alias_only,elision_census=census)
    for detail in edit_guard(original, runtime['recogniser_text']) + edit_guard(original,proposal):
        result['hold_slots'].append(dict(start=0,letter='',reason='edit_guard',detail=detail))
    if result['hold_slots']:
        return dict(result, status='hold')
    if nfd(original) == nfd(proposal):
        return dict(result, status='unchanged', label=original)
    old, new = nfd(original), nfd(proposal)
    for tag, i, j, lo, hi in SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
        if tag == 'equal':
            continue
        # Evidence is recogniser-indexed; edits are original-label NFD offsets.
        evidence = dict(recogniser_text=runtime['recogniser_text'], agreement=variant,
            slots=[dict(start=s['start'], letter=s['base'], r1_coverage=s.get('r1_coverage'),
                        segmentation_uncertain=s.get('segmentation_uncertain'),localisation_unknown=s.get('localisation_unknown'),
                        hold_reasons=s.get('hold_reasons'),detector_parts=s.get('detector_parts'),
                        r1_parts=s.get('r1_parts'),peer_arm=s.get('peer_arm'),peer_prediction=s.get('peer_prediction'),
                        peer_coverage=s.get('peer_coverage'),locator_span=s.get('locator_span'),
                        mark_probabilities=s.get('mark_probabilities'), evidence=s.get('evidence'))
                   for s in mode['slots']],
            opening_quotes=mode.get('opening_quotes', []), detector_text=runtime['detector']['text'])
        context = i
        if (lo < hi and unicodedata.combining(new[lo])) or (i < j and unicodedata.combining(old[i])):
            context -= 1
        while context >= 0 and context < len(old) and unicodedata.combining(old[context]):
            context -= 1
        letter = old[context] if 0 <= context < len(old) and old[context].isalpha() else ''
        result['changes'].append(dict(start=i, letter=letter,
                                      **{'from': old[i:j], 'to': new[lo:hi]}, evidence=evidence))
    return dict(result, status='corrected', label=proposal)


def _overlays(task):
    record,runtime,variants,binding=task
    return runtime['id'],{v:overlay(record,runtime,v,binding) for v in variants}


def release(selection, runtime_paths, out, binding, source, input_receipt, variants=('presence','full'), workers=1):
    """Stream both variants, with one explicit kept-line list shared by each control."""
    out = Path(out)
    out.mkdir(parents=True, exist_ok=False)
    original_sha = sha256(source)
    selected=list(rows(selection))
    records = {r['id']: r for r in selected}
    if len(records)!=len(selected):raise ValueError('duplicate selection IDs')
    import gzip
    handles = {v: gzip.open(out / f'overlay_{v}.jsonl.gz', 'xt', encoding='utf-8', compresslevel=3)
               for v in variants}
    counts = {v: Counter({s: 0 for s in STATUSES}) for v in handles}
    aliases = Counter()
    coverage = {v: {'wave': {}, 'source': {}} for v in handles}
    kept = {v: [] for v in handles}
