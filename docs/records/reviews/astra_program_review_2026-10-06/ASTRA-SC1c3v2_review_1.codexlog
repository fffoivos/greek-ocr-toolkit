   165	    cs=clusters(nfd(proposal));letters=_letters(proposal)
   166	    attached={k for k in breathings if k<len(letters) and set(letters[k].marks)&BREATHINGS}
   167	    p=punctuation_sites(proposal);consensus=g.keys()&r.keys();out=[];boundary=0
   168	    for i,c in enumerate(cs):
