   196	def edit_guard(original, proposal):
   197	    """Return rejection reasons; unchanged unsupported characters are preserved.
   198	
   199	    Greek bases and legal mark multiplicities are the only editable letters.
   200	    Non-Greek clusters and unsupported Greek clusters must remain identical.
   201	    Canonical equivalence alone is never a reason to rewrite source bytes.
   202	    """
