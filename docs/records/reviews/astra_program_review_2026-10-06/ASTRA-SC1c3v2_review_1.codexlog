    19	from greekocr.labelfix import release_gate as gate
    20	from greekocr.labelfix.text import (clusters, nfd, nfc, is_letter, punctuation_sites,
    21	                                   elision_alias_key, ELISION, spacing_breathing)
    22	from scripts.labelfix.clariden import l1_common as common
    23	from scripts.labelfix.clariden.r1_common import rows, sha256, write_json, write_rows
    24	
    25	DOC = Path('docs/labelfix/spellcheck')
    26	SIX = {
    27	    '399d224c580127635c47cd8d-p000019-l0010': 'mu_elision',
    28	    '32aae9fec147d3b483deb96e-p000052-l0026': 'kappa_elision',
    29	    'a963b33d02c23d4127f5ec26-p000012-l0029': 'capital_breathing',
    30	    '32aae9fec147d3b483deb96e-p000060-l0057': 'capital_breathing',
