   134	def witnesses(out):
   135	    inputs = list(rows(out/'witness_inputs.jsonl.gz'))
   136	    result = []
   137	    for r in inputs:
   138	        o = common.overlay(r['record'], r['runtime'], 'ensemble_ab', BINDING)
   139	        before = r['before']; after = o.get('label', r['record']['label'])
   140	        g = punctuation_sites(r['record']['label']); rec = punctuation_sites(r['runtime']['recogniser_text'])
   141	        both = g.keys() & rec.keys(); final = punctuation_sites(after)
   142	        # Only the two text rules and spelling accounting may change. The
   143	        # accepted per-letter decisions and all raw evidence remain identical.
   144	        now = gate.compose_runtime(r['runtime'], 'ENSEMBLE_AB')
   145	        assert now['slots'] == r['sf4_decisions']['slots'], r['id']
   146	        result.append(dict(id=r['id'],kind=r['kind'],google=r['record']['label'],
   147	            recogniser=r['runtime']['recogniser_text'],before=before,after=after,
   148	            before_status=r['before_status'],after_status=o['status'],alias_only=o['alias_only'],
   149	            consensus=len(both),consensus_kept=len(both & final.keys()),
   150	            consensus_deleted=len(both-final.keys()),elision_census=o['elision_census'],
   151	            combining_marks_changed=nfd(''.join(c.base+c.marks for c in clusters(nfd(before)) if is_letter(c.base))) !=
   152	                                    nfd(''.join(c.base+c.marks for c in clusters(nfd(after)) if is_letter(c.base))),
   153	            changes=o['changes']))
   154	    write_rows(out/'witness_results.jsonl.gz',result)
   155	    return result
