    20	def synthetic(text, *, detector_apostrophe=False, named=True):
    21	    text=nfd(text);slots=[];pred=[];cov=[]
    22	    for c in clusters(text):
    23	        if not is_letter(c.base):continue
    24	        parts=[p for p,m in R.MARKS.items() if m in c.marks] if named else []
    25	        slots.append(dict(base=c.base,start=c.start,end=c.end,parts=parts,
    26	            apostrophe=detector_apostrophe and not slots,unnamed=[],
    27	            localisation_unknown=False,segmentation_uncertain=False,
    28	            evidence=dict(clipped_top=False,clipped_bottom=False)))
    29	        pred.append(dict(start=c.start,base=c.base,parts=parts))
    30	        cov.append(dict(start=c.start,base=c.base,scored=True,
    31	                        evidence_state='unadjudicated',uncertainty=[]))
    32	    return dict(id='x',recogniser_text=nfc(text),
    33	        detector=release_gate.serialize(R.LineReading(nfc(text),slots,[])),
    34	        r1_predictions=pred,coverage=cov,peer_predictions={a:deepcopy(pred) for a in ('B','E')},
    35	        peer_coverage={a:deepcopy(cov) for a in ('B','E')})
    36	
