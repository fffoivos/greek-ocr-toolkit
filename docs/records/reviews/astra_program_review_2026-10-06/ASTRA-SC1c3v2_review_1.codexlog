    36	
    37	def baseline(root=Path('artifacts/labelfix_sf5/before')):
    38	    """Load all three frozen c6064650 sources without changing package imports."""
    39	    names = ('greekocr.labelfix.text', 'greekocr.labelfix.release_gate',
    40	             'scripts.labelfix.clariden.l1_common')
    41	    paths = ('greekocr/labelfix/text.py', 'greekocr/labelfix/release_gate.py',
    42	             'scripts/labelfix/clariden/l1_common.py')
    43	    previous = {n: sys.modules.get(n) for n in names}
    44	    loaded = []
    45	    try:
    46	        for name, path in zip(names, paths):
    47	            spec = importlib.util.spec_from_file_location(name, root/path)
    48	            module = importlib.util.module_from_spec(spec)
    49	            sys.modules[name] = module
    50	            spec.loader.exec_module(module)
    51	            loaded.append(module)
    52	    finally:
    53	        for name, module in previous.items():
    54	            if module is None: sys.modules.pop(name, None)
    55	            else: sys.modules[name] = module
    56	    return loaded[1], loaded[2]
    57	
    58	
    59	def runtime_from_overlay(overlay, raw=None, mode=None):
    60	    """Recover only fields actually retained by the saved accepted AB overlay.
    61	
    62	    Six L1M witnesses retain the entire raw detector. The 50 overlays retain
    63	    every release gate input used by their accepted decisions, with geometry
    64	    in per-slot evidence. No peer E record was saved here; it remains absent.
    65	    Frozen-SF4 recomposition must reproduce all 56 labels before use.
    66	    """
    67	    ev = overlay['changes'][0]['evidence']
    68	    details = {s['start']: s for s in ev['slots']}
    69	    slots = (mode or {}).get('slots', overlay['gate_decisions'])
    70	    if raw is None:
    71	        rawslots = []
    72	        for s in slots:
    73	            d = details[s['start']]
    74	            z = deepcopy(s)
    75	            z.update(parts=s['detector_parts'], locator_span=d['locator_span'])
    76	            # These are saved observation labels, not newly inferred geometry.
    77	            z['case_class'] = s['evidence'].get('case_class')
    78	            rawslots.append(z)
    79	        raw = dict(text=ev['detector_text'], slots=rawslots, unnamed=[],
    80	                   opening_quotes=overlay['opening_quotes'], constraint_flags=[])
    81	    predictions, coverage, peers, pcov = [], [], [], []
    82	    for s in slots:
    83	        if s.get('r1_coverage') is not None:
    84	            predictions.append(dict(start=s['start'], base=s['base'], parts=s['r1_parts'],
    85	                                    mark_probabilities=details[s['start']].get('mark_probabilities')))
    86	            coverage.append(s['r1_coverage'])
    87	        if s.get('peer_prediction') is not None: peers.append(s['peer_prediction'])
    88	        if s.get('peer_coverage') is not None: pcov.append(s['peer_coverage'])
    89	    return dict(id=overlay['line_id'], recogniser_text=ev['recogniser_text'],
    90	                detector=deepcopy(raw), r1_predictions=predictions, coverage=coverage,
    91	                peer_predictions={'B': peers}, peer_coverage={'B': pcov})
    92	
    93	
    94	def prepare_witnesses(out):
    95	    ids = (DOC/'SF5_witness/witness_50_ids.txt').read_text().splitlines()
    96	    overlays = {r['line_id']: r for r in rows(DOC/'SF5_witness/sf5_witness_50_ab_records.jsonl.gz')}
    97	    assert set(ids) == set(overlays) and len(ids) == 50
    98	    wanted = set(ids) | SIX.keys()
    99	    source = Path('docs/harvest/collection/v2/import_real_v2_train.jsonl')
   100	    records = {}
   101	    for r in rows(source):
   102	        lid = r.get('id', r.get('line_id'))
   103	        if lid in wanted: records[lid] = dict(r, id=lid, script_class='greek_poly')
   104	    assert set(records) == wanted
   105	    result = []
   106	    for lid in ids:
   107	        o = overlays[lid]
   108	        result.append(dict(id=lid, kind='seeded_elision', record=records[lid],
   109	                           runtime=runtime_from_overlay(o), before=o['label'], before_status=o['status']))
   110	    l1m = Path.home()/'Projects/greek-ocr-toolkit-spellcheck-l1/docs/labelfix/spellcheck/L1M_evidence/200/details.jsonl.gz'
   111	    for r in rows(l1m):
   112	        if r['id'] not in SIX: continue
   113	        o = r['overlays']['masked']['ENSEMBLE_AB']
   114	        assert common.label_sha(records[r['id']]['label'])==o['original_label_sha256']
   115	        result.append(dict(id=r['id'], kind=SIX[r['id']], record=records[r['id']],
   116	            runtime=runtime_from_overlay(o, r['detector']['masked'], r['modes']['masked']['ENSEMBLE_AB']),
   117	            before=o['label'], before_status=o['status']))
   118	    assert len(result) == 56
   119	    oldgate, oldcommon = baseline()
   120	    for r in result:
   121	        assert common.label_sha(r['record']['label']) == (
   122	            overlays[r['id']]['original_label_sha256'] if r['id'] in overlays else common.label_sha(r['record']['label']))
   123	        o = oldcommon.overlay(r['record'], r['runtime'], 'ensemble_ab', BINDING)
   124	        assert (o['status'], o.get('label')) == (r['before_status'], r['before']), (r['id'], o['status'], o.get('label'))
   125	        r['sf4_decisions'] = oldgate.compose_runtime(r['runtime'], 'ENSEMBLE_AB')
   126	    write_rows(out/'witness_inputs.jsonl.gz', result)
   127	    write_json(out/'witness_inputs_receipt.json', dict(lines=56, frozen_sf4_labels_reproduced=56,
   128	        diagnostic_E_saved=False, detector_runs=0, r1_runs=0, ctc_runs=0,
   129	        inputs={str(p):sha256(p) for p in (source,l1m,DOC/'SF5_witness/sf5_witness_50_ab_records.jsonl.gz',DOC/'SF5_witness/witness_50_ids.txt')},
   130	        runtime_sha256=sha256(out/'witness_inputs.jsonl.gz')))
   131	    return result
