   157	
   158	def mapped_elisions(text, model):
   159	    """R0 punctuation scopes include printed initial elisions ('ς, 'φελα).
   160	
   161	    Count their emitted sign too. Only the SF5 preservation rule is restricted
   162	    to word-final elisions; a present initial sign must not score as deleted.
   163	    Spacing breathings are excluded in either position.
   164	    """
   165	    from scripts.labelfix.r0_score import align
   166	    a=''.join(c.base for c in clusters(nfd(model)) if is_letter(c.base))
   167	    b=''.join(c.base for c in clusters(nfd(text)) if is_letter(c.base))
   168	    mapping={j:i for i,j in align(a,b,True) if i is not None and j is not None}
   169	    signs=punctuation_sites(text,lambda cs,i:cs[i].base in ELISION and not cs[i].marks
   170	                            and not spacing_breathing(cs,i))
   171	    return {mapping[k-1]+1 if k-1 in mapping else mapping[k] if k in mapping
   172	            else 0 if k==0 else len(a) for k in signs}
   173	
   174	
   175	def elision_truth(ids):
   176	    """Read continuity scopes only; human reference is used only if adjudicated.
   177	
   178	    The R0 site records certify punctuation scopes, never whole lines. A human
   179	    Wikisource emission agreeing with a resolved site supplies its text; an
   180	    absent/disagreeing human emission falls back to the literal R0 judgment.
   181	    """
   182	    path=DOC/'R0_evidence/scoring/punctuation_sites.jsonl'
   183	    result=[]
   184	    with path.open() as f:
   185	        for line in f:
   186	            # Do not decode any new-source locked truth while using this file.
   187	            if '"stratum": "continuity_666"' not in line:continue
   188	            r=json.loads(line)
   189	            if r['line_id'] not in ids:continue
   190	            r['truth_source']=('human_Wikisource_pixel_adjudicated_by_R0'
   191	                if r['status']=='KNOWN' and
   192	                   ((r['printed_role']=='apostrophe_elision' and r['emitted']['human'] in set("'’ʼ᾽᾿`´"))
   193	                    or (r['printed_role']=='absent' and r['emitted']['human']==''))
   194	                else 'R0_adjudication')
   195	            result.append(r)
   196	    return result
   197	
   198	
   199	def score_elisions(sites,texts,models):
   200	    counts=Counter(kept=0,deleted=0,added=0,positive_sites=0,negative_sites=0,unknown_sites=0)
   201	    events=[];mapped={lid:mapped_elisions(text,models[lid]) for lid,text in texts.items()}
   202	    for r in sites:
   203	        if r['status']!='KNOWN':counts['unknown_sites']+=1;continue
   204	        if r['printed_role']=='quote':
   205	            # R0 explicitly calls two curly/ASCII terminal signs closing
   206	            # quotes. Their presence is not an added elision apostrophe.
   207	            counts['excluded_quote_sites']+=1
   208	            continue
   209	        present=r['letter_boundary'] in mapped[r['line_id']]
   210	        positive=r['printed_role']=='apostrophe_elision'
   211	        counts['positive_sites' if positive else 'negative_sites']+=1
   212	        outcome=('kept' if present else 'deleted') if positive else ('added' if present else 'absent')
   213	        counts[outcome]+=1
   214	        events.append(dict(id=r['line_id'],boundary=r['letter_boundary'],outcome=outcome,
   215	            printed_role=r['printed_role'],truth_source=r['truth_source'],card_ids=r['card_ids']))
   216	    return dict(counts),events
   217	
   218	
   219	def effective_label(policy,original,recogniser,decision,*,sf5):
   220	    proposal=decision['text'];census={};alias_only=False
   221	    if sf5:
   222	        proposal,census=gate.release_text(original,recogniser,proposal)
   223	        alias_only=(nfd(original)!=nfd(decision['text']) and
   224	                    elision_alias_key(original)==elision_alias_key(decision['text']))
   225	    census=source_census(original,recogniser,proposal)
   226	    holds=[*decision['hold_slots'],*policy.edit_guard(original,recogniser),*policy.edit_guard(original,proposal)]
   227	    status='hold' if holds else 'unchanged' if nfd(original)==nfd(proposal) else 'corrected'
   228	    return dict(status=status,label=original if status=='hold' else proposal,
   229	                proposal=proposal,alias_only=alias_only and status=='unchanged',elision_census=census)
   230	

