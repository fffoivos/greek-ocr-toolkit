   204	    b=[c for c in clusters(nfd(proposal)) if (c.base.isalpha() and c.base not in ELISION) or ud.combining(c.base)]
   205	    reasons=[]
   206	    # Preserve the raw spelling of out-of-domain clusters, including decomposed
   207	    # Latin accents. NFC equivalence does not authorize rewriting those bytes.
   208	    raw_a=[c for c in clusters(original) if c.base.isalpha() and c.base not in ELISION]
   209	    raw_b=[c for c in clusters(proposal) if c.base.isalpha() and c.base not in ELISION]
   210	    if len(raw_a)==len(raw_b):
