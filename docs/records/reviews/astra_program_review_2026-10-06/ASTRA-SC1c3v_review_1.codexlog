   339	
   340	def bind_runtime(runtime, k1_flags=()):
   341	    """One content-bound envelope for every input used by the release policy.
   342	
   343	    Keep all saved peers, including diagnostic E in AB. The binding covers
   344	    detector geometry, recogniser context, coverage, predictions and K1 flags.
   345	    It proves input identity; source-file/checkpoint custody remains the caller's.
   346	    """
   347	    evidence={k:deepcopy(runtime.get(k,default)) for k,default in (
   348	        ('recogniser_text',''),('detector',{}),('r1_predictions',[]),('coverage',[]),
   349	        ('peer_predictions',{}),('peer_coverage',{}),('k1_flags',[]))}
   350	    if 'recogniser_nfd' in runtime:
   351	        if nfd(runtime['recogniser_text'])!=nfd(runtime['recogniser_nfd']):raise ValueError('runtime recogniser text mismatch')
   352	        evidence['recogniser_nfd']=runtime['recogniser_nfd']
   353	    if not isinstance(evidence['detector'],dict):evidence['detector']=serialize(evidence['detector'])
   354	    digest=hashlib.sha256(json.dumps(evidence,sort_keys=True,ensure_ascii=False).encode()).hexdigest()
   355	    if runtime.get('evidence_sha256',digest)!=digest:raise ValueError('runtime evidence binding mismatch')
   356	    if k1_flags:
   357	        evidence['k1_flags'].extend(deepcopy(k1_flags))
   358	        digest=hashlib.sha256(json.dumps(evidence,sort_keys=True,ensure_ascii=False).encode()).hexdigest()
   359	    return dict(evidence,evidence_sha256=digest)
   360	
   361	
   362	def compose_runtime(runtime, mode, k1_flags=()):
   363	    """Compose the complete saved evidence envelope, without selecting inputs."""
   364	    runtime=bind_runtime(runtime,k1_flags)
   365	    peer=mode[-1].upper() if mode.upper().startswith('ENSEMBLE_') else None
   366	    signals={}
   367	    for records in runtime['peer_predictions'].values():
   368	        prediction_index(records)  # Diagnostic peers must not hide duplicate starts.
   369	        for p in records:signals.setdefault(p['start'],[]).extend(p.get('parts',p.get('cls','none').split('+')))
   370	    rd=_compose_reading(runtime.get('recogniser_nfd',runtime['recogniser_text']),runtime['detector'],
   371	        prediction_index(runtime['r1_predictions']),runtime['coverage'],mode,runtime['k1_flags'],
   372	        peer_predictions=prediction_index(runtime['peer_predictions'].get(peer,[])),
   373	        peer_coverage=runtime['peer_coverage'].get(peer),signal_parts=signals)
   374	    serial=serialize(rd)
   375	    serial.update(mode=mode.upper(),release_policy=POLICY,evidence_sha256=runtime['evidence_sha256'],
   376	        hold_slots=[dict(start=s['start'],base=s['base'],reasons=s['hold_reasons'],parts=s['parts'],
   377	                         detector_parts=s['detector_parts'],r1_parts=s['r1_parts'],locator_span=s.get('locator_span'))
   378	                    for s in serial['slots'] if s['hold']])
   379	    return serial
   380	
   381	
   382	def compose(text,raw,predictions,coverage,mode,k1_flags=(),*,peer_predictions=None,peer_coverage=None,signal_parts=None):
   383	    """Legacy component adapter; bind all supplied evidence before composition.
   384	
   385	    Runtime-aware callers must use compose_runtime to retain diagnostic peers.
   386	    """
   387	    peer=mode[-1].upper() if mode.upper().startswith('ENSEMBLE_') else None
   388	    def records(index):return [dict(p,start=start) for start,p in (index or {}).items()]
   389	    peers={peer:records(peer_predictions)} if peer else {}
   390	    # Preserve explicit legacy relevance inputs as another diagnostic signal.
   391	    if signal_parts:peers['diagnostic']=[dict(start=start,parts=list(parts)) for start,parts in signal_parts.items()]
   392	    return compose_runtime(dict(recogniser_text=text,detector=raw,r1_predictions=records(predictions),coverage=coverage,
   393	        peer_predictions=peers,peer_coverage={peer:peer_coverage or []} if peer else {}),mode,k1_flags)
   394	
   395	
   396	def compose_reading(*args,**kwargs):
   397	    return deserialize(compose(*args,**kwargs))

