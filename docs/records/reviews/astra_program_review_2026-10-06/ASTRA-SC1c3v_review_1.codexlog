   169	def zone_relevance(slot, signal_parts=()):
   170	    """Conservative saved-evidence contract; no capital side-zone exception.
   171	
   172	    Scalar meanline/xh do not certify the whole overhead AND preposed zone.
   173	    Saved SF3 records lack that certificate, so top cuts remain decisive for
   174	    mark bearers. Either recogniser case or physical capital case/band vetoes
   175	    both clipping relaxations, including on otherwise unsupported capitals.
   176	    """
   177	    base=slot['base'].lower()
   178	    ev=slot.get('evidence',{})
   179	    ev=ev.to_record() if hasattr(ev,'to_record') else ev
   180	    capital=(slot['base'].isupper() or slot.get('case_class')=='capital'
   181	             or ev.get('case_class')=='capital'
   182	             or any(record.get(key)=='capital' for record in (slot,ev)
   183	                    for key in ('pixel_class','raw_pixel_class','frozen_pixel_class'))
   184	             or slot.get('geometry_capital') is True or slot.get('all_caps') is True
   185	             or str(ev.get('band_source','')).startswith('capital')
   186	             or str(slot.get('height_band',{}).get('source','')).startswith('capital'))
   187	    bearing=base in 'αεηιουωρ'
   188	    return dict(above=bearing or capital,top_cut=bearing or capital,upper_zone_top=None,
   189	        below=capital or not slot['base'].islower() or base in 'αηω'
   190	              or bool(slot.get('iota_adscript')) or 'subscript' in signal_parts,
   191	        left=bearing and capital,right=slot.get('word_final',False) or slot.get('apostrophe',False))
   192	
   193	
   194	def _flag_relevant(flag, relevance):
   195	    """Only known observation predicates can lose a veto; unknown flags hold."""
   196	    if flag.get('rule','observation')!='observation':return True
   197	    reason=flag.get('reason','')
   198	    key={'clipped_top':'top_cut','detector_clipped_top':'top_cut',
   199	         'clipped_bottom':'below','detector_clipped_bottom':'below',
   200	         'unseen_above':'above','crop_UNSEEN:above':'above',
   201	         'unseen_below':'below','crop_UNSEEN:below':'below'}.get(reason)
   202	    return relevance[key] if key else True
   203	
   204	
   205	def _flag_targets(flag, start):
   206	    return (flag.get('start')==start or any(a.get('start')==start for a in flag.get('alternatives',()))
   207	            or ('start' not in flag and not flag.get('alternatives')))
   208	
   209	
   210	def decide(slot, prediction, coverage, mode, *, flagged=False, peer_prediction=None, peer_coverage=None, signal_parts=()):
   211	    mode=mode.upper()
   212	    if mode not in MODES:raise ValueError('unknown release mode: '+mode)
   213	    ev=slot.get('evidence',{})
   214	    ev=ev.to_record() if hasattr(ev,'to_record') else ev
   215	    det=list(slot.get('parts',()))
   216	    rp=None if prediction is None else list(prediction.get('parts',prediction.get('cls','none').split('+')))
   217	    if rp==['none']:rp=[]
   218	    reasons=[]
   219	    for key in ('localisation_unknown','segmentation_uncertain'):
   220	        if slot.get(key):reasons.append('detector_'+key)
   221	    if slot.get('physical_resolved') is False or slot.get('ambiguity'):
   222	        reasons.append('detector_physical_unresolved')
   223	    if slot.get('unnamed'):reasons.append('detector_unnamed_mark')
   224	    peer_parts=[] if peer_prediction is None else peer_prediction.get('parts',peer_prediction.get('cls','none').split('+'))
   225	    relevant=zone_relevance(slot,[*det,*(rp or []),*peer_parts,*signal_parts])
   226	    reasons.extend('crop_UNSEEN:'+z for z in slot.get('unseen_zones',()) if relevant.get(z,True))
   227	    for zone,direction in [('above','top'),('below','bottom'),('left','left'),('right','right')]:
   228	        if relevant['top_cut' if direction=='top' else zone] and ev.get('clipped_'+direction):reasons.append('detector_clipped_'+direction)
   229	        if relevant[zone] and ev.get('observation',{}).get(zone) in ('UNSEEN','UNKNOWN'):
   230	            reasons.append('crop_UNSEEN:'+zone)
   231	    if slot['base'] in R1_LETTERS:
   232	        reasons.extend(_reader_reasons(slot,prediction,coverage,'r1'))
   233	        if mode.startswith('ENSEMBLE_'):
   234	            peer='r1_'+mode[-1]
   235	            reasons.extend(_reader_reasons(slot,peer_prediction,peer_coverage,peer))
   236	            pp=None if peer_prediction is None else peer_prediction.get('parts',peer_prediction.get('cls','none').split('+'))
   237	            if pp==['none']:pp=[]
   238	            if prediction is not None and peer_prediction is not None and set(rp)!=set(pp):
   239	                reasons.append(mode.lower()+'_mark_set_disagreement')
   240	        if prediction is not None:
   241	            if mode in ('PRESENCE','FULL') and (kinds(det)!=kinds(rp) if mode=='PRESENCE' else set(det)!=set(rp)):
   242	                reasons.append('mark_kind_disagreement' if mode=='PRESENCE' else 'mark_set_disagreement')
   243	    elif (det and not mode.startswith('ENSEMBLE_')) or slot.get('unnamed'):reasons.append('r1_unsupported_letter')
   244	    active_flags=[f for f in slot.get('constraint_flags',()) if _flag_relevant(f,relevant)]
   245	    if flagged or active_flags:reasons.append('K1:flag')
   246	    if slot.get('hold'):
   247	        old=slot.get('hold_reasons')
   248	        # A saved K1-only HOLD must not resurrect a now-irrelevant flag.
   249	        if old:
   250	            for reason in old:
   251	                predicate=reason.removeprefix('K1:observation:')
   252	                if reason.startswith(('detector_clipped_','crop_UNSEEN:','K1:observation:')):
   253	                    if not _flag_relevant(dict(reason=predicate),relevant):continue
   254	                if (reason=='K1:flag' and slot.get('constraint_flags') and not active_flags and not flagged):continue
   255	                reasons.append(reason)
   256	        elif not slot.get('constraint_flags') or active_flags:reasons.append('detector_hold')
   257	    reasons=list(dict.fromkeys(reasons))
   258	    return dict(action='HOLD' if reasons else 'ACCEPT' if slot['base'] in R1_LETTERS else 'KEEP',
   259	                reasons=reasons,detector_parts=det,r1_parts=rp)
