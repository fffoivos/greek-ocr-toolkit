    35	def capital_diaeresis(base='Ι'):
    36	    # Source dots originally extend two rows above this cropped view. Two
    37	    # retained dot fragments touch row zero over the capital's body, not left
    38	    # of it. Evidence is produced by the real deterministic geometry helper.
    39	    lab = np.zeros((40, 48), int)
    40	    lab[8:29, 19:23] = 1
    41	    lab[0:3, 18:21] = 2
    42	    lab[0:3, 24:27] = 3
    43	    components = []
    44	    for k in (1, 2, 3):
    45	        ys, xs = np.where(lab == k)
    46	        x0, x1, y0, y1 = int(xs.min()), int(xs.max()+1), int(ys.min()), int(ys.max()+1)
    47	        components.append(NS(index=k, x0=x0, x1=x1, y0=y0, y1=y1,
    48	                             w=x1-x0, h=y1-y0, cx=(x0+x1)/2, cy=(y0+y1)/2,
    49	                             role='letter' if k == 1 else 'mark', darkness=20.,
    50	                             area=int((lab == k).sum())))
    51	    ink = I.CropInk(np.where(lab > 0, 20., 255.), lab > 0, lab, 20.,
    52	                   np.full(48, 8.), np.full(48, 28.), components, 255., 48, 40, 20.)
    53	    ink.case_info = {1:dict(case_class='capital')}
    54	    region = dict(component=components[0], component_ids=[1],
    55	                  region_bounds=[19,23], case_class='capital')
    56	    ev = I.mark_evidence(ink, 19, 23, base_letter=base,
    57	                         certified_body=(19,23), letter_region=region)
    58	    r = clean(base)
    59	    r['recogniser_text'] = base + '\u0308'
    60	    r['detector']['slots'][0].update(parts=['dialytika'], evidence=ev.to_record())
    61	    return r
