   164	def load_runtimes(paths, config):
   165	    """Read complete, file-hash-bound runtimes, never selected peer fragments."""
   166	    from greekocr.labelfix.release_gate import bind_runtime
   167	    from scripts.labelfix.clariden.r1_common import rows
   168	    if sorted(paths)!=sorted(config.get('runtime',{})):
   169	        raise ValueError('runtime inputs differ from configuration')
   170	    result={}
   171	    for path in paths:
   172	        if digest(path)!=config['runtime'][path]:raise ValueError('runtime hash mismatch')
   173	        for row in rows(path):
   174	            lid=row.get('id',row.get('line_id'))
   175	            if lid in result:raise ValueError('duplicate runtime line')
   176	            for key in ('peer_predictions','peer_coverage'):
   177	                if not {'B','E'}<=set(row.get(key,{})):
   178	                    raise ValueError('runtime must record both B and diagnostic E evidence explicitly')
   179	            result[lid]=bind_runtime(row)
   180	    return result
