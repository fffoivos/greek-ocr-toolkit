   262	def _compose_reading(text, raw, predictions, coverage, mode, k1_flags=(), *, peer_predictions=None, peer_coverage=None, signal_parts=None):
   263	    """Compose from detector punctuation and R1 names, retaining all HOLD evidence."""
   264	    if isinstance(raw,dict):raw=deserialize(raw)
   265	    # Old saved U+02BC slots are punctuation, not evidence for another letter.
   266	    # Preserve their complete records and carry unresolved evidence as a veto.
   267	    aliases=[s for s in raw.slots if s['base'] in ELISION]
   268	    if aliases:
   269	        flags=list(raw.constraint_flags)
   270	        if any(any(s.get(key) for key in ('parts','unnamed','hold','constraint_flags','localisation_unknown',
   271	                    'segmentation_uncertain','ambiguity','unseen_zones')) or s.get('physical_resolved') is False
   272	               for s in aliases):
   273	            flags.append(dict(rule='observation',reason='legacy_elision_slot_unresolved'))
   274	        raw=replace(raw,slots=[s for s in raw.slots if s['base'] not in ELISION],
   275	                    constraint_flags=flags,geometry=dict(raw.geometry,elision_alias_slots=[s for s in serialize(raw)['slots'] if s['base'] in ELISION]))
   276	    cov={c['start']:c for c in coverage}
   277	    if len(cov)!=len(coverage):raise ValueError('duplicate R1 coverage start')
   278	    pcov={c['start']:c for c in (peer_coverage or [])}
   279	    if len(pcov)!=len(peer_coverage or []):raise ValueError('duplicate peer coverage start')
   280	    slots=[]
   281	    cs=clusters(nfd(text))
   282	    source_parts={c.start:[p for p,v in R.MARKS.items() if v in c.marks] for c in cs}
   283	    # A written iota immediately after Α/Η/Ω can be an adscript. Without a
   284	    # separate adscript adjudication, keep the below zone conservative there.
   285	    adscript={c.start for i,c in enumerate(cs) if i and c.base in 'ιΙ' and cs[i-1].base in 'ΑΗΩ'}
   286	    relevance={}
   287	    for s in raw.slots:
   288	        parts=list(s.get('parts',()))+source_parts.get(s['start'],[])+list((signal_parts or {}).get(s['start'],()))
   289	        for p in (predictions.get(s['start']), (peer_predictions or {}).get(s['start'])):
   290	            if p:parts.extend(p.get('parts',p.get('cls','none').split('+')))
   291	        relevance[s['start']]=zone_relevance(dict(s,iota_adscript=True) if s['start'] in adscript else s,parts)
   292	    flags=[]
   293	    for f in [*raw.constraint_flags,*k1_flags]:
   294	        targets=[s for s in raw.slots if _flag_targets(f,s['start'])]
   295	        active=[s for s in targets if _flag_relevant(f,relevance[s['start']])]
   296	        if len(active)==len(targets):flags.append(f)
   297	        else:flags.extend(dict(f,start=s['start'],alternatives=[]) for s in active)
   298	    raw=replace(raw,constraint_flags=flags)
   299	    for original in raw.slots:
   300	        s=deepcopy({k:v for k,v in original.items() if k not in ('component','evidence','naming')})
   301	        s.update(component=original.get('component'),evidence=original.get('evidence',{}),naming=original.get('naming',{}))
   302	        start=s['start'];p=predictions.get(start)
   303	        if start in adscript:s['iota_adscript']=True
   304	        if p is not None:
   305	            if 'parts' not in p and 'cls' not in p:
   306	                p=dict(p,evidence_state='UNKNOWN',uncertainty=['invalid_prediction'])
   307	            p=dict(p,parts=p.get('parts',[x for x in p.get('cls','none').split('+') if x!='none']))
   308	        flagged=any(_flag_targets(f,start) for f in flags)
   309	        peer=(peer_predictions or {}).get(start)
   310	        signals=[*source_parts.get(start,()),*(signal_parts or {}).get(start,())]
   311	        d=decide(s,p,cov.get(start),mode,flagged=flagged,peer_prediction=peer,peer_coverage=pcov.get(start),signal_parts=signals)
   312	        s['constraint_flags']=[f for f in s.get('constraint_flags',()) if _flag_relevant(f,relevance[start])]
   313	        mapping=raw.geometry.get('physical_mapping',{})
   314	        if mapping.get('ambiguous'):
   315	            d['reasons'].append('detector_physical_mapping_ambiguous')
   316	        for variant in raw.geometry.get('substitutions',()):
   317	            if variant not in R.QUALIFIED_GEOMETRY:
   318	                d['reasons'].append('detector_geometry_unqualified:'+variant)
   319	        if d['reasons']:d['action']='HOLD'
   320	        s.update(detector_parts=d['detector_parts'],r1_parts=d['r1_parts'],
   321	                 r1_coverage=deepcopy(cov.get(start)),hold_reasons=d['reasons'],hold=bool(d['reasons']),label_status=d['action'])
   322	        s['zone_relevance']=relevance[start]
   323	        if mode.upper().startswith('ENSEMBLE_'):
   324	            s.update(peer_arm=mode[-1].upper(),peer_prediction=deepcopy(peer),peer_coverage=deepcopy(pcov.get(start)))
   325	        if p is not None and s['base'] in R1_LETTERS:
   326	            s.update(parts=p['parts'],naming={},mark_support_source='reader',reader_evidence={},mark_probabilities=p.get('mark_probabilities',{}))
   327	        slots.append(s)
   328	    rendered=_render_reading(text,slots).lstrip(LEADING_QUOTES+' ')
   329	    if raw.opening_quotes:rendered='“'+rendered
   330	    rd,removed=R.apply_constraints(replace(raw,text=rendered,slots=slots))
   331	    assert not removed
   332	    guard=edit_guard(text,rendered)
   333	    for s in rd.slots:
   334	        rr=list(s['hold_reasons'])+guard
   335	        rr.extend('K1:'+f.get('rule','observation')+':'+f.get('reason','unknown') for f in s.get('constraint_flags',()))
   336	        s.update(hold=bool(rr),hold_reasons=list(dict.fromkeys(rr)),label_status='HOLD' if rr else s['label_status'])
   337	    return rd
