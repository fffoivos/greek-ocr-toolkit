   183	def combine(lid, rd, mode=None, *, runtime=None, peer_predictions=None, peer_coverage=None):
   184	    from greekocr.labelfix.release_gate import compose_runtime, serialize, deserialize
   185	    runtime=runtime if runtime is not None else RUNTIMES.get(lid)
   186	    if runtime is not None:
   187	        if runtime['recogniser_text']!=LINE_TEXT[lid]:raise ValueError('page/runtime text mismatch')
   188	        if serialize(rd)!=runtime['detector']:raise ValueError('page/runtime detector evidence mismatch')
   189	        return deserialize(compose_runtime(runtime,mode or RELEASE_MODE)),[]
   190	    # Historical component callers cannot prove that diagnostic evidence was
   191	    # retained. Keep their proposals reviewable, with an explicit line veto.
   192	    predictions=[dict(p,start=start) for (line_id,start),p in R1.items() if line_id==lid]
   193	    partial=dict(recogniser_text=LINE_TEXT[lid],detector=serialize(rd),
   194	                 r1_predictions=predictions,coverage=COVERAGE.get(lid,[]))
   195	    flags=[dict(rule='observation',reason='complete_runtime_envelope_required')]
   196	    return deserialize(compose_runtime(partial,mode or RELEASE_MODE,flags)),[]
