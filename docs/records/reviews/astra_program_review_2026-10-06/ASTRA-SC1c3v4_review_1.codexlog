    body = ev.get('body') or slot.get('region_bounds')
    center = sum(body) / 2 if body else None
    area = sum(float(b.get('area', 0)) for b in bs)
    distance = (sum(abs((b['bbox'][0] + b['bbox'][2]) / 2 - center)
