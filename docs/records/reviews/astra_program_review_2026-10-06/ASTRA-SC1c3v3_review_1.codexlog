   120	def transfer_alignment(text: str, al: Alignment) -> Alignment:
   121	    """Spans for `text` (e.g. a recorded prediction) borrowed from an alignment of a near-identical
   122	    reading: matched characters keep their span, unmatched ones take the nearest matched
   123	    neighbour's. Used when the re-run prediction differs slightly from the recorded one."""
   124	    from .candidates import align_chars
   125	    if text == al.prediction:
   126	        return al
   127	    path = align_chars(text, al.prediction)
   128	    owner = [None] * len(text)
   129	    for i, j in path:
   130	        if i is not None and j is not None:
   131	            owner[i] = j
   132	    last = None
   133	    for i in range(len(text)):
   134	        if owner[i] is None:
   135	            owner[i] = last
   182	    def align_batch(self, images: list[Image.Image]) -> list[Alignment]:
   183	        torch = self.torch
   184	        from greekocr._vendor.train.model import DET_PAD_MARGIN, masked_forward
   185	        strips, scales = zip(*(make_strip(im) for im in images))
   186	        widths = [s.shape[1] for s in strips]
   187	        canvas_w = max(widths) + DET_PAD_MARGIN
   188	        canvas = np.empty((len(strips), STRIP_HEIGHT, canvas_w), np.uint8)
   189	        for i, s in enumerate(strips):
   190	            w = s.shape[1]
   191	            canvas[i, :, :w] = s
   192	            canvas[i, :, w:] = int(round(float(np.median(s[:, -2:]))))
   193	        x = torch.from_numpy(((canvas.astype(np.float32) / 255.0) - 0.5) / 0.5).unsqueeze(1).to(self.device)
   194	        lengths = torch.tensor([-(-w // STRIDE) for w in widths])
   195	        with torch.no_grad():
   196	            out = masked_forward(self.model, x, lengths)
   197	        lp = out.float().cpu()
   198	        am = lp.argmax(-1).numpy()
   199	        probs = lp.exp().max(-1).values.numpy()
   200	        results = []
   201	        for i in range(len(strips)):
   202	            L = int(lengths[i])
   203	            ids = am[i, :L]
   204	            spans = frames_to_spans(ids, self._decode_atom, scales[i])
   205	            pred = ''.join(c.char for c in spans)
   206	            results.append(Alignment(pred, spans, L, scales[i], widths[i], float(probs[i, :L].mean())))
   207	        return results
