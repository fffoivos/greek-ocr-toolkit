    55	def assert_sf6_hold(result,original):
    56	    assert result['status']=='hold' and result.get('label',original)==original
    57	    assert result['changes']==[]
    58	    assert any(not c['allowed'] for c in result['deletion_checks'])
    59	    assert any(s['detail'].startswith('sf6:deletion_needs_two_positive_absences:') for s in result['hold_slots'])
