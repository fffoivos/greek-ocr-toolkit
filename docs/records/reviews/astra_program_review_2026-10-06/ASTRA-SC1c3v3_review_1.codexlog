   123	    elif defect=='unnamed_a':rt['r1_predictions'][0]['parts']=[]
   124	    elif defect=='unnamed_b':rt['peer_predictions']['B'][0]['parts']=[]
   125	    elif defect=='missing_b':rt['peer_predictions'].pop('B');rt['peer_coverage'].pop('B')
   126	    elif defect=='unscored_a':rt['coverage'][0]['scored']=False
   127	    elif defect=='unscored_b':rt['peer_coverage']['B'][0]['scored']=False
   128	    elif defect=='unknown':rt['coverage'][0]['evidence_state']='UNKNOWN'
   129	    elif defect=='uncertain':rt['peer_coverage']['B'][0]['uncertainty']=['crop_clipped']
   130	    elif defect=='out_of_window_a':rt['coverage'][0]['span']=[-1,10]
   131	    elif defect=='out_of_window_b':rt['peer_coverage']['B'][0]['span']=[10,10]
   132	    elif defect=='clipped':rt['detector']['slots'][0]['evidence']['clipped_top']=True
   133	    elif defect=='unseen':rt['detector']['slots'][0]['evidence']['observation']['above']='UNSEEN'
   134	    elif defect=='lowercase':original='-᾿αλλα';proposal='-ἀλλα';rt=move_runtime(proposal)
   135	    elif defect=='already_attached':original='-᾿Ἀλλα'
   136	    elif defect=='other_boundary':
   137	        original='-᾿ΑΑ';proposal='-ΑἈ';rt=move_runtime(proposal)
   138	        rt.pop('recognition_confidence');rt['detector']['slots'][0]['evidence'].pop('observation')
   139	    elif defect=='duplicate_spacing':original='-᾿᾿Αλλα'
   140	    elif defect=='outside_window':rt['coverage'][0]['span']=[1000,1010]
   141	    elif defect=='missing_window':rt['detector']['slots'][0]['evidence'].pop('window')
   142	    elif defect=='detector_unknown':rt['detector']['slots'][0]['evidence']['evidence_state']='UNKNOWN'
   143	    elif defect=='evidence_uncertain':rt['detector']['slots'][0]['evidence']['uncertainty']=['unresolved']
   144	    elif defect=='clipped_left':rt['detector']['slots'][0]['evidence']['clipped_left']=True
   145	    elif defect=='missing_top_observation':rt['detector']['slots'][0]['evidence'].pop('clipped_top')
   146	    elif defect=='peer_unknown':rt['peer_coverage']['B'][0]['evidence_state']='UNKNOWN'
   147	    o=overlay(policy,original,rt,mode)
   148	    assert o['status']=='hold' and o.get('label',original)==original and o['changes']==[]
   149	    if defect in ('unnamed_a','other_boundary'):
   150	        assert o['deletion_checks']==[]  # composer retains the spacing sign
   151	    else:
   152	        assert any(not c['allowed'] for c in o['deletion_checks'])
   153	    # A direct proposal still cannot turn an unnamed/uncertain reader into
   154	    # positive presence just because the output spells a breathing.
   155	    checks=policy[0].deletion_guard(original,proposal,rt,policy[0].compose_runtime(rt,mode))
   156	    assert any(not c['allowed'] for c in checks)
   157	    assert all(c['reason']=='sf6:deletion_needs_two_positive_absences:'+c['category'] for c in checks if not c['allowed'])
