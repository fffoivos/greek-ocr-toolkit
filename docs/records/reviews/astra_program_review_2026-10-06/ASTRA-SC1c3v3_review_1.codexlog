+def move_runtime(text):
+    rt=rich(text)
+    spans={s['start']:s['locator_span'] for s in rt['detector']['slots']}
+    for records in [rt['coverage'],*rt['peer_coverage'].values()]:
+        for c in records:c['span']=list(spans[c['start']])
+    return rt
+
