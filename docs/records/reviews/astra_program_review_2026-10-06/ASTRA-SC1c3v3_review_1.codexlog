    42	def move_runtime(text):
    43	    rt=rich(text)
    44	    spans={s['start']:s['locator_span'] for s in rt['detector']['slots']}
    45	    for records in [rt['coverage'],*rt['peer_coverage'].values()]:
    46	        for c in records:c['span']=list(spans[c['start']])
    47	    return rt
