   100	def frames_to_spans(ids: np.ndarray, decode_atom, scale: float) -> list[CharSpan]:
   101	    """Greedy CTC path -> spikes -> spans. `ids` are argmax ids for the valid frames."""
   102	    spikes = []   # (id, t0, t1)
   103	    prev = 0
   104	    t0 = 0
   105	    for t, v in enumerate(list(ids) + [0]):
   106	        v = int(v)
   107	        if v != prev:
   108	            if prev != 0:
   109	                spikes.append((prev, t0, t))
   110	            prev, t0 = v, t
   111	    spans: list[CharSpan] = []
   112	    n = len(spikes)
   113	    for k, (v, a, b) in enumerate(spikes):
   114	        left = (spikes[k - 1][2] + a) / 2 if k else max(0.0, a - 1.0)
   115	        right = (b + spikes[k + 1][1]) / 2 if k + 1 < n else b + 1.0
   116	        spans.append(CharSpan(decode_atom(v), k, a, b, left * STRIDE * scale, right * STRIDE * scale))
   117	    return spans
   118	
