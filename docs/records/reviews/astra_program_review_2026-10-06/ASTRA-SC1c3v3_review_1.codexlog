    38	def overlay(record, runtime, variant, binding):
    39	    original = record['label']
    40	    result = dict(line_id=record['id'], original_label_sha256=label_sha(original),
    41	                  changes=[], hold_slots=[], detector_version=binding['detector'],
    42	                  r1_sha=binding['r1_sha256'], policy_sha=binding['policy_sha256'])
    43	    if record['script_class'] != 'greek_poly':
    44	        return dict(result, status='out_of_scope')
    45	    # Never trust previously composed decisions under an older policy.
    46	    mode = compose_runtime(runtime,variant.upper())
    47	    result.update(release_policy=POLICY,evidence_sha256=mode['evidence_sha256'],opening_quotes=mode['opening_quotes'],
    48	        gate_decisions=[{k:s.get(k) for k in ('start','base','label_status','hold_reasons',
    49	            'r1_coverage','segmentation_uncertain','localisation_unknown','unnamed',
    50	            'detector_parts','r1_parts','peer_arm','peer_prediction','peer_coverage','evidence','constraint_flags','apostrophe')}
    51	            for s in mode['slots']])
    52	    for slot in mode['hold_slots']:
    53	        for reason in slot['reasons']:
    54	            result['hold_slots'].append(dict(start=slot['start'], letter=slot['base'],
    55	                reason=hold_reason(reason), detail=reason))
    56	    proposal, census = release_text(original, runtime['recogniser_text'], mode['text'])
    57	    alias_only = (nfd(original)!=nfd(mode['text'])
    58	                  and elision_alias_key(original)==elision_alias_key(mode['text']))
    59	    result.update(alias_only=alias_only,elision_census=census)
    60	    deletions=deletion_guard(original,proposal,runtime,mode)
    61	    result['deletion_checks']=deletions
    62	    for deletion in deletions:
    63	        if not deletion['allowed']:
    64	            result['hold_slots'].append(dict(start=deletion['start'],letter=deletion['character'],
    65	                reason='deletion_uncertain',detail=deletion['reason']))
    66	    for detail in edit_guard(original, runtime['recogniser_text']) + edit_guard(original,proposal):
    67	        result['hold_slots'].append(dict(start=0,letter='',reason='edit_guard',detail=detail))
    68	    if result['hold_slots']:
    69	        return dict(result, status='hold')
    70	    if nfd(original) == nfd(proposal):
    71	        return dict(result, status='unchanged', label=original)
    72	    old, new = nfd(original), nfd(proposal)
    73	    for tag, i, j, lo, hi in SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
    74	        if tag == 'equal':
    75	            continue
    76	        # Evidence is recogniser-indexed; edits are original-label NFD offsets.
    77	        evidence = dict(recogniser_text=runtime['recogniser_text'], agreement=variant,
    78	            slots=[dict(start=s['start'], letter=s['base'], r1_coverage=s.get('r1_coverage'),
    79	                        segmentation_uncertain=s.get('segmentation_uncertain'),localisation_unknown=s.get('localisation_unknown'),
    80	                        hold_reasons=s.get('hold_reasons'),detector_parts=s.get('detector_parts'),
    81	                        r1_parts=s.get('r1_parts'),peer_arm=s.get('peer_arm'),peer_prediction=s.get('peer_prediction'),
    82	                        peer_coverage=s.get('peer_coverage'),locator_span=s.get('locator_span'),
    83	                        mark_probabilities=s.get('mark_probabilities'), evidence=s.get('evidence'))
    84	                   for s in mode['slots']],
    85	            opening_quotes=mode.get('opening_quotes', []), detector_text=runtime['detector']['text'])
    86	        context = i
    87	        if (lo < hi and unicodedata.combining(new[lo])) or (i < j and unicodedata.combining(old[i])):
    88	            context -= 1
    89	        while context >= 0 and context < len(old) and unicodedata.combining(old[context]):
    90	            context -= 1
    91	        letter = old[context] if 0 <= context < len(old) and old[context].isalpha() else ''
    92	        result['changes'].append(dict(start=i, letter=letter,
    93	                                      **{'from': old[i:j], 'to': new[lo:hi]}, evidence=evidence))
    94	    return dict(result, status='corrected', label=proposal)
    95	
    96	
    97	def _overlays(task):
    98	    record,runtime,variants,binding=task
    99	    return runtime['id'],{v:overlay(record,runtime,v,binding) for v in variants}
