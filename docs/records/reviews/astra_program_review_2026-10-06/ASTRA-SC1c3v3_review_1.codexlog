    71	    def span(self, i: int) -> CharSpan:
    72	        return self.spans[i]
    73	
    74	    def window(self, i0: int, i1: int) -> tuple[float, float]:
    75	        """Crop x range covering prediction indices [i0, i1)."""
    76	        s = self.spans[i0:i1]
    77	        return (min(c.x0 for c in s), max(c.x1 for c in s)) if s else (0.0, 0.0)
    78	
    79	    def char_width(self) -> float:
    80	        base = [c.x1 - c.x0 for c in self.spans if not _is_mark(c.char) and c.char != ' ']
    81	        return float(np.median(base)) if base else 0.0
    82	
    83	    def to_record(self) -> dict:
    84	        return dict(prediction=self.prediction, n_frames=self.n_frames, scale=self.scale, strip_width=self.strip_width,
    85	                    confidence=self.confidence,
    86	                    spans=[[c.char, c.frame0, c.frame1, round(c.x0, 1), round(c.x1, 1)] for c in self.spans])
    87	
    88	    @classmethod
    89	    def from_record(cls, r: dict) -> 'Alignment':
    90	        a = cls(r['prediction'], [], r['n_frames'], r['scale'], r['strip_width'], r.get('confidence', 0.0))
    91	        a.spans = [CharSpan(ch, i, f0, f1, x0, x1) for i, (ch, f0, f1, x0, x1) in enumerate(r['spans'])]
    92	        return a
