   162	
   163	
   164	@pytest.mark.parametrize('source',['google','recogniser'])
   165	@pytest.mark.parametrize('detected',[False,True])
   166	def test_single_source_presence_behavior_unchanged_and_counted(policy,source,detected):
   167	    original='κ᾿ α' if source=='google' else 'κ α'
   168	    text='κ α' if source=='google' else "κ' α"
