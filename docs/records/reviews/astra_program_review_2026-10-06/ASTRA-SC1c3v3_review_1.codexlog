    59	@pytest.mark.parametrize('w',INPUTS,ids=[r['cohort']+':'+r['id'] for r in INPUTS])
    60	def test_saved_release_regression(policy,w):
    61	    mode=w.get('mode','ENSEMBLE_AB');o=overlay(policy,w['record']['label'],w['runtime'],mode)
    62	    expected=EXPECTED[w['cohort'],w['id']]
    63	    wanted=('corrected',CAPITAL_MOVES[w['id']]) if w['id'] in CAPITAL_MOVES else (expected['after']['status'],expected['after']['label'])
    64	    assert (o['status'],o.get('label',w['record']['label']))==wanted
    65	    if w['id'] in CAPITAL_MOVES:
    66	        assert len(o['deletion_checks'])==1
    67	        assert o['deletion_checks'][0]['operation']=='MOVE'
    68	        assert o['deletion_checks'][0]['breathing']=='psili'
    69	        assert o['deletion_checks'][0]['allowed'] and o['deletion_checks'][0]['reason'] is None
    70	        assert o['deletion_checks'][0]['signals']==dict(reader=False,detector=False,recogniser=False)
    71	    if w['cohort']=='quote_probe' or (w['cohort']=='sf5' and w['id'] in SF6_HELD):
    72	        assert o['status']=='hold' and o['changes']==[]
    73	    oldgate,oldcommon=baseline()
    74	    old=oldcommon.overlay(w['record'],w['runtime'],mode,BINDING)
    75	    assert (old['status'],old.get('label',w['record']['label']))==(expected['before']['status'],expected['before']['label'])
    76	    assert policy[0].compose_runtime(w['runtime'],mode)['slots']==oldgate.compose_runtime(w['runtime'],mode)['slots']
    77	    if o['status']!='hold':
    78	        assert (o['status'],o['label'])==(old['status'],old['label'])
    79	    elif old['status']!='hold':
    80	        assert o['changes']==[] and any(not c['allowed'] for c in o['deletion_checks'])
