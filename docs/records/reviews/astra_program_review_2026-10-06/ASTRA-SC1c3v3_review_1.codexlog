   180	@pytest.mark.parametrize('original,proposal',[("-᾿Α","-Ἀ"),("-᾽α","-ἀ")])
   181	def test_guard_accepts_only_atomic_spacing_breathing_attachment(policy,original,proposal):
   182	    assert policy[0].edit_guard(original,proposal)==[]
   183	    assert policy[0].edit_guard(original,proposal.replace('Ἀ','Α').replace('ἀ','α'))
