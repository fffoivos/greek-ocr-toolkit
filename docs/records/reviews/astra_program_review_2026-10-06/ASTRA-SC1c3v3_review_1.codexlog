    62	@pytest.mark.parametrize('w',WITNESSES,ids=[r['id'] for r in WITNESSES])
    63	def test_saved_56_release_witnesses(policy,w):
    64	    result=policy[1].overlay(w['record'],w['runtime'],'ensemble_ab',BINDING)
    65	    # SF6 changes only release acceptance. Preserve this exact assertion even
    66	    # for the eight still-held lines, including both known reader mistakes.
    67	    assert policy[0].compose_runtime(w['runtime'],'ENSEMBLE_AB')['slots']==w['sf4_decisions']['slots']
    68	    if policy[0].POLICY=='sf6-release-v1' and w['id'] in SF6_HELD:
    69	        assert_sf6_hold(result,w['record']['label'])
    70	        return
    71	    assert result['status'] in ('corrected','unchanged')
    72	    actual=result['label']
    73	    if w['kind'].startswith('known_reader_'):
    74	        # Precision counterexamples remain wrong; SF5 must not change them.
    75	        assert actual==w['before'] and result['status']=='corrected'
    76	    elif w['kind']=='capital_breathing':
    77	        assert actual==w['before'].replace("-'Ἀ",'-Ἀ')
    78	    else:
    79	        from greekocr.labelfix.text import punctuation_sites
    80	        both=punctuation_sites(w['record']['label']).keys() & punctuation_sites(w['runtime']['recogniser_text']).keys()
    81	        if both:
    82	            assert both<=punctuation_sites(actual).keys()
    83	        else:
    84	            # One seeded line has only Google's mark. Its deletion is outside
    85	            # the consensus rule and must retain SF4 behavior, with a census.
    86	            assert actual==w['before']
    87	            assert result['elision_census']['google_only_deleted']==1
    88	    # All mark sets, decision reasons and saved physical records are retained.
    89	    assert policy[0].compose_runtime(w['runtime'],'ENSEMBLE_AB')['slots']==w['sf4_decisions']['slots']
