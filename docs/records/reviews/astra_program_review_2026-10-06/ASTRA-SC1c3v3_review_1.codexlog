+    old_test=subprocess.check_output(['git','show','05f2dafb:tests/labelfix/test_sf5.py'],text=True)
+    now_test=Path('tests/labelfix/test_sf5.py').read_text()
+    oldf,newf=funcs(old_test),funcs(now_test)
