    62	@dataclass
    63	class Alignment:
    64	    prediction: str
    65	    spans: list = field(default_factory=list)   # CharSpan per decoded codepoint
    66	    n_frames: int = 0
    67	    scale: float = 1.0                          # crop px per strip px
    68	    strip_width: int = 0
    69	    confidence: float = 0.0
