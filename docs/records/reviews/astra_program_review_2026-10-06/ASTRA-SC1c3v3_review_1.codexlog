   115	def test_non_move_keeps_exact_sf6_hold(policy,mode,defect):
   116	    original='-᾿Αλλα';proposal='-Ἀλλα';rt=move_runtime(proposal)
   117	    if defect=='mismatched_kind':
   118	        proposal='-Ἁλλα';rt=move_runtime(proposal)
   119	        # No second positive psili-absence signal: a different breathing
   120	        # cannot itself bypass SF6. Valid two-absence deletions stay unchanged.
