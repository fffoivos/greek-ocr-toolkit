   410	def _reader_reasons(slot, prediction, coverage, prefix):
   411	    reasons=[]
   412	    if prediction is None:reasons.append(prefix+'_missing')
   413	    elif not ('parts' in prediction or 'cls' in prediction):reasons.append(prefix+'_prediction_invalid')
   414	    if prediction and prediction.get('base',slot['base'])!=slot['base']:reasons.append(prefix+'_base_mismatch')
   415	    if coverage is None:reasons.append(prefix+'_missing_coverage')
   416	    else:
   417	        if coverage.get('base',slot['base'])!=slot['base']:reasons.append(prefix+'_coverage_base_mismatch')
   418	        if coverage.get('scored') is not True:reasons.append(prefix+'_unscored:'+str(coverage.get('reason')))
   419	        if coverage.get('evidence_state') in (None,'UNKNOWN'):reasons.append(prefix+'_evidence_UNKNOWN')
   420	        if not isinstance(coverage.get('uncertainty'),(list,tuple)):
   421	            reasons.append(prefix+'_uncertainty_not_recorded')
   422	        else:reasons.extend(prefix+'_uncertainty:'+str(z) for z in coverage['uncertainty'])
   423	    if prediction is not None:
   424	        if prediction.get('evidence_state')=='UNKNOWN':reasons.append(prefix+'_evidence_UNKNOWN')
   425	        reasons.extend(prefix+'_uncertainty:'+str(z) for z in (prediction.get('uncertainty') or ()))
   426	        parts=prediction.get('parts',prediction.get('cls','none').split('+'))
   427	        if any(p not in R.MARKS and p!='none' for p in parts):reasons.append(prefix+'_unsupported_mark')
   428	    return reasons
