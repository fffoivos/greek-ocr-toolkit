   152	def heldout():
   153	    from scripts.labelfix.clariden.l1e_measure import score_line
   154	    decisions=DOC/'SF5_evidence/heldout/decisions.jsonl.gz'
   155	    checked(decisions,DOC/'SF5_evidence/heldout/receipt.json')
   156	    frozen=list(rows(decisions));det={r['line_id']:r for r in rows(DOC/'S6_lines.jsonl.gz') if not r['dev']}
   157	    sources={r['line_id']:r for r in rows(DOC/'R0_evidence/continuity_666.jsonl')}
   158	    truth={r['line_id']:r for r in rows(DOC/'S4_lines.jsonl.gz') if not r['dev']}
   159	    assert len(frozen)==666 and {r['id'] for r in frozen}==set(det)==set(sources)==set(truth)
   160	    oldgate,_=baseline();result=[];totals={p:{m:Counter() for m in gate.MODES} for p in ('before','after')}
   161	    predictions={}
   162	    for r in rows('artifacts/labelfix_r1/output_3678928/A/heldout_predictions.jsonl'):
   163	        predictions.setdefault(r['line_id'],[]).append(r)
   164	    slot_changes=[];proof=[]
   165	    for line in frozen:
   166	        lid=line['id'];s6=det[lid];rec=s6['recogniser_text'];google=sources[lid]['google']
   167	        rt=dict(recogniser_text=rec,r1_predictions=predictions.get(lid,[]),coverage=[],
   168	            detector=dict(text=s6['reading'],slots=s6['recogniser_slots'],
   169	                opening_quotes=s6.get('opening_quotes',[]),constraint_flags=s6.get('reading_flags',[])))
   170	        after_decisions=deepcopy(line['decisions'])
   171	        for mode in gate.MODES:
   172	            d=dict(line['decisions'][mode],mode=mode)
   173	            before=effective(google,rec,d,oldgate)
   174	            after=effective(google,rec,d,gate,rt)
   175	            checks=after['deletion_checks']
   176	            result.append(dict(id=lid,mode=mode,google=google,recogniser=rec,
   177	                before=before,after=after,checks=checks))
   178	            assert before['proposal']==after['proposal']
   179	            # Keep the original slot instrument, then apply ONLY SF6's added
   180	            # whole-line veto. Existing SF5 slot and line vetoes are unchanged.
   181	            if any(not c['allowed'] for c in checks):
   182	                d2=after_decisions[mode]
   183	                for s in d2['slots']:s['hold_reasons']=[*s['hold_reasons'],'sf6:line_deletion_hold']
   184	                d2['hold_slots']=[*d2['hold_slots'],dict(start=0,reasons=['sf6:line_deletion_hold'])]
   185	            proof.extend(dict(id=lid,mode=mode,start=s['start'],slot_identical=True) for s in d['slots'])
   186	        before_counts,before_events=score_line(truth[lid],google,rt,decisions=line['decisions'])
   187	        after_counts,after_events=score_line(truth[lid],google,rt,decisions=after_decisions)
   188	        for mode in gate.MODES:
   189	            totals['before'][mode].update(before_counts[mode]);totals['after'][mode].update(after_counts[mode])
   190	            for a,b in zip(before_events[mode],after_events[mode]):
   191	                if a!=b:slot_changes.append(dict(id=lid,mode=mode,before=a,after=b))
   192	    ref=json.loads((DOC/'SF5_evidence/heldout/metrics.json').read_text())
   193	    assert {m:dict(c) for m,c in totals['before'].items()}==ref['mark_rows']['after']
   194	    # Exact parity of SF5 effective labels/statuses, not just aggregate counts.
   195	    ref_labels={(r['id'],r['mode']):r for r in rows(DOC/'SF5_evidence/heldout/release_labels.jsonl.gz') if r['phase']=='after'}
   196	    for r in result:
   197	        prior=ref_labels[r['id'],r['mode']]
   198	        assert all(r['before'][k]==prior[k] for k in ('status','label','proposal')),r['id']
   199	    models={lid:r['model'] for lid,r in sources.items()};sites=sf5.elision_truth(set(sources));elision={}
   200	    for phase in totals:
   201	        elision[phase]={m:sf5.score_elisions(sites,{r['id']:r[phase]['label'] for r in result if r['mode']==m},models)[0] for m in gate.MODES}
   202	    dest=EV/'heldout';dest.mkdir(exist_ok=True)
   203	    write_rows(dest/'release_labels.jsonl.gz',result);write_rows(dest/'per_slot_changes.jsonl',slot_changes)
   204	    write_rows(dest/'per_slot_proof.jsonl.gz',proof)
   205	    write_json(dest/'metrics.json',dict(marks={p:{m:dict(c) for m,c in q.items()} for p,q in totals.items()},

