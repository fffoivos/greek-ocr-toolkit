    24	def rich(text):
    25	    """Explicitly scored, fully observed fixture; never production evidence."""
    26	    rt=synthetic(text)
    27	    rt['recognition_confidence']=.9
    28	    for i,s in enumerate(rt['detector']['slots']):
    29	        s.update(locator_span=[10+i*10,18+i*10],word_final=True)
    30	        s['evidence'].update(window=[8+i*10,20+i*10],above=[],below=[],apostrophes=[],
    31	            clipped_left=False,clipped_right=False,
    32	            observation={z:'OBSERVED' for z in ('above','below','left','right')})
    33	    for cov in [rt['coverage'],*rt['peer_coverage'].values()]:
    34	        for c in cov:c['span']=[10+c['start']*10,18+c['start']*10]
    35	    return rt
