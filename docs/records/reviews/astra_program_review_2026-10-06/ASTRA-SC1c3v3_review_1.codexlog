   170	    expected=('κ᾿ α' if source=='google' else 'κ’ α') if detected else 'κ α'
   171	    if policy[0].POLICY=='sf6-release-v1' and source=='google' and not detected:
   172	        assert_sf6_hold(result,original)
   173	        assert result['deletion_checks'][0]['category']=='apostrophe'
   174	    else:assert result['label']==expected
   175	    c=result['elision_census']
