+            want = [(p['start'], p['base']) for p in r['r1_predictions']]
+            if len(want) != len(set(want)):
+                raise ValueError('duplicate A prediction')
+            for arm in ('B', 'E'):
+                ps = r.get('peer_predictions', {}).get(arm)
