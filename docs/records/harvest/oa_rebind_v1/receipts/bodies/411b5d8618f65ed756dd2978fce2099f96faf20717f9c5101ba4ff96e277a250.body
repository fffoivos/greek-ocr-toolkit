<meta name="DCTERMS.dateAccepted" content="2012-02-22T10:01:40Z" scheme="DCTERMS.W3CDTF" />
<meta name="DCTERMS.available" content="2012-02-22T10:01:40Z" scheme="DCTERMS.W3CDTF" />
<meta name="DCTERMS.issued" content="2012" xml:lang="el" scheme="DCTERMS.W3CDTF" />
<meta name="DC.identifier" content="http://dspace.lib.uom.gr/handle/2159/14790" scheme="DCTERMS.URI" />
<meta name="DC.description" content="Διπλωματική εργασία--Πανεπιστήμιο Μακεδονίας, Θεσσαλονίκη, 2012." xml:lang="el" />
<meta name="DCTERMS.abstract" content="Ο κύριος σκοπός της παρούσας εργασίας είναι να διερευνήσει και να ερμηνεύσει τις συνθήκες κάτω από τις οποίες εμφανίστηκε η οικονομική κρίση στην ελληνική και παγκόσμια οικονομία με ιδιαίτερη έμφαση στον τραπεζικό κλάδο. Αναπτύσσεται και ξεδιπλώνεται ο πολύπλοκος ρόλος των τραπεζών που είναι σε άμεση εξάρτηση με την απαρχή και την εξέλιξη της κρίσης αυτής. Εξετάζονται τόσο οι λόγοι που οδήγησαν στην εκδήλωση της κρίσης αλλά και τα πολλαπλά αρνητικά αποτελέσματα που αυτή έχει αποφέρει στην ελληνική και παγκόσμια πραγματικότητα." xml:lang="el" />
<meta name="DCTERMS.extent" content="86" xml:lang="el" />
