<meta name="DC.creator" content="Καραμπατζάκης, Στέφανος" xml:lang="el" />
<meta name="DCTERMS.dateAccepted" content="2012-05-03T11:33:05Z" scheme="DCTERMS.W3CDTF" />
<meta name="DCTERMS.available" content="2012-05-03T11:33:05Z" scheme="DCTERMS.W3CDTF" />
<meta name="DCTERMS.issued" content="2011" xml:lang="el" scheme="DCTERMS.W3CDTF" />
<meta name="DC.identifier" content="http://dspace.lib.uom.gr/handle/2159/14904" scheme="DCTERMS.URI" />
<meta name="DC.description" content="Διπλωματική εργασία--Πανεπιστήμιο Μακεδονίας, Θεσσαλονίκη, 2011." xml:lang="el" />
<meta name="DCTERMS.abstract" content="Οι αλματώδης εξελίξεις  στο χώρο των τηλεπικοινωνιών τα τελευταία χρόνια έχουν αντίκτυπο στη καθημερινότητα τόσο των επιχειρήσεων όσο και των απλών χρηστών. Συνεχείς νέες ιδέες και τεχνολογικές ευρεσιτεχνίες καθιστούν το χώρο των ασυρμάτων και φορητών επικοινωνιών ως τον ταχύτερα αναπτυσσόμενο τομέα των νέων τεχνολογιών. Η φυσική θέση και ο χρόνος έχουν πλέον μικρή σημασία και δεν αποτελούν ανασταλτικούς παράγοντες. Η παρούσα μεταπτυχιακή διπλωματική εργασία επικεντρώνεται στην παρουσίαση των δυνατοτήτων που παρέχουν οι υπηρεσίες και οι εφαρμογές που έχουν αναπτυχθεί στο κινητό εμπόριο. Γίνεται μια προσπάθεια να επικεντρωθούμε σε θέματα ποιότητας υπηρεσιών που παρέχονται ή που θα πρέπει να παρέχονται στο κινητό εμπόριο. Επιχειρείται μια αξιολόγηση της ηλεκτρονικής ποιότητας υπηρεσιών που υφίσταται στο κινητό εμπόριο παρουσιάζοντας τα μοντέλα SERVQUAL και e-SQ. Τέλος θέλοντας το τελικό αποτέλεσμα της εργασίας να είναι αντιπροσωπευτικό της πραγματικότητας, επιλέγεται πρόσφατη βιβλιογραφία για την ανάπτυξη του θεωρητικού υπόβαθρού και των παραδειγμάτων που παρουσιάζονται." xml:lang="el" />
<meta name="DCTERMS.extent" content="88" xml:lang="el" />
<meta name="DCTERMS.extent" content="1308858 bytes" />
