<meta name="DC.contributor" content="Καραγιώργος, Θεοφάνης" xml:lang="el" />
<meta name="DC.creator" content="Λαϊτσου, Ιωάννα" xml:lang="el" />
<meta name="DCTERMS.dateAccepted" content="2011-03-21T07:38:38Z" scheme="DCTERMS.W3CDTF" />
<meta name="DCTERMS.available" content="2011-03-21T07:38:38Z" scheme="DCTERMS.W3CDTF" />
<meta name="DCTERMS.issued" content="2011" xml:lang="en" scheme="DCTERMS.W3CDTF" />
<meta name="DC.identifier" content="http://dspace.lib.uom.gr/handle/2159/14311" xml:lang="en" scheme="DCTERMS.URI" />
<meta name="DC.description" content="Διπλωματική εργασία--Πανεπιστήμιο Μακεδονίας, Θεσσαλονίκη, 2011." xml:lang="el" />
<meta name="DCTERMS.abstract" content="Η παρούσα εργασία πραγματεύεται τον εσωτερικό έλεγχο μεμονωμένα, αλλά και σε συνδυασμό με τα πληροφοριακά συστήματα. Στα πλαίσια αυτής της εργασίας, πέρα από τη βιβλιογραφική επισκόπηση που διεξήχθη και μέσα από την οποία θίγονται σημαντικά ζητήματα σχετικά με την σπουδαιότητα και αποτελεσματικότητα του ελέγχου, πραγματοποιήθηκε έρευνα, με σκοπό τη διερεύνηση της ύπαρξης του εσωτερικού ελέγχου και ιδιαίτερα συστημάτων εσωτερικού ελέγχου, στα πλαίσια των ελληνικών επιχειρήσεων. Η συλλογή των πρωτογενών δεδομένων πραγματοποιήθηκε μέσω ερωτηματολογίου σε ένα τυχαίο δείγμα 43 εισηγμένων εταιρειών. Για την ποσοτική ανάλυση των δεδομένων χρησιμοποιήθηκε το λογισμικό στατιστικό πακέτο SPSS 17.0. Τα ευρήματα μας καθοδηγούν στην εξαγωγή συμπερασμάτων για τη βελτίωση του εσωτερικού ελέγχου και την πληροφοριακή οργάνωση συστημάτων εσωτερικού ελέγχου." xml:lang="el" />
<meta name="DCTERMS.extent" content="94" xml:lang="en" />
<meta name="DCTERMS.extent" content="1389036 bytes" />
<meta name="DC.format" content="application/pdf" />
