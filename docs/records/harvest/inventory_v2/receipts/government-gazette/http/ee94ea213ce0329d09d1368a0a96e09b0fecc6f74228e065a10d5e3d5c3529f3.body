<script>
jQuery( function ( $ ) {
	// Focus styles for menus when using keyboard navigation

	// Properly update the ARIA states on focus (keyboard) and mouse over events
	$( 'nav > ul' ).on( 'focus.wparia  mouseenter.wparia', '[aria-haspopup="true"]', function ( ev ) {
		$( ev.currentTarget ).attr( 'aria-expanded', true );
	} );

	// Properly update the ARIA states on blur (keyboard) and mouse out events
	$( 'nav > ul' ).on( 'blur.wparia  mouseleave.wparia', '[aria-haspopup="true"]', function ( ev ) {
		$( ev.currentTarget ).attr( 'aria-expanded', false );
	} );
} );

jQuery(document).ready(function($) {
	$(".sub-menu li a").focus(function() {
		$(this).parents('li').last().addClass("focus");
	}).blur(function() {
		$(this).parents('li').last().removeClass("focus");
	})
});

jQuery(document).ready(function($) {
	
	$(".head-user-menu li a").focus(function() {
		 $(".header-user-name").addClass("hu-menu-visdec");
		 $(".head-user-menu").addClass("hu-menu-vis");
	}).blur(function() {
		 $(".header-user-name").removeClass("hu-menu-visdec");
		 $(".head-user-menu").removeClass("hu-menu-vis");
	})	
	
	
});
	
jQuery(document).ready(function($) {
	
	$(".pojo-a11y-toolbar-items li a").focus(function() {
		$(".pojo-a11y-toolbar-right").addClass("pojo-a11y-toolbar-open");
	}).blur(function() {
		$(".pojo-a11y-toolbar-right").removeClass("pojo-a11y-toolbar-open");
	})	
	
});	

jQuery(document).ready(function($) {
	$(".logreg-modal-open").attr('tabindex','0', 'tabindex','0');
	$(".logreg-modal-open").attr('role', 'button');
	$(".logreg-modal-open").attr('aria-pressed', 'false');
	
	 $(".logreg-modal-open").on('keydown', function (e) {
      if (e.keyCode === 13 || e.keyCode === 32) {
        e.preventDefault();
         $(".logreg-modal-open").click();
		  $(".ctb-modal-close").focus();
      }
    });

});
	

	



</script>
