 
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Page Not Found</title>

 	
<META http-equiv="pragma" content="no-cache" />
<META http-equiv="cache-control" content="no-cache" />
<META http-equiv="Expires" content="-1" />
<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1">

<link rel="icon" href="/export/system/modules/rs.nbs.opencms.template/resources/resources2/img/logo.png" type="image/x-icon" />
<link rel="shortcut icon" href="/export/system/modules/rs.nbs.opencms.template/resources/resources2/img/logo.png" type="image/x-icon"/>




<link href="/export/system/modules/rs.nbs.opencms.template/resources/resources2/css2/bootstrap.css"rel="stylesheet"/>
<link href="/export/system/modules/rs.nbs.opencms.template/resources/resources2/css2/hov.css" rel="stylesheet"/>
<link href="/export/system/modules/rs.nbs.opencms.template/resources/resources2/font-awesome/css/font-awesome.css" rel="stylesheet"/>
<link href="/export/system/modules/rs.nbs.opencms.template/resources/resources2/css2/scrolling.css" rel="stylesheet"/>
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.4.1/css/all.css" integrity="sha384-5sAR7xN1Nv6T6+dT2mhtzEpVJvfS3NScPQTrOxhwjIuvcA67KV2R5Jz6kr4abQsz" crossorigin="anonymous">
<link href="http://fonts.googleapis.com/css?family=Play:400,700" rel="stylesheet">

<!-- JavaScript iz template-a ide poslednji, tj. posle Javascripta iz contenta! -->
<script src="/export/system/modules/rs.nbs.opencms.template/resources/resources2/js/canvasjs.min.js"></script>
<script src="/export/system/modules/rs.nbs.opencms.template/resources/resources2/js/jquery.js"></script>
<script src="/export/system/modules/rs.nbs.opencms.template/resources/resources2/js/bootstrap.js"></script>

<link href="/export/system/modules/rs.nbs.opencms.template/resources/resources2/css2/site.css" rel="stylesheet"/>



<script lang="JavaScript">

function redirecting() {

var host = "https://"+window.location.hostname;


	try {
		lastPage = history.previous;
	} catch (err1) {
		lastPage = " ";
	}
	if (lastPage == undefined || lastPage == "" || lastPage == " ") {
		try {
			lastPage = document.referrer;
		} catch (err2) {
			lastPage = " ";
		}
	}
	if (lastPage == undefined || lastPage == "") {
		lastPage = " ";
	}
	currentPage = document.URL;
	
var test_nbs = false;
	var test_nbsEnglish = false;
	var test_nbsLatinica = false;
	var test_nbsCirilica = false;
	if (lastPage != null) {
		test_nbs = (lastPage.indexOf(host) >= 0);
		
		test_nbsEnglish = (currentPage.indexOf("/en/") >= 0);
		test_nbsLatinica = (currentPage.indexOf("/sr/") >= 0);
		test_nbsCirilica = (currentPage.indexOf("/sr_RS/") >= 0);
	}
	if (test_nbs) {
		window.location= host;
	} else if (test_nbsEnglish) {
		window.location= host+"/en/indeks/";
	} else if (test_nbsLatinica) {
		window.location=host+"/sr/indeks/";
	} else if (test_nbsCirilica) {
		window.location=host+"/sr_RS/indeks/";
	} else {
		window.location=host+ "/sr_RS/indeks/";
	}
	return true;
}

</script>
</head>
<body onLoad="setTimeout('redirecting()',5000);">
    <div class="section">
<div class="container">
<div class="row">
<div class="col-lg-12 col-md-12 box error text-center">
        <header>
          <img style="margin-left: auto;margin-right: auto;" src="/export/system/modules/rs.nbs.opencms.template/resources/resources2/img/logo.png" width="200" height="200" class="hidden-xs">
      <img style="margin-left: auto;margin-right: auto;" src="/export/system/modules/rs.nbs.opencms.template/resources/resources2/img/logo_mini.png"  width="100" height="100" class="hidden-sm hidden-md hidden-lg">		
			<!-- Status error messages start -->
		
			<h1> ERROR 404</h1>
			<h2>Page Not Found <i class="fas fa-reply"></i></h2>
		</header>
		<main>
	
	<p>Tražena strana ne postoji ili trenutno nije dostupna. Za 5 sekundi ćete biti preusmereni na prethodnu/početnu stranicu.</p>
      <p>The requested page is missing or temporarily not available. In 5 seconds you will be redirected to previous/home page.</p>
		
			
		</main>
        <footer>
           
        </footer>
    </div>
	</div>
	</div>
	</div>
	<script src="js/bootstrap.js"></script>
</body>
</html>