 υλικού, έχουν άμεση σχέση διασύνδεσης με το φυσικό τεκμήριο και την ιστορική / πολιτιστική / ερευνητική του αξία. Μόνο μεταδεδομένα διασύνδεσης ευρετηριάζονται και παρέχονται από την Πέργαμο στο διαδίκτυο (και κατ' επέκταση καθίστανται ορατά και σε παντός είδους συσσωρευτές περιεχομένου και μηχανές αναζήτησης)."}),(0,a.jsxs)("p",{style:{textAlign:"justify"},children:["Περισσότερες πληροφορίες, σχετικά και με την ",(0,a.jsx)("b",{children:"πολιτική"})," του ",(0,a.jsx)("b",{children:"ΕΚΠΑ"})," για την προστασία των προσωπικών δεδομένων, μπορείτε να βρείτε στο σύνδεσμο:",(0,a.jsx)("br",{}),(0,a.jsx)(ed.x,{href:"https://www.uoa.gr/to_panepistimio/prostasia_prosopikon_dedomenon/",newtab:!0,children:"https://www.uoa.gr/to_panepistimio/prostasia_prosopikon_dedomenon/"}),"."]}),(0,a.jsxs)("p",{style:{textAlign:"justify"},children:['Για τυχόν τεχνικά ζητήματα ή απορίες για τα οποία δεν μπορείτε να βρείτε λύση από την ενότητα "',(0,a.jsx)(ed.x,{href:"https://pergamos.lib.uoa.gr/uoa/dl/frontend/el/faq.html",newtab:!0,children:"Βοήθεια"}),'" της Περγάμου, μπορείτε να δημιουργείτε σχετικό αίτημα υποστήριξης μέσω του'," ",(0,a.jsx)(ed.x,{href:"https://helpdesk.lib.uoa.gr/index.php?lang=el_EL",newtab:!0,children:(0,a.jsx)("i",{children:(0,a.jsx)("b",{children:"Helpdesk"})})})," ",'(επιλέγοντας "Πέργαμος" σαν το ',(0,a.jsx)("b",{children:"Είδος προβλήματος"}),") ή να επικοινωνείτε με το"," ",(0,a.jsx)(ed.x,{href:"http://www.lib.uoa.gr/plirofories/ypologistiko-kentro-bibliothikon.html",newtab:!0,children:"Υπολογιστικό Κέντρο Βιβλιοθηκών"}),"."]})]})}function s$(){return(0,a.jsxs)(a.Fragment,{children:[(0,a.jsxs)("p",{style:{textAlign:"justify"},children:[(0,a.jsx)("b",{children:"Pergamos"})," uses ",(0,a.jsx)("i",{children:"cookies"})," to provide a richer user experience to members of the NKUA Academic Community, through personalized services (provided only to successfully authenticated users). By using it, you also accept the use of cookies."]}),(0,a.jsx)("p",{style:{textAlign:"justify"},children:"Personal data (such as names of creators or contributors) that may be entered into the platform in the context of self-deposit or documentation of items, are used exclusively for the correct interconnection between the digital object and its creators and contributors or for communicating with them if necessary. Additional references to individuals, in the context of the metadata documentation process, are strictly related to interconnecting the documented item and its historical / cultural / research value. Only interconnection metadata are indexed and served by Pergamos on the Internet (and consequently become visible to all types of metadata harvesters and search engines)."}),(0,a.jsxs)("p",{style:{textAlign:"justify"},children:["For more information on the ",(0,a.jsx)("b",{children:"NKUA"})," privacy policy, please visit:",(0,a.jsx)("br",{}),(0,a.jsx)(ed.x,{href:"https://en.uoa.gr/about_us/personal_data_protection_policy/",newtab:!0,children:"https://en.uoa.gr/about_us/personal_data_protection_policy/"}),"."]}),(0,a.jsxs)("p",{style:{textAlign:"justify"},children:['For any technical issues or questions that cannot be resolved in the "',(0,a.jsx)(ed.x,{href:"https://pergamos.lib.uoa.gr/uoa/dl/frontend/el/faq.html",newtab:!0,children:"Help"}),'" section of Pergamos, you can open a support ticket on our'," ",(0,a.jsx)(ed.x,{href:"https://helpdesk.lib.uoa.gr/index.php?lang=el_EL",newtab:!0,children:(0,a.jsx)("i",{children:(0,a.jsx)("b",{children:"Helpdesk"})})})," ",'(make sure you select "Pergamos" as the ',(0,a.jsx)("b",{children:"Topic"}),") or contact the"," ",(0,a.jsx)(ed.x,{href:"http://www.lib.uoa.gr/plirofories/ypologistiko-kentro-bibliothikon.html",newtab:!0,children:"Libraries Computer Center"}),"."]})]})}function sQ(){let e=(0,s.useContext)(r.PageContext),{locale:t}=(0,r.useTranslation)(),i=(0,U.F)("up","md"),n=e.title[t];return(0,a.jsxs)(a.Fragment,{children:[i&&(0,a.jsx)(en.Z,{component:"h2",variant:"h5",mb:2,children:n}),(0,a.jsx)("el"===t?s0:s1,{})]})}function s0(){return(0,a.jsxs)(a.Fragment,{children:[(0,a.jsxs)("p",{style:{textAlign:"justify"},children:["Η \xabΠέργαμος\xbb στο παρελθόν είχε αναπτυχθεί ως ένα ολοκληρωμένο Σύστημα Ψηφιακής Βιβλιοθήκης για την ομοιόμορφη διαχείριση, τεκμηρίωση, διατήρηση και ανάδειξη ετερογενών ψηφιακών συλλογών. Η ανάπτυξή της είχε ενταχθεί σε μια ενιαία στρατηγική ψηφιακής βιβλιοθήκης, η οποία υλοποιήθηκε από το"," ",(0,a.jsx)(ed.x,{href:"https://www.lib.uoa.gr/plirofories/ypologistiko-kentro-bibliothikon.html",newtab:!0,sx:{wordBreak:"break-word"},children:"Υπολογιστικό Κέντρο Βιβλιοθηκών"})," ","(YKB) στο πλαίσιο του έργου \xabΕμπλουτισμός και Αναβάθμιση της Βιβλιοθήκης του Πανεπιστημίου Αθηνών\xbb του Β' ΕΠΕΑΕΚ (επιστημονικός υπεύθυνος: Καθηγητής Μιχάλης Δερμιτζάκης). Το έργο προέβλεπε την ανάπτυξη, έως το τέλος του 2008, δέκα (10) ψηφιακών συλλογών προερχόμενων από βιβλιοθήκες, αρχεία ή μουσεία του Πανεπιστημίου Αθηνών."," "]}),(0,a.jsx)("p",{style:{textAlign:"justify"},children:"Το ΥΚΒ, μέσω της ανάπτυξης της \xabΠεργάμου\xbb, υλοποίησε τον βασικό στρατηγικό του στόχο: συγκέντρωση των συλλογών σε ένα ενιαίο σύστημα ψηφιακής βιβλιοθήκης και παρουσίασή τους στο διαδίκτυο με ομοιόμορφο, αλλά ευέλικτο τρόπο. Ο στόχος αυτός διαφυλάσσει την αποτελεσματική διαχείριση των συλλογών και την ανάδειξή τους ως συστατικά μέρη μιας κεντρικής ψηφιακής βιβλιοθήκης, προσφέροντας ταυτόχρονα σημαντικές εγγυήσεις για την εξασφάλιση της βιωσιμότητάς τους σε βάθος χρόνου."}),(0,a.jsx)("p",{style:{textAlign:"justify"},children:"Η ίδια λογική ακολουθήθηκε επιτυχώς και στην υλοποίηση των έργων \xabΨηφιακή Συλλογή του Ιστορικού Αρχείου του ΕΚΠΑ\xbb και \xabΨηφιακή Συλλογή Μουσικής Βιβλιοθήκης Ψάχου\xbb του Επιχειρησιακού Προγράμματος \xabΚοινωνία της Πληροφορίας\xbb, Μέτρο 1.3: \xabΤεκμηρίωση, Αξιοποίηση και Ανάδειξη του Ελληνικού Πολιτισμού\xbb, Πρόσκληση 65 (Επιστημονικός Υπεύθυνος: Καθηγητής Μιχάλης Δερμιτζάκης). Η ψηφιακή συλλογή του Ιστορικού Αρχείου ήταν, μάλιστα, η πρώτη συλλογή που αναρτήθηκε στην \xabΠέργαμο\xbb (Δεκέμβριος 2006)."}),(0,a.jsxs)("p",{style:{textAlign:"justify"},children:["Συνεχίζοντας στο ίδιο πλαίσιο ψηφιακής πολιτικής, προχώρησε ο σχεδιασμός και η υλοποίηση της νέας \xabΠεργάμου\xbb, με τη μορφή πλέον ενός Ιδρυματικού Αποθετηρίου (ΙΑ). Η νέα πλατφόρμα αναπτύχθηκε στο πλαίσιο της Πράξης \xabΔημιουργία Ενιαίας πλατφόρμας Ψηφιακού Αποθετηρίου και συναφών ηλεκτρονικών υπηρεσιών πληροφόρησης και ανάδειξης περιεχομένου για τη βιβλιοθήκη του ΕΚΠΑ\xbb (κωδικός ΟΠΣ 304160) του Επιχειρησιακού Προγράμματος Ψηφιακή Σύγκλιση του ΕΣΠΑ 2007-2013, με τη συγχρηματοδότηση της Ελλάδας και της Ευρωπαϊκής Ένωσης (ανάδοχος εταιρεία ήταν η"," ",(0,a.jsx)(ed.x,{href:"http://www.unisystems.gr",newtab:!0,children:"UniSystems"}),", η ανάπτυξη του λογισμικού Ιδρυματικού Αποθετηρίου / Ψηφιακής Βιβλιοθήκης πραγματοποιήθηκε από την εταιρεία"," ",(0,a.jsx)(ed.x,{href:"http://www.niovity.com/",newtab:!0,children:"Niovity"}),", ενώ η διαχείριση, η επιμέλεια και η τεκμηρίωση του υλικού έγινε από τη"," ",(0,a.jsx)(ed.x,{href:"http://www.lib.uoa.gr",newtab:!0,children:"Βιβλιοθήκη και Κέντρο Πληροφόρησης/ΒΚΠ"})," ","του ΕΚΠΑ). Στο πλαίσιο του έργου, το ΥΚΒ σε συνεργασία με τη ΒΚΠ συνέχισε και επέκτεινε την αρχική επιλογή, υλοποιώντας πλέον τη συγκέντρωση όχι μόνο των πολιτιστικών συλλογών του ΕΚΠΑ, αλλά και της ευρύτερης πνευματικής και ερευνητικής δραστηριότητας του Ιδρύματος, σε ένα ενιαίο σύστημα Ψηφιακής Βιβλιοθήκης και Ιδρυματικού Αποθετηρίου."]}),(0,a.jsxs)("p",{style:{textAlign:"justify"},children:["Στη βάση της νέας στρατηγικής πολιτικής του ΙΑ το ΥΚΒ, σε συνεργασία με τη ΒΚΠ, ουσιαστικά συνεχίζει να εμπλουτίζει και να υποστηρίζει τεχνικά την Πέργαμο, παρέχοντας καθοδήγηση και ψηφιακές υπηρεσίες, όπως συντήρηση του λογισμικού, ανάπτυξη των κατάλληλων μεταδεδομένων, αποθήκευση και διατήρηση του ψηφιακού υλικού, φροντίζοντας ταυτόχρονα για την προώθηση και την παρουσίασή τους στο διαδίκτυο, σύμφωνα με σύγχρονες τεχνικές και πρακτικές. Επομένως, η"," ",(0,a.jsx)("i",{children:"\xabΠέργαμος\xbb "}),"θεωρείται ένα ",(0,a.jsx)("i",{children:"\xabΑξιόπιστο Ψηφιακό Αποθετήριο\xbb,"})," το οποίο χαρακτηρίζεται από συνέπεια και ομοιομορφία και το οποίο εξασφαλίζει την αποτελεσματική διαχείριση των ψηφιακών συλλογών και τη βιωσιμότητά τους σε βάθος χρόνου."]})]})}function s1(){return(0,a.jsxs)(a.Fragment,{children:[(0,a.jsxs)("p",{style:{textAlign:"justify"},children:["Pergamos had originally been developed as an integrated Digital Library System (DLS) for the uniform management, documentation, preservation and promotion of heterogeneous digital collections. Its development was incorporated into a single digital library strategy, implemented by the"," ",(0,a.jsx)(ed.x,{href:"https://www-en.lib.uoa.gr/information/libraries-computer-center.html",newtab:!0,sx:{wordBreak:"break-word"},children:"Libraries Computer Center"})," ","(LCC) in the context of the project 'Enrichment and Upgrade of the University of Athens Library' of the 2nd “EPEAEK” (Scientific Director: Prof. M. Dermitzakis). The project envisioned the development, by the end of 2008, of ten (10) digital collections from libraries, archives or museums of the University of Athens."]}),(0,a.jsx)("p",{style:{textAlign:"justify"},children:"LCC, through the development of Pergamos, has achieved its basic strategic goal: to bring the various collections together into a single digital library system and present them online in a uniform but flexible way. This objective safeguards the efficient management of collections and their emergence as integral parts of a central digital library, while providing adequate guarantees to ensure their long-term viability."}),(0,a.jsx)("p",{style:{textAlign:"justify"},children:'The same logic has been successfully applied in the implementation of the projects "Digital Collection of the NKUA Historical Archive" and the "Digital Collection of the Psachos Music Library" of the Operational Program "Information Society", Measure 1.3: "Documentation, Evaluation and Enlightenment" Invitation 65 (Scientific Manager: Professor Michalis Dermitzakis). The digital collection of the Historical Archive was, in fact, the very first collection to be posted on Pergamos (December 2006).'}),(0,a.jsxs)("p",{style:{textAlign:"justify"},children:['Continuing in the same digital policy framework, we proceeded to design and implement the new "Pergamos", now in the form of an Institutional Repository (IR). The new platform was developed in the framework of the Act "Creation of a Unified Digital Repository Platform and Related Electronic Information and Promotion Services for the NKUA Library" (MIS code 304160) of the NSRF Digital Convergence 2007-2013 Operational Program of the European Union (the contractor was'," ",(0,a.jsx)(ed.x,{href:"http://www.unisystems.gr",newtab:!0,children:"UniSystems"}),", the development of the Institutional Repository / Digital Library software was carried out by"," ",(0,a.jsx)(ed.x,{href:"http://www.niovity.com/",newtab:!0,children:"Niovity"}),", while the management, custody and documentation of the material made by the"," ",(0,a.jsx)(ed.x,{href:"http://www.lib.uoa.gr",newtab:!0,children:"Library and Information Center/LIC"})," ","of NKUA). In the context of the project, the LCC in cooperation with the LIC continued and expanded the original strategic choice, now implementing the concentration of not only the cultural collections of NKUA, but also the broader intellectual and research activity of the Foundation, into a unified Digital Library and Institutional Repository platform."]}),(0,a.jsxs)("p",{style:{textAlign:"justify"},children:["Under the IR's new strategic policy, the LCC, in collaboration with the LIC, continues to substantially enrich and technically support Pergamos, providing guidance and digital services such as software maintenance, development of appropriate metadata, storage and retention of digital material, while simultaneously promoting and presenting them online, in line with contemporary techniques and practices. Therefore, ",(0,a.jsx)("i",{children:'"Pergamos"'})," is considered to be a ",(0,a.jsx)("i",{children:'"Reliable Digital Repository"'}),", characterized by consistency and uniformity, which ensures the efficient management of digital collections and their sustainability over time."]})]})}function s2(){let e=(0,s.useContext)(r.PageContext),{locale:t}=(0,r.useTranslation)(),i=e.title[t],n=(0,U.F)("up","md");return(0,a.jsxs)(a.Fragment,{children:[n&&(0,a.jsx)(en.Z,{component:"h2",variant:"h5",mb:2,children:i}),(0,a.jsx)("el"===t?s5:s4,{})]})}function s5(){return(0,a.jsxs)(a.Fragment,{children:[(0,a.jsxs)("p",{style:{textAlign:"justify"},children:["Η Πέργαμος προσφέρει πλήθος υπηρεσιών για αποδοτικότερη πρόσβαση στο υλικό και ευκολότερη διαχείρισή του ανάλογα με τις ανάγκες του επισκέπτη. Οι βασικές υπηρεσίες οι οποίες είναι διαθέσιμες σε όλους είναι η"," ",(0,a.jsx)("i",{children:(0,a.jsx)("b",{children:"Αναζήτηση"})})," ","του υλικού, η"," ",(0,a.jsx)("i",{children:(0,a.jsx)("b",{children:"Ανάκτηση"})})," ","και",(0,a.jsx)("i",{children:(0,a.jsx)("b",{children:" Εμφάνισή"})})," ","του, η"," ",(0,a.jsx)("i",{children:(0,a.jsx)("b",{children:"Χρήση"})})," ","και"," ",(0,a.jsx)("i",{children:(0,a.jsx)("b",{children:"Εξαγωγή"})})," ","των αποτελεσμάτων."]}),(0,a.jsx)("p",{style:{textAlign:"justify"},children:"Εκτός από τις γενικές υπηρεσίες του ΙΑ, ειδικά για τα μέλη της ακαδημαϊκής κοινότητας του ΕΚΠΑ διατίθενται επιπρόσθετες υπηρεσίες, σε περίπτωση που ο χρήστης συνδεθεί στο αποθετήριο μέσω της Κεντρικής Υπηρεσίας Διαπίστευσης Χρηστών με τους κωδικούς του. Αυτές είναι:"}),(0,a.jsxs)("ul",{children:[(0,a.jsxs)("li",{children:["το ",(0,a.jsx)("b",{children:"Ερευνητικό υλικό"})," (αφορά στην απόθεση επιστημονικών δημοσιεύσεων, τεχνικών αναφορών, εργασιών εν εξελίξει και συνόλων δεδομένων)"]}),(0,a.jsxs)("li",{children:["η"," ",(0,a.jsx)("b",{children:(0,a.jsx)("i",{children:"Ηλεκτρονική Κατάθεση"})})," ","εργασιών φοιτητ