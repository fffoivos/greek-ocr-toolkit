children:"Όσον αφορά στην ανάρτηση και το περιεχόμενό της, σε καμιά περίπτωση δεν φέρει ευθύνη το Ιδρυματικό Αποθετήριο Πέργαμος και οι Διαχειριστές του, ούτε το Ίδρυμα στο οποίο ανήκει το Αποθετήριο, στην προκειμένη περίπτωση το Εθνικό και Καποδιστριακό Πανεπιστήμιο Αθηνών."})}),(0,a.jsx)(cX.ZP,{sx:{display:"list-item"},children:(0,a.jsx)(en.Z,{variant:"body2",children:"Σε κάθε περίπτωση, ως δημιουργός του περιεχομένου της ανάρτησης, ευθύνομαι έναντι του ΕΚΠΑ για κάθε σχετική αξίωση που ενδέχεται να εγερθεί από τρίτον."})}),(0,a.jsx)(cX.ZP,{sx:{display:"list-item"},children:(0,a.jsx)(en.Z,{variant:"body2",children:"Έχω καταθέσει στο Ιδρυματικό Αποθετήριο \xabΠΕΡΓΑΜΟΣ\xbb, πιστό ψηφιακό αντίγραφο, σε μορφή PDF, της εγκριθείσας εργασίας μου στην τελική μορφή της και παραχωρώ στη Βιβλιοθήκη και Κέντρο Πληροφόρησης (ΒΚΠ) του ΕΚΠΑ μη αποκλειστική άδεια διάθεσης της εργασίας μου μέσω του διαδικτύου υπό τους όρους της άδειας χρήσης που έχω επιλέξει ανωτέρω. Δηλώνω υπεύθυνα ότι η ανάρτησή μου ακολουθεί την πολιτική ανοικτής πρόσβασης της Περγάμου καθιστώντας το υλικό διαθέσιμο αποκλειστικά για προσωπική μελέτη και ιδιωτική χρήση, καθώς και για εκπαιδευτικούς και ερευνητικούς σκοπούς. Απαγορεύεται οποιαδήποτε χρήση του υλικού από τρίτους, για εμπορικούς σκοπούς, καθώς και για άμεσο ή έμμεσο εμπορικό οικονομικό όφελος."})}),(0,a.jsxs)(cX.ZP,{sx:{display:"list-item"},children:[(0,a.jsx)(en.Z,{variant:"body2",fontWeight:"bold",children:"Κατανοώ ότι:"}),(0,a.jsxs)(nK.Z,{sx:{listStyleType:"circle",pl:4},children:[(0,a.jsx)(cX.ZP,{sx:{display:"list-item",my:-.5},children:(0,a.jsx)(en.Z,{variant:"body2",children:"Στην περίπτωση όπου έχω επιλέξει περιορισμό της πρόσβασης στο (ψηφιακό) πλήρες κείμενο της πτυχιακής εργασίας ή της μεταπτυχιακής διπλωματικής εργασίας ή της διδακτορικής διατριβής, τότε, στο Ιδρυματικό Αποθετήριο εμφανίζονται μόνο τα μεταδεδομένα τεκμηρίωσης (βιβλιογραφικά στοιχεία, η περίληψη και οι λέξεις κλειδιά)."})}),(0,a.jsx)(cX.ZP,{sx:{display:"list-item",my:-.5},children:(0,a.jsx)(en.Z,{variant:"body2",children:"Στην περίπτωση όπου κατατεθεί έγγραφο αίτημα περιορισμού πρόσβασης προς το εφορευτικό σύμβούλιο της οικείας Βιβλιοθήκης, εάν αυτό εγκριθεί θα ισχύσει ο αιτούμενος περιορισμός, ενώ σε αντίθετη περίπτωση θα ισχύσει ο περιορισμός που έχω ρητά επιλέξει."})}),(0,a.jsx)(cX.ZP,{sx:{display:"list-item",my:-.5},children:(0,a.jsx)(en.Z,{variant:"body2",children:"Μετά την άρση ενδεχόμενου περιορισμού πρόσβασης, η πρόσβαση στο ψηφιακό κείμενο της εργασίας μου καθίσταται ανοικτή."})}),(0,a.jsx)(cX.ZP,{sx:{display:"list-item",my:-.5},children:(0,a.jsx)(en.Z,{variant:"body2",children:"Ότι μπορώ να επιλέξω ρητά μια από τις διαθέσιμες άδειες χρήσης για το ψηφιακό υλικό της εργασίας που υποβάλλω, αν απαιτείται να διαφοροποιηθεί από την προεπιλεγμένη άδεια (cc-by-nc)."})}),(0,a.jsx)(cX.ZP,{sx:{display:"list-item",my:-.5},children:(0,a.jsx)(en.Z,{variant:"body2",children:'Ότι αν έχει επιλεχθεί οποιοσδήποτε περιορισμός πρόσβασης (χωρικός ή χρονικός), η άδεια χρήσης που θα εμφανίζεται θα είναι "Άλλη (Ελεγχόμενη πρόσβαση)" ενώ μετά την άρση του περιορισμού η άδεια θα μεταπίπτει σε αυτήν που έχω ρητά επιλέξει.'})})]})]}),(0,a.jsx)(en.Z,{variant:"body2",fontWeight:"bold",children:"Η παραπάνω δήλωση και συμφωνία, αποτελεί υπεύθυνη δήλωση και δεσμεύει από κοινού όλους τους δημιουργούς του υλικού που αναρτάται, καθώς στην περίπτωση περισσοτέρων του ενός δημιουργών, όλοι οι δημιουργοί φέρουν από κοινού την ευθύνη για τη διαδικασία και το περιεχόμενο της ανάρτησης και όσα ενδεχομένως προκύψουν από αυτήν."})]})]})}function d6(){return(0,a.jsxs)(P.Z,{sx:{textAlign:"justify"},children:[(0,a.jsx)(en.Z,{variant:"subtitle2",children:"I agree and solemnly declare that:"}),(0,a.jsxs)(nK.Z,{sx:{listStyleType:"disc",pl:4},children:[(0,a.jsx)(cX.ZP,{sx:{display:"list-item"},children:(0,a.jsx)(en.Z,{variant:"body2",children:"Either I am the sole creator of the work that I intend to post on Pergamos or, in the case of multiple creators, I have the explicit a