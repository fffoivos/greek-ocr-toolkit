":"aretsou","cas.title":[{"key":"el","value":"postgraduate"},{"key":"en","value":"postgraduate"}],"cas.eduPersonPrimaryOrgUnit":null,"cas.eduPersonPrimaryAffiliation":"student","cas.eduPersonOrgUnitDN":["ou=poldiad,ou=postgrads,dc=uoa,dc=gr"],"selfDeposit.rolesAndUnits":[{"publicType":"CasAuthorizationRecord","affiliation":"student","orgUnitDn":"ou=poldiad,ou=postgrads,dc=uoa,dc=gr","butterflyRole":"UNVERIFIED_STUDENT","academicUnit":{"id":"2820260","storeName":"uoadl","publicType":"Unit","parents":[{"id":"2820259","storeName":"uoadl","publicType":"Unit"}],"title":[{"key":"el","value":"Κατεύθυνση Πολιτική και διαδίκτυο"}],"contactInfo":null,"isActive":true,"publish":"true","published":true,"unitType":"DIRECTION","notificationEmails":"antsamts@uoa.gr","notificationEmailsForBooks":null,"notificationEmailsForArticleOrders":null,"notificationEmailsForResearchDatasets":null,"isShownInReports":true,"url":null,"timestamps.createdAt":1542967464000,"timestamps.modifiedAt":1765982472044,"timestamps.publishedAt":1765982472044,"users.createdBy":"users:admin","users.lastModifiedBy":"users:admin","cas.dn":"ou=poldiad,ou=postgrads,dc=uoa,dc=gr","cas.cn":[],"cas.eduOrgSuperiorURI":null,"cas.uoAStructuralType":[]},"libraryUnit":{"id":"1324651","storeName":"uoadl","publicType":"Unit","parents":[{"id":"1324648","storeName":"uoadl","publicType":"Unit"}],"title":[{"key":"el","value":"Βιβλιοθήκη Πολιτικής Επιστήμης και Δημόσιας Διοίκησης - Επικοινωνίας και Μέσων Μαζικής Ενημέρωσης - Τουρκικών Σπουδών και Σύγχρονων Ασιατικών Σπουδών - Κοινωνιολογίας"},{"key":"en","value":"Library of the Faculties of Political Science and Public Administration, Communication and Mass Media Studies, Turkish and Modern Asian Studies, Sociology"}],"contactInfo":null,"isActive":true,"publish":"true","published":true,"unitType":"LIBRARY","notificationEmails":"marzouman@uoa.gr,evoloud@uoa.gr,skloster@uoa.gr,polemme@lib.uoa.gr","notificationEmailsForBooks":"mpolitouk@uoa.gr,skloster@uoa.gr,cgontikaki@uoa.gr","notificationEmailsForArticleOrders":"mpolitouk@uoa.gr,skloster@uoa.gr,cgontikaki@uoa.gr","notificationEmailsForResearchDatasets":"mpolitouk@uoa.gr,evoloud@uoa.gr,marzouman@uoa.gr","isShownInReports":true,"url":"http://econpol.lib.uoa.gr/","timestamps.createdAt":1478525050000,"timestamps.modifiedAt":1768828257058,"timestamps.publishedAt":1768828257058,"users.createdBy":"users:admin","users.lastModifiedBy":"users:admin","cas.dn":null,"cas.cn":[],"cas.eduOrgSuperiorURI":null,"cas.uoAStructuralType":[]}}],"extraPersonalInfo.address":null,"extraPersonalInfo.city":null,"extraPersonalInfo.zipCode":null,"extraPersonalInfo.telNumber":null,"extraPersonalInfo.faxNumber":null,"extraPersonalInfo.email":null,"extraPersonalInfo.orcidId":null,"extraPersonalInfo.googleScholarId":null,"extraPersonalInfo.scopusId":null,"extraPersonalInfo.webOfScienceId":null,"extraAcademicInfo.academicBarcode":null,"extraAcademicInfo.lendingLibrary":null},"email":"aretsou@media.uoa.gr","additionalEmail":"katerinaretsou15@gmail.com","address":[],"telephone":"6949606888","timestamps.createdAt":1791970577537,"timestamps.modifiedAt":1791970723856,"users.createdBy":"users:cas_aretsou","users.lastModifiedBy":"users:cas_aretsou"}],"collectivity":[],"contributor":[],"creationYear":{"publicType":"niovity.butterfly.core.ExactYearDateRange","from":1767225600000,"to":1798761599999,"fromDateFormat":"YYYY","toDateFormat":null},"bibNumber":null,"otherIdentifiers":null,"refsToItem":null,"rightsHolder":[],"relations":null,"source":null,"numberOfPages":null,"number":null,"index":false,"indexPages":"0","withImages":true,"professors":"Λίζα Τσαλίκη, Καθηγήτρια, Τμήμα Επικοινωνίας και Μέσων Μαζικής Ενημέρωσης, ΕΚΠΑ\nΝίκος Παπαναστασίου, Επίκουρος Καθηγητής, Τμήμα Επικοινωνίας και Μέσων Μαζικής Ενημέρωσης, ΕΚΠΑ\nΙωάννα Βώβου, Αναπληρώτρια Καθηγήτρια, Τμήμα Επικοινωνίας, Μέσων και Πολιτισμού, Πάντειο Πανεπιστήμιο","numberOfReferences":103,"abstractText":[{"key":"el","value":"Στην προκειμένη εργασία επιχειρείται να μελετηθεί και να συζητηθεί ο τύπος της\nθηλυκότητας των λαϊκών τραγουδιστριών που κατασκευάζεται στο χώρο των\nνυχτερινών κέντρων διασκέδασης στην Ελλάδα. Η έρευνα είναι συνυφασμένη με το\nπεδίο των πολιτισμικών σπουδών, καθώς σε αυτήν τα μπουζούκια προσεγγίζονται ως\nένα κατεξοχήν πολιτισμικό στοιχείο στην ελληνική οικονομία της νύχτας. Ο χώρος\nαυτός αποτελεί ένα πεδίο σύμπτυξης της οπτικής αναπαράστασης του φύλου σε\nσυνάρτηση με την αισθητική εργασία, την κατανάλωση αλλά και γενικότερα την\nέμφυλη αναπαράσταση, η οποία βασίζεται σε παγιωμένα κοινωνικά στερεότυπα.\nΣτην παρούσα μελέτη υπάρχουν δυο επίπεδα ανάλυσης. Αρχικά, χρησιμοποιήθηκε\nοπτικοακουστικό υλικό από την πλατφόρμα του Tik Tok, με στόχο να μελετηθεί ο\nτρόπος με τον οποίο οι συγκεκριμένες τραγουδίστριες κατασκευάζουν το θηλυκό\nεαυτό τους μέσα από τη σκηνική τους παρουσία και ανιχνεύοντας τα\nεπαναλαμβανόμενα μοτίβα που συγκροτούν την εμφάνιση των καλλιτεχνίδων. Μέσα\nαπό την μέθοδο της θεματικής ανάλυσης, αναδεικνύονται κάποιες κυρίαρχες\nθεματικές όπως η «αδύνατη», η «λαμπερή» και η «ανδρόγυνη» θηλυκότητα. Στο\nδεύτερο μέρος της ερευνητικής διαδικασίας, τα δεδομένα συλλέχθηκαν από\nδημοσιογραφικά άρθρα σε διαδικτυακά μέσα, ώστε να εξεταστεί ο τρόπος με τον\nοποίο κατασκευάζονται και συζητώνται αυτές οι γυναίκες στον δημόσιο διάλογο, σε\nσχέση με την σκηνική τους παρουσία.\nΤα ευρήματα της εργασίας αποδεικνύουν ότι η θηλυκότητα των λαϊκών\nτραγουδιστριών όπως της Λένας Ζευγαρά, της Ιουλίας Καλλιμάνη, της Νατάσας\nΘεοδωρίδου και της Πάολα στα μπουζούκια, δεν ορίζεται ως μια στατική διαδικασία,\nεφόσον στην έρευνα που πραγματοποιήθηκε εντοπίστηκαν διαφοροποιήσεις που\nδηλώνουν την συνύπαρξη αρκετών διαφορετικών θηλυκοτήτων στο συγκεκριμένο\nπολιτισμικό πλαίσιο. Παράλληλα, είναι σαφές ότι τα κυρίαρχα αισθητικά και\nσωματικά μοτίβα που παρατηρήθηκαν καθιστούν την θηλυκότητα μια επιτελεστική\nδιαδικασία, η οποία ενισχύεται από το δημόσιο λόγο."},{"key":"en","value":"This thesis aims to explore the ways in which forms of femininity are constructed in\nthe performances of female Greek popular singers within the context of night-time\nentertainment venues in Greece. The study is situated within the field of cultural\nstudies, approaching bouzoukia as a central cultural element of the Greek night-time\neconomy. This space constitutes a site where visual representations of gender intersect\nwith aesthetic labour, consumption practices, and broader gendered representations,\nwhich are often grounded in established social stereotypes.\n\nThe research is developed across two levels of analysis. Firstly, audiovisual material\nfrom the TikTok platform was utilized in order to observe the on-stage presence of the\nsingers during live performances and to identify recurring patterns that shape their\noverall image. Through thematic analysis, dominant themes emerged, including slim\nfemininity, glamorous femininity, and androgynous femininity. In the second part of\nthe study, data were collected from online journalistic articles, with the aim of\nexamining how these same artists are represented in public discourse and whether this\nrepresentation aligns with their on-stage image.\n\nThe findings of the study suggest that femininity in this context is not a fixed\nattribute, but rather a dynamic and performative process. At the same time, variations\nare identified, indicating the coexistence of multiple forms of femininity within this\ncultural setting, while dominant aesthetic and bodily norms appear to be reinforced\nand reproduced through public discourse."}],"authorship":null,"depositDate":{"publicType":"niovity.butterfly.core.ExactDateRange","from":1791936000000,"to":1792022399999,"fromDateFormat":"DD/MM/YYYY","toDateFormat":null},"casAuthors":[{"id":"cas_aretsou","storeName":"users","publicType":"CasUser","permissionsGranted":[{"publicType":"niovity.butterfly.core.security.ContainerAndUnitPermissionGrant","permission":"APPEND","containerCoords":"uoadl:1081404","unitCoords":null}],"is