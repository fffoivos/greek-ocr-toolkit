eduPersonPrimaryOrgUnit":null,"cas.eduPersonPrimaryAffiliation":"student","cas.eduPersonOrgUnitDN":["ou=sygxrpaidaekpai,ou=postgrads,dc=uoa,dc=gr"],"selfDeposit.rolesAndUnits":[{"publicType":"CasAuthorizationRecord","affiliation":"student","orgUnitDn":"ou=sygxrpaidaekpai,ou=postgrads,dc=uoa,dc=gr","butterflyRole":"UNVERIFIED_STUDENT","academicUnit":{"id":"1327125","storeName":"uoadl","publicType":"Unit","parents":[{"id":"1327119","storeName":"uoadl","publicType":"Unit"}],"title":[{"key":"el","value":"Κατεύθυνση Συγκριτική Παιδαγωγική, Εκπαιδευτική Πολιτική και Διοίκηση της Εκπαίδευσης"}],"contactInfo":"Καταργημένη κατεύθυνση","isActive":false,"publish":"true","published":true,"unitType":"DIRECTION","notificationEmails":"axanthop@primedu.uoa.gr","notificationEmailsForBooks":null,"notificationEmailsForArticleOrders":null,"notificationEmailsForResearchDatasets":null,"isShownInReports":true,"url":null,"timestamps.createdAt":1485259550000,"timestamps.modifiedAt":1769172572251,"timestamps.publishedAt":1769172572251,"users.createdBy":"users:admin","users.lastModifiedBy":"users:admin","cas.dn":"ou=sygxrpaidaekpai,ou=postgrads,dc=uoa,dc=gr","cas.cn":[],"cas.eduOrgSuperiorURI":null,"cas.uoAStructuralType":[]},"libraryUnit":{"id":"1324646","storeName":"uoadl","publicType":"Unit","parents":[{"id":"1324641","storeName":"uoadl","publicType":"Unit"}],"title":[{"key":"el","value":"Βιβλιοθήκη Σχολής Επιστημών της Αγωγής"},{"key":"en","value":"Library of the School of Education"}],"contactInfo":"παλαιά email ενημερώσεων ill edc_repository@lib.uoa.gr και ekostak@uoa.gr,ithanou@uoa.gr,elenikoul@uoa.gr","isActive":true,"publish":"true","published":true,"unitType":"LIBRARY","notificationEmails":"edc_repository@lib.uoa.gr","notificationEmailsForBooks":"edc.ill@lib.uoa.gr","notificationEmailsForArticleOrders":"edc.ill@lib.uoa.gr","notificationEmailsForResearchDatasets":"edc_repository@lib.uoa.gr","isShownInReports":true,"url":"http://edc.lib.uoa.gr/","timestamps.createdAt":1478518645000,"timestamps.modifiedAt":1763043674171,"timestamps.publishedAt":1763043674171,"users.createdBy":"users:admin","users.lastModifiedBy":"users:admin","cas.dn":"ou=libedu,ou=admin,dc=uoa,dc=gr","cas.cn":[],"cas.eduOrgSuperiorURI":null,"cas.uoAStructuralType":[]}}],"extraPersonalInfo.address":null,"extraPersonalInfo.city":null,"extraPersonalInfo.zipCode":null,"extraPersonalInfo.telNumber":null,"extraPersonalInfo.faxNumber":null,"extraPersonalInfo.email":null,"extraPersonalInfo.orcidId":null,"extraPersonalInfo.googleScholarId":null,"extraPersonalInfo.scopusId":null,"extraPersonalInfo.webOfScienceId":null,"extraAcademicInfo.academicBarcode":null,"extraAcademicInfo.lendingLibrary":null},"email":"madamo@primedu.uoa.gr","additionalEmail":"mariaa_adamopoulou@yahoo.gr","address":[],"telephone":"6979279182","timestamps.createdAt":1791943866609,"timestamps.modifiedAt":1791943981602,"users.createdBy":"users:cas_madamo","users.lastModifiedBy":"users:cas_madamo"}],"collectivity":[],"contributor":[],"creationYear":{"publicType":"niovity.butterfly.core.ExactYearDateRange","from":1767225600000,"to":1798761599999,"fromDateFormat":"YYYY","toDateFormat":null},"bibNumber":null,"otherIdentifiers":null,"refsToItem":null,"rightsHolder":[],"relations":null,"source":null,"numberOfPages":null,"number":null,"index":false,"indexPages":"0","withImages":true,"professors":"Κωνσταντίνος Φασούλης, Ομότιμος Καθηγητής ,ΠΤΔΕ,ΕΚΠΑ\nΘωμάς Μπαμπάλης, Καθηγητής ΠΤΔΕ ,ΕΚΠΑ\nΓιάννης Ρουσσάκης, Αναπληρωτής Καθηγητής ΠΑΙΤΔΕ","numberOfReferences":43,"abstractText":[{"key":"el","value":"Η παρούσα εργασία εξετάζει την κριτική που έχει ασκηθεί διεθνώς και στην Ελλάδα στις πολιτικές και \nστον ρόλο του Οργανισμού Οικονομικής Συνεργασίας και Ανάπτυξης (ΟΟΣΑ) στον χώρο της \nεκπαίδευσης, με επίκεντρο το Πρόγραμμα Διεθνούς Αξιολόγησης Μαθητών (PISA). Σκοπός της \nείναι να διερευνήσει τους βασικούς άξονες της κριτικής απέναντι στο PISA, αλλά και τον τρόπο \nμε τον οποίο τα αποτελέσματά του ερμηνεύονται και αξιοποιούνται στη διαμόρφωση της \nεκπαιδευτικής πολιτικής. \nΗ εργασία βασίζεται σε βιβλιογραφική επισκόπηση και συγκριτική προσέγγιση. Αρχικά, \nεξετάζονται ο ρόλος του ΟΟΣΑ στην εκπαίδευση, τα βασικά χαρακτηριστικά του PISA και η \nεπιρροή που έχει αποκτήσει στη διεθνή εκπαιδευτική πολιτική. Στη συνέχεια, παρουσιάζονται \nοι κυριότερες διαστάσεις της κριτικής, οι οποίες αφορούν μεθοδολογικά ζητήματα, πολιτικές, \nιδεολογικές και παιδαγωγικές επιφυλάξεις σχετικά με τις διεθνείς συγκρίσεις και τη χρήση των \nαποτελεσμάτων τους. Αναλύεται, επίσης, η στάση διεθνών εκπαιδευτικών και συνδικαλιστικών \nφορέων. Η επιρροή που ασκεί η αξιολόγηση PISA στην εκπαιδευτική πολιτική διερευνάται \nμέσα από τις περιπτώσεις της Γερμανίας και της Σουηδίας, ενώ ιδιαίτερη έμφαση δίνεται στην \nΕλλάδα, στις επιδόσεις της χώρας, στον δημόσιο και πολιτικό λόγο και στις αντιδράσεις της \nεκπαιδευτικής κοινότητας. \nΑπό την βιβλιογραφία προκύπτει ότι η κριτική απέναντι στο PISA δεν στρέφεται μόνο κατά της \nίδιας της διεθνούς αξιολόγησης αλλά κυρίως κατά του τρόπου με τον οποίο ερμηνεύονται και \nχρησιμοποιούνται τα αποτελέσματά της για τη διάγνωση των προβλημάτων των \nεκπαιδευτικών συστημάτων και τη νομιμοποίηση μεταρρυθμίσεων στο πεδίο της \nεκπαιδευτικής πολιτικής. Η σύγκριση μεταξύ των χωρών δείχνει ότι η επίδραση του PISA δεν \nείναι ίδια, αλλά εξαρτάται σε σημαντικό βαθμό από το πολιτικό, θεσμικό και εκπαιδευτικό \nπλαίσιο κάθε χώρας. Στην Ελλάδα, παρά τις διαχρονικά χαμηλές επιδόσεις, το PISA δεν \nπροκάλεσε ένα «σοκ» αντίστοιχο με εκείνο που παρατηρήθηκε σε άλλες χώρες, ενώ η \nαξιοποίησή του στον πολιτικό λόγο και η σύνδεσή του με εθνικές πολιτικές αξιολόγησης \nγίνονται περισσότερο εμφανείς τα τελευταία χρόνια."},{"key":"en","value":"This dissertation examines the criticism directed, both internationally and in Greece, at the \npolicies and role of the Organisation for Economic Co-operation and Development (OECD) in the \nfield of education, with a particular focus on the Programme for International Student \nAssessment (PISA). Its aim is to explore the main strands of criticism of PISA, as well as the ways \nin which its results are interpreted and used in the formulation of education policy. \nThe study is based on a literature review and a comparative approach. It first examines the role \nof the OECD in education, the main characteristics of PISA, and the influence it has acquired in \ninternational education policy. It then presents the main dimensions of criticism, including \nmethodological issues as well as political, ideological, and pedagogical concerns regarding \ninternational comparisons and the use of their results. The positions adopted by international \neducational organisations and teachers’ unions are also examined. The influence of PISA on \neducation policy is explored through the cases of Germany and Sweden, while particular \nemphasis is placed on Greece, including the country’s performance, public and political \ndiscourse, and the reactions of the educational community. \nThe literature suggests that criticism of PISA is directed not only at the international assessment \nitself, but primarily at the ways in which its results are interpreted and used to diagnose \nproblems within education systems and to legitimise reforms in the field of education policy. \nThe comparison between countries indicates that the impact of PISA is not uniform but depends \nto a significant extent on each country’s political, institutional, and educational context. In \nGreece, despite persistently low performance, PISA has not generated a “shock” comparable to \nthat observed in other countries, while its use in political discourse and its connection with \nnational assessment policies have become more evident in recent years."}],"authorship":null,"depositDate":{"publicType":"niovity.butterfly.core.ExactDateRange","from":1791936000000,"to":1792022399999,"fromDateFormat":"DD/MM/YYYY","toDateFormat":null},"casAuthors":[{"id":"cas_madamo","storeName":"user