":null,"cas.uid":"loukark","cas.title":[{"key":"el","value":"doctoral"},{"key":"en","value":"doctoral"}],"cas.eduPersonPrimaryOrgUnit":null,"cas.eduPersonPrimaryAffiliation":"student","cas.eduPersonOrgUnitDN":["ou=psy,ou=schools,dc=uoa,dc=gr"],"selfDeposit.rolesAndUnits":[{"publicType":"CasAuthorizationRecord","affiliation":"student","orgUnitDn":"ou=psy,ou=schools,dc=uoa,dc=gr","butterflyRole":"UNVERIFIED_STUDENT","academicUnit":{"id":"1326892","storeName":"uoadl","publicType":"Unit","parents":[{"id":"1077546","storeName":"uoadl","publicType":"Unit"}],"title":[{"key":"el","value":"Τμήμα Ψυχολογίας"},{"key":"en","value":"Department of Psychology"}],"contactInfo":null,"isActive":true,"publish":"true","published":true,"unitType":"DEPARTMENT","notificationEmails":"cvakartzi@psych.uoa.gr","notificationEmailsForBooks":null,"notificationEmailsForArticleOrders":null,"notificationEmailsForResearchDatasets":null,"isShownInReports":true,"url":null,"timestamps.createdAt":1484906397000,"timestamps.modifiedAt":1516283198000,"timestamps.publishedAt":1748870901885,"users.createdBy":"users:admin","users.lastModifiedBy":"users:admin","cas.dn":"ou=psy,ou=schools,dc=uoa,dc=gr","cas.cn":[],"cas.eduOrgSuperiorURI":null,"cas.uoAStructuralType":[]},"libraryUnit":{"id":"1324647","storeName":"uoadl","publicType":"Unit","parents":[{"id":"1324641","storeName":"uoadl","publicType":"Unit"}],"title":[{"key":"el","value":"Βιβλιοθήκη Φιλοσοφικής Σχολής"},{"key":"en","value":"Library of the School of Philosophy"}],"contactInfo":null,"isActive":true,"publish":"true","published":true,"unitType":"LIBRARY","notificationEmails":"philgl@lib.uoa.gr","notificationEmailsForBooks":"phil.ill@lib.uoa.gr,mloumpak@uoa.gr,nparaske@uoa.gr","notificationEmailsForArticleOrders":"phil.ao@lib.uoa.gr,mchristidi@uoa.gr,vdiakat@uoa.gr","notificationEmailsForResearchDatasets":"afrantzi@uoa.gr","isShownInReports":true,"url":"http://phil.lib.uoa.gr/","timestamps.createdAt":1478519666000,"timestamps.modifiedAt":1749803298832,"timestamps.publishedAt":1749803298832,"users.createdBy":"users:admin","users.lastModifiedBy":"users:admin","cas.dn":"ou=libphi,ou=admin,dc=uoa,dc=gr","cas.cn":[],"cas.eduOrgSuperiorURI":null,"cas.uoAStructuralType":[]}}],"extraPersonalInfo.address":null,"extraPersonalInfo.city":null,"extraPersonalInfo.zipCode":null,"extraPersonalInfo.telNumber":null,"extraPersonalInfo.faxNumber":null,"extraPersonalInfo.email":null,"extraPersonalInfo.orcidId":null,"extraPersonalInfo.googleScholarId":null,"extraPersonalInfo.scopusId":null,"extraPersonalInfo.webOfScienceId":null,"extraAcademicInfo.academicBarcode":null,"extraAcademicInfo.lendingLibrary":null},"email":"loukark@psych.uoa.gr","additionalEmail":"lukekarkatzounis@gmail.com","address":[],"telephone":"6939499047","timestamps.createdAt":1791740153122,"timestamps.modifiedAt":1791740357678,"users.createdBy":"users:cas_loukark","users.lastModifiedBy":"users:cas_loukark"}],"collectivity":[],"contributor":[],"creationYear":{"publicType":"niovity.butterfly.core.ExactYearDateRange","from":1767225600000,"to":1798761599999,"fromDateFormat":"YYYY","toDateFormat":null},"bibNumber":null,"otherIdentifiers":null,"refsToItem":null,"rightsHolder":[],"relations":null,"source":null,"numberOfPages":null,"number":null,"index":false,"indexPages":"0","withImages":true,"professors":"Αικατερίνη Γκαρή (Επιβλέπουσα), Καθηγήτρια Κοινωνικής Ψυχολογίας, Τμήμα Ψυχολογίας, Εθνικό και Καποδιστριακό Πανεπιστήμιο Αθηνών\n\nΣπυρίδων Τάνταρος, Καθηγητής Αναπτυξιακής Ψυχολογίας, Τμήμα Ψυχολογίας, Εθνικό και Καποδιστριακό Πανεπιστήμιο Αθηνών\n\nΧρυσή Χατζηχρήστου, Καθηγήτρια Σχολικής Ψυχολογίας, Τμήμα Ψυχολογίας, Εθνικό και Καποδιστριακό Πανεπιστήμιο Αθηνών\n\nΚωνσταντίνος Μυλωνάς, Καθηγητής Μεθοδολογίας Επιστημονικής Έρευνας και Στατιστικής στην Ψυχολογία, Τμήμα Ψυχολογίας, Εθνικό και Καποδιστριακό Πανεπιστήμιο Αθηνών\n\nΒασίλης Παυλόπουλος, Καθηγητής Διαπολιτισμικής Κοινωνικής Ψυχολογίας, Τμήμα Ψυχολογίας, Εθνικό και Καποδιστριακό Πανεπιστήμιο Αθηνών\n\nΠέτρος Ρούσσος, Καθηγητής Γνωστικής Ψυχολογίας και Κυβερνοψυχολογίας, Τμήμα Ψυχολογίας, Εθνικό και Καποδιστριακό Πανεπιστήμιο Αθηνών\n\nΠετρούλα (Πέννυ) Παναγιωτοπούλου, Επίκουρη Καθηγήτρια Διαπολιτισμικής Κοινωνικής Ψυχολογίας, Τμήμα Επιστημών της Εκπαίδευσης και Κοινωνικής Εργασίας, Πανεπιστήμιο Πατρών","numberOfReferences":422,"abstractText":[{"key":"el","value":"Μέσα από το πρίσμα των κοινωνικών αξιωμάτων και των προσωπικών αξιών, εξετάζονται οι ψυχοκοινωνικές παράμετροι που καθορίζουν τη διαδικτυακή συμπεριφορά της «Γενιάς του Διαδικτύου» (iGen / Generation Z) στην Ελλάδα. Υιοθετήθηκε διερευνητικός διαδοχικός σχεδιασμός μεικτής μεθοδολογίας. Στην Ποιοτική Διερεύνηση, διεξήχθησαν 20 ημιδομημένες συνεντεύξεις, αναδεικνύοντας θεματικές όπως οι «Πιθανές Αρνητικές Συνέπειες της Έντονης Ψηφιακής Δραστηριότητας» και οι «Πρόσωπα και Ιδέες που Ασκούν Επιρροή (Influencers)». Στην Ποσοτική Διερεύνηση, συμμετείχαν 1908 άτομα (N = 1908), εκ των οποίων 699 έφηβοι (15–17 ετών) και 1209 αναδυόμενοι ενήλικες (18–30 ετών). Η συλλογή δεδομένων πραγματοποιήθηκε με τη χρήση της Κλίμακας Κοινωνικών Αξιωμάτων (SAS-II), του Ερωτηματολογίου Προσωπικών Αξιών (PVQ-RR) και ενός αυτοσχέδιου ερωτηματολογίου διαδικτυακών στάσεων, το οποίο προέκυψε μέσω Αναστοχαστικής Θεματικής Ανάλυσης των συνεντεύξεων και του οποίου η παραγοντική δομή εξετάστηκε μέσω Διερευνητικής Παραγοντικής Ανάλυσης (EFA). Τα αποτελέσματα ανέδειξαν την Κοινωνική Πολυπλοκότητα ως το κυρίαρχο αξίωμα, υποδηλώνοντας υψηλή γνωστική ευελιξία, ακολουθούμενη από την Επιβράβευση της Προσπάθειας. Διαπιστώθηκε στατιστικά σημαντική μείωση του Κοινωνικού Κυνισμού κατά τη μετάβαση στην αναδυόμενη ενηλικίωση. Παράλληλα, οι πολυμεταβλητές αναλύσεις διακύμανσης (MANOVA) υπέδειξαν ορισμένες διαφοροποιήσεις βάσει της ηλικίας, του φύλου, του μορφωτικού επιπέδου των γονέων και της αυτοαναφερόμενης θρησκευτικότητας. Ως επικρατέστερες Προσωπικές Αξίες αναδείχθηκαν η Καλοσύνη (Φροντίδα, Αξιοπιστία), η Αυτοκατεύθυνση-Δράση και η Οικουμενικότητα-Μέριμνα. Μέσω Μοντέλων Δομικών Εξισώσεων (SEM), αναδείχθηκε ο διαμεσολαβητικός ρόλος των Προσωπικών Αξιών στη σχέση μεταξύ Κοινωνικών Αξιωμάτων και Διαδικτυακών Στάσεων σε τρία θεωρητικά μοντέλα: το Προστατευτικό, όπου οι φιλοκοινωνικές αξίες θωρακίζουν απέναντι στη δυσλειτουργική χρήση, το Ενισχυτικό, όπου ο ηδονισμός συνδέει την επιβράβευση της προσπάθειας με την παρακολούθηση διασημοτήτων ως αντισταθμιστική διαφυγή και το Λειτουργικό, όπου η αξία της επίτευξης κατευθύνει προς την εκπαιδευτική χρήση του διαδικτύου. Συνολικά, τα ευρήματα ερμηνεύονται στο πλαίσιο της σταδιακής αναπτυξιακής μετάβασης προς μια «επιστημική ωριμότητα», αναδεικνύοντας το συνθετικό προφίλ του «Σκεπτικιστή Ψηφιακού Αυτόχθονα», ενός ατόμου που πλοηγείται κριτικά, αναστοχαστικά και ενεργητικά στον σύγχρονο κυβερνοχώρο."},{"key":"en","value":"Through the lens of social axioms and personal values, this study examines the psychosocial parameters that determine the online behavior of the \"Internet Generation\" (iGen / Generation Z) in Greece. An exploratory sequential mixed methods design was employed. In the Qualitative Inquiry, 20 semi-structured interviews were conducted, identifying themes such as \"Potential Negative Consequences of Intense Digital Activity\" and \"Figures and Ideas Exerting Influence (Influencers).\" In the Quantitative Inquiry, 1,908 individuals participated (N = 1,908), comprising 699 adolescents (aged 15–17) and 1,209 emerging adults (aged 18–30). Data collection was carried out using the Social Axioms Survey (SAS-II), the Portrait Values Questionnaire (PVQ-RR), and an ad hoc questionnaire assessing online attitudes, which was developed through Reflexive Thematic Analysis of the interviews and whose factorial structure was evaluated via Exploratory Factor Analysis (EFA). Findings revealed Social Complexity as the predominant axiom, indicating high cognitive flexibility, followed by Reward for Application. A statistically significant decrease in Social Cynicism was observed during the transition to emerging adulthood. Furthermore, multivariate analyses of variance (MANOVAs) suggested certain variations based on age, gender, parental educational level, and self-reported religiosity. The most prevalent Personal Values were Benevolence (Care, Dependability), Self-Direction-Action, and Universalism-Concern. Through Structural Equation Modeling (SEM), the mediating role of Personal Values in the relationship between Social Axioms and Online Attitudes was demonstrated across three theoretical models: the Protective model, where prosocial values buffer against dysfunctional usage, the Reinforcing model, where hedonism links reward for application to celebrity following as compensatory escapism, and the Functional model, where the value of achievement directs behavior toward educational Internet use. Overall, the findings are interpreted within the framework of a gradual developmental transition toward \"epistemic maturity,\" highlighting the composite profile of the \"Skeptical Digital Native\", an individual navigating contemporary cyberspace critically, reflexively, and agentically."}],"authorship":null,"depositDate":{"publicType":"niovity.butterfly.core.ExactDateRange","from":1791849600000,"to":1791935999999,"fromDateFormat":"DD/MM/YYYY","toDateFormat":null},"casAuthors":[{"id":"cas_loukark","storeName":"users","publicType":"CasUser","permissionsGranted":[{"publicType":"niovity.butterfly.core.security.ContainerAndUnitPermissionGrant","permission":"APPEND","containerCoords":"uoadl:1081404","unitCoords":null},{"publicType":"niovity.butterfly.core.security.ContainerAndUnitPermissionGrant","permission":"APPEND","containerCoords":"uoadl:1058836","unitCoords":null}],"isEnabled":true,"fromCAS":true,"favourites":[],"allowBackofficeLogin":false,"cas.givenName":[{"key":"el","value":"Λουκάς"},{"key":"en","value":"Loukas"}],"cas.sn":[{"key":"el","value":"Καρκατζούνης"},{"key":"en","value":"Karkatzounis"}],"cas.displayName":[{"key":"el","value":"Λουκάς Καρκατζούνης"},{"key":"en","value":"Loukas Karkatzounis"}],"cas.eduPersonAffiliation":["student"],"cas.mail":"loukark@psych.uoa.gr","cas.telephone":null,"cas.eduPersonOrgDN":"dc=uoa,dc=gr","cas.dn":null,"cas.uid":"loukark","cas.title":[{"key":"el","value":"doctoral"},{"key":"en","value":"doctoral"}],"cas.eduPersonPrimaryOrgUnit":null,"cas.eduPersonPrimaryAffiliation":"student","cas.eduPersonOrgUnitDN":["ou=psy,ou=schools,dc=uoa,dc=gr"],"selfDeposit.rolesAndUnits":[{"publicType":"CasAuthorizationRecord","affiliation":"student","orgUnitDn":"ou=psy,ou=schools,dc=uoa,dc=gr","butterflyRole":"UNVERIFIED_STUDENT","academicUnit":{"id":"1326892","storeName":"uoadl","publicType":"Unit","parents":[{"id":"1077546","storeName":"uoadl","publicType":"Unit","parents":[{"id":"__UNIT","storeName":"uoadl","publicType":"Unit"}],"title":[{"key":"el","value":"Σχολή Φιλοσοφική"},{"key":"en","value":"School of Philosophy"}],"contactInfo":null,"isActive":true,"publish":"true","published":true,"unitType":"SCHOOL","notificationEmails":null,"notificationEmailsForBooks":null,"notificationEmailsForArticleOrders":null,"notificationEmailsForResearchDatasets":null,"isShownInReports":true,"url":null,"timestamps.createdAt":1453937431000,"timestamps.modifiedAt":1500898608000,"timestamps.publishedAt":1748870895067,"users.createdBy":"users:admin","users.lastModifiedBy":"users:admin","cas.dn":null,"cas.cn":[],"cas.eduOrgSuperiorURI":null,"cas.uoAStructuralType":[]}],"title":[{"key":"el","value":"Τμήμα Ψυχολογίας"},{"key":"en","value":"Department of Psychology"}],"contactInfo":null,"isActive":true,"publish":"true","published":true,"unitType":"DEPARTMENT","notificationEmails":"cvakartzi@psych.uoa.gr","notificationEmailsForBooks":null,"notificationEmailsForArticleOrders":null,"notificationEmailsForResearchDatasets":null,"isShownInReports":true,"url":null,"timestamps.createdAt":1484906397000,"timestamps.modifiedAt":1516283198000,"timestamps.publishedAt":1748870901885,"users.createdBy":"users:admin","users.las