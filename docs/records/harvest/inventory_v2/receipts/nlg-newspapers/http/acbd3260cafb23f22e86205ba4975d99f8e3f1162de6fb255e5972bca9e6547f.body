<script type="text/javascript">

function paper_obj(cid,ds,de,sd){
	this.cid=cid;
	this.DateStart=ds;
	this.DateEnd=de;
	this.strDate=sd;
}

var selectedpaper=new paper_obj(0,0,0,0);
var cal_obj;
var selecteddate;
var cal;

function changeDate() {
	document.getElementById("in_date").value=cal.date.print('d/m/y');
	selecteddate=cal.date;
}

function winopen()
{
    	wWidth=screen.width*.9;
    	wHeight=screen.height*.85;
    
       	var sinist = screen.width / 2 - wWidth / 2;
       	var toppo = screen.height / 2 - wHeight / 2 - 30;
    
    	var params;
    	
    	params="c="+selectedpaper.cid+"&dc="+selecteddate.getDate()+"&db="+(selecteddate.getMonth()+1)+"&da="+selecteddate.getFullYear()
    	//alert (params);
  	pdfwin=window.open("pdfwin.asp?"+params,"pdfwin","toolbar=0,location=0,status=1,menubar=0,scrollbars=0,resizable=1,width="+wWidth+",height="+wHeight+",left="+sinist+",top="+toppo);
	try{
		pdfwin.focus();
	}
	catch(x){
	}
}

function SelectPaper(cid)
{
	document.location.replace("dateselect.asp?c="+cid);
}

function DateSelected(cal, date) {
  var el = document.getElementById("in_date");
  var strdate;
  if (cal){
  	strdate=cal.date.print('d/m/y');
  	selecteddate=cal.date
  }
  else{
  	strdate=date.print('d/m/y');
   	selecteddate=date 	
  }
  el.value = strdate;
}



function DoCalendar(){
  var parent = document.getElementById("cal_sh");
  // construct a calendar giving only the "selected" handler.
  cal = new Calendar(true, selectedpaper.strDate, DateSelected);
  cal_obj=cal;
  // hide week numbers
  cal.weekNumbers = false;
  cal.setRange(selectedpaper.DateStart, selectedpaper.DateEnd);
  DateSelected(0,selectedpaper.strDate);

  // We want some dates to be disabled; see function isDisabled above
  
  cal.setDisabledHandler(isDisabled);
  
  cal.setDateFormat("d/m/y");
  // this call must be the last as it might use data initialized above; if
  // we specify a parent, as opposite to the "showCalendar" function above,
  // then we create a flat calendar -- not popup.  Hidden, though, but...
  cal.create(parent);
  // ... we can show it here.
  cal.show();
}

function SelectPaper2(pid,DateStart,DateEnd,strDate){
	if (pid!=0){
		selpapperid=pid;
		var dateinfoel = document.getElementById("dateinfoel");
  		if (dateinfoel) {
    			dateinfoel.style.display = "block";
  		}
		showCalendar('cal_sh', '&da=y&db=m&dc=d',papers[pid].DateStart,papers[pid].DateEnd,papers[pid].strDate);
	}
	else{
		selpapperid=0;
		var dateinfoel = document.getElementById("dateinfoel");
  		if (dateinfoel) {
    			dateinfoel.style.display = "none";
  		}
		HideCalendar();
	}
}

function checkdate(el){
	var newdate=new Date();
	<!--alert ("juyui");-->
	if (newdate.chkdate(el)){
		if (isDisabled(newdate)){
			alert("Το φύλλο δεν είναι διαθέσιμο.");
		}
		else{
			cal_obj.setDate(newdate);
			DateSelected(cal_obj,newdate);			
		}
	}
	else{
		el.select();
		alert("Μη έγκυρη ημερομηνία.");
		el.focus();
	}
}

</script>
