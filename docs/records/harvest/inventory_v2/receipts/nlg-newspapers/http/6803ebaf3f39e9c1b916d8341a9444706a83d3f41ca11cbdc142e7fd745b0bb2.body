
<HTML>
<HEAD>
<TITLE>ftr Parameters</TITLE>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
	<META NAME="KEYWORDS" CONTENT="Digital Library">
  	<META NAME="OWNER" CONTENT="Archive Lambrakis Press">   
	<META NAME="CODE BY" CONTENT="nkir">
	<META NAME="security" CONTENT="public">
	<link rel="stylesheet" type="text/css" media="all" href="css/dlib.css">	
	<script language="JavaScript" src="scripts.js"></script>
	<script language="JavaScript" src="ftiens4.js"></script>
	<SCRIPT LANGUAGE="javascript">
	<!--
	var selpapers;
	var selpaperscount=0;
	
	var ELEYTHERIAID=64;
	var RIZOSID=65; 
	var MAKEDONIAID=124;
	var ETHNOSID=125;
	
	function GetSelectedPapers(){
		var ls=document.getElementById('cols');
		var maxCnt = ls.options.length;
		selpaperscount=0;
		selpapers=Array();
		selids='';

		for(var i = maxCnt - 1; i >= 0; i--) {
			if ((ls.options[i] != null) && (ls.options[i].selected == true)) {
				if (selids!='')					
					selids = selids + ',' + ls.options[i].value;
				else
					selids = ls.options[i].value;

				selpapers[selpaperscount]=ls.options[i].value;
				selpaperscount++;
	      		}
	   	}

	   	return selids;
	}
	

	function clear() {
		document.getElementById('sign').value="";
		document.getElementById('series').value="";
		document.getElementById('title').value="";
	}
	
	function ShowAuthorsSeries(){
		
		clear();
		
		if((document.getElementById('cols').value==RIZOSID || document.getElementById('cols').value==MAKEDONIAID) && document.getElementById('searchtype2').checked==true) {
			document.getElementById('searchauthorsspan').style.display = 'block';
			document.getElementById('searchauthorsspan1').style.display = 'block';
			document.getElementById('searchseriesspan').style.display = 'block';
			document.getElementById('searchseriesspan1').style.display = 'block';
		}
		else {
			document.getElementById('searchauthorsspan').style.display = 'none';
			document.getElementById('searchauthorsspan1').style.display = 'none';
			document.getElementById('searchseriesspan').style.display = 'none';
			document.getElementById('searchseriesspan1').style.display = 'none';
		}
	}

	function searchFeatures(){
		//alert(search.cols.value);
		//alert(search.searchtype1.checked);
		
		clear();

		if(document.getElementById('cols').value!=ELEYTHERIAID && document.getElementById('cols').value!=ETHNOSID && document.getElementById('cols').value!=RIZOSID && document.getElementById('cols').value!=MAKEDONIAID){ //ELEYTHERIA || RIZOSPASTHS
			document.getElementById('searchspan').style.display = 'none';
			document.getElementById('searchtitle').style.display = 'block';
			document.getElementById('searchtype1').checked = true;
		}
		else{
			document.getElementById('searchspan').style.display = 'block';
			document.getElementById('searchtitle').style.display = 'none';
		}
		
		
		if(document.getElementById('cols').value==RIZOSID || document.getElementById('cols').value==MAKEDONIAID){ //RIZOSPASTHS 
			document.getElementById('searcharticletextspan').style.display = 'none';
		}
		else{
			document.getElementById('searchauthorsspan').style.display = 'none';
			document.getElementById('searchauthorsspan1').style.display = 'none';
			document.getElementById('searchseriesspan').style.display = 'none';
			document.getElementById('searchseriesspan1').style.display = 'none';
		}
		
		if(document.getElementById('cols').value==ELEYTHERIAID || document.getElementById('cols').value==ETHNOSID){ //ELEYTHERIA
			document.getElementById('searcharticletextspan').style.display = 'block';
		}
		document.getElementById('searchtype3').checked=true;
		if(document.getElementById('cols').value==ELEYTHERIAID || document.getElementById('cols').value==ETHNOSID){ //ELEYTHERIA
			document.getElementById('searchtype1').checked=true;
		}
		if(document.getElementById('cols').value==RIZOSID || document.getElementById('cols').value==MAKEDONIAID){ //RIZOSPASTHS
			document.getElementById('searchtype1').checked=true;
		}
	}

	
	function newImage(arg) {
		if (document.images) {
			rslt = new Image();
			rslt.src = arg;
			return rslt;
		}
	}
	
	function changeImages() {
		if (document.images && (preloadFlag == true)) {
			for (var i=0; i<changeImages.arguments.length; i+=2) {
				document[changeImages.arguments[i]].src = changeImages.arguments[i+1];
			}
		}
	}
	
	var preloadFlag = false;
	function preloadImages() {
		if (document.images) {
			a1_over = newImage("images/button1_r.gif");
			list_over=newImage("images/list_r.gif");
			preloadFlag = true;
		}
	}
	
	var Listwin;
	function showList(kind)
	{

		var Col_Newspapers;
		Col_Newspapers=GetSelectedPapers();

		if (GetSelectedPapers()>0){
		    	wWidth=350;//screen.width*.4;
	    		wHeight=screen.height*.42;
	    	       	var sinist = screen.width / 2 - wWidth / 2;
	       		var toppo = screen.height / 2 - wHeight / 2 - 30;
	       		getstr=""

	       		for (i=0;i<selpaperscount;i++)
	       			getstr+="&c="+selpapers[i]
			//alert("listwin.asp?k=" + kind + getstr);
	   	  	Listwin=window.open("listwin.asp?k=" + kind + getstr,"Listwin","toolbar=0,location=0,status=1,menubar=0,scrollbars=1,resizable=1,width="+wWidth+",height="+wHeight+",left="+sinist+",top="+toppo);
			try{
				Listwin.focus();
			}
			catch(x){
			}
		}
		else{
		
			alert("Παρακαλώ επιλέξτε πρώτα ένα τουλάχιστον έντυπο.");
		}
	}
	// -->
	</SCRIPT>
	</HEAD>


<body bgcolor="#EFEFEF" text="black" link="blue" vlink="blue" alink="#400080" leftmargin=0 topmargin=0 ONLOAD="preloadImages();"> 
	<form name="search" action="search.asp" target="Fr_results" METHOD = "post">
    	    	
    	<input type=hidden name="efim" value="0">    	    	
	<input type="Hidden" name="query" value="">
	<input type="Hidden" name="cur_page" value="1">
    	<input type=hidden name="katig" value=0>
    	<input type=hidden name="enot" value=0>
    	<INPUT type=hidden name="date_from" value="">
    	<INPUT type=hidden name="date_to" value="">    	
	<INPUT type=hidden id="croppdf" name="croppdf" value="0">
	<INPUT type=hidden id="orderby" name="orderby" value="SCORE">
	<INPUT type=hidden id="pagelen" name="pagelen" value="10">
	<INPUT type=hidden id="action_sign" name="action_sign" value="*">
	<INPUT type=hidden id="stemtype" name="stemtype" value="0">
	<INPUT type=hidden id="anyorder" name="anyorder" value="1">
	<INPUT type=hidden id="maxresults" name="maxresults" value="1000">

	<INPUT type=hidden id="dist" name="dist" value="3">
	<INPUT type=hidden id="ov_dist" name="ov_dist" value="3">
	<INPUT type=hidden id="and_grade" name="and_grade" value="5">
	<INPUT type=hidden id="or_grade" name="or_grade" value="2">
	<INPUT type=hidden id="Cols_Newspapers" name="Cols_Newspapers" value="">   
	
    	
	<table border=0 width=100% cellspacing=0 cellpadding=0>
		<tr>
			<td width=10 nowrap><img src="images/pixel.gif" width=10 height=1></td>
			<td width=470 nowrap>
				<table border=0 width=470 cellspacing=0 cellpadding=0>
					<tr>
						<td width=1 align=left><img src="images/pixel.gif" width=1 height=42></td>					
						<td width=469 align=left style="border-top:'1px solid #F97B26'; border-left:'1px solid #F97B26' ; border-right:'1px solid #F97B26'"><img src="images/search1.gif" width=469 height=42></td>
					</tr>	
					<tr>
						<td width=1 align=left><img src="images/pixel.gif" width=1 height=180></td>					
						<td bgcolor="FAF9F7" style="border-left:'1px solid #F97B26' ; border-right:'1px solid #F97B26'" valign=top align=center>
							<table border=0 width=469 cellspacing=0 cellpadding=0>
							   	<tr>
									<td width=5 align=left><img src="images/pixel.gif" width=5 height=1></td>							   	
							   		<td align=left valign=top width=100% class="txt_label_ftr">επιλογή εντύπων</BR>
							   		<select onchange="searchFeatures('');" id="cols" name="cols" class="txt_listbox_ftr" style="WIDTH:180px;HEIGHT:150px" multiple="multiple">
									

										<OPTION value="126">ΑΚΡΟΠΟΛΙΣ(1883-1884)</option>		
		
									

										<OPTION value="64">ΕΛΕΥΘΕΡΙΑ(1944-1967)</option>		
		
									

										<OPTION value="108">ΕΜΠΡΟΣ(1896-1969)</option>		
		
									

										<OPTION value="124">ΜΑΚΕΔΟΝΙΑ(1911-1981)</option>		
		
									

										<OPTION value="65">ΡΙΖΟΣΠΑΣΤΗΣ(1917-1983)</option>		
		
									

										<OPTION value="123">ΣΚΡΙΠ(1893-1963)</option>		
		
									

										<OPTION value="106">ΤΑΧΥΔΡΟΜΟΣ(1958-1977)</option>		
		
									
									</select>

									</td>
									<td width=180 align=left>
									
										<table border=0 width=180 cellspacing=0 cellpadding=0>
										   	<tr>
												<td width=90 align=left><img src="images/pixel.gif" width=80 height=1></td>
												<td width=90 align=left><img src="images/pixel.gif" width=80 height=1></td>
											</tr>											
											<tr>
												<td align=left class="txt_label_ftr">ημερομηνία</td>
												<td align=left class="txt_label_ftr">έως</td>
											</tr>	
											<tr>
												<td align=left class="txt_label_ftr"><INPUT name="disp_date_from" onBlur="checkdate(this,'date_from')" class="txt_input_ftr" style="WIDTH: 80px"></td>
												<td align=left class="txt_label_ftr"><INPUT name="disp_date_to" onBlur="checkdate(this,'date_to')" class="txt_input_ftr" style="WIDTH: 80px"></td>
											</tr>	
											<tr>
												<td align=left colspan=2 class="txt_label_ftr">
												<span style="display:none;" id="searchspan">
												<input type="radio" onclick="ShowAuthorsSeries();" id="searchtype1" name="searchtype" checked value="1">Κείμενο Σελίδας<br>
												<input type="radio" onclick="ShowAuthorsSeries();" id="searchtype2" name="searchtype" value="2">Τιτλοφορία Άρθρου<br>
												<span style="display:none;" id="searcharticletextspan">
												<input type="radio" id="searchtype3" name="searchtype" value="3">Κείμενο Άρθρου<br>
												</span>
												</span>
												<span id="searchtitle">Σελίδα</span>
												</td>
											</tr>
											<tr>
												<td align=left colspan=2 class="txt_label_ftr"><INPUT id="title" name="title" class="txt_input_ftr" style="WIDTH: 170px"></td>
											</tr>
											
											<tr>
											<td align=left colspan=2 class="txt_label_ftr">

<span style="display:none;" id="searchauthorsspan">
υπογραφή&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href="#" onclick="document.search.sign.value='';showList(1);return false"><img style="WIDTH: 36px; HEIGHT: 11px" align="absbottom" src="images/list_n.gif" ONMOUSEOVER="changeImages('l1', 'images/list_r.gif');return true;" ONMOUSEOUT="changeImages('l1', 'images/list_n.gif'); return true;" style="cursor:'hand';" name="l1" border=0></a>
</span>
</td>

											</tr>
											<tr>
												<td align=left colspan=2 class="txt_label_ftr">
<span style="display:none;" id="searchauthorsspan1">
<INPUT name="sign" id="sign" class="txt_input_ftr" style="WIDTH: 170px">
</span>
												</td>
											</tr>
											<tr>
												<td align=left colspan=2 class="txt_label_ftr">
<span style="display:none;" id="searchseriesspan">
κατηγορίες &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href="#" onclick="showList(2);return false"><img style="WIDTH: 36px; HEIGHT: 11px" align="absbottom" src="images/list_n.gif" ONMOUSEOVER="changeImages('l2', 'images/list_r.gif');return true;" ONMOUSEOUT="changeImages('l2', 'images/list_n.gif'); return true;" style="cursor:'hand';" name="l2" border=0></a>
</span>
												</td>
											</tr>
											<tr>
												<td align=left colspan=2 class="txt_label_ftr">
<span style="display:none;" id="searchseriesspan1">
<INPUT name="series" id="series" class="txt_input_ftr" style="WIDTH: 170px">
</span>
												</td>
											</tr>
											<!--	
											<tr>
												<td align=left colspan=2 class="txt_label_ftr">έκταση</td>
											</tr>	
											<tr>
												<td align=left colspan=2 class="txt_label_ftr">
												<select name="ektasi" size="1" class="txt_input_ftr" style="WIDTH: 70px">
													<OPTION selected value="">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</OPTION>
													<OPTION value="S">Μικρή</OPTION>
													<OPTION value="M">Μεσαία</OPTION>
													<OPTION value="L">Μεγάλη</OPTION>
												</select>
												</td>
											</tr> 
											<input type=hidden name="sign">
											<INPUT type=hidden name="series">
											-->
											<INPUT type=hidden name="ektasi">

										</table>									

									</td>
							   		
								</tr>									
														
							</table>
						</td>
					</tr>
					
					<tr>
						<td width=1 align=left><img src="images/pixel.gif" width=1 height=25></td>
						<td width=469 background ="images/gradient.gif" valign=top align=left style="border-bottom:'1px solid #F97B26'; border-left:'1px solid #F97B26' ; border-right:'1px solid #F97B26'">
							<table border=0 width=469 cellspacing=0 cellpadding=0>
								<tr>
									<td width=326 nowrap><div id="resize_button" class="txt_label_ftr_params" style="CURSOR: hand;" title="επιπλέον παράμετροι">&nbsp;<a href="#" onclick="Myexpand();return false"><img align="absbottom" src="images/arrow_down.gif" width="19" height="19" border=0></a>&nbsp;επιπλέον παράμετροι</div></td>
									<td width=143 valign=top align=right><a href="#" onclick="check();return false"><img src="images/button1_n.gif" ONMOUSEOVER="changeImages('a1', 'images/button1_r.gif');return true;" ONMOUSEOUT="changeImages('a1', 'images/button1_n.gif'); return true;" style="cursor:'hand';" name="a1" width=143 height=25 border=0></a></td>
								</tr>
