,{\"id\":\"60f1d305-44a9-4d89-899e-f6103c9636ff\",\"placeholder_name\":\"regions - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Δείτε όλες τις Περιφέρειες\",\"placeholder_en_text\":\"View all Regions\",\"is_active\":true},{\"id\":\"a08b61e6-144a-4f2b-ac26-d3143e3e023d\",\"placeholder_name\":\"SDG - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Μάθετε περισσότερα για τις διαδικασίες και τις σχετικές πληροφορίες που αφορούν τη διαμονή και τα δικαιώματα πολιτών της Ευρωπαϊκής Ένωσης στην Ελλάδα στο gov.gr.\",\"placeholder_en_text\":\"Find out more about the procedures and relevant information of being an EU citizen in Greece at gov.gr.\",\"is_active\":true},{\"id\":\"ce779979-454d-4bc5-97d2-0ccb07eb336a\",\"placeholder_name\":\"SDG - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Οδηγός για την Ελλάδα\",\"placeholder_en_text\":\"Your Guide to Greece\",\"is_active\":true},{\"id\":\"a37a823d-0721-4f9d-9032-a5fae8ccd4c3\",\"placeholder_name\":\"Αναζήτηση - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Αναζητήστε όλες τις υπηρεσίες, ανά πολίτη και ανά επιχείρηση, εύκολα και γρήγορα στο gov.gr.\",\"placeholder_en_text\":\"Search for digital public services for citizens and businesses, the quick and easy way on gov.gr.\",\"is_active\":true},{\"id\":\"a85429fd-71fe-446c-9099-aa75ab9ca224\",\"placeholder_name\":\"Αναζήτηση - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Αναζητήστε υπηρεσίες\",\"placeholder_en_text\":\"Search for services\",\"is_active\":true},{\"id\":\"7831ab88-9a63-4f3a-b3fc-7ee503d71585\",\"placeholder_name\":\"Ανατροφοδότηση Σελίδας Υπηρεσίας - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Αξιολογήστε τη σελίδα της υπηρεσίας μέσω ερωτηματολογίου, βαθμολογίας και σχολίων, και βοηθήστε στη βελτίωση των υπηρεσιών του gov.gr.\",\"placeholder_en_text\":\"Evaluate the service page through a questionnaire, rating, and comments, and help improve gov.gr services.\",\"is_active\":true},{\"id\":\"67b22c0e-1156-4f3b-9fbe-374a464dfc05\",\"placeholder_name\":\"Ανατροφοδότηση Σελίδας Υπηρεσίας - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Ανατροφοδότηση Σελίδας Υπηρεσίας\",\"placeholder_en_text\":\"Service's Page Feedback\",\"is_active\":true},{\"id\":\"73995338-89b9-4ab1-b242-703c3be4d4d6\",\"placeholder_name\":\"Ανατροφοδότηση Υπηρεσίας - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Αξιολογήστε την υπηρεσία μέσω ερωτηματολογίου, βαθμολογίας και σχολίων, και βοηθήστε στη βελτίωση των υπηρεσιών του gov.gr.\",\"placeholder_en_text\":\"Evaluate the service through a questionnaire, rating, and comments, and help improve gov.gr services.\",\"is_active\":true},{\"id\":\"9c9d8447-6f2e-4b51-9299-08fb7f6ded4e\",\"placeholder_name\":\"Ανατροφοδότηση Υπηρεσίας - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Ανατροφοδότηση Υπηρεσίας\",\"placeholder_en_text\":\"Service's Feedback\",\"is_active\":true},{\"id\":\"dbbeba1c-50a7-4b88-b54e-b2fad68904ba\",\"placeholder_name\":\"Αρχική - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Βρείτε όλες τις ψηφιακές υπηρεσίες των Υπουργείων, Φορέων, Ανεξάρτητων Αρχών και Περιφερειών, εύκολα και γρήγορα στο gov.gr.\",\"placeholder_en_text\":\"Explore digital public services by Ministries, Organisations, Authorities and Regions, the quick and easy way on gov.gr.\",\"is_active\":true},{\"id\":\"b9ab40e3-ecb9-476f-9495-62422bddc862\",\"placeholder_name\":\"Αρχική - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Βρείτε τη δημόσια υπηρεσία που θέλετε\",\"placeholder_en_text\":\"Explore digital public services\",\"is_active\":true},{\"id\":\"d05ccf3d-3913-48a4-974d-c48db671aeea\",\"placeholder_name\":\"Επικοινωνία - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Μπορείτε να καταθέσετε μια πρόταση που θα κάνει το gov.gr καλύτερο πατώντας στον σχετικό σύνδεσμο παρακάτω.\",\"placeholder_en_text\":\"You can make suggestions on how to improve the gov.gr website. Click on the \\\"Make a suggestion\\\" link below.\",\"is_active\":true},{\"id\":\"ae396608-3a90-4908-aabe-2a37724b712a\",\"placeholder_name\":\"Επικοινωνία - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Καταθέστε μια πρόταση\",\"placeholder_en_text\":\"Submit a proposal\",\"is_active\":true},{\"id\":\"b4dd214e-5293-4e37-a1aa-aad3dca58966\",\"placeholder_name\":\"Κατηγορίες - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Βρείτε όλες τις υπηρεσίες ανά κατηγορία, εύκολα και γρήγορα στο gov.gr.\",\"placeholder_en_text\":\"Explore digital public services by category, the quick and easy way on gov.gr.\",\"is_active\":true},{\"id\":\"3593fc15-e48e-4823-a552-1112dcc53d62\",\"placeholder_name\":\"Κατηγορίες - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Δείτε όλες τις κατηγορίες\",\"placeholder_en_text\":\"View all categories\",\"is_active\":true},{\"id\":\"eba8f152-96a9-493c-8c74-7b6aac737db5\",\"placeholder_name\":\"Νέα - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Βρείτε όλες τις αναρτήσεις και ενημερώσεις, εύκολα και γρήγορα στο gov.gr.\",\"placeholder_en_text\":\"Explore news and updates, the quick and easy way on gov.gr.\",\"is_active\":true},{\"id\":\"5613436f-b2ad-4102-9dd8-d6f41898b217\",\"placeholder_name\":\"Νέα - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Νέα \u0026 Ανακοινώσεις\",\"placeholder_en_text\":\"News \u0026 Announcements\",\"is_active\":true},{\"id\":\"73f0598f-5989-4b70-89cf-6bf36419917f\",\"placeholder_name\":\"Νέα - Κατηγορία - Meta Περιγραφή [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eΒρείτε αναρτήσεις και ενημερώσεις για την κατηγορία {category}, εύκολα και γρήγορα στο gov.gr.\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003eExplore news and updates for the {category} category, the quick and easy way on gov.gr.\u003c/p\u003e\",\"is_active\":true},{\"id\":\"2ae9c4d1-5e72-4cc2-bef9-753928ace7bd\",\"placeholder_name\":\"Περιοχή Χρήστη - Θυρίδα πολίτη - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Η θυρίδα είναι το ψηφιακό σας γραμματοκιβώτιο στην πύλη gov.gr. Μπορείτε να βρείτε έγγραφα που εκδώσατε online στη πύλη ή έγγραφα που εκδώσατε σε δεύτερο χρόνο από φορέα μέσω της πύλης.\",\"placeholder_en_text\":\"The citizen portal is your digital mailbox on the gov.gr portal. You can find documents you issued online on the portal or documents you issued at a later time from a carrier via the portal.\",\"is_active\":true},{\"id\":\"9a5b6f16-f582-41e8-9e37-0020eee80758\",\"placeholder_name\":\"Περιοχή Χρήστη - Θυρίδα πολίτη - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Θυρίδα πολίτη\",\"placeholder_en_text\":\"Citizen portal\",\"is_active\":true},{\"id\":\"2cb5e4ae-3a94-4db8-890f-a1724d46bf0a\",\"placeholder_name\":\"Περιοχή Χρήστη - Ιστορικό συνδέσεων - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Εδώ μπορείτε να δείτε το ιστορικό των συνδέσεών σας.\",\"placeholder_en_text\":\"Here you can view your login history.\",\"is_active\":true},{\"id\":\"a27858a3-0153-44a8-b0bc-6f37dcc30504\",\"placeholder_name\":\"Περιοχή Χρήστη - Ιστορικό συνδέσεων - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Ιστορικό συνδέσεων\",\"placeholder_en_text\":\"Login history\",\"is_active\":true},{\"id\":\"4ff13459-fc06-45bd-aa5e-19828bfbefcd\",\"placeholder_name\":\"Περιοχή Χρήστη - Οι ανατροφοδοτήσεις μου - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Εδώ μπορείτε να δείτε τις ανατροφοδοτήσεις σας.\",\"placeholder_en_text\":\"Here you can view your feedbacks.\",\"is_active\":true},{\"id\":\"4239f721-52b4-41a3-860a-db43d025dc7a\",\"placeholder_name\":\"Περιοχή Χρήστη - Οι ανατροφοδοτήσεις μου - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Οι ανατροφοδοτήσεις μου\",\"placeholder_en_text\":\"My feedbacks\",\"is_active\":true},{\"id\":\"a244e541-9158-4abe-b61d-7258e7990910\",\"placeholder_name\":\"Περιοχή Χρήστη - Οι υπηρεσίες μου - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Εδώ μπορείτε να δείτε τις αγαπημένες σας υπηρεσίες.\",\"placeholder_en_text\":\"Here you can view your favorite services.\",\"is_active\":true},{\"id\":\"eeaeeeb4-1992-4468-8e6c-915263cf670d\",\"placeholder_name\":\"Περιοχή Χρήστη - Οι υπηρεσίες μου - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Οι υπηρεσίες μου\",\"placeholder_en_text\":\"My services\",\"is_active\":true},{\"id\":\"9fe857ed-51ad-4c66-8090-7f84adebfccf\",\"placeholder_name\":\"Περιοχή Χρήστη - Οι υποθέσεις μου - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Εδώ μπορείτε να δείτε τις ενεργές υποθέσεις σας με το δημόσιο.\",\"placeholder_en_text\":\"Here you can view your active cases with the public sector.\",\"is_active\":true},{\"id\":\"92c99f80-0bf4-4c1c-b462-aa8ae5a2904d\",\"placeholder_name\":\"Περιοχή Χρήστη - Οι υποθέσεις μου - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Οι υποθέσεις μου\",\"placeholder_en_text\":\"My cases\",\"is_active\":true},{\"id\":\"82a5cb90-468b-419a-a481-d45f47590049\",\"placeholder_name\":\"Περιοχή Χρήστη - Οι φορείς μου - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Εδώ μπορείτε να δείτε τους φορείς που έχετε επιλέξει να παρακολουθείτε.\",\"placeholder_en_text\":\"Here you can view the organizations you have chosen to follow.\",\"is_active\":true},{\"id\":\"2cff998f-ce87-4f40-90b6-ce9d2a7f43e1\",\"placeholder_name\":\"Περιοχή Χρήστη - Οι φορείς μου - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Οι φορείς μου\",\"placeholder_en_text\":\"My organizations\",\"is_active\":true},{\"id\":\"6243b882-80b3-4ba3-b3fb-20660ca5d2a7\",\"placeholder_name\":\"Περιοχή Χρήστη - Τα ραντεβού μου - Meta Περιγραφή [textarea]\",\"placeholder_el_text\":\"Εδώ μπορείτε να δείτε τα ενεργά ραντεβού σας.\",\"placeholder_en_text\":\"Here you can view your active appointments.\",\"is_active\":true},{\"id\":\"385d962e-ac36-49a2-9cbe-97724b1faa2d\",\"placeholder_name\":\"Περιοχή Χρήστη - Τα ραντεβού μου - Meta Τίτλος [input text]\",\"placeholder_el_text\":\"Τα ραντεβού μου\",\"placeholder_en_text\":\"My appointments\",\"is_active\":true},{\"id\":\"f7834946-4f25-4166-bbdc-c1613