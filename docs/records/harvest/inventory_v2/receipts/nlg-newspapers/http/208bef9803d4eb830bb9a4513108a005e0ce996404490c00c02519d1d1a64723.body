lder_name\":\"Search Placeholder [input text]\",\"placeholder_el_text\":\"Αναζητήστε εδώ ...\",\"placeholder_en_text\":\"Search here ...\",\"is_active\":true},{\"id\":\"041a6a68-39ca-4871-9765-1e61875e59bb\",\"placeholder_name\":\"Αποτελέσματα [input text]\",\"placeholder_el_text\":\"αποτελέσματα\",\"placeholder_en_text\":\"results\",\"is_active\":true},{\"id\":\"216c0d67-491e-4459-9a13-3aa72f4855ee\",\"placeholder_name\":\"Δεν Βρέθηκαν Αποτελέσματα [input text]\",\"placeholder_el_text\":\"Δεν βρέθηκαν αποτελέσματα.\",\"placeholder_en_text\":\"No results found.\",\"is_active\":true}]},{\"id\":\"80ca0044-98ed-4e20-bf35-e6c4dcfd6abd\",\"section_name\":\"ΣΕΛΙΔΑ - ΑΡΧΙΚΗ\",\"page_fields\":[{\"id\":\"1854acf8-19af-4402-a158-8f3c0816c4cd\",\"placeholder_name\":\"Categories Section Τίτλος [input text]\",\"placeholder_el_text\":\"Κατηγορίες Υπηρεσιών\",\"placeholder_en_text\":\"Service Categories\",\"is_active\":true},{\"id\":\"1d4c4ac4-c752-47d8-8559-a61fb317c2ea\",\"placeholder_name\":\"Categories Section Υπότιτλος [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eΗ ψηφιακή πύλη του gov.gr σας παρέχει πρόσβαση σε \u003cstrong\u003e{services_count}\u003c/strong\u003e υπηρεσίες οργανωμένες κάτω από \u003cstrong\u003e{categories_count}\u003c/strong\u003e βασικές κατηγορίες για να βρείτε ακριβώς αυτό που ψάχνετε.\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003eThe digital portal of gov.gr gives you access to \u003cstrong\u003e{services_count}\u003c/strong\u003e services organized under \u003cstrong\u003e{categories_count}\u003c/strong\u003e basic categories to find exactly what you are looking for.\u003c/p\u003e\",\"is_active\":true},{\"id\":\"b5cee752-95d8-4171-aa20-bcb54b9550cc\",\"placeholder_name\":\"Featured Page Section - Back To Top [input text]\",\"placeholder_el_text\":\"Επιστροφή στην κορυφή\",\"placeholder_en_text\":\"Back to top\",\"is_active\":true},{\"id\":\"e0242266-735c-476f-bf13-d41ea5a81618\",\"placeholder_name\":\"Featured Page Section - Τίτλος Συνδέσμων [input text]\",\"placeholder_el_text\":\"Σύνδεσμοι\",\"placeholder_en_text\":\"Links\",\"is_active\":true},{\"id\":\"5ecb6e90-143e-4bad-8b96-f1f2526b35f3\",\"placeholder_name\":\"Header Κεφαλίδα [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eΒρείτε τη δημόσια υπηρεσία που θέλετε \u003cstrong\u003eεύκολα \u003c/strong\u003eκαι \u003cstrong\u003eγρήγορα\u003c/strong\u003e\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003eDigital public services, the \u003cstrong\u003equick \u003c/strong\u003eand \u003cstrong\u003eeasy \u003c/strong\u003eway\u003c/p\u003e\",\"is_active\":true},{\"id\":\"7a147d0c-9985-4f3f-ad6e-38c49f99f9a3\",\"placeholder_name\":\"Header Τίτλος Featured Υπηρεσιών [input text]\",\"placeholder_el_text\":\"Επίκαιρες αναζητήσεις\",\"placeholder_en_text\":\"Popular on gov.gr\",\"is_active\":true},{\"id\":\"2af768b8-6019-4f6c-9e03-bccd4f8d8db3\",\"placeholder_name\":\"Header Τίτλος Suggested Υπηρεσιών [input text]\",\"placeholder_el_text\":\"Προτεινόμενα\",\"placeholder_en_text\":\"Suggested\",\"is_active\":true},{\"id\":\"50955fb6-bc1e-47a2-90de-52aa4e4d5018\",\"placeholder_name\":\"Hub Section Περιγραφή [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eΤο \u003ca href=\\\"https://www.gov.gr/el\\\"\u003e\u003cstrong\u003egov.gr\u003c/strong\u003e\u003c/a\u003e είναι η διαδικτυακή πύλη του ελληνικού κράτους. Φιλοξενεί όλες τις ψηφιακές υπηρεσίες των \u003ca href=\\\"https://www.gov.gr/el/organizations/ministries\\\"\u003e\u003cstrong\u003eυπουργείων\u003c/strong\u003e\u003c/a\u003e, φορέων, οργανισμών, \u003ca href=\\\"https://www.gov.gr/el/organizations/authorities\\\"\u003e\u003cstrong\u003eανεξάρτητων αρχών\u003c/strong\u003e\u003c/a\u003e και \u003ca href=\\\"https://www.gov.gr/el/organizations/regions\\\"\u003e\u003cstrong\u003eπεριφερειών\u003c/strong\u003e\u003c/a\u003e του Δημοσίου, που παρέχονται ήδη μέσω διαδικτύου.\u003c/p\u003e\u003cp\u003eΜέσα από την ενότητα αυτή μπορείτε να περιηγηθείτε στις παρεχόμενες ψηφιακές υπηρεσίες. \u003c/p\u003e\u003cp\u003eΗ αναζήτηση με βάση τον φορέα σάς επιτρέπει να εντοπίζετε γρήγορα τις διαθέσιμες υπηρεσίες του οργανισμού που σας ενδιαφέρει, διευκολύνοντας την πρόσβαση στις πληροφορίες και τις ηλεκτρονικές συναλλαγές που προσφέρει.\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003e\u003ca href=\\\"https://www.gov.gr/en\\\"\u003e\u003cstrong\u003eGov.gr\u003c/strong\u003e\u003c/a\u003e is the web portal of the Greek state. It hosts all the digital services of the \u003ca href=\\\"https://www.gov.gr/en/organizations/ministries\\\"\u003e\u003cstrong\u003eministries\u003c/strong\u003e\u003c/a\u003e, agencies, organizations, \u003ca href=\\\"https://www.gov.gr/en/organizations/authorities\\\"\u003e\u003cstrong\u003eindependent authorities\u003c/strong\u003e\u003c/a\u003e and \u003ca href=\\\"https://www.gov.gr/en/organizations/regions\\\"\u003e\u003cstrong\u003eregions\u003c/strong\u003e\u003c/a\u003e of the State, which are already provided via the internet.\u003c/p\u003e\u003cp\u003eThrough this section you can browse the digital services provided.\u003c/p\u003e\u003cp\u003eSearching by agency allows you to quickly locate the available services of the organization you are interested in, facilitating access to the information and electronic transactions it offers.\u003c/p\u003e\",\"is_active\":true},{\"id\":\"e53c8fb2-5bb7-46e6-b9cf-952cbc1e4b5f\",\"placeholder_name\":\"Hub Section Τίτλος [input text]\",\"placeholder_el_text\":\"Αναζητήστε ψηφιακές υπηρεσίες βάσει φορέα\",\"placeholder_en_text\":\"Search digital services by organization\",\"is_active\":true},{\"id\":\"15469079-bebf-4880-80db-3365c6c034af\",\"placeholder_name\":\"Hub Section Υπότιτλος [input text]\",\"placeholder_el_text\":\"Πλοηγηθείτε στις ψηφιακές υπηρεσίες των φορέων.\",\"placeholder_en_text\":\"Navigate to the organization's digital services.\",\"is_active\":true},{\"id\":\"f9fb2151-4e99-420a-a15c-83d60d022751\",\"placeholder_name\":\"Προσωποποιημένη Ενότητα - Header Τίτλος [input text]\",\"placeholder_el_text\":\"Η Περιοχή μου στο Gov.gr\",\"placeholder_en_text\":\"My Area on Gov.gr\",\"is_active\":true},{\"id\":\"22b1acc6-b1c7-4a41-860b-011919e5ff13\",\"placeholder_name\":\"Προσωποποιημένη Ενότητα - Αγαπημένα organization - Κανένα αγαπημένο [input text] [input text]\",\"placeholder_el_text\":\"Δεν έχετε προσθέσει ακόμα αγαπημένους φορείς.\",\"placeholder_en_text\":\"You have not added any favorite organizations yet.\",\"is_active\":true},{\"id\":\"9e6cae2d-461c-461d-9534-fa7e86913850\",\"placeholder_name\":\"Προσωποποιημένη Ενότητα - Αγαπημένα organization - Τίτλος [input text]\",\"placeholder_el_text\":\"Οι φορείς μου\",\"placeholder_en_text\":\"My organizations\",\"is_active\":true},{\"id\":\"c9a52303-da9f-439c-ba84-194dd7bbb082\",\"placeholder_name\":\"Προσωποποιημένη Ενότητα - Αγαπημένα service - Κανένα αγαπημένο [input text]\",\"placeholder_el_text\":\"Δεν έχετε προσθέσει ακόμα αγαπημένες υπηρεσίες.\",\"placeholder_en_text\":\"You have not added any favorite services yet.\",\"is_active\":true},{\"id\":\"e677dbeb-5c48-4587-9743-c72364e0a69b\",\"placeholder_name\":\"Προσωποποιημένη Ενότητα - Αγαπημένα service - Τίτλος [input text]\",\"placeholder_el_text\":\"Οι υπηρεσίες μου\",\"placeholder_en_text\":\"My services\",\"is_active\":true},{\"id\":\"05686ca8-0b93-4db8-980c-33233087637b\",\"placeholder_name\":\"Προσωποποιημένη Ενότητα - Αγαπημένα - Προβολή όλων [input text]\",\"placeholder_el_text\":\"Προβολή όλων\",\"placeholder_en_text\":\"View all\",\"is_active\":true},{\"id\":\"6610f9b5-75a1-4db0-8907-d035cf75e3df\",\"placeholder_name\":\"Προσωποποιημένη Ενότητα - Χρήσιμοι Σύνδεσμοι - Header Τίτλος [input text]\",\"placeholder_el_text\":\"Γρήγορη πρόσβαση\",\"placeholder_en_text\":\"Quick access\",\"is_active\":true}]},{\"id\":\"af3be3b8-e945-48a5-97e0-7b5f5c57b141\",\"section_name\":\"ΣΕΛΙΔΑ - ΠΡΟΤΑΣΕΙΣ ΓΙΑ ΤΟ GOV.GR\",\"page_fields\":[{\"id\":\"dd31ff65-1fb3-4235-af32-c6e6130b5125\",\"placeholder_name\":\"Button URL [input text]\",\"placeholder_el_text\":\"https://support.gov.gr/WebTicket/frmPaatCitizenSiteIssues.zul?typeId=2\u0026type=govgr73\",\"placeholder_en_text\":\"https://support.gov.gr/WebTicket/frmPaatCitizenSiteIssues.zul?typeId=2\u0026type=govgr73\",\"is_active\":true},{\"id\":\"d218b180-a1fd-4f1e-8a41-edde9119d193\",\"placeholder_name\":\"Button Τίτλος [input text]\",\"placeholder_el_text\":\"Υποβολή πρότασης\",\"placeholder_en_text\":\"Make a suggestion\",\"is_active\":true},{\"id\":\"437a86b7-eaab-4b0c-adb9-1debf1539dec\",\"placeholder_name\":\"Page Εισαγωγή [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eΜπορείτε να καταθέσετε μια πρόταση που θα κάνει το gov.gr καλύτερο πατώντας στον σχετικό σύνδεσμο παρακάτω.\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003eYou can make suggestions on how to improve the gov.gr website. Click on the \\\"Make a suggestion\\\" link below.\u003c/p\u003e\",\"is_active\":true},{\"id\":\"66ba541f-95f3-4c67-8731-da4a2e38ac82\",\"placeholder_name\":\"Page Κεφαλίδα [input text]\",\"placeholder_el_text\":\"Προτάσεις για το gov.gr\",\"placeholder_en_text\":\"Suggestions for gov.gr\",\"is_active\":true},{\"id\":\"1834fe29-f338-421f-983a-d338d49ab254\",\"placeholder_name\":\"Page Πλαίσιο [textarea]\",\"placeholder_el_text\":\"Για πληροφορίες ή ερωτήσεις σχετικά με μια υπηρεσία του gov.gr, επιλέξτε “Επικοινωνία” στη σελίδα της συγκεκριμένης υπηρεσίας για να επικοινωνήσετε απευθείας με το υπουργείο, τον φορέα ή την ανεξάρτητη αρχή που την παρέχει.\",\"placeholder_en_text\":\"In case you require further information or assistance for a specific service, please contact the competent organisation directly. Visit the service's page in gov.gr and click on \\\"Contact\\\".\",\"is_active\":true}]}],\"userProfile\":null,\"helpfulVotes\":[],\"favoriteServices\":[],\"children\":\"$L1b\"}]\n"])</script><script nonce="ODdkNWM4MzQtYzU1Ni00ZWFjLTlmNzktNGNhZDkwYjU4NzI1">self.__next_f.push([1,"1c:I[59393,[\"9268\",\"static/chunks/aaea2bcf-6ba775cf21d00197.js\"