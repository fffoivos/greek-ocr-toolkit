aceholder_el_text\":\"Νομοθεσία\",\"placeholder_en_text\":\"Legislation\",\"is_active\":true},{\"id\":\"93d91e83-2d6c-48ff-a108-d373008e7c36\",\"placeholder_name\":\"Sidebar Χρήσιμοι Σύνδεσμοι - manual [input text]\",\"placeholder_el_text\":\"Οδηγίες Χρήσης\",\"placeholder_en_text\":\"User Guide\",\"is_active\":true},{\"id\":\"9a6fa4cf-6058-4875-b112-e52908a3b12e\",\"placeholder_name\":\"Sidebar Χρήσιμοι Σύνδεσμοι - mitos [input text]\",\"placeholder_el_text\":\"ΕΜΔΔ - ΜΙΤΟΣ\",\"placeholder_en_text\":\"EMDD - MITOS\",\"is_active\":true},{\"id\":\"da30870b-ea18-400c-9d46-ff53b2a90e6c\",\"placeholder_name\":\"User Feedback - Additional Comments [input text]\",\"placeholder_el_text\":\"Επιπλέον σχόλια\",\"placeholder_en_text\":\"Additional comments\",\"is_active\":true},{\"id\":\"e6357036-2d11-4251-903a-c33aa56e37a4\",\"placeholder_name\":\"User Feedback - Help Button [input text]\",\"placeholder_el_text\":\"Θέλω να αξιολογήσω\",\"placeholder_en_text\":\"I want to evaluate\",\"is_active\":true},{\"id\":\"e03cd23f-89f9-41bc-952c-3176c60a9f53\",\"placeholder_name\":\"User Feedback - Help [textarea]\",\"placeholder_el_text\":\"Παρακαλούμε βοηθήστε μας να βελτιωθούμε αξιολογώντας μας. Θα χρειαστεί να απαντήσετε σε μερικές ερωτήσεις. Η διαδικασία αξιολόγησης διαρκεί λιγότερο από 1 λεπτό.\",\"placeholder_en_text\":\"Please help us improve by evaluating us. You will need to answer a few questions. The evaluation process takes less than 1 minute.\",\"is_active\":true},{\"id\":\"a198eda3-90b2-4b5f-bd96-e001aef56e64\",\"placeholder_name\":\"User Feedback - Modal Cancel [input text]\",\"placeholder_el_text\":\"Ακύρωση\",\"placeholder_en_text\":\"Cancel\",\"is_active\":true},{\"id\":\"ef9b99a4-8b01-49d4-8edc-3a3bf54b0ce4\",\"placeholder_name\":\"User Feedback - Modal Confirm [input text]\",\"placeholder_el_text\":\"Συνέχεια\",\"placeholder_en_text\":\"Continue\",\"is_active\":true},{\"id\":\"149d5aa5-6f2d-464a-8181-9dbe60279b68\",\"placeholder_name\":\"User Feedback - Modal - Feedback - Description [textarea]\",\"placeholder_el_text\":\"Είστε σίγουροι ότι θέλετε να αφαιρέσετε την ανατροφοδότησή σας;\",\"placeholder_en_text\":\"Are you sure you want to remove your feedback?\",\"is_active\":true},{\"id\":\"c8e4669e-95d0-4c34-a15d-25bd8203454f\",\"placeholder_name\":\"User Feedback - Modal - Feedback - Title [input text]\",\"placeholder_el_text\":\"Αναμένεται να αφαιρέσετε την ανατροφοδότησή σας\",\"placeholder_en_text\":\"You are about to remove your feedback\",\"is_active\":true},{\"id\":\"1b28e307-3e48-4902-b71d-cb1bd970d6e0\",\"placeholder_name\":\"User Feedback - Modal - Rating - Description [textarea]\",\"placeholder_el_text\":\"Είστε σίγουροι ότι θέλετε να αφαιρέσετε την αξιολόγηση σας; Με την αφαίρεση της αξιολόγησης σας, θα διαγραφεί και η ανατροφοδότησή σας στο ερωτηματολόγιο.\",\"placeholder_en_text\":\"Are you sure you want to remove your rating? Removing your rating will also delete your feedback from the questionnaire.\",\"is_active\":true},{\"id\":\"351743f3-ef38-462c-95bf-76b9bf5690af\",\"placeholder_name\":\"User Feedback - Modal - Rating - Title [input text]\",\"placeholder_el_text\":\"Αναμένεται να αφαιρέσετε την αξιολόγηση σας\",\"placeholder_en_text\":\"You are about to remove your rating\",\"is_active\":true},{\"id\":\"5f46cb6e-a3de-4ab8-9679-16ddbf4fc5f4\",\"placeholder_name\":\"User Feedback - Required Field [input text]\",\"placeholder_el_text\":\"Πρέπει να συμπληρώσετε το πεδίο.\",\"placeholder_en_text\":\"This field is required.\",\"is_active\":true},{\"id\":\"7a62ece3-fb4a-4f47-b75c-203369c85538\",\"placeholder_name\":\"User Feedback - Submit Button [input text]\",\"placeholder_el_text\":\"Υποβολή Ανατροφοδότησης\",\"placeholder_en_text\":\"Submit Feedback\",\"is_active\":true},{\"id\":\"7733b404-cbac-4f0c-9fca-e95808787236\",\"placeholder_name\":\"User Feedback - Useful Instructions [input text]\",\"placeholder_el_text\":\"Χρήσιμες Οδηγίες\",\"placeholder_en_text\":\"Useful Instructions\",\"is_active\":true},{\"id\":\"250b7fc6-2425-4afc-b133-7a18db069f1e\",\"placeholder_name\":\"User Feedback - Useful Section Περιγραφή [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eΠαρακαλούμε χρησιμοποιήστε πεζά ελληνικά για την ανατροφοδότησή σας αντί για greeklish και κεφαλαία, για να διασφαλιστεί η σαφήνεια και η κατανοησιμότητα των σχολίων σας.\u003c/p\u003e\u003cp\u003eΈχετε τη δυνατότητα να ενημερώσετε την αξιολόγησή σας οποιαδήποτε στιγμή καθώς το περιεχόμενο των σελίδων ανανεώνεται τακτικά βάσει των ανατροφοδοτήσεων σας.\u003c/p\u003e\u003cp\u003eΣτις ερωτήσεις επιλέξτε μία από τις εξής απαντήσεις: Καθόλου, Λίγο, Αρκετά, Δεν έχω άποψη. Αυτό βοηθά στην καταγραφή της αντίληψής σας για την υπηρεσία.\u003c/p\u003e\u003cp\u003eΧρησιμοποιήστε τα αστεράκια για να βαθμολογήσετε την υπηρεσία, από 1 έως 5, ανάλογα με το συνολικό επίπεδο ικανοποίησής σας.\u003c/p\u003e\u003cp\u003eΧρησιμοποιήστε το πεδίο ελεύθερου κειμένου για να μοιραστείτε τις λεπτομερείς σκέψεις ή προτάσεις σας. Η γνώμη σας είναι πολύτιμη για τη βελτίωση των υπηρεσιών μας.\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003ePlease use lowercase Greek for your feedback instead of Greeklish and capital letters, to ensure the clarity and readability of your comments.\u003c/p\u003e\u003cp\u003eYou can update your evaluation at any time, as the page content is regularly updated based on your feedback.\u003c/p\u003e\u003cp\u003eFor each question, please choose one of the following answers: Not at all, A little, Quite a lot, No opinion. This helps capture your perception of the service.\u003c/p\u003e\u003cp\u003eUse the stars to rate the service from 1 to 5, based on your overall level of satisfaction.\u003c/p\u003e\u003cp\u003eUse the free-text field to share your detailed thoughts or suggestions. Your opinion is valuable for improving our services.\u003c/p\u003e\",\"is_active\":true},{\"id\":\"05f067b3-524d-499f-8958-59f9d97d2ab7\",\"placeholder_name\":\"User Feedback - Βαθμολογία [input text]\",\"placeholder_el_text\":\"Βαθμολογία\",\"placeholder_en_text\":\"Rating\",\"is_active\":true},{\"id\":\"4d4eac2a-fc14-4f7d-8f77-31a2468b74f1\",\"placeholder_name\":\"User Feedback - Περιγραφή Popup Αποτυχίας [input text]\",\"placeholder_el_text\":\"Αποτυχία προσθήκης της ανατροφοδότησης.\",\"placeholder_en_text\":\"Failed to add the feedback.\",\"is_active\":true},{\"id\":\"681c9df3-4137-4108-b94a-71ac5e7d6445\",\"placeholder_name\":\"User Feedback - Περιγραφή Popup Προσθήκης [input text]\",\"placeholder_el_text\":\"Επιτυχής υποβολή ανατροφοδότησης\",\"placeholder_en_text\":\"Successful feedback submission\",\"is_active\":true},{\"id\":\"cfd95026-a77f-4b22-a3d6-ab9882030adf\",\"placeholder_name\":\"User Feedback - Περιγραφή Βαθμολογίας [input text]\",\"placeholder_el_text\":\"Βαθμολογήστε το συνολικό επίπεδο ικανοποίησής σας\",\"placeholder_en_text\":\"Rate your overall level of satisfaction\",\"is_active\":true},{\"id\":\"7a9ac847-b505-4a9e-9708-71553fbe2d37\",\"placeholder_name\":\"Γενικές Υπηρεσίες [input text]\",\"placeholder_el_text\":\"Γενικές Υπηρεσίες\",\"placeholder_en_text\":\"General services\",\"is_active\":true},{\"id\":\"1f7a4733-f1f7-4d8d-bfdd-439271e6b5ce\",\"placeholder_name\":\"Επόμενη Κατάσταση [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eΗ υπηρεσία θα λάβει την κατάσταση {next_status} στις {date}\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003eThe service will receive the status {next_status} on {date}\u003c/p\u003e\",\"is_active\":true},{\"id\":\"84085610-67cf-431b-b145-48c3fba7f32c\",\"placeholder_name\":\"Κατάσταση Υπηρεσίας - deprecated [input text]\",\"placeholder_el_text\":\"δημοσιευμένη με ανενεργή συναλλαγή\",\"placeholder_en_text\":\"published with inactive transaction\",\"is_active\":true},{\"id\":\"baca6fd8-7314-4cda-a8f0-d9c15dbaa1bb\",\"placeholder_name\":\"Κατάσταση Υπηρεσίας - disabled [input text]\",\"placeholder_el_text\":\"ανενεργή\",\"placeholder_en_text\":\"disabled\",\"is_active\":true},{\"id\":\"a77f11c7-75a6-4aaa-a5ff-4710418719f4\",\"placeholder_name\":\"Κατάσταση Υπηρεσίας - published [input text]\",\"placeholder_el_text\":\"δημοσιευμένη\",\"placeholder_en_text\":\"published\",\"is_active\":true},{\"id\":\"8eb35b65-b246-4067-9138-f1ceb1ebe41b\",\"placeholder_name\":\"Μη Διαθέσιμο Αγγλικό Περιεχόμενο [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eThe content you were looking for is not yet available in the English language.\u003c/p\u003e\u003cp\u003ePlease visit again soon.\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003eThe content you were looking for is not yet available in the English language.\u003c/p\u003e\u003cp\u003ePlease visit again soon.\u003c/p\u003e\",\"is_active\":true},{\"id\":\"02f10842-b116-487e-a5a2-595f89f5ed26\",\"placeholder_name\":\"Σελίδα Επικοινωνίας - Email [input text]\",\"placeholder_el_text\":\"Email υποστήριξης\",\"placeholder_en_text\":\"Email support\",\"is_active\":true},{\"id\":\"d90799bf-e10f-4647-9dd5-0f028c3b2ab4\",\"placeholder_name\":\"Σελίδα Επικοινωνίας - Κουμπί Υποστήριξης [input text]\",\"placeholder_el_text\":\"Επικοινωνία με τον Φορέα Εξυπηρέτησης\",\"placeholder_en_text\":\"Contact the Service Provider\",\"is_active\":true},{\"id\":\"1d72d41c-3a90-4ce1-8ef8-ef3272ac9e82\",\"placeholder_name\":\"Σελίδα Επικοινωνίας - Περιγραφή [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003eΔεν έχει ενταχθεί στην ενοποιημένη πλατφόρμα ψηφιακής εξυπηρέτησης \u003ca href=\\\"https://support.gov.gr\\\"\u003eSupport.gov.gr\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eΥπεύθυνος φορέας εξυπηρέτησης : {organization}\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003eNot integrated into the unified digital service platform \u003ca href=\\\"https://support.gov.gr\\\"\u003eSupport.gov.gr\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eResponsible service provider : {organization}\u003c/p\u003e\",\"is_active\":true},{\"id\":\"d8d4c8f4-1796-4ebf-9348-58b94481d31f\",\"placeholder_name\":\"Σελίδα Επικοινωνίας - Τηλέφωνο [input text]\",\"placeholder_el_text\":\"Τηλεφωνική εξυπηρέτηση\",\"placeholder_en_text\":\"Phone support\",\"is_active\":true},{\"id\":\"f2ea6be6-73f4-48cf-b3b7-a0540b3bcf38\",\"placeholder_name\":\"Σελίδα Επικοινωνίας - Τίτλος [input text]\",\"placeholder_el_text\":\"Η ψηφιακή υπηρεσία\",\"placeholder_en_text\":\"Digital Service\",\"is_active\":true},{\"id\":\"3655d6b4-f679-4480-bd34-8b6fd25fd63e\",\"placeholder_name\":\"Σχετικές Συναλλαγές [input text]\",\"placeholder_el_text\":\"Σχετικές Συναλλαγές\",\"placeholder_en_text\":\"Related services\",\"is_active\":true},{\"id\":\"02a2515d-16e5-4d01-88f4-04f2890652da\",\"placeholder_name\":\"Υψηλή Βαθμολογία [input text]\",\"placeholder_el_text\":\"Αυτή η υπηρεσία έχει συγκεντρώσει υψηλή βαθμολογία από τους χρήστες.\",\"placeholder_en_text\":\"This service has been highly rated by users.\",\"is_active\":true}]},{\"id\":\"e896dd5f-f980-470c-92c0-29d1cd52470d\",\"section_name\":\"ΠΡΟΒΟΛΗ - ΣΕΛΙΔΕΣ ΦΟΡΕΩΝ\",\"page_fields\":[{\"id\":\"d989b443-5686-4573-bea3-f4c342022356\",\"placeholder_name\":\"AD [input text]\",\"placeholder_el_text\":\"Αποκεντρωμένες Διοικήσεις\",\"placeholder_en_text\":\"Decentralized Administrations\",\"is_active\":true},{\"id\":\"7c73ffa8-0226-4571-9c62-879d03a1e044\",\"placeholder_name\":\"IAuth [input text]\",\"placeholder_el_text\":\"Ανεξάρτητες Αρχές\",\"placeholder_en_text\":\"Independent Authorities\",\"is_active\":true},{\"id\":\"1f25417d-257e-413d-8b0d-ab2e68214155\",\"placeholder_name\":\"Ministry [input text]\",\"placeholder_el_text\":\"Υπουργεία\",\"placeholder_en_text\":\"Ministries\",\"is_active\":true},{\"id\":\"16dd37c0-4de6-4026-9cae-0d0072ae705d\",\"placeholder_name\":\"Region [input text]\",\"placeholder_el_text\":\"Περιφέρειες\",\"placeholder_en_text\":\"Regions\",\"is_active\":true},{\"id\":\"e8130a4f-7f6b-4c04-a3d8-1d55c0f391df\",\"placeholder_name\":\"Αριθμός Φορέα Ανά Τύπο [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003e\u003cstrong\u003e{organizations_count}\u003c/strong\u003e {organizations_type} \u003cspan style=\\\"color: rgb(33, 41, 48)\\\"\u003eγια να βρείτε ακριβώς αυτό που ψάχνετε.\u003c/span\u003e\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003e\u003cstrong\u003e{organizations_count}\u003c/strong\u003e {organizations_type} to find exactly what you are looking for\u003cspan style=\\\"color: rgb(33, 41, 48)\\\"\u003e.\u003c/span\u003e\u003c/p\u003e\",\"is_active\":true},{\"id\":\"34c29787-5855-47c2-9c1d-bdadf441bef0\",\"placeholder_name\":\"Οργανισμοί του φορέα - Περιγραφή [textarea]\",\"placeholder_el_text\":\"Στη λίστα παρακάτω μπορείτε να δείτε τους φορείς που υπάγονται στον επιλεγμένο φορέα με τις υπηρεσίες τους.\",\"placeholder_en_text\":\"In the list below you can see the organizations under the selected organization with their services.\",\"is_active\":true},{\"id\":\"97e55747-9b8f-4676-ac87-05a82bf71307\",\"placeholder_name\":\"Οργανισμοί του φορέα - Τίτλος [input text]\",\"placeholder_el_text\":\"Εποπτευόμενοι φορείς\",\"placeholder_en_text\":\"Supervised organizations\",\"is_active\":true},{\"id\":\"9c733fac-2d31-4213-af5d-6f7aa2c2ba02\",\"placeholder_name\":\"Προβολή όλων των υπηρεσιών - Περιγραφή [rich editor]\",\"placeholder_el_text\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(37, 40, 48)\\\"\u003eΣτη λίστα παρακάτω μπορείτε να δείτε τις υπηρεσίες που αφορούν τον οργανισμό\u003c/span\u003e {organizations_name}\u003cspan style=\\\"color: rgb(37, 40, 48)\\\"\u003e, κατηγοριοποιημένες\u003c/span\u003e.\u003c/p\u003e\",\"placeholder_en_text\":\"\u003cp\u003eIn the list below you can see the services related to the organization {organizations_name}\u003cspan style=\\\"color: rgb(37, 40, 48)\\\"\u003e,\u003c/span\u003e categorized.\u003c/p\u003e\",\"is_active\":true},{\"id\":\"acb6444e-026d-4644-89a0-41c13707bd31\",\"placeholder_name\":\"Προβολή όλων των υπηρεσιών - Τίτλος [input text]\",\"placeholder_el_text\":\"Προβολή όλων των υπηρεσιών\",\"placeholder_en_text\":\"View all services\",\"is_active\":true},{\"id\":\"15ccbcdd-4a41-468c-8033-f41fcbc67