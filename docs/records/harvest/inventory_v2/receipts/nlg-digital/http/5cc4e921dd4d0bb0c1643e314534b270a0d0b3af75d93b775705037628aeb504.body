<script>

    var switchLocale = function(newLocale) {
        jQuery.ajax({
            type:"POST",
            dataType:"json",
            traditional:true,
            url:"",
            data:{locale:newLocale}
        }).done(function() {
            location.reload();
        });
        return true;
    }

    var switchTpl = function(tpl) {
        var form = jQuery('#searchForm');
        form.find("input[name='p.tpl']").val(tpl);
        form.submit();
        return false;
    }

    var switchSortOption = function(sortOption) {
        var form = jQuery('#searchForm');
        //form.find("input[name='p.start']").val("0");
        form.find("input[name='currentSearchSortField']").val(sortOption);
        form.submit();
        return false;
    }

    $(function() {

        
        var paginationClick = function() {
            var start = jQuery(this).data("start");
            var form = jQuery("#searchForm");
            form.find("input[name='p.start']").val(start);
            form.submit();
            return false;
        }

        jQuery('.paginationGoTo').click(paginationClick);

        jQuery('.paginationNext').click(paginationClick);

        jQuery('.paginationPrev').click(paginationClick);

        jQuery('.paginationFirst').click(paginationClick);

        jQuery('.paginationLast').click(paginationClick);

        
                jQuery('#searchForm input.filter').on('change',function(){
            jQuery("#searchForm").submit();
        });

        jQuery('#searchForm input.in-modal').on('change',function(){
            var frm = jQuery("#searchForm");
            var id = $(this).val();
            var checked = $(this).prop('checked');
            var input = frm.find("[data-id='" + id + "']");
            if (input[0]) {
                input.click();
            }
            else {
                                var name = $(this).data('name');
                $('<input>').attr({
                    type: 'hidden',
                    name: name,
                    value: id
                }).appendTo(frm);
                frm.submit();
            }
        });

        
        var container = jQuery('.masonry-container');
        if (container[0]) {
            container.imagesLoaded( function () {
                                container.masonry({
                    columnWidth: '.masonry-item',
                    itemSelector: '.masonry-item'
                });
                            });
        }

        jQuery('#modal_cit').on('show.bs.modal', function (event) {
            console.log("showing...");
            var modal = jQuery(this);
            var anchor = jQuery(event.relatedTarget);
            var format = anchor.data('format');
            console.log(format);
            jQuery.ajax({
                type:"GET",
                dataType:"text",
                traditional:true,
                url:"/nlg-repo/dl/citation?id=${object.getPath().toString()}&format=" + format
            }).done(function(txt) {
                console.log(txt);
                modal.find('.modal-title').text("Βιβλιογραφική Αναφορά - " + format);
                modal.find('.citation').text(txt);
                modal.find('a.btn-download').attr('href', "/nlg-repo/dl/citation?id=${object.getPath().toString()}&file=true&format=" + format)
            });
        });

    });

</script>


