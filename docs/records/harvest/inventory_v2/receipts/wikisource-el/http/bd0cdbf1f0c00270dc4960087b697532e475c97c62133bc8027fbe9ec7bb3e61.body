<div id="mf-newtexts">
<div class="mw-heading mw-heading3"><h3 id="Νέα_κείμενα"><span id=".CE.9D.CE.AD.CE.B1_.CE.BA.CE.B5.CE.AF.CE.BC.CE.B5.CE.BD.CE.B1"></span>Νέα κείμενα</h3></div>
<ul><li><i><a href="/wiki/%CE%8E%CE%BC%CE%BD%CE%BF%CF%82_%CF%84%CE%BF%CF%85_%CE%94%CE%A3%CE%95" title="Ύμνος του ΔΣΕ">Ύμνος του ΔΣΕ</a></i></li>
<li><a href="/wiki/%CE%A3%CF%85%CE%B3%CE%B3%CF%81%CE%B1%CF%86%CE%AD%CE%B1%CF%82:%CE%99%CF%89%CE%AC%CE%BD%CE%BD%CE%B7%CF%82_%CE%9A%CE%BF%CE%BD%CE%B4%CF%85%CE%BB%CE%AC%CE%BA%CE%B7%CF%82" title="Συγγραφέας:Ιωάννης Κονδυλάκης">Ιωάννη Κονδυλάκη</a>: <i><a href="/wiki/%CE%97_%CE%9A%CE%AC%CE%BA%CE%B9%CE%B1_%CE%BC%CE%B1%CF%82" title="Η Κάκια μας">Η Κάκια μας</a></i>, <i><a href="/wiki/%CE%9F_%CE%B2%CF%81%CF%85%CE%BA%CF%8C%CE%BB%CE%B1%CE%BA%CE%B1%CF%82" title="Ο βρυκόλακας">Ο βρυκόλακας</a></i></li>
<li><a href="/wiki/%CE%A3%CF%85%CE%B3%CE%B3%CF%81%CE%B1%CF%86%CE%AD%CE%B1%CF%82:%CE%9A%CF%89%CF%83%CF%84%CE%AE%CF%82_%CE%A0%CE%B1%CE%BB%CE%B1%CE%BC%CE%AC%CF%82" title="Συγγραφέας:Κωστής Παλαμάς">Κωστή Παλαμά</a>: <i><a href="/wiki/%CE%9F_%CE%9C%CE%B1%CF%8D%CF%81%CE%BF%CF%82" title="Ο Μαύρος">Ο Μαύρος</a></i>, <i><a href="/wiki/%CE%97_%CE%BC%CE%B1%CF%84%CE%B9%CE%AC_%CF%84%CE%B7%CF%82_%CE%BA%CF%8C%CF%81%CE%B7%CF%82" title="Η ματιά της κόρης">Η ματιά της κόρης</a></i>, <i><a href="/wiki/%CE%97_%CF%88%CF%85%CF%87%CE%AE" title="Η ψυχή">Η ψυχή</a></i>, <i><a href="/wiki/%CE%A6%CE%B8%CE%B9%CE%BD%CF%8C%CF%80%CF%89%CF%81%CE%BF%CE%BD" title="Φθινόπωρον">Φθινόπωρον</a></i>, <i><a href="/wiki/%CE%A4%CE%BF_%CF%84%CE%B1%CE%BE%CE%AF%CE%B4%CE%B9" title="Το ταξίδι">Το ταξίδι</a></i>, <i><a href="/wiki/%CE%95%CF%80%CE%B9%CF%83%CF%84%CE%BF%CE%BB%CE%AE" title="Επιστολή">Επιστολή</a></i>, <i><a href="/wiki/%CE%A0%CF%81%CE%BF%CF%83%CE%B5%CF%85%CF%87%CE%AE_(%CE%A0%CE%B1%CE%BB%CE%B1%CE%BC%CE%AC)" title="Προσευχή (Παλαμά)">Προσευχή</a></i>, <i><a href="/wiki/%CE%A4%CE%BF_%CF%83%CF%87%CE%BF%CE%BB%CE%B5%CE%AF%CE%BF%CE%BD" title="Το σχολείον">Το σχολείον</a></i>, <i><a href="/wiki/%CE%A7%CE%B5%CE%B9%CE%BC%CF%89%CE%BD%CE%B9%CE%AC%CF%84%CE%B9%CE%BA%CE%B7_%CE%BD%CF%85%CF%87%CF%84%CE%B9%CE%AC" title="Χειμωνιάτικη νυχτιά">Χειμωνιάτικη νυχτιά</a></i>. <i><a href="/wiki/%CE%A7%CE%B1%CE%BC%CE%AD%CE%BD%CE%B1_%CF%87%CF%81%CF%8C%CE%BD%CE%B9%CE%B1_(%CE%A0%CE%B1%CE%BB%CE%B1%CE%BC%CE%AC)" title="Χαμένα χρόνια (Παλαμά)">Χαμένα χρόνια</a></i></li>
<li><a href="/wiki/%CE%A3%CF%85%CE%B3%CE%B3%CF%81%CE%B1%CF%86%CE%AD%CE%B1%CF%82:%CE%A3%CF%85%CE%BB%CE%AF_%CE%A0%CF%81%CE%BF%CF%85%CE%BD%CF%84%CF%8C%CE%BC" title="Συγγραφέας:Συλί Προυντόμ">Συλί Προυντόμ</a>: <i><a href="/wiki/%CE%9F_%CE%AC%CF%80%CE%B9%CF%83%CF%84%CE%BF%CF%82" title="Ο άπιστος">Ο άπιστος</a></i> (μετάφραση <a href="/wiki/%CE%A3%CF%85%CE%B3%CE%B3%CF%81%CE%B1%CF%86%CE%AD%CE%B1%CF%82:%CE%9A%CF%89%CF%83%CF%84%CE%AE%CF%82_%CE%A0%CE%B1%CE%BB%CE%B1%CE%BC%CE%AC%CF%82" title="Συγγραφέας:Κωστής Παλαμάς">Κωστή Παλαμά</a>)</li>
<li><a href="/wiki/%CE%A3%CF%85%CE%B3%CE%B3%CF%81%CE%B1%CF%86%CE%AD%CE%B1%CF%82:%CE%9A%CF%89%CE%BD%CF%83%CF%84%CE%B1%CE%BD%CF%84%CE%AF%CE%BD%CE%BF%CF%82_%CE%9A%CE%B1%CE%B2%CE%AC%CF%86%CE%B7%CF%82" title="Συγγραφέας:Κωνσταντίνος Καβάφης">Κωνσταντίνου Καβάφη</a>: <i><a href="/wiki/(%CE%93%CE%B9%CE%B1_%CF%84%CE%B7%CE%BD_%CF%86%CE%B9%CE%BB%CE%BF%CE%BB%CE%BF%CE%B3%CE%B9%CE%BA%CE%AE_%CF%80%CE%B1%CF%81%CE%B1%CE%B3%CF%89%CE%B3%CE%AE_%CF%84%CF%89%CE%BD_A%CE%B9%CE%B3%CF%85%CF%80%CF%84%CE%B9%CF%89%CF%84%CF%8E%CE%BD_E%CE%BB%CE%BB%CE%AE%CE%BD%CF%89%CE%BD)" title="(Για την φιλολογική παραγωγή των Aιγυπτιωτών Eλλήνων)">(Για την φιλολογική παραγωγή των Aιγυπτιωτών Eλλήνων)</a></i>, <i><a href="/wiki/(%CE%93%CE%B9%CE%B1_%CF%84%CE%BF_A%CF%84%CF%83%CE%B1%CE%BB%CE%AD%CE%BD%CE%B9%CE%B5%CF%82_K%CE%BB%CF%89%CF%83%CF%84%CE%AD%CF%82)" title="(Για το Aτσαλένιες Kλωστές)">(Για το Aτσαλένιες Kλωστές)</a></i>, <i><a href="/wiki/(%CE%93%CE%B9%CE%B1_%CF%84%CE%BF_%CE%B6%CE%AE%CF%84%CE%B7%CE%BC%CE%B1_%CF%84%CE%BF%CF%85_%C2%ABPopulisme%C2%BB)" title="(Για το ζήτημα του «Populisme»)">(Για το ζήτημα του «Populisme»)</a></i>, <i><a href="/wiki/(%CE%93%CE%B9%CE%B1_%CF%84%CE%BF_%CE%B8%CE%B5%CE%B1%CF%84%CF%81%CE%B9%CE%BA%CF%8C_%CE%AD%CF%81%CE%B3%CE%BF_%CF%84%CE%BF%CF%85_%CE%93%CF%81%CE%B7%CE%B3%CE%BF%CF%81%CE%AF%CE%BF%CF%85_%CE%9E%CE%B5%CE%BD%CE%BF%CF%80%CE%BF%CF%8D%CE%BB%CE%BF%CF%85)" title="(Για το θεατρικό έργο του Γρηγορίου Ξενοπούλου)">(Για το θεατρικό έργο του Γρηγορίου Ξενοπούλου)</a></i>, <i><a href="/wiki/(%CE%93%CE%B9%CE%B1_%CF%84%CE%BF%CE%BD_A%CE%BB%CE%AD%CE%BE%CE%B1%CE%BD%CE%B4%CF%81%CE%BF_%CE%A0%CE%B1%CF%80%CE%B1%CE%B4%CE%B9%CE%B1%CE%BC%CE%AC%CE%BD%CF%84%CE%B7)" title="(Για τον Aλέξανδρο Παπαδιαμάντη)">(Για τον Aλέξανδρο Παπαδιαμάντη)</a></i>, <i><a href="/wiki/(%CE%93%CE%B9%CE%B1_%CF%84%CE%BF_O_E%CE%BB%CE%BB%CE%B7%CE%BD%CE%B9%CF%83%CE%BC%CF%8C%CF%82_%CE%BA%CE%B1%CE%B9_%CE%B7_N%CE%B5%CF%89%CF%84%CE%AD%CF%81%CE%B1_A%CE%AF%CE%B3%CF%85%CF%80%CF%84%CE%BF%CF%82)" title="(Για το O Eλληνισμός και η Nεωτέρα Aίγυπτος)">(Για το O Eλληνισμός και η Nεωτέρα Aίγυπτος)</a></i>, <i><a href="/wiki/A%CE%B9_%CF%83%CE%BA%CE%AD%CF%88%CE%B5%CE%B9%CF%82_%CE%B5%CE%BD%CF%8C%CF%82_%CE%B3%CE%AD%CF%81%CE%BF%CE%BD%CF%84%CE%BF%CF%82_%CE%BA%CE%B1%CE%BB%CE%BB%CE%B9%CF%84%CE%AD%CF%87%CE%BD%CE%BF%CF%85" class="mw-redirect" title="Aι σκέψεις ενός γέροντος καλλιτέχνου">Aι σκέψεις ενός γέροντος καλλιτέχνου</a></i>, <i><a href="/wiki/M%CE%AF%CE%B1_%CE%BD%CF%85%CE%BE_%CE%B5%CE%B9%CF%82_%CF%84%CE%BF_K%CE%B1%CE%BB%CE%B9%CE%BD%CF%84%CE%AD%CF%81%CE%B9" class="mw-redirect" title="Mία νυξ εις το Kαλιντέρι">Mία νυξ εις το Kαλιντέρι</a></i>, <i><a href="/wiki/T%CE%BF_B%CE%BF%CF%85%CE%BD%CF%8C" class="mw-redirect" title="Tο Bουνό">Tο Bουνό</a></i>, <i><a href="/wiki/%CE%91%CE%BD%CE%B5%CE%BE%CE%B1%CF%81%CF%84%CE%B7%CF%83%CE%AF%CE%B1" title="Ανεξαρτησία">Ανεξαρτησία</a></i></li>
<li><a href="/wiki/%CE%A3%CF%85%CE%B3%CE%B3%CF%81%CE%B1%CF%86%CE%AD%CE%B1%CF%82:%CE%9F%CF%85%CE%AF%CE%BB%CE%BB%CE%B9%CE%B1%CE%BC_%CE%A3%CE%B1%CE%AF%CE%BE%CF%80%CE%B7%CF%81" title="Συγγραφέας:Ουίλλιαμ Σαίξπηρ">Ουίλλιαμ Σαίξπηρ</a>: <i><a href="/wiki/%CE%9C%CE%B5_%CF%84%CE%BF_%CE%AF%CE%B4%CE%B9%CE%BF_%CE%BC%CE%AD%CF%84%CF%81%CE%BF" title="Με το ίδιο μέτρο">Με το ίδιο μέτρο</a></i>, <i><a href="/wiki/%CE%A0%CF%81%CE%BF%CF%82_%CF%84%CE%B1%CF%82_%CE%9A%CF%85%CF%81%CE%AF%CE%B1%CF%82" title="Προς τας Κυρίας">Προς τας Κυρίας</a></i> (μετάφραση <a href="/wiki/%CE%A3%CF%85%CE%B3%CE%B3%CF%81%CE%B1%CF%86%CE%AD%CE%B1%CF%82:%CE%9A%CF%89%CE%BD%CF%83%CF%84%CE%B1%CE%BD%CF%84%CE%AF%CE%BD%CE%BF%CF%82_%CE%9A%CE%B1%CE%B2%CE%AC%CF%86%CE%B7%CF%82" title="Συγγραφέας:Κωνσταντίνος Καβάφης">Κωνσταντίνου Καβάφη</a>)</li></ul>
<p>(<small><a href="/wiki/%CE%A0%CF%81%CF%8C%CF%84%CF%85%CF%80%CE%BF:%CE%9D%CE%AD%CE%B1_%CE%BA%CE%B5%CE%AF%CE%BC%CE%B5%CE%BD%CE%B1" title="Πρότυπο:Νέα κείμενα">επεξ.</a></small>) 
</p>
</div>
<hr />
<div class="mw-heading mw-heading3"><h3 id="Κοινότητα"><span id=".CE.9A.CE.BF.CE.B9.CE.BD.CF.8C.CF.84.CE.B7.CF.84.CE.B1"></span>Κοινότητα</h3></div>
