<script>
	function openClose(dId, mId, hId, linkMore, linkLess)
	{
		var dots = document.getElementById(dId);
		var moreText = document.getElementById(mId);
		var hrefText = document.getElementById(hId);
		
		if (dots.style.display === "none") 
		{ 
			dots.style.display = "inline"; 
			hrefText.innerHTML = linkMore; 
			moreText.style.display = "none"; 
		} else
		{ 
			dots.style.display = "none"; 
			hrefText.innerHTML = linkLess; 
			moreText.style.display = "inline"; 
		}
	}
</script>





  







