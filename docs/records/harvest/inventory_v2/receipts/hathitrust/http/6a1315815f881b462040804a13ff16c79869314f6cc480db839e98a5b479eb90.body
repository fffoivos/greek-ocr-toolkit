387247137:nearestAncestors(first:1):edges:0"]}},"client:PTPage:2387247137:nearestAncestors(first:1):edges:0":{"__id":"client:PTPage:2387247137:nearestAncestors(first:1):edges:0","__typename":"PTPageEdge","node":{"__ref":"PTPage:4007886900"}},"client:Content:2387247137:operations:0":{"__id":"client:Content:2387247137:operations:0","__typename":"OperationCheckResult","operation":"read","targetType":"page"},"client:Content:2387247137:operations:1":{"__id":"client:Content:2387247137:operations:1","__typename":"OperationCheckResult","operation":"set_reaction","targetType":"page"},"client:Content:2387247137:operations:2":{"__id":"client:Content:2387247137:operations:2","__typename":"OperationCheckResult","operation":"view_reaction","targetType":"page"},"client:Content:2387247137:properties(keys:[\"cover-picture-id-published\",\"emoji-title-published\",\"editor\",\"import-source\",\"imported-page-modified-date\"])":{"__id":"client:Content:2387247137:properties(keys:[\"cover-picture-id-published\",\"emoji-title-published\",\"editor\",\"import-source\",\"imported-page-modified-date\"])","__typename":"PaginatedJsonContentPropertyList","nodes":{"__refs":["JsonContentProperty:P2387247137"]}},"client:Content:2387247137:contentProperties:draft":{"__id":"client:Content:2387247137:contentProperties:draft","__typename":"DraftContentProperties","contentMode":null,"generatedBy":null},"client:Content:2387247137:properties(keys:[\"smartFolderProperties\"])":{"__id":"client:Content:2387247137:properties(keys:[\"smartFolderProperties\"])","__typename":"PaginatedJsonContentPropertyList","nodes":{"__refs":[]}},"client:Content:2387247137:draftVersion":{"__id":"client:Content:2387247137:draftVersion","__typename":"Version","contentTypeModified":false,"number":1,"friendlyWhen":"2026-01-22","by":{"__ref":"client:Content:2387247137:draftVersion:by"},"when":"2026-01-22T20:17:12.985Z"},"client:Content:2387247137:draftVersion:by":{"__id":"client:Content:2387247137:draftVersion:by","__typename":"KnownUser","displayName":"Val Waldron"},"client:Content:2387247137:body:dynamic":{"__id":"client:Content:2387247137:body:dynamic","__typename":"ContentBody","representation":"atlas_doc_format","value":"{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"4d69c0e3-e71c-4d43-8937-701731b092fb\"},\"content\":[{\"text\":\"What you can download from the collection depends on whether you are logged in, and whether you are affiliated with a member library or are logged in as a guest.\",\"type\":\"text\"}]},{\"type\":\"extension\",\"attrs\":{\"layout\":\"default\",\"extensionType\":\"com.atlassian.confluence.macro.core\",\"extensionKey\":\"toc\",\"parameters\":{\"macroParams\":{},\"macroMetadata\":{\"macroId\":{\"value\":\"e638403c-f3c5-491d-9fbc-a24722e1b1bb\"},\"schemaVersion\":{\"value\":\"1\"},\"title\":\"Table of Contents\"}},\"localId\":\"42e3b119-870c-4228-bd08-151d89995ed4\"}},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"localId\":\"0ed91ddb-3878-4bef-be59-74b3b0ebaea1\"},\"content\":[{\"type\":\"emoji\",\"attrs\":{\"id\":\"1f4d8\",\"text\":\"\\\\uD83D\\\\uDCD8\",\"shortName\":\":blue_book:\",\"localId\":\"cc58fd66-172b-4f4c-9fbb-0d9f5a184533\"}},{\"text\":\" Accessing the collection without logging in\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"913692db-4acc-48f3-9b24-f0f5ef5c934a\"},\"content\":[{\"text\":\"As someone who is accessing the collection without logging in, here are the things you can do in the HathiTrust collection:\",\"type\":\"text\"}]},{\"type\":\"bulletList\",\"attrs\":{\"localId\":\"36777744-30c9-4f25-b52a-dc003b7eecb5\"},\"content\":[{\"type\":\"listItem\",\"attrs\":{\"localId\":\"2bd0c485-a3f0-461d-a424-414100998ef5\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"e765f1de-8701-41af-a04e-692dde4fcd47\"},\"content\":[{\"text\":\"Read and view books that are marked as \\\"full-view.\\\"\",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"64f2f1a5-7cfb-488a-8838-e700caea9ab1\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"5da044f2-a49c-40f0-b15a-16186145d387\"},\"content\":[{\"text\":\"Download public domain books in their entirety that do not have download restrictions (e.g., books digitized by Internet Archive and certain other organizations, or books opened with a Creative Commons license).\",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"704c98e7-c896-47ef-a526-b51ffc099228\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"231cebf2-365d-40e3-adca-a2835982f30b\"},\"content\":[{\"text\":\"Download books one page a time if they do have download restrictions (e.g. a book that was digitized by Google). \",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"f0adc149-cebf-463c-b8ab-15a67ec6a121\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"8a37dac9-2050-4dd9-bc5e-241d5f363ad2\"},\"content\":[{\"text\":\"Books that are marked as \\\"limited (search-only)\\\" are restricted due to copyright. We are unable to provide access to these books (even for members). However, you can search for books of interest, search within them to find page numbers for specific keywords, and then try to find a library that holds a print copy of the book. \",\"type\":\"text\"}]}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"localId\":\"7b8d0205-5ade-42cd-8021-3f0e2ef50b92\"},\"content\":[{\"type\":\"emoji\",\"attrs\":{\"id\":\"1f4d8\",\"text\":\"\\\\uD83D\\\\uDCD8\",\"shortName\":\":blue_book:\",\"localId\":\"d02f4602-629b-4502-8490-fc6729740e2f\"}},{\"text\":\" Logging in as a guest\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"7d4c49c0-c092-4e2e-b75f-8d920f0175f9\"},\"content\":[{\"text\":\"As someone who is logged in as a guest, here are the things you can do in the HathiTrust collection:\",\"type\":\"text\"}]},{\"type\":\"bulletList\",\"attrs\":{\"localId\":\"09e763c2-c202-422c-8eb8-740ef26a7891\"},\"content\":[{\"type\":\"listItem\",\"attrs\":{\"localId\":\"931bff42-a303-4e9a-a807-ae2db86ae041\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"687e5ccd-50e6-4ad4-8d34-59174b9fa1d1\"},\"content\":[{\"text\":\"Read and view books that are marked as \\\"full-view.\\\"\",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"e67c0555-3b21-4ff5-9d68-e180adecd859\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"c7bc4e2f-8e4a-403f-987c-165617be3850\"},\"content\":[{\"text\":\"Download public domain books in their entirety that do not have download restrictions (e.g., books digitized by Internet Archive and certain other organizations, or books opened with a Creative Commons license).\",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"81b46e65-c683-4740-9d28-81efca8762f0\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"2615bb7d-ce86-44c2-9424-9b5cb13be9b8\"},\"content\":[{\"text\":\"Download books one page a time if they do have download restrictions (e.g. a book that was digitized by Google). \",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"bc53dd25-a4c3-4cb2-8ba8-07a2f251ba59\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"51764c02-6b59-4285-bc74-a54cdd49b983\"},\"content\":[{\"text\":\"Books that are marked as \\\"limited (search-only)\\\" are restricted due to copyright. We are unable to provide access to these books (even for members). However, you can search for books of interest, search within them to find page numbers for specific keywords, and then try to find a library that holds a print copy of the book. \",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"e9127859-7180-4dd0-96af-fcfa24e7698e\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"1ba67a49-8a8d-4744-8ea1-0c3dc23f468e\"},\"content\":[{\"text\":\"Build collections and save books of interest to those collections.\",\"type\":\"text\"}]}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"localId\":\"be1efacf-a9b3-4054-8234-70ba82d44196\"},\"content\":[{\"type\":\"emoji\",\"attrs\":{\"id\":\"1f4d8\",\"text\":\"\\\\uD83D\\\\uDCD8\",\"shortName\":\":blue_book:\",\"localId\":\"d38143b0-db6a-4325-a01e-fa8405b77d85\"}},{\"text\":\" Logging in as a member\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"f2011456-bd70-4b99-b9ff-c98497109b88\"},\"content\":[{\"text\":\"If you are logged in and are affiliated with a \",\"type\":\"text\"},{\"text\":\"member library\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https:\u002F\u002Fwww.hathitrust.org\u002Fmember-libraries\u002Fmember-list\u002F\"}}]},{\"text\":\", here are the things you can do in the HathiTrust collection:\",\"type\":\"text\"}]},{\"type\":\"bulletList\",\"attrs\":{\"localId\":\"4dce75d7-dea8-45e4-ae32-bec9ea6afacb\"},\"content\":[{\"type\":\"listItem\",\"attrs\":{\"localId\":\"6036df8d-15f1-47fe-9795-72c3ecf17024\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"512bf05e-448b-4ccf-96d9-c933a358c505\"},\"content\":[{\"text\":\"You are able to download all public domain books in their entirety (including materials with download restrictions that are defined by the vendor) as well as works made available under Creative Commons licenses. Download format options include PDF, EPUB, Text (.txt), Text (.zip), or Image (jpg).\",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"6c95fe8d-444e-46ad-843c-fa8741c8941b\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"db646855-efe9-4122-a6e8-3549bbaa4251\"},\"content\":[{\"text\":\"Books that are marked as \\\"limited (search-only)\\\" are restricted due to copyright. We are unable to provide access to these books (even for members). However, you can search for books of interest, search within them to find page numbers for specific keywords, and then try to find a library that holds a print copy of the book. \",\"type\":\"text\"}]}]},{\"type\":\"listItem\",\"attrs\":{\"localId\":\"59f82d0e-1e8f-466d-acdb-174cb542da12\"},\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"485bf196-967a-4140-97cb-326a57de2ca7\"},\"content\":[{\"text\":\"Build your own collections and save books of interest to those collections.\",\"type\":\"text\"}]}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"localId\":\"74cb916e-33cf-4719-8da7-8833d03ef828\"},\"content\":[{\"type\":\"emoji\",\"attrs\":{\"id\":\"1f4d8\",\"text\":\"\\\\uD83D\\\\uDCD8\",\"shortName\":\":blue_book:\",\"localId\":\"8534b397-43d9-42ae-8eed-b72349cb0d49\"}},{\"text\":\" What determines whether a book is available to download in full\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"3b0f1893-fa46-4cd8-bd43-424fa8c5bd96\"},\"content\":[{\"text\":\"The uses of materials in HathiTrust may be defined by third-party agreements. For instance, libraries' agreements with Google require us to take steps to prevent bulk download of materials they have digitized. We offer full-PDF download of Google-digitized materials to people associated with member libraries because we are able to work with member libraries to ensure that use is within acceptable parameters. Public domain works deposited in HathiTrust without restrictions (such as works scanned by Internet Archive or other organizations) and works made available by rights holders through Creative Commons licenses are available for full download to anyone.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"35bb44c5-76f7-4d7a-b172-018bca4e7dd6\"},\"content\":[{\"text\":\"If you are unable to download a full-view book from HathiTrust, you can select the “Find in Google Books” link to check their website for a download. Google Books has their own copyright policies, so we cannot guarantee that the book will be available for download on their website. You may be able to use Google’s snippet view to search within a book and read some text. You can also contact Google Books support staff to request that they review the copyright status of a restricted book by using \",\"type\":\"text\"},{\"text\":\"Google’s request form\",\"type\":\"text\",\"marks\":[{\"type\":\"underline\"},{\"type\":\"link\",\"attrs\":{\"href\":\"https:\u002F\u002Fsupport.google.com\u002Fbooks\u002Ftroubleshooter\u002F6113172#ts=6113305\"}}]},{\"text\":\".\",\"type\":\"text\",\"marks\":[{\"type\":\"underline\"}]}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"3dcf7828-8942-47f8-b996-576ff6f4767a\"},\"content\":[{\"text\":\"Otherwise, if your local library doesn’t have a copy of a book that interests you, we recommend that you reach out to the interlibrary loan department of your local library to see if they can borrow a copy for you from another institution.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"localId\":\"190e3d2a-af04-4ab6-8998-29726cca564b\"},\"content\":[{\"type\":\"emoji\",\"attrs\":{\"id\":\"1f4d8\",\"text\":\"\\\\uD83D\\\\uDCD8\",\"shortName\":\":blue_book:\",\"localId\":\"419fe668-5a9c-4485-84d1-2b668a9c62cc\"}},{\"text\":\" Other resources related to downloading materials from the collection\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"ffcabb4a-f6aa-4090-99f9-26e6f8a83c31\"},\"content\":[{\"text\":\"Tips for Downloading Materials\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https:\u002F\u002Fhathitrust.atlassian.net\u002Fservicedesk\u002Fcustomer\u002Fkb\u002Fview\u002F2387345411\"}}]}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"d0b0c126-2dc7-4c43-962c-a4a4ac701ab7\"},\"content\":[{\"text\":\"Formats for Downloading Materials\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https:\u002F\u002Fhathitrust.atlassian.net\u002Fservicedesk\u002Fcustomer\u002Fkb\u002Fview\u002F2387247130\"}}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2,\"localId\":\"b5a2f538-dcff-4f91-8a22-6a274df42609\"},\"content\":[{\"type\":\"emoji\",\"attrs\":{\"id\":\"1f4cb\",\"text\":\"\\\\uD83D\\\\uDCCB\",\"shortName\":\":clipboard:\",\"localId\":\"b9a9cc3f-a2b6-40be-a821-77f9298742dc\"}},{\"text\":\" Related articles\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"localId\":\"c1e9fdb4-0dc3-440d-b985-08951aec4dce\"},\"content\":[{\"type\":\"placeholder\",\"attrs\":{\"text\":\"The content by label feature automatically displays related articles based on labels you choose. To edit options for this feature, select the placeholder and tap the pencil icon.\",\"localId\":\"3550ef31-a0c8-4c65-9ffd-492c3332edbb\"}}]},{\"type\":\"extension\",\"attrs\":{\"layout\":\"default\",\"extensionType\":\"com.atlassian.confluence.macro.core\",\"extensionKey\":\"contentbylabel\",\"parameters\":{\"macroParams\":{\"showLabels\":{\"value\":\"false\"},\"max\":{\"value\":\"5\"},\"spaces\":{\"value\":\"com.atlassian.confluence.content.render.xhtml.model.resource.identifiers.SpaceResourceIdentifier@8ec\"},\"showSpace\":{\"value\":\"false\"},\"sort\":{\"value\":\"modified\"},\"type\":{\"value\":\"page\"},\"reverse\":{\"value\":\"true\"},\"labels\":{\"value\":\"kb-how-to-article\"},\"cql\":{\"value\":\"label = \\\"kb-how-to-article\\\" and type = \\\"page\\\" and space = \\\"GS\\\"\"}},\"macroMetadata\":{\"macroId\":{\"value\":\"0ad9a672-7886-45ee-8db8-40b8d7fad66e\"},\"schemaVersion\":{\"value\":\"4\"},\"title\":\"Filter by label\"}},\"localId\":\"aab517b0-5643-4d88-bba8-bcf5127b150c\"}}],\"version\":1}","content":{"__ref":"Content:2387247137"},"webresource":{"__ref":"client:Content:2387247137:body:dynamic:webresource"}},"client:Content:2387247137:body:dynamic:webresource":{"__id":"client:Content:2387247137:body:dynamic:webresource","__typename":"WebResourceDependencies","superbatch":{"__ref":"client:Content:2387247137:body:dynamic:webresource:superbatch"},"tags":{"__ref":"client:Content:2387247137:body:dynamic:webresource:tags"}},"client:Content:2387247137:body:dynamic:webresource:superbatch":{"__id":"client:Content:2387247137:body:d