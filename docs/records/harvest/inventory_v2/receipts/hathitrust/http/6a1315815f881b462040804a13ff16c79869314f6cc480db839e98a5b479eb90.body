:2386690087:createdDate(format:\"MILLIS\")"},"hasChildren":false,"blank":false,"type":"page","subType":null,"links":{"__ref":"client:PTPage:2386690087:links"},"properties(keys:[\"emoji-title-published\",\"emoji-title-draft\",\"editor\",\"jira-planner-connection\"])":{"__ref":"client:PTPage:2386690087:properties(keys:[\"emoji-title-published\",\"emoji-title-draft\",\"editor\",\"jira-planner-connection\"])"}},"client:PTPage:2386690087:createdDate(format:\"MILLIS\")":{"__id":"client:PTPage:2386690087:createdDate(format:\"MILLIS\")","__typename":"ConfluenceDate","value":1667403114934},"client:PTPage:2386690087:links":{"__id":"client:PTPage:2386690087:links","__typename":"Map_LinkType_String","webui":"\u002Fspaces\u002FGS\u002Fpages\u002F2386690087\u002FCan+I+Offer+Materials+to+Include+in+the+Collection"},"client:PTPage:2386690087:properties(keys:[\"emoji-title-published\",\"emoji-title-draft\",\"editor\",\"jira-planner-connection\"])":{"__id":"client:PTPage:2386690087:properties(keys:[\"emoji-title-published\",\"emoji-title-draft\",\"editor\",\"jira-planner-connection\"])","__typename":"PaginatedJsonContentPropertyList","nodes":{"__refs":["JsonContentProperty:P2386690087"]}},"JsonContentProperty:P2386690087":{"__id":"JsonContentProperty:P2386690087","__typename":"JsonContentProperty","id":"P2386690087","key":"editor","value":"\"v2\"","version":null},"PTPage:2387214337":{"__id":"PTPage:2387214337","__typename":"PTPage","id":"2387214337","title":"Emergency Temporary Access Service (ETAS): Using Temporary Access Books","status":"CURRENT","createdDate(format:\"MILLIS\")":{"__ref":"client:PTPage:2387214337:createdDate(format:\"MILLIS\")"},"hasChildren":false,"blank":false,"type":"page","subType":null,"links":{"__ref":"client:PTPage:2387214337:links"},"properties(keys:[\"emoji-title-published\",\"emoji-title-draft\",\"editor\",\"jira-planner-connection\"])":{"__ref":"client:PTPage:2387214337:properties(keys:[\"emoji-title-published\",\"emoji-title-draft\",\"editor\",\"jira-pl