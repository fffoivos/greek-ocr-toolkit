{"created":1792152668,"d1":"ia903106.us.archive.org","d2":"ia803106.us.archive.org","dir":"/16/items/1935eyboikhnomiemat","files":[{"name":"1935eyboikhnomiemat-access_images.zip","source":"original","mtime":"1773947345","size":"22","md5":"76cdb2bad9582d23c1f6f4d868218d6c","crc32":"d7cbc50e","sha1":"b04f3ee8f5e43fa3b162981b50bb72fe1acabb33","format":"Generic Raw Book Zip","filecount":"0","private":"true"},{"name":"1935eyboikhnomiemat_files.xml","source":"original","format":"Metadata","md5":"88f13a4a6675ad8ff6d739072422dd07","summation":"md5"},{"name":"1935eyboikhnomiemat_meta.sqlite","source":"original","mtime":"1773947379","size":"20480","md5":"0c1a2d6127ac145432d596710aa149e4","crc32":"e95a642f","sha1":"14b03df81e036767bd6c5d6d4a9fbe08a353528e","format":"Metadata"},{"name":"1935eyboikhnomiemat_meta.xml","source":"original","mtime":"1777987697","size":"2317","md5":"41f1a0a1f9d8aef51a588dcf9499c1dc","crc32":"4e770f55","sha1":"562b808d2c9bc25ed567554c22109a0c35788725","format":"Metadata"}],"files_count":4,"has_redrow":true,"item_last_updated":1777987698,"item_size":22819,"metadata":{"identifier":"1935eyboikhnomiemat","collection":["snslibraryrestricted","newmannumismaticrestricted","wustl","americana","s-and-s-library-restricted"],"contributor":"Washington University; Eric P Newman Library","coverage":"Greece","creator":"N. A. Petsalis","date":"1/1/35","digitizing_sponsor":"Eric P. Newman Education Society","language":"gre","mediatype":"texts","rights":"This Item is protected by copyright and/or related rights. You are free to use this Item in any way that is permitted by the copyright and related rights legislation that applies to your use. For other uses you need to obtain permission from the rightsholder(s).","scanner":"Internet Archive Python library 5.2.0","subject":["Numismatics","Numismatic ","Book"],"title":"\u0395\u03c5\u03b2\u03bf\u03ca\u03ba\u03b7 \u039d\u03bf\u03bc\u03b9\u03c3\u03bc\u03b1\u03c4\u03bf\u03bb\u03bf\u03b3\u03b9\u03b1","uploader":"digital@wumail.wustl.edu","collection_added":["newmannumismaticrestricted","wustl","americana"],"publicdate":"2026-03-19 19:09:22","addeddate":"2026-03-19 19:09:22","access-restricted-item":"true","identifier-access":"http://archive.org/details/1935eyboikhnomiemat","identifier-ark":"ark:/13960/s221q7x4892","publisher_location":"Athens, Greece","volume":"1935","format":"24cm","description":"<span style=\"font-family:Arial;font-size:13.3333px;background-color:rgb(255,255,255);\">8vo, bound in later tan full morocco by Dionysis Valassis, with hand-etched title bordering central decorations in gilt; binder\u2019s mark in gilt on the rear cover. 15, (1) pages; 8 halftone plates, all but the last devoted to coins. Presentation inscription on title. Binding rubbed at spine; near fine. A rare offprint from the Archives of Euboean Studies, in a charming later binding executed by Dionysis Valassis, one of BCD\u2019s primary binders.</span>"},"pending_tasks":true,"server":"ia903106.us.archive.org","servers_unavailable":true,"tasks":[{"task_id":5258267323,"cmd":"derive.php","priority":-6,"wait_admin":2,"color":"red","status":"error"}],"uniq":1217685000,"workable_servers":["ia903106.us.archive.org"]}