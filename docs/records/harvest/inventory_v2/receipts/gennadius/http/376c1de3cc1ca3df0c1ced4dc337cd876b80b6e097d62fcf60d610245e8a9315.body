<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gennadius Library - ASCSA Digital Collections</title>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Main CSS file -->
    <link rel="stylesheet" href="assets/css/gallery-styles.css">
    <!-- Additional CSS for the grid layout -->
    <style>
        .collection-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
            margin-top: 40px;
        }
        
        .collection-item {
            background: var(--card-bg);
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            overflow: hidden;
            transition: var(--transition);
            position: relative;
            height: 100%;
        }
        
        .collection-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }
        
        .collection-image {
            height: 250px;
            overflow: hidden;
            background: #f9f9f9;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .collection-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }
        
        .collection-info {
            padding: 20px;
        }
        
        .collection-title {
            font-weight: 600;
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: var(--secondary-color);
        }
        
        .collection-meta {
            font-size: 0.9rem;
            color: var(--text-light);
        }
    </style>
</head>
<body>
    <!-- ASCSA Digital Collection Header -->
    <div class="header-brand">
        <div class="brand-container">
            <img src="assets/img/logo-desktop-hd.jpg" alt="ASCSA Logo" class="brand-logo">
        </div>
    </div>
    
    <div class="container">
        <header>
            <h1>Gennadius Library</h1>
            <p class="subtitle">Explore the digital collections from the Gennadius Library at the American School of Classical Studies at Athens</p>
        </header>
        
        <div class="collection-grid">
            <!-- Scrapbooks of Joannes Gennadius -->
            <div class="collection-item">
                <a href="https://collections.ascsa.edu.gr/browse/gennadius">
                    <div class="collection-image">
                        <img src="assets/img/album-list/grid/img-1b.jpg" alt="Browse the Scrapbooks of Joannes Gennadius">
                    </div>
                    <div class="collection-info">
                        <h2 class="collection-title">Browse the Scrapbooks of Joannes Gennadius</h2>
                        <div class="collection-meta"></div>
                    </div>
                </a>
            </div>
            
            <!-- Scrapbook Items of Joannes Gennadius -->
            <div class="collection-item">
                <a href="https://collections.ascsa.edu.gr/search/gennadius">
                    <div class="collection-image">
                        <img src="assets/img/album-list/grid/img-2b.jpg" alt="Search the Scrapbooks of Joannes Gennadius">
                    </div>
                    <div class="collection-info">
                        <h2 class="collection-title">Search the Scrapbooks of Joannes Gennadius</h2>
                        <div class="collection-meta"></div>
                    </div>
                </a>
            </div>
            
            <!-- The Gennadius Map Collection -->
            <div class="collection-item">
                <a href="gennadius/maps/maps-index.php">
                    <div class="collection-image">
                        <img src="assets/img/album-list/grid/img-3b.jpg" alt="The Gennadius Map Collection">
                    </div>
                    <div class="collection-info">
                        <h2 class="collection-title">The Gennadius Map Collection</h2>
                        <div class="collection-meta">3,350 items</div>
                    </div>
                </a>
            </div>
            
            <!-- Έντυπες Ακολουθίες Αγίων -->
            <div class="collection-item">
                <a href="gennadius/akolouthies/akolouthies.php">
                    <div class="collection-image">
                        <img src="assets/img/album-list/grid/img-4b.jpg" alt="Έντυπες Ακολουθίες Αγίων">
                    </div>
                    <div class="collection-info">
                        <h2 class="collection-title">Έντυπες Ακολουθίες Αγίων</h2>
                        <div class="collection-meta">Digital volumes</div>
                    </div>
                </a>
            </div>
            
            <!-- Edward Lear Collection -->
            <div class="collection-item">
                <a href="gennadius/lear/gallery.php">
                    <div class="collection-image">
                        <img src="assets/img/album-list/grid/img-22.jpg" alt="Edward Lear Collection">
                    </div>
                    <div class="collection-info">
                        <h2 class="collection-title">Edward Lear Collection</h2>
                        <div class="collection-meta">Paintings</div>
                    </div>
                </a>
            </div>
        </div>
        
        <!-- Citation line -->
        <div class="citation">
            <center>American School of Classical Studies at Athens, Gennadius Library | <a target="_blank" href="https://www.ascsa.edu.gr/publications/rights-permissions/image-permissions">Image permission</a></center>
        </div>
    </div>
    
    <div class="footer">
        &copy; ASCSA IT Department 2024-25 - Digital Collections - Gennadius Library - All rights reserved
    </div>
    
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Update current year
        const year = new Date().getFullYear();
        document.querySelector('.current-year').textContent = year;
    });
    </script>
</body>
</html>