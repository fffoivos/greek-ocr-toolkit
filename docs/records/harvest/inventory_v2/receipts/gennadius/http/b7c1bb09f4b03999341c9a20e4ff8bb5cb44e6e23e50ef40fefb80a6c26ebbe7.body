<div class="block-item py-3">
	<div class="row">
		
		<div class="col-sm-5 column image">
			<figure><img src="/uploads/news-events-images/_thumb/Ιωάννης_Κράλλης,_μάλλον_Σμύρνη,_26_χρονών_περίπου.png" alt="" class="img-fluid"></figure>
		</div>
		
		<div class="col-sm-7 column text">
			<header>
