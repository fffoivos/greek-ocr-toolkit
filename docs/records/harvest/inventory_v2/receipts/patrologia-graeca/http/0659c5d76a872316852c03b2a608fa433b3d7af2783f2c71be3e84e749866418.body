ess", "access_grants": "https://zenodo.org/api/records/20008699/access/grants", "access_links": "https://zenodo.org/api/records/20008699/access/links", "access_request": "https://zenodo.org/api/records/20008699/access/request", "access_users": "https://zenodo.org/api/records/20008699/access/users", "communities": "https://zenodo.org/api/records/20008699/communities", "communities-suggestions": "https://zenodo.org/api/records/20008699/communities-suggestions", "doi": "https://doi.org/10.5281/zenodo.20008699", "draft": "https://zenodo.org/api/records/20008699/draft", "file_modification": "https://zenodo.org/api/records/20008699/file-modification", "files": "https://zenodo.org/api/records/20008699/files", "latest": "https://zenodo.org/api/records/20008699/versions/latest", "latest_html": "https://zenodo.org/records/20008699/latest", "media_files": "https://zenodo.org/api/records/20008699/media-files", "parent": "https://zenodo.org/api/records/7296538", "parent_doi": "https://doi.org/10.5281/zenodo.7296538", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.7296538", "parent_html": "https://zenodo.org/records/7296538", "preview_html": "https://zenodo.org/records/20008699?preview=1", "quota_increase": "https://zenodo.org/api/records/20008699/quota-increase", "request_deletion": "https://zenodo.org/api/records/20008699/request-deletion", "requests": "https://zenodo.org/api/records/20008699/requests", "reserve_doi": "https://zenodo.org/api/records/20008699/draft/pids/doi", "self": "https://zenodo.org/api/records/20008699", "self_doi": "https://doi.org/10.5281/zenodo.20008699", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.20008699", "self_html": "https://zenodo.org/records/20008699", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:20008699/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:20008699/sequence/default", "versions": "https://zenodo.org/api/records/20008699/versions"}, "media_files": {"count": 0, "enabled": false, "entries": {}, "order": [], "total_bytes": 0}, "metadata": {"contributors": [{"affiliations": [{"name": "Universit\u00e9 de Louvain"}], "person_or_org": {"family_name": "Auwers", "given_name": "Jean-Marie", "name": "Auwers, Jean-Marie", "type": "personal"}, "role": {"id": "projectleader", "title": {"de": "ProjektleiterIn", "en": "Project leader"}}}, {"affiliations": [{"name": "Calfa / Ecole nationale des Chartes-PSL"}], "person_or_org": {"family_name": "Vidal-Gor\u00e8ne", "given_name": "Chahan", "identifiers": [{"identifier": "0000-0003-1567-6508", "scheme": "orcid"}], "name": "Vidal-Gor\u00e8ne, Chahan", "type": "personal"}, "role": {"id": "projectmember", "title": {"de": "Projektmitglied", "en": "Project member"}}}, {"affiliations": [{"name": "GREgORI / Universit\u00e9 de Louvain"}], "person_or_org": {"family_name": "Kindt", "given_name": "Bastien", "name": "Kindt, Bastien", "type": "personal"}, "role": {"id": "projectmember", "title": {"de": "Projektmitglied", "en": "Project member"}}}, {"affiliations": [{"name": "Universit\u00e9 de Louvain"}], "person_or_org": {"family_name": "Somers", "given_name": "V\u00e9ronique", "name": "Somers, V\u00e9ronique", "type": "personal"}, "role": {"id": "projectmember", "title": {"de": "Projektmitglied", "en": "Project member"}}}], "creators": [{"affiliations": [{"name": "Calfa / Ecole nationale des Chartes-PSL"}], "person_or_org": {"family_name": "Vidal-Gor\u00e8ne", "given_name": "Chahan", "identifiers": [{"identifier": "0000-0003-1567-6508", "scheme": "orcid"}], "name": "Vidal-Gor\u00e8ne, Chahan", "type": "personal"}}, {"affiliations": [{"name": "GREgORI / Universit\u00e9 de Louvain"}], "person_or_org": {"family_name": "Kindt", "given_name": "Bastien", "name": "Kindt, Bastien", "type": "personal"}}], "description": "\u003cp\u003eGround truth manually produced within the scope of the CGPG project (Calfa GREgORI Patrologia Graeca), led by Jean-Marie Auwers (UCLouvain), that aim to OCRize the remaining non-digital versions of the Patrologia Graeca volumes.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eV1 dataset\u003c/strong\u003e compiles annotations from 2021 to 2022, and has been used for the Programming Historian online lesson \u003ca href=\"https://programminghistorian.org/fr/lecons/transcription-automatisee-graphies-non-latines\"\u003e\"Transcription automatis\u0026eacute;e de graphies non latines\"\u003c/a\u003e. The dataset contains a set of 100 images from the Patrologia Graeca, with their corresponding pageXML files. Annotation has been performed with the \u003ca href=\"https://vision.calfa.fr\"\u003eCalfa Vision platform\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eDifferent level of annotations are proposed to overcome two tasks: (task1) detection of text regions in Greek (annotations at the region level only) and (task 2) recognition of ancient polytonic Greek (annotations at the line level).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTask 1:\u003c/strong\u003e\u003cbr\u003ecol_greek: 52\u003cbr\u003ecol_lat: 54\u003cbr\u003efootnotes: 27\u003cbr\u003etitles: 9\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTask 2:\u003c/strong\u003e\u003cbr\u003elines: 2.579\u003c/p\u003e\n\u003cp\u003eFinal model of layout analysis is freely usable on the \u003ca href=\"https://vision.calfa.fr\"\u003eCalfa Vision platform\u003c/a\u003e, by choosing the \"Greek printed (Patrologia Graeca)\" type of project.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eV2 dataset\u003c/strong\u003e contains the full training set used for processing the PG. It contains 304 image + pageXML pairs, annotated with the Calfa Vision platform.\u003c/p\u003e\n\u003cp\u003eThe project is sponsored by the ASBL \u003cem\u003eByzantion\u003c/em\u003e, the Fondation \u003cem\u003eSedes Sapientiae\u003c/em\u003e, the Institut \u003cem\u003eReligions, Spiritualit\u0026eacute;s, Cultures, Soci\u0026eacute;t\u0026eacute;s\u003c/em\u003e (RSCS, UCLouvain) and the \u003cem\u003eCentre d\u0027\u0026eacute;tudes orientales\u003c/em\u003e (CIOL, UCLouvain) and by a generous donor who wishes to remain anonymous. Other sponsors have recently expressed their willingness to support the project.\u003c/p\u003e", "publication_date": "2026-04", "publisher": "Zenodo", "related_identifiers": [{"identifier": "arXiv:2603.09470", "relation_type": {"id": "isdescribedby", "title": {"de": "Wird beschrieben von", "en": "Is described by"}}, "resource_type": {"id": "publication", "title": {"de": "Publikation", "en": "Publication"}}, "scheme": "arxiv"}, {"identifier": "https://programminghistorian.org/fr/lecons/transcription-automatisee-graphies-non-latines", "relation_type": {"id": "issupplementto", "title": {"de": "Erg\u00e4nzt", "en": "Is supplement to"}}, "resource_type": {"id": "lesson", "title": {"de": "Unterrichtseinheit", "en": "Lesson"}}, "scheme": "url"}, {"identifier": "https://github.com/calfa-co/Patrologia-Graeca", "relation_type": {"id": "issupplementto", "title": {"de": "Erg\u00e4nzt", "en": "Is supplement to"}}, "resource_type": {"id": "dataset", "title": {"de": "Datensatz", "en": "Dataset"}}, "scheme": "url"}], "resource_type": {"id": "dataset", "title": {"de": "Datensatz", "en": "Dataset"}}, "rights": [{"description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title": {"en": "Creative Commons Attribution 4.0 International"}}], "subjects": [{"subject": "dataset"}, {"subject": "ocr"}, {"subject": "Patrologia Graeca"}, {"subject": "layout analysis"}], "title": "Patrologia Graeca (OCR ground truth)"}, "parent": {"access": {"owned_by": {"user": "377150"}, "settings": {"accept_conditions_text": null, "allow_guest_requests": false, "allow_user_requests": false, "secret_link_expiration": 0}}, "communities": {}, "id": "7296538", "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.7296538", "provider": "datacite"}}}, "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.20008699", "provider": "datacite"}, "oai": {"identifier": "oai:zenodo.org:20008699", "provider": "oai"}}, "revision_id": 4, "stats": {"all_versions": {"data_volume": 30930252688.0, "downloads": 160, "unique_downloads": 156, "unique_views": 3392, "views": 3541}, "this_version": {"data_volume": 19656115977.0, "downloads": 66, "unique_downloads": 62, "unique_views": 193, "views": 206}}, "status": "published", "swh": {}, "ui": {"access_status": {"description_l10n": "The record and files are publicly accessible.", "embargo_date_l10n": null, "icon": "unlock", "id": "open", "message_class": "", "title_l10n": "Open"}, "contributors": {"affiliations": [[1, "Universit\u00e9 de Louvain", null], [2, "Calfa / Ecole nationale des Chartes-PSL", null], [3, "GREgORI / Universit\u00e9 de Louvain", null]], "contributors": [{"affiliations": [[1, "Universit\u00e9 de Louvain"]], "person_or_org": {"family_name": "Auwers", "given_name": "Jean-Marie", "name": "Auwers, Jean-Marie", "type": "personal"}, "role": {"id": "projectleader", "title": "Project leader"}}, {"affiliations": [[2, "Calfa / Ecole nationale des Chartes-PSL"]], "person_or_org": {"family_name": "Vidal-Gor\u00e8ne", "given_name": "Chahan", "identifiers": [{"identifier": "0000-0003-1567-6508", "scheme": "orcid"}], "name": "Vidal-Gor\u00e8ne, Chahan", "type": "personal"}, "role": {"id": "projectmember", "title": "Project member"}}, {"affiliations": [[3, "GREgORI / Universit\u00e9 de Louvain"]], "person_or_org": {"family_name": "Kindt", "given_name": "Bastien", "name": "Kindt, Bastien", "type": "personal"}, "role": {"id": "projectmember", "title": "Project member"}}, {"affiliations": [[1, "Universit\u00e9 de Louvain"]], "person_or_org": {"family_name": "Somers", "given_name": "V\u00e9ronique", "name": "Somers, V\u00e9ronique", "type": "personal"}, "role": {"id": "projectmember", "title": "Project member"}}]}, "created_date_l10n_long": "May 3, 2026", "creators": {"affiliations": [[1, "Calfa / Ecole nationale des Chartes-PSL", null], [2, "GREgORI / Universit\u00e9 de Louvain", null]], "creators": [{"affiliations": [[1, "Calfa / Ecole nationale des Chartes-PSL"]], "person_or_org": {"family_name": "Vidal-Gor\u00e8ne", "given_name": "Chahan", "identifiers": [{"identifier": "0000-0003-1567-6508", "scheme": "orcid"}], "name": "Vidal-Gor\u00e8ne, Chahan", "type": "personal"}}, {"affiliations": [[2, "GREgORI / Universit\u00e9 de Louvain"]], "person_or_org": {"family_name": "Kindt", "given_name": "Bastien", "name": "Kindt, Bastien", "type": "personal"}}]}, "custom_fields": {"legacy:communities": ["tops"]}, "description_stripped": "Ground truth manually produced within the scope of the CGPG project (Calfa GREgORI Patrologia Graeca), led by Jean-Marie Auwers (UCLouvain), that aim to OCRize the remaining non-digital versions of the Patrologia Graeca volumes.\n\nV1 dataset compiles annotations from 2021 to 2022, and has been used for the Programming Historian online lesson \"Transcription automatis\u00e9e de graphies non latines\". The dataset contains a set of 100 images from the Patrologia Graeca, with their corresponding pageXML files. Annotation has been performed with the Calfa Vision platform.\n\nDifferent level of annotations are proposed to overcome two tasks: (task1) detection of text regions in Greek (annotations at the region level only) and (task 2) recognition of ancient polytonic Greek (annotations at the line level).\n\nTask 1:col_greek: 52col_lat: 54footnotes: 27titles: 9\n\nTask 2:lines: 2.579\n\nFinal model of layout analysis is freely usable on the Calfa Vision platform, by choosing the \"Greek printed (Patrologia Graeca)\" type of project.\n\nV2 dataset contains the full training set used for processing the PG. It contains 304 image + pageXML pairs, annotated with the Calfa Vision platform.\n\nThe project is sponsored by the ASBL Byzantion, the Fondation Sedes Sapientiae, the Institut Religions, Spiritualit\u00e9s, Cultures, Soci\u00e9t\u00e9s (RSCS, UCLouvain) and the Centre d\u0027\u00e9tudes orientales (CIOL, UCLouvain) and by a generous donor who wishes to remain anonymous. Other sponsors have recently expressed their willingness to support the project.", "is_draft": false, "publication_date_l10n_long": "April 2026", "publication_date_l10n_medium": "Apr 2026", "related_identifiers": [{"identifier": "arXiv:2603.09470", "relation_type": {"id": "isdescribedby", "title_l10n": "Is described by"}, "resource_type": {"id": "publication", "title_l10n": "Publication"}, "scheme": "arxiv"}, {"identifier": "https://programminghistorian.org/fr/lecons/transcription-automatisee-graphies-non-latines", "relation_type": {"id": "issupplementto", "title_l10n": "Is supplement to"}, "resource_type": {"id": "lesson", "title_l10n": "Lesson"}, "scheme": "url"}, {"identifier": "https://github.com/calfa-co/Patrologia-Graeca", "relation_type": {"id": "issupplementto", "title_l10n": "Is supplement to"}, "resource_type": {"id": "dataset", "title_l10n": "Dataset"}, "scheme": "url"}], "resource_type": {"id": "dataset", "title_l10n": "Dataset"}, "rights": [{"description_l10n": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited.", "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title_l10n": "Creative Commons Attribution 4.0 International"}], "updated_date_l10n_long": "May 3, 2026", "version": "v2"}, "updated": "2026-05-03T16:14:29.244564+00:00", "versions": {"index": 2, "is_latest": true}}' data-preview='false'>
