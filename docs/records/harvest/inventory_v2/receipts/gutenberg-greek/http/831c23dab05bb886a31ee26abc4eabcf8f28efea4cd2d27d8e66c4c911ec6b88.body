<tr><td>Ελληνική ανυπομονησία</td><td style="text-align: center;"> »</td><td style="text-align: right;">344</td></tr>
<tr><td>Άρτος πιτυρίτης</td><td style="text-align: center;"> »</td><td style="text-align: right;">355</td></tr>
<tr><td>Φιλέλληνες και μισέλληνες</td><td style="text-align: center;"> »</td><td style="text-align: right;">368</td></tr>
