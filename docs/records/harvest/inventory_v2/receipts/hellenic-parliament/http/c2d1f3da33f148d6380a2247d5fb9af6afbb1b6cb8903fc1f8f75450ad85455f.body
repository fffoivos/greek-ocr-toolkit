","uuid":"e1523e36-269c-4131-af89-45f14e706081","name":"Εφημερίδες - Περιοδικά","handle":"20.500.14199/1","metadata":{"dc.description":[{"value":"Το αρχείο εφημερίδων - περιοδικών περιέχει 3000 τίτλους εφημερίδων από τον 19ο αιώνα.","language":null,"authority":null,"confidence":-1,"place":0}],"dc.description.abstract":[{"value":"Το αρχείο εφημερίδων - περιοδικών περιέχει 3000 τίτλους εφημερίδων από τον 19ο αιώνα.","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.uri":[{"value":"https://hdl.handle.net/20.500.14199/1","language":null,"authority":null,"confidence":-1,"place":0}],"dc.title":[{"value":"Εφημερίδες - Περιοδικά","language":null,"authority":null,"confidence":-1,"place":0}]},"archivedItemsCount":-1,"type":"community","_links":{"collections":{"href":"https://typos.parliament.gr/newspapers/api/core/communities/e1523e36-269c-4131-af89-45f14e706081/collections"},"logo":{"href":"https://typos.parliament.gr/newspapers/api/core/communities/e1523e36-269c-4131-af89-45f14e706081/logo"},"subcommunities":{"href":"https://typos.parliament.gr/newspapers/api/core/communities/e1523e36-269c-4131-af89-45f14e706081/subcommunities"},"parentCommunity":{"href":"https://typos.parliament.gr/newspapers/api/core/communities/e1523e36-269c-4131-af89-45f14e706081/parentCommunity"},"adminGroup":{"href":"https://typos.parliament.gr/newspapers/api/core/communities/e1523e36-269c-4131-af89-45f14e706081/adminGroup"},"self":{"href":"https://typos.parliament.gr/newspapers/api/core/communities/e1523e36-269c-4131-af89-45f14e706081"}},"base":"newspapers"}],"__lang":"el","__namespaces":{"auth":{"login":"Σύνδεση","login-title":"Ψηφιακές Συλλογές της Βιβλιοθήκης της Βουλής των Ελλήνων","login-subtitle":"Σύνδεση","login-google":"Συνέχεια με Google","login-facebook":"Συνέχεια με Facebook","login-email":"Συνέχεια με Email","no-account":"Δεν έχετε λογαριασμό","create-link":"Μπορείτε να εγγραφείτε εδώ.","have-account":"Έχετε ήδη λογαριασμό;","login-link":"Μπορείτε να συνδεθείτε ε