ιναν εἰς\nἸλαμινομάχος, ἐσταμάτησε τὴν βαρ.1τ\nτραγικήν καὶ δυσάρεσταν λύσιν.","language":null,"authority":null,"confidence":-1,"place":0}]},"inArchive":true,"discoverable":true,"withdrawn":false,"lastModified":"2024-08-06T11:44:58.150+00:00","entityType":null,"type":"item","_links":{"accessStatus":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/accessStatus"},"bundles":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/bundles"},"identifiers":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/identifiers"},"mappedCollections":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/mappedCollections"},"owningCollection":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/owningCollection"},"relationships":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/relationships"},"version":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/version"},"templateItemOf":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/templateItemOf"},"thumbnail":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a/thumbnail"},"self":{"href":"https://typos.parliament.gr/newspapers/api/core/items/3cfd348f-21cc-41e2-8a9c-66df29f9f07a"}},"_embedded":{"thumbnail":{"id":"931bf053-4373-4af9-b5f3-a07182886408","uuid":"931bf053-4373-4af9-b5f3-a07182886408","name":"thumbnail.jpg","handle":null,"metadata":{"dc.title":[{"value":"thumbnail.jpg","language":null,"authority":null,"confidence":-1,"place":0}]},"bundleName":"THUMBNAIL","sizeBytes":24357,"checkSum":{"checkSumAlgorithm":"MD5","value":"fffe534ac7770b475475299eb639669e"},"sequenceId":1,"type":"bitstream","_links":{"conte