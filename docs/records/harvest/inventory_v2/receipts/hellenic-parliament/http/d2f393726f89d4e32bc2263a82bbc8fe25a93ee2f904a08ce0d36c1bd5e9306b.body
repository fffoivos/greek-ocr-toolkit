98dea5e0-e5ab-4278-9f6d-431c7f20cd1b","name":"ΤΙΣ ΠΤΑΙΕΙ","handle":"20.500.14199/4683532","metadata":{"bibo.edition":[{"value":"1","language":null,"authority":null,"confidence":-1,"place":0}],"bibo.issue":[{"value":"7","language":null,"authority":null,"confidence":-1,"place":0}],"bibo.journal":[{"value":"ΤΙΣ ΠΤΑΙΕΙ","language":null,"authority":null,"confidence":-1,"place":0}],"custom.Recommended":[{"value":"e1523e36-269c-4131-af89-45f14e706081","language":null,"authority":null,"confidence":-1,"place":0},{"value":"e1523e36-269c-4131-af89-45f14e706081","language":null,"authority":null,"confidence":-1,"place":1}],"dc.date.accessioned":[{"value":"2023-12-15T06:50:49Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.available":[{"value":"2023-12-15T06:50:49Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier":[{"value":"ΤΙΣ_ΠΤΑΙΕΙ_1875-06-29_7_1","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.uri":[{"value":"https://hdl.handle.net/20.500.14199/4683532","language":null,"authority":null,"confidence":-1,"place":0}],"dc.language.iso639-2b":[{"value":"gre","language":null,"authority":null,"confidence":-1,"place":0}],"dc.publisher":[{"value":"ΓΕΡΑΣΙΜΟΣ ΤΖΑΝΕΤΟΣ","language":null,"authority":null,"confidence":-1,"place":0}],"dc.title":[{"value":"ΤΙΣ ΠΤΑΙΕΙ","language":null,"authority":null,"confidence":-1,"place":0}],"dcterms.created.from":[{"value":"1875-06-29","language":null,"authority":null,"confidence":-1,"place":0}],"dm2e.PublishedAt":[{"value":"ΑΘΗΝΑ","language":null,"authority":null,"confidence":-1,"place":0}],"files.filepath":[{"value":"2.17/ΤΙΣ_ΠΤΑΙΕΙ/1875/1875-06-29/ΤΙΣ_ΠΤΑΙΕΙ_1875-06-29_7_1","language":null,"authority":null,"confidence":-1,"place":0}],"lpgr.Collection":[{"value":"Φύλλα Εφημερίδων - Τεύχη Περιοδικών","language":null,"authority":null,"confidence":-1,"place":0}],"lpgr.firstPageText":[{"value":"Ἐν Ἀθήναις τὴν 29 Ἰουνίου 1875\nΕτος Α'.\nἈριθ.7\nΝ ΠΠρ.-\nΣΥΝΔΡΟΜΑΙ\nἘν Ἀθήναις ἐτησία δρ. 6\nἘν ταῖς ἐπαρχίαις υ 8\nἘν τῷ Ἐξωτερικῷ φ. 12\nΠροπληρωτέαι ἐν Ἀθήναις\nΤΙΜΗ ΚΑΤΑΧΩΡΙΣΕΩΝ\nΔι᾿ ἕκαστον στίχον Λ. 40\nἘπιστολαὶ μὴ ἀπηλλαγμέ-\nναι ταχυδρομικῶν τελῶν εἰ-\nσὶν ἀπαράδεκτοι.\nΕΦΗΜΕΡΙΣ ΣΑΤΥΡΙΚΗ ΚΑΙ ΠΟΛΙΤΙΚΗ.\nἩμέρτηκα Κύριε ἡμάρτηκα καὶ τὰς ἀνομίας μου ἐγὼ γινώσκω, ἀλλ᾿ ἀτοῦμαι εύμενος ἀνές μου Κύρι ἀνές μου\nἘκδίδεται ἅπαξ τῆς ἑβδομάδος ἐπὶ τοῦ παρόντος\nΣΤΕΡΕΟΤΥΠΟΝ\nΕἰδοποιοῦμεν πάντα ἀδικούμενον ὑπὸ /\nὑπαλλήλουἡ εἰδότα ἀσχημίας τοῦ δημο-\nσίου βίου αὐτοῦ, ὅτι δύναται ν᾿ ἀποστέλ-\nλῃ ἀληθεῖς πληροφορίας πρὸς τὸν συν-/\nτάκτην καὶ ἡ καταχώρισις τούτων γίνε-\nται δωρεάν.\nἡ ἀκρισία, ἡ ἀγυρτεία, καὶ πάντοτε ἡ δημοκοπία, ἰ¬\nδιότητας, ὅσπερ ἐπαγγέλλονται καὶ ἀφόβως μετέρ¬\nχονται τέκνα ἐναρέτων πατέρων.\nἘπὶ πατραγαθίας ἐρειδόμενος ὁ Χαρίλαος\nΤρικούπης ἀνεφάνη πρὸ πολλοῦ εἰς τὸν πολιτικὸν\nὁρίζοντα τῆς Ἑλλάδος· ἄνθρωπος ζήσας τὸ σπου.\nδαιότερον μέρος τοῦ βίου του ἐν ξένῃ γῇ καὶ ἐκ\nτοῦ πατρικοῦ ὀνόματος φιλιωθεὶς και ἀνατραφεὶς\nμετὰ ξένων ἰσχυρῶν καὶ ἐπιβαλλομένων τῇ Ἑλ-\nλάδι, ἐξέμαθε παρ᾿ αὐτοῖς τὴν κολακείαν καὶ χα¬\nμέρπειαν καὶ διὰ τῶν προσόντων τούτων, ὑποστη-\nὉ Χαρίλαος Τρικούπης\nΠαρ᾿ ἄλλοις εὐνομουμένοις ἔθνεσιν εἰς τὰ τῆς\nδιοικήσεως καλοῦνται καὶ ἐκτιμῶνται ἄνδρες, ὧν │\nτὰ ἔργα ναὶ ἡ δύναμις τοῦ νοὸς, μετ᾿ ἀπείρους !\nδοκιμασίας, μετέχουσιν ἀγαθότητος, πατριωτισμοῦ │\nκαι θαυμασμοῦ.\nΠαρὰ τοῖς αὐτοῖς ἔθνεσι ἡ κατάστασις τοῦ προ-\nσώπου ἐπάγεται τὴν ἑαυτοῦ ἐκτίμησιν.\nΠαρ᾿ ἡμῖν ὅμως, οἵτινες λεγόμεθα ὅτι ζῶμεν !\nἐν εὐνομίᾳ καὶ ἐλευθερίᾳ τ᾿ ἀντίστροφον συμβαί.\nνεῖ. Ὁ θάνατος τοῦ ἀγαθοῦ πατρὸς ἐγκαταλείπει │\nεἰς τὸν κληρονόμον· υἱὸν, καὶ ἂν ἢ μωρὸς, καὶ τὴν !\nἀγαθότητα τοῦ πατρὸς καὶ τάτε μάριάτου.\nΠαρ᾿ ἡμῖν δυστυχῶς, τοῖς δῆθεν ἀπογόνοις τῶν │\nπαρὰ τῶν ἐθνῶν θαυμασθέντων Ἑλλήνων δύναμις !\nτοῦ νοὸς ἐστὶν, ἐκθειάζεται, ἐπιτυγχάνει καὶ διοκῇ !\nριζομένων ὑπὸ τῶν ξένων ἰσχυρῶν, ἐκλήθη ἄλ-\nλοτε εἰς τὴν διοίκησιν τῆς ἐλευθέρας Ἑλλάδος.\nΓνωσθέντων τῶν ἀτυχῶν, προσόντων του εἴπετο\nἀναγκαίως ἡ πρὸς αὐτὸν ἀποστροφὴ τοῦ ἔθνους καὶ\nἐκπομπὴ ἀπὸ τὴν διοίκησιν.\nΣτενοχωρούμενος διὰ τὴν τοιαύτην θέσιν του παρὰ\nτῇ πολιτείᾳ καὶ τικόμενος διὰ τὴν τοιαύτην ἀση¬\nμότητα, τοὺς μὲν ξένους ἰσχυροὺς προσελιπάρει\nδιὰ τῆς συνήθους χαμερπείας καὶ κολακείας, τὴν\nδὲ κατάληψιν τῆς ἐξουσίας διὰ τῶν προσόντων\nτου τούτων ἐπεδίωκεν.\nἩ τύχη βοηθεῖ τοὺς τοιούτους χαμερπεῖς.\nἈναλαμβάνει τὴν διοίκησιν ἡ πεσοῦσα κυβέρ-\nνησις, γεννᾶται ἐθνικὴ ἄμπωτις καὶ παλίρροια καὶ\nἰδοὺ ἐκ τοῦ βυθοῦ τῆς πολιτικῆς ταύτης ταραχῆς\nἐξέρχεται ἐν τῇ δημοσιογραφίᾳ ὁ Σωτήρ ! 11 τὴς\nἙλλάδος Χαρίλαος ὁ Τρικούπης καὶ","language":null,"authority":null,"confidence":-1,"place":0}]},"inArchive":true,"discoverable":true,"withdrawn":false,"lastModified":"2024-08-06T11:43:51.300+00:00","entityType":null,"type":"item","_links":{"accessStatus":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/accessStatus"},"bundles":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/bundles"},"identifiers":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/identifiers"},"mappedCollections":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/mappedCollections"},"owningCollection":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/owningCollection"},"relationships":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/relationships"},"version":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/version"},"templateItemOf":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/templateItemOf"},"thumbnail":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea5e0-e5ab-4278-9f6d-431c7f20cd1b/thumbnail"},"self":{"href":"https://typos.parliament.gr/newspapers/api/core/items/98dea