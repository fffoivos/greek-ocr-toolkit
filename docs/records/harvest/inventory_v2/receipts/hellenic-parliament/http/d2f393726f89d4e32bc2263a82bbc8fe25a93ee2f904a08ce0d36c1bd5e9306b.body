,"dc.title":[{"value":"ΤΑ ΟΛΥΜΠΙΑ","language":null,"authority":null,"confidence":-1,"place":0}],"dcterms.created.from":[{"value":"1896-04-21","language":null,"authority":null,"confidence":-1,"place":0}],"dm2e.PublishedAt":[{"value":"ΑΘΗΝΑ","language":null,"authority":null,"confidence":-1,"place":0}],"files.filepath":[{"value":"2.17/ΤΑ_ΟΛΥΜΠΙΑ/1896/1896-04-21/ΤΑ_ΟΛΥΜΠΙΑ_1896-04-21_24_1","language":null,"authority":null,"confidence":-1,"place":0}],"lpgr.Collection":[{"value":"Φύλλα Εφημερίδων - Τεύχη Περιοδικών","language":null,"authority":null,"confidence":-1,"place":0}],"lpgr.firstPageText":[{"value":"ρτοατα καρ ποτον πο. κ. τουτκατομας\nΣΥΝΔΡΟΜΗ\nΕΞΟΓΚΡΙΚΟΥ ἐτησία δρ. 132\n\u0026 ΠΡΟΠΛΗΡΩΤΕΑ Φ\nΕἰδοποιήσεις Καλλιτεχνικαὶ\nΤΔ ΟΥΥΙνΙΙΣ\nΚΑΤ᾿ ΑΠΟΚΟΠΗΝ\nΓΡΑΦΕΙΟΝ\nΟΔΟΣ ΣΤΑΔΙΟΥ. ἀρθ 40.\nἘπιστολαῖ καὶ Ἀποστολαὶ\n\u0026 ΧΡΗΜΑΤΩΝ 2\nἀπ᾿ εὐθείας πρός τὸ περιοδικόν\nΤΑ ΟΛΥΜΠΙΑ\nΕΒΔΟΜΑΔΙΑΙΑ ΑΘΗΝΑΙΚΗ ΕΠΙΘΕΩΡΗΣΙΣ ΕΙΚΟΝΟΓΡΑΦΗΜΕΝΗ\nΕΤΟΣ Α'\nἈθῆναι τῇ 21 Ἀπριλίου 1896\nΑΡΙΘ. 24\nΔΙΕΥΘΥΝΤΗΣ\nΓΕΩΡΓΙΟΣ ΜΑΛΑΝΔΡΙΝΟΣ\nἘκδίδεται νατὰ Κυριακὴν\nἈπό τοῦ προσεχοῦς φύλλου\nΤΟ ΔΕΛΤΙΟΝ ΜΕΤΑΡΡΥΘΜΙΖΕΤΑΙ\nΠΡΟΣΤΙΘΕΜΕΝΩΝ ΔΥΟ ΕΠΙ ΠΛΕΟΝ ΣΕΛΙΔΩΝ ΥΛΗΣ\nἈντὶ τῶν ἀγγελιῶν, ἂς καταργοῦμεν ἐπὶ προφανεῖ ζημίᾳ ἡμῶν, τὰς δύω\nτελευταίας σελίδας τοῦ δελτίου διαιροῦμεν εἰς ὀκτὼ σελίδας, εἰς τρόπον ὥστε\nοἱ ἀναγνῶσται ἡμῶν ἀποκόπτοντες αὐτᾶς νὰ ἔχωσι σὺν τῷ χρόνῳ, ἐκτὸς τοῦ\nφύλλου καὶ τοῦ δελτίου, καὶ κομψὸν τομίδιον εἰκονογραφημένον.\nΠρῶτον ἔργον θὰ δημοσιεύσωμεν τὸ ἔξοχον μυθιστόρημα τοῦ πρὸ δέκα μό-\nλις ἡμερῶν δημοσιευθέντος ἐν Παρισίοις τοῦ Γ. Ὀνὲ ὁ Ἀνωφελὴς Πλοῦτος.\nΚαὶ μὲ ὅλην τὴν ἐπι πλέον δαπάνην αὐτὴν ἡ συνδρομὴ μένει ἡ αὐτή.\nΟΛΥΜΠΙΑΚΟΙ ΑΓΩΝΕΣ\nΤὸ ἀναμνηστικὸν μετάλλιον\n) ΠΟΑΤΗΤΜΑΝΟΙ ΑΤΩΝΕ/124/\nΑ'.\nΕΠΙΣΤΟΛΑΙ ΤΟΥ ΑΒΕΡΩΦ\nΕΜΑΘΗΝΑΙΣ\n1596\nΒ'.\nλαμπρότητος, μεθ᾿ ἧς οἱ πραπάτορες ἡμῶν\nἐτέλουν τοὺς Ὁλυμπιακοὺς Ἀγῶνας,\nἩ ἐθνικὴ φιλοτιμία εἶνε πληρέστατα\nἱκανοποιημένη ἐκ τοῦ εὐτυχοῦς ἀποτελέ-\nσματος τῶν Ἀγώνων ἐν γένει· ἔτι δὲ\nμᾶλλον ἐκ τῆς νίκης, ἣν ἤραντο τἱ ὁμοε¬\nθνεῖς ἡμῶν ἔν τισι τῶν ἀγώνων καὶ ἴδια\nἐν τοῖς σπουδαιστάτοις αὐτῶν, τοῦ τῆς\nσκοποβολῆς καὶ τοῦ Μαραθωνίου δρόμου.\nΕἰς ἅπαντας τοὺς ὁλυμπιονίκας ἡμῶν σας\nπαρακαλῶ νὰ προσφέρητε τὰ εἰλικρινῆ μου\nσυγχαρητήρια καὶ τοὺς θερμοὺς ἀσπασμοὺς\nμου, ἰδίᾳ δὲ εἰς τὸν νικητὴν τοῦ Μαραθω-\nνίου δρόμου παρακαλῶ νὰ ἐπιδώσητε αὐ¬\nτοπροσώπως τὴν ἐσώκλειστον πρὸς αὐτὸν\nἐπιστολήν μου. Διαβεβαιώσατε πάντας,\nὅτι συμμερίζομαι τὴν χαρὰν τοῦ Πανελ-\nΑναμνηστικὸν γραμματόσημον\nληνίου ἐπὶ ταῖς νίκαις αὐτῶν.\nἈλλὰ πόσων συγχαρητηρίων δὲν δι-\nκαιοῦσθε καὶ ὑμεῖς, ἱ ἀκάματος παρα¬\nσκευαστὴς καὶ διαργανωτῆς, ὡς ἀληθὴς\nψυχὴ τῶν Ἀγώνων ! Καὶ πῶς ἦτο δυνα¬\nτὸν νὰ καθυστερήσητε ἀπέναντι τοῦ πα-\nραδέγματος, ὅπερ ἔδιδον ὑμῖν καὶ πᾶσι\nτοῖς συναδέλφοις ὑμῶν ἐν τῇ ἐπιτροπείᾳ\nτῶν Ὀλυμπιακῶν ἡ ἀνωτέρα νσημοσύνη,\nὁ ἀκάματος ζῆλος καὶ ὁ ἐνθουσιώδης πα¬\nτριωτισμὸς τῆς Α. Υ. τοῦ Διαδόχου καὶ\nτῶν συνεργῶν αὐτοῦ βασιλοπαίδων ;\nΕἴη δεδοξασμένον τὸ ὄνομα τοῦ Θεοῦ,\nὅστις ἐδωρήσατο τῇ Ἑλλάδι τοιαῦτα τέ-\nκνα, καύχημα καὶ ἐλπίδα αὐτῆς, οὐχ ἦτ¬\nτον ἤ τῶν σεπτῶν Βασιλέων ἡμῶν.\nὉ μεγαλόδωρος Ἠπειρώτης χορηγός\nΔέξασθε τά εἰλικρινῆ συγχαρητήριά\nτῶν Ὁλυμπιακῶν ἀγώνων 7- Γ. Αδέ-\nμου καὶ εὐαρεστηθῆτε νὰ γείνητε ὁ διερ-\nρωφ, ἐπὶ τῇ ἐπιτυχίᾳ αὐτῶν, ἀπέστειλε\nμηνεύς τῶν αἰσθημάτων μου παρὰ πᾶσι\nπρὸς τὸν κ. Τιμ. Φιλήμονα καὶ τὸν νι¬\nτοῖς συντελέσασιν εἰς τὴν ἐπιτυχίαν τῶν\nκητὴν τοῦ Μαραθωνίου δρόμου Σ. Λεύην\nὈλυμπιακῶν Ἀγώνων.\nτὰς κάτωθι συγχαρητηρίους ἐπιστολάς :\nἘπὶ τούτοις σας ἀκριβοασπάζομαι\nἈλεξάνδρεια 1/23 Ἀπριλίου.\nὉ φίλος σας\nἈγαπητὲ φίλε κ. Τιμ. Φιλήμων,\nΓΕΩΡΓΙΟΣ ΑΒΕΡΟΦ\nΜετὰ παλμῶν καρδίας καὶ μετὰ βα-\nθείας συγκινήσεως παρηκολούθησα τοὺς αὐ-\n7 Ἀλεξάνδρεα, 123 Ἀπριλου.\nτόθι τελεσθέντας Ὀλυμπιακοὺς Ἀγῶνας,\nΚέριε Σ. Λούη,\nεἶνε δ᾿ ἀνέκφραστος ἡ χαρά μου ἐπὶ τῇ\nΣᾶς εὐχαριστῶ ἀπὸ καρδίας ἐπὶ τῇ εὐ-\nὑπὲρ πᾶσαν προσδοκίαν ἐπιτυχίᾳ αὐτῶν.\nφροσύνῳ ἀγγελίᾳ, ἣν τηλεγραφικῶς μοὶ\nΧαίρω ἰδίᾳ, ὅτι τὸ Παναθηναϊκὸν Στά-\nδιον, καίπιρ ἀτελῶς ἔτι ἀνακαινισθέν,\nδιεβιβάσατε, τῆς νίκης Ὑμῶν ἐν τῷ Μα-\nσυνετέλεσε τόσῳ θριαμβευτικῶς εἰς τὴν ἐπι-\nραθωνείῳ δρόμῳ.\nἘὰν ἡ ἀνασύστασις τῶν Ὀλυμπιακῶν\nτυχίαν ταύτην, παραστῆσαν τῷ πεπολι-\nἀγώνων, τελεσθέντων ἐν Ἀθήναις τὸ πρῶ-\nτισμένῳ κόσμῳ εἰκόνα φαεινὴν τῆς πάλαι","language":null,"authority":null,"confidence":-1,"place":0}]},"inArchive":true,"discoverable":true,"withdrawn":false,"lastModified":"2024-08-06T11:44:38.068+00:00","entityType":null,"type":"item","_links":{"accessStatus":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/accessStatus"},"bundles":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/bundles"},"identifiers":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/identifiers"},"mappedCollections":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/mappedCollections"},"owningCollection":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/owningCollection"},"relationships":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/relationships"},"version":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/version"},"templateItemOf":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/templateItemOf"},"thumbnail":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56/thumbnail"},"self":{"href":"https://typos.parliament.gr/newspapers/api/core/items/6c1c2e1a-6a42-44bd-9802-d32fc353ad56"}},"_embedded":{"thumbnail":{"id":"a08669f8-f1f3-4135-9005-f932e9f0e576","uuid":"a08669f8-f1f3-4135-9005-f932e9f0e576","name":"thumbnail.jpg","handle":null,"metadata":{"dc.title":[{"value":"thumbnail.jpg","language":null,"authority":null,"confidence":-1,"place":0}]},"bundleName":"THUMBNAIL","sizeBytes":14621,"checkSum":{"checkSum