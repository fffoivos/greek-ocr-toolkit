-10T05:06:39Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.available":[{"value":"2024-01-10T05:06:39Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier":[{"value":"Η_ΕΛΠΙΣ_1844-04-01_129_1","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.uri":[{"value":"https://hdl.handle.net/20.500.14199/5125961","language":null,"authority":null,"confidence":-1,"place":0}],"dc.language.iso639-2b":[{"value":"gre","language":null,"authority":null,"confidence":-1,"place":0}],"dc.publisher":[{"value":"ΚΩΝΣΤΑΝΤΙΝΟΣ Ν. ΛΕΒΙΔΗΣ","language":null,"authority":null,"confidence":-1,"place":0}],"dc.title":[{"value":"Η ΕΛΠΙΣ","language":null,"authority":null,"confidence":-1,"place":0}],"dcterms.created.from":[{"value":"1844-04-01","language":null,"authority":null,"confidence":-1,"place":0}],"dm2e.PublishedAt":[{"value":"ΑΘΗΝΑ","language":null,"authority":null,"confidence":-1,"place":0}],"files.filepath":[{"value":"2.17/Η_ΕΛΠΙΣ/1844/1844-04-01/Η_ΕΛΠΙΣ_1844-04-01_129_1","language":null,"authority":null,"confidence":-1,"place":0}],"lpgr.Collection":[{"value":"Φύλλα Εφημερίδων - Τεύχη Περιοδικών","language":null,"authority":null,"confidence":-1,"place":0}],"lpgr.firstPageText":[{"value":"120\nΑΡΙΘ.\nΑΘΗΝΑΙ Ι ΑΠΡΙΛΙΟΥ 1844 ΣΑΗΗΑΙΩΙ ΕΤΟΣ\nΠΕΛΙΙΣ\nΕΦΗΝΕΡΙΑ\nΤΩΝ ΑΡΧΩΝ ΤΗΣ Γ. ΣΕΠΤΕΜΒΡΙΟΥ.\nΤιμὴ ἐτησία διὰ τοῦς ἐντὶς τῆς ἐπικρατείας Δραχ.\nδιὰ τοὺς ἐκτὸς »\nΤιμὴ τῶν καταχωρήσεων δι᾿ ἕκαστον στῖχεν Λεπτὰ 20.\nΓράμματα πρὸς τὴν διάθυνσιν τῆς ἐφημερίδας πίλλευται ἀνεξέδως.\nΑΘΗΝΑ Ι ΑΠΡΙΛΙΟΥ 1841.\nἜχομεν τέλος πάντων Κυβέρνησιν !\nΑὐταὶ αἱτέσσαρες λέξεις ἀρκοῦσι νὰ ἀποστομώ-\nπεων τος νος πας τ πντο τ πατῶν\nκαὶ ἐκείνους τῶν δημοσιογράφων τῆς Εὐρώπης, ὅσοι │\nἀπαρλονστή ῆς ντας κτς, τ τος\nκαλν ποατανος ανκατοντος\nήπεως, χωρὶς νὰ ἔχῃ ἄλλο ἐλατήριον παρὰ τὸν\nπατριωτισμόν του, ἄλλον δεσμὸν παρὰ τὴν ἠθικήν │\nτου, ἄλλον χαλινὸν, παρά τὴν ἀγάπην του πρὸς τὴν !\nτάξιν, πρὸς τὴν εὐνομέαν, πρὸς τὴν ἀτάρακτον τα-\nκτοποίησιν τῶν πολιτικῶν ἀνωμαλιῶν. Ἑπτὰ μῆνας │\nἐπορολογεῖτο ὁ λαὸς ὑπακούων εἰς τὰς διαταγὰς /\nτῶν ταμῶν, οἱ ὁποῖοιἄλλην δὲν εἶχον ἐκτελεστικὴν │\nἀπαπῶν πά τὴν πραρῶντον, Ἀεντατο ἔτος\nκαὶ εἰς τοὺς ἀνισχύρους διοικητὰς ἔδιδε τὴν δύναμιν /\nά πρέσα το πον τό τῦ το πο τς\nΟ ΠΑ ΜΑΝΕ ΝΕΙΚΑΤΕΣΤΟΝ\nπατεν τά κατάχντας ομτα ρτ\nέ καί ἐαν Ματντως ὅπως προτακῆς\nρίς τς ἡ πηρέστατα ποκέε τατνς\nχωρὶς ν᾿ ἀποσπᾷ τὴν προσοχήν της εἰς τὰς Ἐπαρ-/\nΜοναδικὸν εἶναι τὸ φαινόμενον τοῦτο εἰς τὴν ἱ-\nστορίαν τοῦ ἀνθρωπίνου γένους, ἥτις εἰς παρομοίας /\nς ὡς παικας πορετατον, μὲ ποροτινς\nαἷμα τῶν πολιτῶν, μᾶς ἐπιδεικνύει ὡς φόβητρα διὰ\nπετρμε τος μεπκς\nΚας ἐπαστς κὰ τὲ λνος ἀποταγρες\nἩθεία Πρόνοια ἐπέβλεψεν εἰς τὸ Ἑλληνικὸν ἔθνος /\nεἰς τὸ ὁποῖον ἐπεφύλαξεν ἀειθαλεῖς δάφνας διὰ τὸ /\nμέλλον· τὸ καθῳδήγησε τείνασα πρὸς αὐτὸ τὴν κρα-\nταιὰν δεξιάν της· δὲν ἐσταμάτησε τῶν οὐρανίων σω-\nλων οί λαοένων ἐν πτητῇς τ τς\n») θρησκευτικὴν εὐλάβεαν. Ὁ κάλαμός μας, τὸν ὁποῖον\nὅλον ὁμονοεῖ ν᾿ ἀφήσωσι κατὰ μέρος τὰς κομμα-/\nτὸ ψεῦδος ποτὲ δὲν ἐμόλυνε, θέλει ἐπαινεῖ τὰ ἐ¬\nτικὰς συμπαθείας καὶ ἀντιπαθείας πρὸς τὰ ΠΡΟ-\nΣΩΠΑ, καὶ νὰ σκεφθῶσι μόνον καὶ μόνον πῶς νὰ θέ-\nπαινετά, καὶ θέλει στηλιτεύει μὲ τὴν ὀξύτητα τοῦ\nσωσιν εἰς κίνησιν ταχεῖαν, ἀτάραχον, τὸν Σνταγμα- /\nβέλους τὰ στηλιτεύσεως ἄξια. Αἱ ἀτομικαὶ συμπά¬\nτικὸν μηχαιωμὸν τῆς ἐπικρατείας μας, τοῦ ὁποίου │\nθειαί μας δὲν συναναβιβάζονται μετὰ τοῦ δημοσίου\nὁ μέγας μηχανκὸς ἦτο αὐτὴ ἡ ΟΜΟΝΟΙΑ.\nὑπαλλήλου εἰς τὴν ὁποίαν αὐτὸς καταλαμβάνει ἕδραν.\nΔὲν ἤκουσαν τὰς συμβουλάς μας, ἐχωρίσθησαν /\nἘκ προσιμίων ἀπευθύνομεν πρὸς τὸ νέον Ὑπουργεῖον τὰς\nἀπ᾿ ἀλλήλων, χωρὶς νὰ συλλογισθῶσιν, ὅτι οἱ δέ-\nἑξῆς ἐλίγας συμβουλὰς τὰς ὁποίας εὐχόμεθα ν᾿ ἀκολουθήσῃ\nποντες τὴν τύχην τοῦ ἔθνους πρέπει νὰ σέβωνται ἐ-\nὉ Κ. Μαυροκορδάτος ἂς ἐνθυμηθῆ, ὅτι ἀποσπασθεὶς τῶν\nαυτοὺς, καὶ δὲν σέβεται βεβαίως ἑαυτὸν, ὅστις πράτ-\n) ὅδω λοιπῶν, ἄλλοτε κομματαρχῶν καὶ πρὸ ἐλίγου φίλων\nμσας ά στα τ πνοτος τς πρστης τς τν.ο\nτει τὰ ἐκ διαμέτρου ἐναντία ἐκείνων, ὅσα ὡς μόνα │\nζητήσῃ τὴν διανομήν των μεταξὺ τῶν ὁπαδῶν του. Πρὸ πάν¬\nτας οροίος ο τ οετος πτέτος\nτων ἂς μὴ λησμονήσῃ, ὅτι εἰς αὐτὸν κυρίως ὀφείλεται\nἡ πληγὴ τῆς ἰσοβιότητος τῆς Γερουσίας, καὶ ὅτι ἐ¬\n[δωσαν ἀλλήλοις, ὅταν ἐν στενωτάτῳ συνδέσμῳ πα-/\n[πομένως τοποθετῶν εἰς τὸ σῶμα τοῦτο ἐξόχους καὶ διὰ\nρουσιάσθησαν ἐνώπιον τῆς Συνελεύσεως, δὲν ἦτο φί-\nτὸν πατριωτισμὸν καὶ διὰ τὴν ἀρετήν, καὶ διὰ τὰς γνώσεις\nἐ) λημα ἀδελφικὸν, ἦτο φίλημα Ἰούδα.\nτν πέτας το νον παοστος τν πριτ\nὉ Κ. Μαυροκορδάτος ἀποχαιρετήσας τοὺς συνα-\nγωνιστάς καὶ ἀνταγωνιστάς του Μεταξᾶν καὶ Κω-\nἂς ἐνθυμηθῆ, ὅτι ἂν εἰς τὰς λοιπὰς ὑπηρεσίας τὰ λάθη τοῦ\nλέτην, κρατεῖ σήμερον τὸ πηδάλιον τῆς πολιτείας. 1\n) ἑνὸς ὑπουργοῦ δύνανται νὰ διορθωθῶσι παρὰ τοῦ διαδόχου\nΔὲν εἴμεθα προκατειλημμένοι κατὰ τοῦ Ὑπουργείου /\nτου, ὁ διορισμὸς Γερουσιαστῶν ἀναξίων τῆς ὑψηλῆς ταύ-\nτης θέσεως εἶναι πληγὴ ἀνίατος, τὴν ὁποίαν μόνος ὁ, ὡς ἐπὶ\nτου φρονοῦμεν ὅμως πάντοτε, ὅτι ἄν καὶ περιέχῃ ἀ-\n) τὸ πολὺ εἰς ἄκρον φειδωλὸς πρὸς τοὺς κακοὺς πολίτας θά-\nναντρδήτως πολίτας ὄχι ἀξιοκαταφρονήτους καί κατὰ /\nκτος δύατα νὰ θεραπεώσῃ. Ἂν τὸ ἕνως εὐρθ εἰς κα-\nτὰς πρὸς τὴν πατρίδα ἐκδουλεύσεις καὶ κατὰ τὴν │\nἱκανότητα, δὲν περιέχει ὅμως τ᾿ ἀναγκαῖα στοιχεῖα !\nνὸν νὰ λησμονήσῃ τὸν σκοπὸν τῆς συστάσεώς του, τὸ ἔθνος\nΣυνταγματικοῦ Ὑπουργείου, ἔχοντος νὰ ἐμφανισθῇ /\nδὲν θέλει καταρᾶσθαι μόνον τοὺς ἐνόχους Γερουσιατάς, ἀλλὰ\nἐνώπιον Βουλῆς, καὶ Βουλῆς ὄχι γεγυμνασμένης εἰς\nκαὶ εἰς αὐτὸν τὸν τάφον θέλει ἀναζητῖ τὰ ὀστᾶ τῶν πρω¬\nτὰ βουλευτικὰ δρομήματα, ἀλλ᾿ ἀκμαίας καὶ παρουσι-\nταιτίων τῆς ἰσοβιότητος, διὰ νὰ τὰ στερήσῃ καὶ αὐτῆς ἀ¬\nαζομένῃς μετὰ εἴκοσι ἐτῶν καταπέεσιν. Δὲν περιέχει /\nκόμη τῆς ἡσύχου κοίτης των.\nπαπιαν τοπνς ΤΕΡΕΑΗΣ\nὉ λαὸς ἀπέκαμε πλέον πληρώνων φόρους κολλοσσαίους\nἀπέναντι τῆς πυγμαίας καταστάσεώς του· ἡ γεωργία στε¬\nσει ἴσως ἐνίοτε τοὺς Ὑπουργοὺς λησμονοῦντας,\nνάζει, ἡ βιομηχανία πνέει τὰ λοίσθια, τὸ ἐμπόριον βαρυ¬\nὅτι πρέπει νὰ ἦναι φίλοι τοῦ ἔθνους, νὰ ἐνθυμη-\nμας τα ὁ ποαρα εν κος πρπτον. Τν\nθῶσιν ὅτι πρέπει νὰ ἦναι φίλοι τοῦ κόμματος, εἰς τὸ /\n[μένων νὰ συμβιβάσωσι τοῦ λαοῦ τὴν ἀθλίαν οἰκονομικὴν κα¬\nὁποῖον ἀνήκουσιν· δὲν περιέχει ἱκανὰ στοιχεῖα τοπι-\nτάστασιν μὲ τὰς ἀνάγκας τῆς Ἐπικρατείας.\nκῆς βαρύτητος, διὰ νὰ ἐμπνέῃ τὸ γενικὸν ἐκεῖνο σέ-\nἩ παιδεία πρέπει νὰ ἐξέλθῃ τοῦ στενοῦ κύκλου τῆς\nβας, τὸ ὁποῖον, καθ᾿ ἡμᾶς, ἔπρεπεν᾿ ἀπολαύῃ τὸ πρῶ-\nΓερμανικῆς σχολαστικότητος, καὶ ἡ μετέωρας κατάστασις\nτον μετὰ τὴν πολιτικὴν μεταβολὴν Ὑπουργεῖον.\nτῶν μετὰ τῆς Τουρκίας σχέσεών μας πρέπει νὰ παύσῃ δρι-\nΕἴθε τὰ πράγματα νὰ ψεύσωσι τὴν περὶ τοῦ συ-\nσας δον εοηατα ετ τ παο πτῶν\nστηθέντος Ὑπουργείου ἰδέαν μας ! Εἴθε νὰ δυνηθῶ-\nσιν οἱ νέοι Ὑπουργοὶ νὰ ἐμφανισθῶσιν ἐνώπιον τῶν │\nἐν Τοιρκίᾳ Ἑλλήνων εἰς τὰς Συμμ. Δυνάμεις, καὶ ἂς παύσῃ\nΒουλῶν μὲ τὴν πεποίθησιν ἐκείνην, μὲ τὴν ὁποίαν │\nἡ Πρεσβεία μας. Δὲν πρέπει πλέον νὰ ζητῶμεν ὡς ἔλεος,\nπαρουσιάζεται ἐνώπιον τῶν δικαστῶν, ὁ κρατῶν εἰς │\nὅτιμᾶς ἀνήκει καὶ δυνάμει τοῦ δικαιώματος τῶν ἐθνῶν,\nχεῖρας τὸ ἀπρόσβλητον τεκμήριον τῆς ἀθωότητός του.\nκαὶ δυνάμει τοῦ δικαιώματος τοῦ ὀνόματός μας, δικαιώμα-\nΜακρὰν πάντοτε τῶν κομματικῶν διαπληκτι-\nτος ἰσχυροῦ, περιέχοντος ἐν ἑαυτῷ τὴν ἰδίαν μεγάλης διὰ\nσμῶν τῶν ΠΡΟΣΩΠΩΝ, μὴ κρίνοντες τὰ πρόσω- /\n»— ] τὸ μέλλον κληρονομίας.\n[πα ἐκ τῆς ἀτομικότητός των, καὶ ἐκ τῆς σχέσεώς │\n5) Τοῦ Ὑπουργοῦ τῆς Δικαιοσύνης, τοῦ νέου Κυρίου Α.\n] των πρὸς τὰ σεσαθρωμένα κόμματα, ἀλλ᾿ ἐκ τῶν │\n1) Α. Λόνδου δὲν διαφιλονεικοῦμεν τὴν ἱκανότητα, ἀλλὰ τῶ\nἐπαάίος τον ρον πατε α τος τῦ το\nΚαάτας τ τ τ δυρορῶς τὰ τὸ πτο\nπὴν εἰς τὰ ἀφρισμένα κύματα τῆς θαλάσσης ἀποκα-/\nταρήσασα αὐτὰ γεφύρας, ἀλλ᾿ ἐν τῇ ἀπειρίᾳ τῆς\nχάριτός της ἐνέπνευσεν εἰς τὰς καρδίας μας τὴν !\nΟΜΟΝΟΙΑΝ, καὶ ἰδοὺ ἡ Γ. Σεττεμβρίου, ἐνώπιον │\nτῆς ὁποίας ταπενοῦνται τὰ χρονικὰ τῶν αἰώνων.\nΑὐτὴν τὴν θείαν ΟΜΟΝΟΙΑΝ ἐσυστήσαμεν μετὰ /\nτὴν διάλυσιν τῆς ἐθικῆς μας Συνελεύσεως εἰς τοὺς /\nΚυρίους Μαυροκορδάτον, Κωλέτην καὶ Μεταξᾶν, ἄν- /\nδρας, εἰς τοὺς ὁποίους κἀνεὶς δὲν διεφιλονείκησε τὸν │\nπατρωτισμόν των, καὶ τὰς πρὸς τὴν πατρίδα ἐκ-\nδουλεύσεις των, εἰς τοὺς ὁποίους ὅμως τὸ ἔθνος │\nπελλάκις ἀπέδωσε δικαίως τὰ δεινά του, διότι δυνη-\nθέντες ἐν ὁμονοίᾳ νὰ πράξωσι τὸ καλὸν, ἔγιναν διὰ\nτῆς ἀχονοίας των παραίτισι πληγῶν δυσιάτων. Τοὺς /\nἐυμβουλεύσαμεν νὰ δώσωσιν ἀλλήλοις ἀδελφικῶς,\nἐλκρινῶς τὴν δεξιὰν, καὶ ἀφοῦ τὰς αὐτὰς καὶ οἱ !\nτρεῖς ἔχουσιν συνταγματικὰς ΑΡΧΑΣ, ἀφοῦ τὸ ἔθνος │\nεἰς τὴν ὁποίαν αὐτὸς ἀνήκει. Εἴμεθα κατὰ πάντα σύμφω-\nἁρμόζει εἰς τοὺς ὁμιλοῦντας πρὸς τὸ Κοινόν.\n[νοι νὰ παύσῃ πλέον ἢ διὰ τὰ Ὑπουργεῖα στρατολογία μετα-\n)Ὑπεσχέθημεν καὶ πρὸ τοῦ δορισμοῦ τοῦ Ὑπουρ- /\nξκ τῶν παρηγμασάντων ἤδη ἀνδρὼν τῆς παλαιᾶς ἐποχῆς.\nγείου, ὅτι θέλομεν το ὑποστηρίξει οἱονδήποτε καὶ\nμεταξὺ τῶν ὁποίων πολλοὶ ἔχουσι συστατικὰ τὰς πρὸς τὸ\nἂν ἤθελεν εἶσθαι ἐν ὅσῳ ἤθελε βαδίζει τὴν συνταγ-\nἔθνος ἐκδουλεύσεις των, διὰ τὰς ὁποίας τοῖς ὀφείλεται φά-\nματκὴν ὁδὸν, ἐν ὅσῳ δὲν λησμονήσῃ, ὅτι πρέπει /\n[ρος εὐγνωμοσύνης καὶ περιποίησις εἰς τὸ γῆράς των, πολ-\nνὰ σέβηται τὴν γεννήσασαν αὐτὸ Τρίτην Σεπτεμ-\nκ. κα ν χρολο πτος τοῦ το τς\nβρίου, ἐν ὅσῳ ἤθελεν ἐνθυμεῖσθαι, ὅτι τὸ ἔθνος δὲν │\nποώμημε τὴν πολτκή μεταλλη δὰ νὰ κθσε\n1 ) πί των, καὶ τὴν ἐν τῇ κακίᾳ λευκαθεῖσαν πολιάν των.\nχροσοφάντους στολὰς ὅσι δὲν ηὐτύχησαν νὰ τὰς /\nὉ Νάρος Α Ν. Λάπες ἂς δνωμθα τὸ φλαστρὰν\nφορήσωσι ἐπὶ τοῦ πεπτωκότος συστήματος, διὰ νὰ │\nκαταλάβωσι τὰς δημοσίας θέσεις, ὅσοι, ἀνάξιοι ἴσως │\nὉ Κ. Μαυροκορδάτος κακῶς πιῶν δὲν συμπεριέλαβε εἰς τὸ\nαὐτῶν τὰς ἐθήρευαν ἄλλοτε, διὰ ν᾿ ἀναστηθῇ ὁ Κο-\nὙπουργεῖον τῶν Ναυτικῶν καὶ ἄλλον τῆς νέας γενεᾶς πολί-\nτζαμπασισμὸς, διὰ νὰ ἀσωτεύηται ὁ δημόσιος πλοῦ-\nπν, ἀφοῦ παρητήθη ὁ Κ. Κανάρης. Ὑπάρχουσι δύω υἱοὶ\nδύω ἐνδόξων τοῦ ἀγῶνος ἀνδρῶν, ὁ Μιαούλης καὶ Τομπάζης,\nτος πρὸς ἀμοιβὴν ἐκδουλεύσεων κομματικῶν ἐν τῇ │\nαθούση τῆς Συνελεύσεως. │\nἜοε: εἄν τε τξ αὐτῶν, νά πληρώσῃ τό κενόν,\nΤὴν ὑπόσχεπίν μας θέλομεν τὴν διατηρήσει μὲ !","language":null,"authority":null,"confidence":-1,"place":0}]},"inArchive":true,"discoverable":true,"withdrawn":false,"lastModified":"2024-08-06T11:4