<tbody><tr>
<td style="width: 50%; border: 1px solid #6688AA; background-color: #FFE4C5; color: #000000; padding: 1em; text-align: justify;" class="plainlinks">
<div style="float: left; margin-left: 0.3em; margin-right: 0.7em;">
<p><span typeof="mw:File"><a href="/wiki/%D0%94%D0%B0%D1%82%D0%BE%D1%82%D0%B5%D0%BA%D0%B0:Otvorena_knjiga.JPG" class="mw-file-description"><img src="//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Otvorena_knjiga.JPG/250px-Otvorena_knjiga.JPG?utm_source=sr.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" width="130" height="98" class="mw-file-element" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Otvorena_knjiga.JPG/330px-Otvorena_knjiga.JPG?utm_source=sr.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="640" data-file-height="480" /></a></span>
</p>
</div>
<p><b><a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%9E_%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA%D1%83" title="Викизворник:О Викизворнику">Викизворник</a></b> је збирка текстова на српском језику којима су ауторска права истекла или нису ни постојала. Пре почетка рада обавезно прочитајте <a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%A1%D0%BC%D0%B5%D1%80%D0%BD%D0%B8%D1%86%D0%B5_%D0%B7%D0%B0_%D1%80%D0%B0%D0%B4" title="Викизворник:Смернице за рад">упутство</a>. Уколико желите да вежбате уређивање можете то радити у <a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%9F%D0%B5%D1%81%D0%B0%D0%BA" title="Викизворник:Песак">песку</a>.
</p>
</td>
<td rowspan="2" style="width: 50%; border: 1px solid #6688AA; background-color: #FFFFFF; color: #000000; padding: 1em; vertical-align: top;">
<div style="text-align: center; font-variant: small-caps; font-weight: bold; margin-bottom: 0.3em;">Индекс аутора</div>
<div style="text-align: center; width: 13em; margin:auto; font-family: Arial Unicode MS, Lucida Sans Unicode, sans-serif; font-size:120%; font-weight:bold;">
<p><a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%90" title="Викизворник:Аутори-А">А</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%91" title="Викизворник:Аутори-Б">Б</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%92" title="Викизворник:Аутори-В">В</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%93" title="Викизворник:Аутори-Г">Г</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%94" title="Викизворник:Аутори-Д">Д</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%82" title="Викизворник:Аутори-Ђ">Ђ</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%95" title="Викизворник:Аутори-Е">Е</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%96" title="Викизворник:Аутори-Ж">Ж</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%97" title="Викизворник:Аутори-З">З</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%98" title="Викизворник:Аутори-И">И</a><br />
<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%88" title="Викизворник:Аутори-Ј">Ј</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%9A" title="Викизворник:Аутори-К">К</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%9B" title="Викизворник:Аутори-Л">Л</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%89" title="Викизворник:Аутори-Љ">Љ</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%9C" title="Викизворник:Аутори-М">М</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%9D" title="Викизворник:Аутори-Н">Н</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%8A" title="Викизворник:Аутори-Њ">Њ</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%9E" title="Викизворник:Аутори-О">О</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%9F" title="Викизворник:Аутори-П">П</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A0" title="Викизворник:Аутори-Р">Р</a><br />
<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A1" title="Викизворник:Аутори-С">С</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A2" title="Викизворник:Аутори-Т">Т</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%8B" title="Викизворник:Аутори-Ћ">Ћ</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A3" title="Викизворник:Аутори-У">У</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A4" title="Викизворник:Аутори-Ф">Ф</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A5" title="Викизворник:Аутори-Х">Х</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A6" title="Викизворник:Аутори-Ц">Ц</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A7" title="Викизворник:Аутори-Ч">Ч</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%8F" title="Викизворник:Аутори-Џ">Џ</a>&#183;<a href="/wiki/%D0%92%D0%B8%D0%BA%D0%B8%D0%B7%D0%B2%D0%BE%D1%80%D0%BD%D0%B8%D0%BA:%D0%90%D1%83%D1%82%D0%BE%D1%80%D0%B8-%D0%A8" title="Викизворник:Аутори-Ш">Ш</a>
</p>
