  "docai_lines": [
    {
      "text": "210 БИОГРАФСКИ ПРИЛОЗИ НОВИЈОЈ ИСТОР. СРПСКОЈ\n",
      "bbox": [
        155,
        203,
        628,
        219
      ],
      "confidence": 0.9376992,
      "source": "lines"
    },
    {
      "text": "Годину проведе око Вишеграда и у самом Више-\n",
      "bbox": [
        207,
        251,
        683,
        274
      ],
      "confidence": 0.9781675,
      "source": "lines"
    },
    {
      "text": "граду на Дрини, товарећи, веле, грађу, дрвену и камену,\n",
      "bbox": [
        158,
        274,
        687,
        297
      ],
      "confidence": 0.9758973,
      "source": "lines"
    },
    {
      "text": "те од тога живљаше.\n",
      "bbox": [
        159,
        298,
        358,
        315
      ],
      "confidence": 0.9681444,
      "source": "lines"
    },
    {
      "text": "Тада већ бејаше плануо устанак у Шумадији. Јова,\n",
      "bbox": [
        208,
        315,
        686,
        339
      ],
      "confidence": 0.9673263,
      "source": "lines"
    },
    {
      "text": "сазнавши о свему, пређе Дрину, и, као што је познато,\n",
      "bbox": [
        158,
        336,
        686,
        359
      ],
      "confidence": 0.9736247,
      "source": "lines"
    },
    {
      "text": "прослави се нечувеним јунаштвом, које је лепо опевао\n",
      "bbox": [
        155,
        356,
        687,
        380
      ],
      "confidence": 0.9799449,
      "source": "lines"
    },
    {
      "text": "песник „Србијанке.\"\n",
      "bbox": [
        159,
        377,
        345,
        400
      ],
      "confidence": 0.9485847,
      "source": "lines"
    },
    {
      "text": "Анд. Гавриловић\n",
      "bbox": [
        484,
        425,
        642,
        447
      ],
      "confidence": 0.9768375,
      "source": "lines"
    },
