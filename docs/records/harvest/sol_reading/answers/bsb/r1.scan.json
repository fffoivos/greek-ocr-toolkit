  "commands": [
    "cat cards.jsonl",
    "python - <<'PY'\nimport json\nc=[json.loads(x) for x in open('cards.jsonl')]\nprint('COUNT',len(c))\nfor i,x in enumerate(c[:8]): print(i+1,x['card_id'],x['google_text'])\nPY",
    "mkdir -p zoom\npython - <<'PY'\nimport json,subprocess\nc=[json.loads(x) for x in open('cards.jsonl')]\nfor i,x in enumerate(c):\n subprocess.run(['magick',x['crop'],'-resize','200%',f'zoom/{i+1:03}.png'],check=True)\nPY",
