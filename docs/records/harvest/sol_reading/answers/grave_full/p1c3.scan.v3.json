  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json\nfrom PIL import Image,ImageDraw\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),10):\n rows=[]\n for i,it in enumerate(items[start:start+10],start):\n  w=Image.open(it['word_image']).convert('RGB'); l=Image.open(it['letter_image']).convert('RGB')\n  row=Image.new('RGB',(1000,max(145,w.height+25,l.height+25)),'white'); d=ImageDraw.Draw(row); d.text((5,5),str(i+1)+' '+it['item_id'],fill='black'); row.paste(w,(180,20)); row.paste(l,(700,20)); rows.append(row)\n sheet=Image.new('RGB',(1000,sum(r.height for r in rows)),'#cccccc'); y=0\n for r in rows: sheet.paste(r,(0,y)); y+=r.height\n sheet.save(f'zoom/batch{start//10+1}.png')\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),10):\n rows=[]\n for i,it in enumerate(items[start:start+10],start):\n  path=f'zoom/row{i+1}.png'\n  subprocess.run(['magick','-background','white','-fill','black','-font','Helvetica','-pointsize','16',f'label:{i+1} {it[\"item_id\"]}','-gravity','west','-extent','180x150','(',it['word_image'],'-gravity','west','-extent','500x150',')','(',it['letter_image'],'-gravity','west','-extent','300x150',')','+append',path],check=True)\n  rows.append(path)\n subprocess.run(['magick',*rows,'-append',f'zoom/batch{start//10+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),10):\n rows=[]\n for i,it in enumerate(items[start:start+10],start):\n  path=f'zoom/row{i+1}.png'\n  subprocess.run(['magick','-background','white','(',it['word_image'],'-gravity','west','-extent','500x160',')','(',it['letter_image'],'-gravity','west','-extent','300x160',')','+append','-bordercolor','#bbbbbb','-border','2',path],check=True)\n  rows.append(path)\n subprocess.run(['magick',*rows,'-append',f'zoom/batch{start//10+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),5):\n rows=[]\n for i,it in enumerate(items[start:start+5],start):\n  dims=[list(map(int,subprocess.check_output(['magick','identify','-format','%w %h',it[k]]).split())) for k in ['word_image','letter_image']]\n  h=max(160,*[d[1] for d in dims]); widths=[max(500,dims[0][0]),max(300,dims[1][0])]\n  path=f'zoom/row{i+1}.png'\n  subprocess.run(['magick','-background','white','(',it['word_image'],'-gravity','west','-extent',f'{widths[0]}x{h}',')','(',it['letter_image'],'-gravity','west','-extent',f'{widths[1]}x{h}',')','+append','-bordercolor','#bbbbbb','-border','2',path],check=True)\n  rows.append(path)\n subprocess.run(['magick',*rows,'-append',f'zoom/set{start//5+1}.png'],check=True)\n# First ten observations from word images.\na=['grave','grave','grave','acute','grave','grave','acute','acute','grave','grave']\nwith open('answers.jsonl','w') as f:\n for it,v in zip(items,a):f.write(json.dumps(dict(item_id=it['item_id'],accent=v,confidence='high',note=''))+'\\n')\nPY",
