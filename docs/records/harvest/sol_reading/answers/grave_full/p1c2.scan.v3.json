    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json\nfrom PIL import Image,ImageOps,ImageDraw\nitems=[json.loads(s) for s in open('items.jsonl')]\nfor start in range(0,len(items),10):\n sheet=Image.new('RGB',(1000, len(items[start:start+10])*210),'#eeeeee'); d=ImageDraw.Draw(sheet)\n for j,it in enumerate(items[start:start+10]):\n  y=j*210\n  d.text((8,y+5),f\"{start+j+1} {it['item_id']} {it['word_bare']} [{it['anchor_index']}]\",fill='black')\n  for k,key in enumerate(['word_image','letter_image']):\n   im=Image.open(it[key]).convert('RGB'); im.thumbnail((475,175))\n   sheet.paste(im,(8+k*500,y+30))\n sheet.save(f'zoom/batch{start//10+1}.png')\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json\nfrom PIL import Image,ImageDraw\nitems=[json.loads(s) for s in open('items.jsonl')]\nfor start in range(0,len(items),10):\n sheet=Image.new('RGB',(1000,len(items[start:start+10])*210),'#eeeeee'); d=ImageDraw.Draw(sheet)\n for j,it in enumerate(items[start:start+10]):\n  y=j*210\n  d.text((8,y+5),f\"{start+j+1} {it['item_id']} {it['word_bare']} [{it['anchor_index']}]\",fill='black')\n  for k,key in enumerate(['word_image','letter_image']):\n   im=Image.open(it[key]).convert('RGB'); im.thumbnail((475,175))\n   sheet.paste(im,(8+k*500,y+30))\n sheet.save(f'zoom/batch{start//10+1}.png')\nprint(len(items))\nPY",
