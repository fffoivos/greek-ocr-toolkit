    "python3 zoom/add.py 'g? g g g g c g g g g'",
    "python3 zoom/add.py 'g g g g g g g g g g'",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor i in [51,73,76,80]:\n subprocess.run(['magick',items[i-1]['letter_image'],'-filter','point','-resize','300%',f'zoom/detail{i}.png'],check=True)\nPY",
    "python3 zoom/add.py 'g g u? g g g? g g g a?'",
