          "command": "mkdir -p zoom\npython - <<'PY'\nimport json\nfrom PIL import Image,ImageDraw\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),10):\n rows=[]\n for i,t in enumerate(items[start:start+10],start+1):\n  w=Image.open(t['word_image']).convert('RGB'); l=Image.open(t['letter_image']).convert('RGB')\n  row=Image.new('RGB',(1000,max(160,w.height+30,l.height+30)),'white')\n  ImageDraw.Draw(row).text((5,5),f'{i} {t[\"item_id\"]} anchor {t[\"anchor_index\"]}',fill='black')\n  row.paste(w,(5,30));row.paste(l,(650,30));rows.append(row)\n sheet=Image.new('RGB',(1000,sum(r.height for r in rows)),'white'); y=0\n for r in rows:sheet.paste(r,(0,y));y+=r.height\n sheet.save(f'zoom/batch{start//10+1}.png')\nprint(len(items))\nPY",
