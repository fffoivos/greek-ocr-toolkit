  "exec_commands": 18,
  "commands": [
    "cat items.jsonl",
    "mkdir -p zoom\npython - <<'PY'\nimport json\nfrom PIL import Image,ImageDraw\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),10):\n rows=[]\n for i,t in enumerate(items[start:start+10],start+1):\n  w=Image.open(t['word_image']).convert('RGB'); l=Image.open(t['letter_image']).convert('RGB')\n  row=Image.new('RGB',(1000,max(160,w.height+30,l.height+30)),'white')\n  ImageDraw.Draw(row).text((5,5),f'{i} {t[\"item_id\"]} anchor {t[\"anchor_index\"]}',fill='black')\n  row.paste(w,(5,30));row.paste(l,(650,30));rows.append(row)\n sheet=Image.new('RGB',(1000,sum(r.height for r in rows)),'white'); y=0\n for r in rows:sheet.paste(r,(0,y));y+=r.height\n sheet.save(f'zoom/batch{start//10+1}.png')\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json\nfrom PIL import Image,ImageDraw\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),10):\n rows=[]\n for i,t in enumerate(items[start:start+10],start+1):\n  w=Image.open(t['word_image']).convert('RGB'); l=Image.open(t['letter_image']).convert('RGB')\n  row=Image.new('RGB',(1000,max(160,w.height+30,l.height+30)),'white')\n  ImageDraw.Draw(row).text((5,5),f'{i} {t[\"item_id\"]} anchor {t[\"anchor_index\"]}',fill='black')\n  row.paste(w,(5,30));row.paste(l,(650,30));rows.append(row)\n sheet=Image.new('RGB',(1000,sum(r.height for r in rows)),'white'); y=0\n for r in rows:sheet.paste(r,(0,y));y+=r.height\n sheet.save(f'zoom/batch{start//10+1}.png')\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),10):\n rows=[]\n for i,t in enumerate(items[start:start+10],start+1):\n  p=f'zoom/row{i}.png'; rows.append(p)\n  subprocess.run(['magick','(',t['word_image'],'-background','white','-gravity','west','-extent','630x220',')','(',t['letter_image'],'-background','white','-gravity','west','-extent','350x220',')','+append','-gravity','northwest','-background','white','-splice','0x22','-font','Helvetica','-pointsize','16','-annotate','+4+2',str(i)+' '+t['item_id'],p],check=True)\n subprocess.run(['magick',*rows,'-append',f'zoom/batch{start//10+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),5):\n rows=[]\n for i,t in enumerate(items[start:start+5],start+1):\n  p=f'zoom/row{i}.png'; rows.append(p)\n  subprocess.run(['magick','(',t['word_image'],'-background','white','-gravity','west','-extent','630x220',')','(',t['letter_image'],'-background','white','-gravity','west','-extent','350x220',')','+append','-bordercolor','#aaaaaa','-border','1',p],check=True)\n subprocess.run(['magick',*rows,'-append',f'zoom/batch{start//5+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess\nitems=[json.loads(x) for x in open('items.jsonl')]\nfor start in range(0,len(items),5):\n rows=[]\n for i,t in enumerate(items[start:start+5],start+1):\n  p=f'zoom/row{i}.png'; rows.append(p)\n  subprocess.run(['magick','(',t['word_image'],'-resize','630x280>','-background','white','-gravity','west','-extent','630x280',')','(',t['letter_image'],'-resize','350x280>','-background','white','-gravity','west','-extent','350x280',')','+append','-bordercolor','#aaaaaa','-border','1',p],check=True)\n subprocess.run(['magick',*rows,'-append',f'zoom/batch{start//5+1}.png'],check=True)\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(x) for x in open('items.jsonl')]\nlabels='grave acute grave acute grave grave grave grave grave grave'.split()\nwith open('answers.jsonl','w') as f:\n for t,a in zip(items,labels):f.write(json.dumps(dict(item_id=t['item_id'],accent=a,confidence='high',note=''))+'\\n')\nPY",
    "cat > zoom/add.py <<'PY'\nimport json,sys\nitems=[json.loads(x) for x in open('items.jsonl')]\na=[json.loads(x) for x in open('answers.jsonl')]\nfor label in sys.argv[1].split():\n accent={'g':'grave','a':'acute','c':'circumflex','n':'none','u':'unreadable'}[label.rstrip('?')]\n a.append(dict(item_id=items[len(a)]['item_id'],accent=accent,confidence='low' if label.endswith('?') else 'high',note=''))\nwith open('answers.jsonl','w') as f:\n for t in a:f.write(json.dumps(t)+'\\n')\nprint(len(a))\nPY\npython3 zoom/add.py 'g a g g a a g g g g'",
    "python3 zoom/add.py 'g g g a g g g g c g'",
    "python3 zoom/add.py 'g g g g n g g g g g'",
