  "commands": [
    "cat items.jsonl",
    "python - <<'PY'\nimport json,subprocess,os\nitems=[json.loads(l) for l in open('items.jsonl')]\nos.makedirs('zoom',exist_ok=True)\nfor start in range(0,len(items),5):\n rows=[]\n for n,x in enumerate(items[start:start+5],start+1):\n  out=f'zoom/row{n}.png'\n  subprocess.run(['magick','-background','white','-fill','black','-font','Helvetica','-pointsize','18','label:'+str(n)+' '+x['item_id'],x['word_image'],x['letter_image'],'+append',out],check=True)\n  rows.append(out)\n subprocess.run(['magick',*rows,'-background','white','-gravity','West','-append',f'zoom/batch{start//5+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess,os\nitems=[json.loads(l) for l in open('items.jsonl')]\nos.makedirs('zoom',exist_ok=True)\nfor start in range(0,len(items),5):\n rows=[]\n for n,x in enumerate(items[start:start+5],start+1):\n  out=f'zoom/row{n}.png'\n  subprocess.run(['magick','-background','white','-fill','black','-font','Helvetica','-pointsize','18','label:'+str(n)+' '+x['item_id'],x['word_image'],x['letter_image'],'+append',out],check=True)\n  rows.append(out)\n subprocess.run(['magick',*rows,'-background','white','-gravity','West','-append',f'zoom/batch{start//5+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json,subprocess,os\nitems=[json.loads(l) for l in open('items.jsonl')]\nos.makedirs('zoom',exist_ok=True)\nfor start in range(0,len(items),5):\n rows=[]\n for n,x in enumerate(items[start:start+5],start+1):\n  out=f'zoom/row{n}.png'\n  subprocess.run(['magick',x['word_image'],x['letter_image'],'-background','white','-gravity','Center','+append','-bordercolor','#cccccc','-border','4',out],check=True)\n  rows.append(out)\n subprocess.run(['magick',*rows,'-background','white','-gravity','West','-append',f'zoom/batch{start//5+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]\na=['grave']*7+['circumflex','grave','grave']\nwith open('answers.jsonl','w') as f:\n for x,v in zip(items,a): f.write(json.dumps(dict(item_id=x['item_id'],accent=v,confidence='high',note=''))+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; a=[json.loads(l) for l in open('answers.jsonl')]\nfor x,v in zip(items[len(a):],['grave','grave','grave','grave','grave','acute','grave','acute','acute','grave']): a.append(dict(item_id=x['item_id'],accent=v,confidence='high',note=''))\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; a=[json.loads(l) for l in open('answers.jsonl')]\nfor x,v in zip(items[len(a):],['grave','grave','grave','acute','grave','grave','grave','grave','grave','grave']): a.append(dict(item_id=x['item_id'],accent=v,confidence='high',note=''))\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; a=[json.loads(l) for l in open('answers.jsonl')]\nfor x,v in zip(items[len(a):],['grave','grave','grave','grave','acute','grave','grave','acute','grave','acute']): a.append(dict(item_id=x['item_id'],accent=v,confidence='high',note=''))\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]; a=[json.loads(l) for l in open('answers.jsonl')]\nfor x,v in zip(items[len(a):],['grave','grave','none','grave','grave','acute','grave','grave','acute','grave']): a.append(dict(item_id=x['item_id'],accent=v,confidence='high',note=''))\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json,collections\nitems=[json.loads(l) for l in open('items.jsonl')]; a=[json.loads(l) for l in open('answers.jsonl')]\nfor x,v in zip(items[len(a):],['acute','grave']):a.append(dict(item_id=x['item_id'],accent=v,confidence='high',note=''))\nwith open('answers.jsonl','w') as f:\n for x in a:f.write(json.dumps(x)+'\\n')\na=[json.loads(l) for l in open('answers.jsonl')]\nassert len(a)==len(items)\nassert [x['item_id'] for x in a]==[x['item_id'] for x in items]\nassert all(set(x)=={'item_id','accent','confidence','note'} and x['accent'] in ['acute','grave','circumflex','none','unreadable'] and x['confidence'] in ['high','low'] for x in a)\nprint('Verified count and order:',len(a))\nc=collections.Counter(x['accent'] for x in a)\nprint({v:c[v] for v in ['acute','grave','circumflex','none','unreadable']})\nPY"
