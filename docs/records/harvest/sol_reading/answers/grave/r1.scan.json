  "commands": [
    "cat items.jsonl",
    "python3 - <<'PY'\nimport json, subprocess, os\nitems=[json.loads(l) for l in open('items.jsonl')]\nos.makedirs('zoom',exist_ok=True)\nfor start in range(0,len(items),5):\n    rows=[]\n    for i,x in enumerate(items[start:start+5], start+1):\n        out=f'zoom/row{i}.png'\n        subprocess.run(['magick',x['word_image'],x['letter_image'],'+append','-background','white','-gravity','west','-splice','0x28','-font','Helvetica','-pointsize','18','-annotate','+0+3',str(i)+' '+x['word_bare'],out],check=True)\n        rows.append(out)\n    subprocess.run(['magick',*rows,'-background','white','-gravity','west','-append',f'zoom/batch{start//5+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json, subprocess, os\nitems=[json.loads(l) for l in open('items.jsonl')]\nos.makedirs('zoom',exist_ok=True)\nfor start in range(0,len(items),5):\n rows=[]\n for i,x in enumerate(items[start:start+5], start+1):\n  out=f'zoom/row{i}.png'\n  subprocess.run(['magick',x['word_image'],x['letter_image'],'+append','-background','white','-gravity','west','-splice','0x15',out],check=True)\n  rows.append(out)\n subprocess.run(['magick',*rows,'-background','white','-gravity','west','-append',f'zoom/batch{start//5+1}.png'],check=True)\nprint(len(items))\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]\na='grave grave acute acute acute acute circumflex grave grave acute grave grave acute acute none'.split()\nwith open('answers.jsonl','w') as f:\n for x,v in zip(items,a): f.write(json.dumps(dict(item_id=x['item_id'],accent=v,confidence='high',note=''))+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\nitems=[json.loads(l) for l in open('items.jsonl')]\na=[json.loads(l) for l in open('answers.jsonl')]\nvals='grave acute grave acute unreadable acute acute grave grave acute'.split()\nfor x,v in zip(items[len(a):],vals): a.append(dict(item_id=x['item_id'],accent=v,confidence='low' if v=='unreadable' else 'high',note='Short mark has unclear direction.' if v=='unreadable' else ''))\nopen('answers.jsonl','w').write(''.join(json.dumps(x)+'\\n' for x in a))\nPY",
