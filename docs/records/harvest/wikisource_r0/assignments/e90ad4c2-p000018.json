      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 18
    },
    {
      "alignment": "aligned",
      "human_label": "τόσο θερμὴ τοῦ Ἥλιου τὴ ματιά.",
