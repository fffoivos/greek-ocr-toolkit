      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "— Ὁ πάγος τῆς κορφῆς μου ἀκόμα δὲν ἀνάβει;",
