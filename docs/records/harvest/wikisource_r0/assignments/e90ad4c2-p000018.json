      "human_characters": 25
    },
    {
      "alignment": "aligned",
      "human_label": "ἡ εὐτυχία σου μὲ προβοδεῖ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "Γύρο μονάχα κῦμα καὶ παιχνίδι.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "Ὅ,τι βαρὺ εἴταν, ἔπεσε στὴν μπλάβη λησμονιά,—",
      "cer_docai_vs_human": 0.044444444444444446,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9565217391304348,
      "edit_distance": 2,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "ἀργὴ στέκεται τόρα ἡ βάρκα μου.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 31
    },
    {
      "alignment": "aligned",
      "human_label": "Φουρτούνα καὶ ταξίδι — πὼς τὸ ξέμαθε!",
      "cer_docai_vs_human": 0.05405405405405406,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9473684210526316,
      "edit_distance": 2,
      "human_characters": 37
    },
    {
      "alignment": "aligned",
      "human_label": "Πόθος κ’ ἐλπίδες πνίγηκαν,",
      "cer_docai_vs_human": 0.038461538461538464,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9615384615384616,
      "edit_distance": 1,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "ψυχὴ καὶ θάλασσα γυαλὶ εἶναι.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "Ἕβδομη μοναξιά!",
      "cer_docai_vs_human": 0.06666666666666667,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9375,
      "edit_distance": 1,
      "human_characters": 15
    },
    {
      "alignment": "aligned",
      "human_label": "Ποτές μου δὲν αἰστάνομουν τόσο κοντά μου",
      "cer_docai_vs_human": 0.0,
