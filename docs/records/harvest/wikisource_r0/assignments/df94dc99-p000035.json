    },
    {
      "alignment": "aligned",
      "human_label": "Κ’ ἔδειξας τῆς ἀθανάτου φύσεώς σου τὰ σημεῖα.",
      "cer_docai_vs_human": 0.022222222222222223,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9777777777777777,
      "edit_distance": 1,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Τοὺς κατά σου ἐπελθόντας φοβεροὺς καὶ λευγαλέους",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Δράκοντας ἀπῆγξας, ἆθλον κατορθοῦσα Ἠρακλέους.",
      "cer_docai_vs_human": 0.043478260869565216,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9565217391304348,
      "edit_distance": 2,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Περὶ σὲ τὰς πολλαπλᾶς των ἥπλωσαν, ὤ φρίκη! σπείρας·",
      "cer_docai_vs_human": 0.038461538461538464,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9615384615384616,
      "edit_distance": 2,
      "human_characters": 52
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀλλ’ ἐφάνησαν, θραυσθέντες ὑπὸ τὰς ἁβράς σου χεῖρας,",
      "cer_docai_vs_human": 0.057692307692307696,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9433962264150944,
      "edit_distance": 3,
      "human_characters": 52
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ ὁ δράκων τῆς Ἀσίας καὶ ὁ δράκων τῆς Αἰγύπτου.",
      "cer_docai_vs_human": 0.04081632653061224,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.96,
      "edit_distance": 2,
      "human_characters": 49
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀναπαύεις τὸ ἀνδρεῖον, πολυτραύματόν σου σῶμα.",
      "cer_docai_vs_human": 0.043478260869565216,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9574468085106383,
      "edit_distance": 2,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Τὴν βαθεῖαν μὴ ταράττων τοῦ πελάγους ἠρεμίαν",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀπαράλλακτα κοιμᾶται ὁ ἀὴρ εἰς νηνεμίαν.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 40
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀλλ’ οὐαί! ἂν ἐκ τοῦ ὕπνου τοῦ μακροῦ του ἀνακύψῃ.",
      "cer_docai_vs_human": 0.1,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9038461538461539,
      "edit_distance": 5,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Τρομερώτερον στοιχεῖον δὲν γνωρίζω· εἰς τὰ ὕψη",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ μὲ κύματα σκεπάζει τὰ πολύφλοισβα πελάγη.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Ἡρακλέους μεγαθύμου ῥόπαλον, ὦ Ἕλλην, δράττε,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ μὲ στιβαρὸν τὸν πόδα, καὶ ἀτρόμητον τὴν χεῖρα,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        18
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Τραῦμα ἔνεγκε θανάτου εἰς τὸν αἱμοβόρον θῆρα.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Ἂς ἐμέσῃ πίπτων ὅσον ἔπιεν ἀθώων αἷμα!",
      "cer_docai_vs_human": 0.02631578947368421,
      "human_line_indices": [
        20
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9743589743589743,
      "edit_distance": 1,
      "human_characters": 38
    },
    {
      "alignment": "aligned",
      "human_label": "Σὺ δ’ ἐνδὺς τὴν λεοντῆν του καὶ ἀναλαβὼν τὸ στέμμα",
      "cer_docai_vs_human": 0.02,
      "human_line_indices": [
        21
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.98,
      "edit_distance": 1,
      "human_characters": 50
    },
