  "assignments": [
    {
      "alignment": "aligned",
      "human_label": "λυγίζει τὸ λαιμὸ γιὰ χλεύη πάντα καθαρότερη—",
      "cer_docai_vs_human": 0.045454545454545456,
      "human_line_indices": [
        0
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9555555555555556,
      "edit_distance": 2,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "ἀπὸ ἀνυπομονησία ἕνα φίδι ἀνορθωμένο·",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 37
    },
    {
      "alignment": "aligned",
      "human_label": "αὐτὸ τὸ σῆμα ἐγὼ στήλωσα ἐμπρός μου.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 36
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐτούτη ἡ φλόγα ἡ ἴδια μου ἡ ψυχὴ εἶναι·",
      "cer_docai_vs_human": 0.02564102564102564,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9743589743589743,
      "edit_distance": 1,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "ἀχόρταστη γιὰ νέα ἀπόμακρα",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "ἀπάνου, ἀπάνου ξεχειλᾶ τὸ ἥσυχο της φέγγος.",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9767441860465116,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Ὁ Ζαρατούστρας τί ἔφευγε μπρὸς σὲ θεριὰ κι ἀνθρώπους;",
      "cer_docai_vs_human": 0.018867924528301886,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9814814814814815,
      "edit_distance": 1,
      "human_characters": 53
    },
    {
      "alignment": "aligned",
      "human_label": "Τί ξάφνου ἐλιποτάχτησεν ἀπ’ ὅλες τὶς στεριές;",
      "cer_docai_vs_human": 0.044444444444444446,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9565217391304348,
      "edit_distance": 2,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "ὣς τόρα ἕξη μοναξιὲς γνωρίζει,—",
      "cer_docai_vs_human": 0.06451612903225806,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9375,
      "edit_distance": 2,
      "human_characters": 31
    },
    {
      "alignment": "aligned",
      "human_label": "μὰ ἡ ἴδια ἡ θάλασσα ἀρκετὰ δὲν τοῦ εἴταν ἔρημη,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 47
    },
    {
      "alignment": "aligned",
      "human_label": "τὸν ἄφισε νἀνέβει τὸ νησί,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "ἀπάνου στὸ βουνὸ φωτιὰ νἀνάψει,",
      "cer_docai_vs_human": 0.03225806451612903,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.967741935483871,
      "edit_distance": 1,
      "human_characters": 31
    },
    {
      "alignment": "aligned",
      "human_label": "σὲ μιὰν ἕβδομη μοναξιά",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 22
    },
    {
      "alignment": "aligned",
      "human_label": "ρίχνει τὸ ἀγκίστρι του ψηλὰ ζητῶντας τόρα.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Καράβια πλανημένα! Χάρβαλα ἀστεριῶν παλιῶν!",
      "cer_docai_vs_human": 0.046511627906976744,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9555555555555556,
      "edit_distance": 2,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Σεῖς θάλασσες τοῦ μέλλοντος! Οὐράνια ἀνεξερεύνητα!",
      "cer_docai_vs_human": 0.04,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9615384615384616,
      "edit_distance": 2,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "σὅλους τοὺς μοναχοὺς ἐγὼ, τόρα τὸ ἀγκίστρι ρίχνω·",
      "cer_docai_vs_human": 0.02040816326530612,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9795918367346939,
      "edit_distance": 1,
      "human_characters": 49
    },
    {
      "alignment": "aligned",
      "human_label": "ὤ, στὴν ἀνυπομονησία τῆς φλόγας ἀπαντεῖστε,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "συλλάβετέ μου, τοῦ ψαρρᾶ στὰ ψηλὰ βουνὰ ἀπάνου,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
