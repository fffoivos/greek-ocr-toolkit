    },
    {
      "alignment": "aligned",
      "human_label": "Τὸ δῶρον τὸ θεόσδοτον πρὸς εὐγενῇ ἂς στρέψῃ",
      "cer_docai_vs_human": 0.046511627906976744,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9534883720930233,
      "edit_distance": 2,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Σκοπὸν, ἂν θέρος ἄφθονον δαφνῶν ποθῇ νὰ δρέψῃ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Εἰς τὴν πατρίδα χρεωστεῖ τὴν λύραν· ἡ μεγάλη",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Καρδία του ὑπὲρ αὐτῆς νυχθημερὸν ἂς πάλλῃ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Οὕτω διττῶς ἀθάνατος διττὸν ἔχει τὸ γέρας",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Δόξης ὁμοῦ καὶ ἀρετῆς. Πολλάκις γλυκυτέρας",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ θειοτέρας ἡ Πατρὶς έμπνέει μελῳδίας",
      "cer_docai_vs_human": 0.05128205128205128,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9487179487179487,
      "edit_distance": 2,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "Παρὰ τὴν κόμην τῆς καλῆς Κυνθίας ἢ Λυδίας.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Μισῶ τὸν χαῦνον ἀοιδὸν, εἰς πόδας ὅστις ἕρπει",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Τυράννων, καὶ τὰ πάθη των καὶ τὴν ἀργίαν τέρπει.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Ἡ βάρβιτος τοῦ εὐγενοῦς πατρὸς ἡμῶν Φεραίου",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐβράχη μὲ τὸ αἷμα του· καὶ σήμερον Τυρταίου",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9767441860465116,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀνάγκην ἔχει ἡ Ἑλλὰς, τὸν λήθαργον νὰ λύσῃ",
      "cer_docai_vs_human": 0.023809523809523808,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9761904761904762,
      "edit_distance": 1,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Τῶν τέκνων, καὶ εὐγενοῦς θυμοῦ νὰ τὰ ἐμπλήσῃ",
      "cer_docai_vs_human": 0.13636363636363635,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.8775510204081632,
      "edit_distance": 6,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Ἰδοὺ τετράκις ἑκατὸν ὁ δίφρος τοῦ ἡλίου",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "Κύκλους πληροῖ, κ’ ἡ ἀποφρὰς ἡμέρα τοῦ Μαΐου",
      "cer_docai_vs_human": 0.045454545454545456,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9545454545454546,
      "edit_distance": 2,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Τετράκις ἐπανέκαμψεν, ἡ τὴν φρικτὴν τοῦ Γένους",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Πτῶσιν ἰδοῦσα καὶ δεινπων χειμῶνας ἀρχομένους.",
      "cer_docai_vs_human": 0.13043478260869565,
      "human_line_indices": [
        18
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.8775510204081632,
      "edit_distance": 6,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Ὤ λύσσα! ὤ ἐκδίκησις γλυκεῖα! ὤ παρθένος",
      "cer_docai_vs_human": 0.075,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.925,
      "edit_distance": 3,
      "human_characters": 40
    },
    {
      "alignment": "aligned",
      "human_label": "Νέμεσις, ἡ ᾀεὶ βαρὺ ὑπὸ τὰ στήθη μένος",
      "cer_docai_vs_human": 0.02631578947368421,
      "human_line_indices": [
        20
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9736842105263158,
      "edit_distance": 1,
      "human_characters": 38
    },
    {
      "alignment": "aligned",
      "human_label": "Φέρουσα, δυσπαραίτητε, ἐλθὲ, ὦ Ῥαμνουσία!",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        21
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Εἶναι καιρός· καὶ ἄλλοτε σ’ ἐγνώρισ’ ἡ Ἀσία,",
      "cer_docai_vs_human": 0.09090909090909091,
      "human_line_indices": [
        22
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9111111111111111,
      "edit_distance": 4,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Ὁ πότε διὰ τῆς τριπλῆς τοῦ Ἀλεξάνδρου νίκης",
      "cer_docai_vs_human": 0.046511627906976744,
      "human_line_indices": [
        23
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9545454545454546,
      "edit_distance": 2,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Τὰς ὕβρεις ὅλας τῆς μητρὸς Ἑλλάδος ἐξεδίκεις.",
