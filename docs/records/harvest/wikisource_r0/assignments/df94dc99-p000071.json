    {
      "alignment": "aligned",
      "human_label": "Ἔχεις ἢ τῆς Σαλαμῖνος τὰς γλαυκώφρυδας ἀκτὰς,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ ἐκεῖθεν ὡς ὁ Φοῖβος κατὰ πρῶτον ἀνατείλας,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Μὲ ἀκτῖνας εἰς γενναῖα στήθη λάμπεις ἐφικτὰς,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Κ’ εἰς ἐμὲ χρυσοῦν ἓν βέλος πέμψον, ὦ θεά, φωτός σου,",
      "cer_docai_vs_human": 0.05660377358490566,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9433962264150944,
      "edit_distance": 3,
      "human_characters": 53
    },
    {
      "alignment": "aligned",
      "human_label": "Κ’ εἰς ἀνάξιον δὲν θέλει πέσει στῆθος, βεβαιώσου.",
      "cer_docai_vs_human": 0.02040816326530612,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9795918367346939,
      "edit_distance": 1,
      "human_characters": 49
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Τὴν Ἑλλάδα τῆς ὁποίας τὸ ἐλεύθερον μισεῖ·",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Ἡ ἐλπὶς τοῦ κόσμου εἶχεν εἰς ὀλίγων χεῖρας μείνει,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Ὅμως μετὰ τῶν ὀλίγων τούτων συνεμάζεις Σὺ,",
      "cer_docai_vs_human": 0.023809523809523808,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9761904761904762,
      "edit_distance": 1,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ τὸ κομητολαμπές σου, κομητόμηκές σου ξίφος",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐξωλόθρευσε μυρίων μυριάδων ἐχθρῶν στίφος.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸ ἀῤῥενωπόν σου κάλλος πόῤῥω κεῖται τῆς τρυφῆς.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸ μεσόφρυόν σου εἶναι θρόνος φόβου καὶ ἐλπίδος,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Οὐρανὸς γαληνιαῖος ἐναλλὰξ καὶ συννεφής.",
      "cer_docai_vs_human": 0.025,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.975,
      "edit_distance": 1,
      "human_characters": 40
    },
    {
      "alignment": "aligned",
      "human_label": "Κτείνεις ἐνταυτῷ καὶ σώζεις, ἐπειδὴ ὑπάρχεις μία",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Κ’ ἡ αὐτὴ τυράννων μάστιξ καὶ λαῶν παραμυθία.",
