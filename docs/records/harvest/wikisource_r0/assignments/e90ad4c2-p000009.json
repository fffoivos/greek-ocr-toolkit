  "assignments": [
    {
      "alignment": "aligned",
      "human_label": "Ποιὸς εἶναι, μου πατέρας, μάνα;",
      "cer_docai_vs_human": 0.06451612903225806,
      "human_line_indices": [
        0
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.935483870967742,
      "edit_distance": 2,
      "human_characters": 31
    },
    {
      "alignment": "aligned",
      "human_label": "Ὁ πρίγκηπας ὁ γεμιστὸς δὲν εἶναι μου πατέρας",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "καὶ τὸ ἥσυχο χαμόγελο μητέρα;",
      "cer_docai_vs_human": 0.034482758620689655,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9666666666666667,
      "edit_distance": 1,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸ συνοικέσιο αὐτῶν τῶν δυὸ δὲ γέννησεν ἐμένα,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "τὸ αἰνιγματόζωον ἐμένα,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 23
    },
    {
      "alignment": "aligned",
      "human_label": "τοῦ φωτὸς τὸ ζιζάνιον ἐμένα,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 28
    },
    {
      "alignment": "aligned",
      "human_label": "κάθε σοφίας τὸν ἄσωτον ἐμένα Ζαρατούστρα;",
      "cer_docai_vs_human": 0.024390243902439025,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9761904761904762,
      "edit_distance": 1,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Ἄρρωστο σήμερα ἀπὸ τρυφεράδα,",
      "cer_docai_vs_human": 0.034482758620689655,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9655172413793104,
      "edit_distance": 1,
      "human_characters": 29
    },
    {
