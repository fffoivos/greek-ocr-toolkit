    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ σήμερον τὸ καύχημα, τὸ θαῦμα τῆς Εὐρώπης!",
      "cer_docai_vs_human": 0.044444444444444446,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9565217391304348,
      "edit_distance": 2,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Ὦ Δύσις, τώρ’ ἀμβλυωπεῖς, ἢ τότε ἠμβλυώπεις;",
      "cer_docai_vs_human": 0.022727272727272728,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9772727272727273,
      "edit_distance": 1,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Τίς Ἀλχημεία ἤλλαξε, τίς τέχνη, φίλτρον ποῖον,",
      "cer_docai_vs_human": 0.043478260869565216,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9574468085106383,
      "edit_distance": 2,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸ μέταλλον τὸ εὐτελὲς εἰς καθαρὸν χρυσίον;",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Ὦ ἄξιαι ἱστορικοῦ Χριστιανοῦ εἰκόνες,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 37
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ ἄξια τῆς λύρας σου ὀνόματα τυράννων,",
      "cer_docai_vs_human": 0.025,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.975,
      "edit_distance": 1,
      "human_characters": 40
    },
    {
      "alignment": "aligned",
      "human_label": "Τῶν Βαϊαζὴτ καὶ τῶν Μουρὰτ, Σελὶμ καὶ Σολιμάνων!",
      "cer_docai_vs_human": 0.041666666666666664,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9591836734693877,
      "edit_distance": 2,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ τοῦ Μωάμεθ πορθητοῦ ἡ ἀπηνὴς ἀνδρία·",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 40
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ ἡ μακρὰ τῆς δυστυχοῦς Εὐρώπης ἀγωνία·",
      "cer_docai_vs_human": 0.024390243902439025,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.975609756097561,
      "edit_distance": 1,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ τὸ Βυζάντιον τμηθὲν τῆς χώρας του, κ’ ἀκόμα",
      "cer_docai_vs_human": 0.02127659574468085,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9787234042553191,
      "edit_distance": 1,
      "human_characters": 47
    },
    {
      "alignment": "aligned",
      "human_label": "Παλαῖον ὡς τὸ κολοβὸν τοῦ Κυναιγείρου σῶμα,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Ἕως οὗ τέλος, ὢ κλαυθμὸς καὶ τῶν Ἀγγέλων λύπη!",
      "cer_docai_vs_human": 0.08695652173913043,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9166666666666666,
      "edit_distance": 4,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Εἰς τῆς Σελήνης τὴν σκιὰν ὅλ’ ἡ Ἑλλὰς ἐκλείπει.",
      "cer_docai_vs_human": 0.02127659574468085,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9787234042553191,
      "edit_distance": 1,
      "human_characters": 47
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Τῶν χρονικῶν σου ζήτησε ἐδῶ, σοφὲ, τὴν ὕλην.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐδῶ αἱ πηγαὶ σώζονται, ἐδῶ τὰ φρικαλέα",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 38
    },
    {
      "alignment": "aligned",
      "human_label": "Τῆς τυραννίας πρακτικὰ καὶ παλαιὰ καὶ νέα.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        18
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Δύνασαι τόμους ἑκατὸν μεγάλους νὰ γεμίσῃς·",
      "cer_docai_vs_human": 0.047619047619047616,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9523809523809523,
      "edit_distance": 2,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸ θέρος εἶναι ἄφθονον, πυκναὶ αἱ ἀναμνήσεις.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        20
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Δὲν εἰν’ ὀλίγ’ αἱ γενεαὶ, κ’ εὐάριθμα τὰ ἔτη.",
      "cer_docai_vs_human": 0.08888888888888889,
      "human_line_indices": [
        21
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9111111111111111,
      "edit_distance": 4,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Πρὸς μείζονα δὲ τοῦ Κοινοῦ ψυχαγωγίαν ἔτι,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        22
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Τοὺς τόμους ὅλους στόλισε μὲ φοβερὰς εἰκόνας,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        23
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Τοὺς σκόλοπας, τὰς κρεουργοὺς ἁρπάγας, τὰς ἀγχόνας,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        24
      ],
      "alignment_reason": "one_to_one",
