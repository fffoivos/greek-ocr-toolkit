    },
    {
      "alignment": "aligned",
      "human_label": "ΚΟΡΑΗΣ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 7
    },
    {
      "alignment": "aligned",
      "human_label": "Παύσατε, μὰ τῆς Ἑλλάδος τὴν ἀνάστασιν, ὦ φίλοι!",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 47
    },
    {
      "alignment": "aligned",
      "human_label": "Λόγοι μίσους δὲν ἁρμόζουν εἰς ἀνδρῶν τοιούτων χείλη.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 52
    },
    {
      "alignment": "aligned",
      "human_label": "Πλὴν τίς ἔρχεται; νομίζω ὁ Ἑρμῆς· τὸν διακρίνω",
      "cer_docai_vs_human": 0.021739130434782608,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9787234042553191,
      "edit_distance": 1,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀπὸ τὸ δεκάπηχύ του τὸ κηρύκειον ἐκεῖνο.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 40
    },
    {
      "alignment": "aligned",
      "human_label": "ΕΡΜΗΣ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 6
    },
    {
      "alignment": "aligned",
      "human_label": "Τὴν στιγμὴν, ὦ ἄνδρες, ταύτην ἐπιστρέφω ἐκ τῶν ζώντων",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 53
    },
    {
      "alignment": "aligned",
      "human_label": "Τὰς ψυχάς τινων κομίζων νεωστὶ ἀποθανόντων.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "ΚΟΡΑΗΣ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 7
    },
    {
      "alignment": "aligned",
      "human_label": "Σὺ τὸν κόσμον ὅστις ὅλον καθ’ ἑκάστην περιτρέχεις,",
      "cer_docai_vs_human": 0.02,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.98,
      "edit_distance": 1,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐκ τῆς φίλης μου Ἑλλάδος, ὦ Ἑρμῆ, τί νέα ἔχεις;",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 47
    },
    {
      "alignment": "aligned",
      "human_label": "ΕΡΜΗΣ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 6
    },
    {
      "alignment": "aligned",
      "human_label": "Ἡ Ἑλλάς σου, ἂν ὡς τώρα ἤθελες, ὦ γέρον, ζήσει,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 47
    },
    {
      "alignment": "aligned",
      "human_label": "Οὐδὲ Ἕλληνα πολίτην δὲν σὲ ἤθελε γνωρίσει.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
