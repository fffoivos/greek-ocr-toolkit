      "alignment_similarity": 0.9111111111111111
    },
    {
      "alignment": "aligned",
      "human_label": "Ὤ! εἴθε ἡ ἀθώα σου νὰ φθάσῃ θρηνῳδία",
      "cer_docai_vs_human": 0.05555555555555555,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9444444444444444,
      "edit_distance": 2,
      "human_characters": 36
    },
    {
      "alignment": "aligned",
      "human_label": "Εἰς οὐρανὸν ὡς καθαροῦ λιβάνου εὐωδία,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 38
    },
    {
      "alignment": "aligned",
      "human_label": "Ἑλισσομένη ἄνωθεν τοῦ θυμιατηρίου!",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 34
    },
    {
      "alignment": "aligned",
      "human_label": "Εἴθε κατέλθοι ἐπὶ σὲ ἡ χάρις τοῦ Κυρίου!",
      "cer_docai_vs_human": 0.025,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.975609756097561,
      "edit_distance": 1,
      "human_characters": 40
    },
    {
