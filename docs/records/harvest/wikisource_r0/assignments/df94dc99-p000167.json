    },
    {
      "alignment": "aligned",
      "human_label": "Ἐν οἷς μετὰ τῶν θρήνων μου πολλάκις ἑνουμένη",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Ἡ λιγυρὰ ὑμῶν φωνὴ τῆς ἀτυχοῦς ἀρχίζει",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        20
