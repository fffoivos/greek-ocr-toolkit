    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ τὰς ματαίας κ’ ἐπαχθεῖς τιμὰς τοσούτου κόσμου,",
      "cer_docai_vs_human": 0.02,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.98,
      "edit_distance": 1,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Ἔρχομ’ ἐδῶ, ἐνώπιον τοῦ Πλάστου ταπεινοῦμαι,",
      "cer_docai_vs_human": 0.022727272727272728,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9772727272727273,
      "edit_distance": 1,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ ἄγνωστος καὶ ἀφανὴς νὰ ἦμ’ εὐχαριστοῦμαι.",
      "cer_docai_vs_human": 0.022222222222222223,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9777777777777777,
      "edit_distance": 1,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸ γένος των ἀπόκρυφον εἰς πάντα Πέρσην μένει.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Θὰ τὰς φωνάξω. Ἔλθετε ἁγνόταται παρθένοι,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Τῆς δουλικῆς μου ἄλλοτε δαιτὸς συνδαιτυμόνες,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Τῆς γενεᾶς τοῦ Ἰακὼβ βλαστήματα καὶ κλῶνες!",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9772727272727273,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "ΕΛΙΣΑΒΕΤ.",
      "cer_docai_vs_human": 0.1111111111111111,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.8888888888888888,
      "edit_distance": 1,
      "human_characters": 9
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Ἁπανταχόθεν κύκλω μου προκύπτουσιν ἀθρόον!",
      "cer_docai_vs_human": 0.023809523809523808,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9761904761904762,
      "edit_distance": 1,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Ποῖον ἐρύθημα αἰδοῦς ἐπὶ τὰ πρόσωπά των!",
      "cer_docai_vs_human": 0.025,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.975609756097561,
      "edit_distance": 1,
      "human_characters": 40
    },
    {
