    },
    {
      "alignment": "aligned",
      "human_label": "Τὸν θάνατόν του μελετῶν τὸν ἔνδοξον ὁ ἥρως",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Βότσαρις πίστιν χορηγεῖ εὐμάρτυρον, καὶ κῦρος",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Νέον εἰς τόν Θερμοπυλῶν τὸν μέγαν Σπαρτιάτην,",
      "cer_docai_vs_human": 0.022222222222222223,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9777777777777777,
      "edit_distance": 1,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Κατὰ τὴν τουρκολέτειραν πορείαν νυκτιβάτιν.",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9767441860465116,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Ἤδη ἐπῆλθ’ ἀναπνοὴ τῶν πόνων καὶ εἰρήνη",
      "cer_docai_vs_human": 0.02564102564102564,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9743589743589743,
      "edit_distance": 1,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "Βραχεῖα· πολὺ ἔγεινε, πολὺ μένει νὰ γείνῃ.",
      "cer_docai_vs_human": 0.023809523809523808,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9761904761904762,
      "edit_distance": 1,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Ἂς δρέψωμεν εἰς τῆς ζωῆς ἓν ῥόδον τὸν λειμῶνα.",
      "cer_docai_vs_human": 0.021739130434782608,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9782608695652174,
      "edit_distance": 1,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Αὔριον, τίς με βεβαιοῖ; ἴσως βαρὺν χειμῶνα",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐγείρῃ Ἄρης κρατερός· μικρὸν καὶ εἰς τὰς Μούσας",
      "cer_docai_vs_human": 0.06382978723404255,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9375,
      "edit_distance": 3,
      "human_characters": 47
    },
    {
      "alignment": "aligned",
      "human_label": "Ἂς δώσωμεν. Ἰδού, ἰδοὺ τὰς βλέπω συγκροτούσας",
      "cer_docai_vs_human": 0.044444444444444446,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9555555555555556,
      "edit_distance": 2,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Χορὸν περὶ τὸ ἱερὸν τῆς Κασταλίας νᾶμα,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸν μέγιστον πατέρ’ ἀνδρῶν, θεῶν, ὑμνούσας ἅμα.",
      "cer_docai_vs_human": 0.02127659574468085,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9787234042553191,
      "edit_distance": 1,
      "human_characters": 47
    },
    {
      "alignment": "unaligned",
      "human_label": null,
      "cer_docai_vs_human": null,
      "human_line_indices": [],
      "alignment_reason": "no_one_to_one_match",
      "alignment_similarity": null
    },
    {
      "alignment": "aligned",
      "human_label": "Τὴν δέησιν προσδέχθητε τοῦ εὐφυοῦς Λεάνδρου.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Πάλαι ἰχνηλατεῖ ποθῶν, δεινοπαθῶν καὶ κλαίων,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Δύσερως ὥς τις ἐραστὴς, πλησίον τῶν ἀρχαίων",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Ἑδρῶν σας, καὶ τὴν δάφνινον τοῦ Ἡσιόδου ῥάβδον",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Ζητεῖ στενάζων μεταξὺ τῶν βράχων τῶν ἀναύδων.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        18
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Ποῖοι ἐλάλησαν αὐλοὶ καὶ ἀηδόνων γλῶσσαι;",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Αἱ Μοῦσαι ἀνταπήντησαν ἡρέμα μειδιῶσαι.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        20
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "«Ἐκεῖνοι ἦσαν ἀοιδοὶ θεοφιλεῖς, τὸν τρόπον",
      "cer_docai_vs_human": 0.023809523809523808,
      "human_line_indices": [
        21
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9767441860465116,
      "edit_distance": 1,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Αἰδοῖοι, φίλοι τοῦ Διὸς καὶ τῶν θνητῶν ἀνθρώπων.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        22
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Νήπιος ὅστις πρὸς αὐτοὺς ἐξ ἴσου ἁμιλλᾶται·",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        23
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9767441860465116,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Πλειότερον τοῦ δυστυχοῦς Ἰξίονος πλανᾶται.",
      "cer_docai_vs_human": 0.023809523809523808,
      "human_line_indices": [
        24
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9761904761904762,
      "edit_distance": 1,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Τῆς φύσεως πρωτογενοῦς, τῶν καλλονῶν τῶν τόσων",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        25
      ],
