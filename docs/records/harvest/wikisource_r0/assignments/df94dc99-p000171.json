    },
    {
      "alignment": "aligned",
      "human_label": "ΚΟΡΑΗΣ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        0
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 7
    },
    {
      "alignment": "aligned",
      "human_label": "Τίνες οὗτοι; ποίαν βίαν; σὲ παρακαλῶ εἰπέ με,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ ἀπὸ τὰς δεινοτάτας ἀπορίας ἔκβαλέ με.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Μήπως τῶν εὐγενεστάτων Φαναριωτῶν αἱ χεῖρες;",
      "cer_docai_vs_human": 0.022727272727272728,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9777777777777777,
      "edit_distance": 1,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "ΣΩΚΡΑΤΗΣ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 9
    },
    {
      "alignment": "aligned",
      "human_label": "Οἱ κατάρατοι ἢ μήπως σοφισταὶ, οἱ ὀλετῆρες;",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9767441860465116,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "ΔΙΟΓΕΝΗΣ.",
      "cer_docai_vs_human": 0.1111111111111111,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9,
      "edit_distance": 1,
      "human_characters": 9
    },
    {
      "alignment": "aligned",
      "human_label": "Νὰ σὲ εἴπω ἕνα λόγον, ὦ Ἑρμῆ, μὲ παῤῥησίαν;",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9772727272727273,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Συνετάραξας, ὡς ἦλθες, τῶν ἀνδρῶν τὴν ἡσυχίαν.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Πόσον εἶσαι σπερμολόγος! κάλλιον μὴν εἶχες ἔλθει!",
      "cer_docai_vs_human": 0.061224489795918366,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9411764705882353,
      "edit_distance": 3,
      "human_characters": 49
    },
    {
      "alignment": "aligned",
      "human_label": "ΕΡΜΗΣ.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 6
    },
    {
      "alignment": "aligned",
      "human_label": "Ὁ ἀγὼν, δὲν ἀμφιβάλλω, σοφοὶ ἄνδρες, σᾶς ἠγγέλθη,",
      "cer_docai_vs_human": 0.02040816326530612,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9795918367346939,
      "edit_distance": 1,
      "human_characters": 49
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸν ὁποῖον ἠγωνίσθη ἡ πατρὶς ὑμῶν προσφάτως,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Καταλύσασα τῶν γαύρων Παυαρῶν τὸ ξένον κράτος.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Συνελθοῦσα εἰς Ἀθήνας ἤδη τῶν Ἀντιπροσώπων",
      "cer_docai_vs_human": 0.09523809523809523,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9090909090909091,
      "edit_distance": 4,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Ἡ Βουλὴ χαράττ’ ὑπ’ ὄψιν τῶν Θεῶν καὶ τῶν ἀνθρώπων,",
      "cer_docai_vs_human": 0.0784313725490196,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9215686274509804,
      "edit_distance": 4,
      "human_characters": 51
    },
    {
      "alignment": "aligned",
      "human_label": "Τοὺς θεσμοὺς τῆς τῶν Ἑλλήνων ἐλευθέρας πολιτείας,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 49
    },
    {
      "alignment": "aligned",
      "human_label": "Πολιτείας ἰσονόμου καὶ πρὸς ἅπαντας ὁμοίας.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀπὸ τὰς Ἀθήνας ὅμως πρὸ ὀλίγου διαβαίνων,",
      "cer_docai_vs_human": 0.04878048780487805,
      "human_line_indices": [
        18
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9523809523809523,
      "edit_distance": 2,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ βοὴν πολλὴν ἀκούσας ὡς ἀνθρώπων μαχομένων,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Διευθύνθην πρὸς τὸ μέρος, κ’ ἔνδον τοῦ βουλευτηρίου",
      "cer_docai_vs_human": 0.0196078431372549,
      "human_line_indices": [
        20
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9803921568627451,
      "edit_distance": 1,
      "human_characters": 51
    },
    {
      "alignment": "aligned",
      "human_label": "Ἄνδρας εἶδον μετὰ ζήλου κ’ ἐνθουσιασμοῦ ἀγρίου,",
      "cer_docai_vs_human": 0.02127659574468085,
      "human_line_indices": [
        21
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9787234042553191,
      "edit_distance": 1,
      "human_characters": 47
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐμμανῶς βοῶντας, πόδας, χεῖρας, χείλη παταγοῦντας,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        22
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ τὴν μίαν τῶν Ἑλλήνων φυλὴν δίχα διαιροῦντας,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        23
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
