    {
      "alignment": "aligned",
      "human_label": "μὲ ἀγάπη, μὲ κακία, σὰν κορασιοῦ ματιά…",
      "cer_docai_vs_human": 0.07692307692307693,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.926829268292683,
      "edit_distance": 3,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐμάντευε τὸ βάθος της εὐτυχίας μου,",
      "cer_docai_vs_human": 0.02857142857142857,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9714285714285714,
      "edit_distance": 1,
      "human_characters": 35
    },
    {
      "alignment": "aligned",
      "human_label": "ἐμένα ἐμάντευεν — ἄ! τί ἐφευρίσκει;—",
      "cer_docai_vs_human": 0.1388888888888889,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.8717948717948718,
      "edit_distance": 5,
      "human_characters": 36
    },
    {
      "alignment": "aligned",
      "human_label": "Πορφυρένιος ἕνας δράκοντας κατασκοπεύει",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "στὴν ἄβυσσο τῆς κορασίσιας τῆς ματιᾶς της.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "unaligned",
