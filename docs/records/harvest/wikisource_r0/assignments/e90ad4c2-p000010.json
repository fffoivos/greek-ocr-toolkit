      ],
      "alignment_reason": "split_or_merged_lines",
      "alignment_similarity": 0.8709677419354839
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀλλοίμονό σου, ὦ Ζαρατούστρα!",
      "cer_docai_vs_human": 0.10344827586206896,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9032258064516129,
      "edit_distance": 3,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "Μοιάζεις σὰν ἕνας,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 18
    },
    {
      "alignment": "aligned",
      "human_label": "χρυσάφι ποὺ κατάπιε·",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 20
    },
    {
      "alignment": "aligned",
      "human_label": "θὰ σοῦ ξεσκίσουν, θὰ σου ἀνοίξουν τὴν κοιλιά!…",
      "cer_docai_vs_human": 0.10869565217391304,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.8979591836734694,
      "edit_distance": 5,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Πολὺ πλούσιος εἶσαι,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 20
    },
    {
      "alignment": "aligned",
      "human_label": "ἐσύ, καταστροφέα πολλῶν!",
      "cer_docai_vs_human": 0.041666666666666664,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.96,
      "edit_distance": 1,
      "human_characters": 24
    },
    {
      "alignment": "aligned",
      "human_label": "Παρὰ πολλοὺς κάμνεις ζηλόφτονους,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 33
    },
    {
      "alignment": "aligned",
      "human_label": "παρὰ πολλοὺς κάμνεις φτωχούς…",
      "cer_docai_vs_human": 0.10344827586206896,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9032258064516129,
      "edit_distance": 3,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "Σὲ μέν’ τὸν ἴδιο ρίχνει ἥσκιο τὸ φῶς σου—,",
      "cer_docai_vs_human": 0.047619047619047616,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9523809523809523,
      "edit_distance": 2,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "τουρτουρίζω· φεύγα μακριά, σὺ πλούσιε,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 38
    },
    {
      "alignment": "aligned",
      "human_label": "φεύγα, Ζαρατούστρα, μακριά ἀφ’ τὸν ἥλιο σου!…",
      "cer_docai_vs_human": 0.1111111111111111,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.8936170212765957,
      "edit_distance": 5,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Τὰ περισσεύματά σου ἐπιθυμοῦσες νὰ χαρίσεις, νὰ ξεκάμεις,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        18
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 57
    },
    {
      "alignment": "aligned",
      "human_label": "μὰ ὁ περιττώτατος ὁ ἴδιος εἶσαι ἐσύ!",
      "cer_docai_vs_human": 0.027777777777777776,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.972972972972973,
      "edit_distance": 1,
      "human_characters": 36
    },
    {
      "alignment": "aligned",
      "human_label": "Φρονίμεψε, ὦ σὺ πλούσιε!",
      "cer_docai_vs_human": 0.041666666666666664,
      "human_line_indices": [
        20
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.96,
      "edit_distance": 1,
      "human_characters": 24
    },
    {
      "alignment": "aligned",
      "human_label": "Πρῶτα τὸν ἴδιο σου ἑαυτὸ χάρισε, ὦ Ζαρατούστρα!",
      "cer_docai_vs_human": 0.02127659574468085,
      "human_line_indices": [
        21
      ],
