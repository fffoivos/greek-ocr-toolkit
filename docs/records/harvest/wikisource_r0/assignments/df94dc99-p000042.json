      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "Λοιπὸν τῶν Τούρκων ἀληθῶς τὰς ἀρετὰς θαυμάζων,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
