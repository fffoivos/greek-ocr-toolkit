      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Μὲ νήφοντα τὸν λογισμὸν, καὶ ἀληθῶς σπουδάζων,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Γραφίδα, ποιητὰ σοφὲ, λαμβάνεις Ἡροδότου,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Κ’ ὁρμώμενος ἐκ παλαιοῦ ἀπὸ Ὀσμάνου πρώτου,",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9767441860465116,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ τοὺς αἰώνας τοὺς μακροὺς ὡς ἀετὸς περάσας,",
      "cer_docai_vs_human": 0.021739130434782608,
