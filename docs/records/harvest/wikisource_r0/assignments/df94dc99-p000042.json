    },
    {
      "alignment": "aligned",
      "human_label": "(ΙΣΤΟΡΙΑ ΤΟΥΡΚΙΚΗ ΛΑΜΑΡΤΙΝΟΥ)",
      "cer_docai_vs_human": 0.0,
