        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9782608695652174,
      "edit_distance": 1,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Πτωμάτων ὄρη διαβὰς καὶ αἵματος θαλάσσας,",
