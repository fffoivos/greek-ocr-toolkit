      "edit_distance": 0,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀπ’ ἐδῷ ῥοφᾷ ἡ μία βίαια καὶ τὴν ἑλκύει,",
      "cer_docai_vs_human": 0.075,
      "human_line_indices": [
