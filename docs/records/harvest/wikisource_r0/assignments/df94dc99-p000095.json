    },
    {
      "alignment": "aligned",
      "human_label": "Σῶμα μὲ σῶμα, ἀπνευστεὶ, δι’ ὅπλων, δι’ ὀδόντων,",
      "cer_docai_vs_human": 0.0625,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9375,
      "edit_distance": 3,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Μάχονται καὶ ἀνακινοῦν ἀέρα, γῆν καὶ πόντον",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Ὁ δαίμων τοῦ πολιτισμοῦ καὶ τῆς ἐλευθερίας",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Κ’ ὁ δαίμων τοῦ δεσποτισμοῦ καὶ τῆς κτηνώδους βίας,",
      "cer_docai_vs_human": 0.0196078431372549,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9803921568627451,
      "edit_distance": 1,
      "human_characters": 51
    },
    {
      "alignment": "aligned",
      "human_label": "Ὁ κῆπος τῆς Ἐδὲμ, ἡ γῆ τῶν μύρων καὶ ζεφύρων",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ τῶν ἐρωτικῶν παλμῶν καὶ τῶν τερπνῶν ὀνείρων,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 48
    },
    {
      "alignment": "aligned",
      "human_label": "Ὅπου μὲ μαῦρα ὄμματα ὡραῖαι Ἰταλίδες",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 36
    },
    {
      "alignment": "aligned",
      "human_label": "Σὲ νεύουν καὶ τὸν οὐρανὸν μὲ τὰς τρυφάς του εἶδες,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Ὅπου ἡ λόγχη σκωριᾷ κ’ εἶν’ ὀκνηρὰ τὰ ἔχθη,",
      "cer_docai_vs_human": 0.046511627906976744,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9534883720930233,
      "edit_distance": 2,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Παλαίστρα συμφορᾷς, σκηνὴ τοῦ τρόμου ἐξελέχθη.",
      "cer_docai_vs_human": 0.021739130434782608,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9782608695652174,
      "edit_distance": 1,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Ἡ νὺξ δὲν ἐπισπᾷ ἐκεῖ, τῶν ἡδονῶν ἡ ὥρα,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 40
    },
    {
      "alignment": "aligned",
      "human_label": "Κατόπιν κώμους καὶ φαιδρὰς καθαρῳδίας τώρα·",
      "cer_docai_vs_human": 0.023255813953488372,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9767441860465116,
      "edit_distance": 1,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ ὅταν φέρουσα τὸ φῶς δειλὴ αὐγὴ προβαίνῃ,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Μ’ αἷμα τὸν δρόμον τ’ οὐρανοῦ ἀντὶ μὲ ῥόδα ῥαίνει.",
      "cer_docai_vs_human": 0.04,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.96,
      "edit_distance": 2,
      "human_characters": 50
    },
    {
      "alignment": "aligned",
      "human_label": "Ὡς δράκων μέλας εἰς λαιμὸν παρθένου ἁβροτάτης,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐνῷ κοιμᾶτ’ αὐτὴ, περνᾷ, κ’ ἀθῶος ἐξ ἀπάτης,",
      "cer_docai_vs_human": 0.045454545454545456,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9545454545454546,
      "edit_distance": 2,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Συστρέφεται ὡς ὀρμαθὸς σμαράγδων καὶ ὑφέρπει",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 44
    },
    {
      "alignment": "aligned",
      "human_label": "Παντοῦ, διότι ἡ ἰκμὰς τοῦ σώματος τὸν τέρπει·",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        18
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀλλ’ ἂν κινήσῃ ἐλαφρὰ ἕν μέλος της ἐκείνη,",
      "cer_docai_vs_human": 0.09523809523809523,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9069767441860466,
      "edit_distance": 4,
      "human_characters": 42
    },
    {
      "alignment": "aligned",
      "human_label": "Τὴν ἔπνιξεν ἐλελιχθεὶς καὶ ἄπνουν τὴν ἀφίνει·",
      "cer_docai_vs_human": 0.022222222222222223,
      "human_line_indices": [
        20
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9777777777777777,
      "edit_distance": 1,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Ὁμοίως, ὦ Νεάπολις, καὶ σὲ ὁ τύραννός σου",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        21
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Σ’ ἐφείδετ’ ὅσον ὁ βαθὺς διήρκει λήθαργός σου,",
      "cer_docai_vs_human": 0.043478260869565216,
      "human_line_indices": [
        22
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9565217391304348,
      "edit_distance": 2,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀλλ’ ἅμα ἔδειξας πῶς ζῇς, ὦ τάλαινα, φρυάττων,",
      "cer_docai_vs_human": 0.08695652173913043,
      "human_line_indices": [
        23
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9148936170212766,
      "edit_distance": 4,
      "human_characters": 46
    },
    {
      "alignment": "aligned",
      "human_label": "Μιαιφονώτατος, σφαγῆς σ’ ἐνέπλησε κ’ αἱμάτων.",
      "cer_docai_vs_human": 0.044444444444444446,
      "human_line_indices": [
        24
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9555555555555556,
      "edit_distance": 2,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Πλὴν χαῖρε, χαῖρε, ὦ σεμνὴ, ἁγνὴ Ἐλευθερία·",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        25
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Νικᾷς, καὶ τῶν λαῶν ἰδοὺ κατέστης ἡ θρησκεία.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        26
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "Ἡ οὐρανία σου λαμπὰς εἰς τῆς νυκτὸς τὸν ζόφον",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        27
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 45
