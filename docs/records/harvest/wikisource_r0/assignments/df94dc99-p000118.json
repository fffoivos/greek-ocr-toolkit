    {
      "alignment": "aligned",
      "human_label": "Ἀλλὰ ἐκείνη, φεῦ! ἐν ἀνίαις",
      "cer_docai_vs_human": 0.1111111111111111,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.896551724137931,
      "edit_distance": 3,
      "human_characters": 27
    },
    {
      "alignment": "aligned",
      "human_label": "Κ' ἐν καταισχύνῃ καὶ ἐν μανίαις,",
      "cer_docai_vs_human": 0.03125,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.96875,
      "edit_distance": 1,
      "human_characters": 32
    },
    {
      "alignment": "aligned",
      "human_label": "Οἰκτρὰ καὶ μόνη ἀπὸ τοῦ βράχου",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "Τούτου, ἐντὸς τοῦ πολυταράχου",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "Ἔπιπτε κύματος πελαγίου,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 24
    },
    {
      "alignment": "aligned",
      "human_label": "Πολυταράχου ἕρμαιον βίου.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 25
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐκεῖ ἡ βάρβιτος συνετρίβη,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "Κ' ἡ ἀοιδὸς κ' ἡ ματαία ἥβη,",
      "cer_docai_vs_human": 0.07142857142857142,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9285714285714286,
      "edit_distance": 2,
      "human_characters": 28
    },
    {
      "alignment": "aligned",
      "human_label": "Κ' ὁ δεινὸς ἔρως μὲ τὴν καρδίαν,",
      "cer_docai_vs_human": 0.03125,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.96875,
      "edit_distance": 1,
      "human_characters": 32
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ ἡ πνοὴ μὲ τὴν ἁρμονίαν!",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 27
    },
    {
      "alignment": "aligned",
      "human_label": "Καὶ τώρα ὅταν φαιδρὰ γαλήνη",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 27
    },
    {
      "alignment": "aligned",
      "human_label": "Τὰ γλαυκὰ κύματα ἁπαλύνῃ,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 25
    },
    {
      "alignment": "aligned",
      "human_label": "Εἰς τὸ ῥεμβάζον ὄμμ' ἀνατέλλει",
      "cer_docai_vs_human": 0.03333333333333333,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9666666666666667,
      "edit_distance": 1,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "Πολλάκις ὥς τις λεπτὴ νεφέλη,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀμυδροὶ, ἄμορφοι χαρακτῆρες,",
      "cer_docai_vs_human": 0.07142857142857142,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9310344827586207,
      "edit_distance": 2,
      "human_characters": 28
    },
    {
      "alignment": "aligned",
      "human_label": "Σκιὰ βλεφάρων, εὐπήχεις χεῖρες,",
