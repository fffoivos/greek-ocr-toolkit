        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9615384615384616,
      "edit_distance": 1,
      "human_characters": 25
    },
    {
      "alignment": "aligned",
      "human_label": "λευκὸν, πλὴν ὅλα συγκεχυμένα.",
