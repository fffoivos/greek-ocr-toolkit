    },
    {
      "alignment": "aligned",
      "human_label": "Εἰς τὰς ἀκτὰς καὶ εἰς σὲ τὸ εἶδος",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 33
    },
    {
      "alignment": "aligned",
      "human_label": "Καλὴ ἐπίσης, ὦ Ἰωνία,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 21
    },
    {
      "alignment": "aligned",
      "human_label": "Ἱερῶν ἔστη ποτὲ χορεία",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 22
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀοιδῶν, μέλος διὰ στομάτων",
      "cer_docai_vs_human": 0.07692307692307693,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9259259259259259,
      "edit_distance": 2,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "Κάλλιστον πνέουσα ἀθανάτων,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 27
    },
    {
      "alignment": "aligned",
      "human_label": "Ὡς μελαμφύλλων ἐντὸς δενδρώνων",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "Μουσικῶν ἅμιλλαι ἀηδόνων.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 25
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀλλὰ εἰς πάθος, εἰς πῦρ, εἰς γόους",
      "cer_docai_vs_human": 0.029411764705882353,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9714285714285714,
      "edit_distance": 1,
      "human_characters": 34
    },
    {
      "alignment": "aligned",
      "human_label": "Λιγεῖς, εἰς ἔρωτας πολυθρόους",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "Πολὺ τοὺς ἄλλους ἐνίκα μία",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "Πάντας, ἡ θήλεια ἡ Λεσβία.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "Τοῦ θνητοῦ μέρους καὶ ἐπιγείου",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "Αὐτῆς τὰ κάλλη ὡς ἡφαιστείου",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 28
    },
    {
      "alignment": "aligned",
      "human_label": "Ἐπ' ὄρους θάλλοντες ἦσαν κῆποι,",
      "cer_docai_vs_human": 0.03225806451612903,
      "human_line_indices": [
        17
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.967741935483871,
      "edit_distance": 1,
      "human_characters": 31
    },
    {
      "alignment": "aligned",
      "human_label": "Ὑφ' οὓς ὁ Ἔρως ἐμυδροκτύπει.",
      "cer_docai_vs_human": 0.03571428571428571,
      "human_line_indices": [
        18
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9642857142857143,
      "edit_distance": 1,
      "human_characters": 28
    },
    {
      "alignment": "aligned",
      "human_label": "Εἷς θνητὸς, ἄφρων θνητὸς, ἀγκάλας",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        19
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 33
    },
    {
      "alignment": "aligned",
      "human_label": "Κ' ἔρωτ' ἀπέβαλ' ἐκείνης τάλας",
      "cer_docai_vs_human": 0.1,
      "human_line_indices": [
        20
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9,
      "edit_distance": 3,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "Δι' ἣν τρισμάκαρ ὁ αἰὼν ὅστις,",
      "cer_docai_vs_human": 0.03333333333333333,
      "human_line_indices": [
        21
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9666666666666667,
      "edit_distance": 1,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀνταυγασθεὶς ἐκ τῆς λάμψεώς της,",
      "cer_docai_vs_human": 0.0625,
      "human_line_indices": [
        22
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9393939393939394,
      "edit_distance": 2,
      "human_characters": 32
    },
    {
      "alignment": "aligned",
      "human_label": "Νὰ εἴπῃ δύναται φιλοτίμου",
