  "assignments": [
    {
      "alignment": "aligned",
      "human_label": "Σοφία θερμογάλακτη, γλυκειὰ δροσιὰ τσῆ ἀγάπης",
      "cer_docai_vs_human": 0.044444444444444446,
      "human_line_indices": [
        0
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9555555555555556,
      "edit_distance": 2,
      "human_characters": 45
    },
    {
      "alignment": "aligned",
      "human_label": "ἀπάνου ἀπὸ τὴ χώρα πλημμυρίζω.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        1
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "Μακριά, μακριά, ὦ ἀλήθειες",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        2
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "ποὺ σκοτεινὰ θωρεῖτε!",
      "cer_docai_vs_human": 0.047619047619047616,
      "human_line_indices": [
        3
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9545454545454546,
      "edit_distance": 1,
      "human_characters": 21
    },
    {
      "alignment": "aligned",
      "human_label": "Δὲ θέλω ἀπάνου στὰ βουνά μου",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        4
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 28
    },
    {
      "alignment": "aligned",
      "human_label": "στρυφνὲς χωρὶς ὑπομονὴ νὰ βλέπω ἀλήθειες.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        5
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 41
    },
    {
      "alignment": "aligned",
      "human_label": "Χρυσῆ ἀπὸ τὸ χαμόγελο",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        6
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 21
    },
    {
      "alignment": "aligned",
      "human_label": "σήμερα ἐγγύς μου τὴν ἀλήθεια,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        7
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 29
    },
    {
      "alignment": "aligned",
      "human_label": "ἀπὸ τὸν Ἥλιο γλυκερή, μαύρη ἀπὸ τὴν ἀγάπη,—",
      "cer_docai_vs_human": 0.046511627906976744,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9545454545454546,
      "edit_distance": 2,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "μιὰν οὐρμασμένη ἀλήθεια κόβω ἀπὸ τὸ δέντρο.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 43
    },
    {
      "alignment": "aligned",
      "human_label": "Τὸ χέρι ἀπλόνω σήμερα",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 21
    },
    {
      "alignment": "aligned",
      "human_label": "στῆς τύχης τα σγουρόμαλλα,",
      "cer_docai_vs_human": 0.038461538461538464,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9615384615384616,
      "edit_distance": 1,
      "human_characters": 26
    },
    {
      "alignment": "aligned",
      "human_label": "ἀρκετὰ φρόνιμος, τὴν τύχη",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 25
    },
    {
      "alignment": "aligned",
      "human_label": "νὰ ὁδηγήσω σὰν παιδί, νὰν τηνὲ ξεγελάσω.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        13
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 40
    },
    {
      "alignment": "aligned",
      "human_label": "Θέλω φιλόξενος σήμερα νὰ εἶμαι",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        14
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 30
    },
    {
      "alignment": "aligned",
      "human_label": "στὸν ἐνοχλητικό,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        15
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 16
    },
    {
      "alignment": "aligned",
      "human_label": "τοῦ πεπρωμένου ἐνάντια ἀγκάθια ἐγὼ δὲ θέλω νἀπλόνω",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
