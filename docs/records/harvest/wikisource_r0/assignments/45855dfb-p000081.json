      "alignment_similarity": 0.9210526315789473,
      "edit_distance": 3,
      "human_characters": 37
    },
    {
      "alignment": "aligned",
      "human_label": "Ποῦ ἡ φλόγ’ ἀκαταλάγιαστη ἔχει ἀνάψῃ",
