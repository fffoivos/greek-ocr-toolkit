      "alignment_similarity": 0.9166666666666666,
      "edit_distance": 3,
      "human_characters": 36
    },
    {
      "alignment": "aligned",
      "human_label": "Μέσα ’ς τὰ φυλλοκάρδια μου τὰ μαῦρα,",
