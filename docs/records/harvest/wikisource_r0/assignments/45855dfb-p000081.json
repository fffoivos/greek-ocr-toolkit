      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 39
    },
    {
      "alignment": "aligned",
      "human_label": "Ὤμορφες σὰν τοῦ Ραφαὴλ οἱ ἀγγέλοι,",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        11
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 34
    },
    {
      "alignment": "aligned",
      "human_label": "Γιὰ πολλαῖς πολλαῖς ὥραις",
