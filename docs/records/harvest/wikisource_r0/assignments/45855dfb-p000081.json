      "human_characters": 38
    },
    {
      "alignment": "aligned",
      "human_label": "Δροσιὰ θἆχαν ὀλίγη.",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        8
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 19
    },
    {
      "alignment": "aligned",
      "human_label": "Εἶν’ ἀγάπη; Δὲν εἶναι· ὅλο τὸ μέλι",
      "cer_docai_vs_human": 0.029411764705882353,
      "human_line_indices": [
        9
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 0.9705882352941176,
      "edit_distance": 1,
      "human_characters": 34
    },
    {
      "alignment": "aligned",
      "human_label": "Ποῦ κρύβουν μὲς τὰ χείλη χίλιαις κόραις",
      "cer_docai_vs_human": 0.0,
      "human_line_indices": [
        10
      ],
