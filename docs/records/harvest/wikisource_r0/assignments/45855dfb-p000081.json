      "human_line_indices": [
        12
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 25
    },
    {
      "alignment": "aligned",
      "human_label": "Ἀπὸ ἕνα στόμ’ ἂν τὸ ρουφοῦσα, ἡ λάβρα",
