        16
      ],
      "alignment_reason": "one_to_one",
      "alignment_similarity": 1.0,
      "edit_distance": 0,
      "human_characters": 21
    },
    {
      "alignment": "aligned",
      "human_label": "Τὰ ὀνείρατα τῆς δόξας ἀπὸ χρόνια,",
