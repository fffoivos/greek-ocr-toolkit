  "lines": [
    {
      "text": ":Εὗρε τὸ θῦμα χωρὶς καρδίας.",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "—Θανάτου σύμβολον φοβερόν!—",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Ἀφῆκε φθόγγον ἀπελπισίας",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ἀπὸ τὸ στόμα τὸ ἱερόν,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "κʾ ἐταπεινώθη ὅλων τὸ βλέμμα.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Ὅλων ἐπάγωσʾ εὐθὺς τὸ αἷμα.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Ὅπως, ἐξαίφνης ἐνώπιόν μας",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "ὅταν βροντήσῃ ὁ κεραυνός,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "τὸ πῦρ παγόνει τῶν καρδιῶν μας",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "καὶ στόμʾ ἀνοίγομεν κεχηνός.",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": ":Ὅπως δʾ ὁ ἥλιος ὅταν σβύνῃ,",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "ὠχρὸς εἰς κύματα βυθισθείς,",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "παντοῦ τὰς πτέρυγας ἐπεκτείνει",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "ψυχρὸς ὁ Ζόφος διαχυθείς,",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": "οὕτως ἡ φήμη ταχὺ καθʾ ὅλην",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": "διεσκεδάσθη τὴν ἄλλην πόλιν·",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
      "text": "γυναῖκες, παῖδες, τὸ κύπτον γῆρας,",
      "cleaned_line": 19,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἐκπυνθανόμενοι τὸ καινόν,",
      "cleaned_line": 20,
      "index": 17,
      "usable": true
    },
    {
      "text": "ἀπηλπισμένας αἴροντες χεῖρας",
      "cleaned_line": 21,
      "index": 18,
      "usable": true
    },
    {
      "text": "ἐπεκαλούντο τὸν οὐρανόν.",
      "cleaned_line": 22,
      "index": 19,
      "usable": true
    }
  ],
