  "lines": [
    {
      "text": "ΔΗΜΟΣΙΟΙ ΥΠΑΛΛΗΛΟΙ",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Οἱ ὑπάλληλοι ὅλοι λυόνουν καὶ τελειόνουν",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "σὰν στῆλες δύο δύο μὲς στὰ γραφεῖα.",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "(Ἠλεκτρολόγοι θἆναι ἡ Πολιτεία",
      "cleaned_line": 4,
      "index": 3,
      "usable": true
    },
    {
      "text": "κι ὁ Θάνατος, ποὺ τοὺς ἀνανεώνουν).",
      "cleaned_line": 5,
      "index": 4,
      "usable": true
    },
    {
      "text": "Κάθονται στὶς καρέκλες, μουτζουρόνουν",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "ἀθῶα λευκὰ χαρτιά, χωρὶς αἰτία.",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "«Σὺν τῇ παρούσῃ ἀλληλογραφίᾳ",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἔχομεν τὴν τιμὴν» διαβεβαιώνουν.",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "Καὶ μοναχὰ ἡ τιμὴ τοὺς ἀπομένει,",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "ὅταν ἀνηφορίζουνε τοὺς δρόμους,",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "τὸ βράδυ στὶς ὀχτώ, σὰν κουρντισμένοι.",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Παίρνουν κάστανα, σκέπτονται τοὺς νόμους,",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "σκέπτονται τὸ συνάλλαγμα, τοὺς ὤμους",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "σηκώνοντας οἱ ὑπάλληλοι οἱ καϊμένοι.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    }
  ],
