  "lines": [
    {
      "text": "ἔκταθεν· Ἡρακλέης μὲν ἐνήρατο Τηλεκλῆα 1040",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "ἠδὲ Μεγαβρόντην· Σφόδριν δ’ ἐνάριξεν Ἄκαστος·",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Πηλεὺς δὲ Ζέλυν εἷλεν ἀρηίθοόν τε Γέφυρον.",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "αὐτὰρ ἐυμμελίης Τελαμὼν Βασιλῆα κατέκτα.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Ἴδας δ’ αὖ Προμέα, Κλυτίος δ’ Ὑάκινθον ἔπεφνεν,",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Τυνδαρίδαι δ’ ἄμφω Μεγαλοσσάκεα Φλογίον τε. 1045",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Οἰνεΐδης δ’ ἐπὶ τοῖσιν ἕλεν θρασὺν Ἰτυμονῆα",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "ἠδὲ καὶ Ἀρτακέα, πρόμον ἀνδρῶν· οὓς ἔτι πάντας",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἐνναέται τιμαῖς ἡρωίσι κυδαίνουσιν.",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "οἱ δ’ ἄλλοι εἴξαντες ὑπέτρεσαν, ἠύτε κίρκους",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ὠκυπέτας ἀγεληδὸν ὑποτρέσσωσι πέλειαι. 1050",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "ἐς δὲ πύλας ὁμάδῳ πέσον ἀθρόοι· αἶψα δ’ ἀυτῆς",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "πλῆτο πόλις στονόεντος ὑποτροπίῃ πολέμοιο.",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἠῶθεν δ’ ὀλοὴν καὶ ἀμήχανον εἰσενόησαν",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "ἀμπλακίην ἄμφω· στυγερὸν δ’ ἄχος εἷλεν ἰδόντας",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "ἥρωας Μινύας Αἰνήιον υἷα πάροιθεν 1055",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "Κύζικον ἐν κονίῃσι καὶ αἵματι πεπτηῶτα.",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἤματα δὲ τρία πάντα γόων, τίλλοντό τε χαίτας",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "αὐτοὶ ὁμῶς λαοί τε Δολίονες. αὐτὰρ ἔπειτα",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "τρὶς περὶ χαλκείοις σὺν τεύχεσι δινηθέντες",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "τύμβῳ ἐνεκτερέιξαν, ἐπειρήσαντό τ’ ἀέθλων, 1060",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ἣ θέμις, ἂμ πεδίον λειμώνιον, ἔνθ’ ἔτι νῦν περ",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "ἀγκέχυται τόδε σῆμα καὶ ὀψιγόνοισιν ἰδέσθαι.",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "οὐδὲ μὲν οὐδ’ ἄλοχος Κλείτη φθιμένοιο λέλειπτο",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "οὗ πόσιος μετόπισθε· κακῷ δ’ ἐπὶ κύντερον ἄλλο",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "ἤνυσεν, ἁψαμένη βρόχον αὐχένι. τὴν δὲ καὶ αὐταὶ 1065",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "νύμφαι ἀποφθιμένην ἀλσηίδες ὠδύραντο·",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "καί οἱ ἀπὸ βλεφάρων ὅσα δάκρυα χεῦαν ἔραζε,",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "πάντα τάγε κρήνην τεῦξαν θεαί, ἣν καλέουσιν",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "Κλείτην, δυστήνοιο περικλεὲς οὔνομα νύμφης.",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "αἰνότατον δὴ κεῖνο Δολιονίῃσι γυναιξὶν 1070",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
