      "text": "::ἐλπὶς πλουσίων λύτρων.",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Φωνὴ διέῤῥει σιγαλὴ",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::ὡς ψίθυρος τὸ πρῶτον.",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "Ἀλλ’ ἐθρασύνοντο πολλοὶ,",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "καὶ ἐξεῤῥάγ’ ἡ ἀπειλὴ",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::μετὰ κραυγῶν καὶ κρότων.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Τῶν ἀπαισίων ὀφθαλμῶν",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::τὸ μέλαν πῦρ ἰδέτε.",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "Ἐγείρεται πᾶς ὁ τολμῶν·",
      "cleaned_line": 22,
      "index": 17,
      "usable": true
    },
    {
