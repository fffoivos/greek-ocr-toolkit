  "lines": [
    {
      "text": "ΟΙ ΤΡΕΙΣ",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ἀφοῦ κ’ ἡ τελευταία ἐχάθη μάχη,",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "τρεῖς ἱππεῖς ἐπιστρέφουνε μονάχοι.",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "Ἀπὸ βαθειὲς πληγὲς τὸ αἷμα ρέει",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "ζεστό, τἄλογο σκύβει νὰ τὸ εἰσπνέη.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Ἀπὸ τὴ σέλλα τὸ αἷμα τἀναβάτου,",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "κι ἀπὸ τοὺς χαλινούς, ἔφτασε κάτου.",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "Ἀγάλι ἀγάλι τἄλογο πηγαίνει,",
      "cleaned_line": 11,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἀλλὰ τὸ αἷμα τρέχει καὶ πληθαίνει.",
      "cleaned_line": 12,
      "index": 8,
      "usable": true
    },
    {
      "text": "Οἱ τρεῖς ἱππεῖς πηγαίνουν πλάι πλάι,",
      "cleaned_line": 14,
      "index": 9,
      "usable": true
    },
    {
      "text": "ὁ ἕνας στὸν ἄλλο γέρνει κι ἀκουμπάει",
      "cleaned_line": 15,
      "index": 10,
      "usable": true
    }
  ],
