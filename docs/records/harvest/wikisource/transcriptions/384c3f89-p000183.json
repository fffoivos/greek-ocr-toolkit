  "lines": [
    {
      "text": "Κύπρις ἔτ’ ἐν δίναις ἀνερέψατο, καί ῥ’ ἐσάωσεν",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "πρόφρων ἀντομένη Λιλυβηίδα ναιέμεν ἄκρην.",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "οἱ δ’ ἄχεϊ σχόμενοι τὰς μὲν λίπον, ἄλλα δ’ ὄπαζον 920",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "κύντερα μιξοδίῃσιν ἁλὸς ῥαιστήρια νηῶν.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "τῇ μὲν γὰρ Σκύλλης λισσὴ προυφαίνετο πέτρη·",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "τῇ δ’ ἄμοτον βοάασκεν ἀναβλύζουσα Χάρυβδις·",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "ἄλλοθι δὲ Πλαγκταὶ μεγάλῳ ὑπὸ κύματι πέτραι",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "ῥόχθεον, ᾗχι πάροιθεν ἀπέπτυεν αἰθομένη φλὸξ 925",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἄκρων ἐκ σκοπέλων, πυριθαλπέος ὑψόθι πέτρης,",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "καπνῷ δ’ ἀχλυόεις αἰθὴρ πέλεν, οὐδέ κεν αὐγὰς",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἔδρακες ἠελίοιο. τότ’ αὖ λήξαντος ἀπ’ ἔργων",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "Ἡφαίστου θερμὴν ἔτι κήκιε πόντος ἀυτμήν.",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "ἔνθα σφιν κοῦραι Νηρηίδες ἄλλοθεν ἄλλαι 930",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἤντεον· ἡ δ’ ὄπιθεν πτέρυγος θίγε πηδαλίοιο",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "δῖα Θέτις, Πλαγκτῇσιν ἐνὶ σπιλάδεσσιν ἐρύσσαι.",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "ὡς δ’ ὁπόταν δελφῖνες ὑπὲξ ἁλὸς εὐδιόωντες",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "σπερχομένην ἀγεληδὸν ἑλίσσωνται περὶ νῆα,",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἄλλοτε μἑν προπάροιθεν ὁρώμενοι, ἄλλοτ’ ὄπισθεν, 935",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "ἄλλοτε παρβολάδην, ναύτῃσι δὲ χάρμα τέτυκται·",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "ὧς αἱ ὑπεκπροθέουσαι ἐπήτριμοι εἱλίσσοντο",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "Ἀργῴῃ περὶ νηί, Θέτις δ’ ἴθυνε κέλευθον.",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "καί ῥ’ ὅτε δὴ Πλαγκτῇσιν ἐνιχρίμψεσθαι ἔμελλον,",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "αὐτίκ’ ἀνασχόμεναι λευκοῖς ἐπὶ γούνασι πέζας, 940",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "ὑψοῦ ἐπ’ αὐτάων σπιλάδων καὶ κύματος ἀγῆς",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "ῥώοντ’ ἔνθα καὶ ἔνθα διασταδὸν ἀλλήλῃσιν.",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "τὴν δὲ παρηορίην κόπτεν ῥόος· ἀμφὶ δὲ κῦμα",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "λάβρον ἀειρόμενον πέτραις ἐπικαχλάζεσκεν,",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "αἵ θ’ ὁτὲ μὲν κρημνοῖς ἐναλίγκιαι ἠέρι κῦρον, 945",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "ἄλλοτε δὲ βρύχιαι νεάτῳ ὑπὸ πυθμένι πόντου",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "ἠρήρειν, τὸ δὲ πολλὸν ὑπείρεχεν ἄγριον οἶδμα.",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "αἱ δ’, ὥστ’ ἠμαθόεντος ἐπισχεδὸν αἰγιαλοῖο",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
