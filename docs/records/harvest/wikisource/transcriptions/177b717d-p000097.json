  "lines": [
    {
      "text": "ΒΑΡΚΑΡΟΛΑ",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Κυριακή. Σ’ ἕνα βαπόρι",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "στριμωχτήκαν μπουρζουάδες.",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "Ξεφωνίζει κάθε ἀγόρι,",
      "cleaned_line": 4,
      "index": 3,
      "usable": true
    },
    {
      "text": "ξεμυξίζουν οἱ μαμάδες.",
      "cleaned_line": 5,
      "index": 4,
      "usable": true
    },
    {
      "text": "Τὰ σκυλιὰ δὲ λογαριάζουν,",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "ὀ Σηκουάνας πὄχει πνίξει,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "δὲ φοβοῦνται, διασκεδάζουν",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "τὴν εὐγενική τους πλήξη.",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "«Ὤ, τί ζέστη, Θεέ μου, βράζει!»",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "βεβαιώνουν οἱ κυρίες,",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "κ’ ἐπιπόλαιες καὶ γελοῖες,",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "ξεκουμπώνοντας μὲ νάζι",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "τὰ χυδαῖα ντεκολτέ τους,",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "διευκολύνουν τοὺς ἐμέτους.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Laurent Tailhade",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    }
  ],
