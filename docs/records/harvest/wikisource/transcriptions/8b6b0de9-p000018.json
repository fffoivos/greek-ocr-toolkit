  "lines": [
    {
      "text": "Ἡ τρόπις ἤγγισε τὴν γῆν,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "::καὶ οἱ θαλασσομάχοι,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "τρόμου ἐκπέμψαντες κραυγὴν,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ἐπήδησαν καὶ εἰς φυγὴν",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "::ἐῤῥίφθησαν ἐν τάχει.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Φεύγουσ’ εἰς βράχους, εἰς κλειστὰς",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "::δασώδεις νάπας, ὅτε...",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "ὤ! τὰς ἁλύσεις ὡς κλωστὰς",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "συντρίβουσι, καὶ τοὺς ληστὰς",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "::διώκουσ’ οἱ δεσμῶται!",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Φθάνουσι, ῥίπτουσι πρηνεῖς",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::εἰς γῆν τοὺς ἀτιθάσσους,",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "ἐργάται φοβερᾶς ποινῆς·",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "καὶ σχίζουσιν εὐθυτενεῖς",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::σκυτάλας ἐκ τοῦ δάσους.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Πᾶσα πληγὴ αἱματηρὰ",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::ὡς ξίφους καταβαίνει.",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "Ἔχουσι νεῦρα σιδηρᾶ.",
      "cleaned_line": 22,
      "index": 17,
      "usable": true
    },
    {
      "text": "Δὲν εἶναι ἄνθρωποι, οὐρὰ",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "::τὸ νῶτόν των περαίνει.",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": "Καὶ ἐκαθέσθ’ ὑπὸ φηγὸν",
      "cleaned_line": 26,
      "index": 20,
      "usable": true
