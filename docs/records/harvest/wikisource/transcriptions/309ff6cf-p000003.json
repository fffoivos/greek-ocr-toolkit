  "lines": [
    {
      "text": "ΑΛΕΞΑΝΔΡΟΣ ΖΑΪΜΗΣ",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "ΥΠΑΤΟΣ ΑΡΜΟΣΤΗΣ ΕΝ ΚΡΗΤΗι",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Κυροῦντες τὸ ὑπὸ τῆς Βʹ. τῶν Κρητῶν Συνελεύσεως ψηφισθὲν Σύνταγμα τῆς Κρητικῆς Πολιτείας.",
      "cleaned_line": 7,
      "index": 2,
      "usable": true
    },
    {
      "text": "Αʹ.) Διατάσσομεν τὴν διὰ τῆς Ἐπισήμου Ἐφημερίδος δημοσίευσιν αὐτοῦ ὡς ἕπεται:",
      "cleaned_line": 9,
      "index": 3,
      "usable": true
    },
    {
      "text": "ΣΥΝΤΑΓΜΑ",
      "cleaned_line": 17,
      "index": 4,
      "usable": true
    },
    {
      "text": "ΤΗΣ",
      "cleaned_line": 19,
      "index": 5,
      "usable": true
    },
    {
      "text": "ΚΡΗΤΙΚΗΣ ΠΟΛΙΤΕΙΑΣ",
      "cleaned_line": 21,
      "index": 6,
      "usable": true
    },
    {
      "text": "ΚΕΦΑΛΑΙΟΝ Αʹ.",
      "cleaned_line": 24,
      "index": 7,
      "usable": true
    },
    {
      "text": "Γενικαὶ Διατάξεις",
      "cleaned_line": 26,
      "index": 8,
      "usable": true
    },
    {
      "text": "Ἄρθρον 1.",
      "cleaned_line": 28,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ἡ Νῆσος Κρήτη μετὰ τῶν παρακειμένων αὐτῇ νησιδίων ἀποτελεῖ ἐντελῶς αὐτόνομον Πολιτείαν κατὰ",
      "cleaned_line": 30,
      "index": 10,
      "usable": true
    }
