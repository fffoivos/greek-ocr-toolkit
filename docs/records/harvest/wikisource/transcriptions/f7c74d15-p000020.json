  "lines": [
    {
      "text": "ΤΗΣ ΑΚΡΙΒΗΣ ΡΕΜΒΗΣ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ἀπὸ μιὰ θύμηση περάστηκε ὁ ὕπνος",
      "cleaned_line": 7,
      "index": 1,
      "usable": true
    },
    {
      "text": "Ἀπὸ τὴν ἄνοιξη βγήκαμε στὸ καλοκαῖρι,",
      "cleaned_line": 8,
      "index": 2,
      "usable": true
    },
    {
      "text": "Ἥρωες τῆς ἀκριβῆς ρέμβης,",
      "cleaned_line": 9,
      "index": 3,
      "usable": true
    },
    {
      "text": "Καὶ δὲν ἀπόρησε ὁ νοῦς μας",
      "cleaned_line": 10,
      "index": 4,
      "usable": true
    },
    {
      "text": "Δὲ σπάσαμε κέφι καὶ καρδιές",
      "cleaned_line": 11,
      "index": 5,
      "usable": true
    },
    {
      "text": "Ὅπως μυθέσκετο ἡ ψυχή μας·",
      "cleaned_line": 12,
      "index": 6,
      "usable": true
    },
    {
      "text": "Τεντωμένοι καθ’ ὅλη μας τὴν ὕπαρξη",
      "cleaned_line": 13,
      "index": 7,
      "usable": true
    },
    {
      "text": "Ἀκούσαμε νὰ πέφτει ἡ ἀνατριχίλα",
      "cleaned_line": 14,
      "index": 8,
      "usable": true
    },
    {
      "text": "Τοῦ χρόνου,",
      "cleaned_line": 15,
      "index": 9,
      "usable": true
    },
    {
      "text": "Δὲν εἴδαμε παρὰ τὴν Πλάση μοναχή",
      "cleaned_line": 16,
      "index": 10,
      "usable": true
    },
    {
      "text": "Νὰ βόσκει τὴν ὄμορφη γοητεία της",
      "cleaned_line": 17,
      "index": 11,
      "usable": true
    },
    {
      "text": "Στὴν ἅπλα ποὺ τῆς δώρησε ὁ Θεός",
      "cleaned_line": 18,
      "index": 12,
      "usable": true
    },
    {
      "text": "Ξεφάντωμα ἐξαίσιο",
      "cleaned_line": 19,
      "index": 13,
      "usable": true
    }
  ],
