  "lines": [
    {
      "text": "Ἡ ρήγισα Λευκή, ρόδον αὐγῆς,",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "μὲ τὴ φωνή της τὴ γλυκὰ ἀκουσμένη,",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἡ Βέρθα, ἡ Βεατρίκη, ἡ Ἀρεμβουργὶς",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "τοῦ Μαίν, ἡ Σπαρτιάτισα ἡ Ἑλένη,",
      "cleaned_line": 4,
      "index": 3,
      "usable": true
    },
    {
      "text": "κ’ ἡ καλὴ Ἰωάννα ἀπὸ τὴ Λορραίνη,",
      "cleaned_line": 5,
      "index": 4,
      "usable": true
    },
    {
      "text": "ὅλες ἀνοίξεως ὄνειρα τερπνά,",
      "cleaned_line": 6,
      "index": 5,
      "usable": true
    },
    {
      "text": "ἡ ἀνάμνησή τους ζωηρὴ ἀπομένει.",
      "cleaned_line": 7,
      "index": 6,
      "usable": true
    },
    {
      "text": "Μὰ ποὖναι τὰ χιόνια τἀλλοτινά;",
      "cleaned_line": 8,
      "index": 7,
      "usable": true
    },
    {
      "text": "Πρίγκιψ, ἂν τὶς ἀναζητεῖτε τώρα,",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "τάχα θὰ τὶς εὕρετε πουθενά,",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "τάχα θὰ ὑπάρχουν σὲ καμμιὰ χώρα;",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "Μὰ ποὖναι τὰ χιόνια τἀλλοτινά;",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "François Villon",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    }
  ],
