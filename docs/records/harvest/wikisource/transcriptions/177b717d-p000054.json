  "lines": [
    {
      "text": "BYRON",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ἔνιωσεν ὅτι",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "τοῦ ἦσαν οἱ στίχοι",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "ἄχαρη τύχη",
      "cleaned_line": 4,
      "index": 3,
      "usable": true
    },
    {
      "text": "καὶ ματαιότη.",
      "cleaned_line": 5,
      "index": 4,
      "usable": true
    },
    {
      "text": "Ἡ ὁρμή του ἡ πρώτη",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "πιὰ δὲν ἀντήχει,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "ἀλλά, στὰ τείχη,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἔνδοξη νιότη.",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "Γίνονται οἱ γέροι",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "γαῦροι. Θὰ ὁρμήση",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "ἀνδρῶν λουλούδι.",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Κι ὁ Μπάϊρον ξέρει",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "πῶς νὰ τὸ ζήση",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "τὸ θεῖο Τραγούδι.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    }
