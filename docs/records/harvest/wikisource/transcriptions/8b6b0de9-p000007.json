  "lines": [
    {
      "text": "Τ’ ἀπαλὰ χείλη της, καλὰ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "::ὡς κάλυξ ἀνεμώνης,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "μικρὸν προεῖχον τρυφηλὰ,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "καὶ ὅτ’ ἐγέλων, πῶς γελᾷ",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "::ὁ οὐρανὸς ἐφρόνεις.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Τότε δ’ ὡς ἔκειτο ἐκεῖ,",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "::διέστειλε τὰ χείλη,",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "κ’ ἐξῆλθον τόνοι μουσικοὶ,",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "καὶ μειδιάσασα γλυκὺ,",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "::ἡ νεανὶς ὡμίλει.",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "—»Ὅταν σε βλέπω, δειλιῶν",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::τὸ σῶμά μου πῶς τρέμει;",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "Εἶσαι ἀνώτερόν τι ὄν;",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "Ἄν ἄνθρωπον ἢ ἂν Θεὸν",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::ἀκολουθῶ, εἰπέ μοι.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "»Εἰς σὲ προσπλέκει ἡ Κλωθὼ",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::τοῦ βίου μου τὸ νῆμα.",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "Σὲ μόνον, μόνον σὲ ποθῶ,",
      "cleaned_line": 22,
      "index": 17,
      "usable": true
    },
    {
      "text": "καὶ ὡς δεσμί’ ἀκολουθῶ",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "::τό προσφιλές σου βῆμα.",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": "»Πλανῶμαι ὅπου μὲ πλανᾷς,",
      "cleaned_line": 26,
      "index": 20,
      "usable": true
    },
    {
      "text": "::μετὰ πνοῶν ἀνέμων,",
      "cleaned_line": 27,
      "index": 21,
      "usable": true
    },
    {
