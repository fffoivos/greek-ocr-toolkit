      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::ἐπάνω τοῦ αἰθέρος",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "ὅπου ὁ βίος ὁ γλυκύς,",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "αἱ τέρψεις αἱ διηνεκεῖς,",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::τῶν Θεαινῶν ὁ ἔρως.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "«Ταχὺς δὲ τάφος εἰς ἐμὲ",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::καὶ αἰωνία λήθη».",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "«Εἰς σὲ ἀθάνατοι στιγμαὶ",
      "cleaned_line": 22,
      "index": 17,
