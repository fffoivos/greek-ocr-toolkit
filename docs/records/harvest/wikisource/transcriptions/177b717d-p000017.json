  "lines": [
    {
      "text": "ΦΥΓΕ, Η ΚΑΡΔΙΑ ΜΟΥ ΝΟΣΤΑΛΓΕΙ...",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Φύγε κι ἄσε με μοναχό, ποὺ βλέπω νὰ πληθαίνη",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἀπάνω ἡ νύχτα, καὶ βαθιὰ νὰ γίνωνται τὰ χάη.",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "Οὔτε τοῦ πόνου ἡ θύμηση σὲ λίγο πιὰ δὲ μένει,",
      "cleaned_line": 4,
      "index": 3,
      "usable": true
    },
    {
      "text": "κ' εἶμαι ἄνθος ποὺ φυλλορροεῖ στὸ χέρι σου καὶ πάει.",
      "cleaned_line": 5,
      "index": 4,
      "usable": true
    },
    {
      "text": "Φύγε καθὼς τὰ χρόνια κεῖνα ἐφύγανε, ποὺ μόνον",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "μιὰ λέξη σου ἤταν, στὴ ζωή, γιὰ μένα σὰν παιάνας.",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "Τώρα τὰ χείλη μου διψοῦν τὸ φίλημα τῆς μάνας,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "τῆς μάνας γῆς, καὶ ἀνοίγονται στὸ γέλιο τῶν αἰώνων.",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "Φύγε, ἡ καρδιά μου νοσταλγεῖ τὴν ἄπειρη γαλήνη!",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ταράζει καὶ ἡ ἀνάσα σου τὰ μαῦρα τῆς Στυγὸς",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "νερά, ποὺ μὲ πηγαίνουν, ὅπως εἶμαι ναυαγός,",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "ἐκεῖ, στὸ ἀπόλυτο Μηδέν, στὴν Ἀπεραντοσύνη.",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    }
  ],
