  "lines": [
    {
      "text": "ὅσσους Βιλλαίοιο μέλαν περιάγνυται ὕδωρ.",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "ἀλλά με νῦν Βέβρυκες ὑπερβασίη τ’ Ἀμύκοιο",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "τηλόθι ναιετάοντος, ἐνόσφισαν, Ἡρακλῆος,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "δὴν ἀποτεμνόμενοι γαίης ἅλις, ὄφρ’ ἐβάλοντο",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "οὖρα βαθυρρείοντος ὑφ’ εἱαμεναῖς Ὑπίοιο. 795",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "ἔμπης δ’ ἐξ ὑμέων ἔδοσαν τίσιν· οὐδέ ἕ φημι",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "ἤματι τῷδ’ ἀέκητι θεῶν ἐπελάσσαι ἄρηα,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "Τυνδαρίδην Βέβρυξιν, ὅτ’ ἀνέρα κεῖνον ἔπεφνεν.",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "τῶ νῦν ἥντιν’ ἐγὼ τῖσαι χάριν ἄρκιός εἰμι,",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "τίσω προφρονέως. ἡ γὰρ θέμις ἠπεδανοῖσιν 800",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἀνδράσιν, εὖτ’ ἄρξωσιν ἀρείονες ἄλλοι ὀφέλλειν.",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "ξυνῇ μὲν πάντεσσιν ὁμόστολον ὔμμιν ἕπεσθαι",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "Δάσκυλον ὀτρυνέω, ἐμὸν υἱέα· τοῖο δ’ ἰόντος,",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἦ τ’ ἂν ἐυξείνοισι διὲξ ἁλὸς ἀντιάοιτε",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "ἀνδράσιν, ὄφρ’ αὐτοῖο ποτὶ στόμα Θερμώδοντος. 805",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "νόσφι δὲ Τυνδαρίδαις Ἀχερουσίδος ὑψόθεν ἄκρης",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "εἵσομαι ἱερὸν αἰπύ· τὸ μὲν μάλα τηλόθι πάντες",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "ναυτίλοι ἂμ πέλαγος θηεύμενοι ἱλάξονται·",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "καί κέ σφιν μετέπειτα πρὸ ἄστεος, οἷα θεοῖσιν,",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "πίονας εὐαρότοιο γύας πεδίοιο ταμοίμην.» 810",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": ":Ὧς τότε μὲν δαῖτ’ ἀμφὶ πανήμεροι ἑψιόωντο.",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ἦρί γε μὴν ἐπὶ νῆα κατήισαν ἐγκονέοντες·",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "καὶ δ’ αὐτὸς σὺν τοῖσι Λύκος κίε, μυρί’ ὀπάσσας",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "δῶρα φέρειν· ἅμα δ’ υἷα δόμων ἔκπεμπε νέεσθαι.",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "Ἔνθα δ’ Ἀβαντιάδην πεπρωμένη ἤλασε μοῖρα 815",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "Ἴδμονα, μαντοσύνῃσι κεκασμένον. ἀλλά μιν οὔτι",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "μαντοσύναι ἐσάωσαν, ἐπεὶ χρεὼ ἦγε δαμῆναι·",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "κεῖτο γὰρ εἱαμενῇ δονακώδεος ἐν ποταμοῖο",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "ψυχόμενος λαγόνας τε καὶ ἄσπετον ἰλύι νηδὺν",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "κάπριος ἀργιόδων, ὀλοὸν τέρας, ὅν ῥα καὶ αὐταὶ 820",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "νύμφαι ἑλειονόμοι ὑπεδείδισαν· οὐδέ τις ἀνδρῶν",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    },
    {
      "text": "ἠείδει· οἶος δὲ κατὰ πλατὺ βόσκετο τῖφος.",
      "cleaned_line": 33,
      "index": 31,
      "usable": true
    }
  ],
