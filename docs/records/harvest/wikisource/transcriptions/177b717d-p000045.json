  "lines": [
    {
      "text": "ΤΑΦΟΙ",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "::::«Ἑλένη Σ. Λάμαρη 1878—1912. Ποιήτρια",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": ":::καὶ μουσικός. Ἐπέθανε μὲ τοὺς φριχτότερους",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": ":::πόνους στὸ σῶμα καὶ μὲ τὴ μεγαλείτερη γαλήνη",
      "cleaned_line": 4,
      "index": 3,
      "usable": true
    },
    {
      "text": ":::στὴν ψυχή».",
      "cleaned_line": 5,
      "index": 4,
      "usable": true
    },
    {
      "text": "(Νεκροταφεῖο Ἀθηνῶν).|30%",
      "cleaned_line": 6,
      "index": 5,
      "usable": true
    },
    {
      "text": "Πόση ἡσυχία δωπέρα βασιλεύει!",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "Οἱ τάφοι λὲς κι αὐτοὶ χαμογελοῦνε,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἐνῶ μὲ κεφαλαῖα σιγὰ μιλοῦνε",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "οἱ νεκροὶ γράμματα, βαθιὰ στὰ ἐρέβη.",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ἀπὸ κεῖ, στὴν καρδιά μας ποὺ εἰρηνεύει,",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "μὲ ἁπλὰ θέλουνε λόγια ν' ἀνεβοῦνε.",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Μὰ τὸ παράπονο, ἡ ὅ,τι κι ἂν ποῦνε,",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "—τόσο ἔφυγαν μακριὰ—δὲ χρησιμεύει.",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    }
  ],
