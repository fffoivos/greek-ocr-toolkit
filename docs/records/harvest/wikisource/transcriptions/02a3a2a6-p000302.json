  "lines": [
    {
      "text": "Ἄχ, ἄχ! Τὸ στῆθός του πονεῖ,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": ":ῥιγοῦν τὰ κόκκαλά του!",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Σφραγὶς πιέζει μελανὴ",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": ":τὰ κρύα βλέφαρά του!",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Κι’ ὡς ὀπτασίαν του σβεστήν,",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "ὁρᾷ τὴν πρώτην του μνηστήν,",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": ":τὴν κόρη ποῦ προσμένει,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": ":ὡς νύμφ’ ἐνδεδυμένη.",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "Ἐκεῖ, ὁ κώδων τὸ τραχὺ",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": ":ἀνεῖπε λάλημά του·",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Κι’ εὐθὺς ἐτράπ’ ἡ ταραχὴ",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": ":εἰς σιωπὴν θανάτου!..",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Συντάσσετ’ ἄλλος ἀλλαχοῦ—",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "Ἠκούσθ’ ἡδεῖα πανταχοῦ",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": ":ᾠδὴ τῶν ἀλεκτόρων",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": ":ἐκ τῶν πλησιοχώρων!",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ντίγγ, ντίγγ! Ντίγγ, ντίγγ! “Ὑπομονή,",
      "cleaned_line": 20,
      "index": 16,
      "usable": true
    },
    {
      "text": ":κ’ ἦλθ’ ἡ στιγμὴ τοῦ γάμου·",
      "cleaned_line": 21,
      "index": 17,
      "usable": true
    },
    {
      "text": "κ’ ἐστρώθ’ ἡ κλίνη κ’ ἡδονὴ",
      "cleaned_line": 22,
      "index": 18,
      "usable": true
    },
    {
      "text": ":τοῦ νυμφικοῦ θαλάμου!”",
      "cleaned_line": 23,
      "index": 19,
      "usable": true
    },
    {
      "text": "Ὠχρόν, ψυχρόν, χωρὶς πνοῆς",
      "cleaned_line": 24,
      "index": 20,
      "usable": true
    },
    {
      "text": "τὸν νέον ἀπὸ καταγῆς",
      "cleaned_line": 25,
      "index": 21,
      "usable": true
    },
    {
      "text": ":ἐπ’ ὤμων των ἐπαίρουν",
      "cleaned_line": 26,
      "index": 22,
      "usable": true
    },
    {
      "text": ":καὶ τέσσαρες τὸν φέρουν.",
      "cleaned_line": 27,
      "index": 23,
      "usable": true
    }
