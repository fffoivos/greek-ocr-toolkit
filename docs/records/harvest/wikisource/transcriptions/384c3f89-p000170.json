  "lines": [
    {
      "text": "ὕστατον αὐτοὶ δ’ αὖτε Κυταιίδος ἤθεα γαίης",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "στύξαν, ἀτυζόμενοι χόλον ἄγριον Αἰήταο,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἔμπεδα δ’ ἄλλυδις ἄλλοι ἐφορμηθέντες ἔνασθεν.",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "οἱ μὲν ἐπ’ αὐτάων νήσων ἔβαν, ᾗσιν ἐπέσχον",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "ἥρωες, ναίουσι δ’ ἐπώνυμοι Ἀψύρτοιο· 515",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "οἱ δ’ ἄρ’ ἐπ’ Ἰλλυρικοῖο μελαμβαθέος ποταμοῖο,",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "τύμβος ἵν’ Ἁρμονίης Κάδμοιό τε, πύργον ἔδειμαν,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "ἀνδράσιν Ἐγχελέεσσιν ἐφέστιοι· οἱ δ’ ἐν ὄρεσσιν",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἐνναίουσιν, ἅπερ τε Κεραύνια κικλήσκονται,",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "ἐκ τόθεν, ἐξότε τούσγε Διὸς Κρονίδαο κεραυνοὶ 520",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "νῆσον ἐς ἀντιπέραιαν ἀπέτραπον ὁρμηθῆναι.",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": ":Ἥρωες δ’, ὅτε δή σφιν ἐείσατο νόστος ἀπήμων,",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "δή ῥα τότε προμολόντες ἐπὶ χθονὶ πείσματ’ ἔδησαν",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "Ὑλλήων. νῆσοι γὰρ ἐπιπρούχοντο θαμειαὶ",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "ἀργαλέην πλώουσιν ὁδὸν μεσσηγὺς ἔχουσαι. 525",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "οὐδέ σφιν, ὡς καὶ πρίν, ἀνάρσια μητιάασκον",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ὑλλῆες· πρὸς δ’ αὐτοὶ ἐμηχανόωντο κέλευθον,",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "μισθὸν ἀειρόμενοι τρίποδα μέγαν Ἀπόλλωνος.",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "δοιοὺς γὰρ τρίποδας τηλοῦ πόρε Φοῖβος ἄγεσθαι",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "Αἰσονίδῃ περόωντι κατὰ χρέος, ὁππότε Πυθὼ 530",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "ἱρὴν πευσόμενος μετεκίαθε τῆσδ’ ὑπὲρ αὐτῆς",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ναυτιλίης· πέπρωτο δ’, ὅπῃ χθονὸς ἱδρυνθεῖεν,",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "μήποτε τὴν δῄοισιν ἀναστήσεσθαι ἰοῦσιν.",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "τούνεκεν εἰσέτι νῦν κείνῃ ὅδε κεύθεται αἴῃ",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "ἀμφὶ πόλιν ἀγανὴν Ὑλληίδα, πολλὸν ἔνερθεν 535",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "οὔδεος, ὥς κεν ἄφαντος ἀεὶ μερόπεσσι πέλοιτο.",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "οὐ μὲν ἔτι ζώοντα καταυτόθι τέτμον ἄνακτα",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "Ὕλλον, ὃν εὐειδὴς Μελίτη τέκεν Ἡρακλῆι",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "δήμῳ Φαιήκων. ὁ γὰρ οἰκία Ναυσιθόοιο",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "Μάκριν τ’ εἰσαφίκανε, Διωνύσοιο τιθήνην, 540",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "νιψόμενος παίδων ὀλοὸν φόνον· ἔνθ’ ὅγε κούρην",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
