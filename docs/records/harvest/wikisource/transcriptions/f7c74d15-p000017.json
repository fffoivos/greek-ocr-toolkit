  "lines": [
    {
      "text": "ΕΡΩΤΑΣ ΠΡΟΣ ΤΟ ΠΑΡΕΛΘΟΝ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "Δέντρο τοῦ κακοῦ ὀνείρου",
      "cleaned_line": 6,
      "index": 1,
      "usable": true
    },
    {
      "text": "Πλάσμα τῆς ἀπατηλῆς ἀναμονῆς·",
      "cleaned_line": 7,
      "index": 2,
      "usable": true
    },
    {
      "text": "Τέτοιο τὸ παράστημα τοῦ χρόνου",
      "cleaned_line": 8,
      "index": 3,
      "usable": true
    },
    {
      "text": "Σὰν ξεχείλησε, καὶ ἤπιανε οἱ ρίζες",
      "cleaned_line": 9,
      "index": 4,
      "usable": true
    },
    {
      "text": "Τῆς ἁμαρτωλῆς μας παρουσίας",
      "cleaned_line": 10,
      "index": 5,
      "usable": true
    },
    {
      "text": "Φεύγω τὴν ἤρεμη πηγή",
      "cleaned_line": 12,
      "index": 6,
      "usable": true
    },
    {
      "text": "Ὅπου σταλάζει τὸ μυριόφωνο φαρμάκι",
      "cleaned_line": 13,
      "index": 7,
      "usable": true
    },
    {
      "text": "Τὴν ἀσημένια ζωὴ τοῦ παραδείσου",
      "cleaned_line": 14,
      "index": 8,
      "usable": true
    },
    {
      "text": "Μὲ τὴ μορφὴ τοῦ πρώτου μας καιροῦ",
      "cleaned_line": 15,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ποῦ τὸ ὑπερφίαλο ἀληθινὸ χρυσάφι",
      "cleaned_line": 17,
      "index": 10,
      "usable": true
    },
    {
      "text": "Τῆς οὐσίας, ποὺ μοιάζει μὲ τὸ αἷμα",
      "cleaned_line": 18,
      "index": 11,
      "usable": true
    },
    {
      "text": "Καὶ στίλβει ὅπως ἡ μυθικὴ καρδιά μας;",
      "cleaned_line": 19,
      "index": 12,
      "usable": true
    },
    {
      "text": "Τὰ μάτια ἐπλημμύρησαν ἀγάπη",
      "cleaned_line": 20,
      "index": 13,
      "usable": true
    },
    {
      "text": "Ἀλλὰ δὲν εἶδαν πουθενά",
      "cleaned_line": 21,
      "index": 14,
      "usable": true
    },
    {
      "text": "Τὰ ψυχικά μας δάκρυα",
      "cleaned_line": 22,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ὤ, τὸ πουλί",
      "cleaned_line": 24,
      "index": 16,
      "usable": true
    },
    {
      "text": "Ποὺ τραγούδαγε στὰ δειλινά",
      "cleaned_line": 25,
      "index": 17,
      "usable": true
    },
    {
      "text": "Ζεσταίνοντας τὴν προσευχή μας,",
      "cleaned_line": 26,
      "index": 18,
      "usable": true
    },
    {
      "text": "Πέταξε μακρυὰ",
      "cleaned_line": 27,
      "index": 19,
      "usable": true
    },
    {
      "text": "Ἢ τὸ κατάπιε ὁ ἄνεμος τῆς δύσης!",
      "cleaned_line": 28,
      "index": 20,
      "usable": true
    },
    {
      "text": "Σὰν ὀρφανοὶ προσβλέπουμε τὴ χώρα,",
      "cleaned_line": 29,
      "index": 21,
      "usable": true
    },
    {
      "text": "Τὴν πράσινη καὶ μαλακή μας φύση",
      "cleaned_line": 30,
      "index": 22,
      "usable": true
    },
    {
      "text": "Τὸν ἄμυαλο οὐρανό",
      "cleaned_line": 31,
      "index": 23,
      "usable": true
    }
  ],
