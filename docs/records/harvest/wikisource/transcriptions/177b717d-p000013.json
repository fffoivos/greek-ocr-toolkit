  "lines": [
    {
      "text": "⁂",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ὅλα τὰ πράγματά μου ἔμειναν ὅπως",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "νἄχω πεθάνει πρὶν ἀπὸ καιρούς.",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "Σκόνη στὴ σκόνη ἐγέμισεν ὁ τόπος,",
      "cleaned_line": 4,
      "index": 3,
      "usable": true
    },
    {
      "text": "καὶ γράφω μὲ τὸ δάχτυλο σταυρούς.",
      "cleaned_line": 5,
      "index": 4,
      "usable": true
    },
    {
      "text": "Ὅλα τὰ πράγματά μου ἀναθυμοῦνται",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "μιὰν ὥρα ποὺ περάσαμε μαζί,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "σ' ἐκείνη τὰ βιβλία μου λησμονοῦνται,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "σ' ἐκείνη τὸ ρολόι ἀκόμα ζῆ.",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "Ἤταν εὐτυχισμένη τότε ἡ ὥρα,",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἤταν ἕνα δείλι ζωγραφιστό.",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "Ἔχω πεθάνει τόσα χρόνια τώρα,",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "κ' ἔμεινε τὸ παράθυρο κλειστό.",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    }
  ],
