  "lines": [
    {
      "text": "ΠΑΘΟΣ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "Τὸ λάγνο παρελθὸν ὑπάρχει",
      "cleaned_line": 7,
      "index": 1,
      "usable": true
    },
    {
      "text": "Κρυμμένο στὴν οὐσία μας,",
      "cleaned_line": 8,
      "index": 2,
      "usable": true
    },
    {
      "text": "Γέμει τ’ ἀποσταμένα σωθικά",
      "cleaned_line": 9,
      "index": 3,
      "usable": true
    },
    {
      "text": "Ἁπλώνει τὴν ἀνησυχία του",
      "cleaned_line": 11,
      "index": 4,
      "usable": true
    },
    {
      "text": "Ὅπου, σὲ μελιχρὸ ὀργασμό,",
      "cleaned_line": 12,
      "index": 5,
      "usable": true
    },
    {
      "text": "Πάλλεται ἡ ἀγάπη",
      "cleaned_line": 13,
      "index": 6,
      "usable": true
    },
    {
      "text": "Ὅπου ὀαριστές",
      "cleaned_line": 15,
      "index": 7,
      "usable": true
    },
    {
      "text": "Προχώρησαν σὲ ἄλλη ζωή",
      "cleaned_line": 16,
      "index": 8,
      "usable": true
    },
    {
      "text": "Οἱ τρυφερές",
      "cleaned_line": 17,
      "index": 9,
      "usable": true
    },
    {
      "text": "Πεθαμένες ἡμέρες",
      "cleaned_line": 18,
      "index": 10,
      "usable": true
    },
    {
      "text": "(Καὶ λέγουνε σύμψυχα τὴ χαρά",
      "cleaned_line": 20,
      "index": 11,
      "usable": true
    },
    {
      "text": "Στ’ ἀόρατα,",
      "cleaned_line": 21,
      "index": 12,
      "usable": true
    },
    {
      "text": "Φρόνιμα, σὰν μυστικό",
      "cleaned_line": 22,
      "index": 13,
      "usable": true
    },
    {
      "text": "Ποὺ ἡ αἴγλη του καίει)",
      "cleaned_line": 23,
      "index": 14,
      "usable": true
    },
    {
      "text": "Ἔτσι, τὸ ἔρημο παρελθόν",
      "cleaned_line": 25,
      "index": 15,
      "usable": true
    },
    {
      "text": "Στ’ ἄγνωρα τῆς ἡδονῆς",
      "cleaned_line": 26,
      "index": 16,
      "usable": true
    },
    {
      "text": "Βγαίνει",
      "cleaned_line": 27,
      "index": 17,
      "usable": true
    },
    {
      "text": "Κι ἄναυδο ἐπιστρέφει σὲ μᾶς",
      "cleaned_line": 28,
      "index": 18,
      "usable": true
    },
    {
      "text": "Σέρνοντας τὴν εὐαίσθητη φωνή",
      "cleaned_line": 30,
      "index": 19,
      "usable": true
    },
    {
      "text": "Τῆς συνουσίας·",
      "cleaned_line": 31,
      "index": 20,
      "usable": true
    },
    {
      "text": "Κείνη θὰ προσηλώσει τὴν ψυχή",
      "cleaned_line": 32,
      "index": 21,
      "usable": true
    },
    {
      "text": "Στὸ ἄηθες παράπονο τοῦ χρόνου,",
      "cleaned_line": 33,
      "index": 22,
      "usable": true
    },
    {
      "text": "Κείνη ποὺ ἐξημέρωσε τὸ αὐτί",
      "cleaned_line": 35,
      "index": 23,
      "usable": true
    }
  ],
