  "lines": [
    {
      "text": "ΔΙΟΝΥΣΟΥ ΠΛΟΥΣ",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ἡ ἔκτασις τοῦ ἀχανοῦς",
      "cleaned_line": 6,
      "index": 1,
      "usable": true
    },
    {
      "text": "::Αἰγαίου ἐκοιμᾶτο,",
      "cleaned_line": 7,
      "index": 2,
      "usable": true
    },
    {
      "text": "κ' ἔβλεπες δύω οὐρανούς·",
      "cleaned_line": 8,
      "index": 3,
      "usable": true
    },
    {
      "text": "ὁ εἷς ἦν ἄνω κυανοῦς,",
      "cleaned_line": 9,
      "index": 4,
      "usable": true
    },
    {
      "text": "::γλαυκὸς ὁ ἄλλος κάτω.",
      "cleaned_line": 10,
      "index": 5,
      "usable": true
    },
    {
      "text": "Αἱ διαλείπουσαι πνοαὶ",
      "cleaned_line": 12,
      "index": 6,
      "usable": true
    },
    {
      "text": "::τοῦ ἔαρος ἐφύσων",
      "cleaned_line": 13,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἀμφίβολοι καὶ ἀραιαί·",
      "cleaned_line": 14,
      "index": 8,
      "usable": true
    },
    {
      "text": "μακρὰν δ' ἐφαίνοντ' ὡς σκιαὶ",
      "cleaned_line": 15,
      "index": 9,
      "usable": true
    },
    {
      "text": "::αἱ κορυφαὶ τῶν νήσων.",
      "cleaned_line": 16,
      "index": 10,
      "usable": true
    },
    {
      "text": "Ἡ δύσις, πύλη φλογερὰ,",
      "cleaned_line": 18,
      "index": 11,
      "usable": true
    },
    {
      "text": "::λαμπρὰς ἀντανακλάσεις",
      "cleaned_line": 19,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἠκόντιζεν εἰς τὰ νερὰ,",
      "cleaned_line": 20,
      "index": 13,
      "usable": true
    },
    {
      "text": "ὡς ἄν ἐνέμοντο πυρὰ",
      "cleaned_line": 21,
      "index": 14,
      "usable": true
    },
    {
      "text": "::τὴν πλάκα τῆς θαλάσσης.",
      "cleaned_line": 22,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ἀλλ’ ὅπου νότος εἰς γλαυκὰς",
      "cleaned_line": 24,
      "index": 16,
      "usable": true
    },
    {
      "text": "::ταινίας τὴν ἐῤῥίκνου,",
      "cleaned_line": 25,
      "index": 17,
      "usable": true
    },
    {
      "text": "τί ἦτον; ὄρνις ἢ ὀλκὰς,",
      "cleaned_line": 26,
      "index": 18,
      "usable": true
    },
    {
      "text": "ἥτις ἐτάννυε λευκὰς",
      "cleaned_line": 27,
      "index": 19,
      "usable": true
    },
