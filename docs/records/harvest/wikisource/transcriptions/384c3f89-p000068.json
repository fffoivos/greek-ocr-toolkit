  "lines": [
    {
      "text": "ἱδρῶ ἅλις, καματηρὸν ἀυτμένα φυσιόωντε.",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "ἂψ δ’ αὖτις συνόρουσαν ἐναντίοι, ἠύτε ταύρω",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "φορβάδος ἀμφὶ βοὸς κεκοτηότε δηριάασθον.",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ἔνθα δ’ ἔπειτ’ Ἄμυκος μὲν ἐπ’ ἀκροτάτοισιν ἀερθείς, 90",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "βουτύπος οἷα, πόδεσσι τανύσσατο, κὰδ δὲ βαρεῖαν",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "χεῖρ’ ἐπὶ οἷ πελέμιξεν· ὁ δ’ ἀίξαντος ὑπέστη,",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "κρᾶτα παρακλίνας, ὤμῳ δ’ ἀνεδέξατο πῆχυν",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "τυτθόν· ὁ δ’ ἄγχ’ αὐτοῖο παρὲκ γόνυ γουνὸς ἀμείβων",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "κόψε μεταΐγδην ὑπὲρ οὔατος, ὀστέα δ’ εἴσω 95",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "ῥῆξεν· ὁ δ’ ἀμφ’ ὀδύνῃ γνὺξ ἤριπεν· οἱ δ’ ἰάχησαν",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἥρωες Μινύαι· τοῦ δ’ ἀθρόος ἔκχυτο θυμός.",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": ":Οὐδ’ ἄρα Βέβρυκες ἄνδρες ἀφείδησαν βασιλῆος·",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "ἀλλ’ ἄμυδις κορύνας ἀζηχέας ἠδὲ σιγύννους",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἰθὺς ἀνασχόμενοι Πολυδεύκεος ἀντιάασκον. 100",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "τοῦ δὲ πάρος κολεῶν εὐήκεα φάσγαν’ ἑταῖροι",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "ἔσταν ἐρυσσάμενοι. πρῶτός γε μὲν ἀνέρα Κάστωρ",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "ἤλασ’ ἐπεσσύμενον κεφαλῆς ὕπερ· ἡ δ’ ἑκάτερθεν",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἔνθα καὶ ἔνθ’ ὤμοισιν ἐπ’ ἀμφοτέροις ἐκεάσθη.",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "αὐτὸς δ’ Ἰτυμονῆα πελώριον ἠδὲ Μίμαντα, 105",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "τὸν μὲν ὑπὸ στέρνοιο θοῷ ποδὶ λὰξ ἐπορούσας",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "πλῆξε, καὶ ἐν κονίῃσι βάλεν· τοῦ δ’ ἆσσον ἰόντος",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "δεξιτερῇ σκαιῆς ὑπὲρ ὀφρύος ἤλασε χειρί,",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "δρύψε δέ οἱ βλέφαρον, γυμνὴ δ’ ὑπελείπετ’ ὀπωπή.",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "Ὠρεΐδης δ’ Ἀμύκοιο βίην ὑπέροπλος ὀπάων 110",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "οὖτα Βιαντιάδαο κατὰ λαπάρην Ταλαοῖο,",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "ἀλλά μιν οὐ κατέπεφνεν, ὅσον δ’ ἐπὶ δέρματι μοῦνον",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "νηδυίων ἄψαυστος ὑπὸ ζώνην θόρε χαλκός.",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "αὔτως δ’ Ἄρητος μενεδήιον Εὐρύτου υἷα",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "Ἴφιτον ἀζαλέῃ κορύνῃ στυφέλιξεν ἐλάσσας, 115",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "οὔπω κηρὶ κακῇ πεπρωμένον· ἦ τάχ’ ἔμελλεν",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "αὐτὸς δῃώσεσθαι ὑπὸ ξίφεϊ Κλυτίοιο.",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
