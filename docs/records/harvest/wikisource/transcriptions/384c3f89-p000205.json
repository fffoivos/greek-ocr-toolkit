  "lines": [
    {
      "text": "εἴτε σέγε Τρίτων’, ἅλιον τέρας, εἴτε σε Φόρκυν,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "ἢ Νηρῆα θύγατρες ἐπικλείουσ’ ἁλοσύδναι,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἵλαθι, καὶ νόστοιο τέλος θυμηδὲς ὄπαζε.» 1600",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": ":Ἦ ῥ’, ἅμα δ’ εὐχωλῇσιν ἐς ὕδατα λαιμοτομήσας",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "ἧκε κατὰ πρύμνης· ὁ δὲ βένθεος ἐξεφαάνθη",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "τοῖος ἐών, οἷός περ ἐτήτυμος ἦεν ἰδέσθαι.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "ὡς δ’ ὅτ’ ἀνὴρ θοὸν ἵππον ἐς εὐρέα κύκλον ἀγῶνος",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "στέλλῃ, ὀρεξάμενος λασίης εὐπειθέα χαίτης, 1605",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "εἶθαρ ἐπιτροχάων, ὁ δ’ ἐπ’ αὐχένι γαῦρος ἀερθεὶς",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "ἕσπεται, ἀργινόεντα δ’ ἐνὶ στομάτεσσι χαλινὰ",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἀμφὶς ὀδακτάζοντι παραβλήδην κροτέονται·",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "ὧς ὅγ’ ἐπισχόμενος γλαφυρῆς ὁλκήιον Ἀργοῦς",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "ἦγ’ ἅλαδε προτέρωσε. δέμας δέ οἱ ἐξ ὑπάτοιο 1610",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "κράατος, ἀμφί τε νῶτα καὶ ἰξύας ἔστ’ ἐπὶ νηδὺν",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "ἀντικρὺ μακάρεσσι φυὴν ἔκπαγλον ἔικτο·",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "αὐτὰρ ὑπαὶ λαγόνων δίκραιρά οἱ ἔνθα καὶ ἔνθα",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "κήτεος ὁλκαίη μηκύνετο· κόπτε δ’ ἀκάνθαις",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἄκρον ὕδωρ, αἵ τε σκολιοῖς ἐπινειόθι κέντροις 1615",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "μήνης ὡς κεράεσσιν ἐειδόμεναι διχόωντο.",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "τόφρα δ’ ἄγεν, τείως μιν ἐπιπροέηκε θαλάσσῃ",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "νισσομένην· δῦ δ’ αἶψα μέγαν βυθόν· οἱ δ’ ὁμάδησαν",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ἥρωες, τέρας αἰνὸν ἐν ὀφθαλμοῖσιν ἰδόντες.",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "ἔνθα μὲν Ἀργῷός τε λιμὴν καὶ σήματα νηὸς 1620",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "ἠδὲ Ποσειδάωνος ἰδὲ Τρίτωνος ἔασιν",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "βωμοί· ἐπεὶ κεῖν’ ἦμαρ ἐπέσχεθον. αὐτὰρ ἐς ἠῶ",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "λαίφεσι πεπταμένοις αὐτὴν ἐπὶ δεξί’ ἔχοντες",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "γαῖαν ἐρημαίην, πνοιῇ ζεφύροιο θέεσκον.",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "ἦρι δ’ ἔπειτ’ ἀγκῶνά θ’ ὁμοῦ μυχάτην τε θάλασσαν 1625",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "κεκλιμένην ἀγκῶνος ὕπερ προύχοντος ἴδοντο.",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "αὐτίκα δὲ ζέφυρος μὲν ἐλώφεεν, ἤλυθε δ’ αὔρη",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "ἀργέσταο νότου· κεχάροντο δὲ θυμὸν ἰωῇ.",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
