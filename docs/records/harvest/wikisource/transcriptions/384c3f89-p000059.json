  "lines": [
    {
      "text": "αἱ μέν, ὅσαι σκοπιὰς ὀρέων λάχον ἢ καὶ ἐναύλους,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "αἵγε μὲν ὑλήωροι ἀπόπροθεν ἐστιχόωντο,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἡ δὲ νέον κρήνης ἀνεδύετο καλλινάοιο",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "νύμφη ἐφυδατίη· τὸν δὲ σχεδὸν εἰσενόησεν",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "κάλλεϊ καὶ γλυκερῇσιν ἐρευθόμενον χαρίτεσσιν. 1230",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "πρὸς γάρ οἱ διχόμηνις ἀπ’ αἰθέρος αὐγάζουσα",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "βάλλε σεληναίη. τὴν δὲ φρένας ἐπτοίησεν",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "Κύπρις, ἀμηχανίῃ δὲ μόλις συναγείρατο θυμόν.",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "αὐτὰρ ὅγ’ ὡς τὰ πρῶτα ῥόῳ ἔνι κάλπιν ἔρεισεν",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "λέχρις ἐπιχριμφθείς, περὶ δ’ ἄσπετον ἔβραχεν ὕδωρ 1235",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "χαλκὸν ἐς ἠχήεντα φορεύμενον, αὐτίκα δ’ ἥγε",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "λαιὸν μὲν καθύπερθεν ἐπ’ αὐχένος ἄνθετο πῆχυν",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "κύσσαι ἐπιθύουσα τέρεν στόμα· δεξιτερῇ δὲ",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἀγκῶν’ ἔσπασε χειρί, μέσῃ δ’ ἐνικάββαλε δίνῃ.",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "Τοῦ δ’ ἥρως ἰάχοντος ἐπέκλυεν οἶος ἑταίρων 1240",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "Εἰλατίδης Πολύφημος, ἰὼν προτέρωσε κελεύθου,",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "δέκτο γὰρ Ἡρακλῆα πελώριον, ὁππόθ’ ἵκοιτο.",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "βῆ δὲ μεταΐξας Πηγέων σχεδόν, ἠύτε τις θὴρ",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "ἄγριος, ὅν ῥά τε γῆρυς ἀπόπροθεν ἵκετο μήλων,",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "λιμῷ δ’ αἰθόμενος μετανίσσεται, οὐδ’ ἐπέκυρσεν 1245",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "ποίμνῃσιν· πρὸ γὰρ αὐτοὶ ἐνὶ σταθμοῖσι νομῆες",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ἔλσαν· ὁ δὲ στενάχων βρέμει ἄσπετον, ὄφρα κάμῃσιν·",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "ὧς τότ’ ἄρ’ Εἰλατίδης μεγάλ’ ἔστενεν, ἀμφὶ δὲ χῶρον",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "φοίτα κεκληγώς· μελέη δέ οἱ ἔπλετο φωνή.",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "αἶψα δ’ ἐρυσσάμενος μέγα φάσγανον ὦρτο δίεσθαι, 1250",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "μήπως ἢ θήρεσσιν ἕλωρ πέλοι, ἠέ μιν ἄνδρες",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "μοῦνον ἐόντ’ ἐλόχησαν, ἄγουσι δὲ ληίδ’ ἑτοίμην.",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "ἔνθ’ αὐτῷ ξύμβλητο κατὰ στίβον Ἡρακλῆι",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "γυμνὸν ἐπαΐσσων παλάμῃ ξίφος· εὖ δέ μιν ἔγνω",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "σπερχόμενον μετὰ νῆα διὰ κνέφας. αὐτίκα δ’ ἄτην 1255",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "ἔκφατο λευγαλέην, βεβαρημένος ἄσθματι θυμόν·",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
