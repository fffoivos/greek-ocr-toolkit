  "lines": [
    {
      "text": "ΑΣΤΕΡΙ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ἀστέρι στὸ ὕπαιθρο ἀναμονή",
      "cleaned_line": 7,
      "index": 1,
      "usable": true
    },
    {
      "text": "Μοναχοί μας",
      "cleaned_line": 8,
      "index": 2,
      "usable": true
    },
    {
      "text": "Μελαγχολικὸ πνεῦμα κατοικεῖ τὴν ψυχή",
      "cleaned_line": 9,
      "index": 3,
      "usable": true
    },
    {
      "text": "Λείπει ἡ σελήνη ἀπὸ τὸν οὐρανό",
      "cleaned_line": 10,
      "index": 4,
      "usable": true
    },
    {
      "text": "Χάνει ἡ φωνὴ τοῦ ἀνθρώπου",
      "cleaned_line": 11,
      "index": 5,
      "usable": true
    },
    {
      "text": "Τὴ μυρωδιά της",
      "cleaned_line": 12,
      "index": 6,
      "usable": true
    },
    {
      "text": "Πέφτει ἀπ’ τὸ στερέωμα τὸ ἀστέρι",
      "cleaned_line": 14,
      "index": 7,
      "usable": true
    },
    {
      "text": "Ρυτιδώνει τήν ψυχή",
      "cleaned_line": 15,
      "index": 8,
      "usable": true
    },
    {
      "text": "Τὴ φωνή μας",
      "cleaned_line": 16,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ὅμως ἡ μοναξιὰ τέρπεται",
      "cleaned_line": 17,
      "index": 10,
      "usable": true
    },
    {
      "text": "Ὁδηγεῖ κύματα τὴν ἡδονή",
      "cleaned_line": 18,
      "index": 11,
      "usable": true
    },
    {
      "text": "Στ’ ἀνοιχτὰ τῆς ὕπαρξης",
      "cleaned_line": 19,
      "index": 12,
      "usable": true
    },
    {
      "text": "Στὰ ἐνδόμυχα",
      "cleaned_line": 20,
      "index": 13,
      "usable": true
    },
    {
      "text": "Τῆς μελλούμενης σιωπηλῆς ζωής",
      "cleaned_line": 21,
      "index": 14,
      "usable": true
    }
