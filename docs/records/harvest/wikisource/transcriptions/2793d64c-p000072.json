  "lines": [
    {
      "text": ":»Σὺ δέ, τὸν κείμενον ἐπιτρέψας",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "εἰς τὴν προφύλαξιν τῶν θεῶν,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "εὐθὺς ἀνάγγειλον ἐπιστρέψας",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "τὴν σωτηρίαν εἰς τὸν λαόν.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Κανεὶς τῆς πόλεως μὴ προβάλῃ,",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "μηδ’ ἀνανδρίας κραυγὴν ἐκβάλῃ.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Ἅμα δ’ ἀρθεῖσα φαιδρὰ ἡμέρα",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "τὰς ἀκρωρείας ἐπιχρυσοῖ,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἐλθὲ καὶ ζήτησον τὸν πατέρα",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "κῆρυξ μετ’ ἄλλων κηρύκων σύ.»",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": ":Ὡς ὑψιτράχηλος, ὑπ’ ἀκτίνων·",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "λαμπροῦ Φαέθοντος θερμανθείς,",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "βρέχετ’ ὁ Καύκασος, ὑπαφίνων",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "ψυχροὺς χειμάρρους πολυβαθεῖς,",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": "οὕτως ὁ Μέδων μὲ βλέμμα κρύον",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": "πρὸ τῆς Παλλάδος μένει δακρύων.",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
