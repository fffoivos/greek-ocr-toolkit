  "lines": [
    {
      "text": "Ἐκπνέει, θνήσκει θλιβερὰ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": ":ἡ λάμψις τῶν λαμπάδων·",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἀργὰ τὸν ῥύακα περᾷ",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": ":ὁ θίασός των ᾄδων.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Κι’ ἀπὸ φαράγγων σκοτεινῶν,",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "ἀναρριχῶντ’ ἐπὶ βουνῶν",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": ":καὶ βράχων ἀποκρήμνων,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": ":μετ’ ἐκλειπόντων ὕμνων.",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "Ἡ μήτηρ οἴκοι προσδοκᾷ,",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": ":κ’ ἡ νύμφη περιμένει·",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "καὶ χαίρ’ εἰς ὄνειρα γλυκὰ",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": ":κ’ ἐλπίδας πλανωμένη.",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Λαμπρὸς μαρμαίρ’ Αὐγερινός·",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἐρυθριῶν ὁ οὐρανὸς",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": ":τὴν ἑορτὴν φωτίζει,",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": ":ἀλλ’ ὁ γαμβρὸς χρονίζει.",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
      "text": "Δουποῦσι βήματα γοργά,",
      "cleaned_line": 20,
      "index": 16,
      "usable": true
    },
    {
      "text": ":ἡ προσδοκί’ αὐξάνει.",
      "cleaned_line": 21,
      "index": 17,
      "usable": true
    },
    {
      "text": "Ἦν ὄρθρος, ἔφεξ’, εἶν’ ἀργά—",
      "cleaned_line": 22,
      "index": 18,
      "usable": true
    },
    {
      "text": ":Τὸ Φῶς των δὲν ἐφάνη!",
      "cleaned_line": 23,
      "index": 19,
      "usable": true
    },
    {
      "text": "Ἡ νύμφη ἔχει κοσμηθῆ,",
      "cleaned_line": 24,
      "index": 20,
      "usable": true
    },
    {
      "text": "κι’ ὁ ἱερεὺς ἔχ’ ἐνδυθῆ.",
      "cleaned_line": 25,
      "index": 21,
      "usable": true
    },
    {
      "text": ":Ἡ μήτηρ δὲν ἀντέχει,",
      "cleaned_line": 26,
      "index": 22,
      "usable": true
    },
    {
      "text": ":νὰ τ’ ἀπαντήσῃ τρέχει...",
      "cleaned_line": 27,
      "index": 23,
      "usable": true
    }
  ],
