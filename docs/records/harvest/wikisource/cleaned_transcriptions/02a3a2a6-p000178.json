  "lines": [
    {
      "text": "Χθεσινὰ θαρρεῖς ὁποῦναι!",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": ":Ὄνειρ’ ἀπὸ ’ψὲς καθάρια.",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Καὶ σὰν ἔφεξε, πετοῦνε",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": ":καὶ σπιθοβολοῦν ἀνάρῃα!...",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Διές ὁ κόσμος πῶς ἀλλάζει!",
      "cleaned_line": 7,
      "index": 4,
      "usable": true
    },
    {
      "text": ":Πῶς ’μεῖς ἤμεθα παιδάκια,",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "ποῦ δὲν ’ξεῦραν μὲ τί ’μοιάζει",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": ":ἡ πονήρια καὶ ἡ κάκια!",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "Τώρα, δυὸ χρονῶ κουλοῦκι",
      "cleaned_line": 12,
      "index": 8,
      "usable": true
    },
    {
      "text": ":ἐργολάβος μ’ ἔχει γένει·",
      "cleaned_line": 13,
      "index": 9,
      "usable": true
    },
    {
      "text": "καὶ πρὶν ἔβγ’ ἀπ’ τὸ μπουμποῦκι,",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": ":εἶν’ ἡ κόρ’ ἐρωτεμμένη!...",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "Ἔρωτα κ’ ἐγὼ ’χα πάθει,",
      "cleaned_line": 17,
      "index": 12,
      "usable": true
    },
    {
      "text": ":’κοσιδυὸ χρονῶ κοπέλι,",
      "cleaned_line": 18,
      "index": 13,
      "usable": true
    },
    {
      "text": "μἄγλειφα κρυφὰ τ’ ἀγκάθι,",
      "cleaned_line": 19,
      "index": 14,
      "usable": true
    },
    {
      "text": ":κι’ ἀποφύλαγα τὸ μέλι.",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ὣς νὰ πᾷ καὶ νὰ κερδήσῃ",
      "cleaned_line": 22,
      "index": 16,
      "usable": true
    },
    {
      "text": ":τὸ δουλευτικό μου χέρι,",
      "cleaned_line": 23,
      "index": 17,
      "usable": true
    },
    {
      "text": "κι’ ὁ παππᾶς νὰ μ’ εὐλογήσῃ,",
      "cleaned_line": 24,
      "index": 18,
      "usable": true
    },
    {
      "text": ":καὶ νὰ μοῦ τὴν δώσῃ ’ταῖρι.",
      "cleaned_line": 25,
      "index": 19,
      "usable": true
    },
    {
      "text": "Καὶ σὰν ἦρθ’ ἀπ’ τὸ ταξεῖδι,",
      "cleaned_line": 27,
      "index": 20,
      "usable": true
    },
    {
      "text": ":κι’ ἀλλαχθῆκαν δαχτυλίδια,",
      "cleaned_line": 28,
      "index": 21,
      "usable": true
    }
  ],
