  "lines": [
    {
      "text": "Ὁ Πλάστης τὸν καλοθωρεῖ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "καὶ τὸν ῥωτᾷ μὲ ἱλαρή,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": ":μὲ πατρικὴ φροντίδα:",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "“Ἁγι-Νικόλα, τὸ θωρῶ,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "εἶσαι βρεμμένος στὸ νερὸ",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": ":’ως ’πάνω στὴν κουρίδα!",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "“Ἂν ἦν’ ἀλήθει’ αὐτὸ ποῦ ’πῶ—",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "στὴν Μοσχοβιὰ εἶχες σκοπὸ",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": ":ξανὰ νὰ ταξιδεύσῃς.",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "Κ’ ἐπήγαινες κολυμβητά,",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "γιατὶ δὲν ἤθελες λεπτὰ",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": ":γιὰ ναῦλο νὰ ’ξοδεύσῃς!",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "“Ὁρίστε; Τόσο φειδωλοὶ",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "δὲν ’βρίσκοντ’ Ἅγιοι πολλοί!...",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": ":Ἀλλ’ ὅμως, δὲν θυμόνω.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Θὰ οἱκονόμησες ξανὰ",
      "cleaned_line": 19,
      "index": 15,
      "usable": true
    },
    {
      "text": "γιὰ νὰ προικίσῃς ὀρφανά,",
      "cleaned_line": 20,
      "index": 16,
      "usable": true
    },
    {
      "text": ":νὰ τὰ ’πανδρεύσῃς μόνο.”",
      "cleaned_line": 21,
      "index": 17,
      "usable": true
    },
    {
      "text": "Ἁγι-Νικόλας τουρτουρᾷ—",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "Σὰν ῥυάκια τρέχουν τὰ νερὰ",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": ":ἀπ’ τὸ χλωμὸ κορμί του!",
      "cleaned_line": 25,
      "index": 20,
      "usable": true
    },
    {
      "text": "Ὁ Πλάστης μιὰ τὸ βλέπ’ αὐτό,",
      "cleaned_line": 26,
      "index": 21,
      "usable": true
    },
    {
      "text": "καὶ μιὰ τηρᾷ τὸ κεντητὸ",
      "cleaned_line": 27,
      "index": 22,
      "usable": true
    },
    {
      "text": ":τοῦ σαλονιοῦ χαλί του...",
      "cleaned_line": 28,
      "index": 23,
      "usable": true
    }
