  "lines": [
    {
      "text": "Στὸν κίνδυνο, στὴν ταραχὴ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "δὲν βάλλω, ὁ μαῦρος, προσοχὴ",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": ":μόνο στιβάζω χῶμα.",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "Καὶ μέσ’ στὸν τάφο τὸν κοινὸ",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "σκεπάζω κ’ ἕνα Χριστιανό,",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": ":ποῦ ξεψυχοῦσ’ ἀκόμα!",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Ἄχ! Ἀπ’ τὴν γῆν τὴν σκοτεινὴ",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "ἀκούω τότε μιὰ φωνή.",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": ":“Μὲ θάφτεις πρὶν ’πεθάνω!",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "“Πρὶν εὐχηθῶ τὴν βασιλειά,",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "“καὶ διὰ κρίματα παλῃὰ",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": ":“τὴν προσευχή μου κάνω!”",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Ὠς νὰ τὸν ’βγάλω πεταχτός,",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "τὰ ἐκακάρωσε κι’ αὐτός,",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": ":σὰν τόσοι τόσοι ἄλλοι.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Μ’ ἀλλοίμονον! Εὐθὺς ἐκεῖ",
      "cleaned_line": 19,
      "index": 15,
      "usable": true
    },
    {
      "text": "μοὖρθε κατάρα θεϊκή,",
      "cleaned_line": 20,
      "index": 16,
      "usable": true
    },
    {
      "text": ":σὰν μιὰ βοὴ μεγάλη!",
      "cleaned_line": 21,
      "index": 17,
      "usable": true
    },
    {
      "text": "“Ἐσύ μ’ ἀπάνθρωπη καρδιά,",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "“ὅπου μοῦ θάφτεις τὰ παιδιά,",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": ":“πρὶν ἢ γενῇ ἀνάγκη,",
      "cleaned_line": 25,
      "index": 20,
      "usable": true
    },
    {
      "text": "“προστάζω νὰ μεταβληθῇς,",
      "cleaned_line": 26,
      "index": 21,
      "usable": true
    },
    {
      "text": "“κι’ ἀπ’ ἄνθρωπος, νὰ τυφλωθῇς",
      "cleaned_line": 27,
      "index": 22,
      "usable": true
    },
    {
      "text": ":“καὶ νὰ γενῇς Σπαλάγγι!”",
      "cleaned_line": 28,
      "index": 23,
      "usable": true
    }
  ],
