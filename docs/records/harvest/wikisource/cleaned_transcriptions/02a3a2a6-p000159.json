  "lines": [
    {
      "text": "φλόγαις τώρα ’βγάλλει",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": ":στ’ ἁψηλά!",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Φεύγω νὰ τ’ ἀφήσω—",
      "cleaned_line": 5,
      "index": 2,
      "usable": true
    },
    {
      "text": ":Δὲν ’μπορῶ:",
      "cleaned_line": 6,
      "index": 3,
      "usable": true
    },
    {
      "text": "Μὲ τραβᾷ ’πὸ ’πίσω",
      "cleaned_line": 7,
      "index": 4,
      "usable": true
    },
    {
      "text": ":’να μωρό.",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "Μὲ ξανθὰ μαλάκια,",
      "cleaned_line": 10,
      "index": 6,
      "usable": true
    },
    {
      "text": ":μὲ φτερά,",
      "cleaned_line": 11,
      "index": 7,
      "usable": true
    },
    {
      "text": "καὶ μὲ δυὸ ματάκια",
      "cleaned_line": 12,
      "index": 8,
      "usable": true
    },
    {
      "text": ":φλογερά.",
      "cleaned_line": 13,
      "index": 9,
      "usable": true
    },
    {
      "text": "“Τὸ ψυχρό σου στόμα",
      "cleaned_line": 15,
      "index": 10,
      "usable": true
    },
    {
      "text": ":δὲν ’μπορεῖ",
      "cleaned_line": 16,
      "index": 11,
      "usable": true
    },
    {
      "text": "νὰ τὸ σβύσ’ ἀκόμα",
      "cleaned_line": 17,
      "index": 12,
      "usable": true
    },
    {
      "text": ":τὸ κερί;”",
      "cleaned_line": 18,
      "index": 13,
      "usable": true
    },
    {
      "text": "Λέγει. Καὶ μὲ χά-χα!",
      "cleaned_line": 20,
      "index": 14,
      "usable": true
    },
    {
      "text": ":περισσά,",
      "cleaned_line": 21,
      "index": 15,
      "usable": true
    },
    {
      "text": "προσποιεῖται τάχα,",
      "cleaned_line": 22,
      "index": 16,
      "usable": true
    },
    {
      "text": ":πῶς φυσᾷ.",
      "cleaned_line": 23,
      "index": 17,
      "usable": true
    },
    {
      "text": "“Μὴ φυσᾷς, κοπέλι,",
      "cleaned_line": 25,
      "index": 18,
      "usable": true
    },
    {
      "text": ":στὴν πυρά!",
      "cleaned_line": 26,
      "index": 19,
      "usable": true
