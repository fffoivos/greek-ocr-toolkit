  "lines": [
    {
      "text": ":Τοῦ Φοίβου δύοντος ἀπεχώρει·",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "κ’ ἰδοὺ μετέωρον φωτεινόν,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "διολισθαῖνον ἀνὰ τὰ ὄρη,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ἐγκαταλείπει τὸν οὐρανόν.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Τὸν ἠκολούθησεν ὁ υἱός του,",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "τὸν ἡκολούθησεν ὁ λαός του,",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "ὅπως τὰ πρόβατα τὸν ποιμένα",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "μὲ κεκλιμένας τὰς κεφαλάς,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἐνῷ τὴν Φοίβην ἡ νὺξ ἐγέννα",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "πρὸς ὠχριώσας ἀνατολάς.",
