  },
  "lines": [
    {
      "text": "Μιὰ κωμωδία ἡ πλάση Του σὰν εἶναι φρικαλέα,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ἐκεῖνος, ποὺ ἔχει πάντοτε τὴν πρόθεση καλή,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "εὐδόκησε στὰ μάτια μας νὰ κατεβάση αὐλαία",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "—ὤ, κωμωδία!—τὸ θάμπωμα, τὄνειρο, τὴν ἀχλύ.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "...Κ’ ἤταν ὡραία ὡς σύνολο ἡ ἀγορασμένη φίλη,",
      "cleaned_line": 7,
      "index": 4,
      "usable": true
    },
    {
      "text": "στὸ δείλι αὐτὸ τοῦ μακρινοῦ πέρα χειμῶνος, ὅταν,",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "γελώντας αἰνιγματικά, μᾶς ἔδινε τὰ χείλη",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "κ' ἔβλεπε τὸ ἐνδεχόμενο, τὴν ἄβυσσο ποὺ ἐρχόταν.",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    }
  ],
