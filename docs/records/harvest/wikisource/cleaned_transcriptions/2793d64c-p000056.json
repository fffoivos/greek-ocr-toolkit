  "lines": [
    {
      "text": ":Ἔκφρων ὁ Μέδων τοιαῦτʾ ἀκουσας",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "πρὸς τὸν δεόμενον ἀπαντᾷ.",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "«Κανείς, ὦ γέρον, ἀπὸ τοῦ νοῦ σας",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "εἰς τί συμπέρασμα καταντᾷ;",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Ὅτι, τῷ χρόνῳ συμπροϊόντι,",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "γίγνεσθε παῖδες ὑμεῖς τῷ ὄντι.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Ἐν τούτοις σπεῦδε πεφυλαγμένως",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "σωτὴρ τεκνίων σου δυστυχῶν.»",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "Κʾ ἐξῆλθʾ ὁ γέρων κατεσπευσμένως,",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "τῆς εὐκαιρίας ἐπιτυχών.",
