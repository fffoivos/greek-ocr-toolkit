  "lines": [
    {
      "text": "λέξασθαι. κείνῳ γὰρ ἀεὶ τάδε ἔργα μέμηλεν,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "ἠὲ σὺν ἀθανάταις ἠὲ θνητῇσιν ἰαύειν. 795",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἀλλ’ ἐμὲ αἰδομένη καὶ ἐνὶ φρεσὶ δειμαίνουσα,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ἠλεύω· ὁ δ’ ἔπειτα πελώριον ὅρκον ὄμοσσεν,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "μήποτέ σ’ ἀθανάτοιο θεοῦ καλέεσθαι ἄκοιτιν.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "ἔμπης δ’ οὐ μεθίεσκεν ὀπιπεύων ἀέκουσαν,",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "εἰσότε οἱ πρέσβειρα Θέμις κατέλεξεν ἅπαντα, 800",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "ὡς δή τοι πέπρωται ἀμείνονα πατρὸς ἑοῖο",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "παῖδα τεκεῖν· τῶ καί σε λιλαιόμενος μεθέηκεν,",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "δείματι, μή τις ἑοῦ ἀντάξιος ἄλλος ἀνάσσοι",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἀθανάτων, ἀλλ’ αἰὲν ἑὸν κράτος εἰρύοιτο.",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "αὐτὰρ ἐγὼ τὸν ἄριστον ἐπιχθονίων πόσιν εἶναι 805",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "δῶκά τοι, ὄφρα γάμου θυμηδέος ἀντιάσειας,",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "τέκνα τε φιτύσαιο· θεοὺς δ’ ἐς δαῖτ’ ἐκάλεσσα",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "πάντας ὁμῶς· αὐτὴ δὲ σέλας χείρεσσιν ἀνέσχον",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "νυμφίδιον, κείνης ἀγανόφρονος εἵνεκα τιμῆς.",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "ἀλλ’ ἄγε καί τινά τοι νημερτέα μῦθον ἐνίψω. 810",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "εὖτ’ ἂν ἐς Ἠλύσιον πεδίον τεὸς υἱὸς ἵκηται,",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "ὃν δὴ νῦν Χείρωνος ἐν ἤθεσι Κενταύροιο",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "νηιάδες κομέουσι τεοῦ λίπτοντα γάλακτος,",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "χρειώ μιν κούρης πόσιν ἔμμεναι Αἰήταο",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "Μηδείης· σὺ δ’ ἄρηγε νυῷ ἑκυρή περ ἐοῦσα, 815",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "ἠδ’ αὐτῷ Πηλῆι. τί τοι χόλος ἐστήρικται;",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "ἀάσθη. καὶ γάρ τε θεοὺς ἐπινίσσεται ἄτη.",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "ναὶ μὲν ἐφημοσύνῃσιν ἐμαῖς Ἥφαιστον ὀίω",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "λωφήσειν πρήσοντα πυρὸς μένος, Ἱπποτάδην δὲ",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "Αἴολον ὠκείας ἀνέμων ἄικας ἐρύξειν, 820",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "νόσφιν ἐυσταθέος ζεφύρου, τείως κεν ἵκωνται",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "Φαιήκων λιμένας· σὺ δ’ ἀκηδέα μήδεο νόστον.",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "δεῖμα δέ τοι πέτραι καὶ ὑπέρβια κύματ’ ἔασιν",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "μοῦνον, ἅ κεν τρέψαιο κασιγνήτῃσι σὺν ἄλλαις.",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
