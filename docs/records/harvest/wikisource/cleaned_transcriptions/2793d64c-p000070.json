  "lines": [
    {
      "text": ":Κ’ ἤθελεν ἴσως τοῦ ἐξαρπάσει",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "ἀγρία ζάλη τὸ λογικόν,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἄν, ἀκατάληπτος τῇ ὁράσει,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "πνεῦμα συνέσεως μυστικὸν",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "εἰς τὴν ψυχήν του δὲν ἐνεφύσα",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "φίλη θεότης παρασταθεῖσα.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Συνῆλθε μόλις καὶ μετὰ βίας·",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "καί, τὸν πατέρα περιπτυχθείς,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "τρανῶς ἀνῴμωξεν ἐκ καρδίας,",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "εἰς μαῦρα δάκρυ’ ἀναλυθείς.",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": ":Τὴν οἰμωγήν του ἀπεμιμήθη",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "ἠχὼ στενάξασα θρηνῳδός,",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "καὶ τὸ στρατόπεδον ἐκινήθη",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "τῶν Δωριέων θορυβωδῶς·",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": "κ’ ἐδόθ’ ἐξαίφνης ἡ πόλις πᾶσα",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": "εἰς θρηνῳδίας, ἐξαναστᾶσα.",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ἀλλά, τοῦ Ἄστεως κηδομένη,",
      "cleaned_line": 19,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἐπέστη τέλος ἡ Ἀθηνᾶ,",
      "cleaned_line": 20,
      "index": 17,
      "usable": true
    },
    {
      "text": "(μόνω τῷ Μέδοντι φαινομένη,)",
      "cleaned_line": 21,
      "index": 18,
      "usable": true
    },
    {
      "text": "κ’ ἀπό τῆς νάρκης τὸν ἐξυπνᾷ.",
      "cleaned_line": 22,
      "index": 19,
      "usable": true
    }
  ],
