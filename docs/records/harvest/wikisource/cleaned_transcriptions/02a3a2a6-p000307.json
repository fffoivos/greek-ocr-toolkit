  "lines": [
    {
      "text": "Ὁ Θεὸς ἀκούει καὶ γελᾷ·",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "κι’ ἀνασκομπόνει στ’ ἀψηλὰ",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": ":τοῦ ῥούχου τὰ μανίκια:",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "“Καλὰ τὸ λέγουν οἱ θνητοί,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "πῶς ὅπου λείπει τὸ γατί",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": ":χορεύουν τὰ ποντίκια!”",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Κ’ ἐνῷ οἱ Ἅγιοι μὲ πολλὴ",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "τοῦ ψαλλουρίζουν συστολὴ",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": ":τ’ ἀτέλειωτο τροπάρι,",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "νίβγετ’ Ἐκεῖνος καθαρὰ",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "κι’ ἀλλάζει μέσα, καὶ φορᾷ",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": ":τὴν θεϊκή του χάρη.",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Ἔπειτα γνεύει σιγανὰ",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "τ’ ἀγγέλου ποῦ τὸν διακονᾷ",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": ":ν’ ἀνοίξῃ πιὰ τὴν θύρα.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Μόλις τὴν εἶδαν ν’ ἀνοιγῇ,",
      "cleaned_line": 19,
      "index": 15,
      "usable": true
    },
    {
      "text": "ἐσκύψαν ὅλοι μὲ σιγή,",
      "cleaned_line": 20,
      "index": 16,
      "usable": true
    },
    {
      "text": ":καὶ προσκυνοῦν στὴν γύρα.",
      "cleaned_line": 21,
      "index": 17,
      "usable": true
    },
    {
      "text": "Ὁ Πλάστης γνεύει ἄλλη μιά.",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "Κ’ ἦταν αὐτὸ ἐπιθυμιὰ",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": ":νὰ εἰσαχθοῦν στὸ ’σπίτι.",
      "cleaned_line": 25,
      "index": 20,
      "usable": true
    },
    {
      "text": "“Μόλις ἐδόθ’ ἡ προσταγή,",
      "cleaned_line": 26,
      "index": 21,
      "usable": true
    },
    {
      "text": "καὶ θὰ φιλήσῃ λὲς τὴν γῆ",
      "cleaned_line": 27,
      "index": 22,
      "usable": true
    },
    {
      "text": ":ἡ μακρυά τους μύτη!",
      "cleaned_line": 28,
      "index": 23,
      "usable": true
    }
  ],
