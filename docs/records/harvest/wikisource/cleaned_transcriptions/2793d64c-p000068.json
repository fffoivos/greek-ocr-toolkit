  "lines": [
    {
      "text": ":Ποῦ τρέχει τάχα; Οὐδ’ οὗτος βλέπει·",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "πλὴν σπεύδει, σπεύδει· καὶ καθ’ ὁδόν,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "τυφλὸς παντάπασιν, ἀνατρέπει",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "πᾶν τὸ γινόμενον ἐμποδών·",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "μὲ τὴν ταχύτητα δὲ τοῦ βέλους",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "φθάν’ εἰς τὰς τάξεις του ἐπὶ τέλους.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Οὐδεὶς ἐτόλμησε νὰ μὴ φύγῃ·",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "καὶ, διὰ μέσου τῶν διελθών,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ταχὺς τὰς πύλας αὐτὸς ἀνοίγει",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "κ’ ἐξέρχετ’ ἄφωνος ἀπελθών.",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": ":Οὕτως, ὁπόταν ἀπὸ τῆς Οἴτης",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "στογγύλος βράχος ἀποκοπῇ,",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "κυλᾷ ῥαγδαίως, συντρίβων πίτυς,",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "κ’ ἐνσπείρων τρόμον βαρυδουπεῖ.",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": "Ὅσον δ’ εἰς πρόποδας προσπελάζει",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": "τόσον τὸ τάχος διπλασιάζει.",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ἐνῷ ἡ ἔλαφος, αἱ δορκάδες,",
      "cleaned_line": 19,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἐξεγειρόμεναι πρὸς φυγήν,",
      "cleaned_line": 20,
      "index": 17,
      "usable": true
    },
    {
      "text": "πηδοῦν περίφοβοι, καὶ δρομάδες",
      "cleaned_line": 21,
      "index": 18,
      "usable": true
    },
    {
      "text": "ἄλλην ζητοῦσι καταφυγήν.",
      "cleaned_line": 22,
      "index": 19,
      "usable": true
    }
  ],
