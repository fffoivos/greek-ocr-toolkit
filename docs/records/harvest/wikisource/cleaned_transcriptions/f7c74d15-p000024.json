  "lines": [
    {
      "text": "ΣΤΡΟΦΕΣ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "Βαρύθυμη εὐτυχία",
      "cleaned_line": 7,
      "index": 1,
      "usable": true
    },
    {
      "text": "Τοῦ χρόνου ἡ ἐπαφή",
      "cleaned_line": 8,
      "index": 2,
      "usable": true
    },
    {
      "text": "Κάτω ἀπ’ τὰ βλέφαρα·",
      "cleaned_line": 9,
      "index": 3,
      "usable": true
    },
    {
      "text": "Ὕπνος",
      "cleaned_line": 10,
      "index": 4,
      "usable": true
    },
    {
      "text": "Γλίσχρος ὕμνος",
      "cleaned_line": 11,
      "index": 5,
      "usable": true
    },
    {
      "text": "Ἡ μέρα παρέρχεται",
      "cleaned_line": 12,
      "index": 6,
      "usable": true
    },
    {
      "text": "Καυχᾶται ὁ ἥλιος",
      "cleaned_line": 13,
      "index": 7,
      "usable": true
    },
    {
      "text": "Ἀνάμνηση γλυκειά",
      "cleaned_line": 15,
      "index": 8,
      "usable": true
    },
    {
      "text": "Ὁ ὡραίος οὐρανός",
      "cleaned_line": 16,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ὅταν γύρω βραδυάζει",
      "cleaned_line": 17,
      "index": 10,
      "usable": true
    },
    {
      "text": "Γίνεται ἄσπιλος ὁ χῶρος",
      "cleaned_line": 18,
      "index": 11,
      "usable": true
    },
    {
      "text": "Τέρπεται ἡ ὅραση",
      "cleaned_line": 19,
      "index": 12,
      "usable": true
    },
    {
      "text": "Ποὺ βλέπει διαυγές",
      "cleaned_line": 20,
      "index": 13,
      "usable": true
    },
    {
      "text": "Περήφανο, τὸ πρόσωπο",
      "cleaned_line": 21,
      "index": 14,
      "usable": true
    },
    {
      "text": "Ὄνειρο χορτᾶτο",
      "cleaned_line": 23,
      "index": 15,
      "usable": true
    },
    {
      "text": "Δάκρυα, ἡ χαρά",
      "cleaned_line": 24,
      "index": 16,
      "usable": true
    },
    {
      "text": "Τὸ δέρμα τοῦ κόσμου·",
      "cleaned_line": 25,
      "index": 17,
      "usable": true
    },
    {
      "text": "Πόσο ἡ φαιδρὴ παρουσία",
      "cleaned_line": 26,
      "index": 18,
      "usable": true
    },
    {
      "text": "Ἀνάλαφρα γγίζει τὸ σῶμα,",
      "cleaned_line": 27,
      "index": 19,
      "usable": true
    },
    {
      "text": "Τί ἰδανικὴ τρικυμία",
      "cleaned_line": 28,
      "index": 20,
      "usable": true
    },
    {
      "text": "Στὰ πέριορα τῆς ἀναπνοῆς!",
      "cleaned_line": 29,
      "index": 21,
      "usable": true
    }
  ],
