  "lines": [
    {
      "text": "παρθενίην Ζεὺς αὐτός, ὑποσχεσίῃσι δολωθείς.",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "δὴ γὰρ ὁ μὲν φιλότητος ἐέλδετο· νεῦσε δ’ ὅγ’ αὐτῇ",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "δωσέμεναι, ὅ κεν ᾗσι μετὰ φρεσὶν ἰθύσειεν. 950",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ἡ δέ ἑ παρθενίην ᾐτήσατο κερδοσύνῃσιν.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "ὧς δὲ καὶ Ἀπόλλωνα παρήπαφεν εὐνηθῆναι",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "ἱέμενον, ποταμόν τ’ ἐπὶ τοῖς Ἅλυν· οὐδὲ μὲν ἀνδρῶν",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "τήνγε τις ἱμερτῇσιν ἐν ἀγκοίνῃσι δάμασσεν.",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "ἔνθα δὲ Τρικκαίοιο ἀγαυοῦ Δηιμάχοιο 955",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "υἷες, Δηιλέων τε καὶ Αὐτόλυκος Φλογίος τε",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "τῆμος ἔθ’, Ἡρακλῆος ἀποπλαγχθέντες, ἔναιον·",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "οἵ ῥα τόθ’, ὡς ἐνόησαν ἀριστήων στόλον ἀνδρῶν,",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "σφᾶς αὐτοὺς νημερτὲς ἐπέφραδον ἀντιάσαντες·",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "οὐδ’ ἔτι μιμνάζειν θέλον ἔμπεδον, ἀλλ’ ἐνὶ νηί, 960",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "Ἀργέσταο παρᾶσσον ἐπιπνείοντος, ἔβησαν.",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "τοῖσι δ’ ὁμοῦ μετέπειτα θοῇ πεφορημένοι αὔρῃ",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "λεῖπον Ἅλυν ποταμόν, λεῖπον δ’ ἀγχίρροον Ἶριν,",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "ἠδὲ καὶ Ἀσσυρίης πρόχυσιν χθονός· ἤματι δ’ αὐτῷ",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "γνάμψαν Ἀμαζονίδων ἕκαθεν λιμενήοχον ἄκρην. 965",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": ":Ἔνθα ποτὲ προμολοῦσαν Ἀρητιάδα Μελανίππην",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "ἥρως Ἡρακλέης ἐλοχήσατο, καί οἱ ἄποινα",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "Ἱππολύτη ζωστῆρα παναίολον ἐγγυάλιξεν",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ἀμφὶ κασιγνήτης· ὁ δ’ ἀπήμονα πέμψεν ὀπίσσω.",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "τῆς οἵγ’ ἐν κόλπῳ, προχοαῖς ἔπι Θερμώδοντος, 970",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "κέλσαν, ἐπεὶ καὶ πόντος ὀρίνετο νισσομένοισιν.",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "τῷ δ’ οὔτις ποταμῶν ἐναλίγκιος, οὐδὲ ῥέεθρα",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "τόσσ’ ἐπὶ γαῖαν ἵησι παρὲξ ἕθεν ἄνδιχα βάλλων.",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "τετράκις εἰς ἑκατὸν δεύοιτό κεν, εἴ τις ἕκαστα",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "πεμπάζοι· μία δ’ οἴη ἐτήτυμος ἔπλετο πηγή. 975",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "ἡ μέν τ’ ἐξ ὀρέων κατανίσσεται ἤπειρόνδε",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "ὑψηλῶν, ἅ τέ φασιν Ἀμαζόνια κλείεσθαι.",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "ἔνθεν δ’ αἰπυτέρην ἐπικίδναται ἔνδοθι γαῖαν",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    },
    {
      "text": "ἀντικρύ· τῶ καί οἱ ἐπίστροφοί εἰσι κέλευθοι·",
      "cleaned_line": 33,
      "index": 31,
      "usable": true
    }
  ],
