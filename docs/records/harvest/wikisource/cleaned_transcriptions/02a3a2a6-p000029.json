  "lines": [
    {
      "text": "Ο ΜΑΡΤΗΣ.",
      "cleaned_line": 7,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ὁ Μάρτης βάλλει τ’ Ἀπριλιοῦ τὰ λαμπερὰ φορέματα,",
      "cleaned_line": 12,
      "index": 1,
      "usable": true
    },
    {
      "text": "καὶ καταβαίν’ ἀπ’ τ’ ἁψηλὰ μὲ τῶν βουνῶν τὰ ῥέμματα,",
      "cleaned_line": 13,
      "index": 2,
      "usable": true
    },
    {
      "text": "::::::::καὶ ὅπου εἶναι κάμποι,",
      "cleaned_line": 14,
      "index": 3,
      "usable": true
    },
    {
      "text": "::::::::φωτοβολᾷ καὶ λάμπει.",
      "cleaned_line": 15,
      "index": 4,
      "usable": true
    },
    {
      "text": "Μέσ’ στὸν φελλό τους τὰ δενδρὰ ῥιγοῦν καὶ συμμαζεύονται·",
      "cleaned_line": 17,
      "index": 5,
      "usable": true
    },
    {
      "text": "τ’ ἄνθη στοὺς κόρφους των βαθιὰ κοιμοῦνται κι’ ὀνειρεύονται·",
      "cleaned_line": 18,
      "index": 6,
      "usable": true
    },
    {
      "text": "::::::::καὶ τὰ λουλούδια ’κόμα",
      "cleaned_line": 19,
      "index": 7,
      "usable": true
    },
    {
      "text": "::::::::δὲν ’βγῆκαν ἀπ’ τὸ χῶμα.",
      "cleaned_line": 20,
      "index": 8,
      "usable": true
    },
    {
      "text": "—Δενδρά!—ὁ Μάρτης τὰ λαλεῖ—Γι’ ἀφῆστε τὰ καμώματα!",
      "cleaned_line": 22,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ἄνθη! τὰ μάτι’ ἀνοίξετε, κ’ ἐβγῆτ’ ἀπὸ τὰ στρώματα,",
      "cleaned_line": 23,
      "index": 10,
      "usable": true
    },
    {
      "text": "::::::::νὰ διῆτε τί σᾶς φέρει",
      "cleaned_line": 24,
      "index": 11,
      "usable": true
    },
    {
      "text": "::::::::τὸ μαγικό μου χέρι!",
      "cleaned_line": 25,
      "index": 12,
      "usable": true
    },
    {
      "text": "Ἐγὦμ’ ὁ μῆνας, ποῦ γυρνᾷ σὲ κάθε χρόνου κύλιμα,",
      "cleaned_line": 27,
      "index": 13,
      "usable": true
    },
    {
      "text": "καὶ φέρει μόσχους καὶ θωριαίς εἰς τ’ ἄνθη μ’ ἕνα φίλημα,",
      "cleaned_line": 28,
      "index": 14,
      "usable": true
    },
    {
      "text": "::::::::καὶ φέρ’ εἰς κάθε κόρη",
      "cleaned_line": 29,
      "index": 15,
      "usable": true
    },
    {
      "text": "::::::::ἕνα καλὸν ἀγόρι!—",
      "cleaned_line": 30,
      "index": 16,
      "usable": true
    }
