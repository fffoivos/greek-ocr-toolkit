  "lines": [
    {
      "text": "«Καὶ εἰς τὸν ᾅδην μετὰ σοῦ,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "::εἰς ᾅδου ἂν ἡγῆσαι!",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Ὤ! τοῦ ὀνείρου τοῦ χρυσοῦ",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "μὴ μὲ στερήσῃς, μέχρις οὗ",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "::ἀκούσω ποῖος εἶσαι».—",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Κ’ ἐκεῖνος εἶπε μειδιῶν·",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "::—«Θεώρει με; ὦ κόρη,",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "Θεὸν πλησίον σου, Θεὸν,",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "καὶ πρώτην τῶν εὐτυχιῶν",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "::τήν μετὰ σοῦ θεώρει».—",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "—«Θεὸν μὴ λέγῃς· οἱ Θεοὶ",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::τὸν Ὄλυμπον οἰκοῦσι.",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "Καὶ ἂν μοὶ φύγῃ ἡ ζωὴ",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "εἰς στεναγμὸν διακαῆ,",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::τις θέλει τὸν ἀκούσει;",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "«Θεὸς ἂν ἦσαι, θὰ ζητῇς",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::καπνὸν εὐώδους κνίσσης",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "καὶ ἑκατόμβας τελετῆς,",
      "cleaned_line": 22,
      "index": 17,
      "usable": true
    },
    {
      "text": "ἀλλ’ ὄχι ἔρωτα θνητῆς,",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "::κ’ ἐμὲ θὰ λησμονήσῃς.»—",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": "Ἐν ᾧ δὲ οὗτοι τρυφερῶς",
      "cleaned_line": 26,
      "index": 20,
      "usable": true
    },
    {
      "text": "::τοιαῦτα συνωμίλουν,",
      "cleaned_line": 27,
      "index": 21,
      "usable": true
    },
    {
      "text": "τῶν ναυτῶν ἔστη ὁ χορὸς,",
      "cleaned_line": 28,
      "index": 22,
      "usable": true
    },
    {
      "text": "κ’ ἐπὶ τὸ ζεῦγος βλοσυρῶς",
      "cleaned_line": 29,
      "index": 23,
      "usable": true
    },
    {
      "text": "::τὰ βλέμματα προσήλουν.",
      "cleaned_line": 30,
      "index": 24,
      "usable": true
    }
