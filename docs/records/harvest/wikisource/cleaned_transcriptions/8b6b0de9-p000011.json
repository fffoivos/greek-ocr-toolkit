  "lines": [
    {
      "text": "Ἡ κόρη βλέπ’ ἡ τρυφερὰ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "::τὴν ἀπειλοῦσαν πάλην",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "καὶ ὡς δειλὴ περιστερὰ,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "πρὸς τὴν προστάτιν ἀφορᾷ",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "::τοῦ ἑραστοῦ ἀγκάλην.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Αὐτὸς δὲ κύπτει, τὴν φιλεῖ,",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "::κ’ ἐγείρεται ὀργίλος.",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "Τὸ βλέμμα σπινθηροβολεῖ,",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "προτεταμένον προκαλεῖ",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "::τὸ εὐγενές του χεῖλος.",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "—«Τί θέλετε;» τοὺς ἐρωτᾷ",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::καὶ εἷς προπέτης ναύτης",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "τῷ λέγει· «Θέλομεν αὐτὰ",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "τὰ ψέλλια τὰ τοῤῥευτὰ",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::μετὰ τῆς κόρης ταύτης.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "—«Σὲ δὲ τὸν νέον τὸν καλὸν",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::ταλάντου θὰ πωλήσω",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "εἰς τὰς φυλὰς τῶν Σικελῶν.»—",
      "cleaned_line": 22,
      "index": 17,
      "usable": true
    },
    {
      "text": "Ὁ δ’ ἀπεκρίθη ἀπειλῶν·",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "::—«Παράφρονες, ὀπισω!",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": "—«Ληστῶν ἀγέλη εἶσθε σεῖς!»",
      "cleaned_line": 26,
      "index": 20,
      "usable": true
    },
    {
      "text": "::Κ’ ἐκάγχασαν ἐκεῖνοι,",
      "cleaned_line": 27,
      "index": 21,
      "usable": true
    },
    {
      "text": "κ’ ἐχώρει ἕκαστος θρασὺς,",
      "cleaned_line": 28,
      "index": 22,
      "usable": true
    },
    {
      "text": "κ’ ἐπὶ τὴν κόρην τοὺς δασεῖς",
      "cleaned_line": 29,
      "index": 23,
      "usable": true
