  "lines": [
    {
      "text": "⟦UNRESOLVED_TEMPLATE⟧",
      "cleaned_line": 2,
      "index": 0,
      "usable": false
    },
    {
      "text": "О, да, молитвенна душа,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "И я молюсь всему.",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "Картина Міра хороша,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Люблю я свѣтъ и тьму.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Все, что приходитъ, то прошло,",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Въ воспоминаніи свѣтло",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "Живутъ добро и зло.",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "Но, чтобъ въ душѣ была волна",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "Молитвенной мечты,",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Въ явленьи цѣльность быть должна,",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "Должны въ немъ жить черты.",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Чѣмъ хочешь будь: будь добрый, злой.",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "Но будь же честенъ за игрой,",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": "Явись—самимъ собой.",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": "Пусть будетъ въ смерть твоя игра,",
      "cleaned_line": 19,
      "index": 15,
      "usable": true
    },
    {
      "text": "Пусть ты меня убьешь,—",
      "cleaned_line": 20,
      "index": 16,
      "usable": true
    },
    {
      "text": "Пойму, что мнѣ уйти пора,",
      "cleaned_line": 21,
      "index": 17,
      "usable": true
    },
    {
      "text": "Пойму я все,—не ложь.",
      "cleaned_line": 22,
      "index": 18,
      "usable": true
    },
    {
      "text": "Я только цѣльному молюсь,",
      "cleaned_line": 23,
      "index": 19,
      "usable": true
    },
    {
      "text": "И вѣчно мерзки мнѣ, клянусь,",
      "cleaned_line": 24,
      "index": 20,
      "usable": true
    },
    {
      "text": "Ханжа, глупецъ, и трусъ.",
      "cleaned_line": 25,
      "index": 21,
      "usable": true
    }
  ],
