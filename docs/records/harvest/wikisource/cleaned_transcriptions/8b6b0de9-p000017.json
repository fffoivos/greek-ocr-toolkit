  "lines": [
    {
      "text": "Ἐγγύς, μακράν, εἰς τ’ ἀνοικτὰ,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "::ἐκ σκοτεινοῦ πυθμένος,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ὄντ’ ἀναδύονται φρικτὰ,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ὅσα πλωτά, ὅσα νηκτὰ,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "::καὶ πᾶν ἐνύδρων γένος.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Τὸ κῦμ’ ἀφρίζον ἡ οὐρὰ",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "::τῆς ἱπποκάμπης πλήττει.",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "Φυσῶσ’ εἰς ὕψος τὰ νερὰ,",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "καὶ, βαρεῖς ὄγκοι, σοβαρὰ",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "::προβαίνουσι τὰ κήτη.",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Βάλλουσιν ἔρωτες ὁ εἷς",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::τὸν ἄλλον μὲ κογχύλας·",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "καὶ παίζουσαι μετὰ βοῆς,",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἡ Ναϊὰς κ’ ἡ Νηρηῒς",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::διώκουσιν ἀλλήλας.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Σειρῆνα φέρων, ὁ δελφὶν",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::ὁρμᾷ ἐν τῶν ἀδύτων,",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "καὶ προκαλεῖ τὴν ἀδελφὴν",
      "cleaned_line": 22,
      "index": 17,
      "usable": true
    },
    {
      "text": "εἰς τοῦ ἀφροῦ τὴν κορυφὴν",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "::ὀχούμενος ὁ Τρίτων.",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": "Σεμνὸς ὁ θίασος σοβεῖ,",
      "cleaned_line": 26,
      "index": 20,
      "usable": true
    },
    {
      "text": "::ὡς φέρεται ὁ κέλης,",
      "cleaned_line": 27,
      "index": 21,
      "usable": true
    },
    {
      "text": "εἰς συνοδίαν εὐσεβῆ·",
      "cleaned_line": 28,
      "index": 22,
      "usable": true
    },
    {
      "text": "καὶ ὕμνος ἀντηχεῖ, «Εὐοὶ",
      "cleaned_line": 29,
      "index": 23,
      "usable": true
    },
    {
      "text": "::εὐὰν, υἱὲ Σεμέλης!»",
