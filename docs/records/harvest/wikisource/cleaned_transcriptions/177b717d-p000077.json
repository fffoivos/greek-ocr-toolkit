  "lines": [
    {
      "text": "ΣΤΑΔΙΟΔΡΟΜΙΑ",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Τὴ σάρκα, τὸ αἷμα θὰ βάλω",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "σὲ σχῆμα βιβλίου μεγάλο.",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "«Οἱ στίχοι παρέχουν ἐλπίδες»,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "θὰ γράψουν οἱ ἐφημερίδες.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "«Κλεαρέτη Δίπλα-Μαλάμου»,",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "καὶ δίπλα σ’ αὐτὸ τὄνομά μου.",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "Τὴν ψυχὴ καὶ τὸ σῶμα πάλι",
      "cleaned_line": 11,
      "index": 7,
      "usable": true
    },
    {
      "text": "στὴ δουλειὰ θὰ δίνω, στὴν πάλη.",
      "cleaned_line": 12,
      "index": 8,
      "usable": true
    },
    {
      "text": "Ἀλλά, μὲ τὴ δύση τοῦ ἡλίου,",
      "cleaned_line": 14,
      "index": 9,
      "usable": true
    },
    {
      "text": "θὰ πηγαίνω στοῦ Βασιλείου.",
      "cleaned_line": 15,
      "index": 10,
      "usable": true
    }
  ],
