  "lines": [
    {
      "text": "⁂",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "Ποιὰ θέληση θεοῦ μᾶς κυβερνάει,",
      "cleaned_line": 2,
      "index": 1,
      "usable": true
    },
    {
      "text": "ποιὰ μοῖρα τραγικὴ κρατάει τὸ νῆμα",
      "cleaned_line": 3,
      "index": 2,
      "usable": true
    },
    {
      "text": "τῶν ἄδειων ἡμερῶν ποὺ τώρα ζοῦμε",
      "cleaned_line": 4,
      "index": 3,
      "usable": true
    },
    {
      "text": "σὰν ἀπὸ μιὰ κακή, παλιὰ συνήθεια;",
      "cleaned_line": 5,
      "index": 4,
      "usable": true
    },
    {
      "text": "Πρὶν φτάσουμε στὴ μέση αὐτοῦ τοῦ δρόμου,",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "ἐχάσαμε τὴ χρυσὴ πανοπλία,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "καὶ μόνο τὸ μεγάλο ἐρώτημά μας",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ὁλοένα πιὸ σφιχτὰ μᾶς περιβάλλει.",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "Χωρὶς πίστη κι ἀγάπη, χωρὶς ἕρμα,",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἐγίναμε τὸ λάφυρο τοῦ ἀνέμου,",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "ποὺ ἀναστρέφει τὸ πέλαγος. Θὰ βροῦμε",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "τουλάχιστον τὸ βυθὸ τῆς ἀβύσσου;",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    }
  ],
