  "lines": [
    {
      "text": "ὀψὲ δ’ ἀμειβόμενος προσελέξατο κερδαλέοισιν·",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": ":«Αἰήτη, μάλα τοί με δίκῃ περιπολλὸν ἐέργεις.",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "τῶ καὶ ἐγὼ τὸν ἄεθλον ὑπερφίαλόν περ ἐόντα",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "τλήσομαι, εἰ καί μοι θανέειν μόρος. οὐ γὰρ ἔτ’ ἄλλο",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "ῥίγιον ἀνθρώποισι κακῆς ἐπικείσετ’ ἀνάγκης, 430",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "ἥ με καὶ ἐνθάδε νεῖσθαι ἐπέχραεν ἐκ βασιλῆος.»",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": ":Ὧς φάτ’ ἀμηχανίῃ βεβολημένος· αὐτὰρ ὁ τόνγε",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "σμερδαλέοις ἐπέεσσι προσέννεπεν ἀσχαλόωντα·",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "«Ἔρχεο νῦν μεθ’ ὅμιλον, ἐπεὶ μέμονάς γε πόνοιο·",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "εἰ δὲ σύγε ζυγὰ βουσὶν ὑποδδείσαις ἐπαεῖραι, 435",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἠὲ καὶ οὐλομένου μεταχάσσεαι ἀμήτοιο,",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "αὐτῷ κεν τὰ ἕκαστα μέλοιτό μοι, ὄφρα καὶ ἄλλος",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "ἀνὴρ ἐρρίγῃσιν ἀρείονα φῶτα μετελθεῖν.»",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": ":Ἴσκεν ἀπηλεγέως· ὁ δ’ ἀπὸ θρόνου ὤρνυτ’ Ἰήσων,",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "Αὐγείης Τελαμών τε παρασχεδόν· εἵπετο δ’ Ἄργος 440",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "οἶος, ἐπεὶ μεσσηγὺς ἔτ’ αὐτόθι νεῦσε λιπέσθαι",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "αὐτοκασιγνήτοις· οἱ δ’ ἤισαν ἐκ μεγάροιο.",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "θεσπέσιον δ’ ἐν πᾶσι μετέπρεπεν Αἴσονος υἱὸς",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "κάλλεϊ καὶ χαρίτεσσιν· ἐπ’ αὐτῷ δ’ ὄμματα κούρη",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "λοξὰ παρὰ λιπαρὴν σχομένη θηεῖτο καλύπτρην, 445",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "κῆρ ἄχεϊ σμύχουσα· νόος δέ οἱ ἠύτ’ ὄνειρος",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ἑρπύζων πεπότητο μετ’ ἴχνια νισσομένοιο.",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "καί ῥ’ οἱ μέν ῥα δόμων ἐξήλυθον ἀσχαλόωντες.",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "Χαλκιόπη δὲ χόλον πεφυλαγμένη Αἰήταο",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "καρπαλίμως θάλαμόνδε σὺν υἱάσιν οἷσι βεβήκει. 450",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "αὔτως δ’ αὖ Μήδεια μετέστιχε· πολλὰ δὲ θυμῷ",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "ὥρμαιν’, ὅσσα τ’ Ἔρωτες ἐποτρύνουσι μέλεσθαι.",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "προπρὸ δ’ ἄρ’ ὀφθαλμῶν ἔτι οἱ ἰνδάλλετο πάντα,",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "αὐτός θ’ οἷος ἔην, οἵοισί τε φάρεσιν ἕστο,",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "οἷά τ’ ἔειφ’, ὥς θ’ ἕζετ’ ἐπὶ θρόνου, ὥς τε θύραζε 455",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "ἤιεν· οὐδέ τιν’ ἄλλον ὀίσσατο πορφύρουσα",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
