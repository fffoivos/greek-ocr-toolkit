  },
  "lines": [
    {
      "text": "ἥντινα τήνδ’ ὀνόμηνας ἀριγνώτην γεγαυῖαν 1075",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "Πασιφάης, ἣ πατρὸς ὁμόγνιός ἐστιν ἐμεῖο.»",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": ":Ὧς φάτο· τὸν δὲ καὶ αὐτὸν ὑπήιε δάκρυσι κούρης",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "οὖλος Ἔρως, τοῖον δὲ παραβλήδην ἔπος ηὔδα·",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "«Καὶ λίην οὐ νύκτας ὀίομαι, οὐδέ ποτ’ ἦμαρ",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "σεῦ ἐπιλήσεσθαι, προφυγὼν μόρον, εἰ ἐτεόν γε 1080",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "φεύξομαι ἀσκηθὴς ἐς Ἀχαιίδα, μηδέ τιν’ ἄλλον",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "Αἰήτης προβάλῃσι κακώτερον ἄμμιν ἄεθλον.",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "εἰ δέ τοι ἡμετέρην ἐξίδμεναι εὔαδε πάτρην",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "ἐξερέω· μάλα γάρ με καὶ αὐτὸν θυμὸς ἀνώγει.",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ἔστι τις αἰπεινοῖσι περίδρομος οὔρεσι γαῖα, 1085",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "πάμπαν ἐύρρηνός τε καὶ εὔβοτος, ἔνθα Προμηθεὺς",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "Ἰαπετιονίδης ἀγαθὸν τέκε Δευκαλίωνα,",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "ὃς πρῶτος ποίησε πόλεις καὶ ἐδείματο νηοὺς",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "ἀθανάτοις, πρῶτος δὲ καὶ ἀνθρώπων βασίλευσεν.",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "Αἱμονίην δὴ τήνγε περικτίονες καλέουσιν. 1090",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "ἐν δ’ αὐτῇ Ἰαωλκός, ἐμὴ πόλις, ἐν δὲ καὶ ἄλλαι",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "πολλαὶ ναιετάουσιν, ἵν’ οὐδέ περ οὔνομ’ ἀκοῦσαι",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "Αἰαίης νήσου· Μινύην γε μὲν ὁρμηθέντα,",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "Αἰολίδην Μινύην ἔνθεν φάτις Ὀρχομενοῖο",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "δή ποτε Καδμείοισιν ὁμούριον ἄστυ πολίσσαι. 1095",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ἀλλὰ τίη τάδε τοι μεταμώνια πάντ’ ἀγορεύω,",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "ἡμετέρους τε δόμους τηλεκλείτην τ’ Ἀριάδνην,",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "κούρην Μίνωος, τόπερ ἀγλαὸν οὔνομα κείνην",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "παρθενικὴν καλέεσκον ἐπήρατον, ἥν μ’ ἐρεείνεις;",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "αἴθε γάρ, ὡς Θησῆι τότε ξυναρέσσατο Μίνως 1100",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "ἀμφ’ αὐτῆς, ὧς ἄμμι πατὴρ τεὸς ἄρθμιος εἴη.»",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": ":Ὧς φάτο, μειλιχίοισι καταψήχων ὀάροισιν.",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "τῆς δ’ ἀλεγεινόταται κραδίην ἐρέθεσκον ἀνῖαι,",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "καί μιν ἀκηχεμένη ἀδινῷ προσπτύξατο μύθῳ·",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "«Ἑλλάδι που τάδε καλά, συνημοσύνας ἀλεγύνειν· 1105",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
