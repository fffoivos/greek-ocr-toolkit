  "lines": [
    {
      "text": "Ἀπὸ παιδὶ τὸν ἀγαποῦσε·",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": ":κ’ ἦταν ὁ γάμος Κυριακή.",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Λευκονδυμένη ’καρτεροῦσε",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": ":νὰ μαζευθοῦν οἱ χωρικοί,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "νἀρθοῦν οἱ φίλ’ οἱ καλεσμένοι",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": ":ἀπὸ τὰ ’λόγυρα χωριά.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": ":—Φέρτε τὰ στέφανα! Φέρτε κεριά,",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "γιατ’ ὁ γαμβρὸς μὲ περιμένει!",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "Θωροῦν καπνούς, ἀκοῦν τουφέκια—",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": ":Ἔρχετ’ ἡ νυμφικὴ πομπή.",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ἀκοῦν φωναὶς καὶ τουμπελέκια:",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": ":Ἀνοίξτ’! Ἀνοίξετε νὰ ’μβῇ!",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "Εἶν’ οἱ παππάδες φορεμένοι,",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": ":κ’ εἶναι πολλή ἡ ἀργοποριά,",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": ":—Φέρτε τὰ στέφανα! Φέρτε κεριά,",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": "γιατ’ ὁ γαμβρὸς μὲ περιμένει!",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ἀνοίγ’ ἡ θύρα καὶ κυττάζουν—",
      "cleaned_line": 20,
      "index": 16,
      "usable": true
    },
    {
      "text": ":Βόηθα Χριστὲ ἀπ’ τὸν οὐρανό!",
      "cleaned_line": 21,
      "index": 17,
      "usable": true
    },
    {
      "text": "Δεξιὰ ζερβιά οἱ Τοῦρκοι σφάζουν",
      "cleaned_line": 22,
      "index": 18,
      "usable": true
    },
    {
      "text": ":ὅποιον εὑροῦνε Χριστιανό!..",
      "cleaned_line": 23,
      "index": 19,
      "usable": true
    },
    {
      "text": "Τοὺς Ῥούσσους φεύγουν νικημένοι,",
      "cleaned_line": 24,
      "index": 20,
      "usable": true
    },
    {
      "text": ":καὶ καίγουν τ’ ἄφταιστα χωριά—",
      "cleaned_line": 25,
      "index": 21,
      "usable": true
    },
    {
      "text": ":Κρύψτε τὰ στέφανα καὶ τὰ κεριά,",
      "cleaned_line": 26,
      "index": 22,
      "usable": true
    },
    {
      "text": "γιατ’ εἴμασθ’ ὅλοι ’σκοτωμένοι!",
      "cleaned_line": 27,
      "index": 23,
      "usable": true
    }
  ],
