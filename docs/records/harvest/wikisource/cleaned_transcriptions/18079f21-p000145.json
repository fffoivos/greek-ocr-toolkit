  },
  "lines": [
    {
      "text": "Въ лиліяхъ бѣлыхъ вся нѣжность моя,",
      "cleaned_line": 3,
      "index": 0,
      "usable": true
    },
    {
      "text": "Страсть моя въ кактусахъ красныхъ,",
      "cleaned_line": 4,
      "index": 1,
      "usable": true
    },
    {
      "text": "Въ желтыхъ колосьяхъ покой бытія,",
      "cleaned_line": 5,
      "index": 2,
      "usable": true
    },
    {
      "text": "Ласковость въ розахъ атласныхъ.",
      "cleaned_line": 6,
      "index": 3,
      "usable": true
    },
    {
      "text": "Арумъ зловѣщій, и старый анчаръ,",
      "cleaned_line": 8,
      "index": 4,
      "usable": true
    },
    {
      "text": "Пасть орхидеи тигриной—",
      "cleaned_line": 9,
      "index": 5,
      "usable": true
    },
    {
      "text": "Яркая разность тождественныхъ чаръ,",
      "cleaned_line": 10,
      "index": 6,
      "usable": true
    },
    {
      "text": "Отблески мысли единой.",
      "cleaned_line": 11,
      "index": 7,
      "usable": true
    },
    {
      "text": "Кровью я каждый цвѣтокъ расцвѣтилъ,",
      "cleaned_line": 13,
      "index": 8,
      "usable": true
    },
    {
      "text": "Или слезою воздушной,",
      "cleaned_line": 14,
      "index": 9,
      "usable": true
    },
    {
      "text": "Далъ имъ вкусить отъ сверкающихъ силъ,",
      "cleaned_line": 15,
      "index": 10,
      "usable": true
    },
    {
      "text": "Выростилъ въ безднѣ послушной.",
      "cleaned_line": 16,
      "index": 11,
      "usable": true
    },
    {
      "text": "Выростилъ ихъ, и до завтра затихъ,",
      "cleaned_line": 18,
      "index": 12,
      "usable": true
    },
    {
      "text": "Лучшія радости нѣмы.",
      "cleaned_line": 19,
      "index": 13,
      "usable": true
    },
    {
      "text": "Каждый цвѣтокъ есть изваянный стихъ",
      "cleaned_line": 20,
      "index": 14,
      "usable": true
    },
    {
      "text": "Вѣчно-безгласной Поэмы.",
      "cleaned_line": 21,
      "index": 15,
      "usable": true
    },
    {
      "text": "ВЫСОТЫ.",
      "cleaned_line": 26,
      "index": 16,
      "usable": true
    },
    {
      "text": "Безмолвствуютъ высоты,",
      "cleaned_line": 27,
      "index": 17,
      "usable": true
    },
    {
      "text": "Застыли берега.",
      "cleaned_line": 28,
      "index": 18,
      "usable": true
    },
    {
      "text": "Въ безмѣрности дремоты",
      "cleaned_line": 29,
      "index": 19,
      "usable": true
    },
    {
      "text": "Нагорные снѣга.",
      "cleaned_line": 30,
      "index": 20,
      "usable": true
    },
    {
      "text": "Здѣсь были океаны,",
      "cleaned_line": 32,
      "index": 21,
      "usable": true
    },
    {
      "text": "Но гдѣ теперь волна?",
      "cleaned_line": 33,
      "index": 22,
      "usable": true
    },
    {
      "text": "Остались лишь туманы,",
      "cleaned_line": 34,
      "index": 23,
      "usable": true
    },
    {
      "text": "Величье, глубина.",
      "cleaned_line": 35,
      "index": 24,
      "usable": true
    }
  ],
