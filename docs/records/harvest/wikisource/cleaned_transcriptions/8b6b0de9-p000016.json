  "lines": [
    {
      "text": "Τοὺς ἀνδραποδιστὰς σιγὴ",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "::νεκρῶν καταλαμβάνει.",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Ὤ! ποία πάλιν ἀλλαγή!",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "Πόθεν ἐβλάστησεν ἡ γῆ,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "::ἥτις ἐμπρὸς ἐφάνη;",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Ὁ βαθὺς ὅρμος μειδιᾷ",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "::καὶ νεύει φιληδόνως.",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "Πᾶσα γωνία καὶ σκιά,",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "καὶ εἰς πᾶν δένδρον φωλέα",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "::εὐλάλου ἀηδόνος.",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Τῆς παραλίας μαλακὴ",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::προκύπτει ἡ ἀγκάλη.",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "Ἐκεῖ γαλήνη κατοικεῖ,",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἐκεῖ ὁ ζέφυρος γλυκὺ",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::διὰ τῶν φύλλων ψάλλει.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Ὁ ῥύαξ, ὄφις ἀργυροῦς,",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::τοὺς πολυκάμπτους γύρους",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἑλίσσ’ εἰς τάπητας χλωροὺς,",
      "cleaned_line": 22,
      "index": 17,
      "usable": true
    },
    {
      "text": "καὶ ἄδων ἀπαντᾷ ὁ ῥοῦς",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "::πρὸς ᾂδοντας ζεφύρους.",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": "Βέλους ὀξύτεροον χωρεῖ",
      "cleaned_line": 26,
      "index": 20,
      "usable": true
    },
    {
      "text": "::τὸ πλοῖον πρὸς τὸν κόλπον·",
      "cleaned_line": 27,
      "index": 21,
