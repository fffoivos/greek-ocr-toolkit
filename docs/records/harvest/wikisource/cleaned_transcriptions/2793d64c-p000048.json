    },
    {
      "text": ":Ἀλληλουχούμεναι εἶχον φθάσει",
      "cleaned_line": 21,
      "index": 1,
      "usable": true
    },
    {
      "text": "ὅπου ὁ Μέδων περιπατῶν",
      "cleaned_line": 22,
      "index": 2,
      "usable": true
    },
    {
      "text": "ὀλίγον θέλει νὰ ἠσυχάσῃ,",
      "cleaned_line": 23,
      "index": 3,
      "usable": true
    },
    {
      "text": "μακρὰν ἀγρύπνων στρατιωτῶν.",
      "cleaned_line": 24,
      "index": 4,
      "usable": true
    },
    {
      "text": "Ἡ φαεινή του μεγάλη κόρυς",
      "cleaned_line": 25,
      "index": 5,
      "usable": true
    },
    {
      "text": "φοβεῖ τὰς φρένας ἀμάχου κόρης.",
      "cleaned_line": 26,
      "index": 6,
      "usable": true
    },
    {
      "text": "Κʾ ἐνῷ τὸ βῆμα ἐγγὺς ὡδήγει,",
      "cleaned_line": 27,
      "index": 7,
      "usable": true
    },
    {
      "text": "λαβοῦσα θάρρος προσποιητόν,",
      "cleaned_line": 28,
      "index": 8,
      "usable": true
    },
    {
      "text": "στρέφει τὸν πόδα τώρα νὰ φύγῃ",
      "cleaned_line": 29,
      "index": 9,
      "usable": true
    },
    {
      "text": "κʾ αἴρετʾ ὁ πέπλος ἀναπετῶν.",
