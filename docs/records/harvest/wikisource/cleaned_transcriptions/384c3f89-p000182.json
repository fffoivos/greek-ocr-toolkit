  "lines": [
    {
      "text": "βαῖνον ἐπὶ κληῖδας ἀπὸ χθονός· ἐκ δὲ βυθοῖο",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "εὐναίας εἷλκον περιγηθέες ἄλλα τε πάντα",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἄρμενα μηρύοντο κατὰ χρέος· ὕψι δὲ λαῖφος",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "εἴρυσσαν τανύσαντες ἐν ἱμάντεσσι κεραίης. 890",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "νῆα δ’ ἐυκραὴς ἄνεμος φέρεν. αἶψα δὲ νῆσον",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "καλήν, Ἀνθεμόεσσαν ἐσέδρακον, ἔνθα λίγειαι",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Σειρῆνες σίνοντ’ Ἀχελωίδες ἡδείῃσιν",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "θέλγουσαι μολπῇσιν, ὅτις παρὰ πεῖσμα βάλοιτο.",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "τὰς μὲν ἄρ’ εὐειδὴς Ἀχελωίῳ εὐνηθεῖσα 895",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "γείνατο Τερψιχόρη, Μουσέων μία· καί ποτε Δηοῦς",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "θυγατέρ’ ἰφθίμην ἀδμῆτ’ ἔτι πορσαίνεσκον",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "ἄμμιγα μελπόμεναι· τότε δ’ ἄλλο μὲν οἰωνοῖσιν,",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "ἄλλο δὲ παρθενικῇς ἐναλίγκιαι ἔσκον ἰδέσθαι.",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "αἰεὶ δ’ εὐόρμου δεδοκημέναι ἐκ περιωπῆς 900",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "ἦ θαμὰ δὴ πολέων μελιηδέα νόστον ἕλοντο,",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "τηκεδόνι φθινύθουσαι· ἀπηλεγέως δ’ ἄρα καὶ τοῖς",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "ἵεσαν ἐκ στομάτων ὄπα λείριον. οἱ δ’ ἀπὸ νηὸς",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἤδη πείσματ’ ἔμελλον ἐπ’ ἠιόνεσσι βαλέσθαι,",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "εἰ μὴ ἄρ’ Οἰάγροιο πάις Θρηίκιος Ὀρφεὺς 905",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "Βιστονίην ἐνὶ χερσὶν ἑαῖς φόρμιγγα τανύσσας",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "κραιπνὸν ἐυτροχάλοιο μέλος κανάχησεν ἀοιδῆς,",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "ὄφρ’ ἄμυδις κλονέοντος ἐπιβρομέωνται ἀκουαὶ",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "κρεγμῷ· παρθενικὴν δ’ ἐνοπὴν ἐβιήσατο φόρμιγξ.",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "νῆα δ’ ὁμοῦ ζέφυρός τε καὶ ἠχῆεν φέρε κῦμα 910",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "πρυμνόθεν ὀρνύμενον· ταὶ δ’ ἄκριτον ἵεσαν αὐδήν.",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "ἀλλὰ καὶ ὧς Τελέοντος ἐὺς πάις, οἶος ἑταίρων",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "προφθάμενος, ξεστοῖο κατὰ ζυγοῦ ἔνθορε πόντῳ",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "Βούτης, Σειρήνων λιγυρῇ ὀπὶ θυμὸν ἰανθείς·",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "νῆχε δὲ πορφυρέοιο δι’ οἴδματος, ὄφρ’ ἐπιβαίη, 915",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "σχέτλιος. ἦ τέ οἱ αἶψα καταυτόθι νόστον ἀπηύρων,",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "ἀλλά μιν οἰκτείρασα θεὰ Ἔρυκος μεδέουσα",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
