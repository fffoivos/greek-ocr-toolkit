  "lines": [
    {
      "text": ":Ὅπως ἡ λαίλαψ αὐτὸς τὰ πλήθη,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "πετῶν ἢ τρέχων, διαπερᾷ·",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ὑπὸ τὸν πόδα του ἐκλονήθη,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "τῆς Ἀκροπόλεως ἡ πλευρά,",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "καί, περατώσας τὸν δρόμον ἤδη,",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "τὸν Μελανθίδην ζητεῖ νὰ ἴδῃ.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Ὡς κυβερνήτης ἐκεῖνος χάνων",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "εἰς μαῦρον πέλαγος τὰ νερά,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἐν μέσῳ ἵσταντο μεγιστάνων",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "ἐπεξηγούντων τὰ ἱερά.",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": ":Ὁπότε, φθάσας αὐτοῦ ὁ ξένος,",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "μὲ σέβας ἔκλινε κεφαλὴν",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "κ’ εἰς τὸν ἱδρῶτά του βαπτισμένος,",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "τῷ ἐνεχείρισ’ ἐπιστολήν.",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": "Πρὶν ἢ τὴν δέλτον ἐκεῖνος λύσῃ,",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": "θέλει τὸν ἄγγελον νὰ γνωρίσῃ.",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
      "text": "—Ποῖος; καὶ πόθεν; ἀνδρεῖε ξένε;",
      "cleaned_line": 19,
      "index": 16,
      "usable": true
    },
    {
      "text": "—Τοῦ Κλεομάντεως ἀδελφός.",
      "cleaned_line": 20,
      "index": 17,
      "usable": true
    },
    {
      "text": "Εἶν’ αἱ φιλίαι σας ἐγνωσμέναι,",
      "cleaned_line": 21,
      "index": 18,
      "usable": true
    },
    {
      "text": "ὅπως ἐκεῖνος, εἶμαι Δελφός.",
      "cleaned_line": 22,
      "index": 19,
      "usable": true
    }
  ],
