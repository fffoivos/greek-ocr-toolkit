  "lines": [
    {
      "text": "Ποία ἐντέλεια! Εἰκὼν",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "::ἐφαίνετο μαρμάρου,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "θαῦμα τῆς τέχνης γλυπτικόν.",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "Ἀλλ’ ὡς αὐτὴ δὲν ἦν λευκὸν",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "::τὸ μάρμαρον τῆς Πάρου.",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "Τῶν δροσερῶν της παρειῶν",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "::ὡμοίαζον τὰ κάλλη",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "τὸ ῥόδον τὸ ἐρυθριῶν,",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "ὅταν στιβάζηται χιὼν,",
      "cleaned_line": 11,
      "index": 8,
      "usable": true
    },
    {
      "text": "::κ’ εἰς τὴν χιόνα θάλλῃ.",
      "cleaned_line": 12,
      "index": 9,
      "usable": true
    },
    {
      "text": "Ἐπὶ τοὺς ὤμους της χυτὴ",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "::κατέῤῥεεν ἡ κόμη·",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    },
    {
      "text": "ὡς ἡ σελήνη δ’ ὀρατὴ",
      "cleaned_line": 16,
      "index": 12,
      "usable": true
    },
    {
      "text": "εἰς χρυσᾶ νέφη, ἐν αὐτῇ",
      "cleaned_line": 17,
      "index": 13,
      "usable": true
    },
    {
      "text": "::ὑπέλαμπον οἱ ὦμοι.",
      "cleaned_line": 18,
      "index": 14,
      "usable": true
    },
    {
      "text": "Πλούσιαι πόρπαι πρὸς στολὴν",
      "cleaned_line": 20,
      "index": 15,
      "usable": true
    },
    {
      "text": "::διάλιθοι συνεῖχον",
      "cleaned_line": 21,
      "index": 16,
      "usable": true
    },
    {
      "text": "τῆς κόρης τὴν ἀναβολὴν,",
      "cleaned_line": 22,
      "index": 17,
      "usable": true
    },
    {
      "text": "κ’ εἰς τὴν χρυσῆν της κεφαλὴν",
      "cleaned_line": 23,
      "index": 18,
      "usable": true
    },
    {
      "text": "::τὸν πλοῦτον τῶν βοστρύχων.",
      "cleaned_line": 24,
      "index": 19,
      "usable": true
    },
    {
      "text": "Οἱ εὔγλωττοί της ὀφθαλμοὶ",
      "cleaned_line": 26,
      "index": 20,
      "usable": true
    },
    {
      "text": "::ὅταν χαρὰν ἐδὴλουν,",
      "cleaned_line": 27,
      "index": 21,
      "usable": true
    },
    {
      "text": "ἀπήντων καρδιῶν παλμοὶ,",
      "cleaned_line": 28,
      "index": 22,
      "usable": true
    },
    {
      "text": "καὶ ἦσαν ἔρωτος ψαλμοὶ",
      "cleaned_line": 29,
      "index": 23,
      "usable": true
    },
    {
      "text": "::ἐκεῖνα ποῦ ὡμίλουν.",
