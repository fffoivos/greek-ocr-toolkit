  "lines": [
    {
      "text": "Α. Μ. ΑΝΔΡΕΑΔΟΥ",
      "cleaned_line": 1,
      "index": 0,
      "usable": true
    },
    {
      "text": "ΤΑΚΤΙΚΟΥ ΚΑΘΗΓΗΤΟΥ ΤΗΣ ΔΗΜΟΣΙΑΣ ΟΙΚΟΝΟΜΙΑΣ ΚΑΙ ΣΤΑΤΙΣΤΙΚΗΣ",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ΕΝ Τῼ ΚΑΠΟΔΙΣΤΡΙΑΚῼ ΠΑΝΕΠΙΣΤΗΜΙῼ",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ΠΕΡΙ ΝΟΜΙΣΜΑΤΟΣ",
      "cleaned_line": 7,
      "index": 3,
      "usable": true
    },
    {
      "text": "ΚΑΙ ΤΗΣ",
      "cleaned_line": 9,
      "index": 4,
      "usable": true
    },
    {
      "text": "ΚΤΗΤΙΚΗΣ ΔΥΝΑΜΕΩΣ ΤΩΝ ΠΟΛΥΤΙΜΩΝ ΜΕΤΑΛΛΩΝ",
      "cleaned_line": 11,
      "index": 5,
      "usable": true
    },
    {
      "text": "ΚΑΤΑ ΤΟΥΣ ΒΥΖΑΝΤΙΝΟΥΣ ΧΡΟΝΟΥΣ",
      "cleaned_line": 13,
      "index": 6,
      "usable": true
    },
    {
      "text": "[Ἀπόσπασμα ἐκ τῆς Ἐπιστημονικῆς Ἐπετηρίδος τοῦ Πανεπιστημίου",
      "cleaned_line": 15,
      "index": 7,
      "usable": true
    },
    {
      "text": "τοῦ ἔτους 1916 - 1917].",
      "cleaned_line": 16,
      "index": 8,
      "usable": true
    },
    {
      "text": "⟦UNRESOLVED_TEMPLATE⟧",
      "cleaned_line": 18,
      "index": 9,
      "usable": false
    },
    {
      "text": "ΕΝ ΑΘΗΝΑΙΣ",
      "cleaned_line": 20,
      "index": 10,
      "usable": true
    },
    {
      "text": "ΤΥΠΟΓΡΑΦΙΚΑ ΚΑΤΑΣΤΗΜΑΤΑ ΤΑΡΟΥΣΟΠΟΥΛΟΥ",
      "cleaned_line": 22,
      "index": 11,
      "usable": true
    },
    {
