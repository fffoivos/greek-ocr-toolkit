  },
  "lines": [
    {
      "text": "ἰσθμὸν δ’ αὖ πεδίον τε Δολίονες ἀμφενέμοντο",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "ἀνέρες· ἐν δ’ ἥρως Αἰνήιος υἱὸς ἄνασσεν",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Κύζικος, ὃν κούρη δίου τέκεν Εὐσώροιο",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "Αἰνήτη. τοὺς δ’ οὔτι καὶ ἔκπαγλοί περ ἐόντες 950",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Γηγενέες σίνοντο, Ποσειδάωνος ἀρωγῇ·",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "τοῦ γὰρ ἔσαν τὰ πρῶτα Δολίονες ἐκγεγαῶτες.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "ἔνθ’ Ἀργὼ προύτυψεν ἐπειγομένη ἀνέμοισιν",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "Θρηικίοις, Καλὸς δὲ λιμὴν ὑπέδεκτο θέουσαν.",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "κεῖσε καὶ εὐναίης ὀλίγον λίθον ἐκλύσαντες 955",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "Τίφυος ἐννεσίῃσιν ὑπὸ κρήνῃ ἐλίποντο,",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "κρήνῃ ὑπ’ Ἀρτακίῃ· ἕτερον δ’ ἕλον, ὅστις ἀρήρει,",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "βριθύν· ἀτὰρ κεῖνόν γε θεοπροπίαις Ἑκάτοιο",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "Νηλεΐδαι μετόπισθεν Ἰάονες ἱδρύσαντο",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "ἱερόν, ἣ θέμις ἦεν, Ἰησονίης ἐν Ἀθήνης. 960",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": ":Τοὺς δ’ ἄμυδις φιλότητι Δολίονες ἠδὲ καὶ αὐτὸς",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "Κύζικος ἀντήσαντες ὅτε στόλον ἠδὲ γενέθλην",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": "ἔκλυον, οἵτινες εἶεν, ἐυξείνως ἀρέσαντο,",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "καί σφεας εἰρεσίῃ πέπιθον προτέρωσε κιόντας",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "ἄστεος ἐν λιμένι πρυμνήσια νηὸς ἀνάψαι. 965",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "ἔνθ’ οἵγ’ Ἐκβασίῳ βωμὸν θέσαν Ἀπόλλωνι",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "εἱσάμενοι παρὰ θῖνα, θυηπολίης τ’ ἐμέλοντο.",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "δῶκεν δ’ αὐτὸς ἄναξ λαρὸν μέθυ δευομένοισιν",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "μῆλά θ’ ὁμοῦ· δὴ γάρ οἱ ἔην φάτις, εὖτ’ ἂν ἵκωνται",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": "ἀνδρῶν ἡρώων θεῖος στόλος, αὐτίκα τόνγε 970",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "μείλιχον ἀντιάαν, μηδὲ πτολέμοιο μέλεσθαι.",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "ἶσόν που κἀκείνῳ ἐπισταχύεσκον ἴουλοι,",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": "οὐδέ νύ πω παίδεσσιν ἀγαλλόμενος μεμόρητο·",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "ἀλλ’ ἔτι οἱ κατὰ δώματ’ ἀκήρατος ἦεν ἄκοιτις",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "ὠδίνων, Μέροπος Περκωσίου ἐκγεγαυῖα, 975",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "Κλείτη ἐυπλόκαμος, τὴν μὲν νέον ἐξέτι πατρὸς",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "θεσπεσίοις ἕδνοισιν ἀνήγαγεν ἀντιπέρηθεν.",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
