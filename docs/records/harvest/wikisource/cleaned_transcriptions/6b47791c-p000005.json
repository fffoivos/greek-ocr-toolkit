  "lines": [
    {
      "text": "ΟΛΓΑ'Ι",
      "cleaned_line": 8,
      "index": 0,
      "usable": true
    },
    {
      "text": "ΤΗΙ ΜΕΓΑΛΕΙΟΤΑΤΗΙ ΚΑΙ ΣΕΠΤΗΙ",
      "cleaned_line": 9,
      "index": 1,
      "usable": true
    },
    {
      "text": "ΤΩΝ ΕΛΛΗΝΩΝ ΑΝΑΣΣΗΙ ΤΗΙ ΑΠΡΙΞ ΕΧΟΜΕΝΗΙ",
      "cleaned_line": 10,
      "index": 2,
      "usable": true
    },
    {
      "text": "ΤΗΣ ΠΑΤΡΩΙΑΣ ΕΥΣΕΒΕΙΑΣ ΚΑΙ ΤΩΝ ΘΕΙΩΝ ΑΥΤΗΣ",
      "cleaned_line": 11,
      "index": 3,
      "usable": true
    },
    {
      "text": "ΔΙΔΑΓΜΑΤΩΝ ΑΜΦΙΛΑΦΩΣ ΕΜΠΕΦΟΡΗΜΕΝΗΙ",
      "cleaned_line": 12,
      "index": 4,
      "usable": true
    },
    {
      "text": "ΕΝΘΕΡΜΩΙ ΤΕ ΑΝΤΙΛΗΠΤΟΡΙ ΚΑΙ ΑΡΩΓΩΙ",
      "cleaned_line": 13,
      "index": 5,
      "usable": true
    },
    {
      "text": "ΤΩΝ ΠΑΣΧΟΝΤΩΝ ΚΑΙ ΠΛΕΙΣΤΑΙΣ ΑΛΛΑΙΣ ΑΡΕΤΑΙΣ",
      "cleaned_line": 14,
      "index": 6,
      "usable": true
    },
    {
      "text": "ΤΟΝ ΒΑΣΙΛΕΙΟΝ ΚΑΤΑΓΛΑΙΖΟΥΣΗΙ ΘΡΟΝΟΝ",
      "cleaned_line": 15,
      "index": 7,
      "usable": true
    },
    {
      "text": "ΤΗΝ ΠΑΡΟΥΣΑΝ ΔΙΗΓΗΣΙΝ ΕΥΛΑΒΩΣ ΑΝΑΤΙΘΗΣΙ",
      "cleaned_line": 16,
      "index": 8,
      "usable": true
    },
    {
      "text": "ΤΩΝ ΘΕΡΑΠΟΝΤΩΝ ΑΥΤΗΣ Ο ΕΛΑΧΙΣΤΟΣ",
      "cleaned_line": 17,
      "index": 9,
      "usable": true
    },
    {
      "text": "ΙΩΑΝΝΗΣ ΣΑΚΚΕΛΙΩΝ",
      "cleaned_line": 18,
      "index": 10,
      "usable": true
    }
  ],
