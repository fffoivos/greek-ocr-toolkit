  },
  "lines": [
    {
      "text": "Οἱ ἄνθρωποι φεύγουν, ἢ ὅταν πλησιάζουν,",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "στέκουν γιὰ λίγο πάνω μας, ἀκοῦνε",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "στὴν ἔρημη βοή, μάταιη καὶ κούφια",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "σὰ νὰ χτυποῦν τὸ πόδι σὲ μιὰ στέρνα.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Κοιτάζουνε μὲ φόβο, μὲ ἀπορία,",
      "cleaned_line": 7,
      "index": 4,
      "usable": true
    },
    {
      "text": "ἔπειτα φεύγουν πάλι στοὺς ἀγῶνες,",
      "cleaned_line": 8,
      "index": 5,
      "usable": true
    },
    {
      "text": "καὶ μόνο τὸ συναίσθημα κρατοῦνε",
      "cleaned_line": 9,
      "index": 6,
      "usable": true
    },
    {
      "text": "τοῦ μακρινοῦ, ἀόριστου κινδύνου.",
      "cleaned_line": 10,
      "index": 7,
      "usable": true
    },
    {
      "text": "Εἶναι κάτι φριχτὲς ἀνταποδόσεις.",
      "cleaned_line": 12,
      "index": 8,
      "usable": true
    },
    {
      "text": "Εἶναι στὸν οὐρανὸ μιὰ σιδερένια,",
      "cleaned_line": 13,
      "index": 9,
      "usable": true
    },
    {
      "text": "μιὰ μεγάλη πυγμή, ποὺ δὲ συντρίβει,",
      "cleaned_line": 14,
      "index": 10,
      "usable": true
    },
    {
      "text": "μὰ τιμωρεῖ, κι ἀδιάκοπα πιέζει.",
      "cleaned_line": 15,
      "index": 11,
      "usable": true
    }
  ],
