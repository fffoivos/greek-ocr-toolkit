  },
  "lines": [
    {
      "text": "Ἄργος Ἀρεστορίδης λάχνῃ μέλαν· αὐτὰρ ὁ καλὴν 325",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "δίπλακα, τήν οἱ ὄπασσε κασιγνήτη Πελόπεια.",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "ἀλλ’ ἔμπης τὼ μέν τε διεξερέεσθαι ἕκαστα",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ἔσχετο· τοὺς δ’ ἀγορήνδε συνεδριάασθαι ἄνωγεν.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "αὐτοῦ δ’ ἰλλομένοις ἐπὶ λαίφεσιν, ἠδὲ καὶ ἱστῷ",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "κεκλιμένῳ μάλα πάντες ἐπισχερὼ ἑδριόωντο. 330",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "τοῖσιν δ’ Αἴσονος υἱὸς ἐυφρονέων μετέειπεν·",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": ":«Ἄλλα μὲν ὅσσα τε νηὶ ἐφοπλίσσασθαι ἔοικεν",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "—πάντα γὰρ εὖ κατὰ κόσμον—ἐπαρτέα κεῖται ἰοῦσιν.",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "τῶ οὐκ ἂν δηναιὸν ἐχοίμεθα τοῖο ἕκητι",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": "ναυτιλίης, ὅτε μοῦνον ἐπιπνεύσουσιν ἀῆται. 335",
      "cleaned_line": 12,
      "index": 10,
      "usable": true
    },
    {
      "text": "ἀλλά, φίλοι,—ξυνὸς γὰρ ἐς Ἑλλάδα νόστος ὀπίσσω,",
      "cleaned_line": 13,
      "index": 11,
      "usable": true
    },
    {
      "text": "ξυναὶ δ’ ἄμμι πέλονται ἐς Αἰήταο κέλευθοι—",
      "cleaned_line": 14,
      "index": 12,
      "usable": true
    },
    {
      "text": "τούνεκα νῦν τὸν ἄριστον ἀφειδήσαντες ἕλεσθε",
      "cleaned_line": 15,
      "index": 13,
      "usable": true
    },
    {
      "text": "ὄρχαμον ἡμείων, ᾧ κεν τὰ ἕκαστα μέλοιτο,",
      "cleaned_line": 16,
      "index": 14,
      "usable": true
    },
    {
      "text": "νείκεα συνθεσίας τε μετὰ ξείνοισι βαλέσθαι.» 340",
      "cleaned_line": 17,
      "index": 15,
      "usable": true
    },
    {
      "text": ":Ὧς φάτο· πάπτηναν δὲ νέοι θρασὺν Ἡρακλῆα",
      "cleaned_line": 18,
      "index": 16,
      "usable": true
    },
    {
      "text": "ἥμενον ἐν μέσσοισι· μιῇ δέ ἑ πάντες ἀυτῇ",
      "cleaned_line": 19,
      "index": 17,
      "usable": true
    },
    {
      "text": "σημαίνειν ἐπέτελλον· ὁ δ’ αὐτόθεν, ἔνθα περ ἧστο,",
      "cleaned_line": 20,
      "index": 18,
      "usable": true
    },
    {
      "text": "δεξιτερὴν ἀνὰ χεῖρα τανύσσατο φώνησέν τε·",
      "cleaned_line": 21,
      "index": 19,
      "usable": true
    },
    {
      "text": "«Μήτις ἐμοὶ τόδε κῦδος ὀπαζέτω. οὐ γὰρ ἔγωγε 345",
      "cleaned_line": 22,
      "index": 20,
      "usable": true
    },
    {
      "text": "πείσομαι· ὥστε καὶ ἄλλον ἀναστήσεσθαι ἐρύξω.",
      "cleaned_line": 23,
      "index": 21,
      "usable": true
    },
    {
      "text": "αὐτός, ὅτις ξυνάγειρε, καὶ ἀρχεύοι ὁμάδοιο.»",
      "cleaned_line": 24,
      "index": 22,
      "usable": true
    },
    {
      "text": ":Ἦ ῥα μέγα φρονέων, ἐπὶ δ’ ᾔνεον, ὡς ἐκέλευεν",
      "cleaned_line": 25,
      "index": 23,
      "usable": true
    },
    {
      "text": "Ἡρακλέης· ἀνὰ δ’ αὐτὸς ἀρήιος ὤρνυτ’ Ἰήσων",
      "cleaned_line": 26,
      "index": 24,
      "usable": true
    },
    {
      "text": "γηθόσυνος, καὶ τοῖα λιλαιομένοις ἀγόρευεν· 350",
      "cleaned_line": 27,
      "index": 25,
      "usable": true
    },
    {
      "text": ":«Εἰ μὲν δή μοι κῦδος ἐπιτρωπᾶτε μέλεσθαι,",
      "cleaned_line": 28,
      "index": 26,
      "usable": true
    },
    {
      "text": "μηκέτ’ ἔπειθ’, ὡς καὶ πρίν, ἐρητύοιτο κέλευθα.",
      "cleaned_line": 29,
      "index": 27,
      "usable": true
    },
    {
      "text": "νῦν γε μὲν ἤδη Φοῖβον ἀρεσσάμενοι θυέεσσιν",
      "cleaned_line": 30,
      "index": 28,
      "usable": true
    },
    {
      "text": "δαῖτ’ ἐντυνώμεσθα παρασχεδόν. ὄφρα δ’ ἴωσιν",
      "cleaned_line": 31,
      "index": 29,
      "usable": true
    },
    {
      "text": "δμῶες ἐμοὶ σταθμῶν σημάντορες, οἷσι μέμηλεν 355",
      "cleaned_line": 32,
      "index": 30,
      "usable": true
    }
  ],
