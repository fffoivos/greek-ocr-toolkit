  "lines": [
    {
      "text": ":Οὕτως ὡμίλει ἀλλοφρονοῦσα.",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "«Εὐφήμει, θύγατερ, ἀτυχή,",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "εἶπεν ἡ γραῖα, συμπροχωροῦσα,",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "κτύπος πλησίον μας ἀντηχεῖ.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Σύνελθε· σίγα· φθάνομεν ἤδη",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "παρὰ τῇ πύλῃ καὶ τῷ Κοδρίδῃ.»",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "—Καὶ τῷ Κοδρίδῃ!— Κατακαλύπτει",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "οὔτως εἰποῦσα, σῶμα ψυχρὸν",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "καὶ τὴν εὐγένειαν ὑποκρύπτει",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "ὑπὸ περίβλημα πενιχρόν.",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    }
