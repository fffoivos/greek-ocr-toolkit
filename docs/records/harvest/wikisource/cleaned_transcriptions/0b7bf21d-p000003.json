  "lines": [
    {
      "text": "::ΤΟΙΣ ΕΝΤΕΥΞΟΜΕΝΟΙΣ.",
      "cleaned_line": 5,
      "index": 0,
      "usable": true
    },
    {
      "text": "⟦UNRESOLVED_TEMPLATE⟧ΙΣ τὴν δευτέρα» ἔκδοσιν τῆς κατὰ τὸν ὑπὲρ ἐλευθερίας ἀγῶνα ἱστορίας τῶν Ἀθηνῶν παρένειρα καὶ ἀρχαιολογικά τινα περὶ δήμων, καὶ ταῦτα ἐν παρόδῳ ὡς πάρεργα. Οἱ περὶ τὰ τοιαῦτα ἐσπουδακότες καὶ οἱ δυνάμενοι νὰ κρίνωσι τὸ ὀρθὸν καὶ τὸ πολλῆς ἐχόμενον πιθανότητος, παρεδέχθησαν τὰς κρίσεις μου. Ἐκ τούτων μὲ ἐπρότρεψαν τινὲς φιλικῶς νὰ ἐπιχειρήσω τὴν ἀκολουθίαν τῆς ἀνευρέσεως καὶ τῶν λοιπῶν δήμων τῆς χώρας. Ἡ προτροπὴ αὕτη μοὶ ἔνυξε τὴν φιλοτιμίαν· τὸ ἐπιχείρημα ὅμως ἐργωδέστατον διὰ τὴν τοσαύτην καὶ τηλικαύτην μεταβολὴν καὶ ἀλλοίωσιν τῶν πραγμάτων ἀπὸ τοῦ φωτὸς εἰς τὸ σκότος. Ἀφοῦ ἡ Ἀττικὴ, ὡς καὶ ἡ λοιπὴ Ἑλλὰς, κατεστράφη ὁλοτελῶς εἰς τὸ πολυχρόνιον κράτος τῆς ἀπαιδευσίας, εἶνε τῶν ἀδυνάτων νὰ γένῃ ἐν πᾶσι τελεία καὶ ἀπλανὴς ἡ ἀνεύρεσις τῶν ἀπολωλότων· ἀφοῦ μάλιστα πολλοὶ τῶν δήμων τῆς ἀρχαιότητος διὰ τοὺς ἐν αὐτοῖς ναοὺς τῶν ἁγίων μετωνομάσθησαν ὑπὸ τὰ ὀνόματα τούτων· καὶ ἄλλοι τινὲς ἐρημωθέντες ἐκ τῶν περιστάσεων,",
      "cleaned_line": 7,
      "index": 1,
      "usable": false
    }
