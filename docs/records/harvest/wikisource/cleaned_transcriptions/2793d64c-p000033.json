  "lines": [
    {
      "text": ":«Πείθετ’ ὁ γέρων καὶ κατωρθώθη",
      "cleaned_line": 2,
      "index": 0,
      "usable": true
    },
    {
      "text": "τὸ πλεῖστον ἤδη τοῦ ἐφετοῦ.",
      "cleaned_line": 3,
      "index": 1,
      "usable": true
    },
    {
      "text": "Ἐσώθ’ ἡ πόλις, κ’ ἴσως ἐσώθη",
      "cleaned_line": 4,
      "index": 2,
      "usable": true
    },
    {
      "text": "ζωὴ γονέως ἀγαπητοῦ.",
      "cleaned_line": 5,
      "index": 3,
      "usable": true
    },
    {
      "text": "Λουσθεὶς δὲ τώρα, μετὰ λαμπάδος",
      "cleaned_line": 6,
      "index": 4,
      "usable": true
    },
    {
      "text": "μετέβη θύσων εἰς τῆς Παλλάδος.",
      "cleaned_line": 7,
      "index": 5,
      "usable": true
    },
    {
      "text": "Ἐκεῖ τὸ στέμμα θὰ μ’ ἀναδήσουν.",
      "cleaned_line": 8,
      "index": 6,
      "usable": true
    },
    {
      "text": "Ἐκεῖθεν ἴσως μετὰ μικρόν,",
      "cleaned_line": 9,
      "index": 7,
      "usable": true
    },
    {
      "text": "ἄνακτα νέον θὰ μ’ ὁδηγήσουν",
      "cleaned_line": 10,
      "index": 8,
      "usable": true
    },
    {
      "text": "εἰς τὰ βασίλεια τῶν νεκρῶν.",
      "cleaned_line": 11,
      "index": 9,
      "usable": true
    },
    {
      "text": ":«Διπλῆ τὸν νοῦν του χροιὰ καλύπτει·",
      "cleaned_line": 13,
      "index": 10,
      "usable": true
    },
    {
      "text": "οὐδόλως τοῦτο μὲ ἀπατᾷ·",
      "cleaned_line": 14,
      "index": 11,
      "usable": true
    },
    {
      "text": "πρέπει τις ὅμως νὰ ὑποκύπτῃ,",
      "cleaned_line": 15,
      "index": 12,
      "usable": true
    },
    {
      "text": "ποιῶν τ’ ἀδύνατα δυνατά,",
      "cleaned_line": 16,
      "index": 13,
      "usable": true
    },
    {
      "text": "καὶ τὰς δισήμους μετρῶν ἐκφράσεις,",
      "cleaned_line": 17,
      "index": 14,
      "usable": true
    },
    {
      "text": "νὰ ἐξωνῆται τὰς περιστάσεις.",
      "cleaned_line": 18,
      "index": 15,
      "usable": true
    },
    {
      "text": "Ἀλλ’ ἂν ἀκράδαντος ἐπιστρέψῃ....",
      "cleaned_line": 19,
      "index": 16,
      "usable": true
    },
    {
      "text": "Ὤ! τότε, τότε θ’ ἀντισταθῶ.",
      "cleaned_line": 20,
      "index": 17,
      "usable": true
    },
    {
      "text": "Ὁ κόσμος ὅλος ἂν μ’ ἀποτρέψῃ,",
      "cleaned_line": 21,
      "index": 18,
      "usable": true
    },
    {
      "text": "πρὸ τοῦ πατρός μου θ’ ἀγωνισθῶ.»",
      "cleaned_line": 22,
      "index": 19,
      "usable": true
    }
  ],
