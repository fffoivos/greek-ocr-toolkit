#!/usr/bin/env python3
"""Mac setsid shim: fail closed if session detachment is unavailable."""
import os
import sys

if len(sys.argv) < 2:
    sys.exit('usage: setsid command [args ...]')
try:
    os.setsid()
except OSError as error:
    sys.exit(f'launch blocked: setsid: {error}')
os.execvp(sys.argv[1], sys.argv[1:])
