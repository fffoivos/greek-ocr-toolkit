  "commands": [
    "cat cards.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\ncs=[json.loads(s) for s in open('cards.jsonl')]\nfor i,c in enumerate(cs):\n subprocess.run(['magick',c['crop'],'-resize','300%',f'zoom/{i+1:02}.png'],check=True)\nPY",
