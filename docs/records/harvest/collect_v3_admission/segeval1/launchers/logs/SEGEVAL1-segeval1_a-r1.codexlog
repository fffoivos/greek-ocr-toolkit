import json,collections
cs=list(map(json.loads,open('cards.jsonl')))
rs=list(map(json.loads,open('answers.jsonl')))
r=rs[23];r['marks']='na';r['errors']=['crop_overrun'];r['detail']='';r['segmentation_detail']='Neighbour glyph bodies intrude above and below; apparent tall strokes over the target are neighbouring ink.'
r=rs[13];r['errors'].append('extra_mark');r['detail']='No discernible accent in the visible handwriting → ή';r['segmentation_detail']+=' Handwriting does not support a secure base-letter reading.'
with open('answers.jsonl','w') as f:
 for r in rs:f.write(json.dumps(r,ensure_ascii=False)+'\\n')
assert len(rs)==len(cs)==80
assert [r['card_id'] for r in rs]==[c['card_id'] for c in cs]
fields={'card_id','letters','marks','crop_ok','errors','detail','neighbour_whole_word','multi_line','rotated','horizontally_missegmented','segmentation_detail'}
for r in rs:
 assert set(r)==fields
 assert r['letters'] in ['y','n','u'] and r['marks'] in ['y','n','na'] and r['crop_ok'] in ['y','n']
 for k in ['neighbour_whole_word','multi_line','rotated','horizontally_missegmented']:assert r[k] in ['yes','no','uncertain']
 assert isinstance(r['errors'],list) and isinstance(r['detail'],str) and isinstance(r['segmentation_detail'],str)
print('Validated 80 JSON lines, all fields, same order as cards.jsonl.')
for k in ['letters','marks','crop_ok']:print(k,dict(collections.Counter(r[k] for r in rs)))
print('errors',collections.Counter(e for r in rs for e in r['errors']).most_common())
