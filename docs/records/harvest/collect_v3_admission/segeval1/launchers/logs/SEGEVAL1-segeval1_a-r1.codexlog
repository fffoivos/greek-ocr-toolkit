import json
cs=list(map(json.loads,open('cards.jsonl')))
rows=[]
def add(i,l='y',m='y',c='y',e=[],d='',h='no',s=''):
 rows.append(dict(card_id=cs[i-1]['card_id'],letters=l,marks=m,crop_ok=c,errors=e,detail=d,neighbour_whole_word='no',multi_line='no',rotated='no',horizontally_missegmented=h,segmentation_detail=s))
add(1)
add(2,c='n',e=['crop_clipped'],h='yes',s='Right boundary cuts the final sigma.')
add(3,l='n',e=['wrong_letter'],d='Ἔθνους → ἔθνους')
add(4,l='u',c='n',e=['crop_clipped'],s='Only fragmented lower portions of the target glyphs are visible; final-letter boundary is indeterminate.',h='uncertain')
add(5)
add(6)
add(7,m='na')
add(8,m='na')
