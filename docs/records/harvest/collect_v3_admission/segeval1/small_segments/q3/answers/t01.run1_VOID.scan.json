    "mkdir -p zoom\npython3 - <<'PY'\nimport json, subprocess\ncards=[json.loads(x) for x in open('cards.jsonl')]\nfor i,c in enumerate(cards):\n subprocess.run(['magick',c['crop'],'-filter','point','-resize','400%',f'zoom/{i+1:03}.png'],check=True)\nfor b in range(0,len(cards),8):\n args=['magick','montage']\n for i in range(b,min(b+8,len(cards))): args += ['-label',str(i+1),f'zoom/{i+1:03}.png']\n args += ['-font','Helvetica','-pointsize','18','-geometry','+10+12','-tile','1x',f'zoom/group{b//8+1:02}.png']\n subprocess.run(args,check=True)\nprint(len(cards))\nPY",
