  "commands": [
    "cat cards.jsonl",
    "mkdir -p zoom\npython3 - <<'PY'\nimport json,subprocess\nfor i,c in enumerate(map(json.loads,open('cards.jsonl')),1):\n subprocess.run(['magick',c['crop'],'-resize','300%',f'zoom/{i:02d}-v1.png'],check=True)\nPY",
    "python3 - <<'PY'\nimport json\ncs=list(map(json.loads,open('cards.jsonl')))\nrows=[]\ndef add(i,l='y',m='y',c='y',e=[],d='',h='no',s=''):\n rows.append(dict(card_id=cs[i-1]['card_id'],letters=l,marks=m,crop_ok=c,errors=e,detail=d,neighbour_whole_word='no',multi_line='no',rotated='no',horizontally_missegmented=h,segmentation_detail=s))\nadd(1)\nadd(2,c='n',e=['crop_clipped'],h='yes',s='Right boundary cuts the final sigma.')\nadd(3,l='n',e=['wrong_letter'],d='Ἔθνους → ἔθνους')\nadd(4,l='u',c='n',e=['crop_clipped'],s='Only fragmented lower portions of the target glyphs are visible; final-letter boundary is indeterminate.',h='uncertain')\nadd(5)\nadd(6)\nadd(7,m='na')\nadd(8,m='na')\nwith open('answers.jsonl','w') as f:\n for r in rows:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\ncs=list(map(json.loads,open('cards.jsonl')));rows=list(map(json.loads,open('answers.jsonl')))\ndef a(i,l='y',m='y',c='y',e=[],d='',h='no',s='',r='no'):\n rows.append(dict(card_id=cs[i-1]['card_id'],letters=l,marks=m,crop_ok=c,errors=e,detail=d,neighbour_whole_word='no',multi_line='no',rotated=r,horizontally_missegmented=h,segmentation_detail=s))\na(9);a(10);a(11);a(12);a(13,m='na')\na(14,l='u',m='n',c='n',e=['crop_overrun','crop_clipped'],s='Oblique handwriting with additional letter bodies below and cut strokes above; target reading uncertain.',r='yes',h='uncertain')\na(15,c='n',e=['crop_overrun'],s='Substantial upper letter bodies from the following line are visible; no complete neighbour word.')\na(16)\nwith open('answers.jsonl','w') as f:\n for r in rows:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY",
    "python3 - <<'PY'\nimport json\ncs=list(map(json.loads,open('cards.jsonl')));rows=list(map(json.loads,open('answers.jsonl')))\ndef a(i,l='y',m='y',c='y',e=[],d='',h='no',s='',r='no'):\n rows.append(dict(card_id=cs[i-1]['card_id'],letters=l,marks=m,crop_ok=c,errors=e,detail=d,neighbour_whole_word='no',multi_line='no',rotated=r,horizontally_missegmented=h,segmentation_detail=s))\na(17,r='yes',s='Street-name text runs diagonally.')\na(18,m='na')\na(19,m='na',c='n',e=['crop_overrun','punctuation'],d='“ → \"',s='Upper letter bodies of the next line enter the bottom edge.')\na(20);a(21)\na(22,m='na',e=['hyphen'],d='phrygisch=dorisches → phrygisch-dorisches')\na(23,c='n',e=['crop_clipped'],h='yes',s='Final iota of Οι is cut at the right edge.')\na(24,m='n',c='n',e=['missing_mark','crop_overrun'],d='marked i in Divisui → unmarked i',s='Upper letter bodies from the next line enter at the bottom.')\nwith open('answers.jsonl','w') as f:\n for r in rows:f.write(json.dumps(r,ensure_ascii=False)+'\\n')\nPY",
