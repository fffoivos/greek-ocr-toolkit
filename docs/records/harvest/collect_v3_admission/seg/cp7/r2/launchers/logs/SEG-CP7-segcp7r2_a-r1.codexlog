for i,reason in [(16,'The right boundary cuts the final ο in Συμβούλιο.'),(28,'The right boundary cuts the final α of πεπρα.')]:
 a[i].update(crop_ok='n',errors=['crop_clipped'],end_clip='yes',end_clip_reason=reason)
a[46].update(marks='n',errors=['extra_mark'],detail='φησι → φησὶ')
# The dash is punctuation; all base letters remain correctly transcribed.
a[40].update(errors=['punctuation'],detail='— → –')
# Describe incidental neighbouring ink on otherwise usable crops.
for i in [4,5,6,9,14,15,17,20,21,24,26,27,28,29,33,37,43,44,45,47,49,53]:
 if a[i]['crop_ok']=='y':a[i]['neighbour_whole_word_reason']='Only isolated clipped strokes or slivers of neighbouring ink are visible; no complete neighbouring word.'
with open('answers.jsonl','w') as f:
 for x in a:f.write(json.dumps(x,ensure_ascii=False)+'\\n')
required={'card_id','letters','marks','crop_ok','errors','detail','neighbour_whole_word','neighbour_whole_word_reason','multi_line','multi_line_reason','rotated','rotated_reason','horizontally_missegmented','horizontally_missegmented_reason','end_clip','end_clip_reason'}
b=[json.loads(l) for l in open('answers.jsonl')]
assert len(b)==len(cs)==55
assert [x['card_id'] for x in b]==[x['card_id'] for x in cs]
for x in b:
 assert set(x)==required
 assert x['letters'] in ['y','n','u'] and x['marks'] in ['y','n','na'] and x['crop_ok'] in ['y','n']
 for k in ['neighbour_whole_word','multi_line','rotated','horizontally_missegmented','end_clip']:assert x[k] in ['yes','no'] and x[k+'_reason']
print('Verified count, order, JSON, and fields:',len(b))
for k in ['letters','marks','crop_ok']:print(k,dict(collections.Counter(x[k] for x in b)))
print('errors',collections.Counter(e for x in b for e in x['errors']).most_common())
