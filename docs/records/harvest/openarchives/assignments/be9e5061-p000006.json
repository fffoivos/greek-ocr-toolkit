  "docai_lines": [
    {
      "text": "Δήλωση μη λογοκλοπής\n",
      "bbox": [
        249,
        361,
        702,
        404
      ],
      "confidence": 0.98394924,
      "source": "lines"
    },
    {
      "text": "Δηλώνω υπεύθυνα και γνωρίζοντας τις κυρώσεις του Ν. 2121/1993 περί Πνευματικής\n",
      "bbox": [
        251,
        513,
        1402,
        545
      ],
      "confidence": 0.9892956,
      "source": "lines"
    },
    {
      "text": "Ιδιοκτησίας, ότι η παρούσα πτυχιακή εργασία είναι εξ ολοκλήρου αποτέλεσμα δικής\n",
      "bbox": [
        250,
        570,
        1402,
        602
      ],
      "confidence": 0.99314386,
      "source": "lines"
    },
    {
      "text": "μου ερευνητικής εργασίας, δεν αποτελεί προϊόν αντιγραφής ούτε προέρχεται από\n",
      "bbox": [
        250,
        628,
        1401,
        660
      ],
      "confidence": 0.99273795,
      "source": "lines"
    },
    {
      "text": "ανάθεση σε τρίτους. Όλες οι πηγές που χρησιμοποιήθηκαν (κάθε είδους, μορφής και\n",
      "bbox": [
        252,
        685,
        1402,
        717
      ],
      "confidence": 0.9893946,
      "source": "lines"
    },
    {
      "text": "προέλευσης) για τη συγγραφή της περιλαμβάνονται στη βιβλιογραφία.\n",
      "bbox": [
        249,
        743,
        1193,
        775
      ],
      "confidence": 0.9912703,
      "source": "lines"
    },
    {
