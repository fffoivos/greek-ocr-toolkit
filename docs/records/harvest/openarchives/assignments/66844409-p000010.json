  "docai_lines": [
    {
      "text": "4\n",
      "bbox": [
        765,
        108,
        791,
        129
      ],
      "confidence": 0.9703138,
      "source": "lines"
    },
    {
      "text": "Το τελευταίο είναι πολύ σημαντικό δεδομένου ότι, με την εισαγωγή του ευρώ, οι\n",
      "bbox": [
        241,
        382,
        1353,
        414
      ],
      "confidence": 0.9911187,
      "source": "lines"
    },
    {
      "text": "τιμές των προϊόντων και υπηρεσιών είναι πιο διαφανείς και άμεσα συγκρίσιμες, με\n",
      "bbox": [
        199,
        440,
        1354,
        472
      ],
      "confidence": 0.99266315,
      "source": "lines"
    },
    {
      "text": "αποτέλεσμα τη συμπίεσή τους και τον περιορισμό των περιθωρίων κέρδους των\n",
      "bbox": [
        199,
        495,
        1351,
        530
      ],
      "confidence": 0.988474,
      "source": "lines"
    },
    {
      "text": "επιχειρήσεων.\n",
      "bbox": [
        200,
        555,
        385,
        586
      ],
      "confidence": 0.9915753,
      "source": "lines"
    },
    {
      "text": "Το αποτέλεσμα όλων των ανωτέρω είναι θετικό για τους καταναλωτές, οι οποίοι\n",
      "bbox": [
        240,
        668,
        1354,
        703
      ],
      "confidence": 0.9929019,
      "source": "lines"
    },
    {
      "text": "θα επιβαρύνονται με ολοένα και χαμηλότερο κόστος για τα προϊόντα και υπηρεσίες\n",
      "bbox": [
        200,
        727,
        1352,
        761
      ],
      "confidence": 0.992668,
      "source": "lines"
    },
    {
      "text": "που παρέχονται, ενώ και η ποιότητα αυτών θα βελτιώνεται.\n",
      "bbox": [
        198,
        784,
        991,
        818
      ],
      "confidence": 0.9923262,
      "source": "lines"
    }
  ],
