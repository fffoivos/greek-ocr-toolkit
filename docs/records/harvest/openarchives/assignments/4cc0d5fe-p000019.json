  "docai_lines": [
    {
      "text": "Το πιο επίσημο, ωστόσο, ήταν το κρεβάτι με τις λείες επιφάνειες, καμωμένο στον τόρνο\n",
      "bbox": [
        219,
        224,
        1473,
        257
      ],
      "confidence": 0.991231,
      "source": "lines"
    },
    {
      "text": "(μηχανή η οποία χρησιμοποιείται για τη μορφοποίηση κομματιών ξύλου και μετάλλου με τη\n",
      "bbox": [
        221,
        282,
        1471,
        314
      ],
      "confidence": 0.99152726,
      "source": "lines"
    },
    {
      "text": "σύσφιξή, συγκράτηση και περιστροφή) από τους ντόπιους τεχνίτες, τους τορναδόρους. Είχε\n",
      "bbox": [
        221,
        340,
        1472,
        373
      ],
      "confidence": 0.9917365,
      "source": "lines"
    },
    {
      "text": "σκελετό και τέσσερις στύλους από τορνεμένα ξύλα στρογγυλής διατομής με λείες επιφάνειες\n",
      "bbox": [
        221,
        399,
        1475,
        431
      ],
      "confidence": 0.9924539,
      "source": "lines"
    },
    {
      "text": "και ολόγλυφες σφαιρικές απολήξεις, τα «μήλα». Οι τορναδόροι έφτιαχναν, επίσης, τις\n",
      "bbox": [
        221,
        455,
        1476,
        487
      ],
      "confidence": 0.99034226,
      "source": "lines"
    },
    {
      "text": "καρέκλες «του τόρνου». (Παπαδημητρίου, σελ. 38)\n",
