      "metadata_json": "{\"Τίτλος\": \"ΜΕΤΑΣΧΗΜΑΤΙΣΜΟΣ LAPLACE\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\r\\n\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t(EL)\", \"Δημιουργός\": \"Σφυράκης, Χρυσοβαλάντης\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\r\\n\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t(EL)\", \"Τύπος\": \"7\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\r\\n\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t(EN)\", \"Ημερομηνία έκδοσης\": \"2016-02-22T16:03:07Z\", \"Χρονολογία\": \"2016 (EL)\", \"Περιγραφή\": \"ΕΙΣΑΓΩΓΗ <br/>ΙΔΙΟΤΗΤΕΣ ΜΕΤΑΣΧΗΜΑΤΙΣΜΟΥ LAPLACE<br/>ΑΝΤΙΣΤΡΟΦΟΣ ΜΕΤΑΣΧΗΜΑΤΙΣΜΟΣ LAPLACE<br/>ΕΦΑΡΜΟΓΕΣ ΣΤΙΣ ΔΙΑΦΟΡΙΚΕΣ ΕΞΙΣΩΣΕΙΣ ΚΑΙ ΣΥΣΤΗΜΑΤΑ ΔΙΑΦΟΡΙΚΩΝ ΕΞΙΣΩΣΕΩΝ<br/>ΣΥΝΑΡΤΗΣΗ ΒΗΜΑΤΟΣ<br/>ΣΥΝΑΡΤΗΣΗ ΩΘΗΣΗΣ<br/>ΘΕΩΡΗΜΑ ΣΥΝΕΛΙΞΗΣ<br/>ΤΥΠΟΛΟΓΙΟ ΜΕΤΑΣΧΗΜΑΤΙΣΜΟΥ LAPLACE<br/>ΠΑΡΑΔΕΙΓΜΑΤΑ ΛΥΜΕΝΑ<br/>ΑΣΚΗΣΕΙΣ ΠΡΟΣ ΛΥΣΗ\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\r\\n\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t(EL)\", \"Επιστημονικό πεδίο\": \"I. ΜΑΘΗΜΑΤΙΚΑ ΚΑΙ ΠΛΗΡΟΦΟΡΙΚΗ::Μαθηματικά::Αριθμητική ανάλυση::Συνήθεις διαφορικές εξισώσεις\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\r\\n\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t(EL)\", \"Θέμα\": \"ΣΥΣΤΗΜΑΤΑ ΔΙΑΦΟΡΙΚΩΝ ΕΞΙΣΩΣΕΩΝ\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\r\\n\\r\\n\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t(EL)\", \"Σχολή/Τμήμα/Ινστιτούτο\": \"Σύνδεσμος Ελληνικών Ακαδημαϊκών Βιβλιοθηκών\", \"Πάροχος\": \"Σύνδεσμος Ελληνικών Ακαδημαϊκων Βιβλιοθηκών\", \"Αποθετήριο / συλλογή\": \"Αποθετήριο «Κάλλιπος»\", \"Επιμέρους συλλογή\": \"Κεφάλαια\"}",
