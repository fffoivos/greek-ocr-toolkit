      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 12,
      "text": "μεταθετικούς δακτυλίους Rf. Ένα στοιχείο του Rf μπορεί να γραφτεί στη μορφή",
      "font_size": 35,
      "fitted_size": 36,
      "panel_xy": [
        240,
