        603.75
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 10,
      "text": "X = Spec(R) ⊃ Xf = (Spec(R)) f≠ 0",
      "font_size": 35,
