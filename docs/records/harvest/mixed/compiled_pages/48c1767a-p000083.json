    {
      "line_number": 3,
      "text": "Το ιδεώδες √(0) λέγεται το μηδενικό ριζικό ιδεώδες (nilradical) του μεταθετικού",
      "font_size": 35,
      "fitted_size": 36,
      "panel_xy": [
