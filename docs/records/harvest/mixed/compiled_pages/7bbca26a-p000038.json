        1446.55
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 28,
      "text": "ενεργότητα 10000Bq, τρέχουμε την προσομοίωση για 10sec.",
