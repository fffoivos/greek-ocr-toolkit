    },
    {
      "line_number": 37,
      "text": "Καταρχήν I + (1-t)J είναι ένα ιδεώδες στο k[x1,..., Xn, t]. Τώρα έστω f ∈ INJ,",
      "font_size": 34,
      "fitted_size": 34,
