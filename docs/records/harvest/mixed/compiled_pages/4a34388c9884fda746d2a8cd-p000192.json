    },
    {
      "line_number": 2,
      "text": "Durch welches Mittel? = διὰ τίνος μέσου;",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        150,
        117.7
      ],
      "canvas_xy": [
        1266,
        157.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 3,
      "text": "Durch die Nase reden = διὰ τῆς ῥινὸς ὁμιλεῖν.",
      "font_size": 32,
      "fitted_size": 33,
      "panel_xy": [
        151,
        153.2
      ],
      "canvas_xy": [
        1267,
        193.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 4,
      "text": "Durch ein Brett = διὰ μιᾶς σανίδος.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        152,
        187.7
      ],
      "canvas_xy": [
        1268,
        227.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 5,
      "text": "Die ganze Zeit hindurch = καθ' ὅλον τὸν χρόνον.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        153,
        220.7
      ],
      "canvas_xy": [
        1269,
        260.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 6,
      "text": "Durch den Wald gehen = διὰ τοῦ δάσους πορεύεσθαι.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        153,
        254.2
      ],
      "canvas_xy": [
        1269,
        294.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 7,
      "text": "Durch die Religion verboten = ὑπὸ τῆς θρησκείας ἀπηγορευμένον.",
      "font_size": 31,
      "fitted_size": 31,
      "panel_xy": [
        154,
        287.35
      ],
      "canvas_xy": [
        1270,
        327.35
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 8,
      "text": "Für.",
      "font_size": 32,
      "fitted_size": 36,
      "panel_xy": [
        529,
        343.2
      ],
      "canvas_xy": [
        1645,
        383.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 9,
      "text": "Für baares Geld kaufen – μετρητοῖς ἀγοράζειν.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        160,
        392.2
      ],
      "canvas_xy": [
        1276,
        432.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 10,
      "text": "Etwas für sich behalten = κρατεῖν τι δι᾽ ἑαυτόν.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        157,
        425.7
      ],
      "canvas_xy": [
        1273,
        465.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 11,
      "text": "Stück für Stück = τεμάχιον πρὸς τεμάχιον.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        160,
        459.7
      ],
      "canvas_xy": [
        1276,
        499.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 12,
      "text": "Wort für Wort = λέξιν πρὸς λέξιν.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        160,
        493.2
      ],
      "canvas_xy": [
        1276,
        533.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 13,
      "text": "Schritt für Schritt = βῆμα πρὸς βῆμα.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        161,
        528.7
      ],
      "canvas_xy": [
        1277,
        568.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 14,
      "text": "Ein Mittel für das Kopfweh = μέσον διὰ τὸν κεφαλόπονον.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        161,
        559.7
      ],
      "canvas_xy": [
        1277,
        599.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 15,
      "text": "Ein Thaler für den Mann = ἕν τάληρον δι᾽ ἕκαστον.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        162,
        594.7
      ],
      "canvas_xy": [
        1278,
        634.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 16,
      "text": "Ich habe meinen Hut für 13 Mark gekauft = ἠγόρασα τὸν πῖλόν",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        164,
        627.2
      ],
      "canvas_xy": [
        1280,
        667.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 17,
      "text": "μου ἀντὶ 13 μαρκῶν.",
      "font_size": 31,
      "fitted_size": 31,
      "panel_xy": [
        224,
        668.85
      ],
      "canvas_xy": [
        1340,
        708.85
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 18,
      "text": "Für sein Alter – διὰ τὴν ἡλικίαν του, ὅσον ἀφορᾶ τὴν ἡλικίαν του.",
      "font_size": 31,
      "fitted_size": 31,
      "panel_xy": [
