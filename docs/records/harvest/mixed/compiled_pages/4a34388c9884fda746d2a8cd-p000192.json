      "canvas_xy": [
        1283,
        979.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 25,
      "text": "Gegen seinen Willen – παρὰ τὴν θέλησίν του.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        167,
        972.2
      ],
      "canvas_xy": [
