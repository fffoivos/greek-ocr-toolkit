      "text": "Gegen.",
      "font_size": 32,
      "fitted_size": 34,
      "panel_xy": [
        515,
        754.2
      ],
      "canvas_xy": [
        1631,
        794.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 20,
      "text": "Mildthätig gegen die Armen = ἐλεήμων πρὸς τοὺς πτωχούς.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        166,
        799.2
      ],
      "canvas_xy": [
        1282,
        839.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 21,
      "text": "Unempfindlich gegen meine Leiden = ἀναίσθητος πρὸς τὰ πάθη μου.",
      "font_size": 30,
      "fitted_size": 30,
      "panel_xy": [
        167,
        834.5
      ],
      "canvas_xy": [
        1283,
        874.5
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 22,
      "text": "Gegen sechs Uhr = περὶ τὴν ἕκτην ὥραν.",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        166,
        870.7
      ],
      "canvas_xy": [
        1282,
        910.7
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
