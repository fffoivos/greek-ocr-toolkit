        1261.75
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 14,
      "text": "λαιοφόρα μπορούν να προμηθευτούν το πετρέλαιο. Το πλοίο αυτό πρέπει να",
      "font_size": 35,
      "fitted_size": 36,
      "panel_xy": [
