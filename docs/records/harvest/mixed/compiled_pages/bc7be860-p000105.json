        941.4
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 6,
      "text": "Μοντελοποίηση που έχει να κάνει με την ανάπτυξη πετρελαιοφόρων περιοχών",
      "font_size": 35,
      "fitted_size": 35,
      "panel_xy": [
        227,
