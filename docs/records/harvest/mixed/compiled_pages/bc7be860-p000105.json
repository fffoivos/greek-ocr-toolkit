      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 18,
      "text": "της θάλασσας σε κάποια απόσταση από την πηγή. Για να μη μετακινείται το",
      "font_size": 35,
      "fitted_size": 36,
      "panel_xy": [
        229,
        1421.75
      ],
      "canvas_xy": [
