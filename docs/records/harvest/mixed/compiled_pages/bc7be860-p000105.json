        1222.25
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 13,
      "text": "Αυτό το πλοίο λειτουργεί ως αποθηκευτικός χώρος από το οποίο άλλα πετρε-",
      "font_size": 35,
      "fitted_size": 36,
      "panel_xy": [
