        1068.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 10,
      "text": "δυσβάσταχτων δανείων. Όταν κάποια στιγμή (στα μέσα του 2000) οι επενδυτές",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        276,
