      "text": "κόσμο οι εταιρείες υψηλής τεχνολογίας. Οι προσδοκίες αυτές ανάγκασαν τις",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
        277,
        952.2
      ],
      "canvas_xy": [
        2010,
        992.2
      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
