      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 16,
      "text": "και αυτό είχε σαν αποτέλεσμα να περικόψουν δραματικά τις καταναλωτικές τους",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
