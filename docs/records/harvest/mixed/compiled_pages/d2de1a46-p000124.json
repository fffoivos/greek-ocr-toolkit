      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 17,
      "text": "δαπάνες (παρουσιάζουν υψηλή ελαστικότητα σε περιόδους ύφεσης). Το",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
