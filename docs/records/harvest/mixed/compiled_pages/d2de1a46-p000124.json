      ],
      "tall": false,
      "low_confidence": false,
      "overflow_at_minimum": false
    },
    {
      "line_number": 13,
      "text": "Οι τρέχουσες αξίες των επιχειρήσεων στα χρηματιστήρια ανά τον κόσμο",
      "font_size": 32,
      "fitted_size": 32,
      "panel_xy": [
