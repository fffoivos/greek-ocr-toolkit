{
  "$defs": {
    "receipt": {
      "additionalProperties": false,
      "properties": {
        "candidates_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "counts": {
          "additionalProperties": false,
          "properties": {
            "REPLACED": {
              "minimum": 0,
              "type": "integer"
            },
            "UNFILLED": {
              "minimum": 0,
              "type": "integer"
            },
            "flagged": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "flagged",
            "REPLACED",
            "UNFILLED"
          ],
          "type": "object"
        },
        "final_list_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "mock": {
          "type": "boolean"
        },
        "status": {
          "const": "FINALIZED"
        },
        "verdicts_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "status",
        "mock",
        "final_list_sha256",
        "verdicts_sha256",
        "candidates_sha256",
        "counts"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lf1_receipt_ref": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "minLength": 1,
          "type": "string"
        },
        "verdicts_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "verdicts_sha256",
        "line_id"
      ],
      "type": "object"
    },
    "lf1_verdict": {
      "const": "OK"
    },
    "mock": {
      "description": "Must be false in production; true in packaged mock.",
      "type": "boolean"
    },
    "parent_id": {
      "minLength": 1,
      "type": "string"
    },
    "quota_scope": {
      "pattern": "^(test|dev):[^:]+(:[^:]+)?$",
      "type": "string"
    },
    "replaces": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "parent_id": {
              "minLength": 1,
              "type": "string"
            },
            "row_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "parent_id",
            "row_id"
          ],
          "type": "object"
        }
      ]
    },
    "row_id": {
      "minLength": 1,
      "type": "string"
    },
    "split": {
      "enum": [
        "test",
        "dev"
      ]
    }
  },
  "required": [
    "parent_id",
    "row_id",
    "split",
    "quota_scope",
    "lf1_verdict",
    "replaces",
    "lf1_receipt_ref",
    "mock"
  ],
  "title": "SEAL02 final-list JSONL row (one schema instance per line)",
  "type": "object"
}
