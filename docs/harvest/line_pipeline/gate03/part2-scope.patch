+def crop_aspect(row):
+    """Rotation-free pixel aspect from census crop_bbox or bound crop header."""
+    bbox = row.get("crop_bbox")
+    if bbox is not None:
+        width, height = bbox[2] - bbox[0], bbox[3] - bbox[1]
+    elif row.get("crop_path") and row.get("crop_identity_status", "bound") == "bound":
+        from PIL import Image
+        try:
+            with Image.open(row["crop_path"]) as crop:
+                width, height = crop.size
+        except (OSError, ValueError):
+            return None
+    else:
+        return None
+    if min(width, height) <= 0:
+        return None
+    return max(width, height) / min(width, height)
+
+
