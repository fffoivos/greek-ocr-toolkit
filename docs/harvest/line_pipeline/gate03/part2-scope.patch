+def numeric_text(text):
+    """Exact numeric branch of cells_opus common.output_type (no normalization)."""
+    s = (text or "").strip()
+    if not s:
+        return False
+    separators = set(".,:;/-–—%()+'′§№° ")
+    if any(c.isdecimal() for c in s) and all(c.isdecimal() or c in separators or c.isspace() for c in s):
+        return True
+    token = s[:-1] if s[-1] in ".)" else s
+    return bool(token and re.fullmatch(r"M{0,3}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})", token))
+
+
+def content_role(row, expected):
+    return expected.get("content_role") or row.get("content_role") or row.get("primary_class") or "prose"
+
